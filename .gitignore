node_modules/
package-lock.json
*.log
.env
.env.*
NUL
*Zone.Identifier

__pycache__/
*.pyc

# Serena project cache (local, not versioned)
.serena/

# Python coverage data artifacts
.coverage

# Agentic-perfection hook runtime state (regenerated; not source)
hooks/semantic-router/success.json
# git-hygiene Stop-hook throttle stamp (mtime clock; regenerated every run)
.last-run
# local-tui-reminder "already shown today" markers (dated runtime state)
.shown-*

# test / lint caches (regenerated; a live scan produced 22 of each under hooks/**)
.pytest_cache/
.ruff_cache/

# editor / agent backup cruft — the live harness tree carries suffixed forms
# (.bak-fleet-20260713, .bak-20260714-012512, .baseline); none belong in the repo
*.bak
*.bak-*
*.bak.*
*.baseline
*.orig

# python build artifacts
*.egg-info/

# vendored upstream clone inside a skill; a gitlink trips no-runtime-junk
skills/crypto-ctf/RsaCtfTool/

# mitmproxy MCP traffic capture — runtime SQLite; the capture class can hold live tokens
mitm_mcp_traffic.db

# profile-capture hook runtime state. CARRIES RAW OWNER PII (date of birth, phone numbers)
# copied verbatim out of session text. This repo is PUBLIC — never commit these.
hooks/profile-capture/capture-queue.jsonl
hooks/profile-capture/seen.txt

# live Claude Code workflow deploy target. The repo's tracked home for authored workflows
# is agent-self/config/workflows/; one file dropped here carries owner PII.
.claude/workflows/

# packaged skill build artifact — the unpacked source is tracked in both skill roots
.agents/skills/*.zip

# Hook runtime state directories. Written by a running hook, never source.
# recall-gate/state/tree_index.json was measured to copy a summary line verbatim out of
# the scanned tree -- on 2026-08-08 that included a "BEGIN PRIVATE KEY" header lifted from
# a test fixture. This repo is PUBLIC; hook state is a capture surface, not an artifact.
hooks/*/state/

# agent probe outputs — regenerable; the probe SCRIPTS are kept as provenance
**/_*_out.json
**/_*_out.err
**/_*_out.txt
.ruff_cache/
command-center/catalog-slices/_*.py
command-center/_*.py
