node_modules/
package-lock.json
*.log
.env
.env.*
NUL
*Zone.Identifier

__pycache__/
*.pyc

# Serena project cache (local, not versioned)
.serena/

# Python coverage data artifacts
.coverage

# Agentic-perfection hook runtime state (regenerated; not source)
hooks/semantic-router/success.json
# git-hygiene Stop-hook throttle stamp (mtime clock; regenerated every run)
.last-run
# local-tui-reminder "already shown today" markers (dated runtime state)
.shown-*

# test / lint caches (regenerated; a live scan produced 22 of each under hooks/**)
.pytest_cache/
.ruff_cache/

# editor / agent backup cruft — the live harness tree carries suffixed forms
# (.bak-fleet-20260713, .bak-20260714-012512, .baseline); none belong in the repo
*.bak
*.bak-*
*.bak.*
*.baseline
*.orig

# python build artifacts
*.egg-info/

# vendored upstream clone inside a skill; a gitlink trips no-runtime-junk.
# MEASURED 2026-08-12: the rule covered `skills/` only, while the live curated tree carries the
# same 4.97 MB / 199-file checkout and the DUAL-WRITE mirror `.agents/skills/` was NOT ignored
# (`git check-ignore .agents/skills/crypto-ctf/RsaCtfTool/README.md` -> NOT-IGNORED, vs IGNORED
# for the `skills/` twin). A live->repo reconcile -- which is exactly what the skill-drift work
# does -- would therefore have swept a third-party clone into git through the mirror path.
skills/crypto-ctf/RsaCtfTool/
.agents/skills/crypto-ctf/RsaCtfTool/

# mitmproxy MCP traffic capture — runtime SQLite; the capture class can hold live tokens
mitm_mcp_traffic.db

# profile-capture hook runtime state. CARRIES RAW OWNER PII (date of birth, phone numbers)
# copied verbatim out of session text. This repo is PUBLIC — never commit these.
hooks/profile-capture/capture-queue.jsonl
hooks/profile-capture/seen.txt

# live Claude Code workflow deploy target. The repo's tracked home for authored workflows
# is agent-self/config/workflows/; one file dropped here carries owner PII.
.claude/workflows/

# packaged skill build artifact — the unpacked source is tracked in both skill roots
.agents/skills/*.zip

# Hook runtime state directories. Written by a running hook, never source.
# recall-gate/state/tree_index.json was measured to copy a summary line verbatim out of
# the scanned tree -- on 2026-08-08 that included a "BEGIN PRIVATE KEY" header lifted from
# a test fixture. This repo is PUBLIC; hook state is a capture surface, not an artifact.
hooks/*/state/

# agent probe outputs — regenerable; the probe SCRIPTS are kept as provenance
**/_*_out.json
**/_*_out.err
**/_*_out.txt
.ruff_cache/
command-center/catalog-slices/_*.py
command-center/_*.py
platform/**/_probe_*.py
platform/**/_patch_*.py
platform/**/_gen_*.py
platform/**/_lane*.py
platform/**/_build_*.py

# EXCEPTION, and it is load-bearing: four TRACKED tests execute this generator.
# `platform/lib/test_schema_resolver.py:553` hardcodes
# `GENERATOR = "platform/lib/_gen_schema_substrate.py"` and runs it via subprocess in
# test_generator_output_matches_every_committed_file, _emits_lf_only, _is_deterministic and
# _leaves_the_real_tree_untouched. With the `_gen_*` rule above applying to it, those four
# tests CANNOT pass on a fresh clone -- measured: 6 failed / 3,909 passed on a clean
# `git clone` of main, all six from files the working tree had and the clone did not.
#
# Making them skip-when-absent instead would be worse: that is precisely the vacuous-pass
# shape `command-center/P13-SKIP-MASK-PROOF.json` exists to hunt. A generator that a
# committed test executes is SOURCE, not scratch.
!platform/lib/_gen_schema_substrate.py

# plugin build output. The distributable ZIP is regenerated by one command
# (`python platform/plugin/astplugin.py build`) and is byte-identical for identical content,
# so the artifact itself is not source. Its measured size/sha/member list is recorded in the
# tracked platform/plugin/PACKAGE-MEASUREMENT.json.
platform/plugin/dist/
