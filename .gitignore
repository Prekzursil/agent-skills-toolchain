# secrets & credentials — never version
secrets/
secure-evidence/
local.json
*.token
*token*.json
*credential*
*.pem
*.key
.env
.env.*

# runtime / generated / caches
generated/
logs/
tmp/
state/
backups/
deploy-backups/
.pytest_cache/
.ruff_cache/
.sonar/
__pycache__/
node_modules/

# 2026-09-25 (P5): the comment that used to sit here claimed rules/ was "a junction into
# ~/.claude/rules — versioned in its own home". BOTH halves were false, measured:
#   rules/ LinkType=[] Target=[]           -> a real directory, not a junction
#   git -C ~/.claude rev-parse             -> "fatal: not a git repository", on either host
# Net effect: the rules corpus was version-controlled NOWHERE, and rules authored on the
# disposable VM existed only on the VM. rules/ is now TRACKED.
# If a deploy target ever lands under the repo, ignore THAT exact path, never the corpus.
mcp-servers/
audit-quarantine-*/

# policy-sweep backups (residue)
*.bak-policy-*
*.bak-prepolicy-*
*.bak-20[0-9][0-9][0-9][0-9][0-9][0-9]-*

# router index: build artifact, regenerates via build_index.py
hooks/semantic-router/index/
