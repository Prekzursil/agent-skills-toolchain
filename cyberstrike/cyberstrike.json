        "timeout": 300000
      }
    },
    "nvidia": {
      "models": {
        "moonshotai/kimi-k3": {
          "name": "Kimi K3 (NVIDIA NIM Free)"
        },
        "gpt-5.6-daybreak-blue-latest": {
          "id": "moonshotai/kimi-k3",
