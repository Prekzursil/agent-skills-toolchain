        "timeout": 300000
      }
    },
    "zai": {
      "models": {
        "glm-5.3": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      },
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "timeout": 360000,
        "apiKey": "{env:ZAI_API_KEY_realprekzursil}"
      }
    },
    "zai-model-api": {
      "name": "Z.AI Coding Plan",
      "id": "zai-model-api",
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3 (Z.AI Coding Plan)",
          "options": {
            "reasoningEffort": "max"
