{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-harness/hook-event.schema.json",
  "title": "Normalized Hook Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "event",
    "session_id",
    "turn_id",
    "cwd",
    "permission_mode",
    "tool",
    "last_assistant_message",
    "prompt",
    "source",
    "trigger",
    "agent"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"enum": ["claude", "codex"]},
    "event": {"type": "string", "minLength": 1},
    "session_id": {"type": "string"},
    "turn_id": {"type": "string"},
    "cwd": {"type": "string"},
    "permission_mode": {"type": "string"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "input", "result"],
      "properties": {
        "name": {"type": "string"},
        "id": {"type": "string"},
        "input": {},
        "result": {}
      }
    },
    "last_assistant_message": {"type": "string"},
    "prompt": {"type": "string"},
    "source": {"type": "string"},
    "trigger": {"type": "string"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "transcript_path"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string"},
        "transcript_path": {"type": "string"}
      }
    }
  }
}

