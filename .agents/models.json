{
  "schemaVersion": 1,
  "description": "Hosted + local model endpoint registry (SSOT). Sibling of agents.json (MCP servers). Secrets by environment-variable NAME only. Capability lattice: native > probed{at,version} > declared > emulated > absent; a model row may only override an endpoint value downward. Validated by .agents/scripts/models_control_plane.py; provenance in .provenance/.agents/models.json.md.",
  "policy": {
    "capabilityProbe": {
      "ttlHours": 24
    },
    "localRamBudgetBytes": 8589934592,
    "defaultTimeoutMs": 60000,
    "hub": {
      "host": "127.0.0.1",
      "port": 8901,
      "idleExitSeconds": 600,
      "maxInFlightTotal": 16,
      "ledgerPath": "state/inference-ledger",
      "haltFile": ".agents/INFERENCE-HALT",
      "haltEnv": "INFERENCE_HALT"
    }
  },
  "locks": [
    {
      "id": "L1",
      "rule": "OpenRouter is a spend-capped CLI/Codex sidecar only: never Cursor BYOK, never Claude ANTHROPIC_BASE_URL, never a new OpenRouter MCP.",
      "enforcedBy": [
        "models_control_plane:V7",
        "models_control_plane:V14",
        "models_control_plane:V15"
      ]
    },
    {
      "id": "L2",
      "rule": "No LiteLLM proxy, no LangGraph, no second orchestration runtime, no vector-DB memory. Aider embedding the litellm library is a render target, not a proxy.",
      "enforcedBy": [
        "review"
      ]
    },
    {
      "id": "L3",
      "rule": "auth2api :8317 stays the only Cursor bridge and retires within 7 days of an official Cursor /v1 GA.",
      "enforcedBy": [
        "models_control_plane:V6",
        "models_control_plane:V13"
      ]
    },
    {
      "id": "L4",
      "rule": "Ports 8765 (basic-memory), 8812 (agent-mail), 8317 (auth2api), 8770 are owned; 8901 belongs to inference-hub, the only new resident process, and it idle-exits.",
      "enforcedBy": [
        "models_control_plane:V8"
      ]
    },
    {
      "id": "L5",
      "rule": ".agents/skills is the ONE prompt SSOT; profiles resolve to paths under it.",
      "enforcedBy": [
        "inference-hub:profile-resolver"
      ]
    },
    {
      "id": "L6",
      "rule": "Never rotate credentials; secrets by environment-variable NAME only; values are never written to any registry, log or report.",
      "enforcedBy": [
        "models_control_plane:V1",
        "models_control_plane:V2",
        "gate-secrets"
      ]
    },
    {
      "id": "L7",
      "rule": "Never remove a feature to buy simplicity or reliability; present the tradeoff. glm-5.3 stays reachable through inference-hub after the glm53-space lane is deleted.",
      "enforcedBy": [
        "models_control_plane:V10",
        "test_models_control_plane:glm53_capability_preserved"
      ]
    }
  ],
  "endpoints": {
