#!/usr/bin/env python3
r"""@@NAME@@/hook.py - FORGED tripwire discipline (@@CANON_EVENT@@, BLOCKING).

Generated by forge-discipline. This is a GATE: on a positive predicate it BLOCKS
the operation via the exit-2 path (reason written to stderr, which Claude Code
feeds back to the model). On anything else it exits 0 and is invisible.

A gate is NEVER folded into the in-process dispatcher (which only ever exits 0);
it installs as its own settings.json PreToolUse/UserPromptSubmit command entry.

FAIL-OPEN by design: malformed stdin, a predicate error, a MISSING OR BROKEN
tripwire.py, or the opt-out (env @@ENV_OFF@@=1 / a .disabled file) all -> exit 0
(allow). The tripwire import lives INSIDE the guard precisely so a corrupted
predicate module fails open instead of exiting non-zero. A crashing gate that
blocked (or errored on) every command would be far worse than a silent one.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

THIS = Path(__file__).resolve().parent
DISABLED = THIS / ".disabled"


def _disabled() -> bool:
    return DISABLED.exists() or os.environ.get("@@ENV_OFF@@", "").lower() in ("1", "on", "true")


def main(argv=None) -> int:
    try:
        if _disabled():
            return 0
        # Import the predicate INSIDE the try so a missing/broken tripwire.py
        # fails OPEN (exit 0) - never blocks, never exits non-zero. (Sibling
        # module; this is a standalone process, so no dispatcher name collision.)
        sys.path.insert(0, str(THIS))
        import tripwire

        raw = sys.stdin.read() or "{}"
        try:
            payload = json.loads(raw)
        except Exception:
            return 0  # fail-open: garbage stdin never blocks
        if not isinstance(payload, dict):
            return 0
        halt, reason = tripwire.should_halt(payload)
        if halt:
            sys.stderr.write(str(reason) + "\n")
            sys.stderr.flush()
            return 2  # BLOCK: exit-2 path; reason -> model
    except Exception:
        return 0  # fail-open: any error -> allow
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
