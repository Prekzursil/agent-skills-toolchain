{
  "_comment": "Merge these two keys into the `hooks` object of ~/.claude/settings.json (alongside SessionStart/Stop/etc.). install.ps1 -PatchSettings does this for you.",
  "WorktreeCreate": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:/Users/Prekzursil/.claude/hooks/create-worktree.ps1\"",
          "timeout": 60,
          "statusMessage": "Creating git worktree"
        }
      ]
    }
  ],
  "WorktreeRemove": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:/Users/Prekzursil/.claude/hooks/remove-worktree.ps1\"",
          "timeout": 30,
          "statusMessage": "Removing git worktree"
        }
      ]
    }
  ]
}
