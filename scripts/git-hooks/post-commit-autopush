#!/bin/sh
# AUTOPUSH-HOOK-MARKER post-commit-autopush v1
#   ^ the installer greps for this line to detect an existing install.
#     Without it install-autopush.ps1 is not idempotent and -Uninstall
#     silently finds nothing. Do not remove or rename it.
# post-commit: push immediately. A commit that is not pushed is a commit that
# can be lost.
#
# Owner instruction 2026-09-24: "make it a must that commits are always pushed,
# its better that they live there instead of being lost since the cursor branch
# had insane amount of progress and werent pushed and now are lost".
#
# DESIGN RULES
#  - FAILS OPEN. A push failure must never fail the commit. A blocked commit is
#    strictly worse than an unpushed one: the work would not even exist locally.
#  - NEVER --force, --force-with-lease or -f. NEVER --no-verify. Those stay
#    refused by estate-deny-guard and this hook must not try to route around it.
#  - Silent success, LOUD failure. Every attempt is logged, so a repo that
#    quietly stopped pushing is visible instead of assumed fine.
#  - Skips mid-operation states. Pushing during a rebase/merge/cherry-pick
#    publishes a half-finished tree.
#
# Opt out for one command:  GIT_AUTOPUSH_OFF=1 git commit ...
# Log: ~/.agents/logs/autopush.log

set -u
LOG="${HOME}/.agents/logs/autopush.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG" 2>/dev/null || true; }

[ "${GIT_AUTOPUSH_OFF:-0}" = "1" ] && { log "SKIP opt-out GIT_AUTOPUSH_OFF=1"; exit 0; }

GITDIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0
REPO=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo '?')")

# mid-operation: a rebase/merge/cherry-pick tree is not a publishable state
for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    if [ -e "$GITDIR/$marker" ]; then
        log "SKIP $REPO mid-operation ($marker)"
        exit 0
    fi
done

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || {
    log "SKIP $REPO detached HEAD"
    exit 0
}
[ -z "$BRANCH" ] && exit 0

git remote get-url origin >/dev/null 2>&1 || {
    log "SKIP $REPO no origin remote"
    exit 0
}

SHA=$(git rev-parse --short HEAD 2>/dev/null)

if git rev-parse --abbrev-ref "$BRANCH@{upstream}" >/dev/null 2>&1; then
    OUT=$(git push origin "$BRANCH" 2>&1)
    RC=$?
else
    # first push of a new branch: establish tracking so later pushes just work
    OUT=$(git push -u origin "$BRANCH" 2>&1)
    RC=$?
fi

if [ $RC -eq 0 ]; then
    log "SUCCESS:autopush $REPO $BRANCH $SHA"
else
    log "FAILED:autopush $REPO $BRANCH $SHA rc=$RC"
    log "  $(printf '%s' "$OUT" | tr '\n' ' ' | cut -c1-300)"
    # Loud on stderr so it is visible in the session, but exit 0: the commit stands.
    printf '\n  [autopush] PUSH FAILED for %s on %s (%s)\n' "$REPO" "$BRANCH" "$SHA" >&2
    printf '  [autopush] %s\n' "$(printf '%s' "$OUT" | tr '\n' ' ' | cut -c1-200)" >&2
    printf '  [autopush] The commit is SAFE locally but NOT on the remote. Push it manually.\n' >&2
fi
exit 0
