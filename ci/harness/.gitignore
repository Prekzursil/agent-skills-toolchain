# ci/harness excludes — runtime state & local artifacts, never source.
# Machine-specific install manifest (sha256 of live settings + an absolute backup path).
installed.json
# Local pre-edit backups (author's .bak files + timestamped install-backup dirs).
backups/
*.bak
*.bak-*
# Python / test tool caches.
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
