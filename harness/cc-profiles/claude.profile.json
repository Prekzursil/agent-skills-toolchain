{
  "name": "claude",
  "auth": "subscription OAuth: all ANTHROPIC_* overrides removed; first run: /login once. API-key variant: launch with $env:ANTHROPIC_API_KEY set (process-scoped, nothing written to disk). Cyber-clean MCP posture + failover hook removed + glm plugins off",
  "env_remove": [
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_OPUS_MODEL",
    "API_TIMEOUT_MS",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW"
  ],
  "env_set": {},
  "top_set": {
    "model": "claude-opus-5-5",
    "fallbackModel": [
      "claude-sonnet-5"
    ],
