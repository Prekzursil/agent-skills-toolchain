{
  "_note": "additive --settings payload for cc-glm on a claude base. Token travels via process env, never on disk.",
  "model": "glm-5.3[1m]",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3[1m]",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit|billing_error|authentication_failed",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/Prekzursil/.agents/scripts/zai_key_failover.py\" --on-failure",
            "timeout": 60,
            "statusMessage": "Z.ai key auto-rotate on exhausted/auth failure"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "ralph-orchestrator",
    "repomix",
    "excel",
    "firecrawl",
    "tavily",
    "binary-ninja-mcp",
    "ghidra-mcp",
    "ida-pro-mcp",
    "frida-mcp",
    "cheatengine",
    "hexstrike-ai",
    "markitdown",
    "angr",
    "cloud-hub",
    "figma",
    "playwright",
    "schrodinger",
    "social-hub",
    "search-hub",
    "playwright-extension",
    "playwright-cdp",
    "brightdata",
    "nuclei",
    "osint",
    "cve-mcp",
    "github-security",
    "cloud-audit",
    "mitmproxy",
    "semgrep",
    "cve",
    "firecrawl-kit",
    "hacktricks",
    "metasploit",
    "sliver",
    "sliver-full",
    "agent-mail",
    "basic-memory",
    "context7",
    "apify",
    "github",
    "cursor-bridge",
    "burp"
  ]
}