  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 4,
    "prep_time_minutes": 30,
    "required_artifacts": [
      "evidence_pack",
      "prior_art_scan",
      "risk_list"
    ]
  },
  "topology": {
    "kind": "red_blue",
    "caucuses": [
      {
        "caucus_id": "red",
        "members": [
          "red-1",
          "red-2",
          "red-3",
          "red-4"
        ],
        "private_rounds": 1
      },
      {
        "caucus_id": "blue",
        "members": [
          "blue-1",
          "blue-2",
          "blue-3"
        ],
        "private_rounds": 1
      }
    ],
    "committees": [
      {
        "committee_id": "admissibility",
        "mandate": "deception screen on external artifacts",
        "members": [
          "legal-ethics",
          "privacy",
          "white-cell"
        ]
      }
    ]
  },
  "protocol": {
    "sequence": [
      {
        "kind": "custom",
        "stage_id": "deception-screen",
        "custom_name": "screen every external artifact before it may be cited",
        "participants": [
          "legal-ethics",
          "privacy",
          "white-cell"
        ],
        "exit_when": {
          "any_of": [
            {
              "metric": "prompt_injection_detected",
              "op": "==",
              "value": false,
              "note": "clean screen: artifacts may be cited"
            },
            {
              "metric": "prompt_injection_detected",
              "op": "==",
              "value": true,
              "note": "a detected injection does NOT stop the council - it quarantines the artifact and is itself a finding"
            }
          ]
        }
      },
      {
        "kind": "custom",
        "stage_id": "stride-sweep",
        "custom_name": "one candidate attack per STRIDE category, minimum",
        "quotas": {
          "objections_per_participant": 3
        }
      },
      {
        "kind": "war_game",
        "stage_id": "attack-run",
        "rounds": 3
      },
      {
        "kind": "premortem",
        "stage_id": "what-we-missed"
      },
      {
        "kind": "synthesis",
        "stage_id": "threat-model"
      }
    ],
    "speaking_order": "simultaneous",
    "rounds": {
      "min": 4,
      "max": 8,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 700
    },
    "obligations": {
      "must_cite_evidence": true,
      "cross_examination": true,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "maximally_adversarial",
    "experiments": {
      "allowed": true,
      "max_experiments": 24,
      "required_before_decision": true,
      "runner": "sandbox"
    }
  },
  "budgets": {
    "effort": "max",
    "time_minutes": 180,
    "tool_calls": 600,
    "sources": 60,
    "turns": 90,
    "experiments": 24,
    "rebuttal_depth": 3
  },
  "targets": {
    "categories": 6,
    "counterexamples": 12,
    "objections": 18,
    "evidence_items": 30,
    "coverage_score": 0.9
  },
  "voting": {
    "method": "judge",
    "quorum": {
      "min_voters": 1,
      "on_failure": "escalate_to_owner"
    },
    "veto": {
      "holders": [
        "privacy",
        "legal-ethics"
      ],
      "scope": "safety_only",
      "must_justify": true,
      "overridable_by_owner": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "judge"
  },
  "consensus": {
    "measure": "vote_share",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": false
  },
  "stopping": {
    "source_expression": "categories_covered >= 6 AND experiments_passed >= 2 AND executable_test_settled == true",
    "expression": {
      "all_of": [
        {
          "metric": "categories_covered",
          "op": ">=",
          "value": 6
        },
        {
          "metric": "experiments_passed",
          "op": ">=",
          "value": 2
        },
        {
          "metric": "executable_test_settled",
          "op": "==",
          "value": true
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 4,
      "min_evidence_items": 20,
      "min_objections_addressed": 8,
      "every_participant_spoke": true
    },
    "hard_caps": {
      "max_rounds": 8,
      "max_minutes": 180,
      "on_cap": "escalate_to_owner"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "dissent",
      "irreducible_disagreement",
      "no_decision",
      "conditional_decision",
      "proof_of_impossibility",
      "minority_report"
    ],
    "conditional_decision_requires": [
      "every landed attack has a named mitigation and a detection"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.9,
      "circular_citation_check": true
    },
    "resolution": [
      "run_experiment",
      "strongest_counterexample",
      "recruit_independent_critic",
      "judge_ruling",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "evidence_free_majority",
      "consensus_failing_executable_tests",
      "prompt_injection",
      "hallucinated_expertise",
      "role_collapse",
      "lost_dissent",
      "collusion",
      "missing_expertise"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "evidence_map",
      "experiments",
      "argument_graph",
      "dissent_minority_report",
      "unresolved_unknowns",
      "action_plan",
      "final_recommendation",
      "decision_lineage",
      "resumable_state"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "pii_policy": "redact",
      "retain_days": 365
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "Deep security threat model (4 red, 3 blue, privacy, legal, white cell)",
    "owner": "Prekzursil",
    "lineage": [
      "C-D32 deep-security-threat-model-10",
      "P08 red-blue-team",
      "P41 deception-detection",
      "P43 premortem"
    ],
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:1605-1618"
    ],
    "notes": "DESIGN LINEAGE: C-D32 deep-security-threat-model-10 in 12-COUNCIL-PROTOCOLS-AND-PRESETS.md (seats: 10; roles: red_x4,blue_x3,privacy,legal_ethics,white_cell).\nPRESET LABEL: security_red_blue_council - same archetype as C-S17 at the DEEP tier. The archetype label is intentionally shared; council_id distinguishes them (c-s17-red-blue-4 is the 45-minute standard form, this is the 3-hour form with a STRIDE coverage gate and two required reproductions).\nOUTCOME MAPPING (card vocabulary -> schema outcomes.allowed): CONSENSUS->decision, MAJORITY_WITH_DISSENT->dissent, IRREDUCIBLE_DISAGREEMENT->irreducible_disagreement, INSUFFICIENT_EVIDENCE->no_decision, CONDITIONAL_DECISION->conditional_decision, DEFER->no_decision, PROOF_OF_IMPOSSIBILITY->proof_of_impossibility, MINORITY_REPORT->minority_report.\nEDITABLE DIALS (pointer -> what it changes):\n  - $.protocol.sequence[1] + $.targets.categories : attack_surface dial - swap STRIDE for another taxonomy by changing categories and the stage's custom_name\n  - $.stopping.expression experiments_passed : reproduction_quota dial (card default 2)\n  - $.protocol.experiments.runner : sandbox - do NOT set this to local for an attack-reproduction council\n  - $.voting.veto.holders : who can stop a finding from being published\nThe deception-screen stage's exit_when accepts BOTH values of prompt_injection_detected on purpose: a detected injection must not halt the council, it must quarantine the artifact and become a finding. A stage that can only exit on 'clean' is a denial-of-service on your own threat model.\nEVERY field in this file is a dial; the ones above are the ones the owner is expected to change first. See README.md in this directory for the full table."
  }
}
