        "vendor": "anthropic",
        "role": "facilitator",
        "authority": "chair",
        "effort": "medium",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      }
    ],
    "anonymity": {
      "mode": "pseudonymous",
      "reveal_after_round": 3
    },
    "conflicts_policy": {
      "disclosure_required": false,
      "on_conflict": "disclose_only"
    },
    "duplicate_detection": {
      "enabled": true,
      "dimensions": [
        "position_similarity"
      ],
      "max_similarity": 0.8
    }
  },
  "preparation": {
    "research_required": false,
    "independent_prep": true
  },
  "topology": {
    "kind": "chair_led",
    "chair": "facilitator"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "nominal_group",
        "stage_id": "silent-generation",
        "independent": true,
        "anonymous": true,
        "quotas": {
          "ideas_per_participant": 4
        }
      },
      {
        "kind": "round_robin",
        "stage_id": "clarification-only",
        "rounds": 1
      },
      {
        "kind": "custom",
        "stage_id": "independent-rank",
        "custom_name": "independent ranking, no discussion",
        "independent": true
      },
      {
        "kind": "synthesis",
        "stage_id": "aggregate"
      }
    ],
    "speaking_order": "round_robin",
    "rounds": {
      "min": 4,
      "max": 4
    },
    "turn": {
      "max_words": 250
    },
    "obligations": {
      "must_respond_to_prior": false
    },
    "critique_intensity": "gentle"
  },
  "budgets": {
    "effort": "medium",
    "time_minutes": 25,
    "turns": 28,
    "tool_calls": 30
  },
  "targets": {
    "unique_ideas": 24,
    "raw_ideas": 28,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.8,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "ranked_choice",
    "quorum": {
      "min_voters": 5,
      "on_failure": "extend_rounds"
    },
    "abstention": {
      "allowed": false,
      "counts_toward_quorum": false
    },
    "tie_break": "chair"
  },
  "consensus": {
    "threshold": 0.5,
    "measure": "pairwise_agreement",
    "minority_report": "optional",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": false
    }
  },
  "stopping": {
    "source_expression": "rounds_elapsed >= 4 AND unique_ideas >= 24 AND all_participants_spoke == true",
    "expression": {
      "all_of": [
        {
          "metric": "rounds_elapsed",
          "op": ">=",
          "value": 4
        },
        {
          "metric": "unique_ideas",
          "op": ">=",
          "value": 24
        },
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 4,
      "every_participant_spoke": true,
      "min_independent_positions": 6
    },
    "hard_caps": {
      "max_rounds": 4,
      "max_minutes": 25,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "dissent"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2
    },
    "resolution": [
      "chair_ruling",
      "narrow_scope"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "chair"
    }
  },
  "anti_failure": {
    "controls": [
      "idea_count_gaming",
      "duplicate_novelty",
      "participant_dominance",
      "premature_convergence",
      "prompt_injection"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "idea_catalog",
      "option_cards",
      "votes_by_round",
      "transcript",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "pii_policy": "redact",
      "retain_days": 30
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "Nominal group technique (6 generators + facilitator)",
    "owner": "Prekzursil",
    "lineage": [
      "C-S22 nominal-group-6",
      "P06 nominal-group-technique"
    ],
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:1457-1470"
    ],
    "notes": "DESIGN LINEAGE: C-S22 nominal-group-6 in 12-COUNCIL-PROTOCOLS-AND-PRESETS.md (seats: 6; roles: generalist_x6,facilitator).\nPRESET LABEL: custom - option_enumeration is not one of the 24 required archetypes. roadmap_prioritization is adjacent but is about prioritising a roadmap, not enumerating an option space.\nOUTCOME MAPPING (card vocabulary -> schema outcomes.allowed): CONSENSUS->decision, MAJORITY_WITH_DISSENT->dissent.\nEDITABLE DIALS (pointer -> what it changes):\n  - $.targets.unique_ideas + $.stopping.expression unique_ideas : idea_cap dial. These two MUST move together: SEM-007 fails the spec if the stopping threshold exceeds targets.unique_ideas\n  - $.protocol.sequence[0].quotas.ideas_per_participant : ideas demanded per seat in silent generation\n  - $.participants.anonymity.reveal_after_round : when pseudonyms are unmasked\nSEAT DISCREPANCY (measured): the card says seats:6 but its roles line enumerates 7 (generalist_x6 + facilitator). This instance seats 7 - the facilitator is non-voting, which is the likely reason the card's count excluded it.\nEVERY field in this file is a dial; the ones above are the ones the owner is expected to change first. See README.md in this directory for the full table."
  }
}
