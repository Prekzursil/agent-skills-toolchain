{
  "schema_version": "1.0.0",
  "council_id": "c-s22-nominal-group-6",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Enumerate the option space by silent independent generation, then a clarification-only round, then independent ranking.",
    "charter": "Nominal group technique. The clarification round may contain NO evaluative sentence - evaluation there is what collapses independence and produces anchoring.",
    "risk_tier": "low",
    "desired_output": "ranked_options",
    "success_criteria": [
      "generation was silent and independent - no seat saw another before submitting",
      "the clarification round contained zero evaluative sentences",
      "ranking was independent, not discussed"
    ],
    "consensus_intent": "elicit_distribution",
    "evidence_requirements": {
      "citation_required": false,
      "anchor_style": "any"
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "model_diverse"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 7,
      "min": 7,
      "max": 7
    },
    "diversity": {
      "min_distinct_vendors": 3
    },
