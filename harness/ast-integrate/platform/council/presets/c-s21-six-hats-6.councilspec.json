    ],
    "conflicts_policy": {
      "disclosure_required": false,
      "on_conflict": "disclose_only"
    }
  },
  "preparation": {
    "research_required": false,
    "independent_prep": false
  },
  "topology": {
    "kind": "flat"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "six_hats",
        "stage_id": "round-white",
        "rounds": 1
      },
      {
        "kind": "six_hats",
        "stage_id": "round-red",
        "rounds": 1
      },
      {
        "kind": "six_hats",
        "stage_id": "round-black",
        "rounds": 1
      },
      {
        "kind": "six_hats",
        "stage_id": "round-yellow",
        "rounds": 1
      },
      {
        "kind": "six_hats",
        "stage_id": "round-green",
        "rounds": 1
      },
      {
        "kind": "six_hats",
        "stage_id": "round-blue",
        "rounds": 1
      },
      {
        "kind": "synthesis",
        "stage_id": "blue-synthesis"
      }
    ],
    "speaking_order": "round_robin",
    "rounds": {
      "min": 6,
      "max": 6
    },
    "turn": {
      "max_words": 300
    },
    "obligations": {
      "must_respond_to_prior": false
    },
    "critique_intensity": "gentle"
  },
  "budgets": {
    "effort": "medium",
    "time_minutes": 30,
    "turns": 42,
    "tool_calls": 40
  },
  "targets": {
    "unique_ideas": 18,
    "categories": 6
  },
  "voting": {
    "method": "synthesis_only",
    "tie_break": "chair"
  },
  "consensus": {
    "measure": "agreement_index",
    "minority_report": "optional",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": false
    }
  },
  "stopping": {
    "source_expression": "rounds_elapsed >= 6 AND all_participants_spoke == true",
    "expression": {
      "all_of": [
        {
          "metric": "rounds_elapsed",
          "op": ">=",
          "value": 6
        },
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 6,
      "every_participant_spoke": true
    },
    "hard_caps": {
      "max_rounds": 6,
      "max_minutes": 30,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "dissent",
      "no_decision",
      "conditional_decision"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 3
    },
    "resolution": [
      "chair_ruling",
      "declare_no_decision"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "chair"
    }
  },
  "anti_failure": {
    "controls": [
      "role_collapse",
      "silence",
      "weak_synthesis",
      "prompt_injection"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "idea_ledger",
      "transcript",
      "final_recommendation",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "pii_policy": "redact",
      "retain_days": 30
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "Six hats rotation (6 seats, one hat per round)",
    "owner": "Prekzursil",
    "lineage": [
      "C-S21 six-hats-6",
      "P30 six-hats-rotation"
    ],
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:1443-1456"
    ],
    "notes": "DESIGN LINEAGE: C-S21 six-hats-6 in 12-COUNCIL-PROTOCOLS-AND-PRESETS.md (seats: 6; roles: any_x6 (synchronised hats)).\nPRESET LABEL: custom - exploration is not one of the 24 required archetypes.\nOUTCOME MAPPING (card vocabulary -> schema outcomes.allowed): CONSENSUS->decision, MAJORITY_WITH_DISSENT->dissent, INSUFFICIENT_EVIDENCE->no_decision, CONDITIONAL_DECISION->conditional_decision, DEFER->no_decision.\nEDITABLE DIALS (pointer -> what it changes):\n  - $.protocol.sequence : hat_order dial - reorder the six stages to change the hat order\n  - $.protocol.turn.max_words : how much each seat may say per hat\n  - $.targets.unique_ideas : expected idea yield (6 seats x 3); NOT gated by the stopping rule, so lowering it cannot stall the council\nThe card's roles line is 'any_x6', so the roster uses domain_expert for every seat and carries the hat in display_name + expertise. The hat is a STAGE property here, not a seat property - that is what 'synchronised hats' means.\nEVERY field in this file is a dial; the ones above are the ones the owner is expected to change first. See README.md in this directory for the full table."
  }
}
