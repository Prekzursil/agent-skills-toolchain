{
  "schema_version": "1.0.0",
  "council_id": "c-s21-six-hats-6",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Explore a question from all six de Bono perspectives, one hat per round, with off-hat contributions rejected.",
    "charter": "Six-hats rotation. Every seat wears the SAME hat in a given round; the value comes from synchronised perspective, so an off-hat contribution is rejected, not merged.",
    "risk_tier": "low",
    "desired_output": "recommendation",
    "success_criteria": [
      "all six hats ran, in order",
      "no off-hat contribution was accepted into the ledger"
    ],
    "consensus_intent": "surface_disagreement",
    "evidence_requirements": {
      "citation_required": false,
      "anchor_style": "any"
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 6,
      "min": 6,
      "max": 6
    },
    "diversity": {
      "min_distinct_vendors": 2
    },
