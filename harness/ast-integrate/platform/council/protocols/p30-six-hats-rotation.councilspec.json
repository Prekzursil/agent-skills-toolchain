{
  "schema_version": "1.0.0",
  "council_id": "p30-six-hats-rotation",
  "participation": "hybrid",
  "objective": {
    "statement": "Separate facts, intuition, risk, upside, alternatives and process by making ALL seats wear the SAME hat at the same time and rotate together, one hat per round.",
    "charter": "Parallel same-mode thinking. Every other role protocol assigns DIFFERENT lenses simultaneously; this one deliberately assigns the same one so each mode is done properly once instead of badly six times.",
    "risk_tier": "low",
    "desired_output": "recommendation",
    "success_criteria": [
      "all six hats were worn, in order, by every seat",
      "the off-hat contribution rate is at or below 5% - the chair rejected the rest",
      "the green-hat round produced alternatives that no other round produced"
    ],
    "consensus_intent": "surface_disagreement",
    "evidence_requirements": {
      "citation_required": false,
      "anchor_style": "any",
      "evidence_outranks_votes": true
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "stakeholder_balanced",
        "model_diverse"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 5
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 3,
      "max_share_per_vendor": 0.6
    },
    "roster": [
      {
        "participant_id": "blue-hat-chair",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "role": "facilitator",
        "authority": "chair",
        "effort": "high",
        "independence": {
          "sees_peers_before_first_position": true,
          "fresh_context": false
        },
        "expertise": [
          "process control",
          "off-hat rejection"
        ],
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "context": {
          "briefing": "You hold the blue hat permanently: reject any off-hat contribution on sight."
        }
      },
      {
        "participant_id": "hat-seat-a",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "role": "domain_expert",
        "authority": "voter",
        "effort": "high",
        "independence": {
          "sees_peers_before_first_position": true,
          "fresh_context": false
        },
        "expertise": [
          "the decision domain"
        ]
      },
      {
        "participant_id": "hat-seat-b",
        "kind": "agent",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "role": "domain_expert",
        "authority": "voter",
        "effort": "high",
        "independence": {
          "sees_peers_before_first_position": true,
          "fresh_context": false
        },
        "expertise": [
          "the decision domain"
        ]
      },
      {
        "participant_id": "hat-seat-c",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "role": "risk_officer",
        "authority": "voter",
        "effort": "high",
        "independence": {
          "sees_peers_before_first_position": true,
          "fresh_context": false
        },
        "expertise": [
          "risk analysis"
        ]
      },
      {
        "participant_id": "hat-seat-d",
        "kind": "agent",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "role": "user_advocate",
        "authority": "voter",
        "effort": "high",
        "independence": {
          "sees_peers_before_first_position": true,
          "fresh_context": false
        },
        "expertise": [
          "end-user impact"
        ]
      }
    ],
    "role_templates": [
      "domain_expert",
      "risk_officer",
      "user_advocate",
      "facilitator"
    ],
    "replacement": {
      "enabled": true,
      "triggers": [
        "role_collapse",
        "inactivity",
        "dominance"
      ],
      "preserve_prior_positions": true
    },
    "duplicate_detection": {
      "enabled": true,
      "dimensions": [
        "position_similarity"
      ],
      "max_similarity": 0.85
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": false,
    "min_sources": 2,
    "required_artifacts": [
      "evidence_pack"
    ]
  },
  "topology": {
    "kind": "chair_led",
    "chair": "blue-hat-chair"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "six_hats",
        "stage_id": "white-facts",
        "rounds": 1,
        "participants": [
          "hat-seat-a",
          "hat-seat-b",
          "hat-seat-c",
          "hat-seat-d"
        ]
      },
      {
        "kind": "six_hats",
        "stage_id": "red-intuition",
        "rounds": 1,
        "participants": [
          "hat-seat-a",
          "hat-seat-b",
          "hat-seat-c",
          "hat-seat-d"
        ]
      },
      {
        "kind": "six_hats",
        "stage_id": "black-risk",
        "rounds": 1,
        "participants": [
          "hat-seat-a",
          "hat-seat-b",
          "hat-seat-c",
          "hat-seat-d"
        ],
        "quotas": {
          "objections_per_participant": 2,
          "counterexamples_per_round": 2
        }
      },
      {
        "kind": "six_hats",
        "stage_id": "yellow-upside",
        "rounds": 1,
        "participants": [
          "hat-seat-a",
          "hat-seat-b",
          "hat-seat-c",
          "hat-seat-d"
        ]
      },
      {
        "kind": "six_hats",
        "stage_id": "green-alternatives",
        "rounds": 1,
        "participants": [
          "hat-seat-a",
          "hat-seat-b",
          "hat-seat-c",
          "hat-seat-d"
        ],
        "quotas": {
          "ideas_per_participant": 3,
          "novel_ideas_per_round": 3
        }
      },
      {
        "kind": "custom",
        "custom_name": "blue_hat_process_review_and_off_hat_audit",
        "stage_id": "blue-process",
        "rounds": 1,
        "participants": [
          "blue-hat-chair"
        ],
        "exit_when": {
          "metric": "custom:off_hat_contribution_rate",
          "op": "<=",
          "value": 0.05,
          "value_type": "number"
        }
      },
      {
        "kind": "synthesis",
        "stage_id": "converge"
      }
    ],
    "speaking_order": "round_robin",
    "rounds": {
      "min": 6,
      "max": 7
    },
    "turn": {
      "max_words": 400,
      "time_limit_seconds": 240
    },
    "obligations": {
      "must_respond_to_prior": false,
      "must_cite_evidence": false,
      "steelman_before_rebuttal": true,
      "rebuttal_required": false,
      "cross_examination": false,
      "declare_confidence": true,
      "declare_conflicts": false
    },
    "critique_intensity": "gentle"
  },
  "budgets": {
    "effort": "medium",
    "time_minutes": 60,
    "turns": 35,
    "speaking_quota_per_participant": 7,
    "min_engagement_turns": 6,
    "max_inactivity_rounds": 1
  },
  "targets": {
    "unique_ideas": 12,
    "categories": 6,
    "novelty_ratio": 0.5,
    "objections": 8,
    "counterexamples": 8,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.85,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "synthesis_only",
    "abstention": {
      "allowed": false,
      "must_justify": true
    },
    "evidence_gate": {
      "reject_evidence_free_majority": true
    },
    "tie_break": "owner"
  },
  "consensus": {
    "measure": "agreement_index",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "ALL[rounds_elapsed >= 6, all_participants_spoke == true, custom:off_hat_contribution_rate <= 0.05, custom:hats_worn >= 6]",
    "expression": {
      "all_of": [
        {
          "metric": "rounds_elapsed",
          "op": ">=",
          "value": 6
        },
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true
        },
        {
          "metric": "custom:off_hat_contribution_rate",
          "op": "<=",
          "value": 0.05,
          "value_type": "number"
        },
        {
          "metric": "custom:hats_worn",
          "op": ">=",
          "value": 6,
          "value_type": "number"
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 6,
      "min_independent_positions": 4,
      "every_participant_spoke": true
    },
    "hard_caps": {
      "max_rounds": 7,
      "max_minutes": 75,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "no_decision",
      "minority_report",
      "dissent"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.9
    },
    "resolution": [
      "rotate_roles",
      "narrow_scope",
      "chair_ruling",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "role_collapse",
      "echo_chamber",
      "participant_dominance",
      "silence",
      "premature_convergence",
      "moderator_capture",
      "lost_dissent"
    ],
    "fast_unanimity_response": [
      "role_rotation",
      "forced_dissent",
      "strongest_counterexample"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "transcript",
      "idea_ledger",
      "unresolved_unknowns",
      "dissent_minority_report",
      "final_recommendation",
      "action_plan"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "best_effort",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "any action outside the council transcript",
        "any write to a shared branch"
      ]
    },
    "persistence": {
      "store": "both",
      "path": "platform/council/state/p30-six-hats-rotation",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "P30 six hats rotation (GENERATIVE)",
    "owner": "Prekzursil",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:586",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:591",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:597",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:598"
    ],
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#P30 six-hats-rotation"
    ],
    "notes": "ANTI-FAILURE DEFENCES (7 declared): (1) role_collapse is THE failure mode of this protocol - the card's 'seats leak black-hat content into the yellow round' - and it is enforced by custom:off_hat_contribution_rate <= 0.05 as both the blue-hat stage exit and a stopping leaf, plus replacement on role_collapse; (2) echo_chamber is limited by same-hat parallel writing with respond-to-prior OFF inside a hat round; (3) participant_dominance is capped by speaking_quota_per_participant=7, one turn per hat; (4) silence is caught by min_engagement_turns=6 (a seat must speak in every hat) and abstention.allowed false; (5) premature_convergence is blocked by rounds.min=6 - no synthesis before all six hats; (6) moderator_capture is cut by giving the blue-hat chair no vote; (7) lost_dissent is met by minority_report=required with suppression_check, and outcomes.allowed carries minority_report. PARTICIPATION IS HYBRID because the card recommends this for owner-facing exploratory sessions, and tie_break=owner reflects that. UNVERIFIED: the 5% off-hat ceiling is a placeholder; the card's settling experiment is to classify contributions by hat with a KEYWORD CONTROL first - a classifier that has not been shown to fire on a known off-hat contribution measures nothing."
  }
}
