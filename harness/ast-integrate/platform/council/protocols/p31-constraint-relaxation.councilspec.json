  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 2,
    "required_artifacts": [
      "evidence_pack",
      "risk_list"
    ]
  },
  "topology": {
    "kind": "flat"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "custom",
        "custom_name": "constraint_enumeration_and_unrelaxable_marking",
        "stage_id": "enumerate",
        "rounds": 1,
        "participants": [
          "constraint-clerk",
          "unrelaxable-guard"
        ],
        "exit_when": {
          "all_of": [
            {
              "metric": "custom:constraints_enumerated",
              "op": ">=",
              "value": 1,
              "value_type": "number"
            },
            {
              "metric": "custom:unrelaxable_set_marked",
              "op": "==",
              "value": true,
              "value_type": "boolean"
            }
          ]
        }
      },
      {
        "kind": "custom",
        "custom_name": "single_constraint_removal_and_redecide",
        "stage_id": "relax-probe",
        "rounds": 1,
        "participants": [
          "relaxer-a",
          "relaxer-b",
          "relaxer-c",
          "relaxer-d"
        ],
        "independent": true,
        "quotas": {
          "ideas_per_participant": 2,
          "novel_ideas_per_round": 1
        },
        "exit_when": {
          "metric": "custom:unrelaxable_violations",
          "op": "<=",
          "value": 0,
          "value_type": "number"
        }
      },
      {
        "kind": "nominal_group",
        "stage_id": "rank-binding",
        "rounds": 1
      },
      {
        "kind": "custom",
        "custom_name": "owner_ratification_of_binding_constraints",
        "stage_id": "owner-ratify",
        "rounds": 1,
        "participants": [
          "owner",
          "unrelaxable-guard"
        ],
        "exit_when": {
          "metric": "owner_approved",
          "op": "==",
          "value": true
        }
      },
      {
        "kind": "synthesis",
        "stage_id": "constraint-spec"
      }
    ],
    "speaking_order": "simultaneous",
    "rounds": {
      "min": 2,
      "max": 4,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 700
    },
    "obligations": {
      "must_respond_to_prior": false,
      "must_cite_evidence": true,
      "steelman_before_rebuttal": true,
      "rebuttal_required": true,
      "cross_examination": true,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "adversarial",
    "experiments": {
      "allowed": true,
      "required_before_decision": false,
      "max_experiments": 3,
      "runner": "sandbox"
    }
  },
  "budgets": {
    "effort": "high",
    "time_minutes": 60,
    "turns": 25,
    "experiments": 3,
    "min_engagement_turns": 2,
    "max_inactivity_rounds": 1,
    "rebuttal_depth": 2
  },
  "targets": {
    "unique_ideas": 8,
    "categories": 3,
    "novelty_ratio": 0.4,
    "objections": 6,
    "evidence_items": 6,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.8,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "veto",
    "veto": {
      "holders": [
        "unrelaxable-guard",
        "owner"
      ],
      "scope": "safety_only",
      "must_justify": true,
      "overridable_by_owner": false
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true,
      "strategic_abstention_check": true
    },
    "tie_break": "owner"
  },
  "consensus": {
    "threshold": 0.7,
    "measure": "agreement_index",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "min_dissenters_to_block": 1,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "ALL[custom:binding_constraints_identified >= 1, custom:unrelaxable_violations <= 0, owner_approved == true, custom:constraints_enumerated >= 1]",
    "expression": {
      "all_of": [
        {
          "metric": "custom:binding_constraints_identified",
          "op": ">=",
          "value": 1,
          "value_type": "number"
        },
        {
          "metric": "custom:unrelaxable_violations",
          "op": "<=",
          "value": 0,
          "value_type": "number"
        },
        {
          "metric": "owner_approved",
          "op": "==",
          "value": true
        },
        {
          "metric": "custom:constraints_enumerated",
          "op": ">=",
          "value": 1,
          "value_type": "number"
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 2,
      "min_independent_positions": 4,
      "every_participant_spoke": true,
      "min_evidence_items": 4
    },
    "hard_caps": {
      "max_rounds": 4,
      "max_minutes": 90,
      "on_cap": "escalate_to_owner"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "owner ratification of every constraint the panel proposes to relax",
      "an explicit note for any constraint the panel could not classify as binding or slack"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.9
    },
    "resolution": [
      "run_experiment",
      "narrow_scope",
      "escalate_to_owner",
      "declare_no_decision"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "premature_convergence",
      "evidence_free_majority",
      "participant_dominance",
      "echo_chamber",
      "strategic_voting",
      "lost_dissent",
      "prompt_injection"
    ],
    "fast_unanimity_response": [
      "forced_dissent",
      "strongest_counterexample",
      "blind_re_evaluation"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "option_cards",
      "argument_ledger",
      "unresolved_unknowns",
      "dissent_minority_report",
      "votes_by_round",
      "transcript",
      "final_recommendation",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "seeded",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "relaxing any constraint at all",
        "any action that a relaxed constraint would have prevented"
      ]
    },
    "persistence": {
      "store": "both",
      "path": "platform/council/state/p31-constraint-relaxation",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "P31 constraint relaxation (GENERATIVE, OWNER-DECISION)",
    "owner": "Prekzursil",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:602",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:607",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:613",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:614"
    ],
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#P31 constraint-relaxation"
    ],
    "notes": "ANTI-FAILURE DEFENCES (7 declared): (1) the card's own failure mode is 'relaxing a safety non-negotiable', and it is defended THREE ways that must all hold - an enumerate stage that cannot exit until custom:unrelaxable_set_marked == true, a veto held by the guard AND the owner with overridable_by_owner=false, and a custom:unrelaxable_violations <= 0 leaf in both the probe stage exit and the stopping rule; (2) evidence_free_majority is blocked by reject_evidence_free_majority plus anchor_style=file_line - a constraint claim cites the charter line it comes from; (3) participant_dominance and (4) echo_chamber are cut by independent simultaneous single-constraint probes; (5) strategic_voting is checked by strategic_abstention_check plus must_justify on abstention, because abstaining on a relaxation you want is how a guard gets bypassed quietly; (6) lost_dissent is met by minority_report=required with suppression_check and outcomes.allowed carrying minority_report; (7) prompt_injection defence is on because constraints are read out of charter TEXT, which is untrusted data. FAST UNANIMITY: forced_dissent + strongest_counterexample + blind_re_evaluation. OWNER-DECISION: YES on the card, so owner_approved == true is a stopping-rule leaf - this council cannot self-certify a relaxation. UNVERIFIED: the card's required proof - assert the unrelaxable set is never selected by any seat, both-states, with a deliberate attempt - has not been run; custom:unrelaxable_violations is named in the lane's PRODUCERS map (platform/lib/council_protocols/_shared.py, republished in PROTOCOL-EXPECTATIONS-25-36.json) and NOT implemented, so today the guard is a prompt, not a mechanism."
  }
