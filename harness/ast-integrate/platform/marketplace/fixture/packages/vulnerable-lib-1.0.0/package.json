{
  "name": "vulnerable-lib",
  "version": "1.0.0",
  "channel": "stable",
  "kind": "library",
  "summary": "Carries an open high-severity advisory; the vulnerability gate must refuse it.",
  "description": "Publishes cleanly -- nothing about the package is malformed. What blocks it is the separately signed advisory list, which is the whole point: vulnerability status is DERIVED at install time, not stored on the package.",
  "license": {
    "spdx": "MIT",
    "notice_required": false,
    "aggregate_verified": true
  },
  "permissions": [
    "fs:read:packages/vulnerable-lib/**"
  ],
  "compatibility": {
    "platforms": ["any"],
    "clients": [
      { "id": "claude-code", "range": ">=2.0.0" }
    ]
  },
  "provenance": {
    "source": "https://fixture.invalid/vulnerable-lib",
    "source_revision": "dddddddddddddddddddddddddddddddddddddddd",
    "builder": "mkt-fixture/1.0.0",
    "reproducible": true
  },
  "payload_files": ["LICENSE", "README.md", "vuln.py"],
  "file_licenses": {
    "LICENSE": "MIT",
    "README.md": "MIT",
    "vuln.py": "MIT"
  },
  "categories": ["security"],
  "tags": ["fixture", "advisory"],
  "tests": "pytest platform/marketplace -k advisory"
}
