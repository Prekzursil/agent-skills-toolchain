 },
 "x_extensions": {
  "design_card": "09-WORKFLOW-BLUEPRINT-LIBRARY.md#BP-PLN-02 (doc-order 34 of 96)",
  "distinguishing_mechanism": "CONCURRENCY ADMISSION over PREDICTED footprints, with adverse inference on an unknown footprint and worktree isolation as the default. It shares the overlap primitive with BP-PLN-03 by REFERENCE, and their decisions differ: this one answers 'may these run at the same time', PLN-03 answers 'in what order do these land'. BP-IMP-02 EXECUTES in worktrees; this decides which units may run at all.",
  "measured_gap_closed": "worktree isolation appears in 9 of 329 executed workflows (2.7%). Making it the default for mutating units is the specific gap this closes.",
  "worked_example": {
   "name": "one shared file collapses two units into a serial group",
   "narrative": "Four units. u1 and u2 both touch src/app.py, so they must land in one serial group. u3 is disjoint and may run in parallel. u4's footprint could not be determined, so under adverse inference it overlaps everything and is serialised - which, because the overlap graph is connected through u4, pulls the whole set into one group. That is the correct, conservative answer.",
   "mechanism": "mechanisms.pairwise_overlap + mechanisms.serial_groups + mechanisms.assign_isolation",
   "input": {
    "path_sets": {
     "u1": [
      "src/app.py",
      "src/a.py"
     ],
     "u2": [
      "src/app.py",
      "src/b.py"
     ],
     "u3": [
      "docs/readme.md"
     ],
     "u4": null
    },
    "mutating": [
     "u1",
     "u2",
     "u3"
    ]
   },
   "expected": {
    "overlap_pairs": [
     [
      "u1",
      "u2"
     ],
     [
      "u1",
      "u4"
     ],
     [
      "u2",
      "u4"
     ],
     [
      "u3",
      "u4"
     ]
    ],
    "serial_groups": [
     [
      "u1",
      "u2",
      "u3",
      "u4"
     ]
    ],
    "isolation": {
     "u1": "worktree",
     "u2": "worktree",
     "u3": "worktree",
     "u4": "serial"
    }
   },
   "controls": [
    {
     "mutate": "give u4 the concrete footprint ['tests/test_c.py']",
     "expected_serial_groups": [
      [
       "u1",
       "u2"
      ],
      [
       "u3"
      ],
      [
       "u4"
      ]
     ],
     "why": "with u4's footprint known the graph splits into three components - which proves the UNKNOWN handling, not the arithmetic, produced the single group"
    }
   ]
  }
 }
