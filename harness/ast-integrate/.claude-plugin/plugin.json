{
  "name": "agent-skills-toolchain",
  "version": "0.3.0",
  "description": "Full configuration and toolchain repo for AI agents (Codex CLI, Claude Code, Gemini CLI): 370+ skills, 40+ MCP server configs, shared tool libraries, and platform config snapshots.",
  "author": {
    "name": "Prekzursil",
    "url": "https://github.com/Prekzursil"
  },
  "license": "UNLICENSED",
  "keywords": [
    "skills",
    "reverse-engineering",
    "scholarly-research",
    "drug-discovery",
    "codex",
    "agent-ops",
    "cloud"
  ],
  "compatibility": {
    "min_client": "1.0.0",
    "platforms": [
      "windows",
      "linux"
    ],
    "schema_version": 1
  },
  "entrypoints": [
    {
      "id": "longrun-sh",
      "kind": "script",
      "path": "scripts/longrun.sh",
      "interpreter": "bash",
      "min_version": "5"
    },
    {
      "id": "longrun-py",
      "kind": "script",
      "path": "scripts/longrun.py",
      "interpreter": "python3",
      "min_version": "3.11"
    }
  ]
}
