{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/schema/artifact.schema.json",
  "title": "artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["path"],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string" },
    "bytes": { "type": "integer", "minimum": 0 },
    "role": { "type": "string" },
    "exists": { "type": "boolean" }
  }
}
