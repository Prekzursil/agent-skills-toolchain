{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/command-center/schema/metric-inventory.schema.json",
  "title": "Release-gate metric inventory (B01 quality + B10 cost/stability)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "derivation",
    "b01_b10_receipts",
    "metrics"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "metric-inventory" },
    "derivation": { "type": "string", "minLength": 8 },
    "b01_b10_receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "polarity", "gate", "bucket", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "polarity": {
            "type": "string",
            "enum": ["higher_is_better", "lower_is_better"]
          },
          "gate": { "type": "boolean" },
          "bucket": { "type": "string", "enum": ["B01", "B10"] },
          "unit": { "type": "string" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
