{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/command-center/schema/council-spec.schema.json",
  "title": "Council spec (conflicts-of-interest field)",
  "description": "Seat-level conflict declaration consumed by tools.council.conflicts. A missing conflicts key is refused at enforce time; an empty list still recuses via provenance join.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "seats"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schema": { "type": "string" },
    "question": { "type": "string" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "seats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/seat" }
    },
    "ballots": {
      "type": "array",
      "items": { "$ref": "#/$defs/ballot" }
    }
  },
  "$defs": {
    "conflict_kind": {
      "type": "string",
      "enum": [
        "authored_the_artifact",
        "owns_the_proposal",
        "vendor_under_evaluation",
        "partition_exclusion"
      ]
    },
    "conflict_consequence": {
      "type": "string",
      "enum": ["recusal", "weight_reduction", "partition_exclusion"]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/conflict_kind" },
        "artifact_id": { "type": "string", "minLength": 1 },
        "consequence": { "$ref": "#/$defs/conflict_consequence" }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": true,
      "required": ["conflicts"],
      "properties": {
        "seat_id": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "participant_id": { "type": "string" },
        "display_name": { "type": "string" },
        "vendor": { "type": "string" },
        "conflicts": {
          "type": "array",
          "description": "Required on every seat. Empty list means 'none declared'; provenance join may still recuse.",
          "items": { "$ref": "#/$defs/conflict" }
        }
      },
      "anyOf": [
        { "required": ["seat_id"] },
        { "required": ["id"] }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "artifact_id": { "type": "string" },
        "id": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proposal_owner_id": { "type": "string" },
        "vendor_under_evaluation": { "type": "string" },
        "partition_id": { "type": "string" }
      }
    },
    "ballot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["choice"],
      "properties": {
        "seat_id": { "type": "string" },
        "seat": { "type": "string" },
        "choice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
