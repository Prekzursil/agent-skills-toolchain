{
  "id": "pack.demo.research",
  "name": "Demo research pack",
  "version": "1.2.0",
  "workflows": [
    {
      "id": "wf.demo.research",
      "description": "Fixture workflow whose declared privilege is the ceiling.",
      "params": {
        "topic": {"type": "string", "required": true}
      },
      "tool_permissions": ["Read", "Grep", "Glob", "Bash"],
      "source_policy": ["official-docs", "code", "papers"],
      "units": [
        {"id": "scan", "kind": "task"}
      ]
    }
  ],
  "presets": [
    {
      "id": "strict-plus-write",
      "editable": true,
      "tool_permissions": ["Read", "Grep", "Glob", "Bash", "Write"],
      "source_policy": ["official-docs", "code"]
    }
  ]
}
