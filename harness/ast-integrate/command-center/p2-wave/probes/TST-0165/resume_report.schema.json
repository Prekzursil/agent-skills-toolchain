{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0165/resume_report.schema.json",
  "title": "TST-0165 resume_report (catalog $defs/resume_report stand-in; global receipt.schema.json is absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "question",
    "answer",
    "tests",
    "evidence_a",
    "evidence_b",
    "fixtures",
    "production_census",
    "source_probe",
    "verifier_probe",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "const": "TST-0165" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "const": "SUCCESS:TST-0165" },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "report_kind": { "const": "resume_report" },
    "question": { "type": "string", "minLength": 40 },
    "answer": {
      "type": "object",
      "required": [
        "current_version_resumes_without_migration",
        "old_schema_migrates_or_refuses",
        "zero_silent_drops_on_strict_migrate",
        "lenient_loader_fails_fieldset",
        "summary"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": { "type": "string", "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "evidence_a": {
      "type": "object",
      "required": ["signal", "rows"]
    },
    "evidence_b": {
      "type": "object",
      "required": ["signal", "old_v1_zero_silent_drops", "lenient_silent_drops"]
    },
    "fixtures": {
      "type": "array",
      "minItems": 5
    },
    "source_probe": {
      "type": "object",
      "required": ["id", "command", "fingerprint"]
    },
    "verifier_probe": {
      "type": "object",
      "required": ["id", "command", "fingerprint"]
    }
  }
}
