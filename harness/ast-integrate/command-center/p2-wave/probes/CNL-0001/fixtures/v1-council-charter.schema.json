{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/schema/v1-council-charter.schema.json",
  "title": "Council Charter v1 (reconstructed; harness file absent)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "charter",
    "participants",
    "roles",
    "engagement",
    "budgets",
    "evidence",
    "voting",
    "stopping",
    "outcomes",
    "integrity",
    "artifacts",
    "execution"
  ],
  "properties": {
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "risk_tier": {
          "type": "string"
        },
        "desired_output": {
          "type": "string"
        },
        "success_criteria": {
          "type": "string"
        },
        "consensus_intent": {
          "type": "string"
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/seat"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_turns"
      ],
      "properties": {
        "min_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_inactivity": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "time_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "hash_inputs": {
          "type": "boolean"
        }
      }
    },
    "voting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "quorum"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stopping": {
      "$ref": "#/$defs/stopping_expr"
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_transcript"
      ],
      "properties": {
        "hash_transcript": {
          "type": "boolean"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persist"
      ],
      "properties": {
        "persist": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "expertise": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string"
        },
        "vote_weight": {
          "type": "number"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effort": {
          "type": "string"
        },
        "context": {
          "type": "string"
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "obligation": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "right": {
          "type": "string"
        }
      }
    },
    "stopping_expr": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "decision",
        "conditional-decision",
        "no-decision",
        "irreducible-disagreement",
        "dissent-with-minority-report",
        "proof-of-impossibility",
        "accept",
        "reject",
        "defer",
        "escalate",
        "hung",
        "timeout",
        "owner-override",
        "replay",
        "split",
        "merge",
        "unknown"
      ]
    }
  }
}
