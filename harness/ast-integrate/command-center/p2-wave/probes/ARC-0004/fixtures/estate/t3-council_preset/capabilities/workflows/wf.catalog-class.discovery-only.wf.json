{
  "catalog_cited_count": 108,
  "discovery_only": true,
  "form": "static-config/v1",
  "gates": [
    {
      "id": "human-ack",
      "type": "checkpoint",
      "when": "before-publish"
    }
  ],
  "id": "wf.catalog-class.discovery-only",
  "kind": "workflow_blueprint",
  "library": "09-WORKFLOW-BLUEPRINT-LIBRARY.json",
  "roles": [
    "scanner"
  ],
  "source_id": "09-WORKFLOW-BLUEPRINT-LIBRARY.json#discovery_only",
  "stages": [
    {
      "id": "discover",
      "inputs": [
        "repo"
      ],
      "kind": "static-scan",
      "outputs": [
        "candidates.json"
      ]
    },
    {
      "id": "record",
      "inputs": [
        "candidates.json"
      ],
      "kind": "write-config",
      "outputs": [
        "blueprint.json"
      ]
    }
  ],
  "stopping": {
    "max_stages": 2,
    "on_error": "halt"
  },
  "target_floor": 96,
  "tool_policy": {
    "allow": [
      "Read",
      "Grep",
      "Glob"
    ]
  }
}
