{
  "form": "static-config/v1",
  "id": "council.protocol.catalog-class",
  "kind": "council_protocol",
  "notes": "Declarative protocol the catalog-class preset references.",
  "roles": [
    "Architect",
    "Skeptic",
    "Pragmatist",
    "Critic"
  ],
  "stopping": {
    "max_rounds": 8,
    "on_timeout": "halt",
    "on_unresolved": "BLOCKED"
  },
  "voting": {
    "quorum": 4,
    "rule": "unanimous-or-record-dissent"
  }
}
