{
  "discovery_only": true,
  "form": "static-config/v1",
  "gates": [
    {
      "id": "human-ack",
      "type": "checkpoint",
      "when": "before-publish"
    }
  ],
  "id": "wf.arc0004.marginal-probe",
  "kind": "workflow_blueprint",
  "roles": [
    "scanner"
  ],
  "stages": [
    {
      "id": "measure",
      "inputs": [
        "scratch-tree"
      ],
      "kind": "static-scan",
      "outputs": [
        "numstat.json"
      ]
    },
    {
      "id": "record",
      "inputs": [
        "numstat.json"
      ],
      "kind": "write-config",
      "outputs": [
        "cost-addition.json"
      ]
    }
  ],
  "stopping": {
    "max_stages": 2,
    "on_error": "halt"
  },
  "tool_policy": {
    "allow": [
      "Read",
      "Grep",
      "Glob"
    ]
  }
}
