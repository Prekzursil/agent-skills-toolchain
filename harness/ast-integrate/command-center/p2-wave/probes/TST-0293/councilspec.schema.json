{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/TST-0293/councilspec.schema.json",
  "title": "CouncilSpec preset instance for TST-0293",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status",
    "editable",
    "base_spec_ref",
    "default_binding",
    "editable_dials",
    "charter",
    "participants",
    "roles",
    "protocol_binding",
    "engagement",
    "budgets",
    "evidence",
    "anti_failure",
    "audit",
    "voting",
    "consensus",
    "stopping",
    "outcomes",
    "integrity",
    "execution",
    "meta"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
    "name": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "enum": ["editable", "locked"] },
    "editable": { "type": "boolean", "const": true },
    "base_spec_ref": { "type": "string", "minLength": 3 },
    "default_binding": { "type": "string", "enum": ["static", "auto-compose"] },
    "editable_dials": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "charter": {
      "type": "object",
      "required": ["purpose", "question"],
      "additionalProperties": true,
      "properties": {
        "purpose": { "type": "string", "minLength": 8 },
        "question": { "type": "string", "minLength": 8 }
      }
    },
    "participants": {
      "type": "object",
      "required": ["min", "max", "selection"],
      "additionalProperties": true,
      "properties": {
        "min": { "type": "integer", "minimum": 2 },
        "max": { "type": "integer", "minimum": 2 },
        "selection": { "type": "string", "minLength": 3 }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "protocol_binding": {
      "type": "object",
      "required": ["protocol_id", "protocol_name", "family"],
      "additionalProperties": true,
      "properties": {
        "protocol_id": { "type": "string", "minLength": 2 },
        "protocol_name": { "type": "string", "minLength": 3 },
        "family": {
          "type": "string",
          "enum": [
            "DELIBERATIVE",
            "ADVERSARIAL",
            "JUDICIAL",
            "ANONYMOUS",
            "GENERATIVE",
            "FORECASTING",
            "TRADECRAFT",
            "ENGINEERING-REVIEW",
            "META-COMPOSITION"
          ]
        }
      }
    },
    "engagement": {
      "type": "object",
      "required": ["anonymity", "partition"],
      "additionalProperties": true,
      "properties": {
        "anonymity": {
          "type": "string",
          "enum": ["none", "until-lift", "full-run"]
        },
        "partition": { "type": "string", "minLength": 3 }
      }
    },
    "budgets": {
      "type": "object",
      "required": ["max_rounds", "wall_clock_ms"],
      "additionalProperties": true,
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 32 },
        "wall_clock_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["standard"],
      "additionalProperties": true,
      "properties": {
        "standard": { "type": "string", "minLength": 3 },
        "oracle": { "type": ["string", "null"] }
      }
    },
    "anti_failure": {
      "type": "object",
      "required": ["on_split", "no_silent_average"],
      "additionalProperties": true,
      "properties": {
        "on_split": { "type": "string", "minLength": 3 },
        "no_silent_average": { "type": "boolean", "const": true }
      }
    },
    "audit": {
      "type": "object",
      "required": ["persist_transcript", "hash_inputs", "replay"],
      "additionalProperties": true,
      "properties": {
        "persist_transcript": { "type": "boolean", "const": true },
        "hash_inputs": { "type": "boolean", "const": true },
        "replay": { "type": "boolean" }
      }
    },
    "voting": {
      "type": "object",
      "required": ["rule", "quorum"],
      "additionalProperties": true,
      "properties": {
        "rule": { "type": "string", "minLength": 3 },
        "quorum": { "type": "integer", "minimum": 1 }
      }
    },
    "consensus": {
      "type": "object",
      "required": ["reducer", "local_completion_forbidden"],
      "additionalProperties": true,
      "properties": {
        "reducer": { "type": "string", "minLength": 3 },
        "local_completion_forbidden": { "type": "boolean", "const": true }
      }
    },
    "stopping": {
      "type": "object",
      "required": ["max_rounds", "expression", "on_timeout"],
      "additionalProperties": true,
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 32 },
        "expression": { "type": "string", "minLength": 3 },
        "on_timeout": { "type": "string", "enum": ["FAILED"] }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "transcript",
          "idea_catalog",
          "argument_graph",
          "evidence_map",
          "vote_history",
          "confidence_evolution",
          "dissent",
          "unresolved_questions",
          "action_plan"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "required": ["seeded", "scripted_personas"],
      "additionalProperties": true,
      "properties": {
        "seeded": { "type": "boolean", "const": true },
        "scripted_personas": { "type": "boolean", "const": true }
      }
    },
    "execution": {
      "type": "object",
      "required": ["substrate", "live_model_arm"],
      "additionalProperties": true,
      "properties": {
        "substrate": { "type": "string", "minLength": 3 },
        "live_model_arm": { "type": "string", "enum": ["owner-gated"] }
      }
    },
    "meta": {
      "type": "object",
      "required": ["named_at_11200_11225", "family"],
      "additionalProperties": true,
      "properties": {
        "named_at_11200_11225": { "type": "boolean" },
        "family": { "type": "string", "minLength": 3 }
      }
    }
  }
}
