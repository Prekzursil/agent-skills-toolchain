{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0055/schema.json",
  "title": "WFA-0055 lossy-field ledger (AuditReport)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "sentinel",
    "question",
    "ir_capability",
    "adapters",
    "ledger",
    "declared_vs_measured",
    "disposition_gate",
    "evidence",
    "tests"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0055" },
    "record_type": { "type": "string", "const": "AuditReport" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "pattern": "SUCCESS:WFA-0055" },
    "question": { "type": "string", "minLength": 40 },
    "ir_capability": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string" }
    },
    "adapters": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "slug", "n_declared", "n_measured", "n_p1", "ceiling"],
        "properties": {
          "id": { "type": "string", "pattern": "^WFA-00(45|46|47|48|49|50|51|52|53)$" }
        }
      }
    },
    "ledger": {
      "type": "object",
      "required": ["machine_readable", "losses", "consumed_by"],
      "properties": {
        "machine_readable": { "type": "boolean", "const": true },
        "consumed_by": { "type": "string", "minLength": 8 },
        "losses": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "object",
            "required": [
              "loss_id",
              "adapter_id",
              "native_field",
              "source_construct",
              "worked_example",
              "ir_gap",
              "downstream_consequence",
              "severity",
              "blocks_adopt",
              "acceptability"
            ]
          }
        }
      }
    },
    "declared_vs_measured": {
      "type": "object",
      "required": [
        "aligned",
        "undeclared_leaks",
        "declared_unobserved",
        "measured",
        "declared"
      ]
    },
    "disposition_gate": {
      "type": "object",
      "required": ["rule", "per_adapter"]
    },
    "evidence": {
      "type": "object",
      "required": ["A", "B"]
    },
    "tests": {
      "type": "array",
      "minItems": 3
    }
  }
}
