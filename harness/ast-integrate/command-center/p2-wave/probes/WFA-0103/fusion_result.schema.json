{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0103/fusion_result.schema.json",
  "title": "WFA-0103 FusionResult — best-of-breed per-slot selection by measured score",
  "description": "Discriminating local FusionResult. Catalog names wfa-schema-pack.json#/$defs/FusionResult which is absent on this tree. A garbage SUCCESS object cannot satisfy ablations minItems=3 with composite_moved, TIED recording, or run-id citation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "record_kind",
    "operator",
    "question",
    "answer",
    "fused_workflow",
    "selection",
    "ablations",
    "tie_policy",
    "tied_slot",
    "llm_judgement_refused",
    "run_id_coverage",
    "tests",
    "evidence",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0103" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0103" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0103" },
    "record_kind": { "type": "string", "const": "FusionResult" },
    "operator": { "type": "string", "const": "best-of-breed" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "llm_judgement_refused": { "type": "boolean", "const": true },
    "fused_workflow": {
      "type": "object",
      "required": ["id", "stages"],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "stages": { "type": "array", "minItems": 3 }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "chosen_source_id",
          "score",
          "benchmark_run_id",
          "losers",
          "resolution"
        ],
        "properties": {
          "slot_id": { "type": "string", "minLength": 2 },
          "chosen_source_id": { "type": "string", "minLength": 2 },
          "score": { "type": "number" },
          "benchmark_run_id": {
            "type": "string",
            "pattern": "^run:[A-Za-z0-9._:-]+$"
          },
          "resolution": {
            "type": "string",
            "enum": ["strict-score", "TIED"]
          },
          "losers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "score", "benchmark_run_id"]
            }
          }
        }
      }
    },
    "ablations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "composite_moved",
          "original_score",
          "ablated_score",
          "rematerialized_composite"
        ],
        "properties": {
          "slot_id": { "type": "string", "minLength": 2 },
          "composite_moved": { "type": "boolean", "const": true },
          "original_score": { "type": "number" },
          "ablated_score": { "type": "number" },
          "rematerialized_composite": { "type": "number" }
        }
      }
    },
    "tie_policy": {
      "type": "object",
      "required": ["id", "path", "written_before_apply"],
      "properties": {
        "id": { "type": "string", "const": "lexicographic-source-id" },
        "path": { "type": "string", "minLength": 10 },
        "written_before_apply": { "type": "boolean", "const": true }
      }
    },
    "tied_slot": {
      "type": "object",
      "required": ["slot_id", "resolution", "chosen_source_id", "tie_rule"],
      "properties": {
        "slot_id": { "type": "string", "const": "synthesize" },
        "resolution": { "type": "string", "const": "TIED" },
        "chosen_source_id": {
          "type": "string",
          "const": "wf.wfa0103.alpha"
        },
        "tie_rule": { "type": "string", "const": "lexicographic-source-id" }
      }
    },
    "run_id_coverage": {
      "type": "object",
      "required": ["ok", "cited", "total"],
      "properties": {
        "ok": { "type": "boolean", "const": true },
        "cited": { "type": "integer", "minimum": 3 },
        "total": { "type": "integer", "minimum": 3 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 20 },
          "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED"] },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
