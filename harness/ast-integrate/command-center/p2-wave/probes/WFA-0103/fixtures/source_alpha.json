{
  "id": "wf.wfa0103.alpha",
  "description": "Alpha pipeline: stronger retrieve and synthesize, weaker rank.",
  "tools": ["Read", "Grep", "Glob"],
  "timeout_seconds": 300,
  "stop_rule": {
    "max_stages": 3,
    "on_error": "halt"
  },
  "stages": [
    {
      "id": "retrieve",
      "type": "task",
      "tools": ["Read", "Grep", "Glob"],
      "timeout_seconds": 90,
      "inputs": ["query", "corpus"],
      "outputs": ["hits.json"]
    },
    {
      "id": "rank",
      "type": "task",
      "tools": ["Read"],
      "timeout_seconds": 60,
      "inputs": ["hits.json"],
      "outputs": ["ranked.json"]
    },
    {
      "id": "synthesize",
      "type": "task",
      "tools": ["Read"],
      "timeout_seconds": 90,
      "inputs": ["ranked.json", "query"],
      "outputs": ["answer.md"]
    }
  ]
}
