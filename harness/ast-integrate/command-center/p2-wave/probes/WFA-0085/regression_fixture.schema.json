{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0085/regression_fixture.schema.json",
  "title": "WFA-0085 RegressionFixture (unit-local stand-in for wfa-schema-pack $defs/RegressionFixture)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "state",
    "sentinel",
    "fixture_id",
    "title",
    "question",
    "implementation_target",
    "schema_ref",
    "declared_output_schema",
    "schema_note",
    "dependencies_absent",
    "corpus",
    "engine",
    "idempotence",
    "content_update",
    "adjudication",
    "kill_resume",
    "naive_append",
    "evidence_a",
    "evidence_b",
    "both_states",
    "tests_required",
    "cases",
    "reviewer",
    "tests"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "RegressionFixture" },
    "unit_id": { "type": "string", "const": "WFA-0085" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0085" },
    "fixture_id": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "implementation_target": { "type": "string", "minLength": 40 },
    "schema_ref": { "type": "string", "minLength": 16 },
    "declared_output_schema": { "type": "string", "minLength": 16 },
    "schema_note": { "type": "string", "minLength": 16 },
    "dependencies_absent": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^WFA-[0-9]{4}$" }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_sources", "n_unique_identities", "kill_after", "collision_files", "rename_alias"],
      "properties": {
        "n_sources": { "type": "integer", "minimum": 2 },
        "n_unique_identities": { "type": "integer", "minimum": 1 },
        "kill_after": { "type": "integer", "minimum": 1 },
        "collision_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rename_alias": { "type": "object" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "checkpoint", "kill"],
      "properties": {
        "merge": { "type": "string", "minLength": 8 },
        "checkpoint": { "type": "string", "minLength": 8 },
        "kill": { "type": "string", "minLength": 8 }
      }
    },
    "idempotence": { "type": "object" },
    "content_update": { "type": "object" },
    "adjudication": { "type": "object" },
    "kill_resume": { "type": "object" },
    "naive_append": { "type": "object" },
    "evidence_a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_identical", "new_records", "sha256_first", "sha256_second"],
      "properties": {
        "byte_identical": { "type": "boolean" },
        "new_records": { "type": "integer", "minimum": 0 },
        "sha256_first": { "type": "string", "minLength": 64, "maxLength": 64 },
        "sha256_second": { "type": "string", "minLength": 64, "maxLength": 64 }
      }
    },
    "evidence_b": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_executed", "kill_signal", "record_set_equal", "per_cell_equal", "child_returncode"],
      "properties": {
        "kill_executed": { "type": "boolean" },
        "kill_signal": { "type": "string", "minLength": 3 },
        "record_set_equal": { "type": "boolean" },
        "per_cell_equal": { "type": "boolean" },
        "child_returncode": { "type": "integer" }
      }
    },
    "both_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge_unique", "append_rows", "append_duplicates", "merge_silent_on_collision"],
      "properties": {
        "merge_unique": { "type": "integer", "minimum": 1 },
        "append_rows": { "type": "integer", "minimum": 1 },
        "append_duplicates": { "type": "boolean" },
        "merge_silent_on_collision": { "type": "boolean" }
      }
    },
    "tests_required": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement", "pass"],
        "properties": {
          "id": { "type": "string" },
          "requirement": { "type": "string", "minLength": 8 },
          "pass": { "type": "boolean" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "pass", "expected", "observed"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "pass": { "type": "boolean" },
          "expected": {},
          "observed": {}
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "verdict", "independent", "both_states_rerun"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NOT-REVIEWED"] },
        "independent": { "type": "boolean" },
        "both_states_rerun": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["named_probe_1", "named_probe_2"],
      "properties": {
        "named_probe_1": { "type": "string", "minLength": 8 },
        "named_probe_2": { "type": "string", "minLength": 8 }
      }
    }
  }
}
