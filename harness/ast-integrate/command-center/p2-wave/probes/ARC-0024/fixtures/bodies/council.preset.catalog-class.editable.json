{
  "id": "council.preset.catalog-class.editable",
  "editable": true,
  "roles": ["Architect", "Skeptic", "Pragmatist", "Critic"],
  "anti_failure": {
    "on_split": "surface-disagreement",
    "no_silent_average": true
  },
  "audit": {
    "persist_transcript": true,
    "hash_inputs": true
  },
  "voting": {
    "rule": "unanimous-or-record-dissent",
    "quorum": 4
  },
  "consensus": {
    "reducer": "shared-completion-predicate-name",
    "local_completion_forbidden": true
  },
  "stopping": {
    "max_rounds": 8,
    "on_timeout": "halt",
    "on_unresolved": "BLOCKED"
  },
  "deactivate": "drop-overlay",
  "padding": "preset-overlay-bytes-are-session-resident-only-while-active-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
}
