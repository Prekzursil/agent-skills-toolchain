{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0185/artifact.schema.json",
  "title": "RES-0185 measurement-run (local stand-in; declared measurement-run.schema.json is absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "harvest_frame",
    "source_class_vocabulary",
    "single_source_count",
    "program_conclusion_count",
    "unsupported_shown_not_omitted",
    "distinct_from_RES-0128",
    "cross_tab",
    "conclusions",
    "detector_control",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0185" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "harvest_frame": { "type": "object" },
    "source_class_vocabulary": { "type": "array", "minItems": 16, "maxItems": 16 },
    "single_source_count": { "type": "integer", "minimum": 0 },
    "program_conclusion_count": { "type": "integer", "minimum": 1 },
    "unsupported_shown_not_omitted": { "type": "boolean", "const": true },
    "distinct_from_RES-0128": { "type": "string", "minLength": 40 },
    "cross_tab": { "type": "array", "minItems": 1 },
    "conclusions": { "type": "array", "minItems": 4 },
    "detector_control": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
