{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0009/artifact.schema.json",
  "title": "CNL-0009 target-block design note (JSON stored at the catalog .md path)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "targets",
    "spec_scan",
    "operational_definitions",
    "gaming",
    "both_states",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0009" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "targets": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "measurable_as_written",
          "operational_definition",
          "gaming"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "measurable_as_written": { "type": "boolean" },
          "operational_definition": { "type": "string", "minLength": 16 },
          "gaming": { "type": "object" }
        }
      }
    },
    "spec_scan": { "type": "object" },
    "operational_definitions": { "type": "object" },
    "gaming": { "type": "object" },
    "both_states": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
