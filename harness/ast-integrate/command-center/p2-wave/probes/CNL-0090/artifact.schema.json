{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0090/artifact.schema.json",
  "title": "CNL-0090 circular-debate information-gain detector spec (JSON at catalog .md path)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "claim_under_test",
    "thresholds",
    "both_states",
    "false_positive_rate",
    "gain_curves",
    "tests",
    "evidence",
    "negative_control",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0090" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "claim_under_test": { "type": "string", "minLength": 40 },
    "false_positive_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "thresholds": {
      "type": "object",
      "required": ["floor_information_units", "consecutive_subfloor_rounds"],
      "properties": {
        "floor_information_units": { "type": "integer", "minimum": 1 },
        "consecutive_subfloor_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["detector_control_first", "planted_bad", "known_good"],
      "properties": {
        "detector_control_first": { "type": "boolean", "const": true },
        "planted_bad": { "type": "object" },
        "known_good": { "type": "object" }
      }
    },
    "gain_curves": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "evidence": { "type": "array", "minItems": 2 },
    "negative_control": { "type": "object" },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
