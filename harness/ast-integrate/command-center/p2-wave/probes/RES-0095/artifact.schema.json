{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0095/artifact.schema.json",
  "title": "RES-0095 measurement-run (local physical control; declared measurement-run.schema.json is a generated shim)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "effect_size_assumption",
    "variance",
    "planned_n",
    "required_n",
    "printed_required_n_versus_planned_n",
    "printed_sensitivity_row_halved_effect_size",
    "power",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0095" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 40 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "effect_size_assumption": { "type": "object" },
    "variance": { "type": "object" },
    "planned_n": { "type": "integer", "minimum": 1 },
    "required_n": { "type": "integer", "minimum": 1 },
    "printed_required_n_versus_planned_n": { "type": "string", "minLength": 16 },
    "printed_sensitivity_row_halved_effect_size": { "type": "string", "minLength": 16 },
    "power": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
