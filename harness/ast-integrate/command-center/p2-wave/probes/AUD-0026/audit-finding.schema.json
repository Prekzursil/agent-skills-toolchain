{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/AUD-0026/audit-finding.schema.json",
  "title": "AUD-0026 runtime-vs-dev split finding",
  "description": "Discriminating: SUCCESS requires the both-states control (shipped pytest flagged, test pytest silent), verbatim named probes, and a plugin_runtime_vs_dev object a garbage {ok:true} document cannot satisfy.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "report_kind",
    "named_probes",
    "tests",
    "evidence",
    "reviewer",
    "artifacts",
    "plugin_runtime_vs_dev",
    "control_shipped_dev_import_flagged",
    "control_test_dev_import_silent",
    "negative_controls"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "AUD-0026" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "report_kind": { "type": "string", "const": "audit-finding" },
    "control_shipped_dev_import_flagged": { "type": "boolean", "const": true },
    "control_test_dev_import_silent": { "type": "boolean", "const": true },
    "plugin_runtime_vs_dev": {
      "type": "object",
      "required": [
        "plugin_root",
        "manifest_absent",
        "consumer_forced",
        "dev_only",
        "packaging_defects"
      ],
      "properties": {
        "plugin_root": { "type": "string", "minLength": 8 },
        "manifest_absent": { "type": "boolean" },
        "consumer_forced": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dev_only": {
          "type": "array",
          "items": { "type": "string" }
        },
        "packaging_defects": { "type": "array" }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "raw_output", "exit_code"],
        "properties": {
          "id": { "type": "string", "minLength": 6 },
          "command": { "type": "string", "minLength": 16 },
          "raw_output": { "type": "string", "minLength": 32 },
          "exit_code": { "type": "integer", "const": 0 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 16 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "fired_on_bad_state",
          "silent_on_good_state"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "fired_on_bad_state": { "type": "boolean", "const": true },
          "silent_on_good_state": { "type": "boolean", "const": true }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean" },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
