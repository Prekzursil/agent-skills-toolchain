{
  "id": "wf.nested",
  "routing": {
    "model": "opus",
    "role": "implementer",
    "vendor": "anthropic"
  },
  "stages": [
    {
      "contents": {
        "root/parent.txt": "parent"
      },
      "id": "parent",
      "kind": "write-file",
      "writes": [
        "root/parent.txt"
      ]
    },
    {
      "id": "child-wf",
      "kind": "subworkflow",
      "stages": [
        {
          "contents": {
            "root/child.txt": "child",
            "root/notes.md": "# notes"
          },
          "id": "child",
          "kind": "write-file",
          "writes": [
            "root/child.txt",
            "root/notes.md"
          ]
        }
      ]
    }
  ]
}
