{
  "id": "wf.linear",
  "params": {
    "prefix": {
      "default": "artifacts",
      "type": "string"
    }
  },
  "routing": {
    "model": "opus",
    "role": "implementer",
    "vendor": "anthropic"
  },
  "stages": [
    {
      "contents": {
        "{prefix}/plan.json": "{\"stage\":\"plan\"}"
      },
      "cost": {
        "micro": 1,
        "wall_ms": 10
      },
      "id": "plan",
      "kind": "write-file",
      "writes": [
        "{prefix}/plan.json"
      ]
    },
    {
      "contents": {
        "{prefix}/summary.txt": "ok"
      },
      "id": "summary",
      "kind": "write-file",
      "writes": [
        "{prefix}/summary.txt"
      ]
    }
  ]
}
