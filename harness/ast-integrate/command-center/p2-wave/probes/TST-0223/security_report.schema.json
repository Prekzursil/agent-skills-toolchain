{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0223/security_report.schema.json",
  "title": "TST-0223 security_report (unit-local; catalog family is receipt.schema.json#/$defs/security_report)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "question",
    "answer",
    "property_test",
    "mutation_control",
    "privileged_call",
    "nesting_depths",
    "executor_fixture",
    "evidence",
    "tests",
    "reviewer",
    "named_probes",
    "catalog_named_inputs"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0223" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": {
      "type": "string",
      "const": "SUCCESS:TST-0223"
    },
    "completion_sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "SUCCESS:TST-0223"
    },
    "report_kind": { "type": "string", "const": "security_report" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "property_test": {
      "type": "object",
      "required": [
        "n_trees",
        "seed",
        "violations",
        "widening_attempts",
        "pass"
      ],
      "properties": {
        "n_trees": { "type": "integer", "minimum": 5000 },
        "seed": { "type": "integer" },
        "violations": { "type": "integer", "const": 0 },
        "widening_attempts": { "type": "integer", "minimum": 1 },
        "pass": { "type": "boolean", "const": true }
      }
    },
    "mutation_control": {
      "type": "object",
      "required": ["mode", "property_failed", "violations"],
      "properties": {
        "mode": { "type": "string", "minLength": 4 },
        "property_failed": { "type": "boolean", "const": true },
        "violations": { "type": "integer", "minimum": 1 }
      }
    },
    "privileged_call": {
      "type": "object",
      "required": ["tool", "allowed", "spawn_count"],
      "properties": {
        "tool": { "type": "string", "minLength": 3 },
        "allowed": { "type": "boolean", "const": false },
        "spawn_count": { "type": "integer", "const": 0 }
      }
    },
    "nesting_depths": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["depth", "effective", "monotone"],
        "properties": {
          "depth": { "type": "integer", "minimum": 0 },
          "effective": { "type": "array", "items": { "type": "string" } },
          "monotone": { "type": "boolean", "const": true }
        }
      }
    },
    "executor_fixture": {
      "type": "object",
      "required": ["denied_write", "leaked_secret", "allowed_read"],
      "properties": {
        "denied_write": { "type": "boolean", "const": true },
        "leaked_secret": { "type": "boolean", "const": false },
        "allowed_read": { "type": "boolean", "const": true }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2
    },
    "tests": {
      "type": "array",
      "minItems": 2
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2
    },
    "catalog_named_inputs": {
      "type": "array",
      "minItems": 2
    }
  }
}
