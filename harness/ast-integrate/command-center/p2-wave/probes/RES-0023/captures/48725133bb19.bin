beta_features_header*/ None,\n@@ -3009,6 +3010,7 @@ async fn azure_responses_request_does_not_store_and_preserves_prefixed_item_ids(\n         SessionSource::Exec,\n         \"test_originator\".to_string(),\n         config.model_verbosity,\n+        config.features.enabled(Feature::ContentItemKinds),\n         /*enable_request_compression*/ false,\n         /*include_timing_metrics*/ false,\n         /*beta_features_header*/ None,"},{"sha":"748cc0772845c3b0f0fbd39d8ae7da4cdeaaec0d","filename":"codex-rs/core/tests/suite/client_websockets.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/openai/codex/blob/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fcore%2Ftests%2Fsuite%2Fclient_websockets.rs","raw_url":"https://github.com/openai/codex/raw/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fcore%2Ftests%2Fsuite%2Fclient_websockets.rs","contents_url":"https://api.github.com/repos/openai/codex/contents/codex-rs%2Fcore%2Ftests%2Fsuite%2Fclient_websockets.rs?ref=4aa52f2cb2cdffa9c826f9e4e421a5435a05af06","patch":"@@ -2514,6 +2514,7 @@ async fn websocket_harness_with_provider_options_and_auth(\n         SessionSource::Exec,\n         \"test_originator\".to_string(),\n         config.model_verbosity,\n+        config.features.enabled(Feature::ContentItemKinds),\n         /*enable_request_compression*/ false,\n         runtime_metrics_enabled,\n         /*beta_features_header*/ None,"},{"sha":"ba43fd5bf8182f6323721bdf72c68472178604f9","filename":"codex-rs/core/tests/suite/context_annotations.rs","status":"modified","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/openai/codex/blob/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fcore%2Ftests%2Fsuite%2Fcontext_annotations.rs","raw_url":"https://github.com/openai/codex/raw/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fcore%2Ftests%2Fsuite%2Fcontext_annotations.rs","contents_url":"https://api.github.com/repos/openai/codex/contents/codex-rs%2Fcore%2Ftests%2Fsuite%2Fcontext_annotations.rs?ref=4aa52f2cb2cdffa9c826f9e4e421a5435a05af06","patch":"@@ -215,3 +215,39 @@ async fn first_request_item_types_roles_and_content_annotations() -> Result<()>\n \n     Ok(())\n }\n+\n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\n+async fn content_item_kinds_are_omitted_when_feature_disabled() -> Result<()> {\n+    skip_if_no_network!(Ok(()));\n+\n+    let server = start_mock_server().await;\n+    let response = mount_sse_once(\n+        &server,\n+        sse(vec![ev_response_created(\"resp-1\"), ev_completed(\"resp-1\")]),\n+    )\n+    .await;\n+    let test = test_codex()\n+        .with_config(|config| {\n+            config.developer_instructions = Some(\"Keep other metadata intact.\".into());\n+            config\n+                .features\n+                .disable(Feature::ContentItemKinds)\n+                .expect(\"test config should allow ContentItemKinds override\");\n+        })\n+        .build_with_auto_env(&server)\n+        .await?;\n+\n+    test.submit_text_turn(\"inspect request metadata\").await?;\n+\n+    let input = response.single_request().input();\n+    assert!(input.iter().all(|item| {\n+        item.pointer(\"/internal_chat_message_metadata_passthrough/content_item_kinds\")\n+            .is_none()\n+    }));\n+    assert!(input.iter().any(|item| {\n+        item.pointer(\"/internal_chat_message_metadata_passthrough/turn_id\")\n+            .is_some()\n+    }));\n+\n+    Ok(())\n+}"},{"sha":"26443b6a8a4900b986ca8c4e38221fc1ca2dbbd0","filename":"codex-rs/features/src/lib.rs","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/openai/codex/blob/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Ffeatures%2Fsrc%2Flib.rs","raw_url":"https://github.com/openai/codex/raw/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Ffeatures%2Fsrc%2Flib.rs","contents_url":"https://api.github.com/repos/openai/codex/contents/codex-rs%2Ffeatures%2Fsrc%2Flib.rs?ref=4aa52f2cb2cdffa9c826f9e4e421a5435a05af06","patch":"@@ -99,6 +99,8 @@ pub enum Feature {\n     SecretAuthStorage,\n \n     // Experimental\n+    /// Send per-content-entry classifications in internal Responses metadata.\n+    ContentItemKinds,\n     /// Record model-attempted tool calls in internal Responses metadata.\n     ExecutedToolCallMetadata,\n     /// Enable JavaScript code mode backed by the standalone host process.\n@@ -905,6 +907,12 @@ pub const FEATURES: &[FeatureSpec] = &[\n         stage: Stage::Removed,\n         default_enabled: false,\n     },\n+    FeatureSpec {\n+        id: Feature::ContentItemKinds,\n+        key: \"content_item_kinds\",\n+        stage: Stage::UnderDevelopment,\n+        default_enabled: false,\n+    },\n     FeatureSpec {\n         id: Feature::ExecutedToolCallMetadata,\n         key: \"executed_tool_call_metadata\","},{"sha":"9ce806499e06ff14c41014393f2ebbf2b15d5270","filename":"codex-rs/memories/write/src/runtime.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/openai/codex/blob/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fmemories%2Fwrite%2Fsrc%2Fruntime.rs","raw_url":"https://github.com/openai/codex/raw/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fmemories%2Fwrite%2Fsrc%2Fruntime.rs","contents_url":"https://api.github.com/repos/openai/codex/contents/codex-rs%2Fmemories%2Fwrite%2Fsrc%2Fruntime.rs?ref=4aa52f2cb2cdffa9c826f9e4e421a5435a05af06","patch":"@@ -257,6 +257,7 @@ impl MemoryStartupContext {\n             session_source.clone(),\n             config_snapshot.originator,\n             config.model_verbosity,\n+            config.features.enabled(Feature::ContentItemKinds),\n             config.features.enabled(Feature::EnableRequestCompression),\n             config.features.enabled(Feature::RuntimeMetrics),\n             /*beta_features_header*/ None,"},{"sha":"e8bcab9c981c7e613dec75b3c42aa1ed091c9877","filename":"codex-rs/protocol/src/models.rs","status":"modified","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/openai/codex/blob/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fprotocol%2Fsrc%2Fmodels.rs","raw_url":"https://github.com/openai/codex/raw/4aa52f2cb2cdffa9c826f9e4e421a5435a05af06/codex-rs%2Fprotocol%2Fsrc%2Fmodels.rs","contents_url":"https://api.github.com/repos/openai/codex/contents/codex-rs%2Fprotocol%2Fsrc%2Fmodels.rs?ref=4aa52f2cb2cdffa9c826f9e4e421a5435a05af06","patch":"@@ -1316,6 +1316,21 @@ impl ResponseItem {\n         }\n     }\n \n+    /// Removes content item classifications while preserving other passthrough metadata.\n+    pub fn clear_content_item_kinds(&mut self) {\n+        let Some(metadata) = self.internal_chat_message_metadata_passthrough_mut() else {\n+            return;\n+        };\n+        let Some(metadata_value) = metadata else {\n+            return;\n+        };\n+\n+        metadata_value.content_item_kinds = None;\n+        if metadata_value == &InternalChatMessageMetadataPassthrough::default() {\n+            *metadata = None;\n+        }\n+    }\n+\n     fn internal_chat_message_metadata_passthrough(\n         &self,\n     ) -> Option<&InternalChatMessageMetadataPassthrough> {"}]}