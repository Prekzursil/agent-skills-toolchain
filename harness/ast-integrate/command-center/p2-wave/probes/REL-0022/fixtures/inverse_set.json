{
  "schema": "rel-0002-inverse-set/v1-stand-in",
  "unit_id": "REL-0022",
  "stand_in_for": "REL-0002 typed inverse set (catalog receipt not present on this worktree)",
  "invariants": [
    "An inverse may never remove a path the installer did not create.",
    "An inverse may never remove a command, skill or setting that pre-dated the install."
  ],
  "actions": [
    {
      "id": "write-plugin-manifest",
      "action": "write_file",
      "target": ".ast-plugin/plugin.json",
      "capture_preexisting": true,
      "inverse": {"op": "delete_if_created", "total": true, "residue": null},
      "installer_created": true
    },
    {
      "id": "write-echo-skill",
      "action": "write_file",
      "target": ".ast-plugin/skills/skill.echo.md",
      "capture_preexisting": true,
