      "action": "write_file",
      "target": ".ast-plugin/hooks.json",
      "capture_preexisting": true,
      "inverse": {"op": "delete_if_created", "total": true, "residue": null},
      "installer_created": true
    },
    {
      "id": "write-hook-pre-tool",
      "action": "write_file",
      "target": ".ast-plugin/hooks/pre-tool.json",
      "capture_preexisting": true,
      "inverse": {"op": "delete_if_created", "total": true, "residue": null},
      "installer_created": true
    },
    {
      "id": "write-mcp-entry",
      "action": "write_file",
