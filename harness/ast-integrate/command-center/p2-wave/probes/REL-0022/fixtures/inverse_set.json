    {
      "id": "edit-settings-plugin-enabled",
      "action": "edit_settings_key",
      "target": "settings.json",
      "key": "plugin.enabled",
      "capture_preexisting": true,
      "inverse": {
        "op": "restore_captured_file",
        "total": false,
        "residue": "owner.theme and any other pre-install keys remain; only plugin.enabled is reverted"
      },
      "installer_created": false
    }
  ]
