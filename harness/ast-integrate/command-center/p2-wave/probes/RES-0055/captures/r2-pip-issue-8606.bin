d":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABc3C_JZAAqTY2MTc1MTY2MA=="},{"node":{"__typename":"IssueComment","databaseId":661764140,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"lypwig","id":"MDQ6VXNlcjE2NjU1NDI="},"id":"MDU6SXNzdWU2NjI2OTQ5NTA=","number":8606,"locked":false,"databaseId":662694950},"author":{"__typename":"User","login":"pfmoore","avatarUrl":"https://avatars.githubusercontent.com/u/1110419?v=4","profileUrl":"https://github.com/pfmoore","id":"MDQ6VXNlcjExMTA0MTk=","name":"Paul Moore"},"id":"MDEyOklzc3VlQ29tbWVudDY2MTc2NDE0MA==","url":"https://github.com/pypa/pip/issues/8606#issuecomment-661764140","createdAt":"2020-07-21T10:05:50Z","authorAssociation":"MEMBER","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"Understood - so you're trusting PyPI, for better or worse. I don't have a solution for you, but treating all indexes as equal is by design. So if you want a solution for your use case, you need to describe what you'd want to happen as a new feature, *without* changing existing behaviour. It can then be considered - but would likely need someone to submit a PR once the approach is agreed.","bodyHTML":"\u003cp dir=\"auto\"\u003eUnderstood - so you're trusting PyPI, for better or worse. I don't have a solution for you, but treating all indexes as equal is by design. So if you want a solution for your use case, you need to describe what you'd want to happen as a new feature, \u003cem\u003ewithout\u003c/em\u003e changing existing behaviour. It can then be considered - but would likely need someone to submit a PR once the approach is agreed.\u003c/p\u003e","bodyVersion":"58491a9c042f1e146e9470d8d03b5d64740572ee1fd95b55a4ba7d5b4ef2b0bc","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkxNDQ2NDY3","name":"pip","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjY0NzAyNQ==","login":"pypa","url":"https://github.com/pypa"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pypa/pip","databaseId":1446467},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":1,"nodes":[{"__typename":"User","__isActor":"User","login":"dg-nvm","name":"Dawid Gosławski","avatarUrl":"https://avatars.githubusercontent.com/u/50369002?s=64\u0026u=c9101e310e1d70b51dfdb8af531373dfd471607c\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjUwMzY5MDAy"}]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":16,"nodes":[{"__typename":"User","__isActor":"User","login":"Limezero","name":"Limezero","avatarUrl":"https://avatars.githubusercontent.com/u/8932874?s=64\u0026u=707f056873fa820c34e272378c26238aeaa379ef\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjg5MzI4NzQ="},{"__typename":"User","__isActor":"User","login":"bear-williams","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/115792624?s=64\u0026v=4","__isNode":"User","id":"U_kgDOBuba8A"},{"__typename":"User","__isActor":"User","login":"fa9r","name":"Felix Altenberger","avatarUrl":"https://avatars.githubusercontent.com/u/23118541?s=64\u0026u=21387be74392bebe8a98f739da50243b8f9cf83f\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjIzMTE4NTQx"},{"__typename":"User","__isActor":"User","login":"sg495","name":"Stefano Gogioso","avatarUrl":"https://avatars.githubusercontent.com/u/13587235?s=64\u0026u=1ba230774ed21de48381c154df4f2d721740e7cf\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEzNTg3MjM1"},{"__typename":"User","__isActor":"User","login":"TiansuYu","name":"Tiansu","avatarUrl":"https://avatars.githubusercontent.com/u/9974655?s=64\u0026u=65629721d43071f7710357bcccb29fde8ee841c3\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjk5NzQ2NTU="},{"__typename":"User","__isActor":"User","login":"0xfeeddeadbeef","name":"Giorgi Chakhidze","avatarUrl":"https://avatars.githubusercontent.com/u/732366?s=64\u0026u=7f5e03dbb6667325b387168da76c6e07c60d12e9\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjczMjM2Ng=="},{"__typename":"User","__isActor":"User","login":"timurokahoot","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/113594809?s=64\u0026u=cb57c7a2918736c32083be963d0c3890f961d29b\u0026v=4","__isNode":"User","id":"U_kgDOBsVRuQ"},{"__typename":"User","__isActor":"User","login":"bviktor","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/5798552?s=64\u0026u=735e128b45d5642796f1fc75da3ec7c433aaf213\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjU3OTg1NTI="},{"__typename":"User","__isActor":"User","login":"baseplate-admin","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/61817579?s=64\u0026u=ce4c268fa949ae9a0290996e7949195302055812\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjYxODE3NTc5"},{"__typename":"User","__isActor":"User","login":"benranderson","name":"Ben Randerson","avatarUrl":"https://avatars.githubusercontent.com/u/8963848?s=64\u0026u=0570179ed7e9e031b6c1ac54a55ddce4f0fbb30f\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjg5NjM4NDg="}]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABc3DWKDAAqTY2MTc2NDE0MA=="},{"node":{"__typename":"IssueComment","databaseId":661775020,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"lypwig","id":"MDQ6VXNlcjE2NjU1NDI="},"id":"MDU6SXNzdWU2NjI2OTQ5NTA=","number":8606,"locked":false,"databaseId":662694950},"author":{"__typename":"User","login":"uranusjr","avatarUrl":"https://avatars.githubusercontent.com/u/605277?v=4","profileUrl":"https://github.com/uranusjr","id":"MDQ6VXNlcjYwNTI3Nw==","name":"Tzu-ping Chung"},"id":"MDEyOklzc3VlQ29tbWVudDY2MTc3NTAyMA==","url":"https://github.com/pypa/pip/issues/8606#issuecomment-661775020","createdAt":"2020-07-21T10:29:26Z","authorAssociation":"MEMBER","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"There is a discussion on the philosophy around this design choice: https://discuss.python.org/t/4045\r\n\r\nIn concrete words, pip is consistently treating pypi.org as a global namespace registry, while your mental model is treating it as a package repository. This is still an actively debated topic, but at this point neither view is “wrong”. To use this feature as pip designs it, you should name-squat on PyPI to get what you want.","bodyHTML":"\u003cp dir=\"auto\"\u003eThere is a discussion on the philosophy around this design choice: \u003ca href=\"https://discuss.python.org/t/4045\" rel=\"nofollow\"\u003ehttps://discuss.python.org/t/4045\u003c/a\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eIn concrete words, pip is consistently treating pypi.org as a global namespace registry, while your mental model is treating it as a package repository. This is still an actively debated topic, but at this point neither view is “wrong”. To use this feature as pip designs it, you should name-squat on PyPI to get what you want.\u003c/p\u003e","bodyVersion":"33309873dd81089d8cb5867027cd1101cd39d87a14212116491f01e08430194b","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkxNDQ2NDY3","name":"pip","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjY0NzAyNQ==","login":"pypa","url":"https://github.com/pypa"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pypa/pip","databaseId":1446467},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABc3Drw3AAqTY2MTc3NTAyMA=="},{"node":{"__typename":"IssueComment","databaseId":661787968,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"lypwig","id":"MDQ6VXNlcjE2NjU1NDI="},"id":"MDU6SXNzdWU2NjI2OTQ5NTA=","number":8606,"locked":false,"databaseId":662694950},"author":{"__typename":"User","login":"pfmoore","avatarUrl":"https://avatars.githubusercontent.com/u/1110419?v=4","profileUrl":"https://github.com/pfmoore","id":"MDQ6VXNlcjExMTA0MTk=","name":"Paul Moore"},"id":"MDEyOklzc3VlQ29tbWVudDY2MTc4Nzk2OA==","url":"https://github.com/pypa/pip/issues/8606#issuecomment-661787968","createdAt":"2020-07-21T11:00:27Z","authorAssociation":"MEMBER","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"Philosophical issues to one side, I'd note that [devpi](https://www.devpi.net/) fixes this problem, and is available as a solution right now. From the documentation of \"index inheritance\":\r\n\r\n\u003e All privately uploaded packages will by default inhibit lookups from pypi, allowing to stay safe from an attacker who could otherwise upload malicious release files to the public PyPI index.\r\n\r\nI don't use devpi myself, so I don't know the details, but I would **strongly** recommend that @roipoussiere and anyone else who feels that they would like \"priority order\" for indexes in pip, look at whether devpi solves their issue.\r\n\r\n(Yes, I know it has the problem of \"but it means I have to set up a server in my local environment\". I have some sympathy for this, as I work in an environment where installing local servers is frustratingly painful thanks to internal policies and bureaucracy. But conversely, please remember that asking a group of volunteer maintainers to make significant code changes to address an issue that already has a solution doesn't come without cost either...)","bodyHTML":"\u003cp dir=\"auto\"\u003ePhilosophical issues to one side, I'd note that \u003ca href=\"https://www.devpi.net/\" rel=\"nofollow\"\u003edevpi\u003c/a\u003e fixes this problem, and is available as a solution right now. From the documentation of \"index inheritance\":\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003eAll privately uploaded packages will by default inhibit lookups from pypi, allowing to stay safe from an attacker who could otherwise upload malicious release files to the public PyPI index.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003eI don't use devpi myself, so I don't know the details, but I would \u003cstrong\u003estrongly\u003c/strong\u003e recommend that @roipoussiere and anyone else who feels that they would like \"priority order\" for indexes in pip, look at whether devpi solves their issue.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e(Yes, I know it has the problem of \"but it means I have to set up a server in my local environment\". I have some sympathy for this, as I work in an environment where installing local servers is frustratingly painful thanks to internal policies and bureaucracy. But conversely, please remember that asking a group of volunteer maintainers to make significant code changes to address an issue that already has a solution doesn't come without cost either...)\u003c/p\u003e","bodyVersion":"76f5cf205ec4dda985e08637e3ec8120679a4581836e098e62f7e5530a93b914","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkxNDQ2NDY3","name":"pip","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjY0NzAyNQ==","login":"pypa","url":"https://github.com/pypa"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pypa/pip","databaseId":1446467},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":6,"nodes":[{"__typename":"User","__isActor":"User","login":"McSinyx","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/13689192?s=64\u0026u=851123de66cab889638b667d105b714d7cea1d6d\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEzNjg5MTky"},{"__typename":"User","__isActor":"User","login":"b-a-t","name":"Timur Bakeyev","avatarUrl":"https://avatars.githubusercontent.com/u/1394818?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEzOTQ4MTg="},{"__typename":"User","__isActor":"User","login":"bruce2233","name":"岛石","avatarUrl":"https://avatars.githubusercontent.com/u/54824693?s=64\u0026u=f5a2a66a892f2f478e1643b07accd65e9f775fb8\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjU0ODI0Njkz"},{"__typename":"User","__isActor":"User","login":"edvgui","name":"Guillaume","avatarUrl":"https://avatars.githubusercontent.com/u/20844316?s=64\u0026u=ea7d7764aae9f50d568dbb1373c5bf4f35339bec\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjIwODQ0MzE2"},{"__typename":"User","__isActor":"User","login":"kezzyhko","name":"Sergey Semushin","avatarUrl":"https://avatars.githubusercontent.com/u/51031997?s=64\u0026u=8c3a2b2d8f88713454ede6818036493898aea1cd\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjUxMDMxOTk3"},{"__typename":"User","__isActor":"User","login":"merwok","name":"Éric","avatarUrl":"https://avatars.githubusercontent.com/u/635179?s=64\u0026u=4bd26a095e7e8fe9efd67dc1793e8a5255309d90\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjYzNTE3OQ=="}]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":4,"nodes":[{"__typename":"User","__isActor":"User","login":"Limezero","name":"Limezero","avatarUrl":"https://avatars.githubusercontent.com/u/8932874?s=64\u0026u=707f056873fa820c34e272378c26238aeaa379ef\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjg5MzI4NzQ="},{"__typename":"User","__isActor":"User","login":"fa9r","name":"Felix Altenberger","avatarUrl":"https://avatars.githubusercontent.com/u/23118541?s=64\u0026u=21387be74392bebe8a98f739da50243b8f9cf83f\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjIzMTE4NTQx"},{"__typename":"User","__isActor":"User","login":"bviktor","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/5798552?s=64\u0026u=735e128b45d5642796f1fc75da3ec7c433aaf213\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjU3OTg1NTI="},{"__typename":"User","__isActor":"User","login":"DeliciousBounty","name":"DeliciousBounty","avatarUrl":"https://avatars.githubusercontent.com/u/46570579?s=64\u0026u=ab1dd268bf153b58f09fb377157eccf604e03d44\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ2NTcwNTc5"}]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABc3EIKPgAqTY2MTc4Nzk2OA=="},{"node":{"__typename":"IssueComment","databaseId":662052551,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"lypwig","id":"MDQ6VXNlcjE2NjU1NDI="},"id":"MDU6SXNzdWU2NjI2OTQ5NTA=","number":8606,"locked":false,"databaseId":662694950},"author":{"__typename":"User","login":"lypwig","avatarUrl":"https://avatars.githubusercontent.com/u/1665542?u=7c07b93b654e71c9d371f798a236eabca9b3eeec\u0026v=4","profileUrl":"https://github.com/lypwig","id":"MDQ6VXNlcjE2NjU1NDI=","name":null},"id":"MDEyOklzc3VlQ29tbWVudDY2MjA1MjU1MQ==","url":"https://github.com/pypa/pip/issues/8606#issuecomment-662052551","createdAt":"2020-07-21T19:09:35Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"Thank you for these detailed responses.\r\n\r\n\u003e So if you want a solution for your use case, you need to describe what you'd want to happen as a new feature, without changing existing behaviour.\r\n\r\nOk I understand. Here my suggestion:\r\n\r\nCreate a new pip boolean option `prefer-extra`, defaulted to False. If set to True, pip will look for the packages in the repositories defined in `extra-index-url`, in the definition order.","bodyHTML":"\u003cp dir=\"auto\"\u003eThank you for these detailed responses.\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003eSo if you want a solution for your use case, you need to describe what you'd want to happen as a new feature, without changing existing behaviour.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003eOk I understand. Here my suggestion:\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eCreate a new pip boolean option \u003ccode class=\"notranslate\"\u003eprefer-extra\u003c/code\u003e, defaulted to False. If set to True, pip will look for the packages in the repositories defined in \u003ccode class=\"notranslate\"\u003eextra-index-url\u003c/code\u003e, in the definition order.\u003c/p\u003e","bodyVersion":"e7168068558bf0b91b172546f3cc967ae29cc9f8d75fb7c5a0ff687d6220c10b","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkxNDQ2NDY3","name":"pip","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjY0NzAyNQ==","login":"pypa","url":"https://github.com/pypa"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pypa/pip","databaseId":1446467},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":38,"nodes":[{"__typename":"User","__isActor":"User","login":"mboisson","name":"Maxime Boissonneault","avatarUrl":"https://avatars.githubusercontent.com/u/7515242?s=64\u0026u=9a32ba2e0de066866ed9b7bdb202957501ab379a\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjc1MTUyNDI="},{"__typename":"User","__isActor":"User","login":"bagerard","name":"Bastien Gérard","avatarUrl":"https://avatars.githubusercontent.com/u/11854690?s=64\u0026u=590704f84607bfc6e3920534b9d8510044a7591e\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjExODU0Njkw"},{"__typename":"User","__isActor":"User","login":"ericchansen","name":"Eric Hansen","avatarUrl":"https://avatars.githubusercontent.com/u/5395779?s=64\u0026u=f6e085ac1f6699bca8b44219f07ed8bc6262c26f\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjUzOTU3Nzk="},{"__typename":"User","__isActor":"User","login":"jimbo1969","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/9255653?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjkyNTU2NTM="},{"__typename":"User","__isActor":"User","login":"dsolstad","name":"Daniel Solstad","avatarUrl":"https://avatars.githubusercontent.com/u/346888?s=64\u0026u=f087b50765aa8407a6eb87a3022a00c6aadbb659\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjM0Njg4OA=="},{"__typename":"User","__isActor":"User","login":"UZPENG","name":"UZPENG","avatarUrl":"https://avatars.githubusercontent.com/u/29246858?s=64\u0026u=6ca6f6fce3bdba0d92228f868e359caa8487ebae\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI5MjQ2ODU4"},{"__typename":"User","__isActor":"User","login":"karlkovaciny","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/3171120?s=64\u0026u=a456e09639530c5ba27782fdf840cb40ec94594c\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjMxNzExMjA="},{"__typename":"User","__isActor":"User","login":"laserK3000","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/3374310?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjMzNzQzMTA="},{"__typename":"User","__isActor":"User","login":"bityob","name":"Yonatan Bitton","avatarUrl":"https://avatars.githubusercontent.com/u/20026896?s=64\u0026u=c1c5581ca7606475c452f06e3e7f138ee6139e3a\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjIwMDI2ODk2"},{"__typename":"User","__isActor":"User","login":"hillolsarkersanofi","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/114083779?s=64\u0026u=0e5116c0be1bd4c2b79300a89def581a463f5496\u0026v=4","__isNode":"User","id":"U_kgDOBszHww"}]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":1,"nodes":[{"__typename":"User","__isActor":"User","login":"CroMarmot","name":"陈鼫RWHTYFZ","avatarUrl":"https://avatars.githubusercontent.com/u/24691835?s=64\u0026u=af734892615bb7db74c4ddde8495437d9e5f1872\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI0NjkxODM1"}]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABc3LH-ZgAqTY2MjA1MjU1MQ=="},{"node":{"__typename":"IssueComment","databaseId":662061457,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"lypwig","id":"MDQ6VXNlcjE2NjU1NDI="},"id":"MDU6SXNzdWU2NjI2OTQ5NTA=","number":8606,"locked":false,"databaseId":662694950},"author":{"__typename":"User","login":"pfmoore","avatarUrl":"https://avatars.githubusercontent.com/u/1110419?v=4","profileUrl":"https://github.com/pfmoore","id":"MDQ6VXNlcjExMTA0MTk=","name":"Paul Moore"},"id":"MDEyOklzc3VlQ29tbWVudDY2MjA2MTQ1Nw==","url":"https://github.com/pypa/pip/issues/8606#issuecomment-662061457","createdAt":"2020-07-21T19:28:01Z","authorAssociation":"MEMBER","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"-1 (you shouldn't be too surprised to hear...)\r\n\r\nIt's way too easy for people to set a flag in config and forget they have it set, and then be confused when legitimate upgrades don't work. Or we'd get people wanting to set it in requirements files, but its effect wouldn't be limited to the requirement file. Also, the proposal doesn't explain how this would interact with `--find-links`.\r\n\r\nI don't think you fully understood my reservations - this is *not* a simple thing to change, and it will take some work to flesh out a viable proposal.\r\n\r\nI did a quick test with devpi, and setting up a devpi server with your local packages stored in a private index backed by the default PyPI mirror index does *precisely* what you want. Given that devpi solves this problem out of the box, I'm going to be very hard to convince that this needs a solution within pip.","bodyHTML":"\u003cp dir=\"auto\"\u003e-1 (you shouldn't be too surprised to hear...)\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eIt's way too easy for people to set a flag in config and forget they have it set, and then be confused when legitimate upgrades don't work. Or we'd get people wanting to set it in requirements files, but its effect wouldn't be limited to the requirement file. Also, the proposal doesn't explain how this would interact with \u003ccode class=\"notranslate\"\u003e--find-links\u003c/code\u003e.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI don't think you fully understood my reservations - this is \u003cem\u003enot\u003c/em\u003e a simple thing to change, and it will take some work to flesh out a viable proposal.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI did a quick test with devpi, and setting up a devpi server with your local packages stored in a private index backed by the default PyPI mirror index does \u003cem\u003eprecisely\u003c/em\u003e what you want. Given that devpi solves this problem out of the box, I'm going to be very hard to convince that this needs a solution within pip.\u003c/p\u003e","bodyVersion":"ec93d729e6f441c260b2ca855b47d3b6dfff18cb673257612ae97b6900e99209","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkxNDQ2NDY3","name":"pip","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjY0NzAyNQ==","login":"pypa","url":"https://github.com/pypa"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pypa/pip","databaseId":1446467},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":5,"nodes":[{"__typename":"User","__isActor":"User","login":"kousu","name":"Nick","avatarUrl":"https://avatars.githubusercontent.com/u/987487?s=64\u0026u=8f72aaa5539759c40b55c347cb6ea0100bbf08b2\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjk4NzQ4Nw=="},{"__typename":"User","__isActor":"User","login":"trobert2","name":"Robert Tingirică","avatarUrl":"https://avatars.githubusercontent.com/u/4254749?s=64\u0026u=ce93891e327689d81a3eac8c93d05ad4934d5f49\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQyNTQ3NDk="},{"__typename":"User","__isActor":"User","login":"bashhu","name":"bash","avatarUrl":"https://avatars.githubusercontent.com/u/5791748?s=64\u0026u=73918388f12373671f487fe66e02770de6faa93f\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjU3OTE3NDg="},{"__typename":"User","__isActor":"User","login":"b-a-t","name":"Timur Bakeyev","avatarUrl":"https://avatars.githubusercontent.com/u/1394818?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEzOTQ4MTg="},{"__typename":"User","__isActor":"User","login":"CroMarmot","name":"陈鼫RWHTYFZ","avatarUrl":"https://avatars.githubusercontent.com/u/24691835?s=64\u0026u=af734892615bb