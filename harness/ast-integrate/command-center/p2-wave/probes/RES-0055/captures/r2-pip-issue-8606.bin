dViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"Yes but Pypi is used to download my project dependencies and I don't want to include all of them in our private repo.","bodyHTML":"\u003cp dir=\"auto\"\u003eYes but Pypi is used to download my project dependencies and I don't want to include all of them in our private repo.\u003c/p\u003e","bodyVersion":"d97ffc441f296110e0787219908d23a609541627801e97cf605892e44f518448","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkxNDQ2NDY3","name":"pip","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjY0NzAyNQ==","login":"pypa","url":"https://github.com/pypa"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pypa/pip","databaseId":1446467},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":14,"nodes":[{"__typename":"User","__isActor":"User","login":"karelvaculik","name":"Karel Vaculík","avatarUrl":"https://avatars.githubusercontent.com/u/26491194?s=64\u0026u=aa2573eeaad9e8d15d527e5b118164a0110bc7c5\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI2NDkxMTk0"},{"__typename":"User","__isActor":"User","login":"wimglenn","name":"Wim Jeantine-Glenn","avatarUrl":"https://avatars.githubusercontent.com/u/6615374?s=64\u0026u=02fd58558377ffb3f757b10246145058b15a6efd\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjY2MTUzNzQ="},{"__typename":"User","__isActor":"User","login":"UZPENG","name":"UZPENG","avatarUrl":"https://avatars.githubusercontent.com/u/29246858?s=64\u0026u=6ca6f6fce3bdba0d92228f868e359caa8487ebae\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI5MjQ2ODU4"},{"__typename":"User","__isActor":"User","login":"trobert2","name":"Robert Tingirică","avatarUrl":"https://avatars.githubusercontent.com/u/4254749?s=64\u0026u=ce93891e327689d81a3eac8c93d05ad4934d5f49\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQyNTQ3