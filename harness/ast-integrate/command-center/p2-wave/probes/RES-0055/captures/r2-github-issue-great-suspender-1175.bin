stUserContentEdit":null,"pinnedBy":null,"body":"What are people using as a replacement for TGS? \"Tiny Suspender\" is mentioned above. In the absence of a compelling explanation by the new owner of who they are and what they're doing, and an update here consistent with the Play Store, it's only prudent to consider TGS to now be malware.","bodyHTML":"\u003cp dir=\"auto\"\u003eWhat are people using as a replacement for TGS? \"Tiny Suspender\" is mentioned above. In the absence of a compelling explanation by the new owner of who they are and what they're doing, and an update here consistent with the Play Store, it's only prudent to consider TGS to now be malware.\u003c/p\u003e","bodyVersion":"78e53985ac7ebf83e9bee7d546df705de24cf632f8d8bd871cc0c977cbfb2fa4","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzczMTAw","name":"thegreatsuspender","owner":{"__typename":"User","id":"MDQ6VXNlcjExNjAzODI4","login":"greatsuspender","url":"https://github.com/greatsuspender"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"greatsuspender/thegreatsuspender","databaseId":5773100},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":14,"nodes":[{"__typename":"User","__isActor":"User","login":"0xdevalias","name":"Glenn 'devalias' Grant","avatarUrl":"https://avatars.githubusercontent.com/u/753891?s=64\u0026u=91b663823a9d5d4587a092636d6f478d06a0981c\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjc1Mzg5MQ=="},{"__typename":"User","__isActor":"User","login":"jgurtz","name":"Jason Gurtz","avatarUrl":"https://avatars.githubusercontent.com/u/3574135?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjM1NzQxMzU="},{"__typename":"User","__isActor":"User","login":"aekanshd","name":"Aekansh Dixit","avatarUrl":"https://avatars.githubusercontent.com/u/30038178?s=64\u0026u=a2eb62b2485cbb8086588b4d32a79a6b6dfb8ef7\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjMwMDM4MTc4"},{"__typename":"User",