me":"Marlon","avatarUrl":"https://avatars.githubusercontent.com/u/66328166?s=64\u0026u=1a1b1e0629137f2014da0dbfc8f320e858049d98\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjY2MzI4MTY2"}]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":1,"nodes":[{"__typename":"User","__isActor":"User","login":"namanp08","name":"Naman P","avatarUrl":"https://avatars.githubusercontent.com/u/66672786?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjY2NjcyNzg2"}]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABc2NegogAqTY2MDUyOTIwOA=="},{"node":{"__typename":"IssueComment","databaseId":706685133,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"deanoemcke","id":"MDQ6VXNlcjEwNTE3NjM="},"id":"MDU6SXNzdWU2NDIyNDMzNjI=","number":1175,"locked":false,"databaseId":642243362},"author":{"__typename":"User","login":"ossilator","avatarUrl":"https://avatars.githubusercontent.com/u/812380?v=4","profileUrl":"https://github.com/ossilator","id":"MDQ6VXNlcjgxMjM4MA==","name":"Oswald Buddenhagen"},"id":"MDEyOklzc3VlQ29tbWVudDcwNjY4NTEzMw==","url":"https://github.com/greatsuspender/thegreatsuspender/issues/1175#issuecomment-706685133","createdAt":"2020-10-11T10:44:50Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"so i guess we can now officially conclude that the transition was a failure? :(\r\ni'm not at all surprised - you can't really expect someone with no track record in a project to take over a major responsibility as a volunteer. it doesn't matter how enthusiastic they may appear at the outset. that it all happened behind closed doors probably didn't help, either.\r\n@greatsuspender, care to comment?\r\n\r\nthe question is how to move forward. finding a \"worthy\" successor within the community still requires prolonged investment from the old maintainer, so as things stand, even a prominent call for help on the web store would not lead to anything. i suppose a possible way forward would be declaring \"bankruptcy\", seeing if a viable fork emerges, and if so, transferring official ownership to its maintainer.","bodyHTML":"\u003cp dir=\"auto\"\u003eso i guess we can now officially conclude that the transition was a failure? :(\u003cbr\u003e\ni'm not at all surprised - you can't really expect someone with no track record in a project to take over a major responsibility as a volunteer. it doesn't matter how enthusiastic they may appear at the outset. that it all happened behind closed doors probably didn't help, either.\u003cbr\u003e\n\u003ca class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/greatsuspender/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/greatsuspender\"\u003e@greatsuspender\u003c/a\u003e, care to comment?\u003c/p\u003e\n\u003cp dir=\"auto\"\u003ethe question is how to move forward. finding a \"worthy\" successor within the community still requires prolonged investment from the old maintainer, so as things stand, even a prominent call for help on the web store would not lead to anything. i suppose a possible way forward would be declaring \"bankruptcy\", seeing if a viable fork emerges, and if so, transferring official ownership to its maintainer.\u003c/p\u003e","bodyVersion":"b80e13e8d520c27b3543800a143b13469d57dc7f7f38d6e2ef626c082dbaf633","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzczMTAw","name":"thegreatsuspender","owner":{"__typename":"User","id":"MDQ6VXNlcjExNjAzODI4","login":"greatsuspender","url":"https://github.com/greatsuspender"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"greatsuspender/thegreatsuspender","databaseId":5773100},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":13,"nodes":[{"__typename":"User","__isActor":"User","login":"u100009","name":"BEAT BUCHER","avatarUrl":"https://avatars.githubusercontent.com/u/45983171?s=64\u0026u=f1dad1a63dd56e90d1a969304d5c656a228114eb\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ1OTgzMTcx"},{"__typename":"User","__isActor":"User","login":"rommeltoledocr","name":"Rommel Toledo","avatarUrl":"https://avatars.githubusercontent.com/u/63619664?s=64\u0026u=026c0fe51f8094f503140889a215b40a1d8ce5c9\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjYzNjE5NjY0"},{"__typename":"User","__isActor":"User","login":"wjcroft","name":"William J Croft","avatarUrl":"https://avatars.githubusercontent.com/u/8441213?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjg0NDEyMTM="},{"__typename":"User","__isActor":"User","login":"arregit","name":"rubber","avatarUrl":"https://avatars.githubusercontent.com/u/498849?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ5ODg0OQ=="},{"__typename":"User","__isActor":"User","login":"wpafbo79","name":"Theron E. Weimer, Jr.","avatarUrl":"https://avatars.githubusercontent.com/u/13511650?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEzNTE