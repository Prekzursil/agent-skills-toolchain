,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABdWoH2ogAqTcxNzIwOTYwNA=="},{"node":{"__typename":"IssueComment","databaseId":717238751,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"deanoemcke","id":"MDQ6VXNlcjEwNTE3NjM="},"id":"MDU6SXNzdWU2NDIyNDMzNjI=","number":1175,"locked":false,"databaseId":642243362},"author":{"__typename":"User","login":"DAOWAce","avatarUrl":"https://avatars.githubusercontent.com/u/480587?v=4","profileUrl":"https://github.com/DAOWAce","id":"MDQ6VXNlcjQ4MDU4Nw==","name":null},"id":"MDEyOklzc3VlQ29tbWVudDcxNzIzODc1MQ==","url":"https://github.com/greatsuspender/thegreatsuspender/issues/1175#issuecomment-717238751","createdAt":"2020-10-27T13:21:26Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"Hmm, addon updated to 7.1.8 but there's no release for it on github, still showing 7.1.6.\r\n\r\nWhat's the official changelog in the newest update?  (besides trying to parse commits)\r\n\r\n\r\nAn an aside, I still hate how Chrome decides to randomly update addons in the background despite being in developer mode.  Why even have an 'update extensions' button if it's going to update them regardless?","bodyHTML":"\u003cp dir=\"auto\"\u003eHmm, addon updated to 7.1.8 but there's no release for it on github, still showing 7.1.6.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eWhat's the official changelog in the newest update?  (besides trying to parse commits)\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eAn an aside, I still hate how Chrome decides to randomly update addons in the background despite being in developer mode.  Why even have an 'update extensions' button if it's going to update them regardless?\u003c/p\u003e","bodyVersion":"c203631eebde8b961921a48d02efc8feaced7770d56d0bf3ad4d9f0e063e8353","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzczMTAw","name":"thegreatsuspender","owner":{"__typename":"User","id":"MDQ6VXNlcjExNjAzODI4","login":"greatsuspender","url":"https://github.com/greatsuspender"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"greatsuspender/thegreatsuspender","databaseId":5773100},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":37,"nodes":[{"__typename":"User","__isActor":"User","login":"Poopooracoocoo","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/51363864?s=64\u0026u=d8fed23682c70fbc6681ccd5d44f7f82c8bbcb90\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjUxMzYzODY0"},{"__typename":"User","__isActor":"User","login":"TheMCNerd2017","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/25375242?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI1Mzc1MjQy"},{"__typename":"User","__isActor":"User","login":"XxX-Force","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/45721696?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ1NzIxNjk2"},{"__typename":"User","__isActor":"User","login":"ctsstc","name":"Cody Swartz","avatarUrl":"https://avatars.githubusercontent.com/u/416814?s=64\u0026u=66792ade5014c7bc71f7bf59894a4596e4bfcfc6\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQxNjgxNA=="},{"__typename":"User","__isActor":"User","login":"sudo-owen","name":"owen","avatarUrl":"https://avatars.githubusercontent.com/u/22165146?s=64\u0