U2NDIyNDMzNjI=","number":1175,"locked":false,"databaseId":642243362},"author":{"__typename":"User","login":"Poopooracoocoo","avatarUrl":"https://avatars.githubusercontent.com/u/51363864?u=d8fed23682c70fbc6681ccd5d44f7f82c8bbcb90\u0026v=4","profileUrl":"https://github.com/Poopooracoocoo","id":"MDQ6VXNlcjUxMzYzODY0","name":null},"id":"MDEyOklzc3VlQ29tbWVudDcxNzIwOTYwNA==","url":"https://github.com/greatsuspender/thegreatsuspender/issues/1175#issuecomment-717209604","createdAt":"2020-10-27T12:28:21Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"After what happened to Nano Adblocker and Defender and an update to The Great Suspender, my stomach is churning. I'm so scared. I don't know what I'm supposed to do. With Nano I just uninstalled them, switched to uBO and kept the filters as it leads to an archived repo. What do I do here????","bodyHTML":"\u003cp dir=\"auto\"\u003eAfter what happened to Nano Adblocker and Defender and an update to The Great Suspender, my stomach is churning. I'm so scared. I don't know what I'm supposed to do. With Nano I just uninstalled them, switched to uBO and kept the filters as it leads to an archived repo. What do I do here????\u003c/p\u003e","bodyVersion":"cbd22a6333abb30d22d953507e131005f1df3f47b59044c28235cca0aa1d7d7e","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzczMTAw","name":"thegreatsuspender","owner":{"__typename":"User","id":"MDQ6VXNlcjExNjAzODI4","login":"greatsuspender","url":"h