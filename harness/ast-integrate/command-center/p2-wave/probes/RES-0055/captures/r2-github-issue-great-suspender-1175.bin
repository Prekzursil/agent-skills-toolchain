2eea5db17121c67d3cd8b8\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjExNTkwNjY="},{"__typename":"User","__isActor":"User","login":"dangeredwolf","name":"dangered wolf","avatarUrl":"https://avatars.githubusercontent.com/u/2636265?s=64\u0026u=24166259d294205352e931b8ae8b3433071cdef2\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI2MzYyNjU="},{"__typename":"User","__isActor":"User","login":"arregit","name":"rubber","avatarUrl":"https://avatars.githubusercontent.com/u/498849?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ5ODg0OQ=="},{"__typename":"User","__isActor":"User","login":"Gaboou","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/62707203?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjYyNzA3MjAz"},{"__typename":"User","__isActor":"User","login":"atornatore","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/10772467?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEwNzcyNDY3"},{"__typename":"User","__isActor":"User","login":"dasJ","name":"Janne Heß","avatarUrl":"https://avatars.githubusercontent.com/u/4971975?s=64\u0026u=e396715146d55d6c8c70fdf88c98d6e0473febe7\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ5NzE5NzU="}]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABdWo4c_AAqTcxNzIzODc1MQ=="},{"node":{"__typename":"IssueComment","databaseId":717310130,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"deanoemcke","id":"MDQ6VXNlcjEwNTE3NjM="},"id":"MDU6SXNzdWU2NDIyNDMzNjI=","number":1175,"locked":false,"databaseId":642243362},"author":{"__typename":"User","login":"joshmanders","avatarUrl":"https://avatars.githubusercontent.com/u/352113?u=6dc1eb9f564bc00b08ebdc0cf447ea45010b65ed\u0026v=4","profileUrl":"https://github.com/joshmanders","id":"MDQ6VXNlcjM1MjExMw==","name":"Josh Manders"},"id":"MDEyOklzc3VlQ29tbWVudDcxNzMxMDEzMA==","url":"https://github.com/greatsuspender/thegreatsuspender/issues/1175#issuecomment-717310130","createdAt":"2020-10-27T15:08:46Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"@DAOWAce \r\n\u003e Hmm, addon updated to 7.1.8 but there's no release for it on github, still showing 7.1.6.\r\n\r\nJudging by the commits, it maybe was an oversight in publishing both on GitHub and on Google. Looks like he possibly published after overhauling the screenshot code in https://github.com/greatsuspender/thegreatsuspender/pull/1238 and then again after making it possible to disable Google Analytics in https://github.com/greatsuspender/thegreatsuspender/pull/1239\r\n\r\nI've been inspecting the code on my browser extension version for any malicious stuff being added between those version discrepancies, I'd advise you to do the same. (Not sure in Chrome, but in Brave I can click inspect on the extension and view its code)","bodyHTML":"\u003cp dir=\"auto\"\u003e\u003ca class=\"user-mention notranslate\" data-hovercard-type=\"user\" data-hovercard-url=\"/users/DAOWAce/hovercard\" data-octo-click=\"hovercard-link-click\" data-octo-dimensions=\"link_type:self\" href=\"https://github.com/DAOWAce\"\u003e@DAOWAce\u003c/a\u003e\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003eHmm, addon updated to 7.1.8 but there's no release for it on github, still showing 7.1.6.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003eJudging by the commits, it maybe was an oversight in publishing both on GitHub and on Google. Looks like he possibly published after overhauling the screenshot code in \u003ca class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"723977494\" data-permission-text=\"Title is private\" data-url=\"https://github.com/greatsuspender/thegreatsuspender/issues/1238\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/greatsuspender/thegreatsuspender/pull/1238/hovercard\" href=\"https://github.com/greatsuspender/thegreatsuspender/pull/1238\"\u003e#1238\u003c/a\u003e and then again after making it possible to disable Google Analytics in \u003ca class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"723982651\" data-permission-text=\"Title is private\" data-url=\"https://github.com/greatsuspender/thegreatsuspender/issues/1239\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/greatsuspender/thegreatsuspender/pull/1239/hovercard\" href=\"https://github.com/greatsuspender/thegreatsuspender/pull/1239\"\u003e#1239\u003c/a\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI've been inspecting the code on my browser extension version for any malicious stuff being added between those version discrepancies, I'd advise you to do the same. (Not sure in Chrome, but in Brave I can click inspect on the extension and view its code)\u003c/p\u003e","bodyVersion":"43f039d68a46cfa2b2d3f511c011adc36c38166a6ca83d16c6609c79e4bb499d","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzczMTAw","name":"thegreatsuspender","owner":{"__typename":"User","id":"MDQ6VXNlcjExNjAzODI4","login":"greatsuspender","url":"https://github.com/greatsuspender"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"greatsuspender/thegreatsuspender","databaseId":5773100},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":3,"nodes":[{"__typename":"User","__isActor":"User","login":"arregit","name":"rubber","avatarUrl":"https://avatars.githubusercontent.com/u/498849?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ5ODg0OQ=="},{"__typename":"User","__isActor":"User","login":"Gaboou","name":null,"avatarUrl":"https://avatars.githubusercontent.com/u/62707203?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjYyNzA3MjAz"},{"__typename":"User","__isActor":"User","login":"py660","name":"py660","avatarUrl":"https://avatars.githubusercontent.com/u/93660666?s=64\u0026v=4","__isNode":"User","id":"U_kgDOBZUl-g"}]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABdWqauDAAqTcxNzMxMDEzMA=="},{"node":{"__typename":"IssueComment","databaseId":717312177,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"deanoemcke","id":"MDQ6VXNlcjEwNTE3NjM="},"id":"MDU6SXNzdWU2NDIyNDMzNjI=","number":1175,"locked":false,"databaseId":642243362},"author":{"__typename":"User","login":"LeChatNoir666","avatarUrl":"https://avatars.githubusercontent.com/u/59604462?v=4","profileUrl":"https://github.com/LeChatNoir666","id":"MDQ6VXNlcjU5NjA0NDYy","name":null},"id":"MDEyOklzc3VlQ29tbWVudDcxNzMxMjE3Nw==","url":"https://github.com/greatsuspender/thegreatsuspender/issues/1175#issuecomment-717312177","createdAt":"2020-10-27T15:11:54Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":"2020-10-29T14:46:45Z","lastUserContentEdit":{"editor":{"__typename":"User","url":"https://github.com/LeChatNoir666","login":"LeChatNoir666","id":"MDQ6VXNlcjU5NjA0NDYy"},"id":"MDE1OlVzZXJDb250ZW50RWRpdElzc3VlQ29tbWVudEVkaXQ6NDEwMjQ2OTE5"},"pinnedBy":null,"body":"Uninstalled The Great Suspender!\r\nSame **annoying behavior** like in the last update with the popup in **any** browser windows and again no changelog...\r\nSo I say good bye to TGS and hello to \"**Auto Tab Discard**\" on all my devices.\r\nThe 3rd Add-On after Nano Defender / Adblocker I uninstalled this week...\r\n\r\nAlso I fear another bad code injecting, especially like above about the releases.\r\n\r\nAnyway... thanks to the old dev.\r\n\r\nOh and if someone decide to switch too:\r\n**Make a Backup of your Tab else you will lose your tabs with uninstalling TGS!**\r\n \r\n\r\n","bodyHTML":"\u003cp dir=\"auto\"\u003eUninstalled The Great Suspender!\u003cbr\u003e\nSame \u003cstrong\u003eannoying behavior\u003c/strong\u003e like in the last update with the popup in \u003cstrong\u003eany\u003c/strong\u003e browser windows and again no changelog...\u003cbr\u003e\nSo I say good bye to TGS and hello to \"\u003cstrong\u003eAuto Tab Discard\u003c/strong\u003e\" on all my devices.\u003cbr\u003e\nThe 3rd Add-On after Nano Defender / Adblocker I uninstalled this week...\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eAlso I fear another bad code injecting, especially like above about the releases.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eAnyway... thanks to the old dev.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eOh and if someone decide to switch too:\u003cbr\u003e\n\u003cstrong\u003eMake a Backup of your Tab else you will lose your tabs with uninstalling TGS!\u003c/strong\u003e\u003c/p\u003e","bodyVersion":"dffb9cd38e76f5d45e2a83a40e2f070da1c3198f541f86b506d702efa94f9d04","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnk1NzczMTAw","name":"thegreatsuspender","owner":{"__typename":"User","id":"MDQ6VXNlcjExNjAzODI4","login":"greatsuspender","url":"https://github.com/greatsuspender"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"greatsuspender/thegreatsuspender","databaseId":5773100},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":22,"nodes":[{"__typename":"User","__isActor":"User","login":"PseudoCowboy","name":"Gea","avatarUrl":"https://avatars.githubusercontent.com/u/20549450?s=64\u0026u=4f3d5509a8d0bf63353adf4805bed481b209a900\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjIwNTQ5NDUw"},{"__typename":"User","__isActor":"User","login":"slmingol","name":"Sam Mingo","avatarUrl":"https://avatars.githubusercontent.com/u/15072?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjE1MDcy"},{"__typename":"User","__isActor":"User","login":"0xdevalias","name":"Glenn 'devalias' Grant","avatarUrl":"https://avatars.githubusercontent.com/u/753891?s=64\u0026u=91b663823a9d5d4587a092636d6f478d06a0981c\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjc1Mzg5MQ=="},{"__typename":"User","__isActor":"User","login":"BernardVanTonder","name":"Bernard","avatarUrl":"https://avatars.githubusercontent.com/u/62942829?s=64\u0026u=77ac5f2696ed46dbce3e10cf18394ca9a39a1c2f\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjYyOTQyODI5"},{"__typename":"User","__isActor":"User","login":"compuguy","name":"Alex Hall","avatarUrl":"https://avatars.githubusercontent.com/u/864349?s=64\u0026u=417cd88776f2b4170c00e7eb2aed6308e11c40b2\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjg2NDM0OQ=="},{"__typename":"User","__isActor":"User","login":"phcreery","name":"Peyton Creery","avatarUrl":"https://avatars.githubusercontent.com/u/44987569?s=64\u0026u=ec52cd4bcb77512ea54d58f6af047d5e5b1edaf6\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ0OTg