r not and stop it : \u003ccode class=\"notranslate\"\u003eps -aux | grep jsextension\u003c/code\u003e\u003c/p\u003e","bodyVersion":"95fa3fb80d5ff9dfa18398d4e2d5aa836a03614f60338f244f4dd665b8dc7ca7","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkzMzIwNzEw","name":"ua-parser-js","owner":{"__typename":"User","id":"MDQ6VXNlcjQ2MDMwMg==","login":"faisalman","url":"https://github.com/faisalman"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"faisalman/ua-parser-js","databaseId":3320710},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":24,"nodes":[{"__typename":"User","__isActor":"User","login":"SuperOleg39","name":"SuperOleg39","avatarUrl":"https://avatars.githubusercontent.com/u/15360667?s=64\u0026u=a778be51467c57776a57103c35aa0b8f3633db9d\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjE1MzYwNjY3"},{"__typename":"User","__isActor":"User","login":"alex-drocks","name":"Alexandre Desroches","avatarUrl":"https://avatars.githubusercontent.com/u/69808183?s=64\u0026u=f3a39c87781bb1c10a05355aa8b9aa5a74bb4feb\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjY5ODA4MTgz"},{"__typename":"User","__isActor":"User","login":"JaneJeon","name":"Jane Jeon","avatarUrl":"https://avatars.githubusercontent.com/u/24810585?s=64\u0026u=f7e52f36ef8a61a9ca613dd346a1ce18462dd329\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI0ODEwNTg1"},{"__typename":"User","__isActor":"User","login":"devansh08","name":"Devansh Sharma","avatarUrl":"https://avatars.githubusercontent.com/u/21225957?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjIxMjI1OTU3"},{"__typename":"User","__isActor":"User","login":"tsteuwer-accesso","name":"Troy Steuwer","avatarUrl":"https://avatars.githubusercontent.com/u/32495798?s=64\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjMyNDk1Nzk4"},{"__typename":"User","__isActor":"User","login":"horvbalint","name":"Horváth Bálint","avatarUrl":"https://avatars.githubusercontent.com/u/4077