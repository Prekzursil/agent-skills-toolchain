WN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABfKiWIoAAqTk0OTcyNzgwOA=="},{"node":{"__typename":"IssueComment","databaseId":949742904,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"SuperOleg39","id":"MDQ6VXNlcjE1MzYwNjY3"},"id":"I_kwDOADKrhs49m4SG","number":536,"locked":false,"databaseId":1033602182},"author":{"__typename":"User","login":"faisalman","avatarUrl":"https://avatars.githubusercontent.com/u/460302?u=638c5122668fbcc4306732e1a3de60b19c393707\u0026v=4","profileUrl":"https://github.com/faisalman","id":"MDQ6VXNlcjQ2MDMwMg==","name":"Faisal Salman"},"id":"IC_kwDOADKrhs44m-04","url":"https://github.com/faisalman/ua-parser-js/issues/536#issuecomment-949742904","createdAt":"2021-10-22T15:38:07Z","authorAssociation":"OWNER","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"Hi all, very sorry about this. \r\n\r\nI noticed something unusual when my email was suddenly flooded by spams from hundreds of websites (maybe so I don't realize something was up, luckily the effect is quite the contrary). \r\n\r\nI believe someone was hijacking my npm account and published some compromised packages (`0.7.29`, `0.8.0`, `1.0.0`) which will probably install malware as can be seen from the diff here: https://app.renovatebot.com/package-diff?name=ua-parser-js\u0026from=0.7.28\u0026to=1.0.0 \r\n\r\nI have sent a message to NPM support since I can't seem to unpublish the compromised versions (maybe due to npm policy https://docs.npmjs.com/policies/unpublish) so I can only deprecate them with a warning message.","bodyHTML":"\u003cp dir=\"auto\"\u003eHi all, very sorry about this.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI noticed something unusual when my email was suddenly flooded by spams from hundreds of websites (maybe so I don't realize something was up, luckily the effect is quite the contrary).\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI believe someone was hijacking my npm account and published some compromised packages (\u003ccode class=\"notranslate\"\u003e0.7.29\u003c/code\u003e, \u003ccode class=\"notranslate\"\u003e0.8.0\u003c/code\u003e, \u003ccode class=\"notranslate\"\u003e1.0.0\u003c/code\u003e) which will probably install malware as can be seen from the diff here: \u003ca href=\"https://app.renovatebot.com/package-diff?name=ua-parser-js\u0026amp;from=0.7.28\u0026amp;to=1.0.0\" rel=\"nofollow\"\u003ehttps://app.renovatebot.com/package-diff?name=ua-parser-js\u0026amp;from=0.7.28\u0026amp;to=1.0.0\u003c/a\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI have sent a message to NPM support since I can't seem to unpublish the compromised versions (maybe due to npm policy \u003ca href=\"https://docs.npmjs.com/policies/unpublish\" rel=\"nofollow\"\u003ehttps://docs.npmjs.com/policies/unpublish\u003c/a\u003e) so I can only deprecate them with a warning message.\u003c/p\u003e","bodyVersion":"900dad4a7c3b63958c8796051422fba91df909305f240bec361c68fc40edc88c","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkzMzIwNzEw","name":"ua-parser-js","owner":{"__typename":"User","id":"MDQ6VXNlcjQ2MDMwMg==","login":"faisalman","url":"https://github.com/faisalman"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"faisalman/ua-parser-js","databaseId":3320710},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":119,"nodes":[{"__typename":"User","__isActor":"User","login":"KalleOlaviNiemitalo","name":"Kalle Olavi Niemitalo","avatarUrl":"https://avatars.githubusercontent.com/u/46201428?s=64\u0026u=d9072cf93da27c02b5e4a622e4405f185c9fc862\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjQ2MjAxNDI4"},{"__typename":"User","__isActor":"User","login":"alex-drocks","name":"Alexandre Desroches","avatarUrl":"https://avatars.githubusercontent.com/u/69808183?s=64\u0026u=f3a39c87781bb1c10a05355aa8b9aa5a74bb4feb\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjY5ODA4MTgz"},{"__typename":"User","__isActor":"User","login":"psidex","name":"Simon","avatarUrl":"https://avatars.githubusercontent.com/u/14183909?s=64\u0026u=cd546a0d991a3ed4732275fad5268af4071bd962\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjE0MTgzOTA5"},{"__typename":"User","__isActor":"User","login":"eps1lon","name":"Sebastian \"Sebbie\" Silbermann","avatarUrl":"https://avatars.githubusercontent.com/u/12292047?s=64\u0026u=d1523888bc16deb2ce9f5294e4849d1a2f02270c\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjEyMjkyMDQ3"},{"__typename":"User","__isActor":"User","login":"JaneJeon","name":"Jane Jeon","avatarUrl":"https://avatars.githubusercontent.com/u/24810585?s=64\u0026u=f7e52f36ef8a61a9ca613dd346a1ce18462dd329\u0026v=4","__isNode":"User","id":"MDQ6VXNlcjI0ODEwNTg1"},{"__typename":"User","__isActor":"User","login":"davidbmaier","name":"David B. Maier","avatarUrl":"https://avatars.githubusercontent.com/u/17618532?s=64\u0026u=b9eb8091437990faf3ff9c3e2a4c4dc1a4be905d\u0026v=4","__isNode":"User