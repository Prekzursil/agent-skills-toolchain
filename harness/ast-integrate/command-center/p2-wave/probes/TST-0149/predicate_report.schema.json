{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0149/predicate_report.schema.json",
  "title": "Predicate report (condition-11 unregistered-artifact tester)",
  "description": "Discriminating contract for TST-0149. Catalog receipt.schema.json#/$defs/predicate_report cannot be compiled on jsonschema 4.10.3 (no referencing registry=). Garbage objects are rejected.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts",
    "extensions"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0149" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "report": {
      "type": "object",
      "required": ["kind", "reducer_id", "conditions"],
      "properties": {
        "kind": { "type": "string", "const": "predicate_report" },
        "reducer_id": { "type": "string", "minLength": 8 },
        "conditions": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["n", "text", "outcome", "basis"],
            "properties": {
              "n": { "type": "integer", "minimum": 1, "maximum": 12 },
              "text": { "type": "string", "minLength": 1 },
              "outcome": {
                "type": "string",
                "enum": ["SATISFIED", "UNSATISFIED", "NOT-APPLICABLE", "NOT-CHECKED"]
              },
              "basis": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT-RUN", "BLOCKED", "NOT-CHECKED"]
          }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad_state", "silent_on_good_state"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "extensions": {
      "type": "object",
      "required": ["question", "answer", "both_states", "named_probes"],
      "properties": {
        "question": { "type": "string", "minLength": 40 },
        "answer": { "type": "string", "minLength": 40 },
        "both_states": { "type": "boolean", "const": true },
        "named_probes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "command"],
            "properties": {
              "id": { "type": "string", "minLength": 3 },
              "command": { "type": "string", "minLength": 8 }
            }
          }
        }
      }
    }
  }
}
