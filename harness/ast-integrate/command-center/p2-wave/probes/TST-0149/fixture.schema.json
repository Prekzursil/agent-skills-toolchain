{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["unit_id", "verdict", "body"],
  "properties": {
    "unit_id": { "type": "string" },
    "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED", "PARTIAL"] },
    "body": { "type": "string" },
    "sentinel": { "type": "string" }
  }
}
