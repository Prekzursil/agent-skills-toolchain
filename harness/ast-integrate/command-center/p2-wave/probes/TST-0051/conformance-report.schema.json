{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0051/conformance-report.schema.json",
  "title": "TST-0051 release-policy conformance report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "schema_version",
    "report_kind",
    "title",
    "question",
    "host",
    "contracts_under_test",
    "validators",
    "findings",
    "tests",
    "evidence",
    "blob_method",
    "minimal_fixes",
    "reviewer",
    "artifacts",
    "answer",
    "set_difference"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0051" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "report_kind": { "type": "string", "const": "conformance-report" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "host": {
      "type": "object",
      "required": ["system", "python", "git_worktree_repo"],
      "properties": {
        "system": { "type": "string", "minLength": 3 },
        "python": { "type": "string", "minLength": 3 },
        "git_worktree_repo": { "type": "boolean" }
      }
    },
    "contracts_under_test": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "present"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "minLength": 8 },
          "present": { "type": "boolean" }
        }
      }
    },
    "validators": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "path", "present"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "present": { "type": "boolean" }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "surface", "verdict", "detail", "minimal_fix"],
        "properties": {
          "id": { "type": "string" },
          "surface": { "type": "string" },
          "verdict": {
            "type": "string",
            "enum": ["SURVIVES", "BREAKS", "ABSENT", "NOT-CHECKED"]
          },
          "detail": { "type": "string", "minLength": 8 },
          "minimal_fix": { "type": "string", "minLength": 8 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "path", "detail"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "detail": { "type": "string", "minLength": 8 }
        }
      }
    },
    "blob_method": {
      "type": "object",
      "required": [
        "method",
        "never_git_archive_for_blob",
        "readings",
        "archive_equals_blob",
        "working_tree_crlf_shown"
      ],
      "properties": {
        "method": { "type": "string", "minLength": 8 },
        "never_git_archive_for_blob": { "type": "boolean", "const": true },
        "readings": { "type": "object" },
        "archive_equals_blob": { "type": "boolean" },
        "working_tree_crlf_shown": { "type": "boolean" }
      }
    },
    "set_difference": {
      "type": "object",
      "required": [
        "policy_minus_tooling",
        "tooling_minus_policy",
        "both_directions_printed",
        "sets_equal"
      ],
      "properties": {
        "policy_minus_tooling": { "type": "array", "items": { "type": "string" } },
        "tooling_minus_policy": { "type": "array", "items": { "type": "string" } },
        "both_directions_printed": { "type": "boolean", "const": true },
        "sets_equal": { "type": "boolean" }
      }
    },
    "minimal_fixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["applies_to", "fix"],
        "properties": {
          "applies_to": { "type": "string" },
          "fix": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "answer": { "type": "string", "minLength": 40 }
  }
}
