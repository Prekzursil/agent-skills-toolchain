{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0078.schema.json",
  "title": "Plugin manifest (ARC-0078 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "hooks",
    "scripts",
    "compatibility",
    "unknown_field_policy"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "unknown_field_policy": {
      "type": "string",
      "enum": [
        "strict",
        "tolerant"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_host",
        "max_host"
      ],
      "properties": {
        "min_host": {
          "type": "string",
          "minLength": 1
        },
        "max_host": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "interpreter"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "interpreter": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
