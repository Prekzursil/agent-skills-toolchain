{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0083.schema.json",
  "title": "Work-unit record (ARC-0083 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "phase",
    "target",
    "inputs",
    "dependencies",
    "assignment",
    "tool_permissions",
    "execution_substrate",
    "timeout_seconds",
    "output_path",
    "output_schema",
    "evidence_requirement",
    "tests_required",
    "reviewer_requirement",
    "completion_sentinel",
    "retry_policy",
    "failure_classification",
    "owner_approval_required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 16
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignment": {
      "type": "object",
      "required": [
        "model",
        "role",
        "vendor"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool_permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "execution_substrate": {
      "type": "string",
      "enum": [
        "worktree-isolated",
        "local-parallel",
        "cloud-batch",
        "local-windows-pwsh7"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "output_path": {
      "type": "string",
      "minLength": 8
    },
    "output_schema": {
      "type": "string",
      "minLength": 8
    },
    "evidence_requirement": {
      "type": "string",
      "minLength": 8
    },
    "tests_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviewer_requirement": {
      "type": "string",
      "minLength": 8
    },
    "completion_sentinel": {
      "type": "string",
      "minLength": 8
    },
    "retry_policy": {
      "type": "string",
      "minLength": 8
    },
    "failure_classification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "owner_approval_required": {
      "type": "boolean"
    }
  }
}
