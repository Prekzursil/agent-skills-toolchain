{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0085.schema.json",
  "title": "Claim record (ARC-0085 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "mechanism",
    "lineage",
    "confidence",
    "verification_status",
    "settling_probe",
    "duplicate_of",
    "support",
    "contradiction",
    "implementation_impact"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 3
    },
    "mechanism": {
      "type": "string",
      "minLength": 16
    },
    "lineage": {
      "type": "array",
      "minItems": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "REFUTED"
      ]
    },
    "settling_probe": {
      "type": "string",
      "minLength": 8
    },
    "duplicate_of": {
      "type": "array"
    },
    "support": {
      "type": "array"
    },
    "contradiction": {
      "type": "array"
    },
    "implementation_impact": {
      "type": "string",
      "minLength": 3
    }
  }
}
