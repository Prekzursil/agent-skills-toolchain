{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0080.schema.json",
  "title": "Package content boundary (ARC-0080 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "exclusions",
    "size_ceiling_bytes",
    "content_digest",
    "included_paths",
    "reproducibility",
    "byte_size"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 3
    },
    "exclusions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "size_ceiling_bytes": {
      "type": "integer",
      "minimum": 1024
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "included_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {
            "not": {
              "pattern": "(^|/)\\.git(/|$)"
            }
          },
          {
            "not": {
              "pattern": "(^|/)\\.env$"
            }
          },
          {
            "not": {
              "pattern": "[Cc]redential"
            }
          }
        ]
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "command"
      ],
      "properties": {
        "declared": {
          "type": "boolean"
        },
        "command": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    }
  }
}
