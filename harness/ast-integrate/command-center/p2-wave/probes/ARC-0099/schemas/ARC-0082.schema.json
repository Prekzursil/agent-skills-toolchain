{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0082.schema.json",
  "title": "Workflow DSL (ARC-0082 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "certified_executable",
    "stages",
    "gates",
    "failure_policy",
    "replay"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "certified_executable": {
      "type": "boolean"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "halt",
        "retry",
        "repair"
      ]
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "dry_run"
      ],
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
