{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0084.schema.json",
  "title": "Artifact envelope (ARC-0084 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "producing_unit",
    "content_hash",
    "byte_size",
    "schema_reference",
    "sentinel",
    "evidence_anchors",
    "retention_class",
    "registered_in_manifest"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 3
    },
    "producing_unit": {
      "type": "string",
      "minLength": 3
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 256
    },
    "schema_reference": {
      "type": "string",
      "minLength": 8
    },
    "sentinel": {
      "type": "string",
      "minLength": 8
    },
    "evidence_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "ephemeral",
        "standard",
        "archival"
      ]
    },
    "registered_in_manifest": {
      "type": "boolean",
      "const": true
    }
  }
}
