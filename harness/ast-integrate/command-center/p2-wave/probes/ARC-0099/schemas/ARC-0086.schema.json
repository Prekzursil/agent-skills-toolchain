{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0086.schema.json",
  "title": "Append-only event (ARC-0086 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seq",
    "timestamp",
    "timezone",
    "actor",
    "unit_id",
    "phase",
    "state_from",
    "state_to",
    "correlation_id",
    "causality_id",
    "payload",
    "redacted"
  ],
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 20
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 3
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "state_from": {
      "type": "string",
      "minLength": 1
    },
    "state_to": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causality_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(AKIA|sk-[A-Za-z0-9]|BEGIN PRIVATE KEY)"
          }
        }
      }
    },
    "redacted": {
      "type": "boolean"
    }
  }
}
