{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0099/schemas/ARC-0079.schema.json",
  "title": "Marketplace registry entry (ARC-0079 catalog-derived stand-in)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "namespace",
    "versions",
    "provenance",
    "revocation",
    "permissions",
    "platform"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "namespace": {
      "type": "string",
      "minLength": 2
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "channel"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "signature_ref",
        "sbom_ref",
        "license"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "signature_ref": {
          "type": "string",
          "minLength": 1
        },
        "sbom_ref": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "revoked_versions"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "deprecated",
            "revoked"
          ]
        },
        "revoked_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "vulnerability_status": {
      "type": "string",
      "minLength": 1
    }
  }
}
