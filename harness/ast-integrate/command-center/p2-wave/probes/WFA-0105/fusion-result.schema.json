{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0105/fusion-result.schema.json",
  "title": "WFA-0105 FusionResult (ensemble / execution-consensus)",
  "description": "Unit-local FusionResult contract used because command-center/wfa/schema/wfa-schema-pack.json is absent on this tree. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "produced_at",
    "schema_binding",
    "operator",
    "distinguishing_inputs",
    "source_catalog",
    "ensembles",
    "independence_rule",
    "tests",
    "evidence",
    "reviewer",
    "llm_ranking",
    "lineage"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "FusionResult" },
    "unit_id": { "type": "string", "const": "WFA-0105" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "^SUCCESS:WFA-0105"
    },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0105" },
    "title": { "type": "string", "minLength": 20 },
    "question": { "type": "string", "minLength": 40 },
    "produced_at": { "type": "string", "minLength": 20 },
    "schema_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_output_schema",
        "catalog_pack_present",
        "validated_against",
        "note"
      ],
      "properties": {
        "catalog_output_schema": { "type": "string", "minLength": 20 },
        "catalog_pack_present": { "type": "boolean" },
        "validated_against": { "type": "string", "minLength": 20 },
        "note": { "type": "string", "minLength": 20 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "reconcile_by",
        "runs_in_parallel",
        "llm_ranking_forbidden",
        "implementation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "kind": { "type": "string", "const": "ensemble" },
        "reconcile_by": { "type": "string", "const": "execution-consensus" },
        "runs_in_parallel": { "type": "boolean" },
        "llm_ranking_forbidden": { "type": "boolean" },
        "implementation": { "type": "string", "minLength": 8 }
      }
    },
    "distinguishing_inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ir_kind", "tokens"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "ir_kind": { "type": "string", "minLength": 3 },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "source_catalog": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "vendor", "policy"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "vendor": { "type": "string", "enum": ["anthropic", "openai"] },
          "policy": {
            "type": "string",
            "enum": ["unique-sorted", "order-preserving", "planted-wrong"]
          }
        }
      }
    },
    "ensembles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ensemble_id",
          "strategy",
          "reconcile_by",
          "distinguishing_input_ids",
          "sources",
          "clusters",
          "independence",
          "result",
          "postcondition",
          "naive_member_count",
          "single_input_control",
          "lineage",
          "llm_ranking_invocations"
        ],
        "properties": {
          "ensemble_id": { "type": "string", "minLength": 3 },
          "strategy": { "type": "string", "const": "ensemble" },
          "reconcile_by": { "type": "string", "const": "execution-consensus" },
          "distinguishing_input_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "sources": { "type": "array", "minItems": 2 },
          "clusters": { "type": "array", "minItems": 1 },
          "independence": { "type": "object" },
          "result": {
            "type": "object",
            "required": ["verdict", "reason", "winner_cluster_id", "llm_ranking_invocations"],
            "properties": {
              "verdict": {
                "type": "string",
                "enum": ["RESOLVED", "UNRESOLVED", "POSTCONDITION-FAILED"]
              },
              "reason": { "type": "string" },
              "winner_cluster_id": { "type": ["string", "null"] },
              "tied_cluster_ids": { "type": "array" },
              "llm_ranking_invocations": { "type": "integer", "const": 0 }
            }
          },
          "postcondition": { "type": "object" },
          "naive_member_count": { "type": "object" },
          "single_input_control": { "type": "object" },
          "lineage": { "type": "object" },
          "llm_ranking_invocations": { "type": "integer", "const": 0 }
        }
      }
    },
    "independence_rule": { "type": "string", "minLength": 20 },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": { "type": "string", "enum": ["PASS", "FAIL"] },
          "detail": { "type": "string", "minLength": 8 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 16 },
          "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED"] },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "independent", "verdict", "re_ran_both_states"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "independent": { "type": "boolean" },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "re_ran_both_states": { "type": "boolean" }
      }
    },
    "llm_ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocations",
        "forbidden_imports",
        "forbidden_name_hits",
        "absent"
      ],
      "properties": {
        "invocations": { "type": "integer", "const": 0 },
        "forbidden_imports": { "type": "array", "items": { "type": "string" } },
        "forbidden_name_hits": { "type": "array", "items": { "type": "string" } },
        "absent": { "type": "boolean" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "fusion_strategy"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "fusion_strategy": { "type": "string", "const": "ensemble" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
