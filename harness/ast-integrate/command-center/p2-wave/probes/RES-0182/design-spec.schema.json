{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0182/design-spec.schema.json",
  "title": "Design spec (RES-0182 expert elicitation as a source class)",
  "description": "Pinned local schema: catalog path command-center/schema/design-spec.schema.json is absent from this worktree.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "kind",
    "report_kind",
    "question",
    "answer",
    "protocol",
    "distinct_from_council",
    "questions_no_literature",
    "questions_literature_control",
    "adoption",
    "promotion_guard",
    "negative_control",
    "claims",
    "tests",
    "reviewer",
    "evidence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0182" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:RES-0182" },
    "kind": { "type": "string", "const": "design-spec" },
    "report_kind": {
      "type": "string",
      "const": "expert-elicitation-source-class"
    },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "protocol": {
      "type": "object",
      "required": [
        "reference_class_framing",
        "independent_priors",
        "calibration_questions",
        "aggregation"
      ]
    },
    "distinct_from_council": {
      "type": "object",
      "required": ["is_council_decision_protocol", "mode"],
      "properties": {
        "is_council_decision_protocol": { "type": "boolean", "const": false },
        "mode": { "type": "string", "const": "research-input" }
      }
    },
    "questions_no_literature": {
      "type": "array",
      "minItems": 6
    },
    "questions_literature_control": {
      "type": "array",
      "minItems": 2
    },
    "adoption": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["WEAK", "CONDITIONAL", "REJECTED", "ADOPTED"]
        }
      }
    },
    "promotion_guard": {
      "type": "object",
      "required": ["elicited_promoted_to_measured", "rule"],
      "properties": {
        "elicited_promoted_to_measured": { "type": "boolean", "const": false },
        "rule": {
          "type": "string",
          "const": "elicited-values-never-promoted-to-measured"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 4
    },
    "negative_control": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "evidence": { "type": "array", "minItems": 2 }
  }
}
