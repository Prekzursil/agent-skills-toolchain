{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0112/conformance-report.envelope.schema.json",
  "title": "ARC-0112 golden-corpus conformance-report envelope",
  "$comment": "The catalog output_schema is a generated $ref shim with no constraints of its own and a host that does not resolve. This envelope is the executable schema for THIS unit: it rejects garbage and requires adjudication plus encoding control.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "verdict",
    "answer",
    "failures",
    "adjudication",
    "encoding_control",
    "tests",
    "evidence",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "ARC-0112" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:ARC-0112" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "verdict": { "type": "string", "minLength": 8 },
    "answer": { "type": "string", "minLength": 40 },
    "failures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "direction", "citation", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "direction": { "type": "string", "enum": ["artifact-wrong", "schema-wrong"] },
          "citation": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 8 }
        },
        "additionalProperties": true
      }
    },
    "adjudication": {
      "type": "object",
      "required": [
        "failing_records",
        "classified",
        "unexplained",
        "artifact_wrong",
        "schema_wrong",
        "computed_not_asserted"
      ],
      "properties": {
        "failing_records": { "type": "integer", "minimum": 1 },
        "classified": { "type": "integer", "minimum": 1 },
        "unexplained": { "type": "integer", "minimum": 0, "maximum": 0 },
        "artifact_wrong": { "type": "integer", "minimum": 0 },
        "schema_wrong": { "type": "integer", "minimum": 0 },
        "computed_not_asserted": { "type": "boolean", "const": true }
      },
      "additionalProperties": true
    },
    "encoding_control": {
      "type": "object",
      "required": ["crlf_not_misread_as_data", "surfaces"],
      "properties": {
        "crlf_not_misread_as_data": { "type": "boolean", "const": true },
        "surfaces": { "type": "array", "minItems": 2 }
      },
      "additionalProperties": true
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict"],
        "additionalProperties": true
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "additionalProperties": true
      }
    }
  }
}
