{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "SYN-0008 per-candidate synthesis row (unit-local, not the catalog shim)",
  "$comment": "Catalog output_schema is a generated generic_report pin and has no definitions.candidate. This file is the schema every candidate is parsed against before fan-in.",
  "type": "object",
  "required": [
    "id",
    "vendor",
    "model",
    "lens",
    "partition_manifest",
    "wall_clock_start",
    "wall_clock_end",
    "prompt_file",
    "prompt_sha256",
    "exit_code",
    "output_path",
    "output_bytes",
    "parsed",
    "classification",
    "counts_as_result",
    "prompt_transport",
    "foreground",
    "synthesis"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "vendor": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "lens": { "type": "string", "minLength": 1 },
    "partition_manifest": {
      "type": "object",
      "required": [
        "agent_id",
        "vendor",
        "shared_classes",
        "disjoint_classes",
        "evidence_files"
      ],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "lens": { "type": "string" },
        "shared_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "disjoint_classes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "allow_read": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "wall_clock_start": { "type": "string", "minLength": 8 },
    "wall_clock_end": { "type": "string", "minLength": 8 },
    "prompt_file": { "type": "string", "minLength": 1 },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exit_code": { "type": "integer", "const": 0 },
    "output_path": { "type": "string", "minLength": 1 },
    "output_bytes": { "type": "integer", "minimum": 1 },
    "parsed": { "type": "boolean", "const": true },
    "classification": { "type": "string", "const": "completed" },
    "counts_as_result": { "type": "boolean", "const": true },
    "prompt_transport": { "type": "string", "const": "file" },
    "foreground": { "type": "boolean", "const": true },
    "synthesis": {
      "type": "object",
      "required": ["findings", "tokens_observed"],
      "properties": {
        "findings": { "type": "array", "minItems": 1 },
        "tokens_observed": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "diagnostic_tail": { "type": "string" },
    "published_path": { "type": "string" }
  }
}
