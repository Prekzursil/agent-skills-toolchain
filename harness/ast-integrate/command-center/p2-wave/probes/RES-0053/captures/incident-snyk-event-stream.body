ganization-jsonld-Organization">{"@context":"https://schema.org","@type":"Organization","@id":"https://snyk.io/#organization","name":"Snyk","url":"https://snyk.io","logo":"https://res.cloudinary.com/snyk/image/upload/v1588772106/title-card-vertical-white-1.png","sameAs":["https://www.facebook.com/snyksec/","https://twitter.com/snyksec"]}</script><!--$--><!--/$--></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"page":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"3CDqWaosPx1QunCGNECtBE3","type":"Entry","createdAt":"2022-09-21T01:27:20.149Z","updatedAt":"2023-05-22T16:18:00.383Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":61,"revision":16,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"templateBlogPost"}},"locale":"en-US"},"fields":{"title":"A post-mortem of the malicious event-stream backdoor","slug":"a-post-mortem-of-the-malicious-event-stream-backdoor","contentTags":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"qMwl1ampzrFdGiHukhg7jV","type":"Entry","createdAt":"2022-09-21T00:43:44.878Z","updatedAt":"2023-04-11T18:22:39.232Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":9,"revision":4,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"composeContentTags"}},"locale":"en-US"},"fields":{"internalName":"\"A post-mortem of the malicious event-stream backdoor\" - Content Tags","topic":["vulnerability-insights"],"product":["snyk-security-intel"],"language":["javascript"],"technology":["node-js"],"focus":["awareness","acquisition"],"audience":["developer","security"],"medium":"blog","contributor":["devrel"]}},"seoSocialSharing":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"qlYwwDoJI