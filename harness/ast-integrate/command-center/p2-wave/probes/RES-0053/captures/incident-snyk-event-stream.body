adzz"}},"id":"pFo4jDSB0DmPVedOoo4DVR","type":"Entry","createdAt":"2022-09-20T23:21:20.343Z","updatedAt":"2025-06-12T16:02:20.680Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":226,"revision":195,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentPerson"}},"locale":"en-US"},"fields":{"internalName":"Liran Tal","fullName":"Liran Tal","slug":"liran-tal","firstName":"Liran","lastName":"Tal","headshot":[{"url":"http://res.cloudinary.com/snyk/image/upload/v1663712675/wordpress-sync/liran-yoda.jpg","tags":[],"type":"upload","bytes":40391,"width":400,"format":"jpg","height":400,"version":1663712675,"duration":null,"metadata":[],"public_id":"wordpress-sync/liran-yoda","created_at":"2022-09-20T22:24:35Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/v1663712675/wordpress-sync/liran-yoda.jpg","resource_type":"image","raw_transformation":""}],"roles":["Blog Author","Event Speaker","Podcast Guest","Podcast Host"],"bio":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Award-winning software developer, security researcher, and open source champion in the JavaScript community. His contributions to developer security education include leading OWASP projects, building supply chain security tools, participation in CNCF and OpenSSF initiatives, and authoring books such as O'Reilly's Serverless Security.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"title":"Director of Developer Relations","company":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"BiiaijTYQ14RazfFg8UMc","type":"Entry","createdAt":"2022-11-08T15:58:24.247Z","updatedAt":"2026-08-04T11:30:17.114Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":436,"revision":428,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCompany"}},"locale":"en-US"},"fields":{"companyName":"Snyk","logoHorizontalDark":[{"url":"http://res.cloudinary.com/snyk/image/upload/v1645705749/snyk-marketingwp/snykcon/logo-snyk.svg","tags":[],"type":"upload","bytes":8086,"width":155,"format":"svg","height":80,"version":1645705749,"duration":null,"metadata":{},"public_id":"snyk-marketingwp/snykcon/logo-snyk","created_at":"2022-02-24T12:29:09Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/v1645705749/snyk-marketingwp/snykcon/logo-snyk.svg","resource_type":"image"}],"logoHorizontal":[{"url":"http://res.cloudinary.com/snyk/image/upload/v1645182199/snyk-marketingui/brand-logos/wordmark-logo-color.svg","tags":null,"type":"upload","bytes":6792,"width":283,"format":"svg","height":146,"version":1645182199,"duration":null,"metadata":[],"public_id":"snyk-marketingui/brand-logos/wordmark-logo-color","created_at":"2022-02-18T11:03:19Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/v1645182199/snyk-marketingui/brand-logos/wordmark-logo-color.svg","original_url":"http://res.cloudinary.com/snyk/image/upload/v1645182199/snyk-marketingui/brand-logos/wordmark-logo-color.svg","resource_type":"image","raw_transformation":"","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1645182199/snyk-marketingui/brand-logos/wordmark-logo-color.svg"}],"companyUrl":"https://snyk.io/","region":"americas","size":"enterprise","isCustomer":false,"isPartner":false}},"linkedInUrl":"https://github.com/lirantal","githubUrl":"https://twitter.com/liran_tal"}}],"publishDate":"2018-12-06T17:39-05:00","excerpt":"A look back at the chain of events that led to the use of the malicious npm package \"flatmap-stream\" and a reflection on what it means for the fragility of open source.","article":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Last week the ","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"imaginable","nodeType":"text"},{"data":{},"marks":[],"value":" happened. A malicious package, flatmap-stream, was published to npm and was later added as a dependency to the widely used event-stream package by user ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":". Some time, and 8 million downloads later, applications all over the web were unwittingly running ","nodeType":"text"},{"data":{"uri":"/learn/malicious-code/"},"content":[{"data":{},"marks":[],"value":"malicious code","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" in production. We wrote some ","nodeType":"text"},{"data":{"uri":"/blog/malicious-code-found-in-npm-package-event-stream"},"content":[{"data":{},"marks":[],"value":"early thoughts on our blog last week","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", moments after the incident came to light, but are now able to perform a deeper post-mortem including a timeline of the events as they took place. Thanks go to many others who also investigated this issue, and in particular GitHub user ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"maths22","nodeType":"text"},{"data":{},"marks":[],"value":", who reverse engineered the malicious code.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"What is the event-stream package?","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"The event-stream package is a toolkit that provides utilities to creating and managing streams. Authored by Dominic Tarr (","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"~dominictarr","nodeType":"text"},{"data":{},"marks":[],"value":" on npmjs), it is one of ","nodeType":"text"},{"data":{"uri":"https://www.npmjs.com/~dominictarr"},"content":[{"data":{},"marks":[],"value":"422 packages","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" he owns on npmjs. The event-stream package has a total of 84 releases, dating back to v0.5.2, in 2011, and having regular releases up until version 3.3.4, two years ago.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Throughout event-steam’s total development, it received contributions from ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/graphs/contributors"},"content":[{"data":{},"marks":[],"value":"33 different contributors","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", but most of its contributions were delivered in its early days and has only reviewed minor changes since then:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"10N4gdEpGE5KjYJuvKIqsT","type":"Entry","createdAt":"2022-10-18T17:05:39.065Z","updatedAt":"2022-10-18T17:51:29.128Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"github-project-commits.png\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/github-project-commits.png","tags":[],"type":"upload","bytes":16773,"width":1200,"format":"png","height":855,"version":1544003567,"duration":null,"metadata":[],"context":{"custom":{"caption":"github-project-commits","cld_wp_plugin":"1","guid":"5c3bebba63934452e2689839d72f66e5"}},"public_id":"github-project-commits","created_at":"2018-12-05T09:52:47Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/github-project-commits.png","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1544003567/github-project-commits.png","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1544003567/github-project-commits.png","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[],"value":"The project had received over 2000 stars, been forked 139 times and 62 GitHub users have signed-up for notifications on any changes happening in the project. The project was used by 3931 other packages (excluding scoped packages).","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The Timeline of Events","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"Here is a timeline showing some of the major milestones in the project history, and the key moments during the malicious incident. We’ll look into each point on the timeline, and more, in detail below.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"b87Jr09oQCrzChDM4WFPQ","type":"Entry","createdAt":"2022-10-18T17:07:26.692Z","updatedAt":"2022-10-18T17:51:29.151Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":6,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"event-stream-timeline.jpg\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003568/event-stream-timeline.jpg","tags":[],"type":"upload","bytes":72732,"width":930,"format":"jpg","height":537,"version":1544003568,"duration":null,"metadata":[],"context":{"custom":{"caption":"event-stream-timeline","cld_wp_plugin":"1","guid":"d03c445a1e4367ff5a19a8790ae1fed8"}},"public_id":"event-stream-timeline","created_at":"2018-12-05T09:52:48Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003568/event-stream-timeline.jpg","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1544003568/event-stream-timeline.jpg","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1544003568/event-stream-timeline.jpg","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[],"value":"Chain of Events","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"We’ll take a look at the chain of events which led up to the use of the malicious flatmap-stream package. These events were researched from public GitHub information, Google cache, and npm.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"31st July, 2015:","nodeType":"text"},{"data":{},"marks":[],"value":" GitHub user, ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"devinus","nodeType":"text"},{"data":{},"marks":[],"value":", ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/issues/73"},"content":[{"data":{},"marks":[],"value":"comments on an issue","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" on the event-stream project questioning whether a flatmap functionality would be welcomed, to which the package maintainer, ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"dominictarr","nodeType":"text"},{"data":{},"marks":[],"value":", replies positively stating that a user contribution would be accepted:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"76bc669RMk2MowZXiwJRtp","type":"Entry","createdAt":"2022-10-18T17:45:44.427Z","updatedAt":"2022-10-18T17:51:29.177Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":6,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"original-github-flatmap-issue-request.png\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1663728798/wordpress-sync/original-github-flatmap-issue-request.png","tags":[],"type":"upload","bytes":44194,"width":1200,"format":"png","height":611,"version":1663728798,"duration":null,"metadata":[],"public_id":"wordpress-sync/original-github-flatmap-issue-request","created_at":"2022-09-21T02:53:18Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1663728798/wordpress-sync/original-github-flatmap-issue-request.png","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1663728798/wordpress-sync/original-github-flatmap-issue-request.png","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1663728798/wordpress-sync/original-github-flatmap-issue-request.png","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[],"value":"We could speculate that the later to be discovered malicious user ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":" could well have used this information to plan and execute an elaborate social engineering attack on the project.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"August 5, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" a user who identified as ","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"\"Antonio Macias\"","nodeType":"text"},{"data":{},"marks":[],"value":" in npm created and published a non-malicious package called flatmap-stream.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Next, Antonio Macias proposed that the event-stream project used in the flatmap package. GitHub user ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":" approached Dominic Tarr asking to assist with the project and to make the necessary changes to introduce the flatmap functionality, by pulling in the flatmap-stream dependency. Dominic accepted ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":"’s offer and makes them a contributor to the event-stream GitHub project, as well as gave ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":" full npm publishing rights for the module on the npm ecosystem. Dominic later confirmed during the incident report that he no longer had any publishing rights for the module on npm to remedy the incident (i.e. by removing the infected 3.3.6 version from npm).","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Soon after, a series of innocuous commits were pushed by ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":" to the event-stream GitHub repository:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 4, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" an innocent ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/a74c9b2ab433c4e36089fbb72931f6b786b550f5"},"content":[{"data":{},"marks":[],"value":"dependency upgrade","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 4/5, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" added map and split examples ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/0cc6c7f6c762ef7a8c288296d537d4255337c105"},"content":[{"data":{},"marks":[],"value":"0cc","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/ee8f8e4e9297890fdf3cb66584589eb493477832"},"content":[{"data":{},"marks":[],"value":"ee8","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/c08d14b777aa48524948c6d0de024096bf2c2095"},"content":[{"data":{},"marks":[],"value":"c08","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/05b0224c058a721ed293b1fc2ac3c0c608a644c5"},"content":[{"data":{},"marks":[],"value":"05b","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 5, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" released event-stream version 3.3.5 with ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/918d4a3398166d6f4264f7fc4ec2cc43f731ab0e"},"content":[{"data":{},"marks":[],"value":"918","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 9, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" the flatmap-stream dependency was added under ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/e3163361fed01384c986b9b4c18feb1fc42b8285"},"content":[{"data":{},"marks":[],"value":"e31","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 9, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" created a new minor event-stream release 3.3.6 in ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/5999958dfc1b0a80e6caeac4cdc76b3b828bdfe2"},"content":[{"data":{},"marks":[],"value":"599","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 16, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" flatmap-stream was removed from the event-stream code in ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/908fee5c65d4eb02809a84a1ebc3e5df1f935cd1"},"content":[{"data":{},"marks":[],"value":"908","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" and from the dependency tree in ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/2bd63d58fe24367372690c29c7249ed1c7145601"},"content":[{"data":{},"marks":[],"value":"2bd","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" and released as a major version, 4.0.0","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"September 20, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":" adds further cosmetic code changes that enhance the project’s keywords in ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/commit/60d0aa3def10c09ead68ee43804f244ffbd3b9c9"},"content":[{"data":{},"marks":[],"value":"60d","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" to presumably further improve the search results on the official npmjs.com registry website","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"October 5, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" a new minor version flatmap-stream@0.1.1 was released with the injection attack in its minified source code. Installations of event-stream will now also fetch the new infected 0.1.1 version of flatmap as a transient dependency.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"There is no more evidence of any further work to the event-stream project by the ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"right9ctrl","nodeType":"text"},{"data":{},"marks":[],"value":" user, whose profile has now been removed from GitHub and npm, although can still be ","nodeType":"text"},{"data":{"uri":"https://webcache.googleusercontent.com/search?q=cache:Lyox1SZ96zAJ:https://github.com/right9ctrl+\u0026cd=1\u0026hl=en\u0026ct=clnk\u0026gl=il"},"content":[{"data":{},"marks":[],"value":"accessed via Google cache","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" for introspection:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"3iVO42HsKgnjQdQLMlvbWT","type":"Entry","createdAt":"2022-10-18T17:47:05.287Z","updatedAt":"2022-10-18T17:51:29.199Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"right9ctrl-github-account.png\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003568/right9ctrl-github-account.png","tags":[],"type":"upload","bytes":68786,"width":1200,"format":"png","height":701,"version":1544003568,"duration":null,"metadata":[],"context":{"custom":{"caption":"right9ctrl-github-account","cld_wp_plugin":"1","guid":"a9f0a17265c6ea8f2d8d064e79873dfa"}},"public_id":"right9ctrl-github-account","created_at":"2018-12-05T09:52:48Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003568/right9ctrl-github-account.png","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1544003568/right9ctrl-github-account.png","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1544003568/right9ctrl-github-account.png","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"October 29, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"jaydenseric","nodeType":"text"},{"data":{},"marks":[],"value":" opened an ","nodeType":"text"},{"data":{"uri":"https://github.com/remy/nodemon/issues/1442"},"content":[{"data":{},"marks":[],"value":"issue against nodemon","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" reporting an unexpected deprecation warning. This message is in line with OpenSSL's recommendation to use a more modern algorithm instead of ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"EVP_BytesToKey","nodeType":"text"},{"data":{},"marks":[],"value":" it is recommended that developers derive a key and IV on their own using ","nodeType":"text"},{"data":{"uri":"https://docs.google.com/document/d/19g1krCBUjjPyz7mkKT-xNoJXIG_PQYcZCm0HfcH8DnM/edit#"},"content":[{"data":{},"marks":[{"type":"code"}],"value":"crypto.scrypt()","nodeType":"text"},{"data":{},"marks":[],"value":" and to use ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"crypto.createDecipheriv()","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" to create the Decipher object.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"4Mxi9RJy4RvNpQMnoXZCHU","type":"Entry","createdAt":"2022-10-18T17:47:47.861Z","updatedAt":"2022-10-18T17:51:29.223Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"jayden-seric-deprecation-issue.png\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/jayden-seric-deprecation-issue.png","tags":[],"type":"upload","bytes":50778,"width":1200,"format":"png","height":782,"version":1544003567,"duration":null,"metadata":[],"context":{"custom":{"caption":"jayden-seric-deprecation-issue","cld_wp_plugin":"1","guid":"3f1646854c59489c4d325e3f3580d632"}},"public_id":"jayden-seric-deprecation-issue","created_at":"2018-12-05T09:52:47Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/jayden-seric-deprecation-issue.png","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1544003567/jayden-seric-deprecation-issue.png","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1544003567/jayden-seric-deprecation-issue.png","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[],"value":"November 19, 2018: ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"NewEraCracker","nodeType":"text"},{"data":{},"marks":[],"value":" opened an issue ","nodeType":"text"},{"data":{"uri":"https://github.com/remy/nodemon/issues/1451"},"content":[{"data":{},"marks":[],"value":"against event-stream","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"3YhsShPG1JdxSP1inU1jEd","type":"Entry","createdAt":"2022-10-18T17:49:09.475Z","updatedAt":"2022-10-18T17:51:29.245Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"neweracracker-comment.png\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/neweracracker-comment.png","tags":[],"type":"upload","bytes":40579,"width":1200,"format":"png","height":502,"version":1544003567,"duration":null,"metadata":[],"context":{"custom":{"caption":"neweracracker-comment","cld_wp_plugin":"1","guid":"68af3653cf06455ae263f1767c1f430a"}},"public_id":"neweracracker-comment","created_at":"2018-12-05T09:52:47Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/neweracracker-comment.png","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1544003567/neweracracker-comment.png","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1544003567/neweracracker-comment.png","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 19, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"NewEraCracker","nodeType":"text"},{"data":{},"marks":[],"value":" opened an issue ","nodeType":"text"},{"data":{"uri":"https://github.com/remy/nodemon/issues/1451"},"content":[{"data":{},"marks":[],"value":"against nodemon.","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"6QyQApsZbBulLJnSXJHsNj","type":"Entry","createdAt":"2022-10-18T17:49:55.688Z","updatedAt":"2022-10-18T17:51:29.269Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":4,"revision":2,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contentCloudinaryAsset"}},"locale":"en-US"},"fields":{"internalName":"\"neweracracker-suspicious-issue.png\" - original","asset":[{"url":"http://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/neweracracker-suspicious-issue.png","tags":[],"type":"upload","bytes":53569,"width":1200,"format":"png","height":653,"version":1544003567,"duration":null,"metadata":[],"context":{"custom":{"caption":"neweracracker-suspicious-issue","cld_wp_plugin":"1","guid":"a4c511175786b4cd0bdc3c442731b1dd"}},"public_id":"neweracracker-suspicious-issue","created_at":"2018-12-05T09:52:47Z","secure_url":"https://res.cloudinary.com/snyk/image/upload/f_auto/q_auto/v1544003567/neweracracker-suspicious-issue.png","resource_type":"image","original_url":"http://res.cloudinary.com/snyk/image/upload/v1544003567/neweracracker-suspicious-issue.png","original_secure_url":"https://res.cloudinary.com/snyk/image/upload/v1544003567/neweracracker-suspicious-issue.png","raw_transformation":"f_auto/q_auto"}]}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 20, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"FallingSnow","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{"uri":"https://github.com/remy/nodemon/issues/1442#issuecomment-440435714"},"content":[{"data":{},"marks":[],"value":"suspects it’s an injection attack.","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 20, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"FallingSnow","nodeType":"text"},{"data":{},"marks":[],"value":" opens the ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/issues/116"},"content":[{"data":{},"marks":[],"value":"issue against event-stream.","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":"  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 26, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" HackerNews ","nodeType":"text"},{"data":{"uri":"https://news.ycombinator.com/item?id=18534392"},"content":[{"data":{},"marks":[],"value":"post appears","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", and the issue made it to the social media.  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 26, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" flatmap-stream package got removed from npm.  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 26, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" Multiple users report the issue to Snyk via the ","nodeType":"text"},{"data":{"uri":"/vulnerability-disclosure"},"content":[{"data":{},"marks":[],"value":"Vulnerability Submission Form","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 26, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" Snyk adds the malicious package entry to it’s ","nodeType":"text"},{"data":{"uri":"/vuln/SNYK-JS-EVENTSTREAM-72638"},"content":[{"data":{},"marks":[],"value":"vulnerability database","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", notifying all monitored projects.  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 26, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" Danny Grander from Snyk reported ","nodeType":"text"},{"data":{"uri":"https://hackerone.com/reports/450006"},"content":[{"data":{},"marks":[],"value":"the issue","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" to Node.js Foundation Security WG  ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"November 27, 2018:","nodeType":"text"},{"data":{},"marks":[],"value":" Snyk published a ","nodeType":"text"},{"data":{"uri":"/blog/malicious-code-found-in-npm-package-event-stream"},"content":[{"data":{},"marks":[],"value":"blog post","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" on the issue.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The Target: Copay","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"Upon a more detailed inspection of the flatmap-stream code, we can see that this was a surgically targeted attack on ","nodeType":"text"},{"data":{"uri":"https://copay.io/"},"content":[{"data":{},"marks":[],"value":"Copay","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", a secure bitcoin wallet platform.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The malicious flatmap-stream code was downloaded millions of times, and executed many million more. The attackers could have done countless evil things here. But instead, their strategy was to wait for the opportunity to be executed when the Copay app was being built. They succeeded, and were built into Copay versions 5.0.2 to 5.1.0.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The decryption code looked for the key in an environment variable named npm_package_description. This environment variable is set by npm in the root package’s description. It would be only be decrypted if the client application was the bitcoin wallet, Copay, which used the key to decrypt the payload as “A Secure Bitcoin Wallet”. The latter was found by ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"maths22","nodeType":"text"},{"data":{},"marks":[],"value":" as he brute forced various npm package descriptions.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"To work this out, the user, ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"maths22","nodeType":"text"},{"data":{},"marks":[],"value":", ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/issues/116#issuecomment-441745006"},"content":[{"data":{},"marks":[],"value":"enumerated over different npm package descriptions","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", using them as keys, to decrypt the payload. However this wasn’t all, the second payload would execute upon running a ","nodeType":"text"},{"data":{"uri":"https://github.com/bitpay/copay/blob/master/package.json#L70-L72"},"content":[{"data":{},"marks":[],"value":"specific build commands","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":", essentially only when the ios, android, or desktop applications are being built.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The ","nodeType":"text"},{"data":{"uri":"https://gist.github.com/jsoverson/3df528d4f0be857fe03c32dafc56a486#file-payload-c-js"},"content":[{"data":{},"marks":[],"value":"third and final payload","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" is JavaScript code that will be injected into another dependency, namely ","nodeType":"text"},{"data":{},"marks":[{"type":"code"}],"value":"./node_modules/@zxing/library/esm5/core/common/reedsolomon/ReedSolomonDecoder.js","nodeType":"text"},{"data":{},"marks":[],"value":". This was then executed within the app itself, unlike the first two payloads which were executed during build time.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The malicious code harvested Bitcoins along with the wallet private keys, if the wallet balance was above 100 Bitcoins or 1000 BHC (Bitcoin Cash). Copay issued the following advice to their users:","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Users should not attempt to move funds to new wallets by importing affected wallets' twelve word backup phrases (which correspond to potentially compromised private keys). Users should first update their affected wallets (5.0.2-5.1.0) and then send all funds from affected wallets to a brand new wallet on version 5.2.0, using the Send Max feature to initiate transactions of all funds.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"blockquote"},{"data":{},"content":[{"data":{},"marks":[],"value":"The further suggested that users \"should assume\" their private keys may have been compromised, and react by \"immediately\" moving any holdings to new, secure v5.2.0 wallets.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"From the post-mortem of the events and the attack, we can see that this was a well planned and well executed attack, which was performed by professionals and likely took months of preparation.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Conclusion","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"The series of events that have been described in this blog are another reminder of how fragile the open-source model can be if not respected. If widely used packages, such as event-stream, were supported by just a small proportion of those who consume it, and take value from it, the malicious takeover could easily have been avoided. The event-stream package was included as a dependency all over the npm ecosystem, being included in at least ","nodeType":"text"},{"data":{"uri":"https://github.com/dominictarr/event-stream/files/2616706/flatmap-deps-list.txt"},"content":[{"data":{},"marks":[],"value":"3931","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" packages as a dependency. Most notably, affecting top level packages such as: @vue/cli-ui, vscode, nodemon, and ps-tree.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The malicious package could have even remained unnoticed if not for the deprecation message that caused Jayden Seric to open an issue on the nodemon package. Otherwise, it’s likely it would have not been found for a long time.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"At Snyk, we are big advocates for responsible disclosure and practice security research as part of our culture. If you discover a vulnerability that you would like to responsibly disclose, we’re happy to hear from you via our ","nodeType":"text"},{"data":{"uri":"/vulnerability-disclosure"},"content":[{"data":{},"marks":[],"value":"responsible disclosure form","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"},{"data":{"uri":"/vulnerability-disclosure"},"content":[{"data":{},"marks":[],"value":"Submit a disclosure","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":".","nodeType":"text"}],"nodeType":"paragraph"},{"data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"3vJaoLVyg95RpmtPdJwbUb","type":"Entry","createdAt":"2022-09-26T22:03:13.895Z","updatedAt":"2025-03-31T13:42:38.187Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":112,"revision":68,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"organismBodyCta"}},"locale":"en-US"},"fields":{"internalName":"(When not promoting CTF) Developer free - Snyk Platform 2","headline":"Get started in capture the flag","description":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"Learn how to solve capture the flag challenges by watching our virtual 101 workshop on demand.","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"},"actions":[{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"oyrbri43adzz"}},"id":"1m2Z62mDaC4d6K4IGnaf6a","type":"Entry","createdAt":"2024-04-24T17:08:37.784Z","updatedAt":"2025-03-31T13:42:38.203Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":51,"revision":10,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"atomButton"}},"locale":"en-US"},"fields":{"internalName":"\"Watch now\" - Capture the Flag 101 Workshop Webinar","label":"Watch now","url":"https://go.snyk.io/240418_ctf-101-workshop.html","appearance":{"button":{}}}}],"appearance":{"bodyCta":{}}}}},"content":[],"nodeType":"embedded-entry-block"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}}},"enPage":null,"menu":{"__typename":"NavigationPrimary","announcementBar":null,"customLogo":"wordmark","customLogoLink":null,"actions":{"__typename":"NavigationPrimaryActionsCollection","items":[{"sys":{"id":"jZfGXRe3L9UtIHd0zy87C","__typename":"Sys"},"__typename":"AtomButton","label":"Sign up","url":