{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0073/design-note.schema.json",
  "title": "CNL-0073 proof-of-impossibility design note",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "claims",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "both_states"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0073" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "pattern": "^SUCCESS:CNL-0073" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "both_states": {
      "type": "object",
      "required": [
        "incomplete_qualifies",
        "exhaustive_qualifies",
        "incomplete_classification",
        "exhaustive_classification"
      ],
      "properties": {
        "incomplete_qualifies": { "type": "boolean", "const": false },
        "exhaustive_qualifies": { "type": "boolean", "const": true },
        "incomplete_classification": {
          "type": "string",
          "const": "UNSUCCESSFUL_SEARCH"
        },
        "exhaustive_classification": {
          "type": "string",
          "const": "EXHAUSTIVE_REFUTATION"
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "kind", "claim", "mechanism"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "kind": { "type": "string", "minLength": 3 },
          "claim": { "type": "string", "minLength": 8 },
          "mechanism": { "type": "string", "minLength": 4 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rejects", "verbatim"],
        "properties": {
          "id": { "type": "string" },
          "rejects": { "type": "string", "minLength": 8 },
          "verbatim": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "re_ran_both_states"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" },
        "re_ran_both_states": { "type": "boolean", "const": true },
        "vendor": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
