{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0040/council-design-note.schema.json",
  "$comment": "Live compiling contract for CNL-0040. The catalog output_schema is a $ref shim to https://ast-integrate.invalid/ which this host cannot fetch. G-1 json.loads the catalog path; this file is the schema the named probes actually compile.",
  "title": "CNL-0040 JUDICIAL runtime design note",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "family",
    "family_count",
    "protocols",
    "both_states",
    "negative_control",
    "tests",
    "negative_controls",
    "reviewer",
    "evidence",
    "artifacts",
    "report"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0040" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0040" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "family": { "type": "string", "const": "JUDICIAL" },
    "family_count": { "type": "integer", "minimum": 6, "maximum": 6 },
    "protocols": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "executable",
          "turn_schedule",
          "admissibility_standard",
          "who_rules_on_admissibility",
          "who_decides"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "enum": ["P14", "P15", "P16", "P17", "P18", "P19"]
          },
          "executable": { "type": "boolean" },
          "turn_schedule": { "type": "array", "minItems": 3 },
          "admissibility_standard": { "type": "string", "minLength": 8 },
          "who_rules_on_admissibility": { "type": "string", "minLength": 3 },
          "who_decides": { "type": "string", "minLength": 3 }
        }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["silent_on_good", "fires_on_bad"],
      "properties": {
        "silent_on_good": { "type": "boolean", "const": true },
        "fires_on_bad": { "type": "boolean", "const": true }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["fires", "verbatim", "statement"],
      "properties": {
        "fires": { "type": "boolean", "const": true },
        "verbatim": { "type": "string", "minLength": 24 },
        "statement": { "type": "string", "minLength": 24 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rejects"],
        "properties": {
          "id": { "type": "string" },
          "rejects": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["kind", "observations", "control_ids"],
      "properties": {
        "kind": { "type": "string", "const": "council-design-note" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "measured", "method", "anchor"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "measured": { "type": ["string", "number", "boolean"] },
              "method": { "type": "string", "minLength": 1 },
              "anchor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
