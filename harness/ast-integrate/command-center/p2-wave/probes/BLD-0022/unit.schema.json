{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/BLD-0022/unit.schema.json",
  "$comment": "Executable G-1 schema for BLD-0022. The catalog path command-center/schema/provenance-audit.schema.json is a generated $ref shim whose $id is a non-resolving https://ast-integrate.invalid URL; Draft7Validator tries the network and fails closed. Named probes read selected_options, control_classifications, and extra reviewer fields at the receipt root, so this schema validates that live shape rather than receipt_core additionalProperties:false.",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "selected_options",
    "control_classifications",
    "owner_packet",
    "reviewer",
    "evidence",
    "tests",
    "source_availability"
  ],
  "properties": {
    "unit_id": { "const": "BLD-0022" },
    "state": { "const": "SUCCESS" },
    "sentinel": {
      "type": "string",
      "pattern": "SUCCESS:BLD-0022"
    },
    "selected_options": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/definitions/row" }
    },
    "control_classifications": {
      "type": "array",
      "minItems": 4,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": { "const": "CTRL-PR-ONLY-FIXTURE" },
              "classification": { "const": "OWNER-EXPLICIT" }
            },
            "required": ["id", "classification"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": { "const": "CTRL-Z-00-AGENT-ASSUMED" },
              "classification": { "const": "AGENT-ASSUMED" }
            },
            "required": ["id", "classification"]
          }
        }
      ],
      "items": { "$ref": "#/definitions/row" }
    },
    "owner_packet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "ask_the_owner"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classification": { "const": "AGENT-ASSUMED" },
          "ask_the_owner": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_id",
        "verdict",
        "independent",
        "input_was_quotes_only",
        "rescored_count"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "verdict": { "const": "PASS" },
        "independent": { "const": true },
        "input_was_quotes_only": { "const": true },
        "rescored_count": { "type": "integer", "minimum": 5 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "line", "snippet", "claim", "anchor"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "snippet": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": { "const": "PASS" }
        }
      }
    },
    "source_availability": {
      "type": "object",
      "required": ["checked", "present", "absent", "prompt_two_placeholder"],
      "properties": {
        "checked": { "type": "array", "minItems": 1 },
        "present": { "type": "array" },
        "absent": { "type": "array", "minItems": 1 },
        "prompt_two_placeholder": { "const": "[PASTE SELECTED OPTION IDS HERE]" }
      }
    }
  },
  "definitions": {
    "row": {
      "type": "object",
      "required": ["id", "treated_as", "classification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "treated_as": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": ["OWNER-EXPLICIT", "OWNER-IMPLIED", "AGENT-ASSUMED"]
        },
        "owner_quote": { "type": ["string", "null"] },
        "owner_quote_anchor": { "type": ["string", "null"] },
        "routed_to_owner": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "classification": { "const": "OWNER-EXPLICIT" } },
            "required": ["classification"]
          },
          "then": {
            "required": ["owner_quote", "owner_quote_anchor"],
            "properties": {
              "owner_quote": { "type": "string", "minLength": 8 },
              "owner_quote_anchor": { "type": "string", "minLength": 3 }
            }
          }
        },
        {
          "if": {
            "properties": { "classification": { "const": "AGENT-ASSUMED" } },
            "required": ["classification"]
          },
          "then": {
            "properties": { "routed_to_owner": { "const": true } },
            "required": ["routed_to_owner"]
          }
        }
      ]
    }
  }
}
