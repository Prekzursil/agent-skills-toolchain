{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0123/research-claim-record.schema.json",
  "title": "Research claim record (RES-0123 local envelope)",
  "description": "Discriminating envelope. Garbage without required fields must fail. A claim missing source_lineage must fail.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "claims",
    "tests",
    "reviewer",
    "conflicts_with_current_practice",
    "no_legal_conclusion"
  ],
  "properties": {
    "unit_id": { "type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{4}$" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "report_kind": { "type": "string", "const": "research-claim-record" },
    "question": { "type": "string", "minLength": 40 },
    "no_legal_conclusion": { "type": "boolean", "const": true },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "canonical_mechanism",
          "source_lineage",
          "evidence_tier",
          "confidence_band",
          "named_settling_probe",
          "verbatim_quote"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "canonical_mechanism": { "type": "string", "minLength": 4 },
          "source_lineage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url", "fetched_at", "http_status", "sha256"],
              "properties": {
                "url": { "type": "string", "minLength": 8 },
                "fetched_at": { "type": "string", "minLength": 10 },
                "http_status": { "type": "integer" },
                "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
              }
            }
          },
          "evidence_tier": { "type": "string", "enum": ["E1", "E2", "E3", "E4"] },
          "confidence_band": { "type": "string", "minLength": 2 },
          "named_settling_probe": { "type": "string", "minLength": 4 },
          "verbatim_quote": { "type": "string", "minLength": 20 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 2 },
        "independent": { "type": "boolean" }
      }
    },
    "conflicts_with_current_practice": { "type": "array" }
  }
}
