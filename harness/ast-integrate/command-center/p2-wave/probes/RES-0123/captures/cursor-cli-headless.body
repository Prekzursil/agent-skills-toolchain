tps://cursor.com/install -fsS | bash\\n\\n# Install Cursor CLI (Windows PowerShell)\\nirm 'https://cursor.com/install?win32=true' | iex\\n\\n# Set API key for scripts\\nexport CURSOR_API_KEY=your_api_key_here\\nagent -p \\\"Analyze this code\\\"\"}]}]}]\n34:[\"$\",\"$L2b\",null,{\"className\":\"mt-12 mb-4\",\"children\":\"Example scripts\"}]\n35:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"Use different output formats for different script needs. See \",[\"$\",\"$L26\",null,{\"className\":\"text-foreground underline decoration-neutral-600 underline-offset-2 transition-colors hover:decoration-neutral-700\",\"href\":\"/docs/cli/reference/output-format\",\"children\":\"Output format\"}],\" for details.\"]}]\n36:[\"$\",\"$L2c\",null,{\"className\":\"mb-3\",\"children\":\"Searching the codebase\"}]\n37:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"By default, \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"--print\"}],\" uses \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"text\"}],\" format for clean, final-answer-only responses:\"]}]\n38:[\"$\",\"div\",null,{\"className\":\"mb-4\",\"children\":[\"$\",\"$L2d\",null,{\"code\":\"#!/bin/bash\\n# Simple codebase question - uses text format by default\\n\\nagent -p \\\"What does this codebase do?\\\"\",\"language\":\"bash\",\"title\":\"$undefined\",\"children\":[\"$\",\"$L2e\",null,{\"language\":\"bash\",\"children\":\"#!/bin/bash\\n# Simple codebase question - uses text format by default\\n\\nagent -p \\\"What does this codebase do?\\\"\"}]}]}]\n39:[\"$\",\"$L2c\",null,{\"className\":\"mb-3\",\"children\":\"Automated code review\"}]\n3a:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"Use \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"--o"])</script><script>self.__next_f.push([1,"utput-format json\"}],\" for structured analysis:\"]}]\n3b:[\"$\",\"div\",null,{\"className\":\"mb-4\",\"children\":[\"$\",\"$L2d\",null,{\"code\":\"#!/bin/bash\\n# simple-code-review.sh - Basic code review script\\n\\necho \\\"Starting code review...\\\"\\n\\n# Review recent changes\\nagent -p --force --output-format text \\\\\\n  \\\"Review the recent code changes and provide feedback on:\\n  - Code quality and readability\\n  - Potential bugs or issues\\n  - Security considerations\\n  - Best practices compliance\\n\\n  Provide specific suggestions for improvement and write to review.txt\\\"\\n\\nif [ $? -eq 0 ]; then\\n  echo \\\"✅ Code review completed successfully\\\"\\nelse\\n  echo \\\"❌ Code review failed\\\"\\n  exit 1\\nfi\",\"language\":\"bash\",\"title\":\"$undefined\",\"children\":[\"$\",\"$L2e\",null,{\"language\":\"bash\",\"children\":\"#!/bin/bash\\n# simple-code-review.sh - Basic code review script\\n\\necho \\\"Starting code review...\\\"\\n\\n# Review recent changes\\nagent -p --force --output-format text \\\\\\n  \\\"Review the recent code changes and provide feedback on:\\n  - Code quality and readability\\n  - Potential bugs or issues\\n  - Security considerations\\n  - Best practices compliance\\n\\n  Provide specific suggestions for improvement and write to review.txt\\\"\\n\\nif [ $? -eq 0 ]; then\\n  echo \\\"✅ Code review completed successfully\\\"\\nelse\\n  echo \\\"❌ Code review failed\\\"\\n  exit 1\\nfi\"}]}]}]\n3c:[\"$\",\"$L2c\",null,{\"className\":\"mb-3\",\"children\":\"Real-time progress tracking\"}]\n3d:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":[\"Use \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"--output-format stream-json\"}],\" for message-level progress tracking, or add \",[\"$\",\"code\",null,{\"className\":\"rounded-sm border border-border bg-card/80 p-1 font-mono text-xs\",\"children\":\"--stream-partial-output\"}],\" for incremental streaming of deltas:\"]}]\n4e:Tbad,"])</script><script>self.__next_f.push([1,"#!/bin/bash\n# stream-progress.sh - Track progress in real-time\n\necho \"🚀 Starting stream processing...\"\n\n# Track progress in real-time\naccumulated_text=\"\"\ntool_count=0\nstart_time=$(date +%s)\n\nagent -p --force --output-format stream-json --stream-partial-output \\\n  \"Analyze this project structure and create a summary report in analysis.txt\" | \\\n  while IFS= read -r line; do\n    \n    type=$(echo \"$line\" | jq -r '.type // empty')\n    subtype=$(echo \"$line\" | jq -r '.subtype // empty')\n    \n    case \"$type\" in\n      \"system\")\n        if [ \"$subtype\" = \"init\" ]; then\n          model=$(echo \"$line\" | jq -r '.model // \"unknown\"')\n          echo \"🤖 Using model: $model\"\n        fi\n        ;;\n        \n      \"assistant\")\n        # Only process streaming deltas (timestamp_ms present, no model_call_id).\n        # Skip buffered flushes before tool calls and at end of turn.\n        has_ts=$(echo \"$line\" | jq 'has(\"timestamp_ms\")')\n        has_mc=$(echo \"$line\" | jq 'has(\"model_call_id\")')\n        if [ \"$has_ts\" = \"true\" ] \u0026\u0026 [ \"$has_mc\" = \"false\" ]; then\n          content=$(echo \"$line\" | jq -r '.message.content[0].text // empty')\n          accumulated_text=\"$accumulated_text$content\"\n          printf \"\\r📝 Generating: %d chars\" ${#accumulated_text}\n        fi\n        ;;\n\n      \"tool_call\")\n        if [ \"$subtype\" = \"started\" ]; then\n          tool_count=$((tool_count + 1))\n\n          # Extract tool information\n          if echo \"$line\" | jq -e '.tool_call.writeToolCall' \u003e /dev/null 2\u003e\u00261; then\n            path=$(echo \"$line\" | jq -r '.tool_call.writeToolCall.args.path // \"unknown\"')\n            echo -e \"\\n🔧 Tool #$tool_count: Creating $path\"\n          elif echo \"$line\" | jq -e '.tool_call.readToolCall' \u003e /dev/null 2\u003e\u00261; then\n            path=$(echo \"$line\" | jq -r '.tool_call.readToolCall.args.path // \"unknown\"')\n            echo -e \"\\n📖 Tool #$tool_count: Reading $path\"\n          fi\n\n        elif [ \"$subtype\" = \"completed\" ]; then\n          # Extract and show tool results\n          if echo \"$line\" | jq -e '.tool_call.writeToolCall.result.success' \u003e /dev/null 2\u003e\u00261; then\n            lines=$(echo \"$line\" | jq -r '.tool_call.writeToolCall.result.success.linesCreated // 0')\n            size=$(echo \"$line\" | jq -r '.tool_call.writeToolCall.result.success.fileSize // 0')\n            echo \"   ✅ Created $lines lines ($size bytes)\"\n          elif echo \"$line\" | jq -e '.tool_call.readToolCall.result.success' \u003e /dev/null 2\u003e\u00261; then\n            lines=$(echo \"$line\" | jq -r '.tool_call.readToolCall.result.success.totalLines // 0')\n            echo \"   ✅ Read $lines lines\"\n          fi\n        fi\n        ;;\n\n      \"result\")\n        duration=$(echo \"$line\" | jq -r '.duration_ms // 0')\n        end_time=$(date +%s)\n        total_time=$((end_time - start_time))\n\n        echo -e \"\\n\\n🎯 Completed in ${duration}ms (${total_time}s total)\"\n        echo \"📊 Final stats: $tool_count tools, ${#accumulated_text} chars generated\"\n        ;;\n    esac\n  done"])</script><script>self.__next_f.push([1,"4f:Tbad,"])</script><script>self.__next_f.push([1,"#!/bin/bash\n# stream-progress.sh - Track progress in real-time\n\necho \"🚀 Starting stream processing...\"\n\n# Track progress in real-time\naccumulated_text=\"\"\ntool_count=0\nstart_time=$(date +%s)\n\nagent -p --force --output-format stream-json --stream-partial-output \\\n  \"Analyze this project structure and create a summary report in analysis.txt\" | \\\n  while IFS= read -r line; do\n    \n    type=$(echo \"$line\" | jq -r '.type // empty')\n    subtype=$(echo \"$line\" | jq -r '.subtype // empty')\n    \n    case \"$type\" in\n      \"system\")\n        if [ \"$subtype\" = \"init\" ]; then\n          model=$(echo \"$line\" | jq -r '.model // \"unknown\"')\n          echo \"🤖 Using model: $model\"\n        fi\n        ;;\n        \n      \"assistant\")\n        # Only process streaming deltas (timestamp_ms present, no model_call_id).\n        # Skip buffered flushes before tool calls and at end of turn.\n        has_ts=$(echo \"$line\" | jq 'has(\"timestamp_ms\")')\n        has_mc=$(echo \"$line\" | jq 'has(\"model_call_id\")')\n        if [ \"$has_ts\" = \"true\" ] \u0026\u0026 [ \"$has_mc\" = \"false\" ]; then\n          content=$(echo \"$line\" | jq -r '.message.content[0].text // empty')\n          accumulated_text=\"$accumulated_text$content\"\n          printf \"\\r📝 Generating: %d chars\" ${#accumulated_text}\n        fi\n        ;;\n\n      \"tool_call\")\n        if [ \"$subtype\" = \"started\" ]; then\n          tool_count=$((tool_count + 1))\n\n          # Extract tool information\n          if echo \"$line\" | jq -e '.tool_call.writeToolCall' \u003e /dev/null 2\u003e\u00261; then\n            path=$(echo \"$line\" | jq -r '.tool_call.writeToolCall.args.path // \"unknown\"')\n            echo -e \"\\n🔧 Tool #$tool_count: Creating $path\"\n          elif echo \"$line\" | jq -e '.tool_call.readToolCall' \u003e /dev/null 2\u003e\u00261; then\n            path=$(echo \"$line\" | jq -r '.tool_call.readToolCall.args.path // \"unknown\"')\n            echo -e \"\\n📖 Tool #$tool_count: Reading $path\"\n          fi\n\n        elif [ \"$subtype\" = \"completed\" ]; then\n          # Extract and show tool results\n          if echo \"$line\" | jq -e '.tool_call.writeToolCall.result.success' \u003e /dev/null 2\u003e\u00261; then\n            lines=$(echo \"$line\" | jq -r '.tool_call.writeToolCall.result.success.linesCreated // 0')\n            size=$(echo \"$line\" | jq -r '.tool_call.writeToolCall.result.success.fileSize // 0')\n            echo \"   ✅ Created $lines lines ($size bytes)\"\n          elif echo \"$line\" | jq -e '.tool_call.readToolCall.result.success' \u003e /dev/null 2\u003e\u00261; then\n            lines=$(echo \"$line\" | jq -r '.tool_call.readToolCall.result.success.totalLines // 0')\n            echo \"   ✅ Read $lines lines\"\n          fi\n        fi\n        ;;\n\n      \"result\")\n        duration=$(echo \"$line\" | jq -r '.duration_ms // 0')\n        end_time=$(date +%s)\n        total_time=$((end_time - start_time))\n\n        echo -e \"\\n\\n🎯 Completed in ${duration}ms (${total_time}s total)\"\n        echo \"📊 Final stats: $tool_count tools, ${#accumulated_text} chars generated\"\n        ;;\n    esac\n  done"])</script><script>self.__next_f.push([1,"3e:[\"$\",\"div\",null,{\"className\":\"mb-4\",\"children\":[\"$\",\"$L2d\",null,{\"code\":\"$4e\",\"language\":\"bash\",\"title\":\"$undefined\",\"children\":[\"$\",\"$L2e\",null,{\"language\":\"bash\",\"children\":\"$4f\"}]}]}]\n3f:[\"$\",\"$L2b\",null,{\"className\":\"mt-12 mb-4\",\"children\":\"Working with images\"}]\n40:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"To send images, media files, or other binary data to the agent, include file paths in your prompts. The agent can read any files through tool calling, including images, videos, and other formats.\"}]\n41:[\"$\",\"$L2c\",null,{\"className\":\"mb-3\",\"children\":\"Including file paths in prompts\"}]\n42:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"Simply reference file paths in your prompt text. The agent will automatically read the files when needed:\"}]\n43:[\"$\",\"div\",null,{\"className\":\"mb-4\",\"children\":[\"$\",\"$L2d\",null,{\"code\":\"# Analyze an image\\nagent -p \\\"Analyze this image and describe what you see: ./screenshot.png\\\"\\n\\n# Process multiple media files\\nagent -p \\\"Compare these two images and identify differences: ./before.png ./after.png\\\"\\n\\n# Combine file paths with text instructions\\nagent -p \\\"Review the code in src/app.ts and the design mockup in designs/homepage.png. Suggest improvements to match the design.\\\"\",\"language\":\"bash\",\"title\":\"$undefined\",\"children\":[\"$\",\"$L2e\",null,{\"language\":\"bash\",\"children\":\"# Analyze an image\\nagent -p \\\"Analyze this image and describe what you see: ./screenshot.png\\\"\\n\\n# Process multiple media files\\nagent -p \\\"Compare these two images and identify differences: ./before.png ./after.png\\\"\\n\\n# Combine file paths with text instructions\\nagent -p \\\"Review the code in src/app.ts and the design mockup in designs/homepage.png. Suggest improvements to match the design.\\\"\"}]}]}]\n44:[\"$\",\"$L2c\",null,{\"className\":\"mb-3\",\"children\":\"How it works\"}]\n45:[\"$\",\"p\",null,{\"className\":\"text-base mb-4 leading-relaxed!\",\"ref\":\"$undefined\",\"children\":\"When you include file paths in your prompt:\"}]\n46:[\"$\",\"ol\",null,{\"className\":\"mb-4 prose-ol-markers\",\"style\":{\"listStyleType\":\"decimal\",\"listStylePosition\":\"outside\",\"paddingLeft\":\"calc(4rem / 3)\",\"lineHeight\":\"1.5\"},\"children\":[\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":\"The agent receives your prompt with the file path references\"}],\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":\"The agent uses tool calling to read the files automatically\"}],\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":\"15px\"},\"children\":\"Images are handled transparently\"}],\"\\n\",[\"$\",\"li\",null,{\"style\":{\"paddingInlineStart\":\"4px\",\"margin\":\"0 0 0.5rem 0\",\"fontSize\":