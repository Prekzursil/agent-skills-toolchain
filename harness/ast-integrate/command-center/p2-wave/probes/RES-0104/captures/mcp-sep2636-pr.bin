/api.github.com/repos/SylonZero/modelcontextprotocol/contents/{+path}","contributors_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/contributors","deployments_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/deployments","downloads_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/downloads","events_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/events","forks_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/forks","git_commits_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/git/commits{/sha}","git_refs_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/git/refs{/sha}","git_tags_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/git/tags{/sha}","git_url":"git://github.com/SylonZero/modelcontextprotocol.git","issue_comment_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/issues/comments{/number}","issue_events_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/issues/events{/number}","issues_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/issues{/number}","keys_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/keys{/key_id}","labels_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/labels{/name}","languages_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/languages","merges_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/merges","milestones_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/milestones{/number}","notifications_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/notifications{?since,all,participating}","pulls_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/pulls{/number}","releases_url":"https://api.github.com/repos/SylonZero/modelcontextprotocol/releases{/id}","ssh_url":"git@github.com:SylonZero/modelcontextprotocol.git","stargazers_url":"https://api.github