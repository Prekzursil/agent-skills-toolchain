    <meta name="dc.title" content="Expediting systematic reviews: methods and implications of rapid reviews"/>
    <meta name="dc.source" content="Implementation Science 2010 5:1"/>
    <meta name="dc.format" content="text/html"/>
    <meta name="dc.publisher" content="BioMed Central"/>
    <meta name="dc.date" content="2010-07-19"/>
