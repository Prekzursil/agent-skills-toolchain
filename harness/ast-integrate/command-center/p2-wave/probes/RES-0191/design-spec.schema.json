{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0191/design-spec.schema.json",
  "title": "RES-0191 local design-spec (catalog design-spec.schema.json is absent from this tree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "kind",
    "state",
    "sentinel",
    "question",
    "answer",
    "protocol",
    "distinct_from",
    "claims",
    "both_states",
    "tests",
    "reviewer",
    "source_lineage",
    "named_settling_probe",
    "freshness_stamp",
    "snapshot_sha256",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "const": "RES-0191" },
    "kind": { "const": "design-spec" },
    "state": { "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"] },
    "sentinel": { "const": "SUCCESS:RES-0191" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "canonical_mechanism": { "type": "string", "minLength": 16 },
    "protocol": {
      "type": "object",
      "required": ["durable_fields", "statuses", "resume_rules", "kill_point"],
      "properties": {
        "durable_fields": { "type": "array", "minItems": 6, "items": { "type": "string" } },
        "statuses": {
          "type": "array",
          "minItems": 4,
          "items": { "enum": ["not_started", "partial", "completed", "failed"] }
        },
        "resume_rules": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 8 } },
        "kill_point": { "type": "string", "minLength": 8 }
      }
    },
    "distinct_from": {
      "type": "object",
      "required": ["RES-0004", "RES-0171"],
      "properties": {
        "RES-0004": { "type": "string", "minLength": 24 },
        "RES-0171": { "type": "string", "minLength": 24 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/definitions/claim" }
    },
    "both_states": {
      "type": "object",
      "required": [
        "resume_matches_control",
        "corrupt_refused",
        "naive_skip_drops_claims",
        "completed_not_repaid"
      ],
      "properties": {
        "resume_matches_control": { "const": true },
        "corrupt_refused": { "const": true },
        "naive_skip_drops_claims": { "const": true },
        "completed_not_repaid": { "const": true }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string", "minLength": 8 },
          "result": { "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "default_without_evidence"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "const": true },
        "default_without_evidence": { "const": "REFUTED" }
      }
    },
    "source_lineage": { "type": "array", "minItems": 1 },
    "named_settling_probe": { "type": "string", "minLength": 8 },
    "freshness_stamp": { "type": "string", "minLength": 20 },
    "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifacts": { "type": "array", "minItems": 1 }
  },
  "definitions": {
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "text",
        "canonical_mechanism",
        "evidence_tier",
        "confidence_band",
        "verdict",
        "source_probe",
        "verifier_probe",
        "named_settling_probe",
        "freshness_stamp",
        "snapshot_sha256",
        "source_lineage",
        "rails",
        "strongest_caveat"
      ],
      "properties": {
        "claim_id": { "type": "string", "minLength": 3 },
        "text": { "type": "string", "minLength": 16 },
        "canonical_mechanism": { "type": "string", "minLength": 8 },
        "evidence_tier": { "enum": ["E1", "E2", "E3", "E4"] },
        "confidence_band": { "type": "string" },
        "verdict": { "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"] },
        "source_probe": { "type": "string", "minLength": 8 },
        "verifier_probe": { "type": "string", "minLength": 8 },
        "named_settling_probe": { "type": "string" },
        "freshness_stamp": { "type": "string" },
        "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_lineage": { "type": "array", "minItems": 1 },
        "rails": { "type": "array", "minItems": 2 },
        "strongest_caveat": { "type": "string", "minLength": 16 }
      }
    }
  }
}
