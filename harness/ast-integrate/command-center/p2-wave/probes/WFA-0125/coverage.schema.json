{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/wfa-0125/coverage.schema.json",
  "title": "WFA-0125 library-category CoverageMatrix (local stand-in; WFA-0001 pack absent)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "schema_version",
    "question",
    "answer",
    "cells",
    "counts",
    "generation_lane_goals",
    "keyword_trap",
    "both_states",
    "tests",
    "reviewer",
    "evidence",
    "artifacts",
    "min_bytes_threshold"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0125" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0125" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0125" },
    "report_kind": { "type": "string", "const": "coverage-matrix" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "answers": { "type": "object" },
    "output_schema_declared": { "type": "string" },
    "schema_pack_present": { "type": "boolean" },
    "local_schema": { "type": "string" },
    "source_inputs_on_this_tree": { "type": "object" },
    "spec_fragments": { "type": "object" },
    "requirement_extraction": { "type": "object" },
    "family_alignment": { "type": "object" },
    "cells": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "family",
          "spec_cite",
          "status"
        ],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 2 },
          "family": { "type": "string", "minLength": 8 },
          "spec_cite": { "type": "string", "minLength": 8 },
          "catalog_unit": { "type": "string" },
          "candidate_covers": { "type": "array" },
          "blueprint_covers": { "type": "array" },
          "keyword_rejects": { "type": "array" },
          "status": {
            "type": "string",
            "enum": ["BOTH", "CANDIDATE", "BLUEPRINT", "NEITHER", "UNCOVERED"]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["total", "NEITHER"],
      "properties": {
        "BOTH": { "type": "integer", "minimum": 0 },
        "CANDIDATE": { "type": "integer", "minimum": 0 },
        "BLUEPRINT": { "type": "integer", "minimum": 0 },
        "NEITHER": { "type": "integer", "minimum": 0 },
        "UNCOVERED": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "const": 96 }
      }
    },
    "generation_lane_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "lane",
          "requirement_id",
          "spec_cite",
          "reason"
        ],
        "properties": {
          "kind": { "type": "string", "const": "typed-generation-goal" },
          "lane": { "type": "string", "const": "generation" },
          "requirement_id": { "type": "string" },
          "family": { "type": "string" },
          "spec_cite": { "type": "string" },
          "catalog_unit": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "keyword_trap": { "type": "object" },
    "both_states": { "type": "object" },
    "tests": { "type": "array", "minItems": 3 },
    "negative_controls": { "type": "array" },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "independent": { "type": "boolean", "const": true },
        "method": { "type": "string" }
      }
    },
    "claims": { "type": "array" },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 },
    "residual_unknowns": { "type": "array" },
    "min_bytes_threshold": { "type": "integer", "minimum": 2048 }
  }
}
