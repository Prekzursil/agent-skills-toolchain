{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/CNL-0128/note.schema.json",
  "title": "CNL-0128 council design note (local constraining schema)",
  "$comment": "The catalog output_schema path is a generated $ref shim to an unresolvable ast-integrate.invalid URL. This local schema actually constrains the design note: it rejects garbage and requires the five-goal round-trips plus a verbatim negative control. Do not copy the catalog shim over this file.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "round_trips",
    "tests",
    "negative_control",
    "negative_controls",
    "reviewer",
    "artifacts",
    "evidence"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "const": "CNL-0128"
    },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": {
      "type": "string",
      "const": "SUCCESS:CNL-0128"
    },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "round_trips": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "natural_language",
          "stopping_expr",
          "restatement",
          "named_gap"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^G[1-5]$" },
          "natural_language": { "type": "string", "minLength": 8 },
          "stopping_expr": { "type": "string", "minLength": 3 },
          "restatement": { "type": "string", "minLength": 8 },
          "named_gap": { "type": "boolean", "const": false }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["verbatim", "what_the_check_does_on_that_state"],
      "properties": {
        "verbatim": { "type": "string", "minLength": 40 },
        "what_the_check_does_on_that_state": { "type": "string", "minLength": 8 }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
