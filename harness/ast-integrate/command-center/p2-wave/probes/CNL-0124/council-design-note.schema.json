{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0124/council-design-note.schema.json",
  "title": "CNL-0124 council-as-workflow-type design note (per-unit; catalog schema is a $ref shim)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "kind",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "no_home_capability",
    "inventory",
    "integration_contract",
    "duplicate_control_plane",
    "tests",
    "negative_controls",
    "reviewer",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0124" },
    "kind": { "type": "string", "const": "council-design-note" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0124" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80, "pattern": "SUCCESS:CNL-0124" },
    "no_home_capability": { "type": "string", "const": "CAP-STANDING" },
    "inventory": {
      "type": "object",
      "required": [
        "n_capabilities",
        "n_mapped",
        "n_required_extension",
        "n_unmapped",
        "ok",
        "no_home_capability"
      ],
      "properties": {
        "n_capabilities": { "type": "integer", "const": 20 },
        "n_mapped": { "type": "integer", "const": 17 },
        "n_required_extension": { "type": "integer", "const": 3 },
        "n_unmapped": { "type": "integer", "const": 0 },
        "ok": { "type": "boolean", "const": true },
        "no_home_capability": { "type": "string", "const": "CAP-STANDING" }
      }
    },
    "integration_contract": {
      "type": "object",
      "required": ["council_is", "council_is_not", "home_plane", "scheduler"],
      "properties": {
        "council_is": { "type": "string", "minLength": 8 },
        "council_is_not": { "type": "string", "minLength": 8 },
        "home_plane": { "type": "string", "const": "prompt-native" },
        "scheduler": { "type": "string", "const": "agentspec" }
      }
    },
    "duplicate_control_plane": {
      "type": "object",
      "required": ["mapped_home", "own_scheduler", "langgraph_import"],
      "properties": {
        "mapped_home": {
          "type": "object",
          "required": ["gate", "over_one"],
          "properties": {
            "gate": { "type": "string", "const": "PASS" },
            "over_one": { "type": "boolean", "const": false }
          }
        },
        "own_scheduler": {
          "type": "object",
          "required": ["gate", "over_one"],
          "properties": {
            "gate": { "type": "string", "const": "FIRE" },
            "over_one": { "type": "boolean", "const": true }
          }
        },
        "langgraph_import": {
          "type": "object",
          "required": ["gate"],
          "properties": {
            "gate": { "type": "string", "const": "FIRE" }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "on_state", "observed"],
        "properties": {
          "id": { "type": "string" },
          "on_state": { "type": "string", "minLength": 8 },
          "observed": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
