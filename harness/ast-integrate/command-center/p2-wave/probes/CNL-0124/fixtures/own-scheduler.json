{
  "id": "council.own-turn-engine",
  "kind": "council",
  "scheduler": "council-runtime",
  "dispatch_loop": true,
  "round_runner": "council.engine.turn_taking",
  "own_scheduler": true,
  "roles": [
    {"id": "Architect", "voting": true},
    {"id": "Skeptic", "voting": true}
  ],
  "protocol_schedule": [
    {"id": "P1", "compose": "sequence"}
  ],
  "voting": {"rule": "majority", "quorum": 2},
  "stopping": {"max_rounds": 4, "expression": "done"}
}
