{
  "id": "council.anonymous-peer-review",
  "kind": "council",
  "scheduler": "agentspec",
  "anonymity": true,
  "roles": [
    {"id": "Author", "voting": false},
    {"id": "Reviewer", "voting": true},
    {"id": "Editor", "voting": true}
  ],
  "protocol_schedule": [
    {"id": "P45", "compose": "sequence"}
  ],
  "voting": {"rule": "editor-after-reviews", "quorum": 2},
  "stopping": {"max_rounds": 4, "expression": "editor_decision"}
}
