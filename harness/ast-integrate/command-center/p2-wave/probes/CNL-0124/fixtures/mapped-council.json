{
  "id": "council.mapped-home",
  "kind": "council",
  "scheduler": "agentspec",
  "roles": [
    {"id": "Architect", "voting": true},
    {"id": "Skeptic", "voting": true},
    {"id": "Critic", "voting": true}
  ],
  "protocol_schedule": [
    {"id": "P46", "compose": "sequence", "purpose": "architecture review"}
  ],
  "voting": {"rule": "majority", "quorum": 2},
  "stopping": {
    "max_rounds": 6,
    "expression": "majority && unresolved->BLOCKED",
    "on_timeout": "halt"
  },
  "anonymity": false,
  "standing_watch": false,
  "chair": true,
  "nested": false,
  "oracle": false
}
