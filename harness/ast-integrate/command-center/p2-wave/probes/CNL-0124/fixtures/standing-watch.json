{
  "id": "council.standing-watch-on-plane",
  "kind": "council",
  "scheduler": "agentspec",
  "roles": [
    {"id": "WatchChair", "voting": true},
    {"id": "Skeptic", "voting": true}
  ],
  "protocol_schedule": [
    {"id": "P-watch", "compose": "sequence"}
  ],
  "voting": {"rule": "majority", "quorum": 2},
  "stopping": {"max_rounds": 2, "expression": "settled"},
  "standing_watch": true,
  "wake_on": ["etag", "release-tag"],
  "anonymity": false
}
