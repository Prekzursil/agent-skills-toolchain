{
  "id": "council.nested-children",
  "kind": "council",
  "scheduler": "agentspec",
  "nested": true,
  "children": ["child-a", "child-b"],
  "roles": [
    {"id": "ParentChair", "voting": true},
    {"id": "Skeptic", "voting": true}
  ],
  "protocol_schedule": [
    {"id": "fan-in", "compose": "nest"}
  ],
  "voting": {"rule": "majority", "quorum": 2},
  "stopping": {"max_rounds": 3, "expression": "children-resolved"}
}
