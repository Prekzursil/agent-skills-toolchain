{
  "id": "council.standing-own-event-loop",
  "kind": "council",
  "scheduler": "council-runtime",
  "standing_watch": true,
  "watch_loop": true,
  "own_wake_clock": true,
  "wake_on": ["etag"],
  "roles": [
    {"id": "WatchChair", "voting": true},
    {"id": "Skeptic", "voting": true}
  ],
  "protocol_schedule": [
    {"id": "P-watch", "compose": "sequence"}
  ],
  "voting": {"rule": "majority", "quorum": 2},
  "stopping": {"max_rounds": 2, "expression": "settled"}
}
