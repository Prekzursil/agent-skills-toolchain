:\"en\",\"tabs\":[{\"tab\":\"Getting started\",\"pages\":[{\"title\":\"Getting started\",\"href\":\"/en/overview\"}]},{\"tab\":\"Build with Claude Code\",\"groups\":[{\"group\":\"Agents and parallel work\",\"pages\":[{\"title\":\"Run agents in parallel\",\"sidebarTitle\":\"Overview\",\"description\":\"Compare the ways Claude Code can take on multiple tasks at once: subagents, agent view, agent teams, and dynamic workflows.\",\"keywords\":[\"agents\",\"parallel\",\"multi-agent\",\"subagent\",\"agent view\",\"agent teams\",\"workflow\",\"workflows\",\"worktree\",\"background\"],\"href\":\"/en/agents\"},{\"title\":\"Create custom subagents\",\"description\":\"Create and use specialized AI subagents in Claude Code for task-specific workflows and improved context management.\",\"keywords\":[\"agent\",\"agents\",\"subagent\",\"sub-agent\",\"sub agent\",\"Task tool\",\"fork\",\"/fork\",\"/subtask\",\"subtask\",\"forked subagent\"],\"href\":\"/en/sub-agents\"},{\"title\":\"Manage multiple agents with agent view\",\"sidebarTitle\":\"Agent view\",\"description\":\"Dispatch and manage many Claude Code sessions from one screen. Agent view shows what every session is doing and which ones need your input.\",\"keywords\":[\"agent view\",\"background agents\",\"claude agents\",\"parallel sessions\",\"multiple sessions\",\"run in background\",\"background tasks\",\"manage agents\",\"daemon\",\"/bg\",\"/background\",\"/fork\",\"fork a session\",\"copy a session\",\"attach\",\"detach\"],\"href\":\"/en/agent-view\"},{\"title\":\"Orchestrate teams of Claude Code sessions\",\"sidebarTitle\":\"Run agent teams\",\"description\":\"Coordinate multiple Claude Code instances working together as a team, with shared tasks, inter-agent messaging, and centralized management.\",\"keywords\":[\"teammate\",\"team\",\"multi-agent\",\"swarm\"],\"href\":\"/en/agent-teams\"},{\"title\":\"Message your other Claude Code sessions\",\"sidebarTitle\":\"Cross-session messaging\",\"description\":\"Let Claude list and message your other Claude Code sessions on this machine, and reach your sessions on other machines or on the web.\",\"keywords\":[\"cross-session messaging\",\"message another session\",\"ListAgents\",\"list agents\",\"/list-agents\",\"/peers\",\"SendMessage\",\"crossSessionInbound\",\"isolatePeerMachines\",\"peer message\",\"notify_when_idle\",\"idle notice\"],\"href\":\"/en/cross-session-messaging\"},{\"title\":\"Orchestrate subagents at scale with dynamic workflows\",\"sidebarTitle\":\"Dynamic workflows\",\"description\":\"Dynamic workflows orchestrate many subagents from a script Claude writes and you can rerun. Use them for codebase audits, large migrations, and cross-checked research.\",\"keywords\":[\"workflow\",\"workflows\",\"dynamic workflows\",\"ultracode\",\"effort\",\"multi-agent\",\"fan out\",\"orchestration\",\"deep research\",\"test-time compute\",\"swarm\",\"/workflows\"],\"href\":\"/en/workflows\"},{\"title\":\"Run parallel sessions with worktrees\",\"sidebarTitle\":\"Isolate sessions with worktrees\",\"description\":\"Isolate parallel Claude Code sessions in separate git worktrees so changes don't collide. Covers the `--worktree` flag, subagent isolation, `.worktreeinclude`, cleanup, and non-git VCS hooks.\",\"keywords\":[\"worktree\",\"git worktree\",\"parallel\",\"isolation\",\".worktreeinclude\",\"EnterWorktree\"],\"href\":\"/en/worktrees\"}]},{\"group\":\"MCP\",\"pages\":[{\"title\":\"Connect to MCP servers\",\"sidebarTitle\":\"Quickstart\",\"description\":\"Add an MCP server to Claude Code, verify the connection, and find the configuration on disk.\",\"href\":\"/en/mcp-quickstart\"},{\"sidebarTitle\":\"Reference\",\"title\":\"Connect Claude Code to tools via MCP\",\"description\":\"Learn how to connect Claude Code to your tools with the Model Context Protocol.\",\"keywords\":[\"mcp\",\"model context protocol\",\"mcp server\",\".mcp.json\",\"figma\",\"linear\"],\"href\":\"/en/mcp\"}]},{\"group\":\"Skills\",\"pages\":[{\"title\":\"Extend Claude with skills\",\"description\":\"Create, manage, and share skills to extend Claude's capabilities in Claude Code. Includes custom commands and bundled skills.\",\"keywords\":[\"skill\",\"skills\",\"SKILL.md\",\"custom command\",\"custom slash command\"],\"href\":\"/en/skills\"}]},{\"group\":\"Plugins\",\"pages\":[{\"title\":\"Discover and install prebuilt plugins through marketplaces\",\"sidebarTitle\":\"Discover and install prebuilt plugins\",\"description\":\"Find and install plugins from marketplaces to extend Claude Code with new skills, agents, and capabilities.\",\"href\":\"/en/discover-plugins\"},{\"title\":\"Create plugins\",\"sidebarTitle\":\"Create plugins\",\"description\":\"Create custom plugins to extend Claude Code with skills, agents, hooks, and MCP servers.\",\"keywords\":[\"plugin\",\"plugins\",\"create plugin\",\"plugin.json\"],\"href\":\"/en/plugins\"}]},{\"group\":\"Artifacts\",\"pages\":[{\"title\":\"Share session output as artifacts\",\"description\":\"Artifacts turn Claude Code's work into live, interactive pages on claude.ai that you can keep private, share with your organization, or publish to a public link.\",\"keywords\":[\"artifact\",\"artifacts\",\"share\",\"public\",\"collaborate\",\"dashboard\",\"html\",\"page\",\"report\",\"visualize\",\"publish\",\"interactive\",\"mcp\",\"connector\",\"connectors\",\"live data\"],\"href\":\"/en/artifacts\"}]},{\"group\":\"Automation\",\"pages\":[{\"title\":\"Automate actions with hooks\",\"sidebarTitle\":\"Automate with hooks\",\"description\":\"Run shell commands automatically when Claude Code edits files, finishes tasks, or needs input. Format code, send notifications, validate commands, and enforce project rules.\",\"href\":\"/en/hooks-guide\"},{\"sidebarTitle\":\"Push external events to Claude\",\"title\":\"Push events into a running session with channels\",\"description\":\"Use channels to push messages, alerts, and webhooks into your Claude Code session from an MCP server. Forward CI results, chat messages, and monitoring events so Claude can react while you're away.\",\"href\":\"/en/channels\"},{\"title\":\"Run prompts on a schedule\",\"description\":\"Use /loop and the cron scheduling tools to run prompts repeatedly, poll for status, or set one-time reminders within a Claude Code session.\",\"keywords\":[\"loop\",\"loops\",\"/loop\",\"cron\",\"recurring\",\"repeat\",\"poll\",\"interval\",\"reminder\",\"/schedule\",\"/routines\"],\"href\":\"/en/scheduled-tasks\"},{\"title\":\"Keep Claude working toward a goal\",\"sidebarTitle\":\"Goals\",\"description\":\"Set a completion condition with /goal and Claude keeps working until it's met, a model judges it impossible, or an error you have to fix clears the goal.\",\"keywords\":[\"goal\",\"/goal\",\"until\",\"condition\",\"keep going\",\"stop hook\",\"iterate\",\"verification loop\",\"verify\"],\"href\":\"/en/goal\"},{\"title\":\"Run Claude Code programmatically\",\"sidebarTitle\":\"Programmatic usage\",\"description\":\"Use the Agent SDK to run Claude Code programmatically from the CLI, Python, or TypeScript.\",\"href\":\"/en/headless\"},{\"title\":\"Launch sessions from links\",\"description\":\"Open a Claude Code terminal session from a URL. Embed `claude-cli://` links in runbooks, alerts, and dashboards so a click opens Claude Code in the right repo with the right prompt.\",\"href\":\"/en/deep-links\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"Set up Claude Code in a monorepo or large codebase\",\"sidebarTitle\":\"Monorepos and large repos\",\"description\":\"Configure Claude Code for monorepos and large single-tree codebases with nested CLAUDE.md files, sparse worktrees, code intelligence, and per-package skills so Claude stays focused on the code you're working in.\",\"href\":\"/en/large-codebases\"}]},{\"group\":\"Troubleshooting\",\"pages\":[{\"title\":\"Troubleshoot installation and login\",\"description\":\"Fix command not found, PATH, permission, network, and authentication errors when installing or signing in to Claude Code.\",\"keywords\":[\"command not found\",\"install\",\"PATH\",\"EACCES\",\"OAuth\",\"login\",\"authentication\",\"403\",\"TLS\",\"proxy\",\"Killed\",\"out of memory\",\"exit code 137\",\"installation was killed before it could finish\",\"claude update hangs\",\"claude doctor hangs\",\"system diagnostics blank\",\"ParseException\",\"ParserError\",\"Invoke-Expression\",\"missing expression after unary operator\",\"running scripts is disabled on this system\",\"PSSecurityException\",\"execution policy\",\"claude native binary not installed\",\"could not find native binary package\",\"ENOTEMPTY\",\"npm error code ENOTEMPTY\"],\"href\":\"/en/troubleshoot-install\"},{\"title\":\"Troubleshooting\",\"sidebarTitle\":\"Troubleshoot performance and stability\",\"description\":\"Fix high CPU or memory usage, hangs, auto-compact thrashing, and search problems in Claude Code, and find the right page for other issues.\",\"keywords\":[\"error\",\"troubleshoot\",\"fix\",\"not working\",\"broken\",\"issue\",\"slow\",\"performance\",\"hang\",\"memory\",\"garbled\",\"corrupted glyphs\"],\"href\":\"/en/troubleshooting\"},{\"title\":\"Debug your configuration\",\"sidebarTitle\":\"Debug configuration\",\"description\":\"Diagnose why CLAUDE.md, settings, hooks, MCP servers, or skills aren't taking effect. Use /context, /doctor, /hooks, and /mcp to see what actually loaded.\",\"href\":\"/en/debug-your-config\"},{\"title\":\"Error reference\",\"description\":\"Look up Claude Code runtime error messages with what each one means and how to fix it.\",\"keywords\":[\"claude code error\",\"api error\",\"500\",\"529\",\"overloaded\",\"429\",\"rate limit\",\"waiting for api response\",\"will retry in\",\"no response from api\",\"401\",\"403\",\"invalid api key\",\"your apiKeyHelper script is failing\",\"apiKeyHelper failed\",\"invalid auth token\",\"fix external auth token\",\"invalid ANTHROPIC_CUSTOM_HEADERS\",\"invalid request header from the environment\",\"contains a line break at character\",\"anthropic profile login expired\",\"re-authenticate your anthropic profile\",\"run /login to use your claude.ai account instead\",\"aws credentials expired or invalid\",\"aws authentication failed\",\"bedrock streaming response has content-type\",\"truncated event message received\",\"vnd.amazon.eventstream\",\"aws default-chain credential resolve timed out\",\"credential_process\",\"awsAuthRefresh\",\"gcpAuthRefresh\",\"could not load the default credentials\",\"could not resolve authentication method\",\"ECONNRESET\",\"ETIMEDOUT\",\"fetch failed\",\"connection refused\",\"a firewall or proxy may be blocking it\",\"can't reach the api server\",\"no internet route\",\"couldn't connect through your proxy\",\"connection dropped\",\"internal server error\",\"prompt is too long\",\"context limit reached\",\"auto-compact is off\",\"/config to turn it on\",\"context exceeds the token limit\",\"past the compaction window\",\"you've hit your session limit\",\"you've hit your weekly limit\",\"usage credits required for 1M context\",\"usage credits are required for long context\",\"failed to update spend limit\",\"spend limit reached\",\"spend limit unavailable\",\"failed to update auto-reload\",\"could not update your spend limit\",\"server is temporarily limiting requests\",\"not your usage limit\",\"extra inputs are not permitted\",\"image was too large\",\"unable to resize image\",\"organization has been disabled\",\"restricted by your organization's settings\",\"is not a recognized model id\",\"claude-code:unrecognized_model\",\"unrecognized_model\",\"disabled claude subscription access\",\"disabled API key authentication\",\"ask your admin to enable access\",\"routines are disabled\",\"remote control is only available when using claude via api.anthropic.com\",\"couldn't reconnect to your remote control session\",\"previous session is unavailable\",\"remote control disconnected\",\"signed-in claude.ai account or organization changed\",\"couldn't share the transcript\",\"oauth token refresh failed\",\"jwt refresh failed\",\"claude.ai login was rejected\",\"oauth token unavailable\",\"oauth token expired\",\"login expired\",\"oauth session expired and could not be refreshed\",\"failed to authenticate\",\"server error mid-response\",\"connection lost mid-response\",\"your computer went to sleep\",\"the response stopped arriving\",\"before a response was produced\",\"while your computer was asleep\",\"connection closed mid-response\",\"response stalled mid-stream\",\"the response above may be incomplete\",\"ssl certificate error\",\"ssl certificate verification failed\",\"self-signed certificate\",\"NODE_EXTRA_CA_CERTS\",\"TLS-intercepting firewall\",\"compaction\",\"max_tokens\",\"thinking.budget_tokens\",\"thinking.type.enabled\",\"is not supported for this model\",\"auto mode cannot determine the safety\",\"classifier\",\"refused by the safety safeguard\",\"agent terminated early due to an API error\",\"subagent failed\",\"host_not_allowed\",\"x-deny-reason\",\"egress gateway\",\"this graphql query is not enabled for this session\",\"unable to respond to this request\",\"usage policy\",\"violate our Usage Policy\",\"can't help with this\",\"start a new session to continue\",\"cybersecurity topic\",\"cyber verification program\",\"has safety measures that flagged this message\",\"safeguards flagged this message\",\"is set, so this session is using\",\"--bg and --print conflict\",\"the job would be unattachable\",\"installation was killed before it could finish\",\"exit code 137\",\"system ran out of memory\",\"this workspace has not been trusted\",\"ignoring permissions.allow entries\",\"hasTrustDialogAccepted\",\"is not matched by file permission checks\",\"the connection dropped while downloading the update\",\"proxies sometimes cut off large downloads\",\"failed to install native update\",\"download timed out\",\"exceeded the total deadline\",\"--json-schema is not a valid JSON Schema\",\"could not import\",\"add-from-claude-desktop\",\"is not yet available in this build\",\"could not read claude code config\",\"permission-prompt-tool not found\",\"MCP tool not found\",\"is registered from an untrusted source\",\"reserved marketplace name\",\"references ${user_config\",\"user_config in a shell-form command\",\"monitor commands cannot safely reference\",\"CLAUDE_PLUGIN_OPTION\",\"would be spawned with zero tools\",\"subagent_type is required\",\"the general-purpose agent is not available in this session\",\"file is covered by a read deny rule\",\"this write left the memory index\",\"over its read limit\",\"can't open mcp settings while no terminal is attached\",\"can't open mcp settings in a background session\",\"this session has no saved transcript\",\"it was stopped before its first response finished\",\"this session was running agent\",\"which is no longer available\",\"tool restrictions no longer apply\",\"re-create the agent\",\"CLAUDE_CODE_PROCESS_WRAPPER\",\"must exec, not daemonize\",\"couldn't reach the background service\",\"request too large\",\"accumulated images and attachments\",\"cannot make it fit\",\"this conversation cannot continue as is\",\"request too large for the api's 32mb request limit\",\"automatic compaction failed\",\"input contained only whitespace\",\"blank prompt\",\"only whitespace, so nothing was sent to the model\",\"EUNKNOWN\",\"uv_spawn\",\"uv_cwd\",\"the current directory no longer exists\",\"it was deleted or moved\",\"start claude code from an existing directory\",\"can't read the current directory\",\"socket is closed\",\"settings file exceeds the 2mib limit\",\"cannot use settings file\",\"workspace not trusted\",\"home-directory trust is never saved\",\"pkill: refusing to run\",\"pattern matches the claude cli process\",\"restored the code, but skipped\",\"skipped files were left untouched\",\"diff is too large for ultrareview\",\"too large for ultrareview\",\"pass a closer base branch\",\"could not find merge-base\",\"shares no history with HEAD\",\"your checkout has no branches\",\"detached HEAD only\",\"failed to resume the conversation\",\"resuming conversation\",\"invalid authentication credentials\",\"input must be provided either through stdin or as a prompt argument\",\"claude code process exited with code\",\"shell command failed for pattern\",\"cannot determine remote head\",\"ambiguous argument origin/HEAD\",\"unknown revision or path not in the working tree\",\"security-review fails\",\"claude.ai rejected the session token\",\"session token rejected\",\"unable to connect to anthropic services\",\"checking connectivity\",\"a proxy is configured via\",\"connection to api.anthropic.com timed out\",\"failed to write to inbox\",\"nothing was sent\",\"mailbox write failed\",\"plan not submitted\",\"message too large for cross-session delivery\",\"shorten the message text\",\"too many messages to this session just now\",\"batch what remains into one message\",\"plugin archive integrity check failed\",\"expected sha256\",\"the archive was not installed\",\"no conversation found with session id\",\"input is too long for requested model\",\"transcript writes are failing\",\"transcript saving is off\",\"recent messages may not be saved for resume\",\"CLAUDE_CODE_SKIP_PROMPT_HISTORY\",\"inherited CLAUDE_CODE_CHILD_SESSION marker\",\"ENOSPC\",\"disk full\",\"this write was blocked\",\"cannot be safely resolved\",\"path is network-shaped\",\"direct symlink-free path\",\"plainly-spelled path\",\"the 200K limit isn't enforced\",\"this session can grow past it\",\"could not locate the claude cli on path\",\"sessions ended while this machine was offline\",\"session ended while this machine was offline\",\"environment was cleaned up on the server\",\"cannot switch renderers in this session\",\"restrictions a restart can't carry over\",\"cannot switch renderers while work is running in the background\",\"sent a reply this version can't display\",\"couldn't show context usage\",\"fable 5 limit reached\",\"fable 5 now uses usage credits\",\"answer it where this session is running\",\"the prompt to confirm went unanswered\",\"refusing to send\",\"reply target is a symlink\",\"cannot vet reply target\",\"connected endpoint is not the expected process\",\"connected endpoint identity could not be read\",\"unknown command\",\"did you mean\",\"signed out of claude\",\"the app running this session is signed out of claude\",\"the app running this session is now signed in to a different claude account\",\"proxy refused the connection\",\"unreadable reply\",\"headersHelper not run\",\"no persisted trust\",\"issuer mismatch in authorization response\",\"RFC 9207\",\"api returned an empty or malformed response\",\"check for a proxy or gateway intercepting the request\",\"capability_rejected: prompt_too_long\",\"capability_rejected\",\"upstream rejected the request\",\"request too large for this upstream\",\"upstream rate limit exceeded\",\"all upstreams failed\"],\"href\":\"/en/errors\"}]}]},{\"tab\":\"Administration\",\"pages\":[{\"title\":\"Administration\",\"href\":\"/en/admin-setup\"}]},{\"tab\":\"Configuration\",\"pages\":[{\"title\":\"Configuration\",\"href\":\"/en/settings\"}]},{\"tab\":\"Reference\",\"pages\":[{\"title\":\"Reference\",\"href\":\"/en/cli-reference\"}]},{\"tab\":\"Agent SDK\",\"pages\":[{\"title\":\"Agent SDK\",\"href\":\"/en/agent-sdk/overview\"}]},{\"tab\":\"What's New\",\"pages\":[{\"title\":\"What's New\",\"href\":\"/en/whats-new\"}]},{\"tab\":\"Resources\",\"pages\":[{\"title\":\"Resources\",\"href\":\"/en/legal-and-compliance\"}]}]},{\"language\":\"fr\",\"pages\":[{\"title\":\"fr\",\"href\":\"/fr/mcp\"}]},{\"language\":\"de\",\"pages\":[{\"title\":\"de\",\"href\":\"/de/mcp\"}]},{\"language\":\"it\",\"pages\":[{\"title\":\"it\",\"href\":\"/it/mcp\"}]},{\"language\":\"jp\",\"pages\":[{\"title\":\"jp\",\"href\":\"/ja/mcp\"}]},{\"language\":\"es\",\"pages\":[{\"title\":\"es\",\"href\":\"/es/mcp\"}]},{\"language\":\"ko\",\"pages\":[