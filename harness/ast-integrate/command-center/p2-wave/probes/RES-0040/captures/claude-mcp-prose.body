9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` notion`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.notion.com/mcp`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Example with Bearer token`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` secure-api`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://api.example.com/mcp`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --header`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"Authorization: Bearer your-token\"`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`When configuring MCP servers via JSON in `,_jsx(_components.code,{children:`.mcp.json`}),`, `,_jsx(_components.code,{children:`~/.claude.json`}),`, or `,_jsx(_components.code,{children:`claude mcp add-json`}),`, the `,_jsx(_components.code,{children:`type`}),` field accepts `,_jsx(_components.code,{children:`streamable-http`}),` as an alias for `,_jsx(_components.code,{children:`http`}),`. The MCP specification uses the name `,_jsx(_components.code,{children:`streamable-http`}),` for this transport, so configurations copied from server documentation work without modification.`]}),`\n`,_jsxs(_components.p,{children:[`A JSON entry that has a `,_jsx(_components.code,{children:`url`}),` but no `,_jsx(_components.code,{children:`type`}),` is a configuration error, because Claude Code reads an entry with no `,_jsx(_components.code,{children:`type`}),` as a stdio server. Claude Code skips that server and reports `,_jsx(_components.code,{children:`MCP server \"\u003cname\u003e\" has a \"url\" but no \"type\"; add \"type\": \"http\" (or \"sse\" / \"ws\") to this entry`}),`. Before v2.1.202, Claude Code reported this misconfiguration as `,_jsx(_components.code,{children:`command: expected string, received undefined`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`In `,_jsx(_components.code,{children:`--output-format stream-json`}),` runs, Claude Code also reports a skipped `,_jsx(_components.code,{children:`--mcp-config`}),` entry in the `,_jsx(_components.code,{children:`system/init`}),` event’s `,_jsxs(_components.a,{href:`/en/headless#stream-responses`,children:[_jsx(_components.code,{children:`mcp_server_errors`}),` field`]}),`, so scripts can detect that the server never loaded. This requires Claude Code v2.1.219 or later.`]}),`\n`,_jsx(Heading,{level:`3`,id:`option-2-add-a-remote-sse-server`,children:`Option 2: Add a remote SSE server`}),`\n`,_jsx(Warning,{children:_jsx(_components.p,{children:`The SSE (Server-Sent Events) transport is deprecated. Use HTTP servers instead, where available.`})}),`\n`,_jsxs(_components.p,{children:[`Some services still expose only an SSE endpoint. Use the same command as the HTTP transport, with `,_jsx(_components.code,{children:`--transport sse`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`9`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`9`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Basic syntax`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sse`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:` \u003c`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`nam`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`e`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`\u003e`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:` \u003c`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`ur`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`l`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`\u003e`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Real example: Connect to Asana`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sse`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` asana`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.asana.com/sse`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Example with authentication header`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sse`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` private-api`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://api.company.com/sse`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --header`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"X-API-Key: your-key-here\"`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`option-3-add-a-local-stdio-server`,children:`Option 3: Add a local stdio server`}),`\n`,_jsx(_components.p,{children:`Stdio servers run as local processes on your machine. They’re ideal for tools that need direct system access or custom scripts.`}),`\n`,_jsxs(_components.p,{children:[`Claude Code sets `,_jsx(_components.code,{children:`CLAUDE_PROJECT_DIR`}),` in the spawned server’s environment to the project root, so your server can resolve project-relative paths without depending on the working directory. This is the same directory hooks receive in their `,_jsx(_components.code,{children:`CLAUDE_PROJECT_DIR`}),` variable. Read it from inside your server process, for example `,_jsx(_components.code,{children:`process.env.CLAUDE_PROJECT_DIR`}),` in Node or `,_jsx(_components.code,{children:`os.environ[\"CLAUDE_PROJECT_DIR\"]`}),` in Python.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`CLAUDE_PROJECT_DIR`}),` is the stable project root and doesn’t change when you add or remove working directories mid-session. A server that limits its own filesystem access to a set of allowed directories should implement the MCP `,_jsx(_components.code,{children:`roots/list`}),` request instead. Claude Code answers `,_jsx(_components.code,{children:`roots/list`}),` with the session’s launch directory plus every `,_jsx(_components.a,{href:`/en/permissions#working-directories`,children:`additional working directory`}),` you’ve granted with `,_jsx(_components.code,{children:`--add-dir`}),`, `,_jsx(_components.code,{children:`/add-dir`}),`, or the `,_jsx(_components.code,{children:`additionalDirectories`}),` setting. Claude Code sends `,_jsx(_components.code,{children:`notifications/roots/list_changed`}),` when that set changes. Before v2.1.203, `,_jsx(_components.code,{children:`roots/list`}),` returned only the launch directory and Claude Code didn’t send `,_jsx(_components.code,{children:`notifications/roots/list_changed`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`This variable is set in the server’s environment, not in Claude Code’s own environment, so referencing it via `,_jsx(_components.code,{children:\"${VAR}\"}),` expansion in the `,_jsx(_components.code,{children:`command`}),` or `,_jsx(_components.code,{children:`args`}),` of a project-scoped `,_jsx(_components.code,{children:`.mcp.json`}),` entry or a local- or user-scoped server entry in `,_jsx(_components.code,{children:`~/.claude.json`}),` requires a default such as `,_jsx(_components.code,{children:\"${CLAUDE_PROJECT_DIR:-.}\"}),`. Plugin-provided MCP configurations substitute `,_jsx(_components.code,{children:\"${CLAUDE_PROJECT_DIR}\"}),` directly and don’t need the default.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`6`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`6`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Basic syntax`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` [options] `}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`\u003c`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`name`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`\u003e`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` -- `}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`\u003c`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`command`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`\u003e`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` [args...]`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Real example: Add Airtable server`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --env`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` AIRTABLE_API_KEY=YOUR_KEY`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` stdio`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` airtable`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` npx`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` -y`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` airtable-mcp-server`})]}),`\n`]})})}),`\n`,_jsxs(Note,{children:[_jsx(_components.p,{children:_jsxs(_components.strong,{children:[`Important: Separate server arguments with `,_jsx(_components.code,{children:`--`})]})}),_jsxs(_components.p,{children:[`For stdio servers, the `,_jsx(_components.code,{children:`--`}),` (double dash) separates Claude’s own options, such as `,_jsx(_components.code,{children:`--transport`}),`, `,_jsx(_components.code,{children:`--env`}),`, and `,_jsx(_components.code,{children:`--scope`}),`, from the command and arguments that run the server. Everything after `,_jsx(_components.code,{children:`--`}),` is passed to the server untouched.`]}),_jsx(_components.p,{children:`For example:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`claude mcp add --transport stdio myserver -- npx server`}),` → runs `,_jsx(_components.code,{children:`npx server`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`claude mcp add --env KEY=value --transport stdio myserver -- python server.py --port 8080`}),` → runs `,_jsx(_components.code,{children:`python server.py --port 8080`}),` with `,_jsx(_components.code,{children:`KEY=value`}),` in environment`]}),`\n`]}),_jsxs(_components.p,{children:[`Without `,_jsx(_components.code,{children:`--`}),`, Claude Code would try to parse the server’s flags, like `,_jsx(_components.code,{children:`--port`}),` above, as its own options.`]}),_jsxs(_components.p,{children:[_jsx(_components.code,{children:`--env`}),` accepts multiple `,_jsx(_components.code,{children:`KEY=value`}),` pairs. If the server name comes directly after `,_jsx(_components.code,{children:`--env`}),`, the CLI reads the name as another pair and rejects it, so place at least one other option between `,_jsx(_components.code,{children:`--env`}),` and the server name, as in the examples above.`]})]}),`\n`,_jsx(Heading,{level:`3`,id:`option-4-add-a-remote-websocket-server`,children:`Option 4: Add a remote WebSocket server`}),`\n`,_jsxs(_components.p,{children:[`WebSocket servers hold a persistent bidirectional connection, which suits remote MCP servers that push events to Claude unprompted. Use HTTP instead when your server only responds to requests, since HTTP supports OAuth and the `,_jsx(_components.code,{children:`claude mcp add --transport`}),` flag, while WebSocket supports neither.`]}),`\n`,_jsxs(_components.p,{children:[`Configure WebSocket servers in `,_jsx(_components.code,{children:`.mcp.json`}),` or with `,_jsx(_components.code,{children:`claude mcp add-json`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add-json`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` events-server`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`  '{\"type\":\"ws\",\"url\":\"wss://mcp.example.com/socket\",\"headers\":{\"Authorization\":\"Bearer YOUR_TOKEN\"}}'`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`type: \"ws\"`}),` entry accepts the same `,_jsx(_components.code,{children:`url`}),`, `,_jsx(_components.code,{children:`headers`}),`, `,_jsx(_components.code,{children:`headersHelper`}),`, `,_jsx(_components.code,{children:`timeout`}),`, and `,_jsx(_components.code,{children:`alwaysLoad`}),` fields as `,_jsx(_components.code,{children:`http`}),`. Authentication is header-only, so pass a static token in `,_jsx(_components.code,{children:`headers`}),` or generate one at connect time with `,_jsx(_components.a,{href:`#use-dynamic-headers-for-custom-authentication`,children:_jsx(_components.code,{children:`headersHelper`})}),`. The `,_jsx(_components.code,{children:`claude mcp add --transport`}),` flag doesn’t accept `,_jsx(_components.code,{children:`ws`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`add-a-server-from-setup-instructions-written-for-another-client`,children:`Add a server from setup instructions written for another client`}),`\n`,_jsxs(_components.p,{children:[`MCP servers aren’t specific to Claude Code, so a server’s setup instructions may be written for Claude Desktop, Cursor, or another MCP client and give no `,_jsx(_components.code,{children:`claude mcp add`}),` command. To add the server anyway, look in those instructions for one of these three things:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`A URL`}),` such as `,_jsx(_components.code,{children:`https://mcp.example.com/mcp`}),`: the server is remote.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`A launch command`}),` such as `,_jsx(_components.code,{children:`npx -y @example/mcp-server`}),`: the server runs on your machine.`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`An `,_jsx(_components.code,{children:`mcpServers`}),` JSON block`]}),`: configuration written for another client’s settings file.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Each is one of the inputs the four options in `,_jsx(_components.a,{href:`#installing-mcp-servers`,children:`Installing MCP servers`}),` take. Find the shape you have below to turn it into the command Claude Code accepts. Each command writes to `,_jsx(_components.a,{href:`#local-scope`,children:`local scope`}),` unless you add `,_jsx(_components.code,{children:`--scope project`}),` or `,_jsx(_components.code,{children:`--scope user`}),`.`]}),`\n`,_jsx(Heading,{level:`4`,id:`from-a-url`,children:`From a URL`}),`\n`,_jsxs(_components.p,{children:[`A URL means the server is remote. For an `,_jsx(_components.code,{children:`https://`}),` endpoint, add it with `,_jsx(_components.code,{children:`--transport http`}),`, or with `,_jsx(_components.code,{children:`--transport sse`}),` when the instructions say the endpoint uses SSE. For a `,_jsx(_components.code,{children:`wss://`}),` endpoint, use `,_jsx(_components.a,{href:`#option-4-add-a-remote-websocket-server`,children:`Option 4`}),` instead, since `,_jsx(_components.code,{children:`--transport`}),` doesn’t accept `,_jsx(_components.code,{children:`ws`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` example`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.example.com/mcp`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`If the instructions also give an API key or token header, pass it with `,_jsx(_components.code,{children:`--header`}),` as shown in `,_jsx(_components.a,{href:`#option-1-add-a-remote-http-server`,children:`Option 1`}),`.`]}),`\n`,_jsxs(Heading,{level:`4`,id:`from-an-npx-uvx-or-binary-command`,children:[`From an `,_jsx(_components.code,{children:`npx`}),`, `,_jsx(_components.code,{children:`uvx`}),`, or binary command`]}),`\n`,_jsxs(_components.p,{children:[`A launch command means the server runs as a local stdio process. Put the whole command after `,_jsx(_components.code,{children:`--`}),`, so Claude Code passes flags such as `,_jsx(_components.code,{children:`-y`}),` to the command that starts the server instead of reading them as its own options. Pass any environment variables the instructions ask for with `,_jsx(_components.code,{children:`--env`}),`, after the server name and before `,_jsx(_components.code,{children:`--`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` example`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --env`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` API_KEY=your-key`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` npx`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` -y`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` @example/mcp-server`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`#option-3-add-a-local-stdio-server`,children:`Option 3`}),` covers the `,_jsx(_components.code,{children:`--`}),` separator in full.`]}),`\n`,_jsxs(Heading,{level:`4`,id:`from-an-mcpservers-json-block`,children:[`From an `,_jsx(_components.code,{children:`mcpServers`}),` JSON block`]}),`\n`,_jsxs(_components.p,{children:[`An `,_jsx(_components.code,{children:`mcpServers`}),` block written for another MCP client, such as Claude Desktop, uses the wrapper key and entry shape Claude Code reads. Pass `,_jsx(_components.code,{children:`claude mcp add-json`}),` the object inside `,_jsx(_components.code,{children:`mcpServers`}),`, not the wrapper. Two entries need a repair first:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`A `,_jsx(_components.code,{children:`url`}),` with no `,_jsx(_components.code,{children:`type`})]}),`: add `,_jsx(_components.code,{children:`\"type\": \"http\"`}),`, `,_jsx(_components.code,{children:`\"type\": \"sse\"`}),`, or `,_jsx(_components.code,{children:`\"type\": \"ws\"`}),` to match the endpoint. Claude Code reads an entry with no `,_jsx(_components.code,{children:`type`}),` as a stdio server, so a `,_jsx(_components.code,{children:`url`}),` entry without a `,_jsx(_components.code,{children:`type`}),` fails.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`A key with characters other than letters, numbers, hyphens, and underscores`}),`: pick a server name that uses only those characters. Otherwise the key is the server name.`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`For example, this block:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`8`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`8`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"mcpServers\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"example\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"command\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"npx\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"args\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"-y\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"@example/mcp-server\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`becomes this command:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add-json`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` example`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` '{\"command\":\"npx\",\"args\":[\"-y\",\"@example/mcp-server\"]}'`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`#add-mcp-servers-from-json-configuration`,children:`Add MCP servers from JSON configuration`}),` covers shell escaping and the `,_jsx(_components.code,{children:`--scope`}),` flag for `,_jsx(_components.code,{children:`add-json`}),`. To share the server with your team instead, add `,_jsx(_components.code,{children:`--scope project`}),`, or add the entry under `,_jsx(_components.code,{children:`mcpServers`}),` in `,_jsx(_components.code,{children:`.mcp.json`}),` at your project root and commit it. `,_jsx(_components.a,{href:`#project-scope`,children:`Project scope`}),` covers how Claude Code loads and approves that file.`]}),`\n`,_jsxs(_components.p,{children:[`Each `,_jsx(_components.code,{children:`claude mcp add`}),` and `,_jsx(_components.code,{children:`claude mcp add-json`}),` command prints an `,_jsx(_components.code,{children:`Added ...`}),` line. To check that Claude Code connected, run `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),`; `,_jsx(_components.a,{href:`#server-status`,children:`Server status`}),` covers the statuses it shows and the approval step for `,_jsx(_components.code,{children:`.mcp.json`}),` servers.`]}),`\n`,_jsx(Heading,{level:`3`,id:`managing-your-servers`,children:`Managing your servers`}),`\n`,_jsx(_components.p,{children:`Once configured, you can manage your MCP servers with these commands:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`11`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`11`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# List all configured servers`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` list`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Get details for a specific server`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` get`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` notion`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Remove a server`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` remove`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` notion`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# (within Claude Code) Check server status`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/mcp`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`4`,id:`server-status`,children:`Server status`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`claude mcp add`}),` confirms a successful add by printing an `,_jsx(_components.code,{children:`Added ...`}),` line, which means the configuration was written. `,_jsx(_components.code,{children:`claude mcp list`}),` then shows a health status next to each server it lists, such as `,_jsx(_components.code,{children:`✔ Connected`}),`, `,_jsx(_components.code,{children:`! Needs authentication`}),`, or `,_jsx(_components.code,{children:`✘ Failed to connect`}),`. A failure status means Claude Code couldn’t connect to that server, not that the list command failed.`]}),`\n`,_jsxs(_components.p,{children:[`Project-scoped servers from `,_jsx(_components.code,{children:`.mcp.json`}),` that are awaiting your approval appear in `,_jsx(_components.code,{children:`claude mcp list`}),` and `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` as `,_jsx(_components.code,{children:\"⏸ Pending approval (run `claude` to approve)\"}),`. Run `,_jsx(_components.code,{children:`claude`}),` interactively to review and approve them. `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` shows rejected servers as `,_jsx(_components.code,{children:`✘ Rejected (see disabledMcpjsonServers in settings)`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`WebSocket servers don’t appear in `,_jsx(_components.code,{children:`claude mcp list`}),` output. Use `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` or the `,_jsx(_components.code,{children:`/mcp`}),` panel to check them.`]}),`\n`,_jsx(Heading,{level:`4`,id:`project-server-approvals-and-workspace-trust`,children:`Project server approvals and workspace trust`}),`\n`,_jsxs(_components.p,{children:[`As of v2.1.196, `,_jsx(_components.code,{children:`claude mcp list`}),` and `,_jsx(_components.code,{children:`claude mcp get`}),` read `,_jsx(_components.code,{children:`.mcp.json`}),` approvals only from settings files that aren’t checked into the repository until you trust the workspace by running `,_jsx(_components.code,{children:`claude`}),` in it and accepting the workspace trust dialog. A cloned repository can’t approve its own servers: `,_jsx(_components.a,{href:`/en/settings-reference#enableallprojectmcpservers`,children:_jsx(_components.code,{children:`enableAllProjectMcpServers`})}),` or `,_jsx(_components.a,{href:`/en/settings-reference#enabledmcpjsonservers`,children:_jsx(_components.code,{children:`enabledMcpjsonServers`})}),` committed to the project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` is ignored in an untrusted folder, and the server stays at `,_jsx(_components.code,{children:`⏸ Pending approval`}),` instead of being connected and health-checked.`]}),`\n`,_jsx(_components.p,{children:`Approvals from these sources still apply in an untrusted folder:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`your user `,_jsx(_components.code,{children:`~/.claude/settings.json`})]}),`\n`,_jsx(_components.li,{children:`managed settings`}),`\n`,_jsxs(_components.li,{children:[`settings passed with `,_jsx(_components.code,{children:`--settings`})]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code also applies approvals from an untracked `,_jsx(_components.code,{children:`.claude/settings.local.json`}),`, but it runs git to check whether the file is tracked, and it runs that check only in a `,_jsx(_components.a,{href:`/en/permissions#project-allow-rules-and-workspace-trust`,children:`trusted folder`}),`. In a folder you’ve never trusted, Claude Code waits for the trust dialog before applying the file’s approvals, unless the folder is your own configuration home: your home directory, or a directory whose `,_jsx(_components.code,{children:`.claude`}),` you’ve set as `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CONFIG_DIR`})}),`. Before v2.1.207, Claude Code applied approvals from an untracked `,_jsx(_components.code,{children:`.claude/settings.local.json`}),` even in a folder you’d never trusted.`]}),`\n`,_jsxs(_components.p,{children:[`A `,_jsx(_components.code,{children:`disabledMcpjsonServers`}),` entry in any settings file still rejects the server.`]}),`\n`,_jsx(Heading,{level:`4`,id:`server-status-detail`,children:`Server status detail`}),`\n`,_jsxs(_components.p,{children:[`In `,_jsx(_components.code,{children:`/mcp`}),`, including a server’s menu there, and in the `,_jsx(_components.a,{href:`/en/plugins`,children:_jsx(_components.code,{children:`/plugin`})}),` manager, a remote HTTP or SSE server you’ve used before can show a `,_jsx(_components.code,{children:`cached`}),` status such as `,_jsx(_components.code,{children:`cached 2h ago · connects on first use · 5 tools`}),`. Claude Code loaded the server’s tool list from its discovery cache, saved in a previous session, instead of connecting at startup, and Claude Code connects the server the first time Claude calls one of the server’s tools. The tools are available from your first message, so you don’t need to do anything. The discovery cache and its `,_jsx(_components.code,{children:`cached`}),` status require Claude Code v2.1.221 or later.`]}),`\n`,_jsxs(_components.p,{children:[`The discovery cache is off by default unless a gradual rollout has enabled it for your account. Set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_DISCOVERY_CACHE=1`})}),` to turn it on, or `,_jsx(_components.code,{children:`0`}),` to keep it off even when the rollout has enabled it. Before v2.1.238, the cache was on by default.`]}),`\n`,_jsxs(_components.p,{children:[`Two actions in a server’s menu in `,_jsx(_components.code,{children:`/mcp`}),` also affect that server’s cache entry:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Reconnect`}),`: on a `,_jsx(_components.code,{children:`cached`}),` server, Claude Code connects it now rather than on its first tool call and keeps the entry. On a connected or failed server, Claude Code reconnects it and also discards the entry.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Clear authentication`}),`: Claude Code revokes the server’s authentication and also discards the entry.`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`After discarding the entry, Claude Code fetches the server’s tool list from the server instead of from the cache.`}),`\n`,_jsxs(_components.p,{children:[`When a server’s status is `,_jsx(_components.code,{children:`✘ Failed to connect`}),`, `,_jsx(_components.code,{children:`claude mcp list`}),` appends the failure detail to that status line, and `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` shows it on an `,_jsx(_components.code,{children:`Issue:`}),` line: the HTTP status or error code, plus any error text the server returned. The server’s detail view in `,_jsx(_components.code,{children:`/mcp`}),` includes the same server-reported text in its `,_jsx(_components.code,{children:`Issue:`}),` row. Claude Code redacts credential-like text from this detail and never includes the expanded server URL, which can carry secrets. Claude Code appends no detail to a `,_jsx(_components.code,{children:`✘ Connection error`}),` status, because the exception text it would print there can embed that URL. Before v2.1.219, both commands showed only the bare failure status, without the status code or the server’s error text.`]}),`\n`,_jsxs(_components.p,{children:[`A remote server whose configuration has an empty `,_jsx(_components.code,{children:`url`}),` shows as `,_jsx(_components.code,{children:`not configured`}),` in `,_jsx(_components.code,{children:`/mcp`}),`, in `,_jsx(_components.code,{children:`claude mcp list`}),`, and in the `,_jsx(_components.a,{href:`/en/plugins`,children:_jsx(_components.code,{children:`/plugin`})}),` manager, and Claude Code doesn’t attempt to connect to it. A plugin can include a placeholder entry like this for a connector you configure later, so Claude Code doesn’t report it as an error or a setup issue. The server’s detail view in `,_jsx(_components.code,{children:`/mcp`}),` reads `,_jsx(_components.code,{children:`No URL configured for this server`}),`; set the entry’s `,_jsx(_components.code,{children:`url`}),` to connect it. Before v2.1.208, Claude Code reported an empty `,_jsx(_components.code,{children:`url`}),` as a configuration issue with a prompt to reconnect.`]}),`\n`,_jsx(Heading,{level:`4`,id:`configuration-warnings`,children:`Configuration warnings`}),`\n`,_jsxs(_components.p,{children:[`Claude Code also warns when an MCP config value carries hidden leading or trailing whitespace, which often comes from pasting a token with a trailing newline. Claude Code checks `,_jsx(_components.code,{children:`command`}),`, `,_jsx(_components.code,{children:`url`}),`, each `,_jsx(_components.code,{children:`args`}),` entry, and the values and key names under `,_jsx(_components.code,{children:`env`}),` and `,_jsx(_components.code,{children:`headers`}),`. Claude Code shows the warning in `,_jsx(_components.code,{children:`claude mcp list`}),` output and in `,_jsx(_components.code,{children:`/mcp`}),`, naming the affected fields without echoing their values, for example `,_jsx(_components.code,{children:`Leading or trailing whitespace in: headers.Authorization`}),`. Claude Code doesn’t trim the whitespace and uses the values exactly as written, so edit the configuration to remove it.`]}),`\n`,_jsxs(_components.p,{children:[`Some server names are reserved for Claude Code’s built-in servers: `,_jsx(_components.code,{children:`workspace`}),`, `,_jsx(_components.code,{children:`claude-in-chrome`}),`, `,_jsx(_components.code,{children:`computer-use`}),`, `,_jsx(_components.code,{children:`Claude Preview`}),`, and `,_jsx(_components.code,{children:`Claude Browser`}),`. If your configuration defines a server with a reserved name, Claude Code skips it at load time and shows a warning asking you to rename it. `,_jsx(_components.code,{children:`claude mcp add`}),` rejects a reserved name with an error.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`Claude Preview`}),` and `,_jsx(_components.code,{children:`Claude Browser`}),` both name the built-in server that the `,_jsx(_components.a,{href:`/en/desktop#preview-your-app`,children:`Claude Code desktop app’s preview pane`}),` uses. Before v2.1.205, `,_jsx(_components.code,{children:`Claude Browser`}),` wasn’t reserved, so a user-configured server could register under that name.`]}),`\n`,_jsx(Heading,{level:`4`,id:`tool-availability`,children:`Tool availability`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`/mcp`}),` panel shows the tool count next to each connected server and flags servers that advertise the tools capability but expose no tools.`]}),`\n`,_jsx(_components.p,{children:`If your request needs tools from a server that is still connecting in the background, Claude waits for that server before continuing. How the wait happens depends on your configuration:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`With `,_jsx(_components.a,{href:`#scale-with-mcp-tool-search`,children:`tool search`}),`, the default`]}),`: the wait happens inside the `,_jsx(_components.code,{children:`ToolSearch`}),` call.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Without tool search`}),`: Claude uses the `,_jsx(_components.code,{children:`WaitForMcpServers`}),` tool instead. Configurations without tool search include a custom `,_jsx(_components.code,{children:`ANTHROPIC_BASE_URL`}),`, `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH=false`}),`, and a model earlier than the Claude 4.5 generation on Google Cloud’s Agent Platform.`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.strong,{children:[`On a Microsoft Foundry `,_jsx(_components.a,{href:`https://platform.claude.com/docs/en/build-with-claude/claude-in-microsoft-foundry#hosting-options`,children:`deployment hosted on Azure`})]}),`: Claude starts on the tool-search path rather than with `,_jsx(_components.code,{children:`WaitForMcpServers`}),`, since Claude Code discovers the deployment’s server-side rejection only from the API. After Claude Code switches that deployment to `,_jsx(_components.a,{href:`#scale-with-mcp-tool-search`,children:`upfront loading`}),`, tools from a server that finishes connecting become available on Claude’s next request.`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`With tool search enabled, when a server finishes connecting while Claude is working, Claude Code lists the server’s tool names to Claude on its next request in the same turn. Claude can then search for and call those tools without waiting for your next message.`}),`\n`,_jsx(Heading,{level:`3`,id:`disable-a-server-without-removing-it`,children:`Disable a server without removing it`}),`\n`,_jsxs(_components.p,{children:[`Toggle a server off in the `,_jsx(_components.code,{children:`/mcp`}),` panel to stop Claude Code from connecting to it without losing its configuration. Claude Code still lists the server in `,_jsx(_components.code,{children:`/mcp`}),`, marked as disabled.`]}),`\n`,_jsxs(_components.p,{children:[`When you toggle a server, Claude Code records your choice per project in `,_jsx(_components.code,{children:`~/.claude.json`}),`, in one of two lists that cover disjoint sets of servers:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`disabledMcpServers`}),`: an opt-out list for user-configured servers, plugin servers, claude.ai connectors, and built-in servers that default to on. Claude Code doesn’t connect to a server you list here. When you disable a claude.ai connector with the per-project `,_jsx(_components.code,{children:`/mcp`}),` toggle described in `,_jsx(_components.a,{href:`#disable-claude-ai-connectors`,children:`Disable claude.ai connectors`}),`, Claude Code writes it to this list under its display name, for example `,_jsx(_components.code,{children:`claude.ai Slack`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`enabledMcpServers`}),`: an opt-in list for built-in servers that default to off, such as `,_jsx(_components.code,{children:`computer-use`}),`. Claude Code connects to a default-off server only when you list it here.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code consults exactly one of the two lists for each server, so neither list overrides the other. If you add a regular server to `,_jsx(_components.code,{children:`enabledMcpServers`}),`, or a default-off built-in server to `,_jsx(_components.code,{children:`disabledMcpServers`}),`, Claude Code ignores the entry.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`disabledMcpServers`}),` and `,_jsx(_components.code,{children:`enabledMcpServers`}),` are unrelated to `,_jsx(_components.a,{href:`/en/settings-reference#enabledmcpjsonservers`,children:_jsx(_components.code,{children:`enabledMcpjsonServers`})}),` and `,_jsx(_components.a,{href:`/en/settings-reference#disabledmcpjsonservers`,children:_jsx(_components.code,{children:`disabledMcpjsonServers`})}),`, which control approval of servers defined in a project’s `,_jsx(_components.code,{children:`.mcp.json`}),` file.`]}),`\n`,_jsx(Heading,{level:`3`,id:`mcp-client-runtimes`,children:`MCP client runtimes`}),`\n`,_jsxs(_components.p,{children:[`Claude Code connects to MCP servers through one of two client runtimes. The v1 runtime is built on MCP TypeScript SDK 1.x. The v2 runtime is the same code on `,_jsx(_components.a,{href:`https://ts.sdk.modelcontextprotocol.io/v2/`,children:`MCP TypeScript SDK 2.0`}),`, which adds MCP protocol revision 2026-07-28. The rest of this page applies to both runtimes, except where a section names the v2 runtime.`]}),`\n`,_jsx(_components.p,{children:`On Claude Code v2.1.232 or later, Claude Code uses the v2 runtime. It picks a runtime each time you start it and keeps it until you exit. It uses v1 when you run it:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`On Amazon Bedrock, Claude Platform on AWS, Google Cloud’s Agent Platform, or Microsoft Foundry, unless a host platform that embeds Claude Code sets `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST`})})]}),`\n`,_jsxs(_components.li,{children:[`Signed in through a `,_jsx(_components.a,{href:`/en/claude-apps-gateway`,children:`Claude apps gateway`})]}),`\n`,_jsxs(_components.li,{children:[`With `,_jsx(_components.a,{href:`/en/env-vars#features-that-need-feature-flag-fetching`,children:`feature-flag fetching off`})]}),`\n`]}),`\n`,_jsx(_components.p,{children:`On v2, Claude Code also:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Asks HTTP and claude.ai connector servers whether they support the newer revision, and uses it with those that do. It asks stdio servers only if you set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_PROTOCOL_NEGOTIATION`})}),` to `,_jsx(_components.code,{children:`auto`}),`, and connects to every other server as v1 does.`]}),`\n`,_jsxs(_components.li,{children:[`Receives `,_jsx(_components.code,{children:`list_changed`}),` notifications from servers on the newer revision over a `,_jsx(_components.a,{href:`#notification-streams-on-the-v2-runtime`,children:`stream it holds open`}),`.`]}),`\n`,_jsxs(_components.li,{children:[`Doesn’t register a `,_jsx(_components.a,{href:`#push-messages-with-channels`,children:`channel`}),` server that connects on the newer revision, because that revision can’t carry channel messages.`]}),`\n`,_jsxs(_components.li,{children:[`Fails an `,_jsx(_components.a,{href:`#authenticate-with-remote-mcp-servers`,children:`MCP OAuth sign-in`}),` whose authorization response names an unexpected issuer.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Anthropic can keep a specific server on the earlier protocol, or off that stream, with a feature flag Claude Code fetches. In a `,_jsx(_components.a,{href:`/en/cloud-environments#network-access`,children:`Claude Code on the web`}),` session, Claude Code asks its MCP connectors only if you set `,_jsx(_components.code,{children:`MCP_PROTOCOL_NEGOTIATION`}),` to `,_jsx(_components.code,{children:`auto`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`To pick the runtime yourself, set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_SDK_GENERATION`})}),` to `,_jsx(_components.code,{children:`v1`}),` or `,_jsx(_components.code,{children:`v2`}),`. To decide whether Claude Code asks, set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_PROTOCOL_NEGOTIATION`})}),` to `,_jsx(_components.code,{children:`auto`}),` or `,_jsx(_components.code,{children:`legacy`}),`. Where Claude Code uses v1 by default, pinning `,_jsx(_components.code,{children:`v2`}),` doesn’t make it ask, so set `,_jsx(_components.code,{children:`auto`}),` too.`]}),`\n`,_jsx(Heading,{level:`3`,id:`dynamic-tool-updates`,children:`Dynamic tool updates`}),`\n`,_jsxs(_components.p,{children:[`Claude Code supports MCP `,_jsx(_components.code,{children:`list_changed`}),` notifications, allowing MCP servers to dynamically update their available tools, prompts, and resources without requiring you to disconnect and reconnect. When an MCP server sends a `,_jsx(_components.code,{children:`list_changed`}),` notification, Claude Code automatically refreshes the available capabilities from that server.`]}),`\n`,_jsx(_components.p,{children:`If a refresh request fails, Claude Code keeps the server’s previously discovered tools, prompts, and resources until a later refresh succeeds. Before v2.1.214, a transient error during the refresh replaced the server’s tools, prompts, and resources with an empty list.`}),`\n`,_jsx(Heading,{level:`4`,id:`notification-streams-on-the-v2-runtime`,children:`Notification streams on the v2 runtime`}),`\n`,_jsxs(_components.p,{children:[`On the `,_jsx(_components.a,{href:`#mcp-client-runtimes`,children:`v2 runtime`}),`, Claude Code receives `,_jsx(_components.code,{children:`list_changed`}),` notifications from a server on the newer protocol revision over a stream it holds open. When the stream closes, Claude Code reopens it, with two limits:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`The stream closes again within 10 seconds`}),`: Claude Code reopens it up to three times, then stops for that connection.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`The stream stays open longer than 10 seconds, then closes`}),`, as streams to serverless hosts commonly do: after five reopens in an hour, Claude Code waits about six hours before the next one.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Until the stream reopens, you keep the server’s last fetched tools, prompts, and resources. To pick up its changes sooner, reconnect the server from `,_jsx(_components.code,{children:`/mcp`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`automatic-reconnection`,children:`Automatic reconnection`}),`\n`,_jsxs(_components.p,{children:[`If an HTTP or SSE server disconnects mid-session, Claude Code automatically reconnects with exponential backoff: up to five attempts, starting at a one-second delay and doubling each time. The server appears as pending in `,_jsx(_components.code,{children:`/mcp`}),` while reconnection is in progress. After five failed attempts the server is marked as failed and you can retry manually from `,_jsx(_components.code,{children:`/mcp`}),`. Stdio servers are local processes and are not reconnected automatically.`]}),`\n`,_jsx(_components.p,{children:`The same backoff applies when an HTTP or SSE server fails its initial connection at startup. Claude Code retries the initial connection up to three times on transient errors such as a 5xx response, a connection refused, or a timeout, then marks the server as failed if it still can’t connect. Authentication and not-found errors are not retried because they require a configuration change to resolve.`}),`\n`,_jsxs(_components.p,{children:[`When a configured server fails to connect, Claude Code tells Claude which server failed and its connection error, including in `,_jsx(_components.code,{children:`ToolSearch`}),` results that find no matching tool, so Claude reports the connection failure in its response. Requires `,_jsx(_components.a,{href:`#scale-with-mcp-tool-search`,children:`tool search`}),`, which is enabled by default. In configurations without tool search, such as a custom `,_jsx(_components.code,{children:`ANTHROPIC_BASE_URL`}),`, `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH=false`}),`, or a model that doesn’t support tool search, and on Amazon Bedrock, Google Cloud’s Agent Platform, and Microsoft Foundry, Claude Code doesn’t report failed server connections to Claude.`]}),`\n`,_jsxs(_components.p,{children:[`The capability discovery requests that run after a successful connection, such as `,_jsx(_components.code,{children:`tools/list`}),`, `,_jsx(_components.code,{children:`prompts/list`}),`, and `,_jsx(_components.code,{children:`resources/list`}),`, also retry transient network and server errors up to three times with short backoff. Authentication errors, 4xx responses, and request timeouts are not retried.`]}),`\n`,_jsx(Heading,{level:`3`,id:`push-messages-with-channels`,children:`Push messages with channels`}),`\n`,_jsxs(_components.p,{children:[`An MCP server can also push messages directly into your session so Claude can react to external events like CI results, monitoring alerts, or chat messages. To enable this, your server declares the `,_jsx(_components.code,{children:`claude/channel`}),` capability and you opt it in with the `,_jsx(_components.code,{children:`--channels`}),` flag at startup. See `,_jsx(_components.a,{href:`/en/channels`,children:`Channels`}),` to use an officially supported channel, or `,_jsx(_components.a,{href:`/en/channels-reference`,children:`Channels reference`}),` to build your own.`]}),`\n`,_jsxs(_components.p,{children:[`On the `,_jsx(_components.a,{href:`#mcp-client-runtimes`,children:`v2 runtime`}),`, if you set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_PROTOCOL_NEGOTIATION`})}),` to `,_jsx(_components.code,{children:`auto`}),` and a channel server negotiates MCP protocol revision 2026-07-28, it can’t deliver channel messages, so Claude Code doesn’t register it as a channel. Leaving the variable unset, or setting it to `,_jsx(_components.code,{children:`legacy`}),`, keeps stdio servers on the earlier handshake.`]}),`\n`,_jsxs(Tip,{children:[_jsx(_components.p,{children:`Tips:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Use the `,_jsx(_components.code,{children:`-s`}),` or `,_jsx(_components.code,{children:`--scope`}),` flag to specify where the configuration is stored:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`local`}),` (default): available only to you in the current project`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`project`}),`: shared with everyone in the project via the `,_jsx(_components.code,{children:`.mcp.json`}),` file`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`user`}),`: available to you across all projects`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`Set environment variables with `,_jsx(_components.code,{children:`-e`}),` or `,_jsx(_components.code,{children:`--env`}),` flags (for example, `,_jsx(_components.code,{children:`-e KEY=value`}),`)`]}),`\n`,_jsxs(_components.li,{children:[`The `,_jsx(_components.code,{children:`--transport`}),` and `,_jsx(_components.code,{children:`--header`}),` flags also accept `,_jsx(_components.code,{children:`-t`}),` and `,_jsx(_components.code,{children:`-H`}),` short forms`]}),`\n`,_jsxs(_components.li,{children:[`Configure MCP server startup timeout using the `,_jsx(_components.code,{children:`MCP_TIMEOUT`}),` environment variable (for example, `,_jsx(_components.code,{children:`MCP_TIMEOUT=10000 claude`}),` sets a 10-second timeout)`]}),`\n`,_jsxs(_components.li,{children:[`Set a per-server tool execution timeout by adding a `,_jsx(_components.code,{children:`timeout`}),` field in milliseconds to that server’s `,_jsx(_components.code,{children:`.mcp.json`}),` entry, for example `,_jsx(_components.code,{children:`\"timeout\": 600000`}),` for ten minutes. This overrides the `,_jsx(_components.code,{children:`MCP_TOOL_TIMEOUT`}),` environment variable for that server only`]}),`\n`,_jsxs(_components.li,{children:[`Claude Code displays a warning when MCP tool output exceeds 10,000 tokens and limits output to 25,000 tokens by default. To raise the limit, set the `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`}),` environment variable (for example, `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS=50000`}),`); the warning threshold is fixed. See `,_jsx(_components.a,{href:`#mcp-output-limits-and-warnings`,children:`MCP output limits and warnings`})]}),`\n`,_jsxs(_components.li,{children:[`Use `,_jsx(_components.code,{children:`/mcp`}),` to authenticate with remote servers that require OAuth 2.0 authentication`]}),`\n`]})]}),`\n`,_jsxs(_components.p,{children:[`The per-server `,_jsx(_components.code,{children:`timeout`}),` is a hard wall-clock limit per tool call, and progress notifications from the server don’t extend it. Values below 1000 are ignored and fall through to `,_jsx(_components.code,{children:`MCP_TOOL_TIMEOUT`}),`, or to its default of about 28 hours when that variable is unset. For an HTTP, SSE, or `,_jsx(_components.a,{href:`/en/mcp#use-mcp-servers-from-claude-ai`,children:`claude.ai connector`}),` server there is also a second, per-request timer that covers each request through to the server’s first response byte. That timer is 60 seconds unless you set the per-server `,_jsx(_components.code,{children:`timeout`}),` or `,_jsx(_components.code,{children:`MCP_TOOL_TIMEOUT`}),`; setting either to 60 seconds or higher raises the per-request timer to that value, a lower value doesn’t shorten it, and the 28-hour default of an unset `,_jsx(_components.code,{children:`MCP_TOOL_TIMEOUT`}),` never feeds it. Stdio and WebSocket servers have no per-request timer. Before v2.1.162, values below 1000 were floored to one second instead.`]}),`\n`,_jsxs(_components.p,{children:[`A per-server `,_jsx(_components.code,{children:`timeout`}),` of at least 1000 also acts as a floor on the idle timeout described below: Claude Code never aborts that server’s tool calls for idleness sooner than the per-server `,_jsx(_components.code,{children:`timeout`}),`. Requires Claude Code v2.1.203 or later.`]}),`\n`,_jsxs(_components.p,{children:[`A tool call to an MCP server that sends no response and no progress notification for the idle window aborts with an error instead of waiting for the wall-clock limit. The idle timeout requires Claude Code v2.1.187 or later. It applies to every server type except IDE servers and SDK in-process servers. The idle window defaults to five minutes for HTTP, SSE, WebSocket, and `,_jsx(_components.a,{href:`#use-mcp-servers-from-claude-ai`,children:`claude.ai connector`}),` servers, and to 30 minutes for stdio servers. Before v2.1.203, stdio servers were exempt from the idle timeout.`]}),`\n`,_jsxs(_components.p,{children:[`Set the `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT`})}),` environment variable in milliseconds to change the idle window, or set it to `,_jsx(_components.code,{children:`0`}),` to disable the check.`]}),`\n`,_jsxs(_components.p,{children:[`These timeouts bound how long a call can run, not always how long it blocks the session: a main-conversation call that runs past two minutes moves to a background task first. See `,_jsx(_components.a,{href:`#automatic-backgrounding-of-long-tool-calls`,children:`Automatic backgrounding of long tool calls`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`automatic-backgrounding-of-long-tool-calls`,children:`Automatic backgrounding of long tool calls`}),`\n`,_jsx(_components.p,{children:`An MCP tool call in the main conversation that is still running after two minutes moves to a background task instead of blocking the session. Claude receives the task ID immediately and keeps working, and the result arrives as a task notification when the call settles. Automatic backgrounding requires Claude Code v2.1.212 or later.`}),`\n`,_jsxs(_components.p,{children:[`The task appears in `,_jsx(_components.a,{href:`/en/commands#all-commands`,children:_jsx(_components.code,{children:`/tasks`})}),`, where you can also stop it, and it doesn’t survive exiting the session. The per-call limits still apply while the call runs in the background: the wall-clock limit set by the per-server `,_jsx(_components.code,{children:`timeout`}),` or `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_TOOL_TIMEOUT`})}),`, and the idle timeout set by `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT`})}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Set the `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS`})}),` environment variable in milliseconds to change the threshold, or set it to `,_jsx(_components.code,{children:`0`}),` to turn automatic backgrounding off. Setting `,_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_BACKGROUND_TASKS`}),` to `,_jsx(_components.code,{children:`1`}),` also turns it off, along with all other background task features.`]}),`\n`,_jsx(_components.p,{children:`Some calls never move to the background:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Calls from `,_jsx(_components.a,{href:`/en/sub-agents`,children:`subagents`}),`; Claude Code backgrounds only main-conversation calls`]}),`\n`,_jsx(_components.li,{children:`Calls to IDE servers`}),`\n`,_jsxs(_components.li,{children:[`Calls in `,_jsx(_components.a,{href:`/en/headless`,children:`non-interactive mode`}),`, unless `,_jsx(_components.code,{children:`CLAUDE_AUTO_BACKGROUND_TASKS`}),` is set to `,_jsx(_components.code,{children:`1`}),`, since a one-shot run can end before the result arrives`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`A call waiting on an open `,_jsx(_components.a,{href:`#respond-to-mcp-elicitation-requests`,children:`elicitation dialog`}),` isn’t backgrounded while the dialog is open; the server is blocked on your input, not slow, so Claude Code defers the move until the dialog closes.`]}),`\n`,_jsx(Heading,{level:`3`,id:`plugin-provided-mcp-servers`,children:`Plugin-provided MCP servers`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`/en/plugins`,children:`Plugins`}),` can bundle MCP servers that provide tools and integrations when you enable the plugin. Plugin MCP servers work identically to user-configured servers.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`How plugin MCP servers work`}),`:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Plugins define MCP servers in `,_jsx(_components.code,{children:`.mcp.json`}),` at the plugin root or inline in `,_jsx(_components.code,{children:`plugin.json`})]}),`\n`,_jsx(_components.li,{children:`When you enable a plugin, Claude Code starts its MCP servers automatically`}),`\n`,_jsx(_components.li,{children:`Claude Code offers plugin MCP tools alongside manually configured MCP tools`}),`\n`,_jsxs(_components.li,{children:[`You add and remove plugin servers by installing or uninstalling the plugin, not with `,_jsx(_components.code,{children:`/mcp`}),` commands. You can still `,_jsx(_components.a,{href:`#disable-a-server-without-removing-it`,children:`toggle an installed plugin server off`}),` in `,_jsx(_components.code,{children:`/mcp`}),`, which stops Claude Code from connecting to it without removing the plugin`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Example plugin MCP configuration`}),`:`]}),`\n`,_jsxs(_components.p,{children:[`In `,_jsx(_components.code,{children:`.mcp.json`}),` at plugin root:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`11`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`11`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"mcpServers\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"database-tools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx