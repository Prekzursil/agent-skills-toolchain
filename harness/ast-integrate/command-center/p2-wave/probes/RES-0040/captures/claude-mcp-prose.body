ildren:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` github`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://api.githubcopilot.com/mcp/`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --header`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"Authorization: Bearer YOUR_GITHUB_PAT\"`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Replace `,_jsx(_components.code,{children:`YOUR_GITHUB_PAT`}),` with your personal access token. The `,_jsx(_components.code,{children:`claude mcp add`}),` command saves the configuration without validating credentials, so a placeholder value is accepted here but the server fails to connect later. To verify the connection, run `,_jsx(_components.code,{children:`/mcp`}),` and check that the server shows `,_jsx(_components.code,{children:`connected`}),`. A server with bad credentials shows `,_jsx(_components.code,{children:`failed`}),`, and the failure detail includes the HTTP status the server returned, such as a 401.`]}),`\n`,_jsx(_components.p,{children:`Then work with GitHub:`}),`\n`,_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Review PR #456 and suggest improvements`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Create a new issue for the bug we just found`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Show me all open PRs assigned to me`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(Heading,{level:`3`,id:`example-query-your-postgresql-database`,children:`Example: Query your PostgreSQL database`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`https://github.com/bytebase/dbhub`,children:`DBHub`}),`, the `,_jsx(_components.code,{children:`@bytebase/dbhub`}),` package, is an MCP server that connects Claude to a relational database through the connection string you pass in `,_jsx(_components.code,{children:`--dsn`}),`. Use a read-only database user in the connection string so the queries Claude runs can’t modify data:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` stdio`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` db`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` npx`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` -y`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` @bytebase/dbhub`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --dsn`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"postgresql://readonly:pass@prod.db.com:5432/analytics\"`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`To confirm the server starts, run `,_jsx(_components.code,{children:`/mcp`}),` and check that `,_jsx(_components.code,{children:`db`}),` shows `,_jsx(_components.code,{children:`connected`}),`.`]}),`\n`,_jsx(_components.p,{children:`Then query your database naturally:`}),`\n`,_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`What's our total revenue this month?`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Show me the schema for the orders table`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Find customers who haven't made a purchase in 90 days`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(Heading,{level:`2`,id:`authenticate-with-remote-mcp-servers`,children:`Authenticate with remote MCP servers`}),`\n`,_jsx(_components.p,{children:`Many cloud-based MCP servers require authentication. Claude Code supports OAuth 2.0 for secure connections.`}),`\n`,_jsxs(_components.p,{children:[`Claude Code marks a remote server as needing authentication when the server responds with `,_jsx(_components.code,{children:`401 Unauthorized`}),` or `,_jsx(_components.code,{children:`403 Forbidden`}),`. What Claude Code shows depends on the server:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`For a server you haven’t signed in to, either status code flags it in `,_jsx(_components.code,{children:`/mcp`}),` so you can complete the OAuth flow.`]}),`\n`,_jsxs(_components.li,{children:[`For a `,_jsx(_components.a,{href:`#use-mcp-servers-from-claude-ai`,children:`claude.ai connector`}),`, a `,_jsx(_components.code,{children:`401`}),` caused by claude.ai rejecting your session token doesn’t flag the connector, because re-authorizing the connector can’t fix your login. Claude Code shows the `,_jsx(_components.a,{href:`/en/errors#claude-ai-rejected-the-session-token`,children:`session-token-rejected state`}),` instead.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`When a request to an OAuth server you already signed in to returns `,_jsx(_components.code,{children:`401 Unauthorized`}),`, Claude Code refreshes the stored token, reconnects, and retries the request once. It flags the server in `,_jsx(_components.code,{children:`/mcp`}),` only if that retry also fails. Before v2.1.206, a token refresh that failed for a transient reason, such as a network error, flagged an OAuth server as needing authentication for the rest of the session even though its refresh token was still valid.`]}),`\n`,_jsxs(_components.p,{children:[`When the server rejects the stored refresh token, Claude Code immediately shows a notice pointing at `,_jsx(_components.code,{children:`/mcp`}),`. Open `,_jsx(_components.code,{children:`/mcp`}),` and select `,_jsx(_components.strong,{children:`Re-authenticate`}),` on the server to sign in again before the next tool call fails.`]}),`\n`,_jsxs(_components.p,{children:[`A custom server that returns a `,_jsx(_components.code,{children:`WWW-Authenticate`}),` header pointing to its authorization server gets the same automatic discovery as any other remote server.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code also shows a startup notice when one or more configured servers need authentication, so you don’t have to open `,_jsx(_components.code,{children:`/mcp`}),` to discover which servers need sign-in. The notice requires Claude Code v2.1.193 or later. It counts only servers you can sign in to from Claude Code. Before v2.1.218, it also counted `,_jsx(_components.a,{href:`#use-mcp-servers-from-claude-ai`,children:`claude.ai connectors`}),` that weren’t connected in claude.ai, which you can connect only from claude.ai settings.`]}),`\n`,_jsxs(_components.p,{children:[`In non-interactive mode there’s no `,_jsx(_components.code,{children:`/mcp`}),` panel, so Claude Code can’t run the OAuth flow for you. As of v2.1.196, when a configured server needs authentication during a `,_jsx(_components.code,{children:`claude -p`}),` or Agent SDK run with `,_jsx(_components.a,{href:`#scale-with-mcp-tool-search`,children:`tool search`}),` enabled, which is the default, Claude Code tells Claude that the server’s tools are unavailable until you authorize it. Claude can then name the server that needs sign-in instead of responding as if the server weren’t configured. Complete the sign-in from an interactive session with `,_jsx(_components.code,{children:`/mcp`}),` or `,_jsx(_components.code,{children:`claude mcp login \u003cname\u003e`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`If you configured `,_jsx(_components.code,{children:`headers.Authorization`}),` for the server and the server rejects that header, Claude Code reports the connection as failed instead of falling back to OAuth. Check that the token is valid for the MCP endpoint, or remove the header to use the OAuth flow.`]}),`\n`,_jsxs(Steps,{children:[_jsxs(Step,{title:`Add the server that requires authentication`,children:[_jsxs(_components.p,{children:[`If you already added the `,_jsx(_components.code,{children:`sentry`}),` server in the `,_jsx(_components.a,{href:`/en/mcp-quickstart#connect-a-server-that-requires-sign-in`,children:`MCP quickstart`}),`, skip this step: running `,_jsx(_components.code,{children:`claude mcp add`}),` again with the same server name at the same scope fails with `,_jsx(_components.code,{children:`MCP server sentry already exists in local config`}),`. Otherwise, run:`]}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sentry`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.sentry.dev/mcp`})]}),`\n`]})})})]}),_jsxs(Step,{title:`Use the /mcp command within Claude Code`,children:[_jsx(_components.p,{children:`In Claude Code, use the command:`}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/mcp`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsx(_components.p,{children:`Then follow the steps in your browser to log in.`})]})]}),`\n`,_jsxs(Tip,{children:[_jsx(_components.p,{children:`Tips:`}),_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Authentication tokens are stored securely and refreshed automatically`}),`\n`,_jsxs(_components.li,{children:[`Use “Clear authentication” in the `,_jsx(_components.code,{children:`/mcp`}),` menu to revoke access`]}),`\n`,_jsx(_components.li,{children:`If your browser doesn’t open automatically, copy the provided URL and open it manually`}),`\n`,_jsx(_components.li,{children:`If the browser redirect fails with a connection error after authenticating, paste the full callback URL from your browser’s address bar into the URL prompt that appears in Claude Code`}),`\n`,_jsx(_components.li,{children:`OAuth authentication works with HTTP servers`}),`\n`]})]}),`\n`,_jsx(Heading,{level:`3`,id:`authenticate-from-the-command-line`,children:`Authenticate from the command line`}),`\n`,_jsxs(_components.p,{children:[`From v2.1.186, `,_jsx(_components.code,{children:`claude mcp login \u003cname\u003e`}),` runs a configured server’s OAuth flow directly from your shell, so you don’t need to open the `,_jsx(_components.code,{children:`/mcp`}),` panel inside a session.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` login`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sentry`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`To clear stored credentials later, run `,_jsx(_components.code,{children:`claude mcp logout \u003cname\u003e`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`As of v2.1.191, the command detects when no local browser is available, such as during an SSH session or on Linux without a display server, and prints the authorization URL instead of trying to open a browser. Open the URL on your local machine, then paste the full redirect URL from your browser’s address bar back at the prompt. The command needs an interactive terminal for the paste step, so connect with `,_jsx(_components.code,{children:`ssh -t`}),`. Pass `,_jsx(_components.code,{children:`--no-browser`}),` to force the URL prompt even when a local browser is detected.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` login`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sentry`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --no-browser`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`use-a-fixed-oauth-callback-port`,children:`Use a fixed OAuth callback port`}),`\n`,_jsxs(_components.p,{children:[`Some MCP servers require a specific redirect URI registered in advance. By default, Claude Code picks a random available port for the OAuth callback. Use `,_jsx(_components.code,{children:`--callback-port`}),` to fix the port so it matches a pre-registered redirect URI of the form `,_jsx(_components.code,{children:`http://localhost:PORT/callback`}),`. If sign-in on Claude Code v2.1.229 fails with a redirect URI mismatch, see the version note under `,_jsx(_components.a,{href:`#use-pre-configured-oauth-credentials`,children:`Use pre-configured OAuth credentials`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`You can use `,_jsx(_components.code,{children:`--callback-port`}),` on its own (with dynamic client registration) or together with `,_jsx(_components.code,{children:`--client-id`}),` (with pre-configured credentials).`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`4`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`4`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Fixed callback port with dynamic client registration`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --callback-port`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:` 8080`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`  my-server`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.example.com/mcp`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`use-pre-configured-oauth-credentials`,children:`Use pre-configured OAuth credentials`}),`\n`,_jsx(_components.p,{children:`Some MCP servers don’t support automatic OAuth setup via Dynamic Client Registration. If you see an error like “Incompatible auth server: does not support dynamic client registration,” the server requires pre-configured credentials. Claude Code also supports servers that use a Client ID Metadata Document (CIMD) instead of Dynamic Client Registration, and discovers these automatically. If automatic discovery fails, register an OAuth app through the server’s developer portal first, then provide the credentials when adding the server.`}),`\n`,_jsxs(Steps,{children:[_jsxs(Step,{title:`Register an OAuth app with the server`,children:[_jsx(_components.p,{children:`Create an app through the server’s developer portal and note your client ID and client secret.`}),_jsxs(_components.p,{children:[`Many servers also require a redirect URI. If so, choose a port and register a redirect URI in the format `,_jsx(_components.code,{children:`http://localhost:PORT/callback`}),`. Use that same port with `,_jsx(_components.code,{children:`--callback-port`}),` in the next step.`]}),_jsxs(_components.p,{children:[`In v2.1.229, Claude Code sent `,_jsx(_components.code,{children:`http://127.0.0.1:PORT/callback`}),` instead, and servers that exact-match the registered redirect URI rejected the sign-in with a redirect URI mismatch. Claude Code v2.1.231 restored the `,_jsx(_components.code,{children:`localhost`}),` form. To recover on v2.1.229, upgrade Claude Code, or temporarily add the `,_jsx(_components.code,{children:`http://127.0.0.1:PORT/callback`}),` form to the server’s registered redirect URIs.`]})]}),_jsxs(Step,{title:`Add the server with your credentials`,children:[_jsxs(_components.p,{children:[`Choose one of the following methods. The port used for `,_jsx(_components.code,{children:`--callback-port`}),` can be any available port. It needs to match the redirect URI you registered in the previous step.`]}),_jsxs(Tabs,{children:[_jsxs(Tab,{title:`claude mcp add`,id:`claude-mcp-add`,children:[_jsxs(_components.p,{children:[`Use `,_jsx(_components.code,{children:`--client-id`}),` to pass your app’s client ID. The `,_jsx(_components.code,{children:`--client-secret`}),` flag prompts for the secret with masked input:`]}),_jsx(CodeBlock,{filename:``,n