ur conversation context:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Output warning threshold`}),`: Claude Code displays a warning when any MCP tool output exceeds 10,000 tokens`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Configurable limit`}),`: you can adjust the maximum allowed MCP output tokens using the `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`}),` environment variable`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default limit`}),`: the default maximum is 25,000 tokens`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: the environment variable applies to tools that don’t declare their own limit. Tools that set `,_jsx(_components.a,{href:`#raise-the-limit-for-a-specific-tool`,children:_jsx(_components.code,{children:`anthropic/maxResultSizeChars`})}),` use that value instead for text content, regardless of what `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`}),` is set to. Tools that return image data are still subject to `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`})]}),`\n`]}),`\n`,_jsx(_components.p,{children:`To increase the limit for tools that produce large outputs:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`export`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:` MAX_MCP_OUTPUT_TOKENS`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`50000`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`raise-the-limit-for-a-specific-tool`,children:`Raise the limit for a specific tool`}),`\n`,_jsxs(_components.p,{children:[`If you’re building an MCP server, you can allow individual tools to return results larger than the default persist-to-disk threshold by setting `,_jsx(_components.code,{children:`_meta[\"anthropic/maxResultSizeChars\"]`}),` in the tool’s `,_jsx(_components.code,{children:`tools/list`}),` response entry. Claude Code raises that tool’s threshold to the annotated value, up to a hard ceiling of 500,000 characters.`]}),`\n`,_jsx(_components.p,{children:`This is useful for tools that return inherently large but necessary outputs, such as database schemas or full file trees. Without the annotation, results that exceed the default threshold are persisted to disk and replaced with a file reference in the conversation.`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`7`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`7`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"name\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"get_schema\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"description\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"Returns the full database schema\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"_meta\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"anthropic/maxResultSizeChars\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`200000`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The annotation applies independently of `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`}),` for text content, so users don’t need to raise the environment variable for tools that declare it. Tools that return image data are still subject to the token limit.`]}),`\n`,_jsx(Warning,{children:_jsxs(_components.p,{children:[`If you frequently encounter output warnings with specific MCP servers you don’t control, consider increasing the `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`}),` limit. You can also ask the server author to add the `,_jsx(_components.code,{children:`anthropic/maxResultSizeChars`}),` annotation or to paginate their responses. The annotation has no effect on tools that return image content; for those, raising `,_jsx(_components.code,{children:`MAX_MCP_OUTPUT_TOKENS`}),` is the only option.`]})}),`\n`,_jsx(Heading,{level:`2`,id:`tool-input-schemas-with-a-root-level-combinator`,children:`Tool input schemas with a root-level combinator`}),`\n`,_jsxs(_components.p,{children:[`Some MCP servers declare a tool’s input schema as a JSON Schema union, with `,_jsx(_components.code,{children:`anyOf`}),`, `,_jsx(_components.code,{children:`oneOf`}),`, or `,_jsx(_components.code,{children:`allOf`}),` at the top level of the schema. The Claude API doesn’t accept those keywords at the schema root. It does accept combinators nested inside `,_jsx(_components.code,{children:`properties`}),`, which Claude Code sends unchanged.`]}),`\n`,_jsx(_components.p,{children:`Tools with a root-level combinator stay available. Before sending the tool to the API, Claude Code flattens the schema into a single object and prepends a sentence to the tool’s description that tells Claude which parameter groups belong together:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`allOf`}),`: properties from every branch are merged, and each branch’s `,_jsx(_components.code,{children:`required`}),` list still applies`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`anyOf`}),` and `,_jsx(_components.code,{children:`oneOf`}),`: properties from every branch are merged, and each branch’s `,_jsx(_components.code,{children:`required`}),` list is described in the tool description instead of enforced by the schema`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`Your server receives whichever arguments Claude chose, so keep validating the combination server-side.`}),`\n`,_jsxs(_components.p,{children:[`When Claude Code can’t produce a schema the API accepts, or on a deployment that doesn’t receive the remote configuration that enables the rewrite, such as an offline machine, it skips that one tool, records the reason in the server’s log, and leaves the server’s other tools available. Versions earlier than v2.1.195 skip every tool whose input schema has a root-level `,_jsx(_components.code,{children:`anyOf`}),`, `,_jsx(_components.code,{children:`oneOf`}),`, or `,_jsx(_components.code,{children:`allOf`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`require-approval-for-a-specific-tool`,children:`Require approval for a specific tool`}),`\n`,_jsxs(_components.p,{children:[`If you’re building an MCP server, you can mark a tool as requiring explicit approval on every call by setting `,_jsx(_components.code,{children:`_meta[\"anthropic/requiresUserInteraction\"]`}),` to `,_jsx(_components.code,{children:`true`}),` in the tool’s `,_jsx(_components.code,{children:`tools/list`}),` response entry. The value must be the JSON boolean `,_jsx(_components.code,{children:`true`}),`; any other value is ignored.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code shows that tool’s permission prompt on every call, even in `,_jsx(_components.code,{children:`acceptEdits`}),`, `,_jsx(_components.code,{children:`auto`}),`, and `,_jsx(_components.code,{children:`bypassPermissions`}),` `,_jsx(_components.a,{href:`/en/permissions#permission-modes`,children:`permission modes`}),`, and doesn’t offer a “don’t ask again” option for it. `,_jsx(_components.a,{href:`/en/permissions#permission-rule-syntax`,children:`Allow rules`}),` that match the tool don’t skip the prompt either. In `,_jsx(_components.code,{children:`dontAsk`}),` mode, which never prompts, Claude Code denies the call instead.`]}),`\n`,_jsxs(_components.p,{children:[`The prompt has to reach a person. In non-interactive mode with `,_jsx(_components.a,{href:`/en/cli-reference#cli-flags`,children:_jsx(_components.code,{children:`--permission-prompt-tool`})}),`, an `,_jsx(_components.code,{children:`allow`}),` result from the prompt tool for a flagged tool is converted to a deny with the message `,_jsx(_components.code,{children:`MCP tool requires user interaction; not supported via --permission-prompt-tool`}),`. The Agent SDK’s `,_jsxs(_components.a,{href:`/en/agent-sdk/permissions`,children:[_jsx(_components.code,{children:`canUseTool`}),` callback`]}),` does receive these calls and can approve them, because your SDK application is expected to show them to a user.`]}),`\n`,_jsx(_components.p,{children:`Use this for tools whose permission prompt is itself the point, such as a consent or access-grant step where auto-approval would mean no human ever agreed. Other tools from the same server keep their normal permission behavior.`}),`\n`,_jsxs(_components.p,{children:[`The following `,_jsx(_components.code,{children:`tools/list`}),` entry marks one tool as always requiring approval.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`7`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`7`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"name\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"grant_access\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"description\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"Requests access to a protected resource\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"_meta\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"anthropic/requiresUserInteraction\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`anthropic/requiresUserInteraction`}),` annotation requires Claude Code v2.1.199 or later. Earlier versions ignore it and apply the standard permission flow.`]}),`\n`,_jsxs(_components.p,{children:[`Some surfaces, such as `,_jsx(_components.a,{href:`/en/remote-control`,children:`Remote Control`}),` and applications built on the `,_jsx(_components.a,{href:`/en/agent-sdk/overview`,children:`Agent SDK`}),`, normally let you approve tool calls with one tap. For a tool marked with this annotation, Claude Code withholds the one-tap action and shows the tool’s full permission prompt instead, so approval still comes from a person answering the prompt rather than a tap.`]}),`\n`,_jsx(_components.p,{children:`Claude Code withholds one-tap approval the same way for any permission request that only the terminal dialog can render in full, such as one that carries a safety warning or an always-allow option the remote surface can’t show. You answer that request in the terminal dialog rather than from Remote Control. Requires Claude Code v2.1.214 or later.`}),`\n`,_jsx(Heading,{level:`2`,id:`respond-to-mcp-elicitation-requests`,children:`Respond to MCP elicitation requests`}),`\n`,_jsx(_components.p,{children:`MCP servers can request structured input from you mid-task using elicitation. When a server needs information it can’t get on its own, Claude Code displays an interactive dialog and passes your response back to the server. No configuration is required on your side: elicitation dialogs appear automatically when a server requests them.`}),`\n`,_jsx(_components.p,{children:`Servers can request input in two ways:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Form mode`}),`: Claude Code shows a dialog with form fields defined by the server (for example, a username and password prompt). Fill in the fields and submit.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`URL mode`}),`: Claude Code opens a browser URL for authentication or approval. Complete the flow in the browser, then confirm in the CLI.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`To auto-respond to elicitation requests without showing a dialog, use the `,_jsxs(_components.a,{href:`/en/hooks#elicitation`,children:[_jsx(_components.code,{children:`Elicitation`}),` hook`]}),`.`]}),`\n`,_jsxs(_components.p,{children:[`If you’re building an MCP server that uses elicitation, see the `,_jsx(_components.a,{href:`https://modelcontextprotocol.io/docs/learn/client-concepts#elicitation`,children:`MCP elicitation specification`}),` for protocol details and schema examples.`]}),`\n`,_jsx(Heading,{level:`2`,id:`use-mcp-resources`,children:`Use MCP resources`}),`\n`,_jsx(_components.p,{children:`MCP servers can expose resources that you can reference using @ mentions, similar to how you reference files.`}),`\n`,_jsx(Heading,{level:`3`,id:`reference-mcp-resources`,children:`Reference MCP resources`}),`\n`,_jsxs(Steps,{children:[_jsx(Step,{title:`List available resources`,children:_jsxs(_components.p,{children:[`Type `,_jsx(_components.code,{children:`@`}),` in your prompt to see available resources from all connected MCP servers. Resources appear alongside files in the autocomplete menu.`]})}),_jsxs(Step,{title:`Reference a specific resource`,children:[_jsxs(_components.p,{children:[`Use the format `,_jsx(_components.code,{children:`@server:protocol://resource/path`}),` to reference a resource:`]}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Can you analyze @github:issue://123 and suggest a fix?`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Please review the API documentation at @docs:file://api/authentication`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})})]}),_jsxs(Step,{title:`Multiple resource references`,children:[_jsx(_components.p,{children:`You can reference multiple resources in a single prompt:`}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Compare @postgres:schema://users with @docs:file://database/user-model`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})})]})]}),`\n`,_jsxs(Tip,{children:[_jsx(_components.p,{children:`Tips:`}),_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Resources are automatically fetched and included as attachments when referenced`}),`\n`,_jsx(_components.li,{children:`Resource paths are fuzzy-searchable in the @ mention autocomplete`}),`\n`,_jsx(_components.li,{children:`Claude Code automatically provides tools to list and read MCP resources when servers support them`}),`\n`,_jsx(_components.li,{children:`Resources can contain any type of content that the MCP server provides (text, JSON, structured data, etc.)`}),`\n`]})]}),`\n`,_jsx(Heading,{level:`2`,id:`scale-with-mcp-tool-search`,children:`Scale with MCP tool search`}),`\n`,_jsx(_components.p,{children:`Tool search keeps MCP context usage low by deferring tool definitions until Claude needs them. Only tool names and server instructions load at session start, so adding more MCP servers has minimal impact on your context window. Claude Code doesn’t impose a fixed per-server tool cap; the practical limit is your context window budget.`}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`Tool search isn’t supported on Microsoft Foundry `,_jsx(_components.a,{href:`https://platform.claude.com/docs/en/build-with-claude/claude-in-microsoft-foundry#hosting-options`,children:`deployments hosted on Azure`}),`, which reject it server-side: Claude Code detects the rejection and loads MCP tools upfront for that deployment instead. `,_jsx(_components.a,{href:`#configure-tool-search`,children:_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH`})}),` can’t override this, since the rejection comes from the deployment itself.`]})}),`\n`,_jsx(Heading,{level:`3`,id:`for-mcp-server-authors`,children:`For MCP server authors`}),`\n`,_jsxs(_components.p,{children:[`If you’re building an MCP server, the server instructions field becomes more useful with tool search enabled. Server instructions help Claude understand when to search for your tools, similar to how `,_jsx(_components.a,{href:`/en/skills`,children:`skills`}),` work.`]}),`\n`,_jsx(_components.p,{children:`Add clear, descriptive server instructions that explain:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`What category of tasks your tools handle`}),`\n`,_jsx(_components.li,{children:`When Claude should search for your tools`}),`\n`,_jsx(_components.li,{children:`Key capabilities your server provides`}),`\n`]}),`\n`,_jsx(_components.p,{children:`Claude Code truncates tool descriptions and server instructions at 2KB each. Keep them concise to avoid truncation, and put critical details near the start.`}),`\n`,_jsx(Heading,{level:`3`,id:`configure-tool-search`,children:`Configure tool search`}),`\n`,_jsxs(_components.p,{children:[`Tool search is enabled by default: MCP tools are deferred and discovered on demand. Claude Code disables it when `,_jsx(_components.code,{children:`ANTHROPIC_BASE_URL`}),` points to a non-first-party host, since most proxies don’t forward `,_jsx(_components.code,{children:`tool_reference`}),` blocks. Set `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH`}),` explicitly to override that fallback.`]}),`\n`,_jsxs(_components.p,{children:[`Setting `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS`})}),` keeps tool search off. You can’t override it by setting `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH`}),` yourself. Your organization can keep tool search on through `,_jsx(_components.a,{href:`/en/managed-settings`,children:`managed settings`}),`, on Claude Code v2.1.227 or later. `,_jsx(_components.a,{href:`/en/llm-gateway-protocol#disable-pre-release-capabilities`,children:`Disable pre-release capabilities`}),` covers where the override applies and what the variable strips.`]}),`\n`,_jsxs(_components.p,{children:[`Tool search requires a model that supports `,_jsx(_components.code,{children:`tool_reference`}),` blocks: Claude Sonnet 4.5, Claude Haiku 4.5, Claude Opus 4.5, and later models. See `,_jsx(_components.a,{href:`https://platform.claude.com/docs/en/agents-and-tools/tool-use/tool-search-tool#model-compatibility`,children:`model compatibility in the API docs`}),` for the current list.`]}),`\n`,_jsx(_components.p,{children:`On Google Cloud’s Agent Platform, Claude Code decides by model generation:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Claude Opus 4.5, Sonnet 4.5, Haiku 4.5, and later`}),`: tool search is on by default, the same as on the Anthropic API.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Earlier Agent Platform models`}),`: Claude Code loads all MCP tools upfront, because their serving stacks reject the required beta header. `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH=true`}),` doesn’t override this.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Before v2.1.221, Claude Code disabled tool search for all models on Google Cloud’s Agent Platform unless you set `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH=true`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Control tool search behavior with the `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH`}),` environment variable:`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{style:{textAlign:`left`},children:`Value`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Behavior`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:`(unset)`}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`All MCP tools deferred and loaded on demand. Falls back to loading upfront on Google Cloud’s Agent Platform models earlier than the Claude 4.5 generation, when `,_jsx(_components.code,{children:`ANTHROPIC_BASE_URL`}),` is a non-first-party host, or on a Microsoft Foundry deployment hosted on Azure`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`true`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`All MCP tools deferred, except on a Microsoft Foundry deployment hosted on Azure, where the server-side rejection still forces upfront loading, and on Google Cloud’s Agent Platform models earlier than the Claude 4.5 generation, where Claude Code keeps loading tools upfront. Claude Code sends the beta header through proxies, and requests fail on proxies that don’t support `,_jsx(_components.code,{children:`tool_reference`}),` blocks`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`auto`})}),_jsx(_components.td,{style:{textAlign:`left`},children:`Threshold mode: Claude Code loads the tools it would otherwise defer upfront while their definitions total less than 10% of the context window, and defers all of them once the definitions reach 10%`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`auto:N`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Threshold mode with a custom percentage, where `,_jsx(_components.code,{children:`N`}),` is 0-100. For example, `,_jsx(_components.code,{children:`auto:5`}),` for 5%`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`false`})}),_jsx(_components.td,{style:{textAlign:`left`},children:`All MCP tools loaded upfront, no deferral`})]})]})]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`5`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Use a custom 5% threshold`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`ENABLE_TOOL_SEARCH`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`auto:5`}),_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:` claude`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Disable tool search entirely`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`ENABLE_TOOL_SEARCH`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`false`}),_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:` claude`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Or set the value in your `,_jsxs(_components.a,{href:`/en/settings-reference#env`,children:[`settings.json `,_jsx(_components.code,{children:`env`}),` field`]}),`.`]}),`\n`,_jsxs(_components.p,{children:[`You can also disable the `,_jsx(_components.code,{children:`ToolSearch`}),` tool specifically:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`5`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"permissions\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"deny\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"ToolSearch\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`exempt-a-server-from-deferral`,children:`Exempt a server from deferral`}),`\n`,_jsxs(_components.p,{children:[`If a server’s tools should always be visible to Claude without a search step, set `,_jsx(_components.code,{children:`alwaysLoad`}),` to `,_jsx(_components.code,{children:`true`}),` in that server’s configuration. Every tool from that server then loads into context at session start regardless of the `,_jsx(_components.code,{children:`ENABLE_TOOL_SEARCH`}),` setting. Use this for a small number of tools that Claude needs on every turn, since each upfront tool consumes context that would otherwise be available for your conversation.`]}),`\n`,_jsxs(_components.p,{children:[`The following `,_jsx(_components.code,{children:`.mcp.json`}),` entry exempts one HTTP server while leaving other servers deferred:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`9`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`9`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"mcpServers\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"core-tools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"type\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"http\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"url\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"https://mcp.example.com/mcp\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"alwaysLoad\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`alwaysLoad`}),` field is available on all server types. An MCP server can also mark individual tools as always-loaded by including `,_jsx(_components.code,{children:`\"anthropic/alwaysLoad\": true`}),` in the tool’s `,_jsx(_components.code,{children:`_meta`}),` object, which has the same effect for that tool only.`]}),`\n`,_jsxs(_components.p,{children:[`Setting `,_jsx(_components.code,{children:`alwaysLoad: true`}),` also makes startup wait for the server’s tools, capped at the standard 5-second connect timeout, since they must be present when the first prompt is built. A remote server with a valid `,_jsxs(_components.a,{href:`#server-status-detail`,children:[_jsx(_components.code,{children:`cached`}),` entry`]}),` supplies its tools from the cache without connecting, so it doesn’t hold startup. Other servers connect in the background by default; set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_CONNECTION_NONBLOCKING=0`})}),` to make startup wait for them too.`]}),`\n`,_jsx(Heading,{level:`2`,id:`use-mcp-prompts-as-commands`,children:`Use MCP prompts as commands`}),`\n`,_jsx(_components.p,{children:`MCP servers can expose prompts that become available as commands in Claude Code.`}),`\n`,_jsx(Heading,{level:`3`,id:`execute-mcp-prompts`,children:`Execute MCP prompts`}),`\n`,_jsxs(Steps,{children:[_jsx(Step,{title:`Discover available prompts`,children:_jsxs(_components.p,{children:[`Type `,_jsx(_components.code,{children:`/`}),` to see the commands available to you, including those from MCP servers. MCP prompts appear with the format `,_jsx(_components.code,{children:`/mcp__servername__promptname`}),`.`]})}),_jsx(Step,{title:`Execute a prompt without arguments`,children:_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/mcp__github__list_prs`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})})}),_jsxs(Step,{title:`Execute a prompt with arguments`,children:[_jsx(_components.p,{children:`Many prompts accept arguments. Pass them space-separated after the command:`}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/mcp__github__pr_review 456`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/mcp__jira__create_issue \"Bug in login flow\" high`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})})]})]}),`\n`,_jsxs(Tip,{children:[_jsx(_components.p,{children:`Tips:`}),_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`MCP prompts are dynamically discovered from connected servers`}),`\n`,_jsx(_components.li,{children:`Arguments are parsed based on the prompt’s defined parameters`}),`\n`,_jsx(_components.li,{children:`Prompt results are injected directly into the conversation`}),`\n`,_jsx(_components.li,{children:`Server and prompt names are normalized, with spaces converted to underscores`}),`\n`]})]}),`\n`,_jsx(Heading,{level:`2`,id:`managed-mcp-configuration`,children:`Managed MCP configuration`}),`\n`,_jsxs(_components.p,{children:[`For organizations that need centralized control over which MCP servers users can connect to, see `,_jsx(_components.a,{href:`/en/managed-mcp`,children:`Managed MCP configuration`}),`. It covers deploying a fixed server set with `,_jsx(_components.code,{children:`managed-mcp.json`}),`, restricting servers with `,_jsx(_components.code,{children:`allowedMcpServers`}),` and `,_jsx(_components.code,{children:`deniedMcpServers`}),`, and what users see when a server is blocked.`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"5c:[\"$\",\"$L61\",null,{\"slug\":\"en/mcp\",\"pageMetadata\":\"$4f:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L62\",null,{\"mdxSource\":{\"compiledSource\":\"$63\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"sidebarTitle\":\"Reference\",\"title\":\"Connect Claude Code to tools via MCP\",\"description\":\"Learn how to connect Claude Code to your tools with the Model Context Protocol.\",\"keywords\":[\"mcp\",\"model context protocol\",\"mcp server\",\".mcp.json\",\"figma\",\"linear\"],\"href\":\"/en/mcp\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"code.claude.com/docs\"}]}]\n"])</script></body></html>