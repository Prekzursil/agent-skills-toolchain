mponents.code,{children:`--setting-sources`})}),` or the SDK’s `,_jsx(_components.code,{children:`settingSources`}),` option. `,_jsx(_components.a,{href:`#project-server-approvals-and-workspace-trust`,children:`Project server approvals and workspace trust`}),` covers how approvals committed to the repository interact with workspace trust.`]}),`\n`,_jsx(Heading,{level:`3`,id:`user-scope`,children:`User scope`}),`\n`,_jsxs(_components.p,{children:[`User-scoped servers are stored in `,_jsx(_components.code,{children:`~/.claude.json`}),` and provide cross-project accessibility, making them available across all projects on your machine while remaining private to your user account. This scope works well for personal utility servers, development tools, or services you frequently use across different projects.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Add a user server`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` hubspot`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --scope`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` user`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.hubspot.com/anthropic`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`scope-hierarchy-and-precedence`,children:`Scope hierarchy and precedence`}),`\n`,_jsx(_components.p,{children:`When the same server is defined in more than one place, Claude Code connects to it once, using the definition from the highest-precedence source. The entire server entry from that source is used; fields are not merged across scopes.`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsx(_components.li,{children:`Local scope`}),`\n`,_jsx(_components.li,{children:`Project scope`}),`\n`,_jsx(_components.li,{children:`User scope`}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`/en/plugins`,children:`Plugin-provided servers`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`#use-mcp-servers-from-claude-ai`,children:`claude.ai connectors`})}),`\n`]}),`\n`,_jsx(_components.p,{children:`The three scopes match duplicates by name. Plugins and connectors match by endpoint, so one that points at the same URL or command as a server above is treated as a duplicate.`}),`\n`,_jsxs(_components.p,{children:[`If you open a local session in the `,_jsx(_components.a,{href:`/en/desktop#mcp-servers-from-the-claude-desktop-chat-app`,children:`Desktop app’s Code tab`}),` with the same stdio server name at the top level of `,_jsx(_components.code,{children:`~/.claude.json`}),` (user scope) and in `,_jsx(_components.code,{children:`.mcp.json`}),`, the Code tab uses the `,_jsx(_components.code,{children:`~/.claude.json`}),` definition.`]}),`\n`,_jsxs(Heading,{level:`3`,id:`environment-variable-expansion-in-mcp-json`,children:[`Environment variable expansion in `,_jsx(_components.code,{children:`.mcp.json`})]}),`\n`,_jsxs(_components.p,{children:[`Claude Code supports environment variable expansion in `,_jsx(_components.code,{children:`.mcp.json`}),` files, allowing teams to share configurations while maintaining flexibility for machine-specific paths and sensitive values like API keys.`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Supported syntax:`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:\"${VAR}\"}),`: expands to the value of environment variable `,_jsx(_components.code,{children:`VAR`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:\"${VAR:-default}\"}),`: expands to `,_jsx(_components.code,{children:`VAR`}),` if set, otherwise uses `,_jsx(_components.code,{children:`default`})]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Expansion locations:`}),`\nEnvironment variables can be expanded in:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`command`}),`: the server executable path`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`args`}),`: command-line arguments`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`env`}),`: environment variables passed to the server`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`url`}),`: for HTTP server types`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`headers`}),`: for HTTP server authentication`]}),`\n`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Example with variable expansion:`})}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`11`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`j