fff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="shellscript"><code language="shellscript" numberOfLines="1"><span class="line"><span style="color:#953800;--shiki-dark:#DCDCAA">claude</span><span style="color:#0A3069;--shiki-dark:#CE9178"> mcp</span><span style="color:#0A3069;--shiki-dark:#CE9178"> add-json</span><span style="color:#0A3069;--shiki-dark:#CE9178"> example</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &#x27;{&quot;command&quot;:&quot;npx&quot;,&quot;args&quot;:[&quot;-y&quot;,&quot;@example/mcp-server&quot;]}&#x27;</span></span>
