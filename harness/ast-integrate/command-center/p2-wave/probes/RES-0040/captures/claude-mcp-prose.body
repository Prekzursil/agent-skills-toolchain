span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Or inline in `,_jsx(_components.code,{children:`plugin.json`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`9`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`9`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"name\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"my-plugin\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"mcpServers\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"plugin-api\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"command\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:'\"${CLAUDE_PLUGIN_ROOT}/servers/api-server\"'}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"args\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"--port\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"8080\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Plugin MCP features`}),`:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Automatic lifecycle`}),`: servers connect and disconnect at these points:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`At session startup, Claude Code connects the servers for enabled plugins automatically. In `,_jsx(_components.code,{children:`/mcp`}),`, a remote (HTTP or SSE) plugin server you’ve used before can show the `,_jsxs(_components.a,{href:`#server-status-detail`,children:[_jsx(_components.code,{children:`cached`}),` status`]}),` instead; Claude Code connects it when Claude first calls one of its tools`]}),`\n`,_jsxs(_components.li,{children:[`If you enable or disable a plugin during a session, run `,_jsx(_components.code,{children:`/reload-plugins`}),` to connect or disconnect its MCP servers. When you reload, Claude Code keeps the live connections of plugin servers whose configuration is unchanged, and does the same when you `,_jsx(_components.a,{href:`/en/agent-sdk/typescript#mcpsetserversresult`,children:`replace the session’s MCP server list`}),` from the Agent SDK without naming them`]}),`\n`,_jsxs(_components.li,{children:[`In `,_jsx(_components.a,{href:`/en/claude-code-on-the-web`,children:`web sessions`}),`, an MCP call to a plugin server that isn’t connected yet, such as right after an idle session wakes, starts the server on demand and waits for it to connect`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Path placeholders`}),`: `,_jsx(_components.code,{children:\"${CLAUDE_PLUGIN_ROOT}\"}),` resolves to the plugin’s installation directory, `,_jsx(_components.code,{children:\"${CLAUDE_PLUGIN_DATA}\"}),` to its `,_jsx(_components.a,{href:`/en/plugins-reference#persistent-data-directory`,children:`persistent state`}),` directory, and `,_jsx(_components.code,{children:\"${CLAUDE_PROJECT_DIR}\"}),` to the stable project root. Substitution applies to:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`stdio`}),` servers: `,_jsx(_components.code,{children:`command`}),`, `,_jsx(_components.code,{children:`args`}),`, `,_jsx(_components.code,{children:`env`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`http`}),`, `,_jsx(_components.code,{children:`sse`}),`, and `,_jsx(_components.code,{children:`ws`}),` servers: `,_jsx(_components.code,{children:`url`}),`, `,_jsx(_components.code,{children:`headers`}),`, and `,_jsx(_components.code,{children:`headersHelper`}),`. Before v2.1.195, `,_jsx(_components.code,{children:`headersHelper`}),` passed the placeholder through as a literal string`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`User environment access`}),`: access to the same environment variables as manually configured servers`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Multiple transport types`}),`: support for stdio, SSE, HTTP, and WebSocket transports, though transport support may vary by server`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Plugin servers appear in `,_jsx(_components.code,{children:`/mcp`}),` with indicators showing they come from plugins.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Plugin MCP tool names`}),`:`]}),`\n`,_jsxs(_components.p,{children:[`Tools from a plugin-bundled MCP server include both the plugin name and the server key in their callable name. The full form is `,_jsx(_components.code,{children:`mcp__plugin_\u003cplugin-name\u003e_\u003cserver-name\u003e__\u003ctool-name\u003e`}),`, where any character outside `,_jsx(_components.code,{children:`A-Z`}),`, `,_jsx(_components.code,{children:`a-z`}),`, `,_jsx(_components.code,{children:`0-9`}),`, `,_jsx(_components.code,{children:`_`}),`, and `,_jsx(_components.code,{children:`-`}),` is replaced with `,_jsx(_components.code,{children:`_`}),`. For the `,_jsx(_components.code,{children:`database-tools`}),` server bundled in a plugin named `,_jsx(_components.code,{children:`my-plugin`}),`, a `,_jsx(_components.code,{children:`query`}),` tool is callable as:`]}),`\n`,_jsx(CodeBlock,{numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`mcp__plugin_my-plugin_database-tools__query`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`Use this full name when referencing the tool in `,_jsx(_components.a,{href:`/en/permissions`,children:`permission rules`}),`, a skill’s `,_jsx(_components.code,{children:`allowed-tools`}),` list, a `,_jsxs(_components.a,{href:`/en/sub-agents#available-tools`,children:[`subagent’s `,_jsx(_components.code,{children:`tools`}),` field`]}),`, or a `,_jsx(_components.a,{href:`/en/hooks#match-mcp-tools`,children:`hook matcher`}),`. A hook matcher written against the bare server key, such as `,_jsx(_components.code,{children:`mcp__database-tools__.*`}),`, never fires for a plugin-bundled server.`]}),`\n`,_jsxs(_components.p,{children:[`The server itself registers under the scoped name `,_jsx(_components.code,{children:`plugin:\u003cplugin-name\u003e:\u003cserver-name\u003e`}),`, such as `,_jsx(_components.code,{children:`plugin:my-plugin:database-tools`}),`. Use that name where a configured server name is expected, such as an `,_jsxs(_components.a,{href:`/en/hooks#mcp-tool-hook-fields`,children:[_jsx(_components.code,{children:`mcp_tool`}),` hook’s `,_jsx(_components.code,{children:`server`}),` field`]}),`.`]}),`\n`,_jsxs(_components.p,{children:[`See the `,_jsx(_components.a,{href:`/en/plugins-reference#mcp-servers`,children:`plugin components reference`}),` for details on bundling MCP servers with plugins.`]}),`\n`,_jsx(Heading,{level:`2`,id:`mcp-installation-scopes`,children:`MCP installation scopes`}),`\n`,_jsxs(_components.p,{children:[`MCP servers can be configured at three scopes. The scope you choose controls which projects the server loads in and whether the configuration is shared with your team. Administrators can also deploy servers at the enterprise level via `,_jsx(_components.a,{href:`#managed-mcp-configuration`,children:`managed configuration`}),`.`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Scope`}),_jsx(_components.th,{children:`Loads in`}),_jsx(_components.th,{children:`Shared with team`}),_jsx(_components.th,{children:`Stored in`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.a,{href:`#local-scope`,children:`Local`})}),_jsx(_components.td,{children:`Current project only`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`~/.claude.json`})})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.a,{href:`#project-scope`,children:`Project`})}),_jsx(_components.td,{children:`Current project only`}),_jsx(_components.td,{children:`Yes, via version control`}),_jsxs(_components.td,{children:[_jsx(_components.code,{children:`.mcp.json`}),` in project root`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:_jsx(_components.a,{href:`#user-scope`,children:`User`})}),_jsx(_components.td,{children:`All your projects`}),_jsx(_components.td,{children:`No`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`~/.claude.json`})})]})]})]}),`\n`,_jsx(Heading,{level:`3`,id:`local-scope`,children:`Local scope`}),`\n`,_jsxs(_components.p,{children:[`Local scope is the default. A local-scoped server loads only in the project where you added it and stays private to you. Claude Code stores it in `,_jsx(_components.code,{children:`~/.claude.json`}),` under that project’s path, so the same server won’t appear in your other projects. Use local scope for personal development servers, experimental configurations, or servers with credentials you don’t want in version control.`]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`The term “local scope” for MCP servers differs from general local settings. MCP local-scoped servers are stored in `,_jsx(_components.code,{children:`~/.claude.json`}),` (your home directory), while general local settings use `,_jsx(_components.code,{children:`.claude/settings.local.json`}),` (in the project directory). See `,_jsx(_components.a,{href:`/en/settings#where-settings-live`,children:`Settings`}),` for details on settings file locations.`]})}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`5`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Add a local-scoped server (default)`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` stripe`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.stripe.com`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# Explicitly specify local scope`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{styl