<span class="line"><span style="color:#1F2328;--shiki-dark:#9CDCFE">ENABLE_TOOL_SEARCH</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#0A3069;--shiki-dark:#CE9178">auto:5</span><span style="color:#953800;--shiki-dark:#DCDCAA"> claude</span></span>
