<span class="line"><span style="color:#953800;--shiki-dark:#DCDCAA">claude</span><span style="color:#0A3069;--shiki-dark:#CE9178"> mcp</span><span style="color:#0A3069;--shiki-dark:#CE9178"> add-from-claude-desktop</span></span>
