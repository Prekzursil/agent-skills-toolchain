{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/CNL-0116/council-preset.schema.json",
  "title": "CNL-0116 flagship auto-composed council preset (unit-local contract)",
  "$comment": "Catalog output_schema cites command-center/schema/council-preset.schema.json. On this tree that file is CNL-0107's typed-delta wrapper (unit_id const CNL-0107, $defs.council_preset) and does not define $defs.preset_record. This unit-local schema is the executable Draft 2020-12 contract for CNL-0116 records. It does not claim to own or replace CNL-0107.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "preset"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0116" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0116" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:CNL-0116" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "preset": { "$ref": "#/$defs/preset_record" },
    "sibling": { "type": "object" },
    "worked_example": { "type": "object" },
    "tests": { "type": "array" },
    "negative_controls": { "type": "array" },
    "reviewer": { "type": "object" },
    "honesty": { "type": "object" }
  },
  "$defs": {
    "preset_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "base_spec_ref",
        "default_binding",
        "editable_dials",
        "charter",
        "participants",
        "roles",
        "engagement",
        "budgets",
        "evidence",
        "voting",
        "stopping",
        "outcomes",
        "integrity",
        "artifacts",
        "execution",
        "protocol_binding",
        "meta"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 2 },
        "status": { "type": "string", "minLength": 2 },
        "base_spec_ref": { "type": "string", "minLength": 2 },
        "default_binding": { "type": "string", "minLength": 2 },
        "editable_dials": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "charter": { "type": "object" },
        "participants": { "type": "object" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "engagement": { "type": "object" },
        "budgets": { "type": "object" },
        "evidence": { "type": "object" },
        "voting": { "type": "object" },
        "stopping": { "type": "object" },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "integrity": { "type": "object" },
        "artifacts": { "type": "object" },
        "execution": { "type": "object" },
        "protocol_binding": { "type": "object" },
        "meta": { "type": "object" }
      }
    }
  }
}
