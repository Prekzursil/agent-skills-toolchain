{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/wfa-0143/artifact.schema.json",
  "title": "WFA-0143 workflow-scout foundry artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "answers",
    "pipeline",
    "demonstration_runs",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0143" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "string", "minLength": 8 }
    },
    "pipeline": {
      "type": "object",
      "required": ["engine", "stages", "sources_searched"],
      "properties": {
        "engine": { "type": "string", "minLength": 8 },
        "stages": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "sources_searched": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "demonstration_runs": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "object" }
    },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
