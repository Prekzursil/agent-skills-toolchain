{
  "id": "charter.measurable.demo",
  "objective": "Rank protocol variants for a catalog-class discovery task.",
  "risk_class": "medium",
  "desired_output": "recommendation",
  "consensus_intent": "supermajority",
  "required_outputs": [
    "positions",
    "idea_ledger",
    "argument_graph",
    "votes",
    "dissent",
    "unknowns",
    "experiments",
    "recommendation",
    "calibration"
  ],
  "success_criteria": [
    {
      "id": "c-ideas",
      "metric": "unique_ideas",
      "op": ">=",
      "threshold": 100
    },
    {
      "id": "c-complete",
      "metric": "completeness_score",
      "op": ">=",
      "threshold": 0.9
    }
  ]
}
