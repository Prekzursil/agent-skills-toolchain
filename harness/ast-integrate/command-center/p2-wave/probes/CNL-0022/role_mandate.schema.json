{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/CNL-0022/role_mandate.schema.json",
  "title": "CouncilSpec role mandate: obligations vs permissions vs rights",
  "$defs": {
    "grant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 3
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "must_discharge", "discharge_artifact"],
      "properties": {
        "id": { "$ref": "#/$defs/grant_id" },
        "kind": { "const": "obligation" },
        "must_discharge": { "const": true },
        "discharge_artifact": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 8 }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "may_leave_unused"],
      "properties": {
        "id": { "$ref": "#/$defs/grant_id" },
        "kind": { "const": "permission" },
        "may_leave_unused": { "const": true },
        "description": { "type": "string", "minLength": 8 }
      }
    },
    "right": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "undeniable"],
      "properties": {
        "id": { "$ref": "#/$defs/grant_id" },
        "kind": { "const": "right" },
        "undeniable": { "const": true },
        "description": { "type": "string", "minLength": 8 }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "obligations", "permissions", "rights"],
      "properties": {
        "id": { "$ref": "#/$defs/grant_id" },
        "name": { "type": "string", "minLength": 3 },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/obligation" }
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/permission" }
        },
        "rights": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/right" }
        },
        "incompatible_with": {
          "type": "array",
          "items": { "$ref": "#/$defs/grant_id" }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["roles"],
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    }
  }
}
