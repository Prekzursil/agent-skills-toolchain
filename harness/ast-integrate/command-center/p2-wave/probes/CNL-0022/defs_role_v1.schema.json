{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/CNL-0022/defs_role_v1.schema.json",
  "$comment": "RECONSTRUCTED $defs.role. The Windows path 11-COUNCIL-SPECIFICATION.schema.json is absent on this worktree. Fields are the catalog-cited grant bag (TST-0279 spec :10925; IMP-0280 typed objects; WFA-0037 extractor). Not a byte-for-byte extract.",
  "title": "Reconstructed v1 $defs.role (conflated grant bag)",
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandate", "permissions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "mandate": {
          "type": "string",
          "minLength": 1,
          "$comment": "Untyped prose. Authors dump MUST/MAY/undeniable into one string; a checker cannot iterate it."
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "$comment": "CONFLATOR: obligation ids, optional tool ids, and vote/speak/veto ids are indistinguishable strings."
        },
        "tool_access": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_access": {
          "type": "array",
          "items": { "type": "string" }
        },
        "speaking_rights": { "type": "boolean" },
        "vote_rights": { "type": "boolean" },
        "veto_rights": { "type": "boolean" },
        "incompatible_roles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "type": "object",
  "required": ["id", "mandate", "permissions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "mandate": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tool_access": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_access": {
      "type": "array",
      "items": { "type": "string" }
    },
    "speaking_rights": { "type": "boolean" },
    "vote_rights": { "type": "boolean" },
    "veto_rights": { "type": "boolean" },
    "incompatible_roles": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
