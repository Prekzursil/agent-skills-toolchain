{
  "roles": [
    {
      "id": "proposer",
      "name": "Proposer",
      "obligations": [
        {
          "id": "emit_proposal",
          "kind": "obligation",
          "must_discharge": true,
          "discharge_artifact": "proposal.md",
          "description": "Must file a concrete proposal before voting opens."
        }
      ],
      "permissions": [
        {
          "id": "consult_web",
          "kind": "permission",
          "may_leave_unused": true,
          "description": "May fetch external sources; unused is not a breach."
        }
      ],
      "rights": [
        {
          "id": "speak",
          "kind": "right",
          "undeniable": true,
          "description": "May not be denied a speaking turn."
        },
        {
          "id": "vote",
          "kind": "right",
          "undeniable": true,
          "description": "May not be denied a ballot of weight 1.0 without provenance."
        }
      ],
      "incompatible_with": ["judge"]
    },
    {
      "id": "critic",
