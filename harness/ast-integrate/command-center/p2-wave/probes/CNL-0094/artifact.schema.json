{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0094/artifact.schema.json",
  "title": "CNL-0094 evidence-free majority blocker (JSON body at the catalog .md path)",
  "$comment": "The catalog output_schema is a $ref shim to ast-integrate.invalid. Stock jsonschema 4.10.3 Draft7Validator fetches that URL on the network and raises RefResolutionError. This local schema is the discriminator: it rejects garbage, requires machine_checkable_property, pins both_states.fired_on_bad=true, and types false_positive_rate as a number.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "spec_kind",
    "title",
    "question",
    "machine_checkable_property",
    "answers",
    "detector",
    "fixtures",
    "both_states",
    "detector_control",
    "negative_control",
    "false_positive_rate",
    "tests",
    "named_probes",
    "reviewer",
    "artifacts",
    "evidence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0094" },
    "state": { "type": "string", "const": "SUCCESS" },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0094" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:CNL-0094" },
    "spec_kind": { "type": "string", "const": "council-detector-spec" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "machine_checkable_property": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "required": [
        "minimum_evidence_attachment",
        "evidence_free_majority_fate"
      ],
      "properties": {
        "minimum_evidence_attachment": { "type": "string", "minLength": 40 },
        "evidence_free_majority_fate": { "type": "string", "minLength": 40 }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["fired_on_bad", "silent_on_good"],
      "properties": {
        "fired_on_bad": { "type": "boolean", "const": true },
        "silent_on_good": { "type": "boolean", "const": true }
      }
    },
    "false_positive_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "reran_both_states"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true },
        "reran_both_states": { "type": "boolean", "const": true }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["rejects", "observed"],
      "properties": {
        "rejects": { "type": "string", "minLength": 8 },
        "observed": { "type": "string", "minLength": 8, "pattern": "SILENT" }
      }
    },
    "tests": { "type": "array", "minItems": 4 },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 }
  }
}
