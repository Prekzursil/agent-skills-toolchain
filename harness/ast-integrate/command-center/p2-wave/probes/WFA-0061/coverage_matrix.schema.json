{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0061/coverage_matrix.schema.json",
  "title": "WFA-0061 CoverageMatrix (local; global wfa-schema-pack.json is absent on this tree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "row_axis",
    "col_axis",
    "row_ids",
    "col_ids",
    "cells",
    "uncovered_mechanisms",
    "empty_blueprints",
    "spot_checks",
    "generation_lane_goals",
    "both_directions_published",
    "live_sources"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "CoverageMatrix" },
    "unit_id": { "type": "string", "const": "WFA-0061" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "pattern": "^SUCCESS:WFA-0061" },
    "completion_sentinel": { "type": "string", "pattern": "SUCCESS:WFA-0061" },
    "row_axis": { "type": "string", "const": "canonical_mechanism" },
    "col_axis": { "type": "string", "const": "artifact" },
    "row_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^mech\\." }
    },
    "col_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["row", "col", "state", "rule"],
        "properties": {
          "row": { "type": "string" },
          "col": { "type": "string" },
          "state": { "type": "string", "enum": ["EVIDENCED", "HONEST-NULL", "EMPTY"] },
          "rule": { "type": "string", "minLength": 8 }
        }
      }
    },
    "uncovered_mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^mech\\." }
    },
    "empty_blueprints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^bp\\." }
    },
    "spot_checks": {
      "type": "object",
      "required": ["n_checked", "n_survived", "rows", "all_survived"],
      "properties": {
        "n_checked": { "type": "integer", "minimum": 10 },
        "n_survived": { "type": "integer", "minimum": 10 },
        "all_survived": { "type": "boolean", "const": true }
      }
    },
    "generation_lane_goals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["goal_id", "lane", "kind", "target", "source_gap"],
        "properties": {
          "lane": { "type": "string", "const": "generation" },
          "kind": { "type": "string", "minLength": 4 },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    },
    "both_directions_published": { "type": "boolean", "const": true }
  }
}
