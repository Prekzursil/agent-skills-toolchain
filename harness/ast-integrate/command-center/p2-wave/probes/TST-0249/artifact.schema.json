{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0249/artifact.schema.json",
  "title": "TST-0249 ux_report (declared receipt.schema.json#/$defs/ux_report is absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "ux_pass",
    "chosen_fallback",
    "both_states",
    "regression_seed",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0249" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:TST-0249" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "ux_pass": { "type": "boolean" },
    "chosen_fallback": { "type": ["string", "null"] },
    "both_states": { "type": "object" },
    "regression_seed": { "type": "object" },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
