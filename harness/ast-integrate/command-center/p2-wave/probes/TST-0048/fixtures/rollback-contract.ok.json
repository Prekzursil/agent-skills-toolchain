{
  "strategy": "inverse-plan",
  "restore": [
    "previous-version",
    "previous-configuration",
    "previous-deployed-tree-installer-managed"
  ],
  "preserve": [
    "owner-authored-edits",
    "user-data",
    "mcp-enable-disable-curation",
    "credential-stores",
    "pre-existing-commands-skills-settings"
  ],
  "creation_set": {
    "paths": [
      "commands/cmd.builtin.json",
      "config/harness.json",
      "hooks/hook.pre-tool.json",
      "plugin-extra.json",
      "plugin.json",
      "skills/skill.shipped.md"
    ],
    "disjoint_from_preserve": true
  },
  "inverse_actions": [
    {
      "path": "plugin.json",
      "kind": "restore-bytes",
      "in_creation_set": true,
      "backup_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "path": "plugin-extra.json",
      "kind": "unlink-created",
      "in_creation_set": true,
      "backup_sha256": null
    }
  ],
  "backup": {
    "recorded_before_first_write": true,
    "files": {
      "plugin.json": {
        "existed": true,
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "plugin-extra.json": {
        "existed": false,
        "sha256": null
      }
    }
  },
  "verification": {
    "hashes": {
      "plugin.json": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "all_match": true,
    "complete": true
  }
}
