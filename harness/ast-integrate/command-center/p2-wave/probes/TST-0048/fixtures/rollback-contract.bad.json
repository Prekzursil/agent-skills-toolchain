{
  "strategy": "rmtree-managed-root",
  "restore": [
    "previous-version"
  ],
  "preserve": [],
  "creation_set": {
    "paths": [
      "commands/cmd.builtin.json",
      "config/harness.json",
      "hooks/hook.pre-tool.json",
      "plugin-extra.json",
      "plugin.json",
      "skills/skill.shipped.md"
    ],
    "disjoint_from_preserve": true
  },
  "inverse_actions": [
    {
      "path": "data/user-notes.txt",
      "kind": "restore-bytes",
      "in_creation_set": false
    }
  ],
  "backup": {
    "recorded_before_first_write": false,
    "files": {
      "plugin.json": {
        "existed": true
      }
    }
  },
  "verification": {
    "hashes": {
      "plugin.json": "MISMATCH"
    },
    "all_match": false,
    "complete": true
  }
}
