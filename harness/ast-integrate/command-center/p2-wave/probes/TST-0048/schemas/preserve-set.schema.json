{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "preserve-set.schema.json",
  "title": "Rollback preserve set (never destroyed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner_authored",
    "user_data",
    "mcp_curation",
    "credentials",
    "preexisting_commands_skills_settings"
  ],
  "properties": {
    "owner_authored": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "user_data": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "mcp_curation": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "preexisting_commands_skills_settings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
