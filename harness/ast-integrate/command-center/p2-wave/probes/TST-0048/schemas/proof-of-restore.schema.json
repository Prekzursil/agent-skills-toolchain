{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "proof-of-restore.schema.json",
  "title": "Post-restore verification; complete only if every restored hash matches",
  "type": "object",
  "additionalProperties": false,
  "required": ["hashes", "complete", "all_match"],
  "properties": {
    "hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 3 }
    },
    "all_match": { "type": "boolean" },
    "complete": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "all_match": { "const": false } } },
      "then": { "properties": { "complete": { "const": false } } }
    }
  ]
}
