{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "inverse-action.schema.json",
  "title": "Typed inverse action (11347: never target outside CreationSet)",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "kind", "in_creation_set"],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["restore-bytes", "unlink-created"] },
    "in_creation_set": { "const": true },
    "backup_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    }
  }
}
