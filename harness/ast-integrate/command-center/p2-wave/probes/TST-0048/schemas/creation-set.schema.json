{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creation-set.schema.json",
  "title": "Installer CreationSet (inverse domain)",
  "type": "object",
  "additionalProperties": false,
  "required": ["paths", "disjoint_from_preserve"],
  "properties": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^\\\\]+$" }
    },
    "disjoint_from_preserve": { "const": true }
  }
}
