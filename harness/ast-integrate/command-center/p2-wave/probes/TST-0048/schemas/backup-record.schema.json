{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "backup-record.schema.json",
  "title": "Pre-change backup of installer-managed paths",
  "type": "object",
  "additionalProperties": false,
  "required": ["recorded_before_first_write", "files"],
  "properties": {
    "recorded_before_first_write": { "const": true },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["existed"],
        "properties": {
          "existed": { "type": "boolean" },
          "sha256": { "type": ["string", "null"] }
        }
      }
    }
  }
}
