{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0025/note.schema.json",
  "title": "CNL-0025 chair-powers design note (local). Catalog council-design-note.schema.json is a $ref shim whose target is https://ast-integrate.invalid/; jsonschema 4.10 RefResolver tries the network. G-1 does not require that hop.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "answer",
    "chair_powers",
    "structural_limit",
    "both_states",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts",
    "min_bytes_threshold"
  ],
  "properties": {
    "unit_id": { "const": "CNL-0025" },
    "state": { "const": "SUCCESS" },
    "sentinel": { "const": "SUCCESS:CNL-0025" },
    "completion_sentinel": { "const": "SUCCESS:CNL-0025" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "min_bytes_threshold": { "type": "integer", "minimum": 1 },
    "chair_powers": {
      "type": "object",
      "required": ["agenda", "turn_allocation", "synthesis"],
      "properties": {
        "agenda": { "type": "object", "required": ["permissions", "obligations", "must_not"] },
        "turn_allocation": { "type": "object", "required": ["permissions", "obligations", "must_not"] },
        "synthesis": { "type": "object", "required": ["permissions", "obligations", "must_not", "given"] }
      }
    },
    "structural_limit": {
      "type": "object",
      "required": ["id", "channels", "combined_rule"],
      "properties": {
        "id": { "const": "CAPTURE-BOUND-DUAL" },
        "channels": { "type": "array", "minItems": 2 }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["captured", "evenhanded"],
      "properties": {
        "captured": {
          "type": "object",
          "required": ["captured", "worst_excess", "missing_position_ids"],
          "properties": { "captured": { "const": true } }
        },
        "evenhanded": {
          "type": "object",
          "required": ["captured", "worst_excess", "missing_position_ids"],
          "properties": { "captured": { "const": false } }
        }
      }
    },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor", "mechanism", "command", "verbatim_output"]
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "control_executed"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "const": "PASS" },
        "independent": { "const": true },
        "control_executed": { "const": true }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
