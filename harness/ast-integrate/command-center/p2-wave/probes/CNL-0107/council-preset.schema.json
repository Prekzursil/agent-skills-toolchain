{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/CNL-0107/council-preset.schema.json",
  "title": "CNL-0107 security red/blue council preset (unit-local contract)",
  "$comment": "Catalog output_schema cites command-center/schema/council-preset.schema.json. On this tree that path is a generated generic_report shim (report.kind const council-preset) with no $defs.council_preset. Overwriting the shim would be an ADV rebuild of the schema substrate. This file is the executable Draft 2020-12 contract for CNL-0107 preset records and the design envelope written at the catalog output_path.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answers",
    "preset",
    "nearest_sibling",
    "instantiation"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0107" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0107" },
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "required": [
        "asymmetric_budgets",
        "evidence_standards",
        "win_conditions",
        "timeout_is_not_secure"
      ],
      "properties": {
        "asymmetric_budgets": { "type": "string", "minLength": 40 },
        "evidence_standards": { "type": "string", "minLength": 40 },
        "win_conditions": { "type": "string", "minLength": 40 },
        "timeout_is_not_secure": { "type": "string", "minLength": 40 }
      }
    },
    "preset": { "$ref": "#/$defs/council_preset" },
    "extends_or_supersedes": { "type": "array" },
    "nearest_sibling": { "type": "object" },
    "instantiation": { "type": "object" },
    "tests": { "type": "object" },
    "reviewer": { "type": "object" },
    "honesty": { "type": "object" },
    "named_probes": { "type": "array" }
  },
  "$defs": {
    "council_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "id",
        "kind",
        "base_ref",
        "roles",
        "protocol_binding",
        "protocol_schedule",
        "voting",
        "stopping",
        "budgets",
        "evidence_standards",
        "win_conditions",
        "editable_dials",
        "default_binding",
        "anti_failure",
        "audit"
      ],
      "properties": {
        "artifact_type": { "const": "council_preset" },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "unit_origin": { "type": "string" },
        "base_ref": {
          "type": "object",
          "required": ["spec_kind", "protocol_id", "on_base_version_bump"],
          "properties": {
            "spec_kind": { "type": "string", "minLength": 1 },
            "protocol_id": { "type": "string", "minLength": 1 },
            "on_base_version_bump": { "type": "string", "minLength": 1 }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "mandate", "team"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "mandate": { "type": "string", "minLength": 1 },
              "team": { "type": "string", "minLength": 1 },
              "produces": { "type": "string" }
            }
          }
        },
        "protocol_binding": {
          "type": "object",
          "required": ["protocol_id", "family"],
          "properties": {
            "protocol_id": { "type": "string", "minLength": 1 },
            "family": { "type": "string", "minLength": 1 },
            "name": { "type": "string" }
          }
        },
        "protocol_schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "actor_role", "artifact"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "actor_role": { "type": "string", "minLength": 1 },
              "artifact": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            }
          }
        },
        "voting": {
          "type": "object",
          "required": ["rule", "quorum", "security_poll_forbidden"],
          "properties": {
            "rule": { "type": "string", "minLength": 1 },
            "quorum": { "type": "integer", "minimum": 1 },
            "security_poll_forbidden": { "type": "boolean" }
          }
        },
        "stopping": {
          "type": "object",
          "required": [
            "expression",
            "timeout_outcome",
            "timeout_may_not_map_to_blue_win"
          ],
          "properties": {
            "expression": { "type": "string", "minLength": 1 },
            "max_red_rounds": { "type": "integer", "minimum": 0 },
            "timeout_outcome": {
              "type": "string",
              "enum": ["INCONCLUSIVE", "BLUE_WINS", "RED_WINS", "CONTINUE"]
            },
            "timeout_may_not_map_to_blue_win": { "type": "boolean" }
          }
        },
        "budgets": {
          "type": "object",
          "required": ["red_search_rounds"],
          "properties": {
            "red_search_rounds": { "type": "integer", "minimum": 0 },
            "blue_rebuttal_per_finding": { "type": "integer", "minimum": 0 },
            "neutral_fixed": { "type": "integer", "minimum": 0 },
            "notes": { "type": "string" }
          }
        },
        "evidence_standards": {
          "type": "object",
          "required": ["coverage_ack"],
          "properties": {
            "red_qualifying_finding": {
              "type": "array",
              "items": { "type": "string" }
            },
            "blue_close": { "type": "array", "items": { "type": "string" } },
            "coverage_ack": { "type": "string", "minLength": 1 }
          }
        },
        "win_conditions": {
          "type": "object",
          "required": ["RED_WINS", "BLUE_WINS", "INCONCLUSIVE"],
          "properties": {
            "RED_WINS": { "type": "string", "minLength": 1 },
            "BLUE_WINS": { "type": "string", "minLength": 1 },
            "INCONCLUSIVE": { "type": "string", "minLength": 1 },
            "illegal": { "type": "array", "items": { "type": "string" } }
          }
        },
        "editable_dials": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default_binding": {
          "type": "object",
          "required": ["protocol_id"],
          "properties": {
            "protocol_id": { "type": "string", "minLength": 1 },
            "task_class": { "type": "string" }
          }
        },
        "anti_failure": { "type": "object" },
        "audit": { "type": "object" }
      }
    }
  }
}
