{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/TST-0040/claim-contract.schema.json",
  "title": "TST-0040 eight-field claim-record contract",
  "$comment": "Unit-local conformance schema written before relying on the catalog path. command-center/schema/claim-record.schema.json is a generated receipt-class shim (generic_report + report.kind=claim-record) and does not encode these eight fields. Do not edit the generated shim; this file is the suite.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "canonical_mechanism",
    "verdict",
    "confidence_band",
    "source_lineage",
    "source_probe",
    "verifier_probe",
    "settling_experiment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonical_mechanism": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verdict": {
      "type": "string",
      "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
    },
    "confidence_band": {
      "type": "string",
      "enum": ["almost-certain", "likely", "roughly-even", "unlikely", "remote"]
    },
    "source_lineage": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "type": "object", "minProperties": 1 },
        { "type": "array", "minItems": 1 }
      ]
    },
    "source_probe": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "verifier_probe": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        { "type": "object", "minProperties": 1 }
      ]
    },
    "settling_experiment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
