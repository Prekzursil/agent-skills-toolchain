{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/p2/cnl-0111/council-preset.schema.json",
  "title": "CNL-0111 normative-board family (ethics/legal + risk committee)",
  "$comment": "Catalog output_schema cites command-center/schema/council-preset.schema.json. On this tree that file is a generated shim ($ref to generic_report) and does not define $defs.preset. This unit-local schema is the executable Draft 2020-12 contract for C15/C16 records and the family envelope. It does not overwrite the shared shim.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "presets",
    "composition_rule",
    "instantiations",
    "tests",
    "negative_controls",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0111" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0111" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:CNL-0111" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "presets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/preset" }
    },
    "composition_rule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "formula", "legal_no_risk_accept", "override_path"],
      "properties": {
        "name": { "type": "string", "minLength": 8 },
        "formula": { "type": "string", "minLength": 16 },
        "legal_no_risk_accept": { "type": "string", "minLength": 8 },
        "override_path": { "type": "string", "minLength": 8 }
      }
    },
    "instantiations": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "reviewer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 4 },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "independent": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "bound_protocols",
        "roles",
        "voting_method",
        "stopping_expression",
        "evidence_standard",
        "outcome_types"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 4 },
        "bound_protocols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 2 }
        },
        "voting_method": { "type": "string", "minLength": 4 },
        "stopping_expression": { "type": "string", "minLength": 8 },
        "evidence_standard": {
          "type": "object",
          "additionalProperties": true,
          "required": ["question", "bar"],
          "properties": {
            "question": { "type": "string", "minLength": 4 },
            "bar": { "type": "string", "minLength": 8 }
          }
        },
        "outcome_types": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 4 }
        },
        "question": { "type": "string", "minLength": 4 },
        "supersedes_or_extends": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default_binding": { "type": "object" },
        "editable_dials": { "type": "array" },
        "non_editable_dials": { "type": "array" }
      }
    }
  }
}
