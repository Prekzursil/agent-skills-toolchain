{
  "library": "12-COUNCIL-PROTOCOLS-AND-PRESETS.json",
  "on_this_tree": false,
  "transcription_basis": "ARC-0003 samples.json catalog-cited axes; not a byte copy of 72 presets",
  "presets": [
    {
      "id": "council.preset.catalog-class.editable",
      "source_id": "12-COUNCIL-PROTOCOLS-AND-PRESETS.json#presets",
      "kind": "council_preset",
      "outcome_type": "unspecified",
      "editable": true,
      "default_binding": {
        "protocol": "P-four-voice-prompt",
        "task_selector": "decision_kind==unspecified"
      },
      "protocol_schedule": ["P-four-voice-prompt"],
      "delta": {
        "roles": {
          "required": ["Architect", "Skeptic", "Pragmatist", "Critic"]
        },
        "voting": {
          "rule": "unanimous-or-record-dissent",
          "quorum": 4
        },
        "stopping": {
          "expression": "max_rounds=8 THEN halt",
          "max_rounds": 8,
          "on_timeout": "halt",
          "on_unresolved": "BLOCKED"
        },
        "anti_failure": {
          "on_split": "surface-disagreement",
          "no_silent_average": true
        },
        "audit": {
          "persist_transcript": true,
          "hash_inputs": true
        }
      }
    }
  ]
}
