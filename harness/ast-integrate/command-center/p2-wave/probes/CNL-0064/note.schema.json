{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0064/note.schema.json",
  "title": "CNL-0064 weighted-voting audit design note (unit-local)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "claim_under_test",
    "declared_signal",
    "which_stops_the_round",
    "decision_rule",
    "claims",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "fixture_results",
    "dependency_status",
    "catalog_inputs_on_tree",
    "strongest_surviving_counterargument"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0064" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0064" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "claim_under_test": { "type": "string", "minLength": 16 },
    "declared_signal": {
      "type": "object",
      "required": ["name", "required_fields", "flip_rule", "denominator_rule"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "required_fields": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 3 }
        },
        "flip_rule": { "type": "string", "minLength": 8 },
        "denominator_rule": { "type": "string", "minLength": 8 }
      }
    },
    "which_stops_the_round": {
      "type": "object",
      "required": ["stops", "does_not_stop", "satisfy_quota_from_padding"],
      "properties": {
        "stops": { "type": "string", "minLength": 4 },
        "does_not_stop": { "type": "string", "minLength": 4 },
        "satisfy_quota_from_padding": { "type": "boolean", "const": false }
      }
    },
    "decision_rule": { "type": "object" },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["REFUTED", "CONFIRMED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "line", "snippet", "kind", "claim"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "line": { "type": "integer", "minimum": 1 },
          "snippet": { "type": "string", "minLength": 8 },
          "kind": { "type": "string", "minLength": 3 },
          "claim": { "type": "string", "minLength": 8 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rejects", "verbatim"],
        "properties": {
          "id": { "type": "string" },
          "rejects": { "type": "string" },
          "verbatim": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_id",
        "verdict",
        "independent",
        "scope_not_agreement",
        "re_ran_both_states"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean", "const": true },
        "scope_not_agreement": { "type": "boolean", "const": true },
        "re_ran_both_states": { "type": "boolean", "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "fixture_results": {
      "type": "array",
      "minItems": 4
    },
    "dependency_status": { "type": "object" },
    "catalog_inputs_on_tree": { "type": "object" },
    "strongest_surviving_counterargument": { "type": "string", "minLength": 40 }
  }
}
