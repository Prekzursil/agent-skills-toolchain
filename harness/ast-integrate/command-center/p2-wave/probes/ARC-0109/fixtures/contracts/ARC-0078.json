{
  "$id": "ast://phase4/contracts/ARC-0078",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0078",
  "properties": {
    "hooks": {
      "items": {
        "maxLength": 128,
        "minLength": 3,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "host_compat": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "min": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "scripts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "interpreter": {
            "enum": [
              "python3",
              "node",
              "pwsh",
              "cmd.exe",
              "bash"
            ],
            "type": "string"
          },
          "path": {
            "maxLength": 256,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "path",
          "interpreter"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "type": "array"
    },
    "unknown_field_policy": {
      "enum": [
        "strict",
        "tolerant"
      ],
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "hooks",
    "scripts",
    "host_compat",
    "unknown_field_policy"
  ],
  "title": "Plugin manifest: interpreter-declared scripts, host compat, zero-hooks reject",
  "type": "object"
}
