{
  "$id": "ast://phase4/contracts/ARC-0080",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0080",
  "properties": {
    "exclusions": {
      "items": {
        "enum": [
          ".git",
          "caches",
          "logs",
          "transcripts",
          "credentials",
          "node_modules",
          "__pycache__"
        ],
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "integrity_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "on_ceiling_exceeded": {
      "enum": [
        "fail"
      ],
      "type": "string"
    },
    "package_id": {
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
    },
    "reproducible": {
      "type": "boolean"
    },
    "size_ceiling_bytes": {
      "maximum": 104857600,
      "minimum": 1024,
      "type": "integer"
    }
  },
  "required": [
    "package_id",
    "exclusions",
    "size_ceiling_bytes",
    "integrity_digest",
    "reproducible",
    "on_ceiling_exceeded"
  ],
  "title": "Package content boundary, exclusion list, size ceiling, integrity digest",
  "type": "object"
}
