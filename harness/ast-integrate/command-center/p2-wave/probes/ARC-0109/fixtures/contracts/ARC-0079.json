{
  "$id": "ast://phase4/contracts/ARC-0079",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0079",
  "properties": {
    "declared_permissions": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "license": {
      "maxLength": 64,
      "minLength": 2,
      "type": "string"
    },
    "namespace": {
      "maxLength": 32,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "package_id": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "quality_score": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "versions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "enum": [
              "stable",
              "beta",
              "nightly"
            ],
            "type": "string"
          },
          "lifecycle": {
            "enum": [
              "active",
              "deprecated",
              "revoked"
            ],
            "type": "string"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "builder_id": {
                "maxLength": 64,
                "minLength": 3,
                "type": "string"
              },
              "source_uri": {
                "maxLength": 256,
                "minLength": 8,
                "type": "string"
              }
            },
            "required": [
              "source_uri",
              "builder_id"
            ],
            "type": "object"
          },
          "revocation_notice": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          },
          "sbom_ref": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "signature_ref": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          }
        },
        "required": [
          "version",
          "channel",
          "lifecycle",
          "provenance"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "vulnerability_status": {
      "enum": [
        "clean",
        "advisory",
        "blocked"
      ],
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "namespace",
    "versions",
    "declared_permissions",
    "license",
    "vulnerability_status",
    "quality_score"
  ],
  "title": "Marketplace registry entry: provenance, revocation distinct from deletion",
  "type": "object"
}
