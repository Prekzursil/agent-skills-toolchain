{
  "$id": "ast://phase4/contracts/ARC-0084",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0084",
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "byte_size": {
      "maximum": 104857600,
      "minimum": 2048,
      "type": "integer"
    },
    "content_hash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "manifest_registered": {
      "const": true,
      "type": "boolean"
    },
    "producing_unit": {
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$",
      "type": "string"
    },
    "retention_class": {
      "enum": [
        "ephemeral",
        "standard",
        "archival"
      ],
      "type": "string"
    },
    "schema_ref": {
      "maxLength": 256,
      "minLength": 8,
      "type": "string"
    },
    "sentinel": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "producing_unit",
    "content_hash",
    "byte_size",
    "schema_ref",
    "sentinel",
    "retention_class",
    "manifest_registered"
  ],
  "title": "Artifact envelope: hash, size floor, schema ref, manifest registration",
  "type": "object"
}
