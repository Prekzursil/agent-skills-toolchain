{
  "$id": "ast://phase4/contracts/ARC-0082",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0082",
  "properties": {
    "certified_executable": {
      "type": "boolean"
    },
    "failure_policy": {
      "enum": [
        "halt",
        "repair-loop",
        "skip-stage"
      ],
      "type": "string"
    },
    "id": {
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
    },
    "max_cost_usd": {
      "maximum": 10000,
      "minimum": 0,
      "type": "number"
    },
    "prompt_transport": {
      "const": "file",
      "type": "string"
    },
    "replayable": {
      "type": "boolean"
    },
    "stages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "work",
              "gate",
              "checkpoint",
              "fan-out",
              "barrier"
            ],
            "type": "string"
          },
          "max_retries": {
            "maximum": 8,
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "role"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "id",
    "stages",
    "failure_policy",
    "replayable",
    "certified_executable",
    "prompt_transport"
  ],
  "title": "Workflow DSL: stages, gates, resume/replay, certified-executable required set",
  "type": "object"
}
