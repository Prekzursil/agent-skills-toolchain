{
  "$id": "ast://phase4/contracts/ARC-0090",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0090",
  "properties": {
    "enable_effective": {
      "type": "boolean"
    },
    "enable_scope": {
      "enum": [
        "user",
        "project",
        "local",
        "session"
      ],
      "type": "string"
    },
    "lifecycle_owner": {
      "enum": [
        "session",
        "shared-supervisor"
      ],
      "type": "string"
    },
    "max_processes_per_session": {
      "maximum": 8,
      "minimum": 1,
      "type": "integer"
    },
    "server_id": {
      "maxLength": 64,
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9._-]*$",
      "type": "string"
    },
    "tool_namespace": {
      "maxLength": 32,
      "minLength": 2,
      "type": "string"
    },
    "transport": {
      "enum": [
        "stdio",
        "http"
      ],
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "transport",
    "lifecycle_owner",
    "max_processes_per_session",
    "tool_namespace",
    "enable_scope"
  ],
  "title": "MCP adapter: transport, lifecycle owner, process cap, namespacing, enable scope",
  "type": "object"
}
