{
  "$id": "ast://phase4/contracts/ARC-0086",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0086",
  "properties": {
    "actor": {
      "maxLength": 64,
      "minLength": 2,
      "type": "string"
    },
    "causality_id": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
    },
    "payload_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "phase": {
      "maxLength": 16,
      "minLength": 1,
      "type": "string"
    },
    "secret_redacted": {
      "const": true,
      "type": "boolean"
    },
    "seq": {
      "maximum": 1000000000,
      "minimum": 0,
      "type": "integer"
    },
    "state_transition": {
      "enum": [
        "queued",
        "running",
        "success",
        "failed",
        "blocked"
      ],
      "type": "string"
    },
    "timestamp": {
      "maxLength": 40,
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T",
      "type": "string"
    },
    "unit_id": {
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "timestamp",
    "actor",
    "unit_id",
    "phase",
    "state_transition",
    "correlation_id",
    "causality_id",
    "payload_digest",
    "secret_redacted"
  ],
  "title": "Append-only event: monotonic seq, tz timestamp, causality, redaction",
  "type": "object"
}
