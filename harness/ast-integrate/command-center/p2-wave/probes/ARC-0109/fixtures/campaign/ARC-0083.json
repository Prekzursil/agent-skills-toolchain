{
  "$id": "ast://phase4/contracts/ARC-0083",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "contract_unit": "ARC-0083",
  "properties": {
    "completion_sentinel": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
    },
    "evidence_requirement": {
      "maxLength": 2000,
      "minLength": 16,
      "type": "string"
    },
    "execution_substrate": {
      "enum": [
        "local-serialized",
        "local-parallel",
        "cloud-batch",
        "worktree-isolated"
      ],
      "type": "string"
    },
    "failure_classification": {
      "items": {
        "enum": [
          "detector-failure",
          "mutation-survives",
          "schema-invalid",
          "overclaim",
          "spec-drift",
          "docs-code-divergence",
          "benchmark-gaming"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "fields_from_global_defaults_only": {
      "items": {
        "type": "string"
      },
      "maxItems": 0,
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$",
      "type": "string"
    },
    "output_path": {
      "maxLength": 256,
      "minLength": 8,
      "type": "string"
    },
    "output_schema": {
      "maxLength": 256,
      "minLength": 8,
      "type": "string"
    },
    "phase": {
      "maxLength": 8,
      "minLength": 1,
      "type": "string"
    },
    "question_or_target": {
      "maxLength": 4000,
      "minLength": 40,
      "type": "string"
    },
    "tests_required": {
      "items": {
        "minLength": 8,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "timeout_seconds": {
      "maximum": 86400,
      "minimum": 60,
      "type": "integer"
    },
    "title": {
      "maxLength": 200,
      "minLength": 8,
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "phase",
    "question_or_target",
    "output_path",
    "output_schema",
    "execution_substrate",
    "failure_classification",
    "completion_sentinel",
    "tests_required",
    "evidence_requirement",
    "timeout_seconds",
    "fields_from_global_defaults_only"
  ],
  "title": "Work-unit schema: per-unit mandatory fields, closed enums, no defaults-only",
  "type": "object"
}
