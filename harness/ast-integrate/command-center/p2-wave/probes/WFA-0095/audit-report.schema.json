{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0095/audit-report.schema.json",
  "title": "WFA-0095 unit-local AuditReport (declared pack is WFA-0001)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "sentinel",
    "title",
    "question",
    "policy",
    "evaluations",
    "controls",
    "tests",
    "reviewer",
    "artifacts",
    "evidence",
    "findings",
    "summary"
  ],
  "properties": {
    "unit_id": { "type": "string", "pattern": "^WFA-0095$" },
    "record_type": { "type": "string", "enum": ["AuditReport"] },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "pattern": "^SUCCESS:WFA-0095$" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "policy": {
      "type": "object",
      "required": [
        "text",
        "preserved_attribute_sets",
        "stricter_licence_governs",
        "lossy_collapse_rejected",
        "duplicate_of_required"
      ],
      "properties": {
        "text": { "type": "string", "minLength": 80 },
        "preserved_attribute_sets": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        },
        "stricter_licence_governs": { "type": "boolean" },
        "lossy_collapse_rejected": { "type": "boolean" },
        "duplicate_of_required": { "type": "boolean" }
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "accepted",
          "codes",
          "required_union",
          "missing",
          "matched_expectation"
        ]
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "lossy_rejected",
        "union_preserving_accepted",
        "licence_weakened_rejected",
        "duplicate_of_written",
        "restore_equals_preimage",
        "always_accept_mutant_fails_planted_lossy",
        "policy_has_rejected"
      ],
      "properties": {
        "lossy_rejected": { "type": "boolean" },
        "union_preserving_accepted": { "type": "boolean" },
        "licence_weakened_rejected": { "type": "boolean" },
        "duplicate_of_written": { "type": "boolean" },
        "restore_equals_preimage": { "type": "boolean" },
        "always_accept_mutant_fails_planted_lossy": { "type": "boolean" },
        "policy_has_rejected": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "kind", "claim"]
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1
    },
    "summary": {
      "type": "object",
      "required": ["admitted", "rejected", "policy_constrained"]
    }
  }
}
