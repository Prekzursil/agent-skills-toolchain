{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CNF-0135 executable discrepancy ledger",
  "$comment": "Local ledger schema. Catalog command-center/schema/discrepancy-ledger.schema.json is a generated $ref shim with no test_id guard and an unresolvable remote $id. This file is the executable closer: CLOSED rows require test_id, preregistered_at, and verbatim_result. IRREDUCIBLE is representable without a test.",
  "type": "object",
  "required": ["unit_id", "state", "sentinel", "entries"],
  "properties": {
    "unit_id": { "const": "CNF-0135" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "OPEN", "BLOCKED", "FAILED", "SEVERED", "TIMEOUT"]
    },
    "sentinel": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "test_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,}$"
    },
    "entry": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "TEST_PREREGISTERED",
            "CLOSED_CONFIRMER_REVISED",
            "CLOSED_IMPLEMENTER_REVISED",
            "IRREDUCIBLE"
          ]
        },
        "test_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,}$"
        },
        "preregistered_at": { "type": ["string", "null"] },
        "verbatim_result": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["CLOSED_CONFIRMER_REVISED", "CLOSED_IMPLEMENTER_REVISED"]
              }
            }
          },
          "then": {
            "required": ["test_id", "preregistered_at", "verbatim_result"],
            "properties": {
              "test_id": { "$ref": "#/definitions/test_id" },
              "preregistered_at": { "type": "string", "minLength": 20 },
              "verbatim_result": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "IRREDUCIBLE" } }
          },
          "then": {
            "required": ["irreducible"],
            "properties": {
              "irreducible": {
                "type": "object",
                "required": ["both_parties_attested_no_executable_test"],
                "properties": {
                  "both_parties_attested_no_executable_test": { "const": true }
                }
              }
            }
          }
        }
      ]
    }
  }
}
