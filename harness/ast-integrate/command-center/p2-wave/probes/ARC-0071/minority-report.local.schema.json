{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/ARC-0071/minority-report.local.schema.json",
  "title": "ARC-0071 minority report (local validator; catalog shim $ref is not fetched)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "decision",
    "winner_entry_id",
    "mechanical_check",
    "input_resolution",
    "minority_positions",
    "preservation",
    "both_states",
    "reviewer",
    "evidence",
    "tests",
    "negative_controls"
  ],
  "properties": {
    "unit_id": { "const": "ARC-0071" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:ARC-0071" },
    "question": { "type": "string", "minLength": 40 },
    "decision": { "type": "string", "minLength": 40 },
    "winner_entry_id": { "type": "string", "minLength": 1 },
    "mechanical_check": {
      "type": "object",
      "required": ["formula", "fails_when", "identity"],
      "properties": {
        "formula": { "const": "missing = scorecard_ids - report_ids" },
        "fails_when": { "type": "string", "minLength": 8 },
        "identity": { "const": "judge_id|entry_id|dimension" }
      }
    },
    "input_resolution": {
      "type": "object",
      "required": [
        "scorecards_path",
        "ranking_path",
        "scorecards_live",
        "ranking_live"
      ],
      "properties": {
        "scorecards_path": { "type": "string", "minLength": 8 },
        "ranking_path": { "type": "string", "minLength": 8 },
        "scorecards_live": { "type": "boolean" },
        "ranking_live": { "type": "boolean" }
      }
    },
    "minority_positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "judge_id",
          "entry_id",
          "dimension",
          "score",
          "reasoning",
          "evidence_citation",
          "dissent_id"
        ]
      }
    },
    "preservation": {
      "type": "object",
      "required": [
        "method",
        "formula",
        "scorecard_source",
        "report_source",
        "scorecard_minus_report",
        "missing_count",
        "preserved"
      ],
      "properties": {
        "method": { "const": "set-difference" },
        "formula": { "const": "missing = scorecard_ids - report_ids" },
        "scorecard_minus_report": {
          "type": "array",
          "maxItems": 0
        },
        "missing_count": { "const": 0 },
        "preserved": { "const": true }
      }
    },
    "both_states": {
      "type": "object",
      "required": [
        "victim_id",
        "silent_on_clean",
        "fires_on_delete",
        "discriminates"
      ],
      "properties": {
        "victim_id": { "type": "string", "minLength": 3 },
        "silent_on_clean": { "const": true },
        "fires_on_delete": { "const": true },
        "discriminates": { "const": true }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_id",
        "was_dissenting_judge",
        "verdict",
        "independent",
        "undistorted"
      ],
      "properties": {
        "was_dissenting_judge": { "const": true },
        "verdict": { "const": "PASS" },
        "independent": { "const": true },
        "undistorted": { "const": true }
      }
    },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 2 }
  }
}
