{
  "canonical_format": "agentspec.workflow.canonical",
  "canonical_format_version": 1,
  "workflow": {
    "id": "wf.loop",
    "kind": "Workflow",
    "nodes": [
      {
        "body": [
          "u.body"
        ],
        "convergence_expr": "delta < 0.01",
        "id": "n.loop",
        "kind": "Loop",
        "max_iterations": 8,
        "on_bound_reached": "abort",
        "on_failure": "abort"
      }
    ],
    "params": [],
    "spec_version": "7.0",
    "units": [
      {
        "id": "u.body",
        "kind": "WorkUnit",
        "on_failure": "abort",
        "owner_flags": [],
        "prompt_ref": "body.md",
        "routing": {
          "fallbacks": [
            "sonnet"
          ],
          "model": "opus",
          "role": "implementer",
          "vendor": "anthropic"
        },
        "source_policy": [
          "code",
          "official-docs"
        ],
        "tool_permissions": [
          "Read",
          "Grep"
        ]
      }
    ]
  }
}
