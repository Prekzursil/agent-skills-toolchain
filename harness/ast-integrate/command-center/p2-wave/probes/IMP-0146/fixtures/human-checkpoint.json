{
  "canonical_format": "agentspec.workflow.canonical",
  "canonical_format_version": 1,
  "workflow": {
    "id": "wf.checkpoint",
    "kind": "Workflow",
    "nodes": [
      {
        "allowed_responses": [
          "approve",
          "reject"
        ],
        "default_if_unanswered": "reject",
        "id": "n.gate",
        "kind": "HumanCheckpoint",
        "on_failure": "abort",
        "pause_token": "pause.gate.v1",
        "prompt_ref": "approve.md"
      }
    ],
    "params": [],
    "spec_version": "7.0",
    "units": [
      {
        "id": "u.after",
        "kind": "WorkUnit",
        "on_failure": "abort",
        "owner_flags": [],
        "prompt_ref": "after.md",
        "routing": {
          "fallbacks": [
            "sonnet"
          ],
          "model": "opus",
          "role": "implementer",
          "vendor": "anthropic"
        },
        "source_policy": [
          "code",
          "official-docs"
        ],
        "tool_permissions": [
          "Read",
          "Grep"
        ]
      }
    ]
  }
}
