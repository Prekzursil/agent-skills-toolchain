{
  "canonical_format": "agentspec.workflow.canonical",
  "canonical_format_version": 1,
  "workflow": {
    "id": "wf.sub",
    "kind": "Workflow",
    "nodes": [
      {
        "id": "n.sub",
        "id_namespace": "inner.",
        "kind": "Subworkflow",
        "on_failure": "abort",
        "param_bindings": [
          {
            "name": "region",
            "value": "eu"
          }
        ],
        "workflow_ref": "wf.inner"
      }
    ],
    "params": [
      {
        "default": null,
        "enum": [
          "eu",
          "us"
        ],
        "name": "region",
        "param_type": "string",
        "required": true,
        "secret_ref": null
      }
    ],
    "spec_version": "7.0",
    "units": [
      {
        "id": "u.outer",
        "kind": "WorkUnit",
        "on_failure": "abort",
        "owner_flags": [],
        "prompt_ref": "outer.md",
        "routing": {
          "fallbacks": [
            "sonnet"
          ],
          "model": "opus",
          "role": "implementer",
          "vendor": "anthropic"
        },
        "source_policy": [
          "code",
          "official-docs"
        ],
        "tool_permissions": [
          "Read",
          "Grep"
        ]
      }
    ]
  }
}
