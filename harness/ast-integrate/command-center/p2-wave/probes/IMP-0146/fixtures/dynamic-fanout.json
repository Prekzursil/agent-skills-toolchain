{
  "canonical_format": "agentspec.workflow.canonical",
  "canonical_format_version": 1,
  "workflow": {
    "id": "wf.dynfan",
    "kind": "Workflow",
    "nodes": [
      {
        "id": "n.dyn",
        "item_path": "$.items[*]",
        "kind": "DynamicFanOut",
        "max_cardinality": 32,
        "on_failure": "abort",
        "producer_unit": "u.producer",
        "unit_template": "u.item"
      }
    ],
    "params": [],
    "spec_version": "7.0",
    "units": [
      {
        "id": "u.producer",
        "kind": "WorkUnit",
        "on_failure": "abort",
        "owner_flags": [],
        "prompt_ref": "producer.md",
        "routing": {
          "fallbacks": [
            "sonnet"
          ],
          "model": "opus",
          "role": "implementer",
          "vendor": "anthropic"
        },
        "source_policy": [
          "code",
          "official-docs"
        ],
        "tool_permissions": [
          "Read",
          "Grep"
        ]
      }
    ]
  }
}
