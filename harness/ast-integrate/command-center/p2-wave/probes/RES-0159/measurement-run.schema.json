{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0159/measurement-run.schema.json",
  "title": "RES-0159 local measurement-run (catalog schema absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "claims",
    "evidence",
    "literature",
    "tests",
    "negative_controls",
    "mutant_pairs",
    "reviewer",
    "artifacts",
    "min_bytes_threshold",
    "measurement",
    "detector_control"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0159" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": {
      "type": "string",
      "pattern": "^SUCCESS:RES-0159"
    },
    "report_kind": { "type": "string", "const": "measurement-run" },
    "question": { "type": "string", "minLength": 40 },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["REFUTED", "CONFIRMED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "kind", "claim"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "kind": { "type": "string", "minLength": 3 },
          "claim": { "type": "string", "minLength": 8 }
        }
      }
    },
    "literature": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "citation", "what_was_used", "evidence_tier"],
        "properties": {
          "id": { "type": "string" },
          "citation": { "type": "string", "minLength": 8 },
          "what_was_used": { "type": "string", "minLength": 8 },
          "evidence_tier": { "type": "string", "enum": ["E1", "E2", "E3", "E4"] }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rejects", "observed"],
        "properties": {
          "id": { "type": "string" },
          "rejects": { "type": "string" },
          "observed": { "type": "string" }
        }
      }
    },
    "mutant_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "operator",
          "verdict",
          "mutated_diff",
          "suite_ok",
          "verbatim_output"
        ],
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "operator": { "type": "string" },
          "verdict": { "type": "string", "enum": ["SURVIVED", "KILLED"] },
          "mutated_diff": { "type": "string", "minLength": 8 },
          "suite_ok": { "type": "boolean" },
          "verbatim_output": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "min_bytes_threshold": { "type": "integer", "minimum": 256 },
    "measurement": {
      "type": "object",
      "required": ["raw_n", "novel_n", "declared_n", "novel_over_raw"],
      "properties": {
        "raw_n": { "type": "integer", "minimum": 10 },
        "novel_n": { "type": "integer", "minimum": 0 },
        "declared_n": { "type": "integer", "minimum": 0 },
        "novel_over_raw": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "detector_control": {
      "type": "object",
      "required": ["planted_restatements", "survived", "all_removed"],
      "properties": {
        "planted_restatements": { "type": "integer", "const": 3 },
        "survived": { "type": "integer", "const": 0 },
        "all_removed": { "type": "boolean", "const": true }
      }
    }
  }
}
