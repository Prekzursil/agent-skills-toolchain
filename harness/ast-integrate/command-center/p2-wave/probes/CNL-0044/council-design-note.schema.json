{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0044/council-design-note.schema.json",
  "title": "CNL-0044 TRADECRAFT runtime design note",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "family",
    "enumeration",
    "protocols",
    "duplicates",
    "tests",
    "both_states",
    "negative_controls",
    "reviewer",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0044" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0044" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "family": { "type": "string", "const": "TRADECRAFT" },
    "enumeration": {
      "type": "object",
      "required": ["expected_n", "measured_n", "ids", "agreement"],
      "properties": {
        "expected_n": { "type": "integer", "const": 7 },
        "measured_n": { "type": "integer", "const": 7 },
        "ids": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "type": "string", "pattern": "^P(3[8-9]|4[0-4])$" }
        },
        "agreement": { "type": "boolean", "const": true }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["record_id", "executability", "artifact"],
        "properties": {
          "record_id": { "type": "string" },
          "executability": {
            "type": "string",
            "enum": ["EXECUTABLE", "NOT-EXECUTABLE"]
          }
        }
      }
    },
    "duplicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tradecraft_id", "other_id"],
        "properties": {
          "tradecraft_id": { "type": "string" },
          "other_id": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["known_good", "planted_bad"],
      "properties": {
        "known_good": {
          "type": "object",
          "required": ["silent", "fired"]
        },
        "planted_bad": {
          "type": "object",
          "required": ["silent", "fired"]
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
