{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0103/fault-injection-receipt.schema.json",
  "title": "Fault-injection receipt (TST-0103 commit-exhaustion guard)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "failure_class",
    "report_kind",
    "injected_fault",
    "tests",
    "evidence",
    "named_probes",
    "claims",
    "reviewer",
    "artifacts",
    "host",
    "counters_sampled",
    "ramp"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0103" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:TST-0103" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "failure_class": { "type": "string", "minLength": 8 },
    "report_kind": { "type": "string", "const": "fault-injection-receipt" },
    "injected_fault": {
      "type": "object",
      "required": ["id", "description", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 4 },
        "description": { "type": "string", "minLength": 16 },
        "method": { "type": "string", "minLength": 8 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": { "type": "string", "minLength": 4 },
          "path": { "type": "string", "minLength": 8 }
        }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "command": { "type": "string", "minLength": 8 }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["REFUTED", "CONFIRMED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "host": {
      "type": "object",
      "required": ["os", "commit_probe_source"],
      "properties": {
        "os": { "type": "string", "minLength": 3 },
        "commit_probe_source": { "type": "string", "minLength": 8 }
      }
    },
    "counters_sampled": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 4 }
        }
      }
    },
    "ramp": { "type": "object" }
  }
}
