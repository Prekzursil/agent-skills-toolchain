{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/ARC-0095/matrix-document.schema.json",
  "title": "Compatibility matrix (ARC-0095)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "axes",
    "cells",
    "untested_cell_count",
    "status_counts"
  ],
  "properties": {
    "axes": {
      "type": "object",
      "required": [
        "operating_system",
        "client",
        "client_version",
        "shell",
        "package_version"
      ],
      "properties": {
        "operating_system": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "client": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "client_version": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "shell": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "package_version": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "untested_cell_count": {
      "type": "integer",
      "minimum": 0
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "axes",
          "status",
          "render",
          "is_pass"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 5
          },
          "axes": {
            "type": "object",
            "required": [
              "operating_system",
              "client",
              "client_version",
              "shell",
              "package_version"
            ],
            "properties": {
              "operating_system": {
                "type": "string",
                "minLength": 1
              },
              "client": {
                "type": "string",
                "minLength": 1
              },
              "client_version": {
                "type": "string",
                "minLength": 1
              },
              "shell": {
                "type": "string",
                "minLength": 1
              },
              "package_version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "FAILED",
              "INFERRED",
              "NOT-CHECKED",
              "NOT-APPLICABLE",
              "UNSUPPORTED"
            ]
          },
          "is_pass": {
            "type": "boolean"
          },
          "render": {
            "type": "object",
            "required": [
              "token",
              "glyph",
              "css_class",
              "is_pass",
              "machine_status"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "glyph": {
                "type": "string",
                "minLength": 1
              },
              "css_class": {
                "type": "string",
                "minLength": 3
              },
              "is_pass": {
                "type": "boolean"
              },
              "machine_status": {
                "type": "string",
                "enum": [
                  "SUPPORTED",
                  "FAILED",
                  "INFERRED",
                  "NOT-CHECKED",
                  "NOT-APPLICABLE",
                  "UNSUPPORTED"
                ]
              },
              "color_role": {
                "type": "string"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT-CHECKED"
                }
              }
            },
            "then": {
              "properties": {
                "is_pass": {
                  "const": false
                },
                "render": {
                  "properties": {
                    "token": {
                      "not": {
                        "enum": [
                          "GREEN",
                          "SUPPORTED",
                          "OK",
                          "YES",
                          "TRUE",
                          "PASS",
                          "CHECKED",
                          "RUN"
                        ]
                      }
                    },
                    "is_pass": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "INFERRED"
                }
              }
            },
            "then": {
              "properties": {
                "is_pass": {
                  "const": false
                },
                "status": {
                  "not": {
                    "const": "SUPPORTED"
                  }
                },
                "render": {
                  "properties": {
                    "is_pass": {
                      "const": false
                    },
                    "machine_status": {
                      "const": "INFERRED"
                    },
                    "css_class": {
                      "not": {
                        "const": "matrix-cell-supported"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SUPPORTED"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
