{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0112/benchmark-result.local.schema.json",
  "title": "WFA-0112 BenchmarkResult-shaped corpus (local stand-in while WFA-0001 pack is absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "families",
    "cases",
    "uncovered_families",
    "oracle_evidence",
    "network"
  ],
  "properties": {
    "unit_id": { "const": "WFA-0112" },
    "record_type": { "const": "BenchmarkResult" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0112" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0112" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "families": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20
    },
    "uncovered_families": {
      "type": "array",
      "maxItems": 20
    },
    "oracle_evidence": {
      "type": "object",
      "required": [
        "all_oracles_deterministic",
        "all_known_bad_rejected",
        "cross_family_gold_rejected",
        "n_covered"
      ],
      "properties": {
        "all_oracles_deterministic": { "const": true },
        "all_known_bad_rejected": { "const": true },
        "cross_family_gold_rejected": { "const": true },
        "n_covered": { "type": "integer", "minimum": 20 }
      }
    },
    "network": {
      "type": "object",
      "required": ["required", "used"],
      "properties": {
        "required": { "const": false },
        "used": { "const": false }
      }
    }
  }
}
