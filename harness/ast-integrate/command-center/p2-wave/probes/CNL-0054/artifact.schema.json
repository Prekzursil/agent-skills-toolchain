{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CNL-0054 category taxonomy coverage+diversity design note (JSON at the catalog .md path)",
  "$comment": "Local non-vacuous control. No $id: jsonschema 4.10 RefResolver treats a path $id plus internal $ref as a fetch. Catalog output_schema is a generated $ref shim; do not rebuild it.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "answers",
    "claims",
    "taxonomy",
    "measurement",
    "fixture_scores",
    "both_states",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0054" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "string", "minLength": 8 }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "required": ["id", "closed", "categories"],
      "properties": {
        "id": { "type": "string", "minLength": 4 },
        "closed": { "type": "boolean", "const": true },
        "categories": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 2 }
            }
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["name", "threshold_reject_below", "coverage_alone_insufficient"],
      "properties": {
        "name": { "type": "string", "minLength": 4 },
        "threshold_reject_below": { "type": "number" },
        "coverage_alone_insufficient": { "type": "boolean", "const": true }
      }
    },
    "fixture_scores": {
      "type": "object",
      "required": ["clustered", "spread", "token_coverage"],
      "properties": {
        "clustered": {
          "type": "object",
          "required": ["n", "coverage", "joint", "fires"],
          "properties": {
            "n": { "type": "integer", "minimum": 1 },
            "coverage": { "type": "number" },
            "joint": { "type": "number" },
            "fires": { "type": "boolean" }
          }
        },
        "spread": {
          "type": "object",
          "required": ["n", "coverage", "joint", "fires"],
          "properties": {
            "n": { "type": "integer", "minimum": 1 },
            "coverage": { "type": "number" },
            "joint": { "type": "number" },
            "fires": { "type": "boolean" }
          }
        },
        "token_coverage": {
          "type": "object",
          "required": ["n", "coverage", "joint", "fires"],
          "properties": {
            "n": { "type": "integer", "minimum": 1 },
            "coverage": { "type": "number" },
            "joint": { "type": "number" },
            "fires": { "type": "boolean" }
          }
        },
        "invalid_label": { "type": "object" }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["planted_bad_fires", "known_good_silent", "verbatim_bad", "verbatim_good"],
      "properties": {
        "planted_bad_fires": { "type": "boolean", "const": true },
        "known_good_silent": { "type": "boolean", "const": true },
        "verbatim_bad": { "type": "string", "minLength": 16 },
        "verbatim_good": { "type": "string", "minLength": 16 }
      }
    },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
