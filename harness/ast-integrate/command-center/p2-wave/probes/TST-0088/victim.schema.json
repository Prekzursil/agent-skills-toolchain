{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0088/victim.schema.json",
  "title": "Victim unit artifact (sentinel is a completion-predicate concern, not a schema required)",
  "type": "object",
  "additionalProperties": true,
  "required": ["unit_id", "state"],
  "properties": {
    "unit_id": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "payload": { "type": "string" },
    "sentinel": { "type": "string" },
    "looks_plausible": { "type": "boolean" },
    "note": { "type": "string" }
  }
}
