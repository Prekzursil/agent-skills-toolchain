{
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "mechanism",
    "classification_rules",
    "license_risk_register",
    "lattice",
    "fusions",
    "multi_class_fusions",
    "prohibited_combinations",
    "credit_loss",
    "both_states",
    "live_source",
    "honesty",
    "evidence",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0139" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0139" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "mechanism": { "type": "string", "minLength": 16 },
    "classification_rules": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["index", "id", "title"]
      }
    },
    "license_risk_register": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45
    },
    "lattice": {
      "type": "object",
      "required": ["ranks", "copyleft_classes", "unknown_never_permissive"],
      "properties": {
        "unknown_never_permissive": { "type": "boolean", "const": true }
      }
    },
    "fusions": { "type": "array", "minItems": 30, "maxItems": 30 },
    "multi_class_fusions": { "type": "array", "minItems": 1 },
    "prohibited_combinations": { "type": "array", "minItems": 1 },
    "credit_loss": {
      "type": "object",
      "required": ["any", "fusion_ids"]
    },
    "both_states": {
      "type": "object",
      "required": ["copyleft_plus_permissive", "unknown_license"]
    },
    "live_source": { "type": "object" },
    "honesty": { "type": "string", "minLength": 16 },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "detail", "anchor"]
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"]
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"]
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
