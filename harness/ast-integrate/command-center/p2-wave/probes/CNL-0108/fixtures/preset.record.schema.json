{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/CNL-0108/fixtures/preset.record.schema.json",
  "title": "CNL-0108 incident-lifecycle family envelope and 20-key preset record",
  "$comment": "Catalog output_schema command-center/schema/council-preset.schema.json is a generated generic_report shim with no $defs.preset. This unit-local file is the executable Draft 2020-12 contract for affected preset records. It does not replace the catalog path.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "presets"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0108" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0108" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "object" },
    "presets": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "family",
        "artifact_type",
        "base_spec_ref",
        "base_spec_version",
        "default_binding",
        "protocol_schedule",
        "roster",
        "voting",
        "consensus",
        "stopping",
        "anti_failure",
        "audit",
        "editable_dials",
        "outcome_type",
        "evidence_contract",
        "floor_policy",
        "clock",
        "supersedes"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "name": { "type": "string", "minLength": 2 },
        "family": { "type": "string", "minLength": 2 },
        "artifact_type": { "type": "string", "const": "council-preset" },
        "base_spec_ref": { "type": "string", "minLength": 2 },
        "base_spec_version": { "type": "string", "minLength": 1 },
        "default_binding": {
          "type": "object",
          "required": ["protocol_ids"],
          "properties": {
            "protocol_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 2 }
            }
          }
        },
        "protocol_schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["order", "protocol_id", "purpose"],
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "protocol_id": { "type": "string", "minLength": 2 },
              "purpose": { "type": "string", "minLength": 4 }
            }
          }
        },
        "roster": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "obligation", "permission", "right"],
            "properties": {
              "id": { "type": "string", "minLength": 2 },
              "obligation": { "type": "string", "minLength": 4 },
              "permission": { "type": "string", "minLength": 4 },
              "right": { "type": "string", "minLength": 4 }
            }
          }
        },
        "voting": {
          "type": "object",
          "required": ["method", "quorum"],
          "properties": {
            "method": { "type": "string", "minLength": 2 },
            "quorum": { "type": "integer", "minimum": 1 }
          }
        },
        "consensus": {
          "type": "object",
          "required": ["reducer", "local_completion_forbidden"],
          "properties": {
            "reducer": { "type": "string", "minLength": 2 },
            "local_completion_forbidden": { "type": "boolean" }
          }
        },
        "stopping": {
          "type": "object",
          "required": ["expr", "on_timeout", "max_rounds"],
          "properties": {
            "expr": { "type": "object" },
            "on_timeout": { "type": "string", "minLength": 2 },
            "max_rounds": { "type": "integer", "minimum": 1 }
          }
        },
        "anti_failure": {
          "type": "object",
          "required": ["on_split", "no_silent_average"],
          "properties": {
            "on_split": { "type": "string", "minLength": 2 },
            "no_silent_average": { "type": "boolean" }
          }
        },
        "audit": {
          "type": "object",
          "required": ["persist_transcript", "hash_inputs"],
          "properties": {
            "persist_transcript": { "type": "boolean" },
            "hash_inputs": { "type": "boolean" }
          }
        },
        "editable_dials": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outcome_type": { "type": "string", "minLength": 2 },
        "evidence_contract": {
          "type": "object",
          "required": ["order", "unevidenced_cause"],
          "properties": {
            "order": { "type": "string", "minLength": 2 },
            "unevidenced_cause": { "type": "string", "minLength": 2 }
          }
        },
        "floor_policy": {
          "type": "object",
          "required": [
            "min_rounds",
            "min_independent_briefs",
            "min_evidence",
            "may_skip_minimum_deliberation",
            "skip_scope",
            "ceiling_max_rounds"
          ],
          "properties": {
            "min_rounds": { "type": "integer", "minimum": 0 },
            "min_independent_briefs": { "type": "integer", "minimum": 0 },
            "min_evidence": { "type": "integer", "minimum": 0 },
            "may_skip_minimum_deliberation": { "type": "boolean" },
            "skip_scope": { "type": "string", "minLength": 2 },
            "ceiling_max_rounds": { "type": "integer", "minimum": 1 }
          }
        },
        "clock": {
          "type": "object",
          "required": ["kind", "action_pressure"],
          "properties": {
            "kind": { "type": "string", "minLength": 2 },
            "action_pressure": { "type": "boolean" }
          }
        },
        "supersedes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}
