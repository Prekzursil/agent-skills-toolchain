{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ADV-0019/stale-premise-reprobe.schema.json",
  "title": "Stale-premise reprobe record (ADV-0019)",
  "description": "Discriminating envelope for stale-premise ADV units. Catalog path command-center/schema/stale-premise-reprobe.schema.json is absent on this worktree; this probe-local schema is the executable contract. A self-declared BLOCKED/FAILED state is schema-legal but is not G-1 delivery.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "question",
    "verdicts",
    "named_probes",
    "controls",
    "tests",
    "evidence",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
    },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 40 },
    "report_kind": { "type": "string", "const": "stale-premise-reprobe" },
    "question": { "type": "string", "minLength": 40 },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "claim", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "command", "exit_code", "raw_output"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 8 },
          "exit_code": { "type": "integer" },
          "raw_output": { "type": "string", "minLength": 8 }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "description",
          "fired_on_bad_state",
          "silent_on_good_state"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT-RUN"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "claim", "detail"],
        "properties": {
          "kind": { "type": "string", "minLength": 3 },
          "claim": { "type": "string", "minLength": 8 },
          "detail": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
