{
  "$comment": "Pivot from command-center/schema/foundry-artifact.schema.json#/$defs/compat-repair. That shim $ref targets https://ast-integrate.invalid/platform/schema/artifact-class-profiles.schema.json which jsonschema 4.10.3 Draft7Validator fetches over the network and raises RefResolutionError. Same-fingerprint retry is parked. This file is the named required_fix for live emit on this worktree. It is NOT a rewrite of the catalog output_schema path. It encodes the unit contract the live probes already check.",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/WFA-0149/compat-repair.local.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "bulk_symmetrise": {
      "additionalProperties": true,
      "properties": {
        "admissible": { "const": false },
        "rejected": { "const": true }
      },
      "required": ["rejected", "admissible"],
      "type": "object"
    },
    "census_matrix": { "type": "object" },
    "census_rederived": { "type": "object" },
    "pairs": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "from": { "minLength": 1, "type": "string" },
          "relation": { "minLength": 1, "type": "string" },
          "to": { "minLength": 1, "type": "string" },
          "verdict": { "enum": ["DIRECTIONAL", "MISSING-REVERSE"] }
        },
        "required": ["from", "to", "relation", "verdict"],
        "type": "object"
      },
      "maxItems": 140,
      "minItems": 140,
      "type": "array"
    },
    "repaired_census": { "type": "object" },
    "sentinel": { "const": "SUCCESS:WFA-0149" },
    "state": { "const": "SUCCESS" },
    "unit_id": { "const": "WFA-0149" },
    "verdict_counts": {
      "additionalProperties": true,
      "properties": {
        "DIRECTIONAL": { "minimum": 1, "type": "integer" },
        "MISSING-REVERSE": { "minimum": 1, "type": "integer" }
      },
      "required": ["DIRECTIONAL", "MISSING-REVERSE"],
      "type": "object"
    }
  },
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "pairs",
    "census_rederived",
    "census_matrix",
    "repaired_census",
    "bulk_symmetrise",
    "verdict_counts"
  ],
  "type": "object"
}
