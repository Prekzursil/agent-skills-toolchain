{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/WFA-0124/coverage_matrix.schema.json",
  "title": "CoverageMatrix (WFA-0124 local stand-in; WFA-0001 pack absent on this tree)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "schema_version",
    "title",
    "question",
    "axes",
    "cells",
    "totals",
    "measured_executable_count",
    "catalog_claim",
    "declared_executable_floor",
    "meets_executable_floor",
    "flagship_required",
    "flagship_identified",
    "flagship_deficit",
    "enumeration_source",
    "pre_claim_fingerprint",
    "rows",
    "contradictions",
    "remaining_work_backlog",
    "member_work_template",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "min_bytes_threshold"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "CoverageMatrix" },
    "unit_id": { "type": "string", "const": "WFA-0124" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "pattern": "^SUCCESS:WFA-0124" },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "axes": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 3 }
    },
    "cells": {
      "type": "array",
      "items": { "$ref": "#/$defs/cell" }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_blueprint_rows",
        "ir_load_ok",
        "smoke_ok",
        "measured_executable",
        "flagship_identified",
        "contradictions",
        "honest_null_library_absent"
      ],
      "properties": {
        "live_blueprint_rows": { "type": "integer", "minimum": 0 },
        "ir_load_ok": { "type": "integer", "minimum": 0 },
        "smoke_ok": { "type": "integer", "minimum": 0 },
        "measured_executable": { "type": "integer", "minimum": 0 },
        "flagship_identified": { "type": "integer", "minimum": 0 },
        "contradictions": { "type": "integer", "minimum": 0 },
        "honest_null_library_absent": { "type": "boolean" }
      }
    },
    "measured_executable_count": { "type": "integer", "minimum": 0 },
    "catalog_claim": { "type": "integer", "minimum": 0 },
    "declared_executable_floor": { "type": "integer", "minimum": 0 },
    "meets_executable_floor": { "type": "boolean" },
    "flagship_required": { "type": "integer", "minimum": 0 },
    "flagship_identified": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "flagship_deficit": { "type": "integer", "minimum": 0 },
    "flagship_identification_rule": { "type": "string", "minLength": 24 },
    "enumeration_source": { "type": "string", "const": "filesystem" },
    "pre_claim_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "claim_source": { "type": "string", "minLength": 8 },
    "floor_source": { "type": "string", "minLength": 8 },
    "catalog_declared_size_components": { "type": "object" },
    "scanned_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exists", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 3 },
          "exists": { "type": "boolean" },
          "kind": { "type": "string", "enum": ["file", "directory"] }
        }
      }
    },
    "live_member_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/blueprint_row" }
    },
    "contradictions": {
      "type": "array",
      "items": { "$ref": "#/$defs/contradiction" }
    },
    "remaining_work_backlog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/work_item" }
    },
    "member_work_template": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/work_item" }
    },
    "ir_contract": { "type": "object" },
    "clean_execution_environment": { "type": "string", "minLength": 8 },
    "schema_pack_present": { "type": "boolean" },
    "wfa_0044_present": { "type": "boolean" },
    "library_present": { "type": "boolean" },
    "detector_controls": { "type": "object" },
    "answer": { "type": "string", "minLength": 40 },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "fired_on_bad_state",
          "silent_on_good_state",
          "bad_state_output",
          "good_state_output"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "kind": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" },
          "bad_state_output": { "type": "string", "minLength": 8 },
          "good_state_output": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "enum": ["PASS"] },
        "independent": { "type": "boolean" },
        "scope_not_agreement": { "type": "boolean" },
        "scope": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean" },
          "role": { "type": "string", "enum": ["primary", "supporting"] }
        }
      }
    },
    "min_bytes_threshold": { "type": "integer", "minimum": 512 },
    "retry_policy_note": { "type": "string" }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "tier", "status"],
      "properties": {
        "blueprint_id": { "type": "string", "minLength": 1 },
        "tier": {
          "type": "string",
          "enum": ["discovery_record", "ir_load", "smoke", "flagship_e2e"]
        },
        "status": {
          "type": "string",
          "enum": ["EVIDENCED", "HONEST-NULL", "EMPTY", "FAIL"]
        },
        "detail": { "type": "string" }
      }
    },
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "action", "acceptance", "owner_lane"],
      "properties": {
        "task_id": { "type": "string", "minLength": 6 },
        "action": { "type": "string", "minLength": 40 },
        "acceptance": { "type": "string", "minLength": 24 },
        "owner_lane": { "type": "string", "minLength": 4 }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "kind", "declared", "measured"],
      "properties": {
        "blueprint_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 8 },
        "declared": { "type": "string", "minLength": 3 },
        "measured": { "type": "string", "minLength": 3 }
      }
    },
    "blueprint_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "declared_discovery_only",
        "declared_state",
        "declared_quality_tier",
        "ir_load",
        "smoke",
        "e2e",
        "classification",
        "exit_code",
        "remaining_work"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 3 },
        "declared_discovery_only": { "type": "boolean" },
        "declared_state": { "type": "string" },
        "declared_quality_tier": { "type": "string" },
        "ir_load": { "type": "object" },
        "smoke": { "type": "object" },
        "e2e": { "type": "object" },
        "classification": {
          "type": "string",
          "enum": ["executable", "failure", "load-error", "library-absent"]
        },
        "exit_code": { "type": "integer" },
        "artifact_path": { "type": "string" },
        "error": { "type": "string" },
        "contradiction": { "type": "string" },
        "flagship_identified": { "type": "boolean" },
        "remaining_work": {
          "type": "array",
          "items": { "$ref": "#/$defs/work_item" }
        }
      }
    }
  }
}
