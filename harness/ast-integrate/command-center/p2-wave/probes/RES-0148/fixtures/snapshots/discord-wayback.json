IC_PAGE"},{"__typename":"NavItem","title":"Company","url":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fblog.discord.com\u002Fcompany-posts\u002Fhome","type":"TOPIC_PAGE"},{"__typename":"NavItem","title":"Education","url":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fblog.discord.com\u002Feducation-posts\u002Fhome","type":"TOPIC_PAGE"},{"__typename":"NavItem","title":"Community","url":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fblog.discord.com\u002Fcommunity-posts\u002Fhome","type":"TOPIC_PAGE"},{"__typename":"NavItem","title":"Engineering","url":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fblog.discord.com\u002Fengineering-posts\u002Fhome","type":"TOPIC_PAGE"},{"__typename":"NavItem","title":"Discord.com","url":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fdiscord.com\u002F","type":"EXTERNAL_LINK_NAV_ITEM"}],"creator":{"__ref":"User:7441635a46f7"},"subscriberCount":81116,"avatar":{"__ref":"ImageMetadata:1*6NM093PuIKCvX3z2JCyDQQ.png"},"isEnrolledInHightower":false,"newsletterV3":null,"viewerIsFollowing":false,"viewerIsSubscribedToLetters":false,"canToggleEmail":false,"isUserSubscribedToCollectionEmails":false,"viewerIsMuting":false,"viewerCanEditOwnPosts":false,"viewerCanEditPosts":false,"description":"Discord is a voice, video and text communication service to talk and hang out with your friends and communities.","ampEnabled":false,"twitterUsername":"discord","facebookPageId":null},"User:fd45ac301b54":{"id":"fd45ac301b54","__typename":"User","isFollowing":false,"viewerIsUser":false,"isSuspended":false,"name":"Jesse Howarth","hasCompletedProfile":false,"bio":"","imageId":"1*tNrZL0th3ePB5oiniU6Ryg.png","customStyleSheet":null,"hasDomain":false,"username":"jesse_11222","isAuroraVisible":true,"socialStats":{"__typename":"SocialStats","followerCount":957},"isBlocking":false,"mediumMemberAt":0,"isMuting":false,"allowNotes":true,"newsletterV3":null,"twitterScreenName":"","isPartnerProgramEnrolled":false},"Paragraph:8487af440232_0":{"id":"8487af440232_0","__typename":"Paragraph","name":"05ad","text":"Why Discord is switching from Go to Rust","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_1":{"id":"8487af440232_1","__typename":"Paragraph","name":"9e3b","text":"","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*BYeVEgTVQia4MD5LSLoUlA.png"},"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_2":{"id":"8487af440232_2","__typename":"Paragraph","name":"27aa","text":"Rust is becoming a first class language in a variety of domains. At Discord, we’ve seen success with Rust on the client side and server side. For example, we use it on the client side for our video encoding pipeline for Go Live and on the server side for Elixir NIFs. Most recently, we drastically improved the performance of a service by switching its implementation from Go to Rust. This post explains why it made sense for us to reimplement the service, how it was done, and the resulting performance improvements.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":255,"end":266,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fblog.discordapp.com\u002Fusing-rust-to-scale-elixir-for-11-million-concurrent-users-c6f19fc029d3","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_3":{"id":"8487af440232_3","__typename":"Paragraph","name":"1f41","text":"The Read States service","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_4":{"id":"8487af440232_4","__typename":"Paragraph","name":"0ea8","text":"Discord is a product focused company, so we’ll start with some product context. The service we switched from Go to Rust is the “Read States” service. Its sole purpose is to keep track of which channels and messages you have read. Read States is accessed every time you connect to Discord, every time a message is sent and every time a message is read. In short, Read States is in the hot path. We want to make sure Discord feels super snappy all the time, so we need to make sure Read States is quick.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_5":{"id":"8487af440232_5","__typename":"Paragraph","name":"5c55","text":"With the Go implementation, the Read States service was not supporting its product requirements. It was fast most of the time, but every few minutes we saw large latency spikes that were bad for user experience. After investigating, we determined the spikes were due to core Go features: its memory model and garbage collector (GC).","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_6":{"id":"8487af440232_6","__typename":"Paragraph","name":"b2d6","text":"Why Go did not meet our performance targets","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_7":{"id":"8487af440232_7","__typename":"Paragraph","name":"4776","text":"To explain why Go wasn’t meeting our performance targets, we first need to discuss the data structures, scale, access patterns, and architecture of the service.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_8":{"id":"8487af440232_8","__typename":"Paragraph","name":"e488","text":"The data structure we use to store read state information is conveniently called “Read State”. Discord has billions of Read States. There is one Read State per User per Channel. Each Read State has several counters that need to be updated atomically and often reset to 0. For example, one of the counters is how many @mentions you have in a channel.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_9":{"id":"8487af440232_9","__typename":"Paragraph","name":"d018","text":"In order to get quick atomic counter updates, each Read States server has a Least Recently Used (LRU) cache of Read States. There are millions of Users in each cache. There are tens of millions of Read States in each cache. There are hundreds of thousands of cache updates per second.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_10":{"id":"8487af440232_10","__typename":"Paragraph","name":"1b7f","text":"For persistence, we back the cache with a Cassandra database cluster. On cache key eviction, we commit your Read States to the database. We also schedule a database commit for 30 seconds in the future whenever a Read State is updated. There are tens of thousands of database writes per second.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_11":{"id":"8487af440232_11","__typename":"Paragraph","name":"2a00","text":"In the picture below, you can see the response time and system cpu for a peak sample time frame for the Go service.¹ As you might notice, there are latency and CPU spikes roughly every 2 minutes.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_12":{"id":"8487af440232_12","__typename":"Paragraph","name":"ddf9","text":"","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*3v779KSfo2OkxUPfPptq_Q.png"},"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_13":{"id":"8487af440232_13","__typename":"Paragraph","name":"7f5c","text":"So why 2 minute spikes?","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_14":{"id":"8487af440232_14","__typename":"Paragraph","name":"369a","text":"In Go, on cache key eviction, memory is not immediately freed. Instead, the garbage collector runs every so often to find any memory that has no references and then frees it. In other words, instead of freeing immediately after the memory is out of use, memory hangs out for a bit until the garbage collector can determine if it’s truly out of use. During garbage collection, Go has to do a lot of work to determine what memory is free, which can slow the program down.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_15":{"id":"8487af440232_15","__typename":"Paragraph","name":"17f6","text":"These latency spikes definitely smelled like garbage collection performance impact, but we had written the Go code very efficiently and had very few allocations. We were not creating a lot of garbage.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_16":{"id":"8487af440232_16","__typename":"Paragraph","name":"12f3","text":"After digging through the Go source code, we learned that Go will force a garbage collection run every 2 minutes at minimum. In other words, if garbage collection has not run for 2 minutes, regardless of heap growth, go will still force a garbage collection.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":103,"end":123,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fgithub.com\u002Fgolang\u002Fgo\u002Fblob\u002F895b7c85addfffe19b66d8ca71c31799d6e55990\u002Fsrc\u002Fruntime\u002Fproc.go#L4481-L4486","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_17":{"id":"8487af440232_17","__typename":"Paragraph","name":"90c7","text":"We figured we could tune the garbage collector to happen more often in order to prevent large spikes, so we implemented an endpoint on the service to change the garbage collector GC Percent on the fly. Unfortunately, no matter how we configured the GC percent nothing changed. How could that be? It turns out, it was because we were not allocating memory quickly enough for it to force garbage collection to happen more often.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":179,"end":189,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fgolang.org\u002Fpkg\u002Fruntime\u002Fdebug\u002F#SetGCPercent","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_18":{"id":"8487af440232_18","__typename":"Paragraph","name":"32bb","text":"We kept digging and learned the spikes were huge not because of a massive amount of ready-to-free memory, but because the garbage collector needed to scan the entire LRU cache in order to determine if the memory was truly free from references. Thus, we figured a smaller LRU cache would be faster because the garbage collector would have less to scan. So we added another setting to the service to change the size of the LRU cache and changed the architecture to have many partitioned LRU caches per server.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_19":{"id":"8487af440232_19","__typename":"Paragraph","name":"7058","text":"We were right. With the LRU cache smaller, garbage collection resulted in smaller spikes.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_20":{"id":"8487af440232_20","__typename":"Paragraph","name":"1436","text":"Unfortunately, the trade off of making the LRU cache smaller resulted in higher 99th latency times. This is because if the cache is smaller it’s less likely for a user’s Read State to be in the cache. If it’s not in the cache then we have to do a database load.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_21":{"id":"8487af440232_21","__typename":"Paragraph","name":"4327","text":"After a significant amount of load testing different cache capacities, we found a setting that seemed okay. Not completely satisfied, but satisfied enough and with bigger fish to fry, we left the service running like this for quite some time.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_22":{"id":"8487af440232_22","__typename":"Paragraph","name":"293d","text":"During that time we were seeing more and more success with Rust in other parts of Discord and we collectively decided we wanted to create the frameworks and libraries needed to build new services fully in Rust. This service was a great candidate to port to Rust since it was small and self-contained, but we also hoped that Rust would fix these latency spikes. So we took on the task of porting Read States to Rust, hoping to prove out Rust as a service language and improve the user experience.²","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_23":{"id":"8487af440232_23","__typename":"Paragraph","name":"8361","text":"Memory management in Rust","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_24":{"id":"8487af440232_24","__typename":"Paragraph","name":"a209","text":"Rust is blazingly fast and memory-efficient: with no runtime or garbage collector, it can power performance-critical services, run on embedded devices, and easily integrate with other languages.³","type":"BQ","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":45,"end":81,"type":"STRONG","href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_25":{"id":"8487af440232_25","__typename":"Paragraph","name":"c1a6","text":"Rust does not have garbage collection, so we figured it would not have the same latency spikes Go had.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_26":{"id":"8487af440232_26","__typename":"Paragraph","name":"ee23","text":"Rust uses a relatively unique memory management approach that incorporates the idea of memory “ownership”. Basically, Rust keeps track of who can read and write to memory. It knows when the program is using memory and immediately frees the memory once it is no longer needed. It enforces memory rules at compile time, making it virtually impossible to have runtime memory bugs.⁴ You do not need to manually keep track of memory. The compiler takes care of it.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_27":{"id":"8487af440232_27","__typename":"Paragraph","name":"89ce","text":"So in the Rust version of the Read States service, when a user’s Read State is evicted from the LRU cache it is immediately freed from memory. The read state memory does not sit around waiting for the garbage collector to collect it. Rust knows it’s no longer in use and frees it immediately. There is no runtime process to determine if it should be freed.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_28":{"id":"8487af440232_28","__typename":"Paragraph","name":"bd56","text":"Async Rust","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_29":{"id":"8487af440232_29","__typename":"Paragraph","name":"34c2","text":"But there was a problem with the Rust ecosystem. At the time this service was reimplemented, Rust stable did not have a very good story for asynchronous Rust. For a networked service, asynchronous programming is a requirement. There were a few community libraries that enabled asynchronous Rust, but they required a significant amount of ceremony and the error messages were extremely obtuse.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_30":{"id":"8487af440232_30","__typename":"Paragraph","name":"03e2","text":"Fortunately, the Rust team was hard at work on making asynchronous programming easy, and it was available in the unstable nightly channel of Rust.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_31":{"id":"8487af440232_31","__typename":"Paragraph","name":"3def","text":"Discord has never been afraid of embracing new technologies that look promising. For example, we were early adopters of Elixir, React, React Native, and Scylla. If a piece of technology is promising and gives us an advantage, we do not mind dealing with the inherent difficulties and instability of the bleeding edge. This is one of the ways we’ve quickly reached 250+ million users with less than 50 engineers.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_32":{"id":"8487af440232_32","__typename":"Paragraph","name":"c295","text":"Embracing the new async features in Rust nightly is another example of our willingness to embrace new, promising technology. As an engineering team, we decided it was worth using nightly Rust and we committed to running on nightly until async was fully supported on stable. Together we dealt with any problems that arose and at this point Rust stable supports asynchronous Rust.⁵ The bet paid off.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_33":{"id":"8487af440232_33","__typename":"Paragraph","name":"486e","text":"Implementation, load testing, and launch","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_34":{"id":"8487af440232_34","__typename":"Paragraph","name":"dc10","text":"The actual rewrite was fairly straight forward. It started as a rough translation, then we slimmed it down where it made sense. For instance, Rust has a great type system with extensive support for generics, so we could throw out Go code that existed simply due to lack of generics. Also, Rust’s memory model is able to reason about memory safety across threads, so we were able to throw away some of the manual cross-goroutine memory protection that was required in Go.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_35":{"id":"8487af440232_35","__typename":"Paragraph","name":"dd8e","text":"When we started load testing, we were instantly pleased with the results. The latency of the Rust version was just as good as Go’s and had no latency spikes!","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":135,"end":157,"type":"STRONG","href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_36":{"id":"8487af440232_36","__typename":"Paragraph","name":"4259","text":"Remarkably, we had only put very basic thought into optimization as the Rust version was written. Even with just basic optimization, Rust was able to outperform the hyper hand-tuned Go version. This is a huge testament to how easy it is to write efficient programs with Rust compared to the deep dive we had to do with Go.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":98,"end":193,"type":"STRONG","href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_37":{"id":"8487af440232_37","__typename":"Paragraph","name":"09e1","text":"But we weren’t satisfied with simply matching Go’s performance. After a bit of profiling and performance optimizations, we were able to beat Go on every single performance metric. Latency, CPU, and memory were all better in the Rust version.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":120,"end":178,"type":"STRONG","href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_38":{"id":"8487af440232_38","__typename":"Paragraph","name":"b948","text":"The Rust performance optimizations included:","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_39":{"id":"8487af440232_39","__typename":"Paragraph","name":"7c2a","text":"Changing to a BTreeMap instead of a HashMap in the LRU cache to optimize memory usage.","type":"OLI","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_40":{"id":"8487af440232_40","__typename":"Paragraph","name":"ff33","text":"Swapping out the initial metrics library for one that used modern Rust concurrency.","type":"OLI","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_41":{"id":"8487af440232_41","__typename":"Paragraph","name":"5804","text":"Reducing the number of memory copies we were doing.","type":"OLI","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_42":{"id":"8487af440232_42","__typename":"Paragraph","name":"e4e9","text":"Satisfied, we decided to roll out the service.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_43":{"id":"8487af440232_43","__typename":"Paragraph","name":"dfba","text":"The launch was fairly seamless because we load tested. We put it out to a single canary node, found a few edge cases that were missing, and fixed them. Soon after that we rolled it out to the entire fleet.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_44":{"id":"8487af440232_44","__typename":"Paragraph","name":"219d","text":"Below are the results.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_45":{"id":"8487af440232_45","__typename":"Paragraph","name":"1640","text":"Go is purple, Rust is blue.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_46":{"id":"8487af440232_46","__typename":"Paragraph","name":"732f","text":"","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*-q1B4t622mnxoV8kvT9RwA.png"},"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_47":{"id":"8487af440232_47","__typename":"Paragraph","name":"32fd","text":"Raising the cache capacity","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_48":{"id":"8487af440232_48","__typename":"Paragraph","name":"0bed","text":"After the service ran successfully for a few days, we decided it was time to re-raise the LRU cache capacity. In the Go version, as mentioned above, raising the cap of the LRU cache resulted in longer garbage collections. We no longer had to deal with garbage collection, so we figured we could raise the cap of the cache and get even better performance. We increased the memory capacity for the boxes, optimized the data structure to use even less memory (for fun), and increased the cache capacity to 8 million Read States.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_49":{"id":"8487af440232_49","__typename":"Paragraph","name":"5a5b","text":"The results below speak for themselves. Notice the average time is now measured in microseconds and max @mention is measured in milliseconds.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":40,"end":141,"type":"STRONG","href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_50":{"id":"8487af440232_50","__typename":"Paragraph","name":"72c2","text":"","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*DkLOxc-PzkqgXUj_nnOPpA.png"},"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_51":{"id":"8487af440232_51","__typename":"Paragraph","name":"3dcf","text":"Evolving ecosystem","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_52":{"id":"8487af440232_52","__typename":"Paragraph","name":"0c79","text":"Finally, another great thing about Rust is that it has a quickly evolving ecosystem. Recently, tokio (the async runtime we use) released version 0.2. We upgraded and it gave us CPU benefits for free. Below you can see the CPU is consistently lower starting around the 16th.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_53":{"id":"8487af440232_53","__typename":"Paragraph","name":"f16a","text":"","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*eT1PAnwaAcfCUikJ281v2g.png"},"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_54":{"id":"8487af440232_54","__typename":"Paragraph","name":"4f7e","text":"Closing thoughts","type":"H3","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_55":{"id":"8487af440232_55","__typename":"Paragraph","name":"70a9","text":"At this point, Discord is using Rust in many places across its software stack. We use it for the game SDK, video capturing and encoding for Go Live, Elixir NIFs, several backend services, and more.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":149,"end":160,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fblog.discordapp.com\u002Fusing-rust-to-scale-elixir-for-11-million-concurrent-users-c6f19fc029d3","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_56":{"id":"8487af440232_56","__typename":"Paragraph","name":"e70a","text":"When starting a new project or software component, we consider using Rust. Of course, we only use it where it makes sense.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_57":{"id":"8487af440232_57","__typename":"Paragraph","name":"68cc","text":"Along with performance, Rust has many advantages for an engineering team. For example, its type safety and borrow checker make it very easy to refactor code as product requirements change or new learnings about the language are discovered. Also, the ecosystem and tooling are excellent and have a significant amount of momentum behind them.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_58":{"id":"8487af440232_58","__typename":"Paragraph","name":"e723","text":"If you made it this far, you’re probably newly excited about Rust or have been excited for quite some time. If you want to work on interesting problems using Rust professionally, you should consider working here at Discord.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_59":{"id":"8487af440232_59","__typename":"Paragraph","name":"4e47","text":"Also, a fun fact: the Rust team uses Discord to coordinate. There’s even a very helpful Rust community server that you can find us chatting in from time to time. Click here to check it out.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":162,"end":189,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fdiscord.gg\u002FtcbkpyQ","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_60":{"id":"8487af440232_60","__typename":"Paragraph","name":"b879","text":"[1] Go version 1.9.2. Edit: Graphs are from 1.9.2. We tried versions 1.8, 1.9, and 1.10 without any improvement. The initial port from Go to Rust was completed in May 2019.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_61":{"id":"8487af440232_61","__typename":"Paragraph","name":"fe69","text":"[2] To be clear, we don’t think you should rewrite everything in rust just because.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[],"dropCapImage":null},"Paragraph:8487af440232_62":{"id":"8487af440232_62","__typename":"Paragraph","name":"5f9b","text":"[3] Quote from https:\u002F\u002Fwww.rust-lang.org\u002F","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":15,"end":41,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fwww.rust-lang.org\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_63":{"id":"8487af440232_63","__typename":"Paragraph","name":"7b31","text":"[4] Unless, of course, you use unsafe.","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":31,"end":37,"type":"STRONG","href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"dropCapImage":null},"Paragraph:8487af440232_64":{"id":"8487af440232_64","__typename":"Paragraph","name":"d511","text":"[5] https:\u002F\u002Fareweasyncyet.rs\u002F","type":"P","href":null,"layout":null,"metadata":null,"hasDropCap":null,"iframe":null,"mixtapeMetadata":null,"markups":[{"__typename":"Markup","start":4,"end":29,"type":"A","href":"https:\u002F\u002Fweb.archive.org\u002Fweb\u002F20210202161739\u002Fhttps:\u002F\u002Fareweasyncyet.rs\u002F","anchorType":"LINK","userId":null,"linkMetadata":null}],"dropCapImage":null},"ImageMetadata:1*BYeVEgTVQia4MD5LSLoUlA.png":{"id":"1*BYeVEgTVQia4MD5LSLoUlA.png","__typename":"ImageMetadata","originalHeight":921,"originalWidth":1637,"focusPercentX":null,"focusPercentY":null,"alt":null},"ImageMetadata:1*3v779KSfo2OkxUPfPptq_Q.png":{"id":"1*3v779KSfo2OkxUPfPptq_Q.png","__typename":"ImageMetadata","originalHeight":427,"originalWidth":1067,"focusPercentX":null,"focusPercentY":null,"alt":null},"ImageMetadata:1*-q1B4t622mnxoV8kvT9RwA.png":{"id":"1*-q1B4t622mnxoV8kvT9RwA.png","__typename":"ImageMetadata","originalHeight":430,"originalWidth":1071,"focusPercentX":null,"focusPercentY":null,"alt":null},"ImageMetadata:1*DkLOxc-PzkqgXUj_nnOPpA.pn