{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0080/receipt.schema.json",
  "title": "TST-0080 stale-cache receipt (unit-local executable contract)",
  "$comment": "Catalog output_schema command-center/schema/fault-injection-receipt.schema.json is a generated $ref shim to ast-integrate.invalid; jsonschema 4.x on this host tries the network and raises. This file is the executable Draft-07 contract emit_receipt.py validates against. It does not fetch that $ref. G-1 still binds the catalog path as the on-disk artifact.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "fixed_package_observed_after_reinstall",
    "cache_key_changes_on_any_shipped_byte",
    "explicit_invalidation_works",
    "cache_key_derivation",
    "collision_attempt",
    "detector_control",
    "name_version_mutant",
    "named_probes",
    "tests"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0080" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS"]
    },
    "sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "^SUCCESS:TST-0080"
    },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:TST-0080" },
    "fixed_package_observed_after_reinstall": { "type": "boolean", "const": true },
    "cache_key_changes_on_any_shipped_byte": { "type": "boolean", "const": true },
    "explicit_invalidation_works": { "type": "boolean", "const": true },
    "cache_key_derivation": {
      "type": "object",
      "required": ["file", "line", "quote", "symbol"],
      "properties": {
        "file": { "type": "string", "minLength": 8 },
        "line": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 16 },
        "symbol": { "type": "string", "pattern": "derive_cache_key" }
      }
    },
    "collision_attempt": {
      "type": "object",
      "required": [
        "omitted_hash_collided",
        "sound_keys_differ",
        "two_materially_different_packages_share_one_sound_key"
      ],
      "properties": {
        "omitted_hash_collided": { "type": "boolean", "const": true },
        "sound_keys_differ": { "type": "boolean", "const": true },
        "two_materially_different_packages_share_one_sound_key": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "detector_control": {
      "type": "object",
      "required": ["fired"],
      "properties": {
        "fired": { "type": "boolean", "const": true }
      }
    },
    "name_version_mutant": {
      "type": "object",
      "required": ["masked_by_stale_cache"],
      "properties": {
        "masked_by_stale_cache": { "type": "boolean", "const": true }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2
    },
    "tests": {
      "type": "array",
      "minItems": 3
    }
  }
}
