{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0126/note.schema.json",
  "title": "CNL-0126 cross-vendor adapter design note",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "answers",
    "claims",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "evidence",
    "fixture_scores",
    "measurement",
    "both_states",
    "measured_lpi"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0126" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0126" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "minProperties": 3,
      "required": ["what_breaks", "degradation_record", "substitution_rule"],
      "properties": {
        "what_breaks": { "type": "string", "minLength": 16 },
        "degradation_record": { "type": "string", "minLength": 16 },
        "substitution_rule": { "type": "string", "minLength": 16 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "ERROR", "SKIP", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["id"] }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "fixture_scores": {
      "type": "object",
      "required": ["capable", "tool_access", "context_length", "structured_output"],
      "properties": {
        "capable": { "type": "object" },
        "tool_access": { "type": "object" },
        "context_length": { "type": "object" },
        "structured_output": { "type": "object" }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["coverage_alone_insufficient", "threshold_reject_below"],
      "properties": {
        "coverage_alone_insufficient": { "type": "boolean", "const": true },
        "threshold_reject_below": { "type": "number", "const": 1.0 }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["verbatim_bad", "verbatim_good", "verbatim_gap", "verbatim_discard"],
      "properties": {
        "verbatim_bad": { "type": "string", "minLength": 8 },
        "verbatim_good": { "type": "string", "minLength": 8 },
        "verbatim_gap": { "type": "string", "minLength": 8 },
        "verbatim_discard": { "type": "string", "minLength": 8 }
      }
    },
    "measured_lpi": { "type": "number", "minimum": 1.0, "maximum": 1.0 }
  }
}
