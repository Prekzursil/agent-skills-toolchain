 /><link rel="alternate" href="https://docs.aws.amazon.com/step-functions/latest/dg/tutorial-continue-new.html" hreflang="en" /><link rel="alternate" href="https://docs.aws.amazon.com/es_es/step-functions/latest/dg/tutorial-continue-new.html" hreflang="es-es" /><link rel="alternate" href="https://docs.aws.amazon.com/es_es/step-functions/latest/dg/tutorial-continue-new.html" hreflang="es" /><link rel="alternate" href="https://docs.aws.amazon.com/fr_fr/step-functions/latest/dg/tutorial-continue-new.html" hreflang="fr-fr" /><link rel="alternate" href="https://docs.aws.amazon.com/fr_fr/step-functions/latest/dg/tutorial-continue-new.html" hreflang="fr" /><link rel="alternate" href="https://docs.aws.amazon.com/it_it/step-functions/latest/dg/tutorial-continue-new.html" hreflang="it-it" /><link rel="alternate" href="https://docs.aws.amazon.com/it_it/step-functions/latest/dg/tutorial-continue-new.html" hreflang="it" /><link rel="alternate" href="https://docs.aws.amazon.com/ja_jp/step-functions/latest/dg/tutorial-continue-new.html" hreflang="ja-jp" /><link rel="alternate" href="https://docs.aws.amazon.com/ja_jp/step-functions/latest/dg/tutorial-continue-new.html" hreflang="ja" /><link rel="alternate" href="https://docs.aws.amazon.com/ko_kr/step-functions/latest/dg/tutorial-continue-new.html" hreflang="ko-kr" /><link rel="alternate" href="https://docs.aws.amazon.com/ko_kr/step-functions/latest/dg/tutorial-continue-new.html" hreflang="ko" /><link rel="alternate" href="https://docs.aws.amazon.com/pt_br/step-functions/latest/dg/tutorial-continue-new.html" hreflang="pt-br" /><link rel="alternate" href="https://docs.aws.amazon.com/pt_br/step-functions/latest/dg/tutorial-continue-new.html" hreflang="pt" /><link rel="alternate" href="https://docs.aws.amazon.com/zh_cn/step-functions/latest/dg/tutorial-continue-new.html" hreflang="zh-cn" /><link rel="alternate" href="https://docs.aws.amazon.com/zh_tw/step-functions/latest/dg/tutorial-continue-new.html" hreflang="zh-tw" /><link rel="alternate" href="https://docs.aws.amazon.com/step-functions/latest/dg/tutorial-continue-new.html" hreflang="x-default" /><meta name="feedback-item" content="Step Functions" /><meta name="this_doc_product" content="AWS Step Functions" /><meta name="this_doc_guide" content="Developer Guide" /><head xmlns="http://www.w3.org/1999/xhtml"> <script defer="" src="/assets/r/awsdocs-doc-page.2.0.0.js"></script><link href="/assets/r/awsdocs-doc-page.2.0.0.css" rel="stylesheet"/></head>
<script defer="" id="awsc-panorama-bundle" type="text/javascript" src="https://prod.pa.cdn.uis.awsstatic.com/panorama-nav-init.js" data-config="{'appEntity':'aws-documentation','region':'us-east-1','service':'step-functions'}"></script><meta id="panorama-serviceSubSection" value="Developer Guide" /><meta id="panorama-serviceConsolePage" value="Continue long-running workflows using Step Functions API (recommended)" /></head><body class="awsdocs awsui"><div class="awsdocs-container"><p><a href="tutorial-continue-new.md">View a markdown version of this page</a></p><awsdocs-header></awsdocs-header><awsui-app-layout id="app-layout" class="awsui-util-no-gutters" ng-controller="ContentController as $ctrl" header-selector="awsdocs-header" navigation-hide="false" navigation-width="$ctrl.navWidth" navigation-open="$ctrl.navOpen" navigation-change="$ctrl.onNavChange($event)" tools-hide="$ctrl.hideTools" tools-width="$ctrl.toolsWidth" tools-open="$ctrl.toolsOpen" tools-change="$ctrl.onToolsChange($event)"><div id="guide-toc" dom-region="navigation"><awsdocs-toc></awsdocs-toc></div><div id="main-column" dom-region="content" tabindex="-1"><awsdocs-view class="awsdocs-view"><div id="awsdocs-content"><head><title>Continue long-running workflows using Step Functions API (recommended) - AWS Step Functions</title><meta name="pdf" content="/pdfs/step-functions/latest/dg/step-functions-dg.pdf#tutorial-continue-new" /><meta name="rss" content="recent-updates.rss" /><meta name="forums" content="https://repost.aws/tags/TAcY-U_PLNSpyRRpAaT3B35A" /><meta name="feedback" content="https://docs.aws.amazon.com/forms/aws-doc-feedback?hidden_service_name=Step%20Functions&amp;topic_url=https://docs.aws.amazon.com/en_us/step-functions/latest/dg/tutorial-continue-new.html" /><meta name="feedback-yes" content="feedbackyes.html?topic_url=https://docs.aws.amazon.com/en_us/step-functions/latest/dg/tutorial-continue-new.html" /><meta name="feedback-no" content="feedbackno.html?topic_url=https://docs.aws.amazon.com/en_us/step-functions/latest/dg/tutorial-continue-new.html" /><meta name="keywords" content="Step Functions,Workflow,state machine,visual workflow,microservices,service orchestration,state machine tutorials,step functions tutorials,workflow tutorials" /><link rel="alternate" type="text/markdown" href="tutorial-continue-new.md" title="Markdown version" /><script type="application/ld+json">
{
