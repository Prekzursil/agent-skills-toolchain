<span class="devsite-syntax-w">          </span><span class="devsite-syntax-p">{</span>
<span class="devsite-syntax-w">            </span><span class="devsite-syntax-nt">"skipFrenchTranslation"</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-p">{</span>
<span class="devsite-syntax-w">              </span><span class="devsite-syntax-nt">"assign"</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-p">[</span>
<span class="devsite-syntax-w">                </span><span class="devsite-syntax-p">{</span>
<span class="devsite-syntax-w">                  </span><span class="devsite-syntax-nt">"translated"</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-s2">"${text}"</span>
<span class="devsite-syntax-w">                </span><span class="devsite-syntax-p">}</span>
