<span class="devsite-syntax-w">                  </span><span class="devsite-syntax-nt">"translated"</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-s2">"${translation.data.translations[0].translatedText}"</span>
<span class="devsite-syntax-w">                </span><span class="devsite-syntax-p">}</span>
<span class="devsite-syntax-w">              </span><span class="devsite-syntax-p">],</span>
<span class="devsite-syntax-w">              </span><span class="devsite-syntax-nt">"next"</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-s2">"print"</span>
<span class="devsite-syntax-w">            </span><span class="devsite-syntax-p">}</span>
