  <div></div><devsite-code><pre suppresswarning="suppresswarning" translate="no" class="devsite-click-to-copy" track-metadata-position="GoogleCloudPlatform/workflows-samples/src/loop_scope.workflows.json/main/" data-code-snippet="true" data-github-includecode-link="https://github.com/GoogleCloudPlatform/workflows-samples/blob/main/src/loop_scope.workflows.json" track-metadata-snippet-file-url="https://github.com/GoogleCloudPlatform/workflows-samples/blob/main/src/loop_scope.workflows.json" feedback-context="{&#34;language&#34;: &#34;json&#34;, &#34;region_tag&#34;: &#34;workflows_loop_scope&#34;, &#34;snippet_file_url&#34;: &#34;https://github.com/GoogleCloudPlatform/workflows-samples/blob/main/src/loop_scope.workflows.json&#34;}" feedback-product="1634365" feedback-bucket="serverless" language="json" data-github-path="GoogleCloudPlatform/workflows-samples/src/loop_scope.workflows.json" data-git-revision="main" dir="ltr" is-upgraded syntax="JSON"><code translate="no" dir="ltr"><span class="devsite-syntax-p">[</span>
