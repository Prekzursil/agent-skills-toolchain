{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0110/fusion-result.schema.json",
  "title": "FusionResult (WFA-0110 unit-local $def; WFA-0001 pack absent)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "kind",
    "unit_id",
    "id",
    "state",
    "status",
    "sentinel",
    "completion_sentinel",
    "title",
    "output_path",
    "output_schema",
    "schema_gate",
    "operators",
    "fusions",
    "lineage_validation",
    "rollback_rehearsals",
    "licence_inheritance",
    "credit_survival",
    "decomposition_match",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "implementation",
    "notes"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "FusionResult" },
    "kind": { "type": "string", "const": "FusionResult" },
    "unit_id": { "type": "string", "const": "WFA-0110" },
    "id": { "type": "string", "const": "WFA-0110" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "status": { "type": "string", "enum": ["DELIVERED"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0110" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0110" },
    "title": { "type": "string", "minLength": 16 },
    "output_path": { "type": "string", "minLength": 8 },
    "output_schema": { "type": "string", "minLength": 8 },
    "schema_gate": { "type": "object" },
    "premise": { "type": "object" },
    "operators": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "fusions": { "type": "array", "minItems": 7 },
    "lineage_validation": { "type": "object" },
    "rollback_rehearsals": { "type": "object" },
    "licence_inheritance": { "type": "object" },
    "credit_survival": { "type": "object" },
    "decomposition_match": { "type": "object" },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "implementation": { "type": "object" },
    "manifest_registration": { "type": "object" },
    "timestamps": { "type": "object" },
    "notes": { "type": "string", "minLength": 12 },
    "profile": { "type": "string" },
    "produced_by": { "type": "object" },
    "min_bytes_threshold": { "type": "integer" },
    "spec_anchor": { "type": "string" }
  }
}
