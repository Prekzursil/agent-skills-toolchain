{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0074/design-note.schema.json",
  "title": "CNL-0074 confidence-trajectory design note",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "per_round_record",
    "resolution_source_taxonomy",
    "scoring_semantics",
    "fixture_tabulation",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "residual_unknowns"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0074" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0074" },
    "question": { "type": "string", "minLength": 40 },
    "answer": {
      "type": "object",
      "required": ["what_is_recorded_per_round", "what_settles_correctness"],
      "properties": {
        "what_is_recorded_per_round": { "type": "string", "minLength": 40 },
        "what_settles_correctness": { "type": "string", "minLength": 40 }
      }
    },
    "per_round_record": { "type": "object" },
    "resolution_source_taxonomy": { "type": "object" },
    "scoring_semantics": { "type": "object" },
    "fixture_tabulation": {
      "type": "object",
      "required": ["deferred_scoreable", "unscoreable", "pending", "mismatch_source"],
      "properties": {
        "deferred_scoreable": { "type": "object" },
        "unscoreable": { "type": "object" },
        "pending": { "type": "object" },
        "mismatch_source": { "type": "object" }
      }
    },
    "tests": { "type": "array", "minItems": 3 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "residual_unknowns": { "type": "array" }
  }
}
