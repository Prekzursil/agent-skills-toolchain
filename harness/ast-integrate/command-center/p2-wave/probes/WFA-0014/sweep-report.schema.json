{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WFA-0014 SweepReport (branch workflow uniqueness)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "report_kind",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "answer",
    "output_schema",
    "declared_schema_on_disk",
    "validated_against",
    "ts",
    "signals",
    "path_rule",
    "live",
    "controls",
    "hits",
    "branch_summaries",
    "deletion_recommendations",
    "discovery_only",
    "tests",
    "reviewer",
    "artifacts",
    "confirmations",
    "honesty",
    "inputs_on_disk"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0014" },
    "report_kind": { "type": "string", "const": "SweepReport" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0014" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0014" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "output_schema": { "type": "string" },
    "declared_schema_on_disk": { "type": "boolean" },
    "validated_against": { "type": "string" },
    "ts": { "type": "string", "minLength": 20 },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "type": "string", "minLength": 20 },
        "B": { "type": "string", "minLength": 20 }
      }
    },
    "path_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefixes", "never_reads_working_tree", "blob_reader"],
      "properties": {
        "prefixes": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "never_reads_working_tree": { "type": "boolean", "const": true },
        "blob_reader": { "type": "string", "const": "git cat-file -p" }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "present",
        "reason",
        "main_ref",
        "remote_ref_count",
        "branch_count",
        "unique_content_total",
        "any_deletion_recommended"
      ],
      "properties": {
        "present": { "type": "boolean" },
        "reason": { "type": "string" },
        "main_ref": { "type": ["string", "null"] },
        "remote_ref_count": { "type": "integer", "minimum": 0 },
        "branch_count": { "type": "integer", "minimum": 0 },
        "unique_content_total": { "type": "integer", "minimum": 0 },
        "any_deletion_recommended": { "type": "boolean", "const": false },
        "truncated": { "type": "boolean" },
        "branches_with_unique_content": {
          "type": "array",
          "items": { "type": "string" }
        },
        "branches": { "type": "array" },
        "hits": { "type": "array" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "squash_ahead",
        "unique",
        "additions_only",
        "large_modifications",
        "superseded_rename"
      ],
      "properties": {
        "squash_ahead": { "$ref": "#/definitions/branch_row" },
        "unique": { "$ref": "#/definitions/branch_row" },
        "additions_only": { "$ref": "#/definitions/branch_row" },
        "large_modifications": { "$ref": "#/definitions/branch_row" },
        "superseded_rename": { "$ref": "#/definitions/branch_row" }
      }
    },
    "hits": {
      "type": "array",
      "items": { "$ref": "#/definitions/hit" }
    },
    "branch_summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/branch_row" }
    },
    "deletion_recommendations": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "discovery_only": { "type": "boolean", "const": true },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true },
        "scope_not_agreement": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "confirmations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "verdict",
          "source_probe",
          "verifier_probe"
        ],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 16 },
          "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED"] },
          "source_probe": { "type": "string", "minLength": 8 },
          "verifier_probe": { "type": "string", "minLength": 8 }
        }
      }
    },
    "honesty": {
      "type": "object",
      "additionalProperties": true,
      "required": ["unit_success_means", "unit_success_does_not_mean"],
      "properties": {
        "unit_success_means": { "type": "string", "minLength": 20 },
        "unit_success_does_not_mean": { "type": "string", "minLength": 20 }
      }
    },
    "inputs_on_disk": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "path",
        "classification",
        "signal_a",
        "signal_b_same_path_equal",
        "signal_b_elsewhere_paths",
        "conflict_role",
        "deletion_recommended"
      ],
      "properties": {
        "branch": { "type": "string" },
        "path": { "type": "string" },
        "classification": {
          "type": "string",
          "enum": [
            "GENUINELY-UNIQUE",
            "IDENTICAL-TO-MAIN",
            "SUPERSEDED-DIFFERENT-NAME"
          ]
        },
        "signal_a": { "type": "boolean" },
        "signal_b_same_path_equal": { "type": "boolean" },
        "signal_b_elsewhere_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conflict_role": { "type": "string" },
        "deletion_recommended": { "type": "boolean", "const": false },
        "blob_sha256": { "type": "string" },
        "bytes": { "type": "integer" }
      }
    },
    "branch_row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "branch",
        "ancestry_ahead",
        "ahead_commit_count",
        "signal_a_path_count",
        "unique_content_count",
        "conflict_surface",
        "deletion_recommended",
        "discovery_only"
      ],
      "properties": {
        "branch": { "type": "string" },
        "ref": { "type": "string" },
        "ancestry_ahead": { "type": "boolean" },
        "ahead_commit_count": { "type": "integer", "minimum": 0 },
        "signal_a_path_count": { "type": "integer", "minimum": 0 },
        "signal_a_paths": { "type": "array", "items": { "type": "string" } },
        "two_tree_path_count": { "type": "integer" },
        "unique_content_count": { "type": "integer", "minimum": 0 },
        "superseded_count": { "type": "integer" },
        "identical_to_main_count": { "type": "integer" },
        "added_count": { "type": "integer" },
        "modified_count": { "type": "integer" },
        "conflict_surface": {
          "type": "string",
          "enum": ["LARGE", "SMALL", "ADDITIONS-ONLY", "NONE"]
        },
        "deletion_recommended": { "type": "boolean", "const": false },
        "discovery_only": { "type": "boolean", "const": true },
        "hits": { "type": "array" },
        "unique_hits": { "type": "array" },
        "superseded_hits": { "type": "array" }
      }
    }
  }
}
