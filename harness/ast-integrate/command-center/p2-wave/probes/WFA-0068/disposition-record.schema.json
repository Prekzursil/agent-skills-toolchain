{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0068/disposition-record.schema.json",
  "title": "WFA-0068 DispositionRecord (decision procedure)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "vocabulary",
    "tie_break_order",
    "required_inputs",
    "criteria",
    "gold_set",
    "per_disposition_agreement",
    "agreement_floor",
    "independent_replay",
    "refusal_path",
    "tests",
    "reviewer",
    "evidence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0068" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "vocabulary": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "type": "string", "minLength": 5 }
    },
    "tie_break_order": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "type": "string", "minLength": 5 }
    },
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "criteria": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "required": ["value", "rank", "criterion", "falsifier"],
        "properties": {
          "value": { "type": "string" },
          "rank": { "type": "integer", "minimum": 0 },
          "criterion": { "type": "string", "minLength": 8 },
          "falsifier": { "type": "string", "minLength": 8 }
        }
      }
    },
    "gold_set": { "type": "object" },
    "per_disposition_agreement": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15
    },
    "agreement_floor": { "type": "number", "minimum": 0, "maximum": 1 },
    "independent_replay": { "type": "object" },
    "refusal_path": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "evidence": { "type": "array", "minItems": 3 }
  }
}
