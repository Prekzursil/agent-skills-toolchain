{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/CNL-0105/preset.record.schema.json",
  "title": "CNL-0105 working typed-delta council preset (20 keys)",
  "description": "Working schema for this unit's affected preset records. command-center/schema/council-preset.schema.json is a generated $ref shim with no $defs.preset, so records are validated here. This does not claim to be a byte copy of the absent 12-COUNCIL library type.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "family",
    "base_spec",
    "base_spec_version",
    "delta",
    "default_binding",
    "editable_dials",
    "protocol_bindings",
    "roles",
    "voting",
    "stopping",
    "anonymity",
    "recruitment",
    "rebuttal",
    "evidence",
    "integrity",
    "outcomes",
    "budgets",
    "meta"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 8, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$" },
    "name": { "type": "string", "minLength": 8 },
    "family": { "type": "string", "minLength": 4 },
    "base_spec": { "type": "string", "minLength": 4 },
    "base_spec_version": { "type": "string", "minLength": 1 },
    "delta": {
      "type": "object",
      "minProperties": 11,
      "required": [
        "protocol_bindings",
        "roles",
        "voting",
        "stopping",
        "anonymity",
        "recruitment",
        "rebuttal",
        "evidence",
        "integrity",
        "outcomes",
        "budgets"
      ],
      "properties": {
        "protocol_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "template", "votes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "minLength": 2 },
              "votes": { "type": "boolean" },
              "recruited": { "type": "boolean" },
              "conditional": { "type": "boolean" }
            }
          }
        },
        "voting": { "type": "object" },
        "stopping": { "type": "object" },
        "anonymity": { "type": "object" },
        "recruitment": { "type": "object" },
        "rebuttal": { "type": "object" },
        "evidence": { "type": "object" },
        "integrity": { "type": "object" },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "budgets": { "type": "object" }
      }
    },
    "default_binding": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "string", "minLength": 2 },
        "family": { "type": "string" }
      }
    },
    "editable_dials": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "protocol_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "template", "votes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "template": { "type": "string", "minLength": 2 },
          "votes": { "type": "boolean" },
          "recruited": { "type": "boolean" },
          "conditional": { "type": "boolean" }
        }
      }
    },
    "voting": {
      "type": "object",
      "required": ["method", "quorum"],
      "properties": {
        "method": { "type": "string", "minLength": 4 },
        "quorum": { "type": "integer", "minimum": 0 }
      }
    },
    "stopping": {
      "type": "object",
      "required": ["expression", "max_rounds"],
      "properties": {
        "expression": { "type": "string", "minLength": 8 },
        "max_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "anonymity": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "minLength": 3 },
        "lift_phase": { "type": "string" },
        "vote_attribution": { "type": "string" }
      }
    },
    "recruitment": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "minLength": 4 },
        "min_reviewers": { "type": "integer", "minimum": 0 },
        "coi_screen": { "type": "boolean" },
        "prefer_distinct_vendors": { "type": "boolean" }
      }
    },
    "rebuttal": {
      "type": "object",
      "required": ["max_rounds", "depth", "author_seat"],
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 0 },
        "depth": { "type": "integer", "minimum": 0 },
        "author_seat": { "type": "boolean" },
        "obligation": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["tier"],
      "properties": {
        "tier": { "type": "string", "minLength": 3 },
        "rubric_source": { "type": "string" }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["two_reviewer_capture", "seal_first_round"],
      "properties": {
        "two_reviewer_capture": { "type": "boolean" },
        "coi_screen": { "type": "boolean" },
        "seal_first_round": { "type": "boolean" },
        "rationale_jaccard_fire_at": { "type": "number" },
        "sybil_same_prompt_hash": { "type": "boolean" }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "budgets": {
      "type": "object",
      "required": ["turns"],
      "properties": {
        "turns": { "type": "integer", "minimum": 1 },
        "rebuttal_depth": { "type": "integer", "minimum": 0 }
      }
    },
    "meta": { "type": "object", "minProperties": 1 }
  }
}
