{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/CNL-0105/envelope.schema.json",
  "title": "CNL-0105 design artifact envelope",
  "description": "Local envelope for the catalog output_path JSON. The catalog council-preset.schema.json is a generated generic_report $ref shim const-locked on report.kind; this unit does not rewrite that shared file.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "schema_version",
    "title",
    "question",
    "preset",
    "sibling_map",
    "instantiation",
    "differential",
    "capture",
    "schema_validation",
    "negative_control",
    "tests",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0105" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0105" },
    "schema_version": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 16 },
    "preset": { "type": "object", "minProperties": 1 },
    "sibling_map": {
      "type": "object",
      "required": ["nearest_sibling"],
      "properties": {
        "nearest_sibling": {
          "type": "object",
          "required": ["id", "named_explicitly"],
          "properties": {
            "id": { "type": "string", "minLength": 4 },
            "named_explicitly": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "instantiation": {
      "type": "object",
      "required": ["task_id", "profile"],
      "properties": {
        "task_id": { "type": "string", "minLength": 4 },
        "profile": {
          "type": "object",
          "required": [
            "roster",
            "protocol_schedule",
            "voting_method",
            "stopping_expression"
          ]
        }
      }
    },
    "differential": {
      "type": "object",
      "required": ["distance", "differing_axes", "measurable"],
      "properties": {
        "distance": { "type": "integer", "minimum": 3 },
        "differing_axes": { "type": "array", "minItems": 3 },
        "measurable": { "type": "boolean", "const": true }
      }
    },
    "capture": {
      "type": "object",
      "required": ["planted_bad", "known_good_split"],
      "properties": {
        "planted_bad": {
          "type": "object",
          "required": ["fire"],
          "properties": { "fire": { "type": "boolean", "const": true } }
        },
        "known_good_split": {
          "type": "object",
          "required": ["fire"],
          "properties": { "fire": { "type": "boolean", "const": false } }
        }
      }
    },
    "schema_validation": {
      "type": "object",
      "required": ["affected_error_count", "deliberately_invalid"],
      "properties": {
        "affected_error_count": { "type": "integer", "const": 0 },
        "deliberately_invalid": {
          "type": "object",
          "required": ["error_count", "proves_validator_not_vacuous"],
          "properties": {
            "error_count": { "type": "integer", "minimum": 1 },
            "proves_validator_not_vacuous": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["verbatim"],
      "properties": {
        "verbatim": { "type": "string", "minLength": 40 }
      }
    },
    "tests": { "type": "array", "minItems": 4 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 4 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    }
  }
}
