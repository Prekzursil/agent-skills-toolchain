{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://ast-integrate.invalid/wfa-0146/routing-function.schema.json",
  "title": "WFA-0146 routing-function artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "routes",
    "thresholds",
    "repair_vs_build",
    "confusion_matrix",
    "holdout",
    "evaluation_rows",
    "constant_function_control",
    "evidence",
    "honesty"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0146" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "pattern": "SUCCESS:WFA-0146" },
    "routes": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "thresholds": { "type": "object", "minProperties": 4 },
    "repair_vs_build": { "type": "object", "required": ["deciding_features", "rule"] },
    "confusion_matrix": {
      "type": "object",
      "required": ["n", "counts", "predicted_routes", "human_classes"]
    },
    "holdout": {
      "type": "object",
      "required": ["holdout_agreement", "train_agreement", "overfit", "n_train", "n_holdout"]
    },
    "evaluation_rows": { "type": "array", "minItems": 284 },
    "constant_function_control": { "type": "object", "required": ["pass"] },
    "evidence": { "type": "array", "minItems": 2 },
    "honesty": {
      "type": "object",
      "required": ["does_not_claim_windows_path_per_id_disagreement"]
    }
  }
}
