{
  "schema_version": 1,
  "note": "Fallback P0/P1 census used when command-center/receipts/CNF-0140.json and command-center/CLAIM-REGISTRY.json are absent. Claims are mechanically checkable facts about this worktree, bundled as self-contained inputs at package authoring time.",
  "claims": [
    {
      "claim_id": "CLAIM-P0-001",
      "severity": "P0",
      "statement": "Catalog work unit CNF-0182 has id CNF-0182 and completion_sentinel SUCCESS:CNF-0182.",
      "check_type": "json_field_equals",
      "source_rel": "command-center/WORK-UNIT-CATALOG.json",
      "extract": "work_unit:CNF-0182",
      "expect": {
        "id": "CNF-0182",
        "completion_sentinel": "SUCCESS:CNF-0182"
      },
      "runtime_inject": ["CNF0182_REPL_TOKEN"],
      "confirmation_record": "NOT-CHECKED"
    },
    {
      "claim_id": "CLAIM-P0-002",
      "severity": "P0",
      "statement": "The G-1 measure script prints SUCCESS:delivered when the per-unit contract holds.",
      "check_type": "text_contains",
      "source_rel": "command-center/p2-wave/_measure_one_delivered.py",
      "extract": "file_text",
      "expect": {
        "needle": "SUCCESS:delivered"
      },
      "runtime_inject": [],
      "confirmation_record": "NOT-CHECKED"
    },
    {
      "claim_id": "CLAIM-P1-001",
      "severity": "P1",
      "statement": "command-center/schema/architecture-dossier.schema.json is the architecture-dossier artifact-class shim.",
      "check_type": "json_field_equals",
      "source_rel": "command-center/schema/architecture-dossier.schema.json",
      "extract": "json_root",
      "expect": {
        "x-artifact-class": "architecture-dossier",
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "runtime_inject": [],
      "confirmation_record": "NOT-CHECKED"
    },
    {
      "claim_id": "CLAIM-P1-002",
      "severity": "P1",
      "statement": "CNF-0182 output_path is command-center/receipts/CNF-0182.json and output_schema is command-center/schema/replication-package.schema.json.",
      "check_type": "json_field_equals",
      "source_rel": "command-center/WORK-UNIT-CATALOG.json",
      "extract": "work_unit:CNF-0182",
      "expect": {
        "output_path": "command-center/receipts/CNF-0182.json",
        "output_schema": "command-center/schema/replication-package.schema.json"
      },
      "runtime_inject": [],
      "confirmation_record": "NOT-CHECKED"
    }
  ]
}
