{
 "$id": "command-center/schema/architecture-dossier.schema.json",
 "$schema": "http://json-schema.org/draft-07/schema#",
 "additionalProperties": true,
 "properties": {
  "architecture_id": {
   "minLength": 2,
   "type": "string"
  },
  "artifacts": {
   "items": {
    "properties": {
     "exists": {
      "const": true,
      "type": "boolean"
     },
     "path": {
      "type": "string"
     },
     "role": {
      "type": "string"
     }
    },
    "required": [
     "path",
     "exists",
     "role"
    ],
    "type": "object"
   },
   "minItems": 1,
   "type": "array"
  },
  "evidence": {
   "items": {
    "properties": {
     "anchor": {
      "minLength": 3,
      "type": "string"
     },
     "claim": {
      "minLength": 8,
      "type": "string"
     },
     "verdict": {
      "enum": [
       "CONFIRMED",
       "REFUTED",
       "PARTIAL",
       "NOT-CHECKED",
       "BLOCKED"
      ],
      "type": "string"
     }
    },
    "required": [
     "claim",
     "verdict",
     "anchor"
    ],
    "type": "object"
   },
   "minItems": 2,
   "type": "array"
  },
  "expressibility": {
   "properties": {
    "catalogue_claim": {
     "minLength": 8,
     "type": "string"
    },
    "first_non_expressible_construct": {
     "minLength": 8,
     "type": "string"
    },
    "libraries_on_this_tree": {
     "type": "object"
    },
    "stopped_at_first_inexpressible": {
     "type": "boolean"
    }
   },
   "required": [
    "catalogue_claim",
    "first_non_expressible_construct",
    "stopped_at_first_inexpressible",
    "libraries_on_this_tree"
   ],
   "type": "object"
  },
  "file_set": {
   "items": {
    "properties": {
     "path": {
      "minLength": 3,
      "type": "string"
     },
     "role": {
      "minLength": 3,
      "type": "string"
     }
    },
    "required": [
     "path",
     "role"
    ],
    "type": "object"
   },
   "minItems": 3,
   "type": "array"
  },
  "load_order": {
   "items": {
    "properties": {
     "order": {
      "minimum": 1,
      "type": "integer"
     },
     "path": {
      "minLength": 3,
      "type": "string"
     }
    },
    "required": [
     "order",
     "path"
    ],
    "type": "object"
   },
   "minItems": 3,
   "type": "array"
  },
  "negative_controls": {
   "items": {
    "type": "object"
   },
   "minItems": 1,
   "type": "array"
  },
  "precedence": {
   "properties": {
    "duplicate_in_one_file": {
     "minLength": 4,
     "type": "string"
    },
    "merge": {
     "minLength": 4,
     "type": "string"
    },
    "rule": {
     "minLength": 8,
     "type": "string"
    },
    "tie_break": {
     "minLength": 8,
     "type": "string"
    }
   },
   "required": [
    "rule",
    "tie_break",
    "duplicate_in_one_file",
    "merge"
   ],
   "type": "object"
  },
  "question": {
   "minLength": 40,
   "type": "string"
  },
  "reviewer": {
   "properties": {
    "independent": {
     "type": "boolean"
    },
    "reviewer_id": {
     "minLength": 3,
     "type": "string"
    },
    "verdict": {
     "type": "string"
    }
   },
   "required": [
    "reviewer_id",
    "verdict",
    "independent"
   ],
   "type": "object"
  },
  "samples": {
   "items": {
    "properties": {
     "id": {
      "minLength": 3,
      "type": "string"
     },
     "kind": {
      "enum": [
       "skill",
       "workflow_blueprint",
       "council_preset",
       "hook",
       "rule",
       "mcp_mount"
      ],
      "type": "string"
     },
     "source_id": {
      "minLength": 3,
      "type": "string"
     },
     "transcription": {
      "type": "object"
     },
     "verdict": {
      "enum": [
       "EXPRESSIBLE",
       "INEXPRESSIBLE"
      ],
      "type": "string"
     }
    },
    "required": [
     "kind",
     "id",
     "source_id",
     "verdict",
     "transcription"
    ],
    "type": "object"
   },
   "minItems": 3,
   "type": "array"
  },
  "sentinel": {
   "minLength": 8,
   "type": "string"
  },
  "state": {
   "enum": [
    "SUCCESS",
    "PARTIAL",
    "BLOCKED",
    "FAILED",
    "TIMEOUT",
    "SEVERED"
   ],
   "type": "string"
  },
  "tests": {
   "items": {
    "properties": {
     "command": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "result": {
      "enum": [
       "PASS",
       "FAIL",
       "NOT-RUN"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "command",
     "result"
    ],
    "type": "object"
   },
   "minItems": 2,
   "type": "array"
  },
  "unit_id": {
   "minLength": 7,
   "pattern": "^ARC-[0-9]{4}$",
   "type": "string"
  }
 },
 "required": [
  "unit_id",
  "state",
  "sentinel",
  "architecture_id",
  "question",
  "file_set",
  "load_order",
  "precedence",
  "expressibility",
  "samples",
  "tests",
  "negative_controls",
  "reviewer",
  "artifacts",
  "evidence"
 ],
 "title": "Architecture dossier (Phase 3 tournament entry)",
 "type": "object"
}
