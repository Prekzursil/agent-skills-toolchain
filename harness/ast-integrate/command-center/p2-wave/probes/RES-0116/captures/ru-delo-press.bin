        <div class="icon__text" data-type="comment_count_header">
            0        </div>
    </a>
</div>
                                                        <div class="icon icon--label favorite-add"
                                 data-id="43740"
                                 data-category="documents"
                                 data-type="70"
                                 data-date="01.04.2015"
                                 data-show="N"
                                 data-message="Вы не авторизованны!"
                            >
                                <svg width="14" height="16">
