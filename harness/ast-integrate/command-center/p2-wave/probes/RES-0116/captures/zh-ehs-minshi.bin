		<script>
			jQuery(document).ready(function() {
				var sidebar = jQuery("#feedbackDiv");
				if (sidebar != null && typeof(sidebar) != 'undefined') {
					_window = jQuery(window),
						offset = sidebar.offset(),
						topPadding = 100;
					_window.scroll(function() {
						if (_window.scrollTop() > offset.top) {
							sidebar.stop().animate({ marginTop: _window.scrollTop() - offset.top + topPadding });
						} else {
							sidebar.stop().animate({ marginTop: 100 });
						}
					});
				}
				/*jQuery("#xiaotu").mouseover(function(){
					jQuery(this).next().show("slide");
				});
				jQuery("#xiaotu").click(function(){
					jQuery(this).next().hide("slide");
				})*/
				jQuery('#lawContentBtn').click(function() {
					jQuery('#lawContentBox').removeAttr('style');
					jQuery(this).next().remove();
					jQuery(this).remove();
				});
				jQuery("#feedbackDiv").mouseover(function() {
					jQuery("#xiaotu").hide();
					jQuery("#kefu").show();
				});
				jQuery("#feedbackDiv").mouseout(function() {
					jQuery("#xiaotu").show();
					jQuery("#kefu").hide();
				});
				var subDone = false;
				jQuery('#sub-btn').click(function() {
					if (vip < 1) {
						showTips(4)
						return false;
					}
					if (subDone) {
						return;
					}
					jQuery.ajax({
						url: '/ehs.php?s=/law/subscribe',
						data: {lid: 125747},
						type: 'post',
						dataType: 'json',
						success: function(json) {
							if (json.status != '1') {
								art.dialog({ content: json.info, title: '提示', lock: false, time: 3 });
							} else {
								subDone = true;
								art.dialog({
									content: '订阅成功<br>法规收录完成后，您会收到我们的站内提醒',
									title: false,
									lock: false,
									time: 8
								});
								jQuery('#sub-btn').html('已订阅');
							}
						}
					});
				});
			});
		</script>
