		<script>
			/** 法规页，浮动层； by 3211 */
			jQuery(document).ready(function() {
				var $sidebar = jQuery("#feedbackDiv");
				if ($sidebar != null && typeof($sidebar) != 'undefined') {
					$window = jQuery(window),
						offset = $sidebar.offset(),
						topPadding = 400;
					$window.scroll(function() {
						if ($window.scrollTop() > offset.top) {
							$sidebar.stop().animate({ marginTop: $window.scrollTop() - offset.top + topPadding });
						} else {
							$sidebar.stop().animate({ marginTop: 200 });
						}
					});
				}
				// 1. 禁用右键菜单（防止右键审查元素）
				jQuery('body').on('contextmenu', function(e) {
				    // 排除扩展相关的元素（如果有特定类/ID可追加判断）
				    if (!e.target.closest('[data-webext]') && !e.target.webkitMatchesSelector('::-webkit-scrollbar')) {
						e.preventDefault();
						return false;
				    }
				});
	
				// 2. 禁用F12、Ctrl+Shift+I、Ctrl+U等调试快捷键
				jQuery(document).on('keydown', function(e) {
					// F12键
					if (e.keyCode === 123) {
						e.preventDefault();
						return false;
					}
					// Ctrl+Shift+I
					if (e.ctrlKey && e.shiftKey && e.keyCode === 73) {
						e.preventDefault();
						return false;
					}
					// Ctrl+U（查看网页源代码）
					if (e.ctrlKey && e.keyCode === 85) {
						e.preventDefault();
						return false;
					}
					// Ctrl+Shift+J（Chrome控制台）
					if (e.ctrlKey && e.shiftKey && e.keyCode === 74) {
						e.preventDefault();
						return false;
					}
					// Shift+F10（右键菜单替代）
					if (e.shiftKey && e.keyCode === 121) {
						e.preventDefault();
						return false;
					}
				});
			});
		</script>
