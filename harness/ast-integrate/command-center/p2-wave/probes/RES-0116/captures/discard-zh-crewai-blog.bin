        <c4d-image id="image--1584010870" alt="Meredith" slot="media" default-src="https://assets.ibm.com/is/image/ibm/mm_headshot?wid=128" class=" overlaywatermark">
            
            
        </c4d-image>
    

    
    
    
    

    

                
                <div class="cds--author-signature__author--image--default">
                    <svg id="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
