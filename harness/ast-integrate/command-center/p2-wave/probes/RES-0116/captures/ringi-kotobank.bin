<script>
$(function () {
    $('#searchForm').on('click', function () {
        $('#searchForm').hide();
    });
    $('#searchForm input').on('click', function (e) {
        e.stopPropagation();
    });
    $('#triggerOpenSearchForm').on('click', function () {
        $('#searchForm').show();
        $('#searchForm input').focus();
    });
});
</script>
