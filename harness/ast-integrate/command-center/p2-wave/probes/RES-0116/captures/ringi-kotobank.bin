</div>
    

	</article><!-- /.dictype 辞書ひとつ -->

                <div id="retailkeyword">
    <b>関連語</b>
                        <span class="gray-button"><a href="/word/%E3%83%97%E3%83%AD%E3%82%A4%E3%82%BB%E3%83%B3-3168616">プロイセン</a></span>
                                <span class="gray-button"><a href="/word/%E7%94%B0%E5%8F%A3%E5%AF%8C%E4%B9%85%E6%B2%BB-1088279">田口富久治</a></span>
