{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0111/research-claim-record.schema.json",
  "title": "RES-0111 research claim record (unit-local; catalog path is absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "primitive_to_failure_class_mapping",
    "primitives_dropped_unmapped_count",
    "claims",
    "mechanisms",
    "e3_records",
    "reviewer",
    "tests",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0111" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "minLength": 40 },
    "question": { "type": "string", "minLength": 40 },
    "primitive_to_failure_class_mapping": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "primitive",
          "decision",
          "evidence_tier",
          "strongest_caveat"
        ]
      }
    },
    "primitives_dropped_unmapped_count": {
      "type": "integer",
      "minimum": 1
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "strongest_caveat"],
        "properties": {
          "verdict": {
            "type": "string",
            "enum": ["REFUTED", "CONFIRMED", "PARTIAL", "NOT-CHECKED"]
          }
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "primitive",
          "doi",
          "section_or_figure",
          "effect_size",
          "baseline"
        ]
      }
    },
    "e3_records": { "type": "array", "minItems": 1 },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_id",
        "verdict",
        "independent",
        "default",
        "scope_not_agreement"
      ],
      "properties": {
        "independent": { "type": "boolean", "const": true },
        "scope_not_agreement": { "type": "boolean", "const": true },
        "default": { "type": "string", "const": "REFUTED" }
      }
    },
    "tests": { "type": "array", "minItems": 2 },
    "evidence": { "type": "array", "minItems": 4 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
