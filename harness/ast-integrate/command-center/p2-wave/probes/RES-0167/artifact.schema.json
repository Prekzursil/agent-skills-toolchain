{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0167/artifact.schema.json",
  "title": "RES-0167 measurement-run (local stand-in; declared measurement-run.schema.json is absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "progress_predicate",
    "attempt_limit",
    "escalation_path",
    "printed_success_by_attempt",
    "both_states",
    "harvest",
    "claims",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0167" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 20 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "progress_predicate": { "type": "object" },
    "attempt_limit": { "type": "object" },
    "escalation_path": { "type": "object" },
    "printed_success_by_attempt": { "type": "string", "minLength": 16 },
    "both_states": { "type": "object" },
    "harvest": { "type": "object" },
    "claims": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
