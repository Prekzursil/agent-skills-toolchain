{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0011/audit-report.schema.json",
  "title": "AuditReport (WFA-0011 unit-local $def; WFA-0001 pack absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "unit_id",
    "id",
    "state",
    "status",
    "sentinel",
    "completion_sentinel",
    "title",
    "output_path",
    "output_schema",
    "question",
    "answer",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "notes"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "AuditReport" },
    "kind": { "type": "string" },
    "unit_id": { "type": "string", "const": "WFA-0011" },
    "id": { "type": "string", "const": "WFA-0011" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "status": { "type": "string", "enum": ["DELIVERED"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0011" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0011" },
    "title": { "type": "string", "minLength": 16 },
    "output_path": { "type": "string" },
    "output_schema": { "type": "string" },
    "question": { "type": "string" },
    "answer": { "type": "string", "minLength": 24 },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 3 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "notes": { "type": "string", "minLength": 12 }
  }
}
