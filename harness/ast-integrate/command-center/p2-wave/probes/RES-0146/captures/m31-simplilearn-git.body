9\u002Ffree_resources_article_thumb\u002FGitHub_Desktop.jpg","star_ratings":"0.0","no_of_learners":"0","author":"John Terra","no_of_views":"27566","id":"article-628ca1a76f43407e058b457e"},{"title":"GitLab vs GitHub: Which is Better for Developers in 2026?","last_updated_on":"2025-12-10T23:43:14+05:30","item_type":"article","page_url":"\u002Fgitlab-vs-github-article","image_url":"https:\u002F\u002Fwww.simplilearn.com\u002Fice9\u002Ffree_resources_article_thumb\u002Fgitlab_vs_github.jpg","star_ratings":"0.0","no_of_learners":"0","author":"Sachin Satish","no_of_views":"149","id":"article-65c0a57b9fab4631708b45dd"}],"tutorial":[{"title":"What is Git: Features, Command and Workflow in Git","last_updated_on":"2026-02-15T09:01:07+05:30","item_type":"tutorial","page_url":"\u002Ftutorials\u002Fgit-tutorial\u002Fwhat-is-git","image_url":"https:\u002F\u002Fwww.simplilearn.com\u002Fice9\u002Ffree_resources_article_thumb\u002Fwhat_is_Git.jpg","star_ratings":"0.0","no_of_learners":"0","no_of_views":"292500","additional_details":["0"],"id":"tutorial-5eafdfa456ab46563e8b47c1"},{"title":"Git vs GitHub: What are the Major Differences?","last_updated_on":"2026-03-08T08:55:40+05:30","item_type":"tutorial","page_url":"\u002Ftutorials\u002Fgit-tutorial\u002Fgit-vs-github","image_url":"https:\u002F\u002Fwww.simplilearn.com\u002Fice9\u002Ffree_resources_article_thumb\u002Fgit_vs_github2.jpg","star_ratings":"0.0","no_of_learners":"0","no_of_views":"197270","additional_details":["0"],"id":"tutorial-5eb0849356ab46543e8b4832"},{"title":"Git Push Command Explained With Demo","last_updated_on":"2026-02-15T09:01:25+05:30","item_type":"tutorial","page_url":"\u002Ftutorials\u002Fgit-tutorial\u002Fgit-push-command","image_url":"https:\u002F\u002Fi.ytimg.com\u002Fvi\u002FQJ0iUNe27c8\u002Fhqdefault.jpg","star_ratings":"0.0","no_of_learners":"0","no_of_views":"296934","additional_details":["0"],"id":"tutorial-5efd707c4f4740f4158b50a9"},{"title":"All The Git Commands You Need to Know About","last_update