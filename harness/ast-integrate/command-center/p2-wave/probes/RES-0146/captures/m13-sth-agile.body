							<cite itemprop="name" class="fn">mehek</cite>						</div>

													<div class="entry-meta comment-metadata">
								<a href="https://www.softwaretestinghelp.com/agile-scrum-methodology-for-development-and-testing/#comment-101352">									<time datetime="2023-09-15T13:37:05+00:00" itemprop="datePublished">
