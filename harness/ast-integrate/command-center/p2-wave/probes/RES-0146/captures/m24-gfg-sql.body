"Databases","parent_slug":"databases","pp_count":1357,"write_id":4341},{"id":8383,"name":"Databases","slug":"databases","url":"https://www.geeksforgeeks.org/category/databases/","parent_id":null,"parent_name":null,"parent_slug":null,"pp_count":1948,"write_id":12022}],"tagsData":[{"id":2162,"name":"DBMS-SQL","slug":"dbms-sql","url":"https://www.geeksforgeeks.org/tag/dbms-sql/","parent_id":null,"parent_name":null,"parent_slug":null,"pp_count":531,"write_id":6180}],"topicTags":null,"companyTags":null,"postLikeCount":276,"postType":"post","isMobileView":false,"countryCode":"","videoData":[{"id":11184,"title":"Introduction to SQL","slug":"introduction-to-sql","description":"\u003cp\u003eIn this SQL tutorial, you’ll learn basic to advanced SQL concepts like queries, joins, and creating tables. SQL, developed by IBM in the 1970s, helps manage data efficiently in databases like MySQL and Oracle. It is a standard query language for database manipulation. Databases store structured data, enabling easy access and management through SQL.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article for detailed examples and concepts: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003ehere\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/0daeba38ee7da891713b2ee0e148cfd9gfg-IntroductiontoSQL12024070610562720250108145349/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804.jpg","likes":0,"views":209760,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/0daeba38ee7da891713b2ee0e148cfd9gfg-IntroductiontoSQL12024070610562720250108145349/subtitle.vtt","duration":1425,"course_link":"https://gfgcdn.com/tu/U4D/","video_schema":{"@context":"https://schema.org","@type":"VideoObject","name":"Introduction to SQL","description":"In this SQL tutorial, youll learn basic to advanced SQL concepts like queries, joins, and creating tables. SQL, developed by IBM in the 1970s, helps manage data efficiently in databases like MySQL and Oracle. It is a standard query language for database manipulation. Databases store structured data, enabling easy access and management through SQL. nbspRead the full article for detailed examples and concepts here.","thumbnailUrl":["https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804.jpg","https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-seo.png","https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-small.png"],"uploadDate":"2025-01-08T16:10:32Z","duration":"PT0H23M45S","contentUrl":"https://www.geeksforgeeks.org/videos/introduction-to-sql/"}},{"id":11185,"title":"Data Retrieval with SQL","slug":"data-retrieval-with-sql","description":"\u003cp\u003eLearn how to retrieve data efficiently using SQL, including the use of \u003cstrong\u003eSELECT statements\u003c/strong\u003e and filters like \u003cstrong\u003eWHERE clauses\u003c/strong\u003e. SQL simplifies fetching specific records from databases such as MySQL and PostgreSQL. Understand key techniques to query and extract valuable insights from structured data. Practical examples make it easy to grasp the concepts.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/9578bb58b6aa79eb4bd8f2351da73f97gfg-DataRetrievalwithSQL2024062818191920250108151510/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/DataRetrievalwithSQL/DataRetrievalwithSQL20250108160549-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/DataRetrievalwithSQL/DataRetrievalwithSQL20250108160549.jpg","likes":0,"views":44140,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/9578bb58b6aa79eb4bd8f2351da73f97gfg-DataRetrievalwithSQL2024062818191920250108151510/subtitle.vtt","duration":1761,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11186,"title":"Introduction to Keys","slug":"introduction-to-keys","description":"\u003cp\u003eUnderstand the importance of \u003cstrong\u003ekeys in SQL\u003c/strong\u003e, including primary, foreign, and unique keys, to ensure data integrity and relationships in databases. Keys play a crucial role in uniquely identifying rows and maintaining database structure. Learn how to use keys effectively in relational databases. Practical examples illustrate their significance.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/8090f5f83867c7d0f3c99881802cd857gfg-IntroductiontoKeys2024062818214720250108152006/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoKeys/IntroductiontoKeys20250108160731-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoKeys/IntroductiontoKeys20250108160731.jpg","likes":2,"views":12990,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/8090f5f83867c7d0f3c99881802cd857gfg-IntroductiontoKeys2024062818214720250108152006/subtitle.vtt","duration":1316,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11187,"title":"Insert Data in a table","slug":"insert-data-in-a-table","description":"\u003cp\u003eLearn how to use the \u003cstrong\u003eINSERT statement in SQL\u003c/strong\u003e to add data into tables effectively. This statement helps populate tables with single or multiple rows of data. Understand the syntax and explore examples for structured data insertion. Ensure data accuracy with practical implementation.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial.\u003c/a\u003e\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/cc20a48833f73db56b969a478d43e53agfg-InsertDatainatable2024062818240320250108152518/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/InsertDatainatable/InsertDatainatable20250108160814-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/InsertDatainatable/InsertDatainatable20250108160814.jpg","likes":0,"views":4410,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/cc20a48833f73db56b969a478d43e53agfg-InsertDatainatable2024062818240320250108152518/subtitle.vtt","duration":1216,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11188,"title":"Update data from a table","slug":"update-data-from-a-table","description":"\u003cp\u003eLearn how to use the \u003cstrong\u003eUPDATE statement in SQL\u003c/strong\u003e to modify existing data in tables efficiently. This statement allows updating specific rows based on conditions or all rows in a table. Explore syntax and practical examples to ensure accurate data updates.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/8eb598e51f2f9946c2a2500bed49ceebgfg-Updatedatafromatable2024062818242720250108152813/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/Updatedatafromatable/Updatedatafromatable20250108161211-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/Updatedatafromatable/Updatedatafromatable20250108161211.jpg","likes":0,"views":4180,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/8eb598e51f2f9946c2a2500bed49ceebgfg-Updatedatafromatable2024062818242720250108152813/subtitle.vtt","duration":799,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11189,"title":"SQL in Action","slug":"sql-in-action","description":"\u003cp\u003eDiscover \u003cstrong\u003eSQL in Action\u003c/strong\u003e with real-world examples demonstrating how SQL queries manage and manipulate data effectively. Learn practical use cases like retrieving, inserting, and updating data to understand SQL's power. Explore detailed examples to enhance your database management skills.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/ab9feb20d7b85a3ec475fdc42a41b8ecgfg-SQLinAction2024062818245220250108153449/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/SQLinAction/SQLinAction20250108161301-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/SQLinAction/SQLinAction20250108161301.jpg","likes":1,"views":6430,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/ab9feb20d7b85a3ec475fdc42a41b8ecgfg-SQLinAction2024062818245220250108153449/subtitle.vtt","duration":1479,"course_link":"https://gfgcdn.com/tu/U4D/"}],"quizData":null,"codeTabsExist":false,"articleContentArray":["\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eStructured Query Language (SQL) is the standard language used to interact with relational databases. \u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003cspan\u003eMainly used to manage data. Whether you want to create, delete, update or read data, SQL provides commands to perform these operations. \u003c/span\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003cspan\u003eWidely supported across various database systems like MySQL oracle, PostgreSQL, SQL Server and many others.\u003c/span\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003cspan\u003eMainly works with Relational Databases (data is stored in the form of tables).\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003cgfg-carousel\u003e\u003cgfg-carousel-content alt=\"sql.webp\" height=\"400\" src=\"https://media.geeksforgeeks.org/wp-content/uploads/20260326174945624060/sql.webp\" width=\"800\"\u003e\u003c/gfg-carousel-content\u003e\u003cgfg-carousel-content alt=\"basic_operation_in_sql.webp\" height=\"400\" src=\"https://media.geeksforgeeks.org/wp-content/uploads/20260326174946291172/basic_operation_in_sql.webp\" width=\"800\"\u003e\u003c/gfg-carousel-content\u003e\u003cgfg-carousel-content alt=\"compute_services.webp\" height=\"400\" src=\"https://media.geeksforgeeks.org/wp-content/uploads/20260326174946034781/compute_services.webp\" width=\"800\"\u003e\u003c/gfg-carousel-content\u003e\u003cgfg-carousel-content alt=\"roadmap.webp\" height=\"400\" src=\"https://media.geeksforgeeks.org/wp-content/uploads/20260326174945753965/roadmap.webp\" width=\"800\"\u003e\u003c/gfg-carousel-content\u003e\u003cgfg-carousel-content alt=\"crud_operations.webp\" height=\"400\" src=\"https://media.geeksforgeeks.org/wp-content/uploads/20260330121057327660/crud_operations.webp\" width=\"800\"\u003e\u003c/gfg-carousel-content\u003e\u003cgfg-carousel-content alt=\"applications_of_sql.webp\" height=\"400\" src=\"https://media.geeksforgeeks.org/wp-content/uploads/20260326174946426217/applications_of_sql.webp\" width=\"800\"\u003e\u003c/gfg-carousel-content\u003e\u003c/gfg-carousel\u003e\u003ch2 id=\"basics\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Basics\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eCovers core concepts like introduction, data types, operators, commands, comments, applications and SQL career path to build a strong foundation\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/what-is-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIntroduction\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-data-types/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eData Types\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-operators/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eOperators\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-ddl-dql-dml-dcl-tcl-commands/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCommands\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-comments/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eComments\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-wildcard-operators/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eWildcards Operators\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/applications-of-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eApplications \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-career-path-roles-skills-salaries/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCareer Path\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"create-database\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Database\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eThis section guides you through the process of creating and managing databases. Learn how to create, select, rename and drop databases with practical examples.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-create-database/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCREATE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-select-database/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eSELECT \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-query-to-rename-database/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRENAME \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-drop-database/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDROP\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"tables\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Tables\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eTables are the core data structures in databases organizing data into rows and columns. This section covers how to create, modify and manage tables effectively.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-create-table/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCREATE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-drop-table-statement/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDROP \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-alter-rename/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRENAME \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-truncate/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eTRUNCATE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-cloning-or-copying-a-table/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCOPY \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/what-is-temporary-table-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eTEMP \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-alter-add-drop-modify/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eALTER \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-auto-increment/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eAuto Increment\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-sequences/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eSequences\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"crud-operations\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Queries\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eMaster writing SQL queries to interact with and manipulate data stored in your tables. This section covers common query types and operations.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-select-query/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eSELECT \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-insert-statement/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eINSERT INTO\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-query-to-insert-multiple-rows/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eINSERT Multiple Rows\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-update-statement/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUPDATE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-delete-statement/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDELETE Statement\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-query-to-delete-duplicate-rows/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDELETE Duplicate Rows\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/dynamic-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDynamic \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"clauses\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Clauses\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eUnlock useful ways to filter organize and group your query results. Clauses help you refine your data extraction.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-where-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eWHERE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-with-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eWITH\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-having-clause-with-examples/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eHAVING \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-order-by/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eORDER By \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-group-by/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eGroup By \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-limit-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eLIMIT \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-distinct-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDistinct \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-top-limit-fetch-first-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRow Limiting \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-aliases/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eAliases\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"operators\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Operators\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eSQL Operators refers to the fundamental symbols and keywords within the SQL that enable users to perform various operations. Operators let you build complex query conditions.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-logical-operators/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eLogical \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-like/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eLIKE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-in-operator/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIN \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-not-operator/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eNOT \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-not-equal-operator/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eNOT EQUAL \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-is-null-operator/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIS NULL \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-union-operator/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUNION\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-union-all/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUNION ALL \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-except-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eEXCEPT \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"10\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-between/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eBETWEEN \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"11\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-all-and-any/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eALL \u0026amp; ANY\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"12\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-intersect-clause/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eINTERSECT\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"13\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-exists/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eEXISTS \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"14\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-case-statement/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCASE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"sql-functions\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Functions\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eSQL functions offer an efficient and versatile approach to data analysis. Enhance your queries with built-in functions that manipulate data types and perform calculations.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/date-functions-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDate \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-string-functions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eString \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-numeric-functions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eNumeric \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/statistical-functions-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eStatistical (Aggregate Functions) \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/working-with-json-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eJSON \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-conversion-function/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eConversion\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/ltrim-function-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eLTRIM \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/upper-function-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUPPER \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/rtrim-function-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRTRIM\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"10\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/regular-expressions-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRegular Expressions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"data-constraints\" style=\"text-align:left\"\u003e\u003cspan\u003eData Constraints\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eConstraints define rules on data to ensure accuracy, consistency and prevent invalid entries in the database.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-not-null-constraint/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eNOT NULL \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/primary-key-constraint-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003ePrimary Key \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/foreign-key-constraint-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eForeign Key \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/composite-key-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eComposite Key\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-unique-constraint/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUnique \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-alternate-key/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eAlternate Key\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-check-constraint/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCHECK \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-default-constraint/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDEFAULT \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"sql-joins\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Joins\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eSQL joins combine data from multiple tables based on related columns to retrieve meaningful results.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-join-set-1-inner-left-right-and-full-joins/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIntroduction\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-outer-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eOuter\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-left-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eLeft\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-right-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRight \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-full-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eFull\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-cross-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCross\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-self-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eSelf \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-update-with-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUPDATE\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-delete-join/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDELETE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"10\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/recursive-join-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRecursive\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"views\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Views\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eFocuses on creating and managing views using CREATE, UPDATE, RENAME and DROP VIEW for simplified and secure data access.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-create-view-statement/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCREATE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/update-view-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUPDATE \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/rename-view-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRENAME \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/drop-view-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDROP \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"indexes\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Indexes\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eImprove query performance by creating indexes that speed up data retrieval. \u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-indexes/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIntroduction\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-create-index/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCreate \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-drop-index/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDrop\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-show-indexes/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eShow\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-unique-index/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eUnique\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/clustered-and-non-clustered-indexing/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eClustered \u0026amp; Non-Clustered \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"subquery\" style=\"text-align:left\"\u003e\u003cspan\u003eSQL Subquery\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eCovers nested queries including subqueries, correlated subqueries and nested queries for complex data retrieval.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-subquery/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIntroduction\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-correlated-subqueries/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCorrelated Subqueries\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/nested-queries-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eNested Queries\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"advanced-sql-databases\" style=\"text-align:left\"\u003e\u003cspan\u003eAdvanced SQL \u0026amp; Databases \u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eCovers advanced concepts like query optimization, complex operations and handling large-scale databases using joins, functions and stored procedures.\u003c/span\u003e\u003c/p\u003e\u003ch3 id=\"database-design-and-modeling\" style=\"text-align:left\"\u003e\u003cspan\u003eDatabase Design \u0026amp; Modeling\u003c/span\u003e\u003c/h3\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eIncludes ER modeling, ER diagrams, mapping to relational models, normalization, functional dependencies and design techniques to build efficient and scalable databases.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/introduction-of-er-model/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIntroduction \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/how-to-draw-entity-relationship-diagrams/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eEntity Relationship Diagrams (ERDs)\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/mapping-from-er-model-to-relational-model/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eMapping from ER Model to Relational Model\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/introduction-of-database-normalization/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eIntroduction of Database Normalization\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/functional-dependency-and-attribute-closure/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eFunctional Dependency \u0026amp; Attribute Closure\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/types-of-functional-dependencies-in-dbms/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eTypes of Functional dependencies\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/engineering-mathematics/rules-of-inference/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRules of Inference\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/normal-forms-in-dbms/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eNormal Forms in DBMS\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/denormalization-in-databases/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDenormalization in Databases\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"10\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/database-design-in-dbms/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDatabase Design\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3 id=\"database-security\" style=\"text-align:left\"\u003e\u003cspan\u003eDatabase Security\u003c/span\u003e\u003c/h3\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eFocuses on protecting databases using SQL injection prevention, encryption, backup and recovery techniques to ensure data safety and integrity.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-injection/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eInjection\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/ethical-hacking/types-of-sql-injection-sqli/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eTypes of SQL Injection\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-data-encryption/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eData Encryption\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/database-recovery-techniques-in-dbms/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDatabase Recovery Techniques \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-backup/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eBackup\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/how-to-restore-sql-server-database-from-backup/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eRestore SQL Server Database From Backup\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch3 id=\"database-connectivity\" style=\"text-align:left\"\u003e\u003cspan\u003eDatabase Connectivity\u003c/span\u003e\u003c/h3\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eExplains how applications connect to databases using technologies like ORM, ODM and ODBC for efficient data interaction across programming languages.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/what-is-object-relational-mapping-orm-in-dbms/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eORM (Object-Relational Mapping)\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/comparison-between-orm-and-odm/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eODM (Object-Document Mapping)\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/odbc-full-form/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eODBC (Open Database Connectivity)\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"miscellaneous-topics\" style=\"text-align:left\"\u003e\u003cspan\u003eMiscellaneous Topics\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\"\u003e\u003cspan\u003eExplore advanced and useful SQL concepts to deepen your knowledge\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/pivot-and-unpivot-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003ePivot and Unpivot\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-trigger-student-database/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eTrigger\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-hosting/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eHosting\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-performance-tuning/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003ePerformance Tuning\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/what-is-stored-procedures-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eStored Procedures\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"6\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-transactions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eTransactions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"7\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/window-functions-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eWindow functions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"8\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/what-is-cursor-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCursors\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"9\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/cte-in-sql/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCommon Table Expressions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"10\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-database-tuning/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDatabase Tuning\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003ch2 id=\"exercises-interview-questions-cheat-sheet\" style=\"text-align:left\"\u003e\u003cspan\u003eExercises, Interview Questions \u0026amp; Cheat Sheet\u003c/span\u003e\u003c/h2\u003e\u003cp dir=\"ltr\" style=\"text-align: justify;\"\u003e\u003cspan\u003eProvides practice exercises, interview questions and a cheat sheet for quick revision of SQL concepts.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-exercises/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eExercises\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-quiz/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eQuiz\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-interview-questions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eInterview Questions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-query-interview-questions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eSQL Query Interview Questions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-cheat-sheet/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCheat Sheet \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e\u003cblockquote\u003e\u003cp dir=\"ltr\"\u003e\u003cb\u003e\u003cstrong\u003eLatest Trend [2025]:\u003c/strong\u003e\u003c/b\u003e\u003cspan\u003e SQL Server 2025 introduces AI-driven features directly within the SQL engine. It supports native vector data types and AI model management, allowing developers to run AI tasks directly in SQL without external tools.\u003c/span\u003e\u003c/p\u003e\u003c/blockquote\u003e\u003ch2 id=\"related-articles\" style=\"text-align:left\"\u003e\u003cspan\u003eRelated Articles\u003c/span\u003e\u003c/h2\u003e\u003cul\u003e\u003cli value=\"1\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/30-days-of-sql-from-basic-to-advanced-level/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003e30 Days of SQL ( From Basic to Advanced)\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"2\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/commonly-asked-dbms-interview-questions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eDBMS Interview Questions\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"3\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/quizzes/sql-gq/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eMultiple Choice Questions of SQLs\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"4\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/dbms/commonly-asked-dbms-interview-questions-set-2/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eCommonly asked DBMS interview questions \u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003cli value=\"5\"\u003e\u003ca href=\"https://www.geeksforgeeks.org/sql/sql-interview-questions/\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eSQL Interview Questions For Business Analyst\u003c/span\u003e\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e"],"textBasedAd":null,"videoSet":false,"isArticlePage":true,"practiceBannerData":null,"practiceBannerSet":false,"articleKatexScript":"","hasCarousel":true,"postTitle":"SQL Tutorial","postModifiedDate":"2026-08-11T16:28:24","validatedPostSchema":[{"@context":"https://schema.org","@type":"Article","mainEntityOfPage":{"@type":"WebPage","id":"https://www.geeksforgeeks.org/sql/sql-tutorial/"},"headline":"SQL Tutorial","datePublished":"2024-02-15 04:51:41","dateModified":"2026-08-11 04:28:24","image":[{"@type":"ImageObject","url":"https://media.geeksforgeeks.org/wp-content/uploads/20260326174945624060/sql.webp","width":"800","height":"400"},{"@type":"ImageObject","url":"https://media.geeksforgeeks.org/wp-content/uploads/20260326174946291172/basic_operation_in_sql.webp","width":"800","height":"400"},{"@type":"ImageObject","url":"https://media.geeksforgeeks.org/wp-content/uploads/20260326174946034781/compute_services.webp","width":"800","height":"400"},{"@type":"ImageObject","url":"https://media.geeksforgeeks.org/wp-content/uploads/20260326174945753965/roadmap.webp","width":"800","height":"400"},{"@type":"ImageObject","url":"https://media.geeksforgeeks.org/wp-content/uploads/20260330121057327660/crud_operations.webp","width":"800","height":"400"},{"@type":"ImageObject","url":"https://media.geeksforgeeks.org/wp-content/uploads/20260326174946426217/applications_of_sql.webp","width":"800","height":"400"}],"author":{"@type":"Organization","name":"GeeksforGeeks","url":"https://www.geeksforgeeks.org/","logo":{"@type":"ImageObject"