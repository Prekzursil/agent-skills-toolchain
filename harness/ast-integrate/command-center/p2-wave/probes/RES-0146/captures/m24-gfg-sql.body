iontoSQL12024070610562720250108145349/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804.jpg","likes":0,"views":209760,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/0daeba38ee7da891713b2ee0e148cfd9gfg-IntroductiontoSQL12024070610562720250108145349/subtitle.vtt","duration":1425,"course_link":"https://gfgcdn.com/tu/U4D/","video_schema":{"@context":"https://schema.org","@type":"VideoObject","name":"Introduction to SQL","description":"In this SQL tutorial, youll learn basic to advanced SQL concepts like queries, joins, and creating tables. SQL, developed by IBM in the 1970s, helps manage data efficiently in databases like MySQL and Oracle. It is a standard query language for database manipulation. Databases store structured data, enabling easy access and management through SQL. nbspRead the full article for detailed examples and concepts here.","thumbnailUrl":["https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804.jpg","https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-seo.png","https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-small.png"],"uploadDate":"2025-01-08T16:10:32Z","duration":"PT0H23M45S","contentUrl":"https://www.geeksforgeeks.org/videos/introduction-to-sql/"}},{"id":11185,"title":"Data Retrieval with SQL","slug":"data-retrieval-with-sql","description":"\u003cp\u003eLearn how to retrieve data efficiently using SQL, including the use of \u003cstrong\u003eSELECT statements\u003c/strong\u003e and filters like \u003cstrong\u003eWHERE clauses\u003c/strong\u003e. SQL simplifies fetching specific records from databases such as MySQL and PostgreSQL. Understand key techniques to query and extract valuable insights from structured data. Practical examples make it easy to grasp the concepts.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/9578bb58b6aa79eb4bd8f2351da73f97gfg-DataRetrievalwithSQL2024062818191920250108151510/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/DataRetrievalwithSQL/DataRetrievalwithSQL20250108160549-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/DataRetrievalwithSQL/DataRetrievalwithSQL20250108160549.jpg","likes":0,"views":44140,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/9578bb58b6aa79eb4bd8f2351da73f97gfg-DataRetrievalwithSQL2024062818191920250108151510/subtitle.vtt","duration":1761,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11186,"title":"Introduction to Keys","slug":"introduction-to-keys","description":"\u003cp\u003eUnderstand the importance of \u003cstrong\u003ekeys in SQL\u003c/strong\u003e, including primary, foreign, and unique keys, to ensure data integrity and relationships in databases. Keys play a crucial role in uniquely identifying rows and maintaining database structure. Learn how to use keys effectively in relational databases. Practical examples illustrate their significance.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/8090f5f83867c7d0f3c99881802cd857gfg-IntroductiontoKeys2024062818214720250108152006/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoKeys/IntroductiontoKeys20250108160731-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/IntroductiontoKeys/IntroductiontoKeys20250108160731.jpg","likes":2,"views":12990,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/8090f5f83867c7d0f3c99881802cd857gfg-IntroductiontoKeys2024062818214720250108152006/subtitle.vtt","duration":1316,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11187,"title":"Insert Data in a table","slug":"insert-data-in-a-table","description":"\u003cp\u003eLearn how to use the \u003cstrong\u003eINSERT statement in SQL\u003c/strong\u003e to add data into tables effectively. This statement helps populate tables with single or multiple rows of data. Understand the syntax and explore examples for structured data insertion. Ensure data accuracy with practical implementation.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial.\u003c/a\u003e\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/cc20a48833f73db56b969a478d43e53agfg-InsertDatainatable2024062818240320250108152518/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/InsertDatainatable/InsertDatainatable20250108160814-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/InsertDatainatable/InsertDatainatable20250108160814.jpg","likes":0,"views":4410,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/cc20a48833f73db56b969a478d43e53agfg-InsertDatainatable2024062818240320250108152518/subtitle.vtt","duration":1216,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11188,"title":"Update data from a table","slug":"update-data-from-a-table","description":"\u003cp\u003eLearn how to use the \u003cstrong\u003eUPDATE statement in SQL\u003c/strong\u003e to modify existing data in tables efficiently. This statement allows updating specific rows based on conditions or all rows in a table. Explore syntax and practical examples to ensure accurate data updates.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.org/sql-tutorial/\"\u003eSQL Tutorial\u003c/a\u003e.\u003c/p\u003e","source":"https://cdnvideos.geeksforgeeks.org/8eb598e51f2f9946c2a2500bed49ceebgfg-Updatedatafromatable2024062818242720250108152813/video.m3u8","category":[{"term_id__id":43,"term_id__term_name":"GATE","term_id__term_type":2,"term_id__slug":"gate"},{"term_id__id":114,"term_id__term_name":"sql","term_id__term_type":2,"term_id__slug":"sql-egjhsg"},{"term_id__id":113,"term_id__term_name":"SQL","term_id__term_type":1,"term_id__slug":"sql"},{"term_id__id":159,"term_id__term_name":"CS-subjects","term_id__term_type":1,"term_id__slug":"cs-subjects"},{"term_id__id":610,"term_id__term_name":"GATE","term_id__term_type":1,"term_id__slug":"gate-2"}],"meta":{"thumbnail":"https://media.geeksforgeeks.org/courses/Updatedatafromatable/Updatedatafromatable20250108161211-small.png","largeThumbnail":"https://media.geeksforgeeks.org/courses/Updatedatafromatable/Updatedatafromatable20250108161211.jpg","likes":0,"views":4180,"isFeatured":0,"isPremium":0,"isPublic":1,"format":"video/mp4","revision":{}},"time":"08/01/2025","subtitle":"https://cdnvideos.geeksforgeeks.org/8eb598e51f2f9946c2a2500bed49ceebgfg-Updatedatafromatable2024062818242720250108152813/subtitle.vtt","duration":799,"course_link":"https://gfgcdn.com/tu/U4D/"},{"id":11189,"title":"SQL in Action","slug":"sql-in-action","description":"\u003cp\u003eDiscover \u003cstrong\u003eSQL in Action\u003c/strong\u003e with real-world examples demonstrating how SQL queries manage and manipulate data effectively. Learn practical use cases like retrieving, inserting, and updating data to understand SQL's power. Explore detailed examples to enhance your database management skills.\u0026nbsp;\u003cbr\u003e\u003cbr\u003eRead the full article here: \u003ca href=\"https://www.geeksforgeeks.