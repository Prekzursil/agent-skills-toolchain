be.com/geeksforgeeksvideos/"]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"SQL","item":{"@type":"Thing","@id":"https://www.geeksforgeeks.org/category/sql/"}},{"@type":"ListItem","position":2,"name":"sql-tutorial","item":{"@type":"Thing","@id":"https://www.geeksforgeeks.org/sql/sql-tutorial/"}}]}</script><script defer="" src="https://apis.google.com/js/platform.js"></script><title>SQL Tutorial - GeeksforGeeks</title><link rel="profile" href="http://gmpg.org/xfn/11"/><link rel="pingback" href="https://www.geeksforgeeks.org/x lrpc.php"/><script type="application/ld+json">{"@context":"https://schema.org","@type":"VideoObject","name":"Introduction to SQL","description":"In this SQL tutorial, youll learn basic to advanced SQL concepts like queries, joins, and creating tables. SQL, developed by IBM in the 1970s, helps manage data efficiently in databases like MySQL and Oracle. It is a standard query language for database manipulation. Databases store structured data, enabling easy access and management through SQL. nbspRead the full article for detailed examples and concepts here.","thumbnailUrl":["https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804.jpg","https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-seo.png","https://media.geeksforgeeks.org/courses/IntroductiontoSQL/IntroductiontoSQL20250108155804-small.png"],"uploadDate":"2025-01-08T16:10:32Z","duration":"PT0H23M45S","contentUrl":"https://www.geeksforgeeks.org/videos/introduction-to-sql/"}</script><script>
