w-up\",\"href\":\"/server/upgrading\"},{\"group\":\"Monitor\",\"icon\":\"chart-line\",\"pages\":[{\"title\":\"Logging\",\"description\":\"Configure logging for Restate Server.\",\"href\":\"/server/monitoring/logging\"},{\"title\":\"Tracing\",\"description\":\"Export OTEL traces of your invocations.\",\"href\":\"/server/monitoring/tracing\"},{\"title\":\"Metrics\",\"description\":\"Expose Restate Server Prometheus metrics.\",\"href\":\"/server/monitoring/metrics\"}]}]},{\"group\":\"References\",\"pages\":[{\"group\":\"Changelog\",\"expanded\":false,\"pages\":[{\"title\":\"Restate Server changelog\",\"description\":\"Releases of the Restate Server.\",\"sidebarTitle\":\"Restate Server\",\"rss\":true,\"href\":\"/changelog/server\"},{\"title\":\"TypeScript SDK changelog\",\"description\":\"Releases of the TypeScript SDK.\",\"sidebarTitle\":\"TypeScript SDK\",\"rss\":true,\"href\":\"/changelog/typescript-sdk\"},{\"title\":\"Python SDK changelog\",\"description\":\"Releases of the Python SDK.\",\"sidebarTitle\":\"Python SDK\",\"rss\":true,\"href\":\"/changelog/python-sdk\"},{\"title\":\"Java/Kotlin SDK changelog\",\"description\":\"Releases of the Java/Kotlin SDK.\",\"sidebarTitle\":\"Java/Kotlin SDK\",\"rss\":true,\"href\":\"/changelog/java-kotlin-sdk\"},{\"title\":\"Go SDK changelog\",\"description\":\"Releases of the Go SDK.\",\"sidebarTitle\":\"Go SDK\",\"rss\":true,\"href\":\"/changelog/go-sdk\"},{\"title\":\"Rust SDK changelog\",\"description\":\"Releases of the Rust SDK.\",\"sidebarTitle\":\"Rust SDK\",\"rss\":true,\"href\":\"/changelog/rust-sdk\"},{\"title\":\"Kubernetes Operator changelog\",\"description\":\"Releases of the Kubernetes Operator.\",\"sidebarTitle\":\"Kubernetes Operator\",\"rss\":true,\"href\":\"/changelog/operator\"}]},{\"title\":\"Restate Architecture\",\"sidebarTitle\":\"Architecture\",\"description\":\"Restate architecture and distributed deployment concepts\",\"href\":\"/references/architecture\"},{\"title\":\"Restate Server Configuration\",\"description\":\"Reference of the configuration options for Restate Server.\",\"mode\":\"wide\",\"href\":\"/references/server-config\"},{\"title\":\"CLI Configuration\",\"description\":\"Restate CLI configuration options.\",\"href\":\"/references/cli-config\"},{\"title\":\"SQL Introspection API\",\"description\":\"API reference for inspecting the invocation status and service state.\",\"href\":\"/references/sql-introspection\"},{\"title\":\"Error Codes\",\"description\":\"Descriptions of error codes emitted by Restate components\",\"href\":\"/references/errors\"},{\"group\":\"Admin API Reference\",\"pages\":[{\"group\":\"cluster_health\",\"pages\":[{\"title\":\"Cluster state endpoint\",\"description\":null,\"deprecated\":true,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /cluster-health\",\"href\":\"/admin-api/cluster_health/cluster-state-endpoint\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"deployment\",\"pages\":[{\"title\":\"List deployments\",\"description\":\"Returns a list of all registered deployments, including their endpoints and associated services.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /deployments\",\"href\":\"/admin-api/deployment/list-deployments\",\"autogeneratedByOpenApi\":true},{\"title\":\"Register deployment\",\"description\":\"Registers a new deployment (HTTP or Lambda). Restate will invoke the endpoint to discover available services and handlers,\\nand make them available for invocation. For more information, see the [deployment documentation](https://docs.restate.dev/services/versioning#registering-a-deployment).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json post /deployments\",\"href\":\"/admin-api/deployment/register-deployment\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get deployment\",\"description\":\"Returns detailed information about a registered deployment, including deployment metadata and the services it exposes.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /deployments/{deployment}\",\"href\":\"/admin-api/deployment/get-deployment\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete deployment\",\"description\":\"Delete a deployment. Currently, only forced deletions are supported.\\n**Use with caution**: forcing a deployment deletion can break in-flight invocations.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json delete /deployments/{deployment}\",\"href\":\"/admin-api/deployment/delete-deployment\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update deployment\",\"description\":\"Updates an existing deployment configuration, such as the endpoint address or invocation headers.\\nBy default, service schemas are not re-discovered. Set `overwrite: true` to trigger re-discovery.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /deployments/{deployment}\",\"href\":\"/admin-api/deployment/update-deployment\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"health\",\"pages\":[{\"title\":\"Health check endpoint\",\"description\":null,\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /health\",\"href\":\"/admin-api/health/health-check-endpoint\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"invocation\",\"pages\":[{\"title\":\"Delete an invocation\",\"description\":\"Use kill_invocation/cancel_invocation/purge_invocation instead.\",\"deprecated\":true,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json delete /invocations/{invocation_id}\",\"href\":\"/admin-api/invocation/delete-an-invocation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Cancel an invocation\",\"description\":\"Gracefully cancels an invocation. The invocation is terminated, but its progress is persisted, allowing consistency guarantees to be maintained.\\nFor more information, see the [cancellation documentation](https://docs.restate.dev/services/invocation/managing-invocations#cancel).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/cancel\",\"href\":\"/admin-api/invocation/cancel-an-invocation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Kill an invocation\",\"description\":\"Forcefully terminates an invocation. **Warning**: This operation does not guarantee consistency for virtual object instance state,\\nin-flight invocations to other services, or other side effects. Use with caution.\\nFor more information, see the [cancellation documentation](https://docs.restate.dev/services/invocation/managing-invocations#kill).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/kill\",\"href\":\"/admin-api/invocation/kill-an-invocation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Pause an invocation\",\"description\":null,\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/pause\",\"href\":\"/admin-api/invocation/pause-an-invocation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Purge a completed invocation\",\"description\":\"Deletes all state associated with a completed invocation, including its journal and metadata.\\nThis operation only applies to invocations that have already completed. For more information,\\nsee the [purging documentation](https://docs.restate.dev/services/invocation/managing-invocations#purge).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/purge\",\"href\":\"/admin-api/invocation/purge-a-completed-invocation\",\"autogeneratedByOpenApi\":true},{\"title\":\"Purge invocation journal\",\"description\":\"Deletes only the journal entries for a completed invocation, while retaining its metadata.\\nThis operation only applies to invocations that have already completed.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/purge-journal\",\"href\":\"/admin-api/invocation/purge-invocation-journal\",\"autogeneratedByOpenApi\":true},{\"title\":\"Restart invocation as new\",\"description\":\"Creates a new invocation from a completed invocation, optionally copying partial progress from the original invocation's journal.\\nThe new invocation will have a different invocation ID. Use the `from` parameter to specify how much of the original journal to preserve.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/restart-as-new\",\"href\":\"/admin-api/invocation/restart-invocation-as-new\",\"autogeneratedByOpenApi\":true},{\"title\":\"Resume an invocation\",\"description\":\"Resumes a paused or suspended invocation. If the invocation is backing off due to a retry, this will immediately trigger the retry.\\nOptionally, you can change the deployment ID that will be used when the invocation resumes. For more information see [resume documentation](https://docs.restate.dev/services/invocation/managing-invocations#resume)\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /invocations/{invocation_id}/resume\",\"href\":\"/admin-api/invocation/resume-an-invocation\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"kafka_cluster\",\"pages\":[{\"title\":\"List Kafka clusters\",\"description\":\"Returns a list of all registered Kafka clusters.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /kafka-clusters\",\"href\":\"/admin-api/kafka_cluster/list-kafka-clusters\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create Kafka cluster\",\"description\":\"Registers a new Kafka cluster configuration that can be referenced by subscriptions.\\nThe cluster configuration is validated to ensure required broker properties are present.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json post /kafka-clusters\",\"href\":\"/admin-api/kafka_cluster/create-kafka-cluster\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get Kafka cluster\",\"description\":\"Returns the details of a specific Kafka cluster, including its configuration properties.\\nSensitive properties (passwords, secrets, etc.) are automatically redacted in the response.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /kafka-clusters/{cluster_name}\",\"href\":\"/admin-api/kafka_cluster/get-kafka-cluster\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete Kafka cluster\",\"description\":\"Deletes a Kafka cluster. By default, deletion is prevented if subscriptions reference the cluster.\\nUse the force parameter to allow deletion with orphaned subscriptions.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json delete /kafka-clusters/{cluster_name}\",\"href\":\"/admin-api/kafka_cluster/delete-kafka-cluster\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update Kafka cluster\",\"description\":\"Updates the configuration properties of an existing Kafka cluster.\\nSensitive properties (passwords, secrets, etc.) are automatically redacted in the response.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /kafka-clusters/{cluster_name}\",\"href\":\"/admin-api/kafka_cluster/update-kafka-cluster\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"rule\",\"pages\":[{\"title\":\"Upsert a batch of rules.\",\"description\":\"Each entry carries an optional [`Precondition`]. Setting it to\\n`DoesNotExist` makes the entry a strict insert; `Matches(v)` rejects\\nthe batch unless the rule's current version is `v`; omitting it\\n(`None`) is unconditional. The whole batch is atomic: any failed\\nprecondition or cap-exceeded condition rolls back the rest.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json put /limits/rules\",\"href\":\"/admin-api/rule/upsert-a-batch-of-rules\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a batch of rules by pattern.\",\"description\":\"Each entry may carry an `expected_version`; if present the rule\\nmust exist at that exact version, otherwise the batch fails.\\nWithout `expected_version` the delete is unconditional and\\nidempotent: a pattern that's already absent is silently skipped.\\nReturns the patterns that this batch actually removed.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json post /limits/rules/bulk-delete\",\"href\":\"/admin-api/rule/delete-a-batch-of-rules-by-pattern\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"introspection\",\"pages\":[{\"title\":\"Query the system and service state by using SQL.\",\"description\":null,\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json post /query\",\"href\":\"/admin-api/introspection/query-the-system-and-service-state-by-using-sql\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"service\",\"pages\":[{\"title\":\"List services\",\"description\":\"Returns a list of all registered services, including their metadata and configuration.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /services\",\"href\":\"/admin-api/service/list-services\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get service\",\"description\":\"Returns detailed metadata about a specific service, including its type, handlers, and configuration settings.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /services/{service}\",\"href\":\"/admin-api/service/get-service\",\"autogeneratedByOpenApi\":true},{\"title\":\"Modify service configuration\",\"description\":\"Updates the configuration of a registered service, such as public visibility, retention policies, and timeout settings.\\nNote: Service re-discovery will update these settings based on the service endpoint configuration.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json patch /services/{service}\",\"href\":\"/admin-api/service/modify-service-configuration\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get service OpenAPI definition\",\"description\":\"Returns the OpenAPI 3.1 specification for the service, describing all handlers and their request/response schemas.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /services/{service}/openapi\",\"href\":\"/admin-api/service/get-service-openapi-definition\",\"autogeneratedByOpenApi\":true},{\"title\":\"Modify service state\",\"description\":\"Modifies the K/V state of a Virtual Object. For a detailed description of this API and how to use it, see the [state documentation](https://docs.restate.dev/operate/invocation#modifying-service-state).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json post /services/{service}/state\",\"href\":\"/admin-api/service/modify-service-state\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"service_handler\",\"pages\":[{\"title\":\"List service handlers\",\"description\":\"Returns a list of all handlers (methods) available in the specified service.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /services/{service}/handlers\",\"href\":\"/admin-api/service_handler/list-service-handlers\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get service handler\",\"description\":\"Returns detailed metadata about a specific handler within a service, including its input/output types and handler type.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /services/{service}/handlers/{handler}\",\"href\":\"/admin-api/service_handler/get-service-handler\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"subscription\",\"pages\":[{\"title\":\"List subscriptions\",\"description\":\"Returns a list of all registered subscriptions, optionally filtered by source or sink.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /subscriptions\",\"href\":\"/admin-api/subscription/list-subscriptions\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create subscription\",\"description\":\"Creates a new subscription that connects an event source (e.g., a Kafka topic) to a Restate service handler.\\nFor more information, see the [subscription documentation](https://docs.restate.dev/operate/invocation#managing-kafka-subscriptions).\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json post /subscriptions\",\"href\":\"/admin-api/subscription/create-subscription\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get subscription\",\"description\":\"Returns the details of a specific subscription, including its source, sink, and configuration options.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /subscriptions/{subscription}\",\"href\":\"/admin-api/subscription/get-subscription\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete subscription\",\"description\":\"Deletes a subscription. This will stop events from the source from being forwarded to the sink.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json delete /subscriptions/{subscription}\",\"href\":\"/admin-api/subscription/delete-subscription\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"version\",\"pages\":[{\"title\":\"Get version information\",\"description\":\"Returns the server version, supported Admin API versions, and the advertised ingress endpoint.\",\"deprecated\":null,\"version\":null,\"openapi\":\"/schemas/openapi-admin.json get /version\",\"href\":\"/admin-api/version/get-version-information\",\"autogeneratedByOpenApi\":true}]}]},{\"title\":\"Typescript API\",\"url\":\"https://restatedev.github.io/sdk-typescript/\",\"description\":null,\"href\":\"/references/tsdocs\"},{\"title\":\"Javadocs\",\"url\":\"https://restatedev.github.io/sdk-java/javadocs/\",\"description\":null,\"href\":\"/references/javadocs\"},{\"title\":\"KotlinDocs\",\"url\":\"https://restatedev.github.io/sdk-java/ktdocs/\",\"description\":null,\"href\":\"/references/ktdocs\"},{\"title\":\"Go API\",\"url\":\"https://pkg.go.dev/github.com/restatedev/sdk-go\",\"description\":null,\"href\":\"/references/gopkg\"}]}]},{\"tab\":\"Guides\",\"icon\":\"book\",\"pages\":[{\"title\":\"Guides\",\"href\":\"/guides\"}]},{\"tab\":\"Roadmap\",\"icon\":\"map\",\"pages\":[{\"title\":\"Roadmap\",\"href\":\"/roadmap/oss\"}]},{\"tab\":\"AI / Agents\",\"icon\":\"robot\",\"pages\":[{\"title\":\"AI / Agents\",\"href\":\"/ai\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L4a\"}]\n"])</script><script>self.__next_f.push([1,"4b:I[27201,[\"/mintlify-assets/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\"],\"IconMark\"]\n"])</script><script>self.__next_f.push([1,"4c:I[763509,[\"/mintlify-assets/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/d5b07934098b610d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0890ba15c670d9b1.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/8778b596bb8e1fac.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0285713793f685da.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/3df48e92ab491c72.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/cfd727ba62f1c54c.js?dpl=dpl_6FYZ3SECAF7eWA496xdt