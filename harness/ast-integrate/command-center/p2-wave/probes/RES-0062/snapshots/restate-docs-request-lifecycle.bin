sDisabled\":false,\"jsFiles\":[{\"_id\":\"68ecb3ff5e79d9f3b1d0ee41\",\"subdomain\":\"restate-6d46e1dc\",\"filePath\":\"commonroom.js\",\"__v\":0,\"content\":\"(function() {\\n    if (typeof window === 'undefined') return;\\n    if (typeof window.signals !== 'undefined') return;\\n    var script = document.createElement('script');\\n    script.src = 'https://cdn.cr-relay.com/v1/site/c63d3c5e-80ca-48f9-ba3a-a476008f8932/signals.js';\\n    script.async = true;\\n    window.signals = Object.assign(\\n    [],\\n    ['page', 'identify', 'form'].reduce(function (acc, method){\\n    acc[method] = function () {\\n    signals.push([method, arguments]);\\n    return signals;\\n};\\n    return acc;\\n}, {})\\n    );\\n    document.head.appendChild(script);\\n})();\"},{\"_id\":\"68ecb3ff5e79d9f3b1d0eec2\",\"filePath\":\"matomo.js\",\"subdomain\":\"restate-6d46e1dc\",\"__v\":0,\"content\":\"var _paq = window._paq = window._paq || [];\\n/* tracker methods like \\\"setCustomDimension\\\" should be called before \\\"trackPageView\\\" */\\n_paq.push([\\\"setDocumentTitle\\\", document.domain + \\\"/\\\" + document.title]);\\n_paq.push([\\\"setCookieDomain\\\", \\\"*.restate.dev\\\"]);\\n_paq.push([\\\"setDoNotTrack\\\", true]);\\n_paq.push([\\\"disableCookies\\\"]);\\n_paq.push(['trackPageView']);\\n_paq.push(['enableLinkTracking']);\\n(function() {\\n    var u=\\\"https://restatedev.matomo.cloud/\\\";\\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\\n    _paq.push(['setSiteId', '1']);\\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\\n    g.async=true; g.src='https://cdn.matomo.cloud/restatedev.matomo.cloud/matomo.js'; s.parentNode.insertBefore(g,s);\\n})();\"},{\"_id\":\"68ecb3ff5e79d9f3b1d0ef68\",\"subdomain\":\"restate-6d46e1dc\",\"filePath\":\"scarf.js\",\"__v\":0,\"content\":\"const img = document.createElement('img');\\nimg.referrerPolicy = 'no-referrer-when-downgrade';\\nimg.src = 'https://scarf.restate.dev/a.png?x-pxid=792a64ae-afe4-487d-9eb6-5dacca7dd248';\\ndocument.body.appendChild(img);\"}]}]\n"])</script><script>self.__next_f.push([1,"5c:T14e9,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={li:`li`,p:`p`,ul:`ul`,..._provideComponents(),...props.components},{Heading}=_components;if(!Heading)_missingMdxReference(`Heading`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`This guide provides a detailed technical walkthrough of how Restate processes requests from start to finish, including the mechanisms that enable durable execution and failure recovery.`}),`\n`,_jsx(Heading,{level:`2`,id:`request-processing-lifecycle`,children:`Request Processing Lifecycle`}),`\n`,_jsx(_components.p,{children:`When Restate receives a request to invoke a handler, it follows this detailed process:`}),`\n`,_jsx(Heading,{level:`3`,id:`1-persist-request`,children:`1. Persist Request`}),`\n`,_jsx(_components.p,{children:`Restate persists the request and creates a new execution journal for this invocation. From this point, Restate guarantees that it will process the request to completion, even in the face of failures.`}),`\n`,_jsx(Heading,{level:`3`,id:`2-forward-to-service`,children:`2. Forward to Service`}),`\n`,_jsx(_components.p,{children:`Restate opens a bidirectional streaming connection (HTTP/2) to the service for which the request is meant. This connection will be used to stream messages back and forth between the Server and the SDK. It then forwards the request to the service.`}),`\n`,_jsx(Heading,{level:`3`,id:`3-invoke-handler`,children:`3. Invoke Handler`}),`\n`,_jsx(_components.p,{children:`The Restate SDK, embedded in the service, calls the handler with the request data and a context object that provides access to Restate features like state management, service calls, and timers.`}),`\n`,_jsx(Heading,{level:`3`,id:`4-track-execution`,children:`4. Track Execution`}),`\n`,_jsx(_components.p,{children:`As the handler runs, it uses the Restate Context to call other services, update state, or perform side effects. The Restate SDK under-the-hood sends a message to the Restate server for each Context operation. The Restate Server then records it in the execution journal.`}),`\n`,_jsx(Heading,{level:`3`,id:`5-handle-failures`,children:`5. Handle Failures`}),`\n`,_jsx(_components.p,{children:`If the handler crashes or fails, Restate either loses the connection or receives an error message. In this case, the Restate Server will send a retry request to the service, including the latest journal.`}),`\n`,_jsx(_components.p,{children:`Failure detection mechanisms:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Connection between Server and service dropped`}),`\n`,_jsx(_components.li,{children:`Explicit error messages (not terminal errors)`}),`\n`,_jsx(_components.li,{children:`Inactivity timeouts reached`}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`6-replay-journal`,children:`6. Replay Journal`}),`\n`,_jsx(_components.p,{children:`The service receives the retry request and restarts the execution of the handler. Whenever the handler performs an action on the Restate context (like calling another service, updating state, or setting a timer), the SDK checks the journal for the last recorded result. If it finds a previous result, it skips executing that action and uses the recorded result instead. This way, the handler resumes from exactly where it left off.`}),`\n`,_jsx(Heading,{level:`3`,id:`7-complete-execution`,children:`7. Complete Execution`}),`\n`,_jsx(_components.p,{children:`Once the handler completes successfully, the Restate SDK proxies the result back to the client via the Restate Server. The server then marks the invocation as complete in the journal.`}),`\n`,_jsx(Heading,{level:`2`,id:`cross-service-interactions`,children:`Cross-service interactions`}),`\n`,_jsx(_components.p,{children:`Note that inter-handler communication between two durable handlers goes through Restate (not direct service-to-service). The caller appends an invocation event to its journal, which Restate Server turns into an invocation for the target service, providing end-to-end idempotency.`}),`\n`,_jsx(Heading,{level:`2`,id:`request-response-deployment-targets`,children:`Request-response Deployment Targets`}),`\n`,_jsx(_components.p,{children:`Some deployment targets don’t support bidirectional streaming connections (HTTP/2), such as AWS Lambda. In these cases, the Restate SDK uses a request-response pattern (HTTP/1.1) instead.`}),`\n`,_jsx(_components.p,{children:`In this case, the SDK will try to make as much progress as possible.\nWhen it hits a point where it needs to wait for a response (like a service call, sleep, or run action), it will send the new journal entries to the Restate Server and suspend the execution.\nThe server will send a retry request once the response is available.\nExecution then resumes by replaying the journal up to the suspension point.`})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L5a\",null,{\"slug\":\"guides/request-lifecycle\",\"pageMetadata\":\"$19:props:children:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5b\",null,{\"mdxSource\":{\"compiledSource\":\"$5c\",\"frontmatter\":{},\"scope\":{\"pageMetadata\":{\"title\":\"Request Lifecycle\",\"description\":\"Deep dive into the lifecycle of a request in Restate\",\"tags\":[\"development\"],\"href\":\"/guides/request-lifecycle\"},\"config\":{}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.restate.dev\"}]}]\n"])</script></body></html>