{
  "schema_version": 1,
  "dispatcher": "command-center/p2-wave/probes/TST-0086/dispatch.py",
  "event_vocabulary": [
    "SessionStart",
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse"
  ],
  "hooks": [
    {
      "id": "hook.session-start",
      "event": "SessionStart",
      "matcher": "*",
      "interpreter": "python3",
      "script": "hooks/session_start.py",
      "enabled": true,
      "may_block": false
    },
    {
      "id": "hook.prompt-submit",
      "event": "UserPromptSubmit",
      "matcher": "*",
      "interpreter": "python3",
      "script": "hooks/prompt_submit.py",
      "enabled": true,
      "may_block": false
    },
    {
      "id": "hook.pre-tool",
      "event": "PreToolUse",
      "matcher": "*",
      "interpreter": "python3",
      "script": "hooks/pre_tool.py",
      "enabled": true,
      "may_block": false
    },
    {
      "id": "hook.post-tool",
      "event": "PostToolUse",
      "matcher": "*",
      "interpreter": "python3",
      "script": "hooks/post_tool.py",
      "enabled": true,
      "may_block": false
    },
    {
      "id": "hook.danger-block",
      "event": "PreToolUse",
      "matcher": "Bash",
      "interpreter": "python3",
      "script": "hooks/danger_block.py",
      "enabled": true,
      "may_block": true
    }
  ]
}
