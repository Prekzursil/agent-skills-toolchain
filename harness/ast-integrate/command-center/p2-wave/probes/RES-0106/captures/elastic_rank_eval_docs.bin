      <div id="operation-rank-eval-path" class="properties-list highlight-container">
    <h4 class="properties-list-title">
      <span class="anchor-link">
  <a data-after="URL Copied" data-action="click-&gt;highlight#highlightFromAnchor" href="/docs/api/doc/elasticsearch/operation/operation-rank-eval#operation-rank-eval-path">
