{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/schema/artifact-envelope.json",
  "title": "Artifact envelope (canonical id, digest, size, schema ref, registration)",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "artifact_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "artifact_id",
    "producing_unit",
    "sha256",
    "bytes",
    "schema_ref",
    "sentinel",
    "retention_class",
    "registered"
  ],
  "properties": {
    "artifact_id": {
      "$ref": "#/$defs/artifact_id"
    },
    "producing_unit": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bytes": {
      "$ref": "#/$defs/byte_size"
    },
    "schema_ref": {
      "type": "string",
      "minLength": 8
    },
    "sentinel": {
      "type": "string",
      "minLength": 8
    },
    "retention_class": {
      "type": "string",
      "enum": ["ephemeral", "standard", "archival"]
    },
    "registered": {
      "type": "boolean",
      "const": true
    },
    "evidence_anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
