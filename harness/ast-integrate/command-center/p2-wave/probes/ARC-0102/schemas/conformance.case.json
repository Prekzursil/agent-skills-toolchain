{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/schema/conformance-case.json",
  "title": "Conformance case wrapping an artifact envelope (two-hop $ref)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "envelope", "verdict"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "envelope": {
      "$ref": "https://ast-integrate.invalid/schema/artifact-envelope.json"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    }
  }
}
