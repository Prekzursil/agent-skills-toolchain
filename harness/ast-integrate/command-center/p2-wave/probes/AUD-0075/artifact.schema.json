{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/AUD-0075/artifact.schema.json",
  "title": "AUD-0075 stale-premise sweep (audit-finding)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "answer",
    "headline",
    "facts",
    "controls",
    "named_probes",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "AUD-0075" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "report_kind": { "type": "string", "const": "audit-finding" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "headline": { "type": "object" },
    "facts": { "type": "array", "minItems": 12 },
    "controls": { "type": "object" },
    "named_probes": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 4 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
