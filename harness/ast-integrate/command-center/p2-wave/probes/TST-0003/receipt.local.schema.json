{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0003/receipt.local.schema.json",
  "title": "TST-0003 test-receipt live contract",
  "$comment": "Pivot from command-center/schema/test-receipt.schema.json. That shim $ref targets https://ast-integrate.invalid/platform/schema/artifact-class-profiles.schema.json which jsonschema 4.10.3 Draft7Validator fetches over the network and raises RefResolutionError. A second attempt on that same fingerprint is a grind; this file is the named required_fix for live emit on this worktree. It is NOT a rewrite of the catalog output_schema path.",
  "type": "object",
  "required": [
    "schema_version",
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "spec_anchor",
    "min_bytes_threshold",
    "call_sites",
    "column_hashes",
    "hashes_agree",
    "identity_ok",
    "evaluate_is_shared",
    "matrix",
    "tests",
    "negative_controls",
    "negative_control_skip_c8",
    "reviewer",
    "evidence",
    "artifacts",
    "report"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "unit_id": { "const": "TST-0003" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:TST-0003" },
    "completion_sentinel": { "const": "SUCCESS:TST-0003" },
    "question": { "type": "string", "minLength": 80 },
    "answer": { "type": "string", "minLength": 80 },
    "spec_anchor": { "type": "string", "minLength": 8 },
    "min_bytes_threshold": { "type": "integer", "minimum": 128 },
    "call_sites": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string", "minLength": 1 }
    },
    "column_hashes": {
      "type": "object",
      "required": [
        "local_runner",
        "cloud_dispatcher",
        "monitor",
        "harvester",
        "workflow_fan_in",
        "cross_vendor_adapter",
        "final_synthesis"
      ],
      "additionalProperties": false,
      "properties": {
        "local_runner": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cloud_dispatcher": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "monitor": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "harvester": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "workflow_fan_in": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cross_vendor_adapter": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_synthesis": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "hashes_agree": { "const": true },
    "distinct_column_hash_count": { "const": 1 },
    "identity_ok": { "const": true },
    "evaluate_is_shared": { "const": true },
    "matrix": {
      "type": "object",
      "required": ["n_rows", "n_sites", "row_ids", "site_ids", "cells"],
      "properties": {
        "n_rows": { "const": 13 },
        "n_sites": { "const": 7 },
        "row_ids": { "type": "array", "minItems": 13, "maxItems": 13 },
        "site_ids": { "type": "array", "minItems": 7, "maxItems": 7 },
        "cells": { "type": "array", "minItems": 13, "maxItems": 13 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": { "const": "PASS" },
          "exit_code": { "const": 0 }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad_state", "silent_on_good_state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fired_on_bad_state": { "const": true },
          "silent_on_good_state": { "const": true }
        }
      }
    },
    "negative_control_skip_c8": {
      "type": "object",
      "required": ["patched_site", "skipped_condition", "turns_red"],
      "properties": {
        "patched_site": { "const": "monitor" },
        "skipped_condition": { "const": 8 },
        "turns_red": { "const": true }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "verdict": { "const": "PASS" },
        "independent": { "const": true }
      }
    },
    "evidence": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 },
    "report": {
      "type": "object",
      "required": ["kind", "observations", "control_ids"],
      "properties": {
        "kind": { "const": "test-receipt" },
        "observations": { "type": "array", "minItems": 1 },
        "control_ids": { "type": "array", "minItems": 1 }
      }
    }
  }
}
