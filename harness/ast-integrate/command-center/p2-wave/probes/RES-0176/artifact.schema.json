{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0176/artifact.schema.json",
  "title": "RES-0176 LangGraph vs CrewAI vs AutoGen ecosystem teardown (local stand-in; declared command-center/schema/ecosystem-teardown.schema.json is absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "answer",
    "frameworks",
    "claims",
    "transfer_verdicts",
    "negative_control",
    "hardness",
    "tests",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0176" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:RES-0176" },
    "report_kind": { "type": "string", "const": "ecosystem-teardown" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "frameworks": { "type": "array", "minItems": 3 },
    "claims": { "type": "array", "minItems": 3 },
    "transfer_verdicts": { "type": "array", "minItems": 3 },
    "negative_control": {
      "type": "object",
      "required": [
        "abstraction",
        "transferable",
        "runtime_service"
      ],
      "properties": {
        "abstraction": { "type": "string", "minLength": 8 },
        "transferable": { "type": "boolean", "const": false },
        "runtime_service": { "type": "string", "minLength": 8 }
      }
    },
    "hardness": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["independent", "reviewer_id", "verdict"],
      "properties": {
        "independent": { "type": "boolean" },
        "reviewer_id": { "type": "string" },
        "verdict": { "type": "string" }
      }
    }
  }
}
