{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0152/pack-contract.schema.json",
  "title": "WFA-0152 pack-contract (declared foundry-artifact.schema.json#/$defs/pack-contract is absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answers",
    "pack_contents",
    "versioning",
    "publication",
    "lineage_carry_through",
    "tests",
    "evidence",
    "negative_controls",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0152" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0152" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "required": [
        "what_pack_contains",
        "version_bump_requires",
        "install_rollback_resolves_lineage"
      ],
      "properties": {
        "what_pack_contains": { "type": "string", "minLength": 40 },
        "version_bump_requires": { "type": "string", "minLength": 40 },
        "install_rollback_resolves_lineage": { "type": "boolean", "const": true }
      }
    },
    "pack_contents": { "type": "object" },
    "versioning": { "type": "object" },
    "publication": { "type": "object" },
    "lineage_carry_through": { "type": "object" },
    "tests": { "type": "array", "minItems": 2 },
    "evidence": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
