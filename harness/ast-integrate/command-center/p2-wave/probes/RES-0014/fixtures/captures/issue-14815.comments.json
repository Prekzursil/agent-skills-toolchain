u/111552463?v=4","gravatar_id":"","url":"https://api.github.com/users/yzavyas","html_url":"https://github.com/yzavyas","followers_url":"https://api.github.com/users/yzavyas/followers","following_url":"https://api.github.com/users/yzavyas/following{/other_user}","gists_url":"https://api.github.com/users/yzavyas/gists{/gist_id}","starred_url":"https://api.github.com/users/yzavyas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yzavyas/subscriptions","organizations_url":"https://api.github.com/users/yzavyas/orgs","repos_url":"https://api.github.com/users/yzavyas/repos","events_url":"https://api.github.com/users/yzavyas/events{/privacy}","received_events_url":"https://api.github.com/users/yzavyas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-01-11T16:31:29Z","updated_at":"2026-01-11T16:31:29Z","body":"**Update:** Workaround confirmed working.\n\nSessionStart hook with `type: command` (not `type: prompt`) successfully injects context at session start.\n\nExample: https://github.com/yzavyas/claude-1337/blob/main/plugins/core-1337/hooks/session-start.sh","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/issues/comments/3734965057/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/anthropics/claude-code/issues/comments/3735187199","html_url":"https://github.com/anthropics/claude-code/issues/14815#issuecomment-3735187199","issue_url":"https://api.github.com/repos/anthropics/claude-code/issues/14815","id":3735187199,"node_id":"IC_kwDON91aY87eom7_","user":{"login":"kaldown","id":3754017,"node_id":"MDQ6VXNlcjM3NTQwMTc=","avatar_url":"https://avatars.githubusercontent.com/u/3754017?v=4","gravatar_id":"","url":"https://api.github.com/users/kaldown","html_url":"https://github.com/kaldown","followers_url":"h