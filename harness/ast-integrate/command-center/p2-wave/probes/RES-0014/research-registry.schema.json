{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/RES-0014/research-registry.schema.json",
  "title": "RES-0014 matched-issue registry (unit-local discriminating contract)",
  "$comment": "Catalog output_schema command-center/schema/research-registry.schema.json is a generated shim with no top-level required. This file is the executable contract for THIS unit only. Do not copy these keys into the shared shim (ADV rebuild circle).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "detector_control",
    "matched_issues",
    "non_matches",
    "claims",
    "evidence_rails",
    "reviewer",
    "tests",
    "answer",
    "matched_issue_table_text"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0014" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "detector_control": {
      "type": "object",
      "required": [
        "seeded_token",
        "present_state_retrieves_seed",
        "absent_state_misses_seed",
        "pass",
        "decoy_must_not_match"
      ]
    },
    "matched_issues": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "issue_ref",
          "verdict",
          "discriminating_observation",
          "upstream_reproduction",
          "local_reproduction",
          "rails"
        ]
      }
    },
    "non_matches": { "type": "array", "minItems": 1 },
    "claims": { "type": "array", "minItems": 1 },
    "evidence_rails": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"]
    },
    "tests": { "type": "array", "minItems": 2 },
    "answer": { "type": "string", "minLength": 40 },
    "matched_issue_table_text": { "type": "string", "minLength": 40 }
  }
}
