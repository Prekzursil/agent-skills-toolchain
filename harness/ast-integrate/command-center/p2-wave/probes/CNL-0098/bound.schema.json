{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/CNL-0098/bound.schema.json",
  "title": "CNL-0098 detector-spec discriminator (unit-local)",
  "$comment": "Catalog output_schema is a generated $ref shim. jsonschema 4.10 on this image cannot resolve ast-integrate.invalid without network (RefResolutionError, not ValidationError). This bound schema is the discrimination contract for this unit: garbage rejected, numeric false-positive rate, required both-states/detector fields. Do not treat an adjective rate as valid.",
  "type": "object",
  "required": [
    "answer",
    "both_states",
    "claims",
    "detector",
    "detector_control",
    "evidence",
    "false_positive_rate",
    "negative_control",
    "pathologies",
    "production_modules",
    "reviewer",
    "sentinel",
    "state",
    "unit_id"
  ],
  "properties": {
    "unit_id": { "const": "CNL-0098" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:CNL-0098" },
    "false_positive_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "false_positive_rate_breakdown": {
      "type": "object",
      "required": ["rate", "fires", "clean_fixtures_total"],
      "properties": {
        "rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "fires": { "type": "integer", "minimum": 0 },
        "clean_fixtures_total": { "type": "integer", "minimum": 1 }
      }
    },
    "detector": {
      "type": "object",
      "required": ["id", "does_not_count_urls", "empty_support_graph"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "does_not_count_urls": { "const": true },
        "empty_support_graph": { "const": "NOT-CHECKED" },
        "support_edge_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["planted", "clean", "detector_control"],
      "properties": {
        "planted": {
          "type": "object",
          "required": ["status", "verbatim"],
          "properties": {
            "status": { "const": "FIRE" },
            "verbatim": { "type": "string", "minLength": 1 }
          }
        },
        "clean": {
          "type": "object",
          "required": ["status", "verbatim"],
          "properties": {
            "status": { "const": "SILENT" },
            "verbatim": { "type": "string", "minLength": 1 }
          }
        },
        "detector_control": {
          "type": "object",
          "required": ["status", "verbatim"],
          "properties": {
            "status": { "const": "FIRE" },
            "verbatim": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "detector_control": {
      "type": "object",
      "required": [
        "known_present_run_first",
        "fired_before_absence_reported",
        "verbatim"
      ],
      "properties": {
        "known_present_run_first": { "const": true },
        "fired_before_absence_reported": { "const": true },
        "verbatim": { "type": "string", "minLength": 1 }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "independent",
        "scope_not_agreement",
        "both_states_rerun",
        "added_failure_mode",
        "verdict"
      ],
      "properties": {
        "independent": { "const": true },
        "scope_not_agreement": { "const": true },
        "both_states_rerun": { "const": true },
        "vendor_constraint_met": { "const": false },
        "verdict": { "const": "PASS" },
        "added_failure_mode": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "const": "FM-SEMANTIC-UNGROUNDED" }
          }
        }
      }
    },
    "production_modules": {
      "type": "object",
      "required": ["argument_graph_py", "evidence_map_py"],
      "properties": {
        "argument_graph_py": {
          "type": "object",
          "required": ["path", "present"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "present": { "type": "boolean" }
          }
        },
        "evidence_map_py": {
          "type": "object",
          "required": ["path", "present"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "present": { "type": "boolean" }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "line", "snippet", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "snippet": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pathologies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string" },
          "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED", "NOT-CHECKED"] },
          "defect_locus": { "type": "string" }
        },
        "if": { "properties": { "verdict": { "const": "REFUTED" } }, "required": ["verdict"] },
        "then": { "required": ["defect_locus"] }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["verbatim"],
      "properties": {
        "verbatim": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": true
}
