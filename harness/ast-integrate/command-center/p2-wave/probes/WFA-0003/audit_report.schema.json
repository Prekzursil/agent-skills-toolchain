{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0003/audit_report.schema.json",
  "title": "WFA-0003 AuditReport (local; declared pack is WFA-0001)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "kind",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "inputs",
    "signal_a",
    "signal_b",
    "historical_mnn_control",
    "absent_ids",
    "pinned_collision_statement",
    "planted_control",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0003" },
    "kind": { "type": "string", "const": "AuditReport" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0003" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "inputs": { "type": "array", "minItems": 5 },
    "signal_a": {
      "type": "object",
      "required": ["intersecting_count", "intersecting_tokens", "method"],
      "properties": {
        "method": { "type": "string", "minLength": 8 },
        "intersecting_count": { "type": "integer", "minimum": 0 },
        "intersecting_tokens": { "type": "array" }
      }
    },
    "signal_b": {
      "type": "object",
      "required": ["semantic_clash_count", "method"],
      "properties": {
        "method": { "type": "string", "minLength": 8 },
        "semantic_clash_count": { "type": "integer", "minimum": 0 }
      }
    },
    "historical_mnn_control": {
      "type": "object",
      "required": ["zero_identical_titles", "semantic_clash_count"],
      "properties": {
        "zero_identical_titles": { "type": "boolean", "const": true },
        "semantic_clash_count": { "type": "integer", "minimum": 1 }
      }
    },
    "absent_ids": { "type": "array", "minItems": 7 },
    "pinned_collision_statement": {
      "type": "object",
      "required": ["stale", "classification"],
      "properties": {
        "stale": { "type": "boolean", "const": true },
        "classification": { "type": "string", "minLength": 4 }
      }
    },
    "planted_control": {
      "type": "object",
      "required": ["pass"],
      "properties": {
        "pass": { "type": "boolean", "const": true }
      }
    },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": {
      "type": "object",
      "required": ["verdict", "independent"],
      "properties": {
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
