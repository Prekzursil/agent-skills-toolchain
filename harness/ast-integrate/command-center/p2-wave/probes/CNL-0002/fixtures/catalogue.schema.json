{
  "$defs": {
    "preset_record": {
      "additionalProperties": false,
      "properties": {
        "bound_protocol": {
          "minLength": 3,
          "type": "string"
        },
        "id": {
          "minLength": 3,
          "type": "string"
        },
        "roles": {
          "type": "array"
        },
        "status": {
          "minLength": 1,
          "type": "string"
        },
        "stopping": {},
        "title": {
          "type": "string"
        },
        "voting": {}
      },
      "required": [
        "id",
        "status",
        "bound_protocol"
      ],
      "type": "object"
    },
    "protocol_record": {
      "additionalProperties": false,
      "properties": {
        "anti_failure": {},
        "artifacts": {},
        "audit": {},
        "bound_preset_ids": {
          "type": "array"
        },
        "budgets": {},
        "consensus": {},
        "description": {},
        "discovery_only": {
          "type": "boolean"
        },
        "evidence": {},
        "execution": {},
        "id": {
          "minLength": 3,
          "type": "string"
        },
        "integrity": {},
        "name": {},
        "outcomes": {},
        "protocol_class": {},
        "roles": {
          "type": "array"
        },
        "seats": {},
        "status": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {}
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    }
  },
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/CNL-0002/fixtures/catalogue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "presets": {
      "items": {
        "$ref": "#/$defs/preset_record"
      },
      "minItems": 1,
      "type": "array"
    },
    "protocols": {
      "items": {
        "$ref": "#/$defs/protocol_record"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_relationship": {
      "type": "string"
    },
    "spec_ref": {
      "additionalProperties": false,
      "properties": {
        "edge": {
          "const": "typed-reference"
        },
        "schema_id": {
          "minLength": 8,
          "type": "string"
        },
        "target_kind": {
          "const": "council-charter-v1"
        }
      },
      "required": [
        "schema_id",
        "edge",
        "target_kind"
      ],
      "type": "object"
    }
  },
  "required": [
    "protocols",
    "presets",
    "spec_ref"
  ],
  "title": "Protocol/preset catalogue (not a Council Charter)",
  "type": "object"
}
