1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">compliance</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>enum&lt;string&gt; | null</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">Enterprise-only compliance mode. Set to <code node="[object Object]"><span>hipaa</span></code> for HIPAA mode. Requires cache-only retrieval with supported parameters. See the HIPAA docs for details.</p></div><div class="whitespace-pre-wrap prose-sm mt-6">Available options<!-- -->:<!-- --> <div class="inline-block"><code>hipaa</code> </div></div><div class="flex prose prose-sm prose-gray dark:prose-invert mt-6 gap-1.5"><span>Example<!-- -->:</span><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2 overflow-wrap-anywhere text-[13px] [&amp;_*]:text-[13px]"><p class="whitespace-pre-line"><code node="[object Object]"><span>"hipaa"</span></code></p></div></div></div></div></div><div class="object-param-field border-gray-100 