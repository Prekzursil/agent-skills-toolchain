fault highlights, or { query } to guide selection with your own query.\",\"minimum\":1,\"deprecated\":true,\"example\":1,\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1.numSentences.oneOf.0\",\"typeLabel\":\"integer\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1.numSentences.oneOf.1\",\"typeLabel\":\"null\"}],\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1.numSentences\",\"typeLabel\":\"integer | null\"},\"highlightsPerUrl\":{\"oneOf\":[{\"type\":\"integer\",\"description\":\"Deprecated and will be removed in a future release. Currently ignored. Pass highlights: true for default highlights, or { query } to guide selection with your own query.\",\"minimum\":1,\"deprecated\":true,\"example\":1,\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1.highlightsPerUrl.oneOf.0\",\"typeLabel\":\"integer\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1.highlightsPerUrl.oneOf.1\",\"typeLabel\":\"null\"}],\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1.highlightsPerUrl\",\"typeLabel\":\"integer | null\"}},\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.1\",\"typeLabel\":\"Advanced highlights options · object\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.highlights.oneOf.2\",\"typeLabel\":\"null\"}],\"uniqueKey\":\"contents.oneOf.0.highlights\",\"typeLabel\":\"boolean | Advanced highlights options · object | null\"},\"summary\":{\"oneOf\":[{\"type\":\"object\",\"description\":\"Summary of the webpage.\",\"properties\":{\"query\":{\"oneOf\":[{\"type\":\"string\",\"description\":\"Custom query for the LLM-generated summary.\",\"example\":\"Main developments\",\"uniqueKey\":\"contents.oneOf.0.summary.oneOf.0.query.oneOf.0\",\"typeLabel\":\"string\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.summary.oneOf.0.query.oneOf.1\",\"typeLabel\":\"null\"}],\"uniqueKey\":\"contents.oneOf.0.summary.oneOf.0.query\",\"typeLabel\":\"string | null\"},\"schema\":{\"oneOf\":[{\"type\":\"object\",\"description\":\"JSON