:root.dark .connect-provider-cards img[src*="financialdatasets.svg"],
html.dark .connect-provider-cards img[src*="financialdatasets.svg"] {
  filter: brightness(0) invert(1);
}

.llm-ctx {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.compact-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  margin-top: 0.5rem;
  margin-bottom: 1.5rem;
}

.compact-cards a {
  display: block;
  border-radius: 0.375rem;
  border: 1px solid var(--border-color, #e5e7eb);
  padding: 0.625rem 0.75rem;
  text-decoration: none !important;
  transition: border-color 0.15s;
}

.compact-cards a:hover {
  border-color: var(--primary, #0765d9);
}

.compact-cards .title {
  display: block;
  font-weight: 600;
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.compact-cards .desc {
  display: block;
  font-size: 0.75rem;
  line-height: 1rem;
  color: #6b7280;
  margin-top: 0.125rem;
}

.callout-box {
  border-left: 6px solid var(--docs-callout-accent) !important;
  border-radius: 0 2px 2px 0 !important;
  padding: 1.25rem 1.5rem;
  margin-top: 1.5rem;
  margin-bottom: 2rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 0 0 0 1px var(--docs-callout-outline);
}

:root.dark .callout-box,
.dark .callout-box {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3), 0 0 0 1px var(--docs-callout-outline);
}

.callout-box .callout-title {
  font-family: "ABCDiatype", sans-serif;
  font-size: 1.25rem;
