dding-left: 1.75rem;\n  transition: max-height 0.25s ease;\n}\n\n.eb-toggle:checked ~ .eb-content {\n  max-height: 800px;\n}\n\n.eb-toggle:checked + .eb-label::before {\n  transform: rotate(90deg);\n  color: var(--primary, #0765d9);\n}\n\n.eb-content \u003e div {\n  margin-top: 0 !important;\n  margin-bottom: 0.25rem !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n}\n\n.eb-content table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.875rem;\n  margin-top: 0;\n  margin-bottom: 0.5rem;\n}\n\n.eb-content th,\n.eb-content td {\n  text-align: left;\n  padding: 0.5rem 0.75rem;\n  border-bottom: 1px solid var(--border-color, #e5e7eb);\n}\n\n.eb-content th {\n  font-weight: 600;\n  color: #6b7280;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.eb-content td code {\n  font-size: 0.8125rem;\n  background: #f3f4f6;\n  padding: 0.125rem 0.375rem;\n  border-radius: 0.25rem;\n}\n\n.eb-content \u003e p,\n.eb-content \u003e span {\n  display: block !important;\n  font-size: 0.875rem !important;\n  text-transform: none !important;\n  letter-spacing: 0.01em;\n  color: #374151 !important;\n  font-weight: 600 !important;\n  margin-top: 1rem !important;\n  margin-bottom: -0.25rem !important;\n  font-family: inherit !important;\n}\n\n.eb-content \u003e span strong {\n  font-size: inherit !important;\n  color: inherit !important;\n  font-weight: inherit !important;\n}\n\n.steps-list {\n  list-style: none;\n  padding-left: 0;\n  margin: 2rem 0;\n  margin-left: 0.875rem;\n}\n\n.steps-list li {\n  position: relative;\n  padding-left: 2rem;\n  padding-bottom: 1.25rem;\n}\n\n.steps-list li:last-child {\n  padding-bottom: 0;\n}\n\n.step-number {\n  position: absolute;\n  left: 0;\n  width: 1.75rem;\n  height: 1.75rem;\n  border-radius: 50%;\n  background-color: #f3f4f6;\n  color: #6b7280;\n  font-size: 0.875rem;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-left: -0.8125rem;\n  flex-shrink: 0;\n  z-index: 1;\n}\n\n.step-line {\n  position: absolute;\n  left: 0;\n  width: 1px;\n  height: calc(100% - 2rem);\n  top: 2rem;\n  background-color: #e5e7eb;\n}\n\n.steps-list li:last-child .step-line {\n  background: linear-gradient(to bottom, #e5e7eb, transparent);\n}\n\n.step-title {\n  font-weight: 600;\n  margin-bottom: 0.5rem;\n  font-size: 1.125rem;\n}\n\n.step-content {\n  margin-top: 0.5rem;\n  color: #6b7280;\n  font-size: 1rem;\n}\n\n.dark .step-number {\n  background-color: #374151;\n  color: #9ca3af;\n}\n\n.dark .step-line {\n  background-color: #4b5563;\n}\n\n.dark .steps-list li:last-child .step-line {\n  background: linear-gradient(to bottom, #4b5563, transparent);\n}\n\n.dark .step-content {\n  color: #d1d5db;\n}\n\n.api-button {\n  align-items: center;\n  background: rgb(var(--primary));\n  color: var(--white, #fff);\n  display: flex;\n  text-transform: uppercase;\n  font-size: 16px;\n  font-style: normal;\n  font-weight: 400;\n  gap: 10px;\n  height: 40px;\n  justify-content: center;\n  line-height: 27px;\n  padding: 14px 32px;\n  text-decoration: none;\n  transition: 0.1s ease-in-out;\n  border: 2px solid var(--primary);\n  word-spacing: 8px;\n  letter-spacing: 1px;\n}\n\n.api-button:hover {\n  background-color: #000000;\n}\n\n.endpoint-link {\n  font-size: 1.15em !important;\n  font-weight: 500 !important;\n  letter-spacing: -0.03em !important;\n}\n\n.eval-tab-radio {\n  display: none;\n}\n\n.eval-tab-labels {\n  display: flex;\n  gap: 0;\n  border-bottom: 1px solid var(--border-color, #e5e7eb);\n  margin-bottom: 0;\n}\n\n.eval-tab-label {\n  padding: 0.5rem 1rem;\n  cursor: pointer;\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: #6b7280;\n  border-bottom: 2px solid transparent;\n  margin-bottom: -1px;\n  transition: color 0.15s, border-color 0.15s;\n}\n\n.eval-tab-label:hover {\n  color: #111827;\n}\n\n#eval-accuracy:checked ~ .eval-tab-labels label[for=\"eval-accuracy\"],\n#eval-latency:checked ~ .eval-tab-labels label[for=\"eval-latency\"],\n#eval-verticals:checked ~ .eval-tab-labels label[for=\"eval-verticals\"] {\n  color: var(--primary, #0765d9);\n  border-bottom-color: var(--primary, #0765d9);\n}\n\n.eval-panel {\n  display: none;\n}\n\n.eval-panel img {\n  width: 100%;\n  border-radius: 0.5rem;\n  border: 1px solid var(--border-color, #e5e7eb);\n}\n\n#eval-accuracy:checked ~ .eval-panel-accuracy,\n#eval-latency:checked ~ .eval-panel-latency,\n#eval-verticals:checked ~ .eval-panel-verticals {\n  display: block;\n}\n\n/* Pydantic blog callout: override the default card hover accent to Pydantic purple. */\na[href=\"https://pydantic.dev/articles/harness-exa\"]:hover {\n  border-color: #e520e9 !important;\n}\n"])</script><script>self.__next_f.push([1,"4d:[\"$\",\"$L4f\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$50\"}}],[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L51\",null,{\"pageMetadata\":\"$19:props:pageMetadata\"}]],[\"$\",\"$L52\",null,{\"pageMetadata\":\"$19:props:pageMetadata\"}],[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"styles.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$53\"}}],\"$L54\"],\"$L55\",\"$L56\"]}]\n"])</script><script>self.__next_f.push([1,"57:I[36098,[\"/docs/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/1ead5edfe5ae6eee.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/0890ba15c670d9b1.js?dp