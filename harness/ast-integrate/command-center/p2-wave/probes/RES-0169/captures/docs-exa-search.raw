,\"metadata\":{\"timestamp\":true},\"styling\":{\"latex\":false,\"codeblocks\":\"system\"},\"navigation\":{\"global\":{\"anchors\":[]},\"pages\":[]}},\"docsNavWithMetadata\":{\"global\":{\"anchors\":[]},\"tabs\":[{\"tab\":\"Documentation\",\"groups\":[{\"group\":\"API\",\"pages\":[{\"group\":\"Search\",\"pages\":[{\"title\":\"Exa Search API\",\"sidebarTitle\":\"For humans\",\"description\":\"Exa is an SF-based research lab building perfect search.\",\"href\":\"/reference/search-api-guide\"},{\"title\":\"Search API Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference with best practices and examples for coding agents\",\"href\":\"/reference/search-api-guide-for-coding-agents\"},{\"title\":\"Search Best Practices\",\"sidebarTitle\":\"Best Practices\",\"description\":\"Best practices for using Exa's Search API\",\"href\":\"/reference/search-best-practices\"}]},{\"group\":\"Contents\",\"pages\":[{\"title\":\"Contents API\",\"sidebarTitle\":\"For humans\",\"description\":\"Extract clean, LLM-ready web content.\",\"href\":\"/reference/contents-api-guide\"},{\"title\":\"Contents API Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Best practices, examples, and API reference for your coding agent\",\"href\":\"/reference/contents-api-guide-for-coding-agents\"},{\"title\":\"Contents Best Practices\",\"sidebarTitle\":\"Best Practices\",\"description\":\"Best practices for using Exa's Contents API\",\"href\":\"/reference/contents-best-practices\"}]},{\"group\":\"Agent\",\"pages\":[{\"title\":\"Exa Agent\",\"sidebarTitle\":\"For Humans\",\"description\":\"Run deep research, list-building, and enrichment workflows that return structured outputs.\",\"href\":\"/reference/agent-api-guide\"},{\"title\":\"Examples\",\"description\":\"Production Exa Agent examples for list building, KYB intelligence, job postings, and structured outputs.\",\"href\":\"/reference/agent-api/examples\"}]},{\"group\":\"Websets\",\"pages\":[{\"title\":\"Websets\",\"sidebarTitle\":\"For humans\",\"description\":\"Find anything on the web, no matter how complex. Websets searches, verifies, and enriches results automatically.\",\"href\":\"/websets/api-guide\"},{\"title\":\"Websets Reference (For Your Coding Agent)\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference for coding agents. Websets API architecture, request/response shapes, event flow, and integration patterns.\",\"href\":\"/websets/api-guide-for-coding-agents\"},{\"title\":\"How Websets Works\",\"description\":null,\"href\":\"/websets/api/how-it-works\"},{\"title\":\"How to Use Imports\",\"description\":\"A step-by-step guide to importing URLs into Websets -- enriching your list, scoring it against criteria, discovering new matches, and combining all three.\",\"href\":\"/websets/imports-and-search\"},{\"title\":\"FAQ\",\"description\":\"Frequently asked questions about Websets\",\"href\":\"/websets/faq\"},{\"title\":\"Websets Best Practices\",\"sidebarTitle\":\"Best Practices\",\"description\":\"Best practices for building with the Websets API\",\"href\":\"/websets/best-practices\"},{\"group\":\"Dashboard\",\"pages\":[{\"title\":\"Get started\",\"description\":\"Welcome to the Websets Dashboard! Find anything you want on the web, no matter how complex.\",\"href\":\"/websets/dashboard/get-started\"},{\"title\":\"Example queries\",\"description\":\"Here are some examples for things to search for, to get you started!\",\"href\":\"/websets/dashboard/websets-example-queries\"},{\"title\":\"Criteria vs Enrichments\",\"description\":null,\"href\":\"/websets/dashboard/criteria-versus-enrichments\"},{\"title\":\"Import from CSV\",\"description\":\"Turn your existing CSV data into a Webset\",\"href\":\"/websets/dashboard/import-from-csv\"},{\"title\":\"Exclude Results\",\"description\":\"Avoid duplicate results in your new searches by excluding URLs from previous Websets or CSV files.\",\"href\":\"/websets/dashboard/exclude-results\"},{\"title\":\"Integrations\",\"description\":\"Connect your Websets with popular CRM and email tools\",\"href\":\"/websets/dashboard/integrations\"}]},{\"group\":\"Videos\",\"pages\":[{\"title\":\"Creating Enrichments \",\"description\":\"Here's how to create enrichments (also known as Adding Columns). \",\"href\":\"/websets/dashboard/walkthroughs/Creating-enrichments\"},{\"title\":\"Exploring your results \",\"description\":\"Explore your Websets matched results, view summaries, criteria justification \",\"href\":\"/websets/dashboard/walkthroughs/Exploring-your-results\"},{\"title\":\"Adding and Managing Your Team Members in Websets\",\"description\":\"Here's how to manage your team.\",\"href\":\"/websets/dashboard/walkthroughs/Managing-Team-Members\"},{\"title\":\"Prompting Websets\",\"description\":\"Here's how to prompt your query in Websets\",\"href\":\"/websets/dashboard/walkthroughs/Prompting\"},{\"title\":\"Downloading and Sharing Your Results\",\"description\":\"Here's how to share or download your results and enrichments.\",\"href\":\"/websets/dashboard/walkthroughs/Sharing-and-Downloading-Your-Results\"}]}]},{\"group\":\"Monitors\",\"pages\":[{\"title\":\"Monitors\",\"sidebarTitle\":\"For humans\",\"description\":\"Schedule recurring Exa searches and get results delivered to your webhook.\",\"href\":\"/reference/monitors-api-guide\"},{\"title\":\"Monitors API Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference with all endpoints, parameters, and examples for coding agents.\",\"href\":\"/reference/monitors-api-guide-for-coding-agents\"}]}]},{\"group\":\"Data\",\"pages\":[{\"group\":\"Exa Connect\",\"pages\":[{\"title\":\"Exa Connect\",\"sidebarTitle\":\"Quickstart\",\"description\":\"Give your Exa Agent live access to premium data partners, alongside Exa web search, in a single run.\",\"href\":\"/reference/agent-api/connect/overview\"},{\"group\":\"Self-Serve Providers\",\"pages\":[{\"title\":\"Fiber.ai\",\"description\":\"Search Fiber.ai's B2B database for companies, people, and LinkedIn profiles.\",\"href\":\"/reference/agent-api/connect/fiber\"},{\"title\":\"Similarweb\",\"description\":\"Get website traffic estimates, global rankings, and competitor discovery.\",\"href\":\"/reference/agent-api/connect/similarweb\"},{\"title\":\"Baselayer\",\"description\":\"Verify US businesses and retrieve KYB data: officers, registrations, risk scores.\",\"href\":\"/reference/agent-api/connect/baselayer\"},{\"title\":\"Affiliate.com\",\"description\":\"Search product catalogs across merchants and affiliate networks.\",\"href\":\"/reference/agent-api/connect/affiliatecom\"},{\"title\":\"Particle\",\"description\":\"Search podcast transcripts with speaker attribution and timestamps.\",\"href\":\"/reference/agent-api/connect/particle\"},{\"title\":\"Financial Datasets\",\"description\":\"Structured financial and market data for 27,000+ active and delisted U.S. tickers, including prices, fundamentals, earnings, SEC filings, ownership, and stock screening.\",\"href\":\"/reference/agent-api/connect/financialdatasets\"},{\"title\":\"Jinko\",\"description\":\"Flight and Hotel search with real-time pricing.\",\"href\":\"/reference/agent-api/connect/jinko\"}]},{\"title\":\"Combining providers\",\"description\":\"Use several data partners together in a single Exa Agent run.\",\"href\":\"/reference/agent-api/connect/combining-providers\"},{\"title\":\"Additional providers\",\"description\":\"Exa Connect partners beyond the self-serve provider set.\",\"href\":\"/reference/agent-api/connect/additional-partners\"}]},{\"group\":\"People\",\"pages\":[{\"title\":\"People Search\",\"sidebarTitle\":\"For humans\",\"description\":null,\"href\":\"/reference/verticals/people\"},{\"title\":\"People Search Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference for coding agents using Exa People Search\",\"href\":\"/reference/verticals/people-for-coding-agents\"}]},{\"group\":\"Company\",\"pages\":[{\"title\":\"Company Search\",\"sidebarTitle\":\"For humans\",\"description\":null,\"href\":\"/reference/verticals/company\"},{\"title\":\"Company Search Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference for coding agents using Exa Company Search\",\"href\":\"/reference/verticals/company-for-coding-agents\"}]},{\"group\":\"Code\",\"pages\":[{\"title\":\"Code Search\",\"sidebarTitle\":\"For humans\",\"description\":null,\"href\":\"/reference/verticals/code\"},{\"title\":\"Code Search Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference for coding agents using Exa Code Search\",\"href\":\"/reference/verticals/code-for-coding-agents\"}]},{\"group\":\"News\",\"pages\":[{\"title\":\"News Search\",\"sidebarTitle\":\"For humans\",\"description\":null,\"href\":\"/reference/verticals/news\"},{\"title\":\"News Search Reference\",\"sidebarTitle\":\"For your coding agent\",\"description\":\"Self-contained reference for coding agents using Exa News Search\",\"href\":\"/reference/verticals/news-for-coding-agents\"}]}]},{\"group\":\"MCP\",\"pages\":[{\"title\":\"Web Search MCP\",\"description\":\"Complete setup guide for Exa MCP Server. Connect Claude Desktop, Cursor, VS Code, and 10+ AI assistants to Exa's web search, fetching, Exa Agent, and Exa Connect tools.\",\"sidebarTitle\":\"Exa MCP\",\"href\":\"/reference/exa-mcp\"},{\"group\":\"Agent Skills\",\"pages\":[{\"title\":\"Agent Skills\",\"description\":\"Install Exa agent skills into Claude Code, Cursor, Codex, or any Agent Skills–compatible coding agent.\",\"keywords\":[\"agent skills\",\"claude code\",\"cursor\",\"codex\",\"exa api\"],\"href\":\"/reference/agent-skills\"},{\"title\":\"Build with Exa\",\"description\":\"Build applications and agents with Exa's full API platform: search, contents, answer, context, Agent API, monitors, websets, and the SDKs.\",\"keywords\":[\"build with exa\",\"agent skills\",\"exa api\",\"sdk\"],\"href\":\"/reference/agent-skills/build-with-exa\"},{\"title\":\"Company Research\",\"description\":\"Deep company research with the Exa Agent API — funding, competitors, tech stack, news — plus quick company-category lookups with Advanced Search.\",\"keywords\":[\"company research\",\"agent skills\",\"exa agent\",\"company search\"],\"href\":\"/reference/agent-skills/company-research\"},{\"title\":\"Lead Generation\",\"description\":\"Generate enriched, ICP-scored lead lists as CSV using the Exa Agent API.\",\"keywords\":[\"lead generation\",\"agent skills\",\"exa agent\",\"icp\"],\"href\":\"/reference/agent-skills/lead-generation\"},{\"title\":\"Exa Search\",\"description\":\"Call Exa Search directly with cURL or raw HTTP — semantic search, ranked results, filters, freshness, and structured output.\",\"keywords\":[\"exa search\",\"agent skills\",\"curl\",\"http\"],\"href\":\"/reference/agent-skills/exa-search\"},{\"title\":\"Exa Contents\",\"description\":\"Call Exa Contents directly with cURL or raw HTTP — extracted text, highlights, summaries, links, and subpages from known URLs.\",\"keywords\":[\"exa contents\",\"agent skills\",\"curl\",\"http\"],\"href\":\"/reference/agent-skills/exa-contents\"}]}]},{\"group\":\"SDKs\",\"pages\":[{\"title\":\"Python SDK\",\"sidebarTitle\":\"Python\",\"description\":\"Install and use the Exa Python SDK\",\"href\":\"/sdks/python-sdk\"},{\"title\":\"JavaScript SDK\",\"sidebarTitle\":\"JavaScript\",\"description\":\"Install and use the Exa JavaScript SDK\",\"href\":\"/sdks/javascript-sdk\"},{\"title\":\"Python SDK Specification\",\"description\":\"Enumeration of methods and types in the Exa Python SDK (exa_py).\",\"href\":\"/sdks/python-sdk-specification\"},{\"title\":\"TypeScript SDK Specification\",\"description\":\"Enumeration of methods and types in the Exa TypeScript SDK (exa-js).\",\"href\":\"/sdks/typescript-sdk-specification\"},{\"title\":\"Python and TS Cheat Sheets\",\"description\":\"Some common code you might want to use - don't miss the TypeScript tab below!\",\"href\":\"/sdks/cheat-sheet\"}]},{\"group\":\"Integrations\",\"pages\":[{\"title\":\"Exa in Slack\",\"description\":null,\"href\":\"/reference/exa-slack\"},{\"title\":\"Exa in Codex and ChatGPT\",\"sidebarTitle\":\"ChatGPT \u0026 Codex\",\"description\":\"Search the web, read any page, and research with Exa directly from Codex and ChatGPT.\",\"keywords\":[\"Codex\",\"ChatGPT\",\"OpenAI plugin\",\"Exa MCP\",\"web search\"],\"href\":\"/integrations/chatgpt-codex\"},{\"title\":\"Grok Build\",\"description\":\"Use Exa web search in Grok Build. Install the Exa plugin from the Grok Build marketplace and sign in with your Exa account.\",\"href\":\"/integrations/grok-build\"},{\"group\":\"Tool Calling\",\"pages\":[{\"title\":\"OpenAI Tool Calling\",\"description\":\"Use OpenAI tool calling to add Exa web search to your application.\",\"href\":\"/reference/openai-tool-calling\"},{\"title\":\"Anthropic Tool Calling\",\"description\":\"Use Claude tool use to add Exa web search to your application.\",\"href\":\"/reference/anthropic-tool-calling\"}]},{\"group\":\"AI SDK\",\"pages\":[{\"title\":\"Vercel AI Gateway\",\"description\":\"Use Exa web search through Vercel AI Gateway with the AI SDK.\",\"href\":\"/integrations/vercel-ai-gateway\"},{\"title\":\"AI SDK by Vercel\",\"description\":\"Add Exa web search to AI SDK applications with the @exalabs/ai-sdk package.\",\"href\":\"/reference/vercel\"}]},{\"group\":\"OpenAI SDK\",\"pages\":[{\"title\":\"OpenAI SDK Compatibility\",\"description\":\"Use Exa's endpoints as a drop-in replacement for OpenAI - supporting both chat completions and responses APIs.\",\"href\":\"/reference/openai-sdk\"},{\"title\":\"OpenAI Responses API\",\"description\":\"Use Exa with OpenAI's Responses API - both as a web search tool and for direct research capabilities.\",\"href\":\"/reference/openai-responses-api-with-exa\"}]},{\"title\":\"Browserbase\",\"description\":\"Combine Exa company search with Browserbase browser automation for job application workflows.\",\"href\":\"/integrations/browserbase\"},{\"title\":\"LangChain\",\"description\":\"How to use Exa's integration with LangChain to perform RAG.\",\"href\":\"/reference/langchain\"},{\"title\":\"Pydantic AI\",\"description\":\"Give a Pydantic AI agent web research tools backed by the Exa search API.\",\"href\":\"/reference/pydantic-ai\"},{\"title\":\"CrewAI\",\"description\":\"Learn how to add Exa retrieval capabilities to your CrewAI agents.\",\"href\":\"/reference/crewai\"},{\"title\":\"LlamaIndex\",\"description\":\"A quick-start guide on how to add Exa retrieval to a LlamaIndex Agent Application.\",\"href\":\"/reference/llamaindex\"},{\"title\":\"Exa for Google Sheets\",\"description\":\"Use Exa Agent and Exa formulas inside Google Sheets.\",\"href\":\"/reference/exa-for-sheets\"},{\"title\":\"Snowflake\",\"description\":\"Use Exa search and content retrieval from Snowflake stored procedures and Cortex Agents.\",\"href\":\"/integrations/snowflake\"},{\"title\":\"ElevenLabs\",\"description\":\"Add Exa web search to ElevenLabs voice agents.\",\"href\":\"/integrations/elevenlabs\"},{\"title\":\"OpenHuman\",\"description\":\"Give the OpenHuman agent live web search with Exa, either managed or with your own Exa API key.\",\"href\":\"/integrations/openhuman\"},{\"title\":\"TrueFoundry\",\"description\":\"Connect Exa to the TrueFoundry MCP Gateway for centralized access controls, tool management, and usage monitoring.\",\"href\":\"/integrations/truefoundry\"},{\"title\":\"Stripe Projects\",\"sidebarTitle\":\"Stripe Projects\",\"description\":\"Integrate Exa from your terminal using the Stripe Projects CLI.\",\"href\":\"/reference/stripe-projects\"}]},{\"group\":\"Agentic payments\",\"pages\":[{\"group\":\"x402\",\"pages\":[{\"title\":\"Pay with x402\",\"sidebarTitle\":\"x402 Payments\",\"description\":\"Use Exa's Search and Contents APIs without an API key. Pay per request with USDC on Base or Solana via the x402 protocol.\",\"href\":\"/reference/x402-guide\"},{\"title\":\"World AgentKit\",\"sidebarTitle\":\"World AgentKit\",\"description\":\"Let verified human-backed AI agents access Exa for free using World AgentKit — no USDC needed.\",\"href\":\"/reference/x402-agentkit-free-trial\"}]},{\"group\":\"MPP\",\"pages\":[{\"title\":\"Pay with MPP (Tempo)\",\"sidebarTitle\":\"MPP Payments\",\"description\":\"Call Exa's Search and Contents APIs without an API key by paying per request with USDC.e on Tempo.\",\"href\":\"/reference/mpp-guide\"},{\"title\":\"Tempo MPP GTM Enrichment Cookbook\",\"sidebarTitle\":\"GTM enrichment with MPP\",\"description\":\"Build a GTM enrichment workflow that pays per Exa search and contents request with Tempo MPP — no API key required.\",\"href\":\"/reference/tempo-mpp-gtm-enrichment-cookbook\"}]},{\"title\":\"Nevermined\",\"sidebarTitle\":\"Nevermined\",\"description\":\"Autonomous agent payments for Exa via Nevermined x402 card delegation. A 7 USD purchase provisions or tops up an Exa API key with 7 USD of credits.\",\"href\":\"/integrations/nevermined\"}]},{\"group\":\"Admin\",\"pages\":[{\"title\":\"Managing Your Team\",\"description\":\"Details on Team structure and account management for the Exa platform\",\"href\":\"/reference/setting-up-team\"},{\"title\":\"Pricing\",\"description\":\"Pay-as-you-go rates for Exa Search, Contents, Answer, Monitors, and the Agent API\",\"keywords\":[\"pricing\",\"cost\",\"rates\",\"credits\",\"billing\",\"agent compute units\"],\"href\":\"/reference/pricing\"},{\"title\":\"Billing\",\"description\":\"How billing, auto recharge, and invoices work on Exa's API\",\"href\":\"/reference/billing\"},{\"title\":\"Rate Limits\",\"description\":\"Default rate limits for Exa API endpoints\",\"href\":\"/reference/rate-limits\"},{\"title\":\"Error Codes\",\"description\":\"Reference for common error codes used by the Exa API\",\"href\":\"/reference/error-codes\"},{\"group\":\"Security\",\"pages\":[{\"title\":\"Enterprise Documentation \u0026 Security\",\"description\":null,\"href\":\"/reference/security\"},{\"title\":\"HIPAA\",\"description\":\"Use HIPAA compliance mode for eligible cached retrieval requests.\",\"href\":\"/reference/security/hipaa\"}]}]},{\"group\":\"Additional Resources\",\"pages\":[{\"title\":\"OpenAPI Specification\",\"description\":null,\"href\":\"/reference/openapi-spec\"},{\"title\":\"Context (Exa Code)\",\"description\":\"Get relevant code snippets and examples from open source libraries and repositories. Search through code repositories to find contextual examples that help developers understand how specific libraries, frameworks, or programming concepts are implemented in practice.\",\"boost\":0.3,\"href\":\"/reference/context\"},{\"title\":\"Content Freshness\",\"description\":null,\"href\":\"/reference/livecrawling-contents\"},{\"title\":\"Migrating from Bing\",\"description\":\"Guide for switching from the deprecated Bing Search API to Exa\",\"href\":\"/reference/migrating-from-bing\"},{\"title\":\"Make Exa Your Default Search Engine\",\"description\":\"Simple steps to set exa.ai as your browser's default search engine\",\"href\":\"/reference/set-exa-as-default-search\"},{\"title\":\"Building a Voice Agent with Exa\",\"description\":\"Best practices for building AI voice agents powered by Exa's real-time search\",\"href\":\"/examples/voice-agent\"},{\"title\":\"FAQs\",\"description\":null,\"href\":\"/reference/faqs\"},{\"title\":\"Blog\",\"icon\":\"pen-to-square\",\"url\":\"https://exa.ai/blog\",\"description\":null,\"href\":\"/reference/blog\"}]}]},{\"tab\":\"API Reference\",\"groups\":[{\"group\":\"Search\",\"pages\":[{\"title\":\"Search\",\"description\":\"The search endpoint lets you search the web and extract contents from the results.\",\"openapi\":\"post /search\",\"timestamp\":false,\"href\":\"/reference/search\"},{\"title\":\"Contents\",\"description\":\"Get the full page contents, summaries, and metadata for a list of URLs.\\n\\nReturns instant results from our cache, with automatic live crawling as fallback for uncached pages.\",\"openapi\":\"post /contents\",\"timestamp\":false,\"href\":\"/reference/get-contents\"},{\"title\":\"Answer\",\"description\":\"Get an LLM answer to a question informed by Exa search results. `/answer` performs an Exa search and uses an LLM to generate either:\\n1. A direct answer for specific queries. (i.e. \\\"What is the capital of France?\\\" would return \\\"Paris\\\")\\n2. A detailed summary with citations for open-ended queries (i.e. \\\"What is the state of ai in healthcare?\\\" would return a summary with citations to relevant sources)\\n\\nThe response includes both the generated answer and the sources used to create it. The endpoint also supports streaming (as `stream=True`), which will return tokens as they are generated.\\n\\nAlternatively, you can use the OpenAI compatible [chat completions interface](/docs/reference/openai-sdk#answer).\\n\",\"openapi\":\"post /answer\",\"timestamp\":false,\"href\":\"/reference/answer\"}]},{\"group\":\"Agent\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Agent runs asynchronous, multi-step web research, list-building, and enrichment workflows with natural-language answers, structured outputs, and citations.\",\"timestamp\":false,\"href\":\"/reference/agent-api/overview\"},{\"title\":\"Create a run\",\"description\":\"Create an asynchronous Agent run. The response returns the run object immediately unless you request server-sent events.\",\"openapi\":\"post /agent/runs\",\"timestamp\":false,\"href\":\"/reference/agent-api/create-a-run\"},{\"title\":\"Get a run\",\"description\":\"Retrieve an Agent run by ID.\",\"openapi\":\"get /agent/runs/{id}\",\"timestamp\":false,\"href\":\"/reference/agent-api/get-a-run\"},{\"title\":\"List runs\",\"description\":\"Retrieve a paginated list of Agent runs for your team.\",\"openapi\":\"get /agent/runs\",\"timestamp\":false,\"href\":\"/reference/agent-api/list-runs\"},{\"title\":\"Cancel a run\",\"description\":\"Cancel a queued or running Agent run.\",\"openapi\":\"post /agent/runs/{id}/cancel\",\"timestamp\":false,\"href\":\"/reference/agent-api/cancel-a-run\"},{\"title\":\"Delete a run\",\"description\":\"Delete a stored Agent run.\",\"openapi\":\"delete /agent/runs/{id}\",\"timestamp\":false,\"href\":\"/reference/agent-api/delete-a-run\"},{\"title\":\"List run events\",\"description\":\"List stored Agent run events or replay them as server-sent events.\",\"openapi\":\"get /agent/runs/{id}/events\",\"timestamp\":false,\"href\":\"/reference/agent-api/list-run-events\"}]},{\"group\":\"Websets\",\"pages\":[{\"group\":\"Websets\",\"icon\":\"folder\",\"pages\":[{\"openapi\":\"post /v0/websets\",\"timestamp\":false,\"title\":\"Create a Webset\",\"description\":\"Creates a new Webset with optional search, import, and enrichment configurations. The Webset will automatically begin processing once created.\\n\\nYou can specify an `externalId` to reference the Webset with your own identifiers for easier integration.\",\"href\":\"/websets/api/websets/create-a-webset\"},{\"openapi\":\"get /v0/websets/{id}\",\"timestamp\":false,\"title\":\"Get a Webset\",\"description\":null,\"href\":\"/websets/api/websets/get-a-webset\"},{\"openapi\":\"post /v0/websets/{id}\",\"timestamp\":false,\"title\":\"Update a Webset\",\"description\":null,\"href\":\"/websets/api/websets/update-a-webset\"},{\"openapi\":\"delete /v0/websets/{id}\",\"timestamp\":false,\"title\":\"Delete a Webset\",\"description\":\"Deletes a Webset.\\n\\nOnce deleted, the Webset and all its Items will no longer be available.\",\"href\":\"/websets/api/websets/delete-a-webset\"},{\"openapi\":\"post /v0/websets/preview\",\"timestamp\":false,\"title\":\"Preview a webset\",\"description\":\"Preview how a search query will be decomposed before creating a webset. This endpoint performs the same query analysis that happens during webset creation, allowing you to see the detected entity type, generated search criteria, and available enrichment columns in advance.\\n\\nUse this to help users understand how their search will be interpreted before committing to a full webset creation.\",\"href\":\"/websets/api/websets/preview-a-webset\"},{\"openapi\":\"post /v0/websets/{id}/cancel\",\"timestamp\":false,\"title\":\"Cancel a running Webset\",\"description\":\"Cancels all operations being performed on a Webset.\\n\\nAny enrichment or search will be stopped and the Webset will be marked as `idle`.\",\"href\":\"/websets/api/websets/cancel-a-running-webset\"},{\"openapi\":\"get /v0/websets\",\"timestamp\":false,\"title\":\"List all Websets\",\"description\":\"Returns a list of Websets.\\n\\nYou can paginate through the results using the `cursor` parameter.\\n\\nYou can filter results using the `search` parameter to find Websets by ID, external ID, or title.\",\"href\":\"/websets/api/websets/list-all-websets\"}]},{\"group\":\"Items\",\"icon\":\"list\",\"pages\":[{\"openapi\":\"get /v0/websets/{webset}/items/{id}\",\"timestamp\":false,\"title\":\"Get an Item\",\"description\":\"Returns a Webset Item.\",\"href\":\"/websets/api/websets/items/get-an-item\"},{\"openapi\":\"delete /v0/websets/{webset}/items/{id}\",\"timestamp\":false,\"title\":\"Delete an Item\",\"description\":\"Deletes an Item from the Webset.\\n\\nThis will cancel any enrichment process for it.\",\"href\":\"/websets/api/websets/items/delete-an-item\"},{\"openapi\":\"get /v0/websets/{webset}/items\",\"timestamp\":false,\"title\":\"List all Items for a Webset\",\"description\":\"Returns a list of Webset Items.\\n\\nYou can paginate through the Items using the `cursor` parameter.\",\"href\":\"/websets/api/websets/items/list-all-items-for-a-webset\"}]},{\"group\":\"Searches\",\"icon\":\"magnifying-glass\",\"pages\":[{\"openapi\":\"post /v0/websets/{webset}/searches\",\"timestamp\":false,\"title\":\"Create a Search\",\"description\":\"Creates a new Search for the Webset.\\n\\nThe default behavior is to reuse the previous Search results and evaluate them against the new criteria.\",\"href\":\"/websets/api/websets/searches/create-a-search\"},{\"openapi\":\"get /v0/websets/{webset}/searches/{id}\",\"timestamp\":false,\"title\":\"Get a Search\",\"description\":\"Gets a Search by id\",\"href\":\"/websets/api/websets/searches/get-a-search\"},{\"openapi\":\"post /v0/websets/{webset}/searches/{id}/cancel\",\"timestamp\":false,\"title\":\"Cancel a running Search\",\"description\":\"Cancels a currently running Search.\\n\\nYou can cancel all searches at once by using the `websets/:webset/cancel` endpoint.\",\"href\":\"/websets/api/websets/searches/cancel-a-running-search\"}]},{\"group\":\"Enrichments\",\"icon\":\"sparkles\",\"pages\":[{\"openapi\":\"post /v0/websets/{webset}/enrichments\",\"timestamp\":false,\"title\":\"Create an Enrichment\",\"description\":\"Create an Enrichment for a Webset.\",\"href\":\"/websets/api/websets/enrichments/create-an-enrichment\"},{\"openapi\":\"get /v0/websets/{webset}/enrichments/{id}\",\"timestamp\":false,\"title\":\"Get an Enrichment\",\"description\":null,\"href\":\"/websets/api/websets/enrichments/get-an-enrichment\"},{\"openapi\":\"patch /v0/websets/{webset}/enrichments/{id}\",\"timestamp\":false,\"title\":\"Update an Enrichment\",\"description\":\"Update an Enrichment configuration for a Webset.\",\"href\":\"/websets/api/websets/enrichments/update-an-enrichment\"},{\"openapi\":\"delete /v0/websets/{webset}/enrichments/{id}\",\"timestamp\":false,\"title\":\"Delete an Enrichment\",\"description\":\"When deleting an Enrichment, any running enrichments will be canceled and all existing `enrichment_result` generated by this Enrichment will no longer be available.\",\"href\":\"/websets/api/websets/enrichments/delete-an-enrichment\"},{\"openapi\":\"post /v0/websets/{webset}/enrichments/{id}/cancel\",\"timestamp\":false,\"title\":\"Cancel a running Enrichment\",\"description\":\"All running enrichments will be canceled. You can not resume an Enrichment after it has been canceled.\",\"href\":\"/websets/api/websets/enrichments/cancel-a-running-enrichment\"}]},{\"group\":\"Imports\",\"icon\":\"cloud-arrow-down\",\"pages\":[{\"openapi\":\"post /v0/imports\",\"timestamp\":false,\"title\":\"Create an Import\",\"description\":\"Creates a new import to upload your data into Websets. Imports can be used to:\\n\\n- **Enrich**: Enhance your data with additional information using our AI-powered enrichment engine\\n- **Search**: Query your data using Websets' agentic search with natural language filters\\n- **Exclude**: Prevent duplicate or already known results from appearing in your searches\\n\\nOnce the import is created, you can upload your data to the returned `uploadUrl` until `uploadValidUntil` (by default 1 hour).\",\"href\":\"/websets/api/imports/create-an-import\"},{\"openapi\":\"get /v0/imports/{id}\",\"timestamp\":false,\"title\":\"Get Import\",\"description\":\"Gets a specific import.\",\"href\":\"/websets/api/imports/get-import\"},{\"openapi\":\"patch /v0/imports/{id}\",\"timestamp\":false,\"title\":\"Update Import\",\"description\":\"Updates a import configuration.\",\"href\":\"/websets/api/imports/update-import\"},{\"openapi\":\"delete /v0/imports/{id}\",\"timestamp\":false,\"title\":\"Delete Import\",\"description\":\"Deletes a import.\",\"href\":\"/websets/api/imports/delete-import\"},{\"openapi\":\"get /v0/imports\",\"timestamp\":false,\"title\":\"List Imports\",\"description\":\"Lists all imports for the Webset.\",\"href\":\"/websets/api/imports/list-imports\"}]},{\"group\":\"Monitors\",\"icon\":\"satellite\",\"pages\":[{\"openapi\":\"post /v0/monitors\",\"timestamp\":false,\"title\":\"Create a Monitor\",\"description\":\"Creates a new `Monitor` to continuously keep your Websets updated with fresh data.\\n\\nMonitors automatically run on your defined schedule to ensure your Websets stay current without manual intervention:\\n\\n- **Find new content**: Execute `search` operations to discover fresh items matching your criteria\\n- **Update existing content**: Run `refresh` operations to update items contents and enrichments\\n- **Automated scheduling**: Configure `cron` expressions and `timezone` for precise scheduling control\",\"href\":\"/websets/api/monitors/create-a-monitor\"},{\"openapi\":\"get /v0/monitors/{id}\",\"timestamp\":false,\"title\":\"Get Monitor\",\"description\":\"Gets a specific monitor.\",\"href\":\"/websets/api/monitors/get-monitor\"},{\"openapi\":\"patch /v0/monitors/{id}\",\"timestamp\":false,\"title\":\"Update Monitor\",\"description\":\"Updates a monitor configuration.\",\"href\":\"/websets/api/monitors/update-monitor\"},{\"openapi\":\"delete /v0/monitors/{id}\",\"timestamp\":false,\"title\":\"Delete Monitor\",\"description\":\"Deletes a monitor.\",\"href\":\"/websets/api/monitors/delete-monitor\"},{\"openapi\":\"get /v0/monitors\",\"timestamp\":false,\"title\":\"List Monitors\",\"description\":\"Lists all monitors for the Webset.\",\"href\":\"/websets/api/monitors/list-monitors\"},{\"group\":\"Monitor Runs\",\"icon\":\"play\",\"pages\":[{\"openapi\":\"get /v0/monitors/{monitor}/runs\",\"timestamp\":false,\"title\":\"List Monitor Runs\",\"description\":\"Lists all runs for the Monitor.\",\"href\":\"/websets/api/monitors/runs/list-monitor-runs\"},{\"openapi\":\"get /v0/monitors/{monitor}/runs/{id}\",\"timestamp\":false,\"title\":\"Get Monitor Run\",\"description\":\"Gets a specific monitor run.\",\"href\":\"/websets/api/monitors/runs/get-monitor-run\"}]}]},{\"group\":\"Webhooks\",\"icon\":\"webhook\",\"pages\":[{\"openapi\":\"post /v0/webhooks\",\"timestamp\":false,\"title\":\"Create a Webhook\",\"description\":null,\"href\":\"/websets/api/webhooks/create-a-webhook\"},{\"openapi\":\"get /v0/webhooks/{id}\",\"timestamp\":false,\"title\":\"Get a Webhook\",\"description\":null,\"href\":\"/websets/api/webhooks/get-a-webhook\"},{\"openapi\":\"patch /v0/webhooks/{id}\",\"timestamp\":false,\"title\":\"Update a Webhook\",\"description\":null,\"href\":\"/websets/api/webhooks/update-a-webhook\"},{\"openapi\":\"delete /v0/webhooks/{id}\",\"timestamp\":false,\"title\":\"Delete a Webhook\",\"description\":null,\"href\":\"/websets/api/webhooks/delete-a-webhook\"},{\"openapi\":\"get /v0/webhooks\",\"timestamp\":false,\"title\":\"List webhooks\",\"description\":null,\"href\":\"/websets/api/webhooks/list-webhooks\"},{\"openapi\":\"get /v0/webhooks/{id}/attempts\",\"timestamp\":false,\"title\":\"List webhook attempts\",\"description\":\"List all attempts made by a Webhook ordered in descending order.\",\"href\":\"/websets/api/webhooks/attempts/list-webhook-attempts\"},{\"title\":\"Verifying Signatures\",\"description\":\"Learn how to securely verify webhook signatures to ensure requests are from Exa\",\"timestamp\":false,\"href\":\"/websets/api/webhooks/verifying-signatures\"}]},{\"group\":\"Events\",\"icon\":\"bell\",\"pages\":[{\"title\":\"Event Types\",\"sidebarTitle\":\"Types\",\"description\":\"Learn about the events that occur within the Webset API\",\"timestamp\":false,\"href\":\"/websets/api/events/types\"},{\"openapi\":\"get /v0/events\",\"timestamp\":false,\"title\":\"List all Events\",\"description\":\"List all events that have occurred in the system.\\n\\nYou can paginate through the results using the `cursor` parameter.\",\"href\":\"/websets/api/events/list-all-events\"},{\"openapi\":\"get /v0/events/{id}\",\"timestamp\":false,\"title\":\"Get an Event\",\"description\":\"Get a single Event by id.\\n\\nYou can subscribe to Events by creating a Webhook.\",\"href\":\"/websets/api/events/get-an-event\"}]},{\"group\":\"Teams\",\"icon\":\"users\",\"pages\":[{\"title\":\"Get Team Info\",\"description\":\"Retrieve information about your team including concurrency usage and limits.\",\"openapi\":\"get /v0/teams/me\",\"timestamp\":false,\"href\":\"/websets/api/teams/get-team-info\"}]}]},{\"group\":\"Monitors\",\"pages\":[{\"openapi\":\"post /monitors\",\"timestamp\":false,\"title\":\"Create a Monitor\",\"description\":\"Creates a new Monitor to run recurring Exa searches on a schedule.\\n\\nMonitors automatically execute your search query on a recurring schedule and deliver results to your webhook endpoint with automatic deduplication:\\n\\n- **Date-based filtering** only fetches content since the last run\\n\\n- **Semantic deduplication** tracks previous outputs to surface only new developments\\n\\nThe response includes a `webhookSecret` that is only returned once at creation time. Store it securely for webhook signature verification.\",\"href\":\"/reference/monitors/create-a-monitor\"},{\"openapi\":\"get /monitors\",\"timestamp\":false,\"title\":\"List Monitors\",\"description\":\"Lists all monitors for the authenticated team. Supports filtering by status and cursor-based pagination.\",\"href\":\"/reference/monitors/list-monitors\"},{\"openapi\":\"get /monitors/{id}\",\"timestamp\":false,\"title\":\"Get a Monitor\",\"description\":\"Retrieves a single monitor by its ID.\",\"href\":\"/reference/monitors/get-a-monitor\"},{\"openapi\":\"patch /monitors/{id}\",\"timestamp\":false,\"title\":\"Update a Monitor\",\"description\":\"Updates an existing monitor. All fields are optional. For `search`, you can send a partial object containing only the fields you want to change. Set `trigger` to `null` to remove the schedule.\",\"href\":\"/reference/monitors/update-a-monitor\"},{\"openapi\":\"delete /monitors/{id}\",\"timestamp\":false,\"title\":\"Delete a Monitor\",\"description\":\"Deletes a monitor. This cannot be undone.\",\"href\":\"/reference/monitors/delete-a-monitor\"},{\"openapi\":\"post /monitors/{id}/trigger\",\"timestamp\":false,\"title\":\"Trigger a Monitor\",\"description\":\"Triggers a run immediately, regardless of the schedule. Works for monitors with status `active` or `paused`.\",\"href\":\"/reference/monitors/trigger-a-monitor\"},{\"openapi\":\"post /monitors/batch\",\"timestamp\":false,\"title\":\"Batch Action on Monitors\",\"description\":\"Perform a batch action on monitors matching the provided filters.\\n\\nSupported actions:\\n- **delete**: Permanently remove matching monitors\\n- **pause**: Pause matching monitors\\n- **unpause**: Unpause matching monitors\\n\\nUse `dry_run: true` (the default) to preview which monitors would be affected before performing the action. Results are paginated via the `limit` parameter; loop until `has_more` is `false` to process all matching monitors.\",\"href\":\"/reference/monitors/batch-monitors\"},{\"group\":\"Runs\",\"pages\":[{\"openapi\":\"get /monitors/{id}/runs\",\"timestamp\":false,\"title\":\"List Runs\",\"description\":\"Lists all runs for a monitor with cursor-based pagination. Runs are returned in reverse chronological order.\",\"href\":\"/reference/monitors/runs/list-runs\"},{\"openapi\":\"get /monitors/{id}/runs/{runId}\",\"timestamp\":false,\"title\":\"Get a Run\",\"description\":\"Retrieves a single run by its ID, including the full output if the run is completed.\",\"href\":\"/reference/monitors/runs/get-a-run\"}]}]},{\"group\":\"Team Management\",\"pages\":[{\"title\":\"Create API Key\",\"description\":\"Create a new API key for your team with optional name and rate limit configuration.\",\"openapi\":\"post /api-keys\",\"timestamp\":false,\"href\":\"/reference/team-management/create-api-key\"},{\"title\":\"List API Keys\",\"description\":\"Retrieve all API keys belonging to your team with their metadata.\",\"openapi\":\"get /api-keys\",\"timestamp\":false,\"href\":\"/reference/team-management/list-api-keys\"},{\"title\":\"Get API Key\",\"description\":\"Retrieve details of a specific API key by its ID.\",\"openapi\":\"get /api-keys/{id}\",\"timestamp\":false,\"href\":\"/reference/team-management/get-api-key\"},{\"title\":\"Get API Key Usage\",\"description\":\"Retrieve usage analytics and billing data for a specific API key.\",\"openapi\":\"get /api-keys/{id}/usage\",\"boost\":0.3,\"timestamp\":false,\"href\":\"/reference/team-management/get-api-key-usage\"},{\"title\":\"Update API Key\",\"description\":\"Update the name and rate limit of an existing API key.\",\"openapi\":\"put /api-keys/{id}\",\"timestamp\":false,\"href\":\"/reference/team-management/update-api-key\"},{\"title\":\"Delete API Key\",\"description\":\"Permanently delete an API key from your team.\",\"openapi\":\"delete /api-keys/{id}\",\"timestamp\":false,\"href\":\"/reference/team-management/delete-api-key\"}]}]},{\"tab\":\"Changelog\",\"groups\":[{\"group\":\"Updates\",\"root\":{\"title\":\"Changelog\",\"description\":\"Product updates and announcements from Exa.\",\"rss\":true,\"timestamp\":false,\"href\":\"/changelog\"},\"pages\":[{\"title\":\"Changelog\",\"description\":\"Product updates and announcements from Exa.\",\"rss\":true,\"timestamp\":false,\"href\":\"/changelog\"}]}]}]},\"anonymizedNav\":\"$undefined\",\"hasFullNav\":true},\"children\":\"$L2b\"}]}]}]}]]}]]}]]\n"])</script><script>self.__next_f.push([1,"2c:I[604804,[\"/docs/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/1ead5edfe5ae6eee.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/0890ba15c670d9b1.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/8778b596bb8e1fac.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/6eca5dd93b4850f1.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/3df48e92ab491c72.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/cfd727ba62f1c54c.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/95810dccb4b634b5.js?dpl=dpl_DKsz4uvMQTpBZTvKv5t