.agent-output-tab-input {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.agent-output-panels {
  height: var(--agent-output-panel-height);
  overflow-x: hidden;
  overflow-y: auto;
  scrollbar-gutter: stable;
}

.agent-output-panel {
  display: none;
  min-height: 100%;
}

#agent-output-tab-findall:checked ~ .agent-output-panels .agent-output-panel-findall,
#agent-output-tab-kyb:checked ~ .agent-output-panels .agent-output-panel-kyb,
#agent-output-tab-jobs:checked ~ .agent-output-panels .agent-output-panel-jobs,
#agent-output-tab-rows:checked ~ .agent-output-panels .agent-output-panel-rows,
#agent-output-tab-contacts:checked ~ .agent-output-panels .agent-output-panel-contacts,
#agent-output-tab-exclusions:checked ~ .agent-output-panels .agent-output-panel-exclusions,
#agent-output-tab-followup:checked ~ .agent-output-panels .agent-output-panel-followup {
  display: block;
}

.agent-output-toolbar {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.62rem 0.72rem;
  border-bottom: 1px solid #dde3ea;
  background: #f9fafb;
}

.agent-output-toolbar > div:first-child {
  min-width: 0;
}

.agent-output-actions {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 0.35rem;
}

.agent-output-eyebrow {
  margin-bottom: 0.12rem;
  color: var(--primary, #0765d9);
  font-size: 0.7rem;
  font-weight: 650;
}

.agent-output-title {
  color: #111827;
  font-size: 0.88rem;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: 0;
}

.agent-output-title code {
  padding: 0.1rem 0.28rem;
  border-radius: 4px;
  background: #eef2f7;
  color: #111827;
  font-size: 0.78rem;
}

.agent-output-cta {
  display: inline-flex;
  align-items: center;
  min-height: 1.7rem;
  padding: 0.28rem 0.55rem;
  border: 1px solid #dbe3ee;
  border-radius: 5px;
  background: #ffffff !important;
  background-image: none !important;
  box-shadow: none !important;
  color: #0b57d0 !important;
  font-size: 0.7rem;
  font-weight: 650;
  text-decoration: none !important;
  white-space: nowrap;
}

.agent-output-cta:hover {
  background: #eef5ff !important;
}

.agent-output-cta::before,
.agent-output-cta::after {
  display: none !important;
  content: none !important;
}

.agent-output-scroll {
  min-height: calc(var(--agent-output-panel-height) - 3.05rem);
  overflow-x: auto;
  background: linear-gradient(180deg, #ffffff 0%, #fbfcff 62%, #f6f8fb 100%);
}

.agent-output-grid {
  width: 100%;
  min-width: 860px;
  margin: 0 !important;
  border-collapse: separate;
  border-spacing: 0;
  background: #ffffff;
  table-layout: fixed;
  font-size: 0.76rem;
}

.agent-output-grid th,
.agent-output-grid td {
  padding: 0.42rem 0.52rem;
  border-right: 1px solid #e5e7eb;
  border-bottom: 1px solid #e5e7eb;
  color: #1f2937;
  line-height: 1.35;
  text-align: left;
  vertical-align: middle;
}

.agent-output-grid th:last-child,
.agent-output-grid td:last-child {
  border-right: 0;
}

.agent-output-grid thead tr:first-child th {
  padding: 0.26rem 0.45rem;
  background: #f8fafc;
  color: #64748b;
  font-size: 0.64rem;
  font-weight: 650;
  text-align: center;
}

.agent-output-grid thead tr:nth-child(2) th {
  background: #ffffff;
  color: #111827;
  font-size: 0.72rem;
  font-weight: 650;
}

.agent-output-grid tbody tr:last-child th,
.agent-output-grid tbody tr:last-child td {
  border-bottom: 0;
}

.agent-output-grid .agent-output-corner,
.agent-output-grid .agent-output-rownum {
  width: 2.35rem;
  background: #f8fafc;
  color: #64748b;
  font-size: 0.7rem;
  font-weight: 550;
  text-align: center;
}

.agent-output-grid th:nth-child(2),
.agent-output-grid td:nth-child(2) {
  width: 5.8rem;
}

.agent-output-grid th:nth-child(3),
.agent-output-grid td:nth-child(3) {
  width: 7rem;
}

.agent-output-grid th:nth-child(4),
.agent-output-grid td:nth-child(4) {
  width: 15rem;
}

.agent-output-grid th:nth-child(5),
.agent-output-grid td:nth-child(5) {
  width: 11.5rem;
}

.agent-output-grid th:nth-child(6),
.agent-output-grid td:nth-child(6) {
  width: 5.8rem;
}

.agent-output-grid th:nth-child(7),
.agent-output-grid td:nth-child(7) {
  width: 6.2rem;
}

.agent-output-chip {
  display: inline-block;
  margin: 0.06rem 0.2rem 0.06rem 0;
  padding: 0.08rem 0.32rem;
  border: 1px solid #dbe3ee;
  border-radius: 999px;
  background: #f8fafc;
  color: #334155;
  font-size: 0.68rem;
  font-weight: 600;
  white-space: nowrap;
}

.agent-output-link {
  color: #0969da;
  font-weight: 650;
}

.agent-output-source {
  color: #475569;
  font-weight: 600;
}

.agent-output-more {
  color: #64748b !important;
  font-size: 0.72rem;
  font-weight: 650;
  text-align: left !important;
  white-space: nowrap;
}

.agent-output-grid .agent-output-more-row .agent-output-rownum {
  font-size: 0.66rem;
}

.agent-output-note-row th,
.agent-output-note-row td {
  background: #fbfcff;
}

.agent-output-note {
  color: #64748b !important;
  font-size: 0.72rem;
  font-weight: 650;
}

.agent-output-placeholder-row th,
.agent-output-placeholder-row td {
  height: 2rem;
  background: #fbfcff;
}

.agent-output-placeholder-row .agent-output-rownum {
  color: transparent;
}

.agent-output-placeholder-row.agent-output-more-row .agent-output-rownum {
  color: #64748b;
}

.agent-output-blur {
  display: block;
  height: 0.7rem;
  border-radius: 999px;
  background: linear-gradient(90deg, #eef2f7 0%, #e5ebf3 58%, #f6f8fb 100%);
  filter: blur(0.35px);
  opacity: 0.8;
}

.agent-output-blur-xs {
  width: 2rem;
}

.agent-output-blur-sm {
  width: 3.4rem;
}

.agent-output-blur-md {
  width: 5.2rem;
}

.agent-output-blur-lg {
  width: 8rem;
}

.agent-output-blur-xl {
  width: min(11rem, 82%);
}

.agent-output-blur-pill {
  height: 1.02rem;
  width: 5.2rem;
  border: 1px solid #dbe3ee;
  background: #f8fafc;
}

.agent-output-blur-wide {
  width: 8rem;
}

.agent-output-tabs {
  display: flex;
  gap: 0.16rem;
  margin-top: 0 !important;
  padding: 0.32rem 0.42rem 0.16rem;
  border-top: 1px solid #dde3ea;
  background: #f6f8fb;
  overflow-x: auto;
}

.agent-output-tab {
  display: inline-flex;
  align-items: center;
  min-height: 1.45rem;
  padding: 0.22rem 0.5rem;
  border: 1px solid transparent;
  border-radius: 5px;
  color: #475569;
  font-size: 0.68rem;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
}

.agent-output-tab:hover {
  background: #eef2f7;
}

#agent-output-tab-findall:checked ~ .agent-output-tabs .agent-output-tab-findall,
#agent-output-tab-kyb:checked ~ .agent-output-tabs .agent-output-tab-kyb,
#agent-output-tab-jobs:checked ~ .agent-output-tabs .agent-output-tab-jobs,
#agent-output-tab-rows:checked ~ .agent-output-tabs .agent-output-tab-rows,
#agent-output-tab-contacts:checked ~ .agent-output-tabs .agent-output-tab-contacts,
#agent-output-tab-exclusions:checked ~ .agent-output-tabs .agent-output-tab-exclusions,
#agent-output-tab-followup:checked ~ .agent-output-tabs .agent-output-tab-followup {
  border-color: #dbe3ee;
  background: #ffffff;
  color: #0b57d0;
}

.dark .agent-output-sheet {
  border-color: rgba(148, 163, 184, 0.3);
  background: rgba(15, 23, 42, 0.86);
  box-shadow: none;
}

.dark .agent-output-toolbar,
.dark .agent-output-grid thead tr:first-child th,
.dark .agent-output-grid .agent-output-corner,
.dark .agent-output-grid .agent-output-rownum,
.dark .agent-output-tabs {
  background: rgba(15, 23, 42, 0.65);
}

.dark .agent-output-toolbar,
.dark .agent-output-grid th,
.dark .agent-output-grid td,
.dark .agent-output-tabs {
  border-color: rgba(148, 163, 184, 0.28);
}

.dark .agent-output-scroll,
.dark .agent-output-grid,
.dark .agent-output-grid thead tr:nth-child(2) th {
  background: rgba(15, 23, 42, 0.86);
}

.dark .agent-output-title,
.dark .agent-output-grid thead tr:nth-child(2) th,
.dark .agent-output-grid td {
  color: #f8fafc !important;
}

.dark .agent-output-title code,
.dark .agent-output-chip,
.dark .agent-output-blur-pill {
  border-color: rgba(148, 163, 184, 0.28);
  background: rgba(226, 232, 240, 0.1);
  color: #f8fafc;
}

.dark .agent-output-placeholder-row th,
.dark .agent-output-placeholder-row td,
.dark .agent-output-note-row th,
.dark .agent-output-note-row td {
  background: rgba(15, 23, 42, 0.72);
}

.dark .agent-output-note,
.dark .agent-output-grid thead tr:first-child th,
.dark .agent-output-grid .agent-output-rownum,
.dark .agent-output-source,
.dark .agent-output-tab {
  color: #cbd5e1;
}

.dark .agent-output-blur {
  background: linear-gradient(90deg, rgba(148, 163, 184, 0.18) 0%, rgba(148, 163, 184, 0.12) 58%, rgba(148, 163, 184, 0.08) 100%);
}

.dark .agent-output-link {
  color: #93c5fd;
}

.dark .agent-output-tab:hover {
  background: rgba(30, 41, 59, 0.9);
}

.dark #agent-output-tab-findall:checked ~ .agent-output-tabs .agent-output-tab-findall,
.dark #agent-output-tab-kyb:checked ~ .agent-output-tabs .agent-output-tab-kyb,
.dark #agent-output-tab-jobs:checked ~ .agent-output-tabs .agent-output-tab-jobs,
.dark #agent-output-tab-rows:checked ~ .agent-output-tabs .agent-output-tab-rows,
.dark #agent-output-tab-contacts:checked ~ .agent-output-tabs .agent-output-tab-contacts,
.dark #agent-output-tab-exclusions:checked ~ .agent-output-tabs .agent-output-tab-exclusions,
.dark #agent-output-tab-followup:checked ~ .agent-output-tabs .agent-output-tab-followup {
  border-color: rgba(148, 163, 184, 0.28);
  background: rgba(15, 23, 42, 0.95);
  color: #bfdbfe;
}

.dark .agent-output-cta {
  border-color: rgba(148, 163, 184, 0.28);
  background: rgba(15, 23, 42, 0.95) !important;
  color: #bfdbfe !important;
}

.dark .agent-output-cta:hover {
  background: rgba(30, 41, 59, 0.9) !important;
}

@media (width < 900px) {
  .agent-output-sheet {
    --agent-output-panel-height: 26rem;
  }

  .agent-output-scroll {
    min-height: calc(var(--agent-output-panel-height) - 5.1rem);
  }

  .agent-output-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .agent-output-grid {
    min-width: 860px;
  }
}

.eb-toggle {
  display: none;
}

.eb-label {
  display: block;
  cursor: pointer;
  padding: 0.625rem 0;
  padding-left: 1.75rem;
  position: relative;
  font-size: 1rem;
  line-height: 1.6;
  user-select: none;
}

.eb-label::before {
  content: '>';
  position: absolute;
  left: 0.125rem;
  top: 0.375rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: #9ca3af;
  transition: transform 0.15s ease, color 0.15s ease;
}

.eb-title {
  display: block;
  font-family: "ABCDiatype", sans-serif;
  font-weight: 700;
  font-size: 1rem;
  color: #111111;
}

.dark .eb-title {
  color: #f3f4f6;
}

.eb-label:hover::before {
  color: var(--primary, #0765d9);
}

.eb-desc {
  display: block;
  font-size: 1rem;
  line-height: 1.6;
  color: #111111;
  margin-top: 0.125rem;
  font-weight: 400;
}

.eb-desc + .eb-desc {
  margin-top: 0.5rem;
}

.dark .eb-desc {
  color: #d1d5db;
}

.eb-tags {
  display: block;
  font-size: 0.8125rem;
  color: #9ca3af;
  margin-top: 0.25rem;
  letter-spacing: 0.01em;
}

.eb-label:hover .eb-tags {
  color: #6b7280;
}

.eb-content {
  max-height: 0;
  overflow: hidden;
  padding-left: 1.75rem;
  transition: max-height 0.25s ease;
}

.eb-toggle:checked ~ .eb-content {
  max-height: 800px;
}

.eb-toggle:checked + .eb-label::before {
  transform: rotate(90deg);
  color: var(--primary, #0765d9);
}

.eb-content > div {
  margin-top: 0 !important;
  margin-bottom: 0.25rem !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
}

.eb-content table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
  margin-top: 0;
  margin-bottom: 0.5rem;
}

.eb-content th,
.eb-content td {
  text-align: left;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid var(--border-color, #e5e7eb);
}

.eb-content th {
  font-weight: 600;
  color: #6b7280;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.eb-content td code {
  font-size: 0.8125rem;
  background: #f3f4f6;
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
}

.eb-content > p,
.eb-content > span {
  display: block !important;
  font-size: 0.875rem !important;
  text-transform: none !important;
  letter-spacing: 0.01em;
  color: #374151 !important;
  font-weight: 600 !important;
  margin-top: 1rem !important;
  margin-bottom: -0.25rem !important;
  font-family: inherit !important;
}

.eb-content > span strong {
  font-size: inherit !important;
  color: inherit !important;
  font-weight: inherit !important;
}

.steps-list {
  list-style: none;
  padding-left: 0;
  margin: 2rem 0;
  margin-left: 0.875rem;
}

.steps-list li {
  position: relative;
  padding-left: 2rem;
  padding-bottom: 1.25rem;
}

.steps-list li:last-child {
  padding-bottom: 0;
}

.step-number {
  position: absolute;
  left: 0;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 50%;
  background-color: #f3f4f6;
  color: #6b7280;
  font-size: 0.875rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -0.8125rem;
  flex-shrink: 0;
  z-index: 1;
}

.step-line {
  position: absolute;
  left: 0;
  width: 1px;
  height: calc(100% - 2rem);
  top: 2rem;
  background-color: #e5e7eb;
}

.steps-list li:last-child .step-line {
  background: linear-gradient(to bottom, #e5e7eb, transparent);
}

.step-title {
  font-weight: 600;
  margin-bottom: 0.5rem;
  font-size: 1.125rem;
}

.step-content {
  margin-top: 0.5rem;
  color: #6b7280;
  font-size: 1rem;
}

.dark .step-number {
  background-color: #374151;
  color: #9ca3af;
}

.dark .step-line {
  background-color: #4b5563;
}

.dark .steps-list li:last-child .step-line {
  background: linear-gradient(to bottom, #4b5563, transparent);
}

.dark .step-content {
  color: #d1d5db;
}

.api-button {
  align-items: center;
  background: rgb(var(--primary));
  color: var(--white, #fff);
  display: flex;
  text-transform: uppercase;
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  gap: 10px;
  height: 40px;
  justify-content: center;
  line-height: 27px;
  padding: 14px 32px;
  text-decoration: none;
  transition: 0.1s ease-in-out;
  border: 2px solid var(--primary);
  word-spacing: 8px;
  letter-spacing: 1px;
}

.api-button:hover {
  background-color: #000000;
}

.endpoint-link {
  font-size: 1.15em !important;
  font-weight: 500 !important;
  letter-spacing: -0.03em !important;
}

.eval-tab-radio {
  display: none;
}

.eval-tab-labels {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--border-color, #e5e7eb);
  margin-bottom: 0;
}

.eval-tab-label {
  padding: 0.5rem 1rem;
  cursor: pointer;
  font-size: 0.875rem;
  font-weight: 500;
  color: #6b7280;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  transition: color 0.15s, border-color 0.15s;
}

.eval-tab-label:hover {
  color: #111827;
}

#eval-accuracy:checked ~ .eval-tab-labels label[for="eval-accuracy"],
#eval-latency:checked ~ .eval-tab-labels label[for="eval-latency"],
#eval-verticals:checked ~ .eval-tab-labels label[for="eval-verticals"] {
  color: var(--primary, #0765d9);
  border-bottom-color: var(--primary, #0765d9);
}

.eval-panel {
  display: none;
}

.eval-panel img {
  width: 100%;
  border-radius: 0.5rem;
  border: 1px solid var(--border-color, #e5e7eb);
}

#eval-accuracy:checked ~ .eval-panel-accuracy,
#eval-latency:checked ~ .eval-panel-latency,
#eval-verticals:checked ~ .eval-panel-verticals {
  display: block;
}

/* Pydantic blog callout: override the default card hover accent to Pydantic purple. */
a[href="https://pydantic.dev/articles/harness-exa"]:hover {
  border-color: #e520e9 !important;
