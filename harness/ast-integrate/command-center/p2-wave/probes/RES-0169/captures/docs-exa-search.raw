}

.rounded-l,
.rounded-l-md,
.rounded-l-lg,
.rounded-l-xl,
.rounded-l-2xl {
  border-top-left-radius: var(--docs-radius) !important;
  border-bottom-left-radius: var(--docs-radius) !important;
}

.rounded-r,
.rounded-r-md,
.rounded-r-lg,
.rounded-r-xl,
.rounded-r-2xl {
  border-top-right-radius: var(--docs-radius) !important;
  border-bottom-right-radius: var(--docs-radius) !important;
}

.rounded-t,
.rounded-t-md,
.rounded-t-lg,
.rounded-t-xl,
.rounded-t-2xl {
  border-top-left-radius: var(--docs-radius) !important;
  border-top-right-radius: var(--docs-radius) !important;
}

.rounded-b,
.rounded-b-md,
.rounded-b-lg,
.rounded-b-xl,
.rounded-b-2xl {
  border-bottom-right-radius: var(--docs-radius) !important;
  border-bottom-left-radius: var(--docs-radius) !important;
}

[role="dialog"].rounded-search {
  border-radius: calc(var(--docs-radius) + 4px) !important;
}

.accordion:not(:last-child),
.accordion:not(:last-child) > summary {
  border-bottom-right-radius: 0 !important;
  border-bottom-left-radius: 0 !important;
}

.accordion:not(:first-child),
.accordion:not(:first-child) > summary {
  border-top-left-radius: 0 !important;
  border-top-right-radius: 0 !important;
}

.accordion > summary {
  align-items: flex-start !important;
}

.accordion > summary > .mr-0\.5,
.accordion > summary > .h-4.w-4 {
  margin-top: 4px;
}

.accordion > summary .leading-tight > p:first-child {
  font-family: "ABCDiatype", sans-serif;
  font-size: 1.0625rem !important;
  font-weight: 700 !important;
  line-height: 1.35 !important;
  margin-bottom: 0.5rem !important;
}

.accordion > summary .leading-tight > p:nth-child(2) {
  line-height: 1.45 !important;
}

.changelog-month-index {
  display: none;
  flex-direction: column;
  gap: 0.5rem;
}

@media (width >= 1280px) {
  .changelog-month-index {
    display: flex;
  }
}

@media (width >= 1280px) {
  .changelog-month-index {
    display: flex;
  }
}

.changelog-month-index a {
  color: #6b7280 !important;
  font-size: 0.875rem !important;
  font-weight: 400 !important;
  text-decoration: none !important;
  border-bottom: none !important;
}

.changelog-month-index a:hover {
  color: #374151 !important;
  text-decoration: underline !important;
  text-decoration-color: #d1d5db !important;
  text-decoration-thickness: 1px !important;
  text-underline-offset: 0.18em !important;
}

.dark .changelog-month-index a {
  color: #9ca3af !important;
}

.dark .changelog-month-index a:hover {
  color: #d1d5db !important;
  text-decoration-color: #6b7280 !important;
}

#navigation-items button[aria-expanded="true"].bg-primary\/10 {
  background: transparent !important;
  color: #4b5563 !important;
  text-shadow: none !important;
}

.dark #navigation-items button[aria-expanded="true"].dark\:bg-primary-light\/10 {
  background: transparent !important;
