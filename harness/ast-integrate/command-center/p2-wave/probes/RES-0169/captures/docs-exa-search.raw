  src: url("https://exa.ai/fonts/ABCDiatype-Bold.woff2") format("woff2");
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

main h1,
article h1 {
  font-family: "ABCDiatype", sans-serif;
  font-weight: 700 !important;
}

main h2,
main h3,
main h4,
article h2,
article h3,
article h4 {
  font-family: "ABCDiatype", sans-serif;
  font-weight: 500 !important;
}

main p:not(.callout-title):not(.callout-body),
article p:not(.callout-title):not(.callout-body) {
  font-size: calc(1em - 1pt);
}

:root {
  --docs-radius: 6px;
  --docs-callout-accent: rgb(var(--primary));
  --docs-callout-outline: rgba(0, 0, 0, 0.05);
}

@media (width >= 1024px) {
  html[data-page-mode="none"] header > .relative.max-w-8xl,
  html[data-page-mode="none"] #body-content {
    width: 100% !important;
    max-width: none !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  html[data-page-mode="none"] #body-content > .w-full,
  html[data-page-mode="none"] #content-container {
    flex: 1 1 auto;
    min-width: 0;
  }

  html[data-page-mode="none"] #content-container {
    max-width: none !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  html[data-page-mode="none"] #content-area {
    max-width: 60rem !important;
  }
}

:root.dark,
.dark {
  --docs-callout-accent: rgb(var(--primary-light));
  --docs-callout-outline: rgba(255, 255, 255, 0.08);
}

.rounded,
.rounded-md,
.rounded-lg,
.rounded-xl,
.rounded-2xl,
.not-prose.rounded-xl,
input[type="text"],
input[type="email"],
input[type="password"],
input[type="search"],
textarea,
select {
