f.0\",\"typeLabel\":\"boolean\"},{\"type\":\"object\",\"title\":\"Advanced text options\",\"description\":\"Text extraction options for each result.\",\"properties\":{\"maxCharacters\":{\"oneOf\":[{\"type\":\"integer\",\"description\":\"Maximum character limit for the full page text. Useful for controlling response size and API costs. Maximum supported value is 10000.\",\"maximum\":10000,\"minimum\":1,\"example\":1000,\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.maxCharacters.oneOf.0\",\"typeLabel\":\"integer\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.maxCharacters.oneOf.1\",\"typeLabel\":\"null\"}],\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.maxCharacters\",\"typeLabel\":\"integer | null\"},\"includeHtmlTags\":{\"oneOf\":[{\"type\":\"boolean\",\"description\":\"If true, include lightweight HTML tags in returned text instead of plain markdown-style text. Use maxAgeHours: 0 when you need this applied to freshly fetched content.\",\"default\":false,\"example\":false,\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.includeHtmlTags.oneOf.0\",\"typeLabel\":\"boolean\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.includeHtmlTags.oneOf.1\",\"typeLabel\":\"null\"}],\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.includeHtmlTags\",\"typeLabel\":\"boolean | null\"},\"verbosity\":{\"oneOf\":[{\"type\":\"string\",\"description\":\"Controls text rendering verbosity. compact focuses on main content, standard includes more surrounding page context, and full requests the most complete rendered text. Some pages may produce identical standard and full output. Use maxAgeHours: 0 when you need this applied to freshly fetched content.\",\"default\":\"compact\",\"enum\":[\"compact\",\"standard\",\"full\"],\"example\":\"standard\",\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.verbosity.oneOf.0\",\"typeLabel\":\"enum\u003cstring\u003e\"},{\"type\":\"null\",\"uniqueKey\":\"contents.oneOf.0.text.oneOf.1.verbosity.oneOf.1\",\"typeLabel\":\"null\"}],