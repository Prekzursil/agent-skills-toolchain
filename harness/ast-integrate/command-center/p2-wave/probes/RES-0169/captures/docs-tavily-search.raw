arTitle\":\"Search\",\"openapi\":\"POST /search\",\"description\":\"Execute a search query using Tavily Search.\",\"href\":\"/documentation/api-reference/endpoint/search\"},{\"title\":\"Tavily Extract\",\"sidebarTitle\":\"Extract\",\"openapi\":\"POST /extract\",\"description\":\"Extract web page content from one or more specified URLs using Tavily Extract.\",\"href\":\"/documentation/api-reference/endpoint/extract\"},{\"title\":\"Tavily Crawl\",\"sidebarTitle\":\"Crawl\",\"openapi\":\"POST /crawl\",\"description\":\"Tavily Crawl is a graph-based website traversal tool that can explore hundreds of paths in parallel with built-in extraction and intelligent discovery.\",\"href\":\"/documentation/api-reference/endpoint/crawl\"},{\"title\":\"Tavily Map\",\"sidebarTitle\":\"Map\",\"openapi\":\"POST /map\",\"description\":\"Tavily Map traverses websites like a graph and can explore hundreds of paths in parallel with intelligent discovery to generate comprehensive site maps.\",\"href\":\"/documentation/api-reference/endpoint/map\"}]},{\"group\":\"Research Endpoint\",\"pages\":[{\"title\":\"Create Research Task\",\"sidebarTitle\":\"Create Research Task\",\"openapi\":\"POST /research\",\"description\":\"Tavily Research performs comprehensive research on a given topic by conducting multiple searches, analyzing sources, and generating a detailed research report.\",\"href\":\"/documentation/api-reference/endpoint/research\"},{\"title\":\"Get Research Task Status\",\"sidebarTitle\":\"Get Research Task Status\",\"openapi\":\"GET /research/{request_id}\",\"description\":\"Retrieve the status and results of a research task using its request ID.\",\"href\":\"/documentation/api-reference/endpoint/research-get\"},{\"title\":\"Streaming\",\"description\":\"Stream real-time research progress and results from Tavily Research API\",\"icon\":\"bolt\",\"href\":\"/documentation/api-reference/endpoint/research-streaming\"}]},{\"group\":\"Account\",\"pages\":[{\"title\":\"Usage\",\"openapi\":\"GET /usage\",\"description\":\"Get API key and account usage details\",\"href\":\"/documentation/api-reference/endpoint/usage\"},{\"title\":\"Logs\",\"openapi\":\"POST /logs\",\"description\":\"Retrieve per-request usage logs for the API keys under your account or organization.\",\"href\":\"/documentation/api-reference/endpoint/logs\"}]},{\"group\":\"Enterprise API Reference\",\"pages\":[{\"group\":\"API Key Generator\",\"pages\":[{\"title\":\"Generate Keys\",\"sidebarTitle\":\"Generate Keys\",\"openapi\":\"POST /generate-keys\",\"description\":\"Generate one or more API keys with custom configuration.\",\"href\":\"/documentation/enterprise/generate-keys\"},{\"title\":\"Deactivate Keys\",\"sidebarTitle\":\"Deactivate Keys\",\"openapi\":\"POST /deactivate-keys\",\"description\":\"Deactivate API keys either in bulk by `request_id` or individually.\\n\\n**Option A — Deactivate by request ID:** Pass a `request_id` in the request body to deactivate all keys from that generation request.\\n\\n**Option B — Deactivate individual key:** Set the key you want to deactivate in the `Authorization` header. No request body is required.\",\"href\":\"/documentation/enterprise/deactivate-keys\"},{\"title\":\"Key Info\",\"sidebarTitle\":\"Key Info\",\"openapi\":\"GET /key-info\",\"description\":\"Get information about an API key. The key to query is specified in the `Authorization` header.\",\"href\":\"/documentation/enterprise/key-info\"}]},{\"title\":\"Organization Usage\",\"sidebarTitle\":\"Organization Usage\",\"openapi\":\"POST /org-usage\",\"description\":\"Retrieve usage (credits), pay-as-you-go USD cost, and request counts for **every API key under an organization you own**, mirroring the platform's Usage analytics page.\\n\\nIdentify the organization by **name** in the request body. Authenticate with the organization owner's **personal API key** — the key from the owner's own personal account, **not** an organization or enterprise API key. Supports date-range, project, and depth filtering.\",\"href\":\"/documentation/enterprise/org-usage\"}]},{\"group\":\"Python SDK\",\"pages\":[{\"title\":\"Quickstart\",\"description\":\"Integrate Tavily's powerful APIs natively in your Python apps.\",\"icon\":\"forward\",\"href\":\"/sdk/python/quick-start\"},{\"title\":\"SDK Reference\",\"description\":\"Integrate Tavily's powerful APIs natively in your Python apps.\",\"icon\":\"book\",\"href\":\"/sdk/python/reference\"}]},{\"group\":\"JavaScript SDK\",\"pages\":[{\"title\":\"Quickstart\",\"description\":\"Integrate Tavily's powerful APIs natively in your JavaScript/TypeScript projects.\",\"icon\":\"forward\",\"href\":\"/sdk/javascript/quick-start\"},{\"title\":\"SDK Reference\",\"description\":\"Integrate Tavily's powerful APIs natively in your JavaScript/TypeScript projects.\",\"icon\":\"book\",\"href\":\"/sdk/javascript/reference\"}]},{\"group\":\"Best Practices\",\"pages\":[{\"title\":\"Best Practices for Search\",\"sidebarTitle\":\"Search\",\"description\":\"Optimize individual queries, and run search reliably at scale with batch workflows.\",\"icon\":\"gear\",\"href\":\"/documentation/best-practices/best-practices-search\"},{\"title\":\"Best Practices for Extract\",\"sidebarTitle\":\"Extract\",\"description\":\"Learn how to optimize content extraction, choose the right approach, and configure parameters for better performance.\",\"icon\":\"wrench\",\"href\":\"/documentation/best-practices/best-practices-extract\"},{\"title\":\"Best Practices for Crawl\",\"sidebarTitle\":\"Crawl\",\"description\":\"Learn how to optimize crawl parameters, focus your crawls, and efficiently extract content from websites.\",\"icon\":\"spider-web\",\"href\":\"/documentation/best-practices/best-practices-crawl\"},{\"title\":\"Best Practices for Research\",\"sidebarTitle\":\"Research\",\"description\":\"Learn how to write effective prompts, choose the right model, and configure output formats for better research results.\",\"icon\":\"magnifying-glass-chart\",\"href\":\"/documentation/best-practices/best-practices-research\"},{\"title\":\"API Key Management\",\"description\":\"Learn how to handle API key leaks and best practices for key rotation.\",\"icon\":\"key\",\"href\":\"/documentation/best-practices/api-key-management\"}]}]},{\"tab\":\"Ecosystem\",\"pages\":[{\"title\":\"Ecosystem\",\"href\":\"/documentation/mcp\"}]},{\"tab\":\"Examples\",\"pages\":[{\"title\":\"Examples\",\"href\":\"/examples/hub\"}]},{\"tab\":\"Changelog\",\"pages\":[{\"title\":\"Changelog\",\"href\":\"/changelog\"}]},{\"tab\":\"Help\",\"pages\":[{\"title\":\"Help\",\"href\":\"/documentation/help\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L4a\"}]\n"])</script><script>self.__next_f.push([1,"4b:I[27201,[\"/mintlify-assets/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\"],\"IconMark\"]\n"])</script><script>self.__next_f.push([1,"4c:I[763509,[\"/mintlify-assets/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/d5b07934098b610d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0890ba15c670d9b1.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/8778b596bb8e1fac.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0285713793f685da.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/3df48e92ab491c72.js?dpl=dpl_6FYZ3SECAF7eWA496x