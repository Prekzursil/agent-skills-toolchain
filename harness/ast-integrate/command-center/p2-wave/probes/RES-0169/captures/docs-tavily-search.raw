-500" aria-hidden="true" focusable="false" style="-webkit-mask-image:url(&quot;https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/regular/key.svg&quot;);-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;mask-image:url(&quot;https://d3gk2c5xim1je2.cloudfront.net/fontawesome/v7.2.0/regular/key.svg&quot;);mask-repeat:no-repeat;mask-position:center"></svg></div><div class="flex-1 flex min-w-0 items-start gap-x-2.5"><div class="flex min-w-0 flex-1 flex-wrap items-center gap-1.5 [word-break:break-word]"><span class="min-w-0 max-w-full break-words hyphens-auto">API Key Management</span></div></div></a></li></ul></div><script>(function () {
  try {
    if (window.__mintlifyInitialSidebarScrollDone) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content')) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></nav><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.tavily.com/#organization","name":"Tavily Docs","url":"https://docs.tavily.com","logo":{"@type":"ImageObject","url":"https://mintcdn.com/tavilyai/W9s9i1gwaZpOi3B0/logo/light.svg?fit=max&auto=format&n=W9s9i1gwaZpOi3B0&q=85&s=57062dc27e5e05238a1bf25b21e5d8ed"}},{"@type":"WebSite","@id":"https://docs.tavily.com#website","name":"Tavily Docs","url":"https://docs.tavily.com","publisher":{"@id":"https://docs.tavily.com/#organization"}},{"@type":"WebPage","@id":"https://docs.tavily.com/documentation/api-reference/endpoint/search#webpage","url":"https://docs.tavily.com/documentation/api-reference/endpoint/search","name":"Tavily Search","description":"Execute a search query using Tavily Search.","dateModified":"2026-01-27T19:22:11.612Z","isPartOf":{"@id":"https://docs.tavily.com#website"},"breadcrumb":{"@id":"https://docs.tavily.com/documentation/api-reference/endpoint/search#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.tavily.com/documentation/api-reference/endpoint/search#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Tavily Docs","item":"https://docs.tavily.com"},{"@type":"ListItem","position":2,"name":"Tavily Search","item":"https://docs.tavily.com/documentation/api-reference/endpoint/search"}]},{"@type":["TechArticle","APIReference"],"@id":"https://docs.tavily.com/documentation/api-reference/endpoint/search#apireference","headline":"Tavily Search","name":"Tavily Search","description":"Execute a search query using Tavily Search.","url":"https://docs.tavily.com/documentation/api-reference/endpoint/search","mainEntityOfPage":{"@id":"https://docs.tavily.com/documentation/api-reference/endpoint/search#webpage"},"dateModified":"2026-01-27T19:22:11.612Z","publisher":{"@id":"https://docs.tavily.com/#organization"},"isPartOf":{"@id":"https://docs.tavily.com#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "none");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10 pointer-events-none" id="background-color"></span><style data-custom-css-index="0" data-custom-css-path="style.css">:root {
  --tavily-yellow: #78b0a1;
}


/* Dark theme enhancements for hero section */
.bg-\[\#0a0a0a\] {
  background-color: #0a0a0a;
}

/* Scope ONLY to the welcome page tabs */
ul.welcome-tabs {
  display: flex;
}

/* Each tab takes equal width */
ul.welcome-tabs > li {
  flex: 1 1 0%;
  display: flex;
}

/* Make the button fill the tab width */
ul.welcome-tabs [data-component-part="tab-button"] {
  flex: 1 1 0%;
  justify-content: center;
  max-width: none; /* overrides max-w-max */
  width: 100%;
}

/* CodeGroup spacing ONLY inside welcome tabs */
ul.welcome-tabs
~ [data-component-part="tab-content"]
  .code-group {
  margin-top: 0 !important;
  margin-bottom: 0.25rem !important; /* Tailwind mb-1 */
}

[data-component-part="tab-content"] .welcome-learn-more {
  font-size: 12px;
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s ease;
}

[data-component-part="tab-content"] .welcome-learn-more:hover {
  border-bottom-color: var(--tavily-yellow);
}

[data-component-part="tab-content"] .code-group {
  margin-top: 0.5rem;   /* mt-2 */
  margin-bottom: 0.5rem;
}


/* Footer social icons – default gray */
.footer-social-icons > a > svg.icon {
  background-color: #9da3af; /* Tailwind gray-400 */
  transition: background-color 0.15s ease;
}

/* Hover state */
.footer-social-icons > a:hover > svg.icon {
  background-color: #e5e7eb; /* Tailwind gray-200 */
}

/* Hide the Mintlify framework footer on the /welcome page only */
body:has(.welcome-tabs) footer {
  display: none !important;
}

.hidden.lg\:flex > .nav-tabs {
  width: 100%;
}

.hidden.lg\:flex > .nav-tabs > a.nav-tabs-item[href="/changelog"] {
  margin-left: auto;
}

/* Each block is labelled by the row above it, so its own vertical margins would only
   detach it from that label. */
.sdk-install .code-block {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
}

/* Mirrors the landing site's HeroAgentField: an overlapping logo deck that opens a
   launcher menu. Kept visually in step with tavily-landing-v3. */
.agent-setup {
  position: relative;
  /* Deck geometry, shared by the marks themselves and by the room the line needs to
     scroll clear of them: three overlapped marks plus 25px of chevron, gap and padding. */
  --agent-setup-mark: 22px;
  --agent-setup-mark-overlap: 7px;
  --agent-setup-deck: calc(
    var(--agent-setup-mark) * 3 - var(--agent-setup-mark-overlap) * 2 + 25px
  );
  --agent-setup-surface: #ffffff;
  --agent-setup-surface-0: rgb(255 255 255 / 0);
  --agent-setup-line: rgb(9 9 11 / 0.1);
  --agent-setup-hover: rgb(9 9 11 / 0.05);
  --agent-setup-muted: rgb(9 9 11 / 0.45);
  --agent-setup-text: rgb(9 9 11);
}

.dark .agent-setup {
  --agent-setup-surface: #0b0c0e;
  --agent-setup-surface-0: rgb(11 12 14 / 0);
  --agent-setup-line: rgb(255 255 255 / 0.12);
  --agent-setup-hover: rgb(255 255 255 / 0.08);
  --agent-setup-muted: rgb(255 255 255 / 0.45);
  --agent-setup-text: #ffffff;
}

.agent-setup .code-block {
  margin: 0 !important;
}

/* Mintlify paints <Icon> with bg-primary on a masked svg, which lands green; the deck
   and the menu rows want the icon to take the colour of the row it sits in. */
.agent-setup svg.icon {
  background-color: currentColor !important;
}

/* Lets the line scroll a little past the deck, as inline content. Padding on the scroll
   container isn't counted in its scroll width, and padding on the code element is reset
   by the code block's own styles — either way the tail stays stuck under the deck. */
.agent-setup .code-block .line:first-child::after {
  content: "";
  display: inline-block;
  width: calc(var(--agent-setup-deck) + 0.5rem);
}

/* The prompt is one line; the code block still renders a trailing empty one. */
.agent-setup .code-block .line + .line {
  display: none;
}

/* Clears the code block's button row (copy + Ask Assistant): 1rem edge inset + two 26px
   buttons + 6px gaps. Static fallback for the measured inset further down. */
.agent-setup-menu {
  position: absolute;
  top: 12px;
  right: 5rem;
  z-index: 20;
}

/* Opaque backdrop reaching to the copy button, so a scrolling line disappears into the
   block's fill instead of sliding through the gaps in the deck. Fades in on the left
   rather than cutting the text off at a hard edge. */
.agent-setup-menu::before {
  content: "";
  position: absolute;
  z-index: -1;
  /* Bounded to the text line: 1px short of the block's top edge so it doesn't paint over
     the border, and stopping above the horizontal scrollbar at the foot of the block. */
  top: calc(-0.75rem + 1px);
  bottom: -2px;
  left: -2.5rem;
  right: -0.375rem;
  background: linear-gradient(
    to right,
    var(--agent-setup-surface-0),
    var(--agent-setup-surface) 2.5rem
  );
  pointer-events: none;
}

.agent-setup-trigger {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 26px;
  padding: 0 6px 0 3px;
  border-radius: 999px;
  color: var(--agent-setup-muted);
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.agent-setup-trigger:hover {
  background: var(--agent-setup-hover);
  color: var(--agent-setup-text);
}

.agent-setup-trigger:focus-visible {
  outline: 2px solid rgb(120 176 161 / 0.7);
  outline-offset: 2px;
}

.agent-setup-logos {
  display: flex;
  flex-shrink: 0;
}

/* Each mark sits on its own opaque disc so the overlap reads as a deck rather than a
   collision; the ring must not enlarge the disc or the overlap maths shifts with it. The
   disc is the wrapper, not the image, so inverting a dark mark leaves the fill alone. */
.agent-setup-logo {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--agent-setup-mark);
  height: var(--agent-setup-mark);
  border-radius: 50%;
  background: var(--agent-setup-surface);
  box-shadow: 0 0 0 1px var(--agent-setup-line);
}

/* Tailwind's dark:invert doesn't survive the hosted build (Mintlify prefixes its
   utilities), so the dark Cursor mark gets its own class. */
.dark .agent-setup-mark-invert {
  filter: invert(1);
}

.agent-setup-logo img {
  width: 14px;
  height: 14px;
  margin: 0 !important;
  object-fit: contain;
}

.agent-setup-logo + .agent-setup-logo {
  margin-left: calc(var(--agent-setup-mark-overlap) * -1) !important;
}

/* Dealt left-over-right, so the stack fans towards the chevron. */
.agent-setup-logo:nth-child(1) {
  z-index: 3;
}

.agent-setup-logo:nth-child(2) {
  z-index: 2;
}

.agent-setup-logo:nth-child(3) {
  z-index: 1;
}

.agent-setup-chevron {
  display: flex;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.agent-setup-menu.is-open .agent-setup-chevron {
  transform: rotate(180deg);
}

.agent-setup-popover {
  display: none;
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 20;
  flex-direction: column;
  gap: 2px;
  min-width: 220px;
  padding: 6px;
  border: 1px solid var(--agent-setup-line);
  border-radius: 14px;
  background: var(--agent-setup-surface);
  box-shadow: 0 12px 28px rgb(11 9 7 / 0.12);
  text-align: left;
}

.dark .agent-setup-popover {
  box-shadow: 0 12px 28px rgb(0 0 0 / 0.45);
}

.agent-setup-menu.is-open .agent-setup-popover {
  display: flex;
}

.agent-setup-group-label {
  padding: 5px 10px 7px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--agent-setup-muted);
}

.agent-setup-divider {
  height: 1px;
  margin: 5px 4px;
  background: var(--agent-setup-line);
}

.agent-setup-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 400;
  line-height: 1;
  color: var(--agent-setup-text);
  text-decoration: none;
  white-space: nowrap;
  transition: background-color 0.2s ease;
}

.agent-setup-option:hover {
  background: var(--agent-setup-hover);
}

.agent-setup-option:focus-visible {
  outline: 2px solid rgb(120 176 161 / 0.7);
  outline-offset: -2px;
}

.agent-setup-option-logo {
  width: 16px;
  height: 16px;
  margin: 0 !important;
  flex-shrink: 0;
  object-fit: contain;
}

/* Occupies the same 16px column as the agent logos so the footer row's text starts on
   the same edge as the rows above it. */
.agent-setup-option-icon {
  display: flex;
  flex-shrink: 0;
  justify-content: center;
  width: 16px;
  color: var(--agent-setup-muted);
}

/* Pinned right so it reads as one column regardless of agent name length. */
.agent-setup-option-action {
  display: flex;
  flex-shrink: 0;
  margin-left: auto;
  padding-left: 12px;
  color: var(--agent-setup-muted);
}

@media (max-width: 640px) {
  .agent-setup-menu {
    right: 4.625rem;
  }

  .agent-setup {
    --agent-setup-mark: 20px;
    --agent-setup-mark-overlap: 6px;
  }

  .agent-setup-logo img {
    width: 13px;
    height: 13px;
  }

  .agent-setup-popover {
    min-width: 200px;
  }
}

/* Where anchor positioning is available, sit against the button row itself instead of a
   guessed inset, so the deck moves only as far as the buttons Mintlify actually renders.
   Screen only: the row is print:hidden, and an absent anchor would drop the deck back to
   its static position. */
@media screen {
  @supports (anchor-name: --probe) {
    .agent-setup .code-block [data-floating-buttons] {
      anchor-name: --agent-setup-buttons;
    }

    /* Matches the row's own 6px gap. */
    .agent-setup-menu {
      position-anchor: --agent-setup-buttons;
      right: calc(anchor(left) + 6px);
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .agent-setup-trigger,
  .agent-setup-chevron,
  .agent-setup-option {
    transition: none;
  }
}

/* Home page chunking: one hairline rule and one rhythm per section, so each block reads
   as its own unit instead of running together. */
:root {
  --home-line: rgb(9 9 11 / 0.1);
  --home-muted: rgb(9 9 11 / 0.5);
}

.dark {
  --home-line: rgb(255 255 255 / 0.12);
  --home-muted: rgb(255 255 255 / 0.5);
}

.home-section {
  padding-top: 2.5rem;
  padding-bottom: 2.5rem;
  border-top: 1px solid var(--home-line);
}

/* The hero already separates the first section; its own rule would only box the hero in.
   The hero's bottom padding stands in for the section's top padding. */
.home-section-lead {
  padding-top: 0;
  border-top: 0;
}

/* Framed "Try it now" tabs. The frame is our own wrapper because Mintlify puts the
   passed className on a different node between releases; the tab list's own border-b
   becomes the divider between the labels and the panel. */
.welcome-tabs-frame {
  border: 1px solid var(--home-line);
  border-radius: 14px;
  overflow: hidden;
}

.welcome-tabs-frame ul[data-component-part="tabs-list"],
.welcome-tabs-frame ul.welcome-tabs {
  margin-bottom: 0 !important;
  padding-left: 1rem !important;
  padding-right: 1rem !important;
  border-color: var(--home-line) !important;
}

.welcome-tabs-frame [data-component-part="tab-content"] {
  padding: 1rem;
}

/* The frame's padding already insets the panel. */
.welcome-tabs-frame [data-component-part="tab-content"] .code-group {
  margin-top: 0 !important;
}
</style><!--$--><!--/$--><div class="w-full"><main class="px-5 lg:pr-10 lg:pl-[5.5rem] lg:pt-10 mx-auto max-w-6xl flex flex-row-reverse gap-x-12 w-full pt-36" id="content-container"><div data-api-example="" class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem]" id="content-side-layout"><div class="w-full relative print:print-color-exact xl:w-[28rem] max-h-[calc(100%-32px)] print:max-h-none gap-6 grid grid-rows-[repeat(auto-fit,minmax(0,min-content))] grid-rows min-h-[18rem]"><div data-orientation="horizontal" data-activation-direction="none" class="code-group p-0.5 flex flex-col not-prose relative rounded-2xl border border-gray-950/10 dark:border-white/10 min-w-0 my-0 bg-gray-50 dark:bg-white/5 dark:codeblock-dark text-gray-950 dark:text-gray-50 codeblock-light"><div class="flex items-center justify-between gap-2 relative px-2.5" data-component-part="code-group-tab-bar"><div class="flex items-center gap-1.5 text-xs font-medium min-w-0"><span class="truncate text-gray-950 dark:text-gray-50" title="Python SDK">Python SDK</span></div><div class="flex items-center justify-end shrink-0 gap-1.5"><button type="button" tabindex="0" aria-haspopup="menu" id="base-ui-_R_39iqbddbsnlhjiuasnpfiutb_" aria-label="Select language" class="group disabled:pointer-events-none [&amp;&gt;span]:line-clamp-1 rounded-lg overflow-hidden group focus-visible:outline-2 focus-visible:outline-primary dark:focus-visible:outline-primary-light flex items-center py-0.5 gap-1 text-gray-950/50 dark:text-white/50 group-hover:text-gray-950/70 dark:group-hover:text-white/70 select-none bg-transparent dark:bg-transparent pb-1 text-xs font-medium cursor-default focus-visible:-outline-offset-2"><div class="flex gap-1 items-center pl-2.5 pr-1.5 py-[5px] rounded-[10px] border text-gray-500 dark:text-gray-400 cursor-pointer hover:bg-gray-200/50 dark:hover:bg-gray-700/70 hover:text-primary dark:hover:text-primary-light border-transparent"><svg class="w-3.5 h-3.