:\"https://docs.tavily.com#website\"},\"breadcrumb\":{\"@id\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search#breadcrumb\"}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Tavily Docs\",\"item\":\"https://docs.tavily.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tavily Search\",\"item\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search\"}]},{\"@type\":[\"TechArticle\",\"APIReference\"],\"@id\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search#apireference\",\"headline\":\"Tavily Search\",\"name\":\"Tavily Search\",\"description\":\"Execute a search query using Tavily Search.\",\"url\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search\",\"mainEntityOfPage\":{\"@id\":\"https://docs.tavily.com/documentation/api-reference/endpoint/search#webpage\"},\"dateModified\":\"2026-01-27T19:22:11.612Z\",\"publisher\":{\"@id\":\"https://docs.tavily.com/#organization\"},\"isPartOf\":{\"@id\":\"https://docs.tavily.com#website\"}}]}"])</script><script>self.__next_f.push([1,"55:T2b53,"])</script><script>self.__next_f.push([1,":root {\n  --tavily-yellow: #78b0a1;\n}\n\n\n/* Dark theme enhancements for hero section */\n.bg-\\[\\#0a0a0a\\] {\n  background-color: #0a0a0a;\n}\n\n/* Scope ONLY to the welcome page tabs */\nul.welcome-tabs {\n  display: flex;\n}\n\n/* Each tab takes equal width */\nul.welcome-tabs \u003e li {\n  flex: 1 1 0%;\n  display: flex;\n}\n\n/* Make the button fill the tab width */\nul.welcome-tabs [data-component-part=\"tab-button\"] {\n  flex: 1 1 0%;\n  justify-content: center;\n  max-width: none; /* overrides max-w-max */\n  width: 100%;\n}\n\n/* CodeGroup spacing ONLY inside welcome tabs */\nul.welcome-tabs\n~ [data-component-part=\"tab-content\"]\n  .code-group {\n  margin-top: 0 !important;\n  margin-bottom: 0.25rem !important; /* Tailwind mb-1 */\n}\n\n[data-component-part=\"tab-content\"] .welcome-learn-more {\n  font-size: 12px;\n  text-decoration: none;\n  border-bottom: 1px solid transparent;\n  transition: border-color 0.15s ease;\n}\n\n[data-component-part=\"tab-content\"] .welcome-learn-more:hover {\n  border-bottom-color: var(--tavily-yellow);\n}\n\n[data-component-part=\"tab-content\"] .code-group {\n  margin-top: 0.5rem;   /* mt-2 */\n  margin-bottom: 0.5rem;\n}\n\n\n/* Footer social icons – default gray */\n.footer-social-icons \u003e a \u003e svg.icon {\n  background-color: #9da3af; /* Tailwind gray-400 */\n  transition: background-color 0.15s ease;\n}\n\n/* Hover state */\n.footer-social-icons \u003e a:hover \u003e svg.icon {\n  background-color: #e5e7eb; /* Tailwind gray-200 */\n}\n\n/* Hide the Mintlify framework footer on the /welcome page only */\nbody:has(.welcome-tabs) footer {\n  display: none !important;\n}\n\n.hidden.lg\\:flex \u003e .nav-tabs {\n  width: 100%;\n}\n\n.hidden.lg\\:flex \u003e .nav-tabs \u003e a.nav-tabs-item[href=\"/changelog\"] {\n  margin-left: auto;\n}\n\n/* Each block is labelled by the row above it, so its own vertical margins would only\n   detach it from that label. */\n.sdk-install .code-block {\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n}\n\n/* Mirrors the landing site's HeroAgentField: an overlapping logo deck that opens a\n   launcher menu. Kept visually in step with tavily-landing-v3. */\n.agent-setup {\n  position: relative;\n  /* Deck geometry, shared by the marks themselves and by the room the line needs to\n     scroll clear of them: three overlapped marks plus 25px of chevron, gap and padding. */\n  --agent-setup-mark: 22px;\n  --agent-setup-mark-overlap: 7px;\n  --agent-setup-deck: calc(\n    var(--agent-setup-mark) * 3 - var(--agent-setup-mark-overlap) * 2 + 25px\n  );\n  --agent-setup-surface: #ffffff;\n  --agent-setup-surface-0: rgb(255 255 255 / 0);\n  --agent-setup-line: rgb(9 9 11 / 0.1);\n  --agent-setup-hover: rgb(9 9 11 / 0.05);\n  --agent-setup-muted: rgb(9 9 11 / 0.45);\n  --agent-setup-text: rgb(9 9 11);\n}\n\n.dark .agent-setup {\n  --agent-setup-surface: #0b0c0e;\n  --agent-setup-surface-0: rgb(11 12 14 / 0);\n  --agent-setup-line: rgb(255 255 255 / 0.12);\n  --agent-setup-hover: rgb(255 255 255 / 0.08);\n  --agent-setup-muted: rgb(255 255 255 / 0.45);\n  --agent-setup-text: #ffffff;\n}\n\n.agent-setup .code-block {\n  margin: 0 !important;\n}\n\n/* Mintlify paints \u003cIcon\u003e with bg-primary on a masked svg, which lands green; the deck\n   and the menu rows want the icon to take the colour of the row it sits in. */\n.agent-setup svg.icon {\n  background-color: currentColor !important;\n}\n\n/* Lets the line scroll a little past the deck, as inline content. Padding on the scroll\n   container isn't counted in its scroll width, and padding on the code element is reset\n   by the code block's own styles — either way the tail stays stuck under the deck. */\n.agent-setup .code-block .line:first-child::after {\n  content: \"\";\n  display: inline-block;\n  width: calc(var(--agent-setup-deck) + 0.5rem);\n}\n\n/* The prompt is one line; the code block still renders a trailing empty one. */\n.agent-setup .code-block .line + .line {\n  display: none;\n}\n\n/* Clears the code block's button row (copy + Ask Assistant): 1rem edge inset + two 26px\n   buttons + 6px gaps. Static fallback for the measured inset further down. */\n.agent-setup-menu {\n  position: absolute;\n  top: 12px;\n  right: 5rem;\n  z-index: 20;\n}\n\n/* Opaque backdrop reaching to the copy button, so a scrolling line disappears into the\n   block's fill instead of sliding through the gaps in the deck. Fades in on the left\n   rather than cutting the text off at a hard edge. */\n.agent-setup-menu::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  /* Bounded to the text line: 1px short of the block's top edge so it doesn't paint over\n     the border, and stopping above the horizontal scrollbar at the foot of the block. */\n  top: calc(-0.75rem + 1px);\n  bottom: -2px;\n  left: -2.5rem;\n  right: -0.375rem;\n  background: linear-gradient(\n    to right,\n    var(--agent-setup-surface-0),\n    var(--agent-setup-surface) 2.5rem\n  );\n  pointer-events: none;\n}\n\n.agent-setup-trigger {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  height: 26px;\n  padding: 0 6px 0 3px;\n  border-radius: 999px;\n  color: var(--agent-setup-muted);\n  cursor: pointer;\n  transition: background-color 0.2s ease, color 0.2s ease;\n}\n\n.agent-setup-trigger:hover {\n  background: var(--agent-setup-hover);\n  color: var(--agent-setup-text);\n}\n\n.agent-setup-trigger:focus-visible {\n  outline: 2px solid rgb(120 176 161 / 0.7);\n  outline-offset: 2px;\n}\n\n.agent-setup-logos {\n  display: flex;\n  flex-shrink: 0;\n}\n\n/* Each mark sits on its own opaque disc so the overlap reads as a deck rather than a\n   collision; the ring must not enlarge the disc or the overlap maths shifts with it. The\n   disc is the wrapper, not the image, so inverting a dark mark leaves the fill alone. */\n.agent-setup-logo {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--agent-setup-mark);\n  height: var(--agent-setup-mark);\n  border-radius: 50%;\n  background: var(--agent-setup-surface);\n  box-shadow: 0 0 0 1px var(--agent-setup-line);\n}\n\n/* Tailwind's dark:invert doesn't survive the hosted build (Mintlify prefixes its\n   utilities), so the dark Cursor mark gets its own class. */\n.dark .agent-setup-mark-invert {\n  filter: invert(1);\n}\n\n.agent-setup-logo img {\n  width: 14px;\n  height: 14px;\n  margin: 0 !important;\n  object-fit: contain;\n}\n\n.agent-setup-logo + .agent-setup-logo {\n  margin-left: calc(var(--agent-setup-mark-overlap) * -1) !important;\n}\n\n/* Dealt left-over-right, so the stack fans towards the chevron. */\n.agent-setup-logo:nth-child(1) {\n  z-index: 3;\n}\n\n.agent-setup-logo:nth-child(2) {\n  z-index: 2;\n}\n\n.agent-setup-logo:nth-child(3) {\n  z-index: 1;\n}\n\n.agent-setup-chevron {\n  display: flex;\n  flex-shrink: 0;\n  transition: transform 0.2s ease;\n}\n\n.agent-setup-menu.is-open .agent-setup-chevron {\n  transform: rotate(180deg);\n}\n\n.agent-setup-popover {\n  display: none;\n  position: absolute;\n  top: calc(100% + 8px);\n  right: 0;\n  z-index: 20;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 220px;\n  padding: 6px;\n  border: 1px solid var(--agent-setup-line);\n  border-radius: 14px;\n  background: var(--agent-setup-surface);\n  box-shadow: 0 12px 28px rgb(11 9 7 / 0.12);\n  text-align: left;\n}\n\n.dark .agent-setup-popover {\n  box-shadow: 0 12px 28px rgb(0 0 0 / 0.45);\n}\n\n.agent-setup-menu.is-open .agent-setup-popover {\n  display: flex;\n}\n\n.agent-setup-group-label {\n  padding: 5px 10px 7px;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--agent-setup-muted);\n}\n\n.agent-setup-divider {\n  height: 1px;\n  margin: 5px 4px;\n  background: var(--agent-setup-line);\n}\n\n.agent-setup-option {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 10px;\n  border-radius: 9px;\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 1;\n  color: var(--agent-setup-text);\n  text-decoration: none;\n  white-space: nowrap;\n  transition: background-color 0.2s ease;\n}\n\n.agent-setup-option:hover {\n  background: var(--agent-setup-hover);\n}\n\n.agent-setup-option:focus-visible {\n  outline: 2px solid rgb(120 176 161 / 0.7);\n  outline-offset: -2px;\n}\n\n.agent-setup-option-logo {\n  width: 16px;\n  height: 16px;\n  margin: 0 !important;\n  flex-shrink: 0;\n  object-fit: contain;\n}\n\n/* Occupies the same 16px column as the agent logos so the footer row's text starts on\n   the same edge as the rows above it. */\n.agent-setup-option-icon {\n  display: flex;\n  flex-shrink: 0;\n  justify-content: center;\n  width: 16px;\n  color: var(--agent-setup-muted);\n}\n\n/* Pinned right so it reads as one column regardless of agent name length. */\n.agent-setup-option-action {\n  display: flex;\n  flex-shrink: 0;\n  margin-left: auto;\n  padding-left: 12px;\n  color: var(--agent-setup-muted);\n}\n\n@media (max-width: 640px) {\n  .agent-setup-menu {\n    right: 4.625rem;\n  }\n\n  .agent-setup {\n    --agent-setup-mark: 20px;\n    --agent-setup-mark-overlap: 6px;\n  }\n\n  .agent-setup-logo img {\n    width: 13px;\n    height: 13px;\n  }\n\n  .agent-setup-popover {\n    min-width: 200px;\n  }\n}\n\n/* Where anchor positioning is available, sit against the button row itself instead of a\n   guessed inset, so the deck moves only as far as the buttons Mintlify actually renders.\n   Screen only: the row is print:hidden, and an absent anchor would drop the deck back to\n   its static position. */\n@media screen {\n  @supports (anchor-name: --probe) {\n    .agent-setup .code-block [data-floating-buttons] {\n      anchor-name: --agent-setup-buttons;\n    }\n\n    /* Matches the row's own 6px gap. */\n    .agent-setup-menu {\n      position-anchor: --agent-setup-buttons;\n      right: calc(anchor(left) + 6px);\n    }\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .agent-setup-trigger,\n  .agent-setup-chevron,\n  .agent-setup-option {\n    transition: none;\n  }\n}\n\n/* Home page chunking: one hairline rule and one rhythm per section, so each block reads\n   as its own unit instead of running together. */\n:root {\n  --home-line: rgb(9 9 11 / 0.1);\n  --home-muted: rgb(9 9 11 / 0.5);\n}\n\n.dark {\n  --home-line: rgb(255 255 255 / 0.12);\n  --home-muted: rgb(255 255 255 / 0.5);\n}\n\n.home-section {\n  padding-top: 2.5rem;\n  padding-bottom: 2.5rem;\n  border-top: 1px solid var(--home-line);\n}\n\n/* The hero already separates the first section; its own rule would only box the hero in.\n   The hero's bottom padding stands in for the section's top padding. */\n.home-section-lead {\n  padding-top: 0;\n  border-top: 0;\n}\n\n/* Framed \"Try it now\" tabs. The frame is our own wrapper because Mintlify puts the\n   passed className on a different node between releases; the tab list's own border-b\n   becomes the divider between the labels and the panel. */\n.welcome-tabs-frame {\n  border: 1px solid var(--home-line);\n  border-radius: 14px;\n  overflow: hidden;\n}\n\n.welcome-tabs-frame ul[data-component-part=\"tabs-list\"],\n.welcome-tabs-frame ul.welcome-tabs {\n  margin-bottom: 0 !important;\n  padding-left: 1rem !important;\n  padding-right: 1rem !important;\n  border-color: var(--home-line) !important;\n}\n\n.welcome-tabs-frame [data-component-part=\"tab-content\"] {\n  padding: 1rem;\n}\n\n/* The frame's padding already insets the panel. */\n.welcome-tabs-frame [data-component-part=\"tab-content\"] .code-group {\n  margin-top: 0 !important;\n}\n"])</script><script>self.__next_f.push([1,"50:[\"$\",\"$L51\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$52\"}}],[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L53\",null,{\"pageMetadata\":\"$4a:props:pageMetadata\"}]],[\"$\",\"$L54\",null,{\"pageMetadata\":\"$4a:props:pageMetadata\"}],[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$55\"}}]],\"$L56\",\"$L57\"]}]\n"])</script><script>self.__next_f.push([1,"58:I[36098,[\"/mintlify-assets/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/d5b07934098b610