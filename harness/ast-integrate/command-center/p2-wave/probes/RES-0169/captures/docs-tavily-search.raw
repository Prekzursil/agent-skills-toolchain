AttributionConsent;\n  document.addEventListener(\"pointerdown\", decorate, true);\n  document.addEventListener(\"click\", decorate, true);\n\n  [\"pushState\", \"replaceState\"].forEach(function (method) {\n    const original = window.history[method];\n    window.history[method] = function () {\n      const result = original.apply(this, arguments);\n      syncAttributionConsent();\n      return result;\n    };\n  });\n  window.addEventListener(\"popstate\", syncAttributionConsent);\n\n  syncAttributionConsent();\n})();\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L58\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"690a63b5daef8898cbd18465\",\"subdomain\":\"tavilyai\",\"filePath\":\"onetrust.js\",\"__v\":0,\"content\":\"$59\"},{\"_id\":\"69125aa4a47d8ee618c58a83\",\"subdomain\":\"tavilyai\",\"filePath\":\"onetrust-footer.js\",\"__v\":0,\"content\":\"$5a\"},{\"_id\":\"69e7fe0d24b96b26b4d25ed7\",\"filePath\":\"equalweb-footer.js\",\"subdomain\":\"tavilyai\",\"__v\":0,\"content\":\"$5b\"},{\"_id\":\"69e7fe0d24b96b26b4d25f18\",\"subdomain\":\"tavilyai\",\"filePath\":\"equalweb.js\",\"__v\":0,\"content\":\"// EqualWeb accessibility widget\\n// Docs: https://login.equalweb.com/custom-button\\nwindow.interdeal = {\\n  get sitekey() {\\n    return \\\"4bc00e30adcaceca9706b68de7b04073\\\";\\n  },\\n  get domains() {\\n    return {\\n      js: \\\"https://cdn.equalweb.com/\\\",\\n      acc: \\\"https://access.equalweb.com/\\\",\\n    };\\n  },\\n  hideBtn: true,\\n  Position: \\\"Left\\\",\\n  Menulang: \\\"EN\\\",\\n  draggable: true,\\n};\\n\\n(function (doc, head, body) {\\n  var coreCall = doc.createElement(\\\"script\\\");\\n  coreCall.src = window.interdeal.domains.js + \\\"core/5.2.5/accessibility.js\\\";\\n  coreCall.defer = true;\\n  coreCall.integrity =\\n    \\\"sha512-Zamp30ps601kXvZTcIYv1sytUc090mrEJD9rLuoWzEGqmB6t0XdLRgC/g5TznUleEBIMm6T3c6Baf/ExIYh/Hw==\\\";\\n  coreCall.crossOrigin = \\\"anonymous\\\";\\n  coreCall.setAttribute(\\\"data-c