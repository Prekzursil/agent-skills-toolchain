4.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">Authorization</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>string</span></div><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>header</span></div><div class="whitespace-nowrap rounded-md bg-red-100/50 px-2 py-0.5 font-medium text-red-600 dark:bg-red-400/10 dark:text-red-300" data-component-part="field-required-pill">required</div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">Bearer authentication header in the form Bearer <!-- -->, where <!-- --> is your Tavily API key (e.g., Bearer tvly-YOUR_API_KEY).</p></div></div></div></div></div><div class="api-section"><div class="api-section-heading flex flex-col gap-y-4 w-full"><div class="flex items-baseline border-b pb-2.5 border-gray-100 dark:border-gray-800 w-full"><h4 class="api-section-heading-title flex-1 mb-0">Body</h4><div class="flex items-center"><div class="font-mono px-2 py-0.5 text-xs font-medium text-gray-600 dark:text-gray-300">application/json</div></div></div><div class="api-section-heading-subtitle text-sm prose prose-gray dark:prose-invert mb-2"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">Parameters for the Tavily Search request.</p></div></div></div><div class="object-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class=""><div class=""><div class=""><div class=""><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-query"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-query" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">query</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>string</span></div><div class="whitespace-nowrap rounded-md bg-red-100/50 px-2 py-0.5 font-medium text-red-600 dark:bg-red-400/10 dark:text-red-300" data-component-part="field-required-pill">required</div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">The search query to execute with Tavily.</p></div><div class="flex prose prose-sm prose-gray dark:prose-invert mt-6 gap-1.5"><span>Example<!-- -->:</span><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2 overflow-wrap-anywhere text-[13px] [&amp;_*]:text-[13px]"><p class="whitespace-pre-line"><code node="[object Object]"><span>"who is Leo Messi?"</span></code></p></div></div></div></div></div><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-search-depth"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-search-depth" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">search_depth</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>enum&lt;string&gt;</span></div><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span class="text-stone-400 dark:text-stone-500">default:</span><span>basic</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">Controls the latency vs. relevance tradeoff and how <code node="[object Object]"><span>results[].content</span></code> is generated:</p>
<ul class="list-inside list-disc whitespace-normal" data-streamdown="unordered-list">
<li class="py-1 [&amp;&gt;p]:inline" data-streamdown="list-item"><code node="[object Object]"><span>advanced</span></code>: Highest relevance with increased latency. Best for detailed, high-precision queries. Returns multiple semantically relevant snippets per URL (configurable via <code node="[object Object]"><span>chunks_per_source</span></code>).</li>
<li class="py-1 [&amp;&gt;p]:inline" data-streamdown="list-item"><code node="[object Object]"><span>basic</span></code>: A balanced option for relevance and latency. Ideal for general-purpose searches. Returns multiple semantically relevant snippets per URL (configurable via <code node="[object Object]"><span>chunks_per_source</span></code>).</li>
<li class="py-1 [&amp;&gt;p]:inline" data-streamdown="list-item"><code node="[object Object]"><span>fast</span></code>: Prioritizes lower latency while maintaining good relevance. Returns multiple semantically relevant snippets per URL (configurable via <code node="[object Object]"><span>chunks_per_source</span></code>).</li>
<li class="py-1 [&amp;&gt;p]:inline" data-streamdown="list-item"><code node="[object Object]"><span>ultra-fast</span></code>: Minimizes latency above all else. Best for time-critical use cases. Returns one NLP summary per URL.</li>
</ul>
<p class="whitespace-pre-line"><span class="font-semibold" data-streamdown="strong">Cost</span>:</p>
<ul class="list-inside list-disc whitespace-normal" data-streamdown="unordered-list">
<li class="py-1 [&amp;&gt;p]:inline" data-streamdown="list-item"><code node="[object Object]"><span>basic</span></code>, <code node="[object Object]"><span>fast</span></code>, <code node="[object Object]"><span>ultra-fast</span></code>: 1 API Credit</li>
<li class="py-1 [&amp;&gt;p]:inline" data-streamdown="list-item"><code node="[object Object]"><span>advanced</span></code>: 2 API Credits</li>
</ul>
<p class="whitespace-pre-line">See <a class="link" href="/documentation/best-practices/best-practices-search#search-depth">Search Best Practices</a> for guidance on choosing the right search depth.</p></div><div class="whitespace-pre-wrap prose-sm mt-6">Available options<!-- -->:<!-- --> <div class="inline-block"><code>advanced</code>,<!-- --> </div><div class="inline-block"><code>basic</code>,<!-- --> </div><div class="inline-block"><code>fast</code>,<!-- --> </div><div class="inline-block"><code>ultra-fast</code> </div></div></div></div></div><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-chunks-per-source"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-chunks-per-source" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">chunks_per_source</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>integer</span></div><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span class="text-stone-400 dark:text-stone-500">default:</span><span>3</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">Chunks are short content snippets (maximum 500 characters each) pulled directly from the source. Use <code node="[object Object]"><span>chunks_per_source</span></code> to define the maximum number of relevant chunks returned per source and to control the <code node="[object Object]"><span>content</span></code> length. Chunks will appear in the <code node="[object Object]"><span>content</span></code> field as: <code node="[object Object]"><span>&#x3C;chunk 1> [...] &#x3C;chunk 2> [...] &#x3C;chunk 3></span></code>. Available when <code node="[object Object]"><span>search_depth</span></code> is <code node="[object Object]"><span>advanced</span></code>, <code node="[object Object]"><span>basic</span></code> or <code node="[object Object]"><span>fast</span></code>.</p></div><div class="prose prose-sm prose-gray dark:prose-invert mt-6">Required range<!-- -->: <code>1 &lt;= x &lt;= 3</code></div></div></div></div><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-max-results"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-max-results" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">max_results</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>integer</span></div><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span class="text-stone-400 dark:text-stone-500">default:</span><span>5</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">The maximum number of search results to return.</p></div><div class="prose prose-sm prose-gray dark:prose-invert mt-6">Required range<!-- -->: <code>0 &lt;= x &lt;= 20</code></div><div class="flex prose prose-sm prose-gray dark:prose-invert mt-6 gap-1.5"><span>Example<!-- -->:</span><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2 overflow-wrap-anywhere text-[13px] [&amp;_*]:text-[13px]"><p class="whitespace-pre-line"><code node="[object Object]"><span>1</span></code></p></div></div></div></div></div><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-topic"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-topic" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">topic</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>enum&lt;string&gt;</span></div><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span class="text-stone-400 dark:text-stone-500">default:</span><span>general</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">The category of the search.<code node="[object Object]"><span>news</span></code> is useful for retrieving real-time updates, particularly about politics, sports, and major current events covered by mainstream media sources. <code node="[object Object]"><span>general</span></code> is for broader, more general-purpose searches that may include a wide range of sources.</p></div><div class="whitespace-pre-wrap prose-sm mt-6">Available options<!-- -->:<!-- --> <div class="inline-block"><code>general</code>,<!-- --> </div><div class="inline-block"><code>news</code>,<!-- --> </div><div class="inline-block"><code>finance</code> </div></div></div></div></div><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-time-range"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-time-range" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">time_range</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>enum&lt;string&gt;</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">The time range back from the current date to filter results based on publish date or last updated date. Useful when looking for sources that have published or updated data.</p></div><div class="whitespace-pre-wrap prose-sm mt-6">Available options<!-- -->:<!-- --> <div class="inline-block"><code>day</code>,<!-- --> </div><div class="inline-block"><code>week</code>,<!-- --> </div><div class="inline-block"><code>month</code>,<!-- --> </div><div class="inline-block"><code>year</code>,<!-- --> </div><div class="inline-block"><code>d</code>,<!-- --> </div><div class="inline-block"><code>w</code>,<!-- --> </div><div class="inline-block"><code>m</code>,<!-- --> </div><div class="inline-block"><code>y</code> </div></div></div></div></div><div class="primitive-param-field border-gray-100 dark:border-gray-800 border-b last:border-b-0"><div class="py-6"><div class="flex font-mono text-sm group/param-head param-head break-all relative" id="body-start-date"><div class="flex-1 flex flex-col content-start py-0.5 mr-5"><div class="flex items-center flex-wrap gap-2"><div class="absolute -top-1.5"><a href="#body-start-date" class="-ml-10 flex items-center opacity-0 border-0 group-hover/param-head:opacity-100 focus:opacity-100 focus:outline-0 py-2 [.expandable-content_&amp;]:-ml-[2.1rem] group/link" aria-label="Navigate to header">​<div class="w-6 h-6 rounded-md flex items-center justify-center shadow-sm text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.827C8.148 6.995 7.818 7.225 7.527 7.517L7.517 7.527C6.136 8.908 6.136 11.146 7.517 12.527L9.692 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 11.173C9.852 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.308 3.298C6.927 1.917 4.689 1.917 3.308 3.298L3.298 3.308C1.917 4.689 1.917 6.927 3.298 8.308L4.229 9.239" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></a></div><div class="font-semibold text-primary dark:text-primary-light overflow-wrap-anywhere cursor-pointer" data-component-part="field-name">start_date</div><div class="inline items-center gap-2 text-xs font-medium [&amp;_div]:inline [&amp;_div]:mr-2 [&amp;_div]:leading-5" data-component-part="field-meta"><div class="flex items-center gap-1 break-all rounded-md bg-stone-100/50 px-2 py-0.5 font-medium text-stone-600 dark:bg-white/5 dark:text-stone-200" data-component-part="field-info-pill"><span>string</span></div></div></div></div></div><div class="mt-4"><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;li]:before:top-[0.75em] [&amp;_li_p.whitespace-pre-line]:!my-0 [&amp;_li.py-1]:!py-0 [&amp;_li.py-1]:!my-2"><p class="whitespace-pre-line">Will return all results after the specified start date based on publish date or last updated date. Required to be written in the format YYYY-MM-DD</p></div><div class="flex prose prose-sm prose-gray dark:prose-invert mt-6 gap-1.5"><span>Example<!-- -->:</span><div class="space-y-4 whitespace-normal prose prose-sm prose-gray dark:prose-invert overflow-wrap-anywhere [&amp;_*]:overflow-wrap-anywhere [&amp;_ul]:list-none [&amp;_ul&gt;