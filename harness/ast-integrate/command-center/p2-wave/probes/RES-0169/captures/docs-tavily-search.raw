t strips\n  // the params from the URL, so currentVisit still reflects the UTMs the visit arrived with.\n  function ensureCaptured() {\n    if (firstTouch === null) {\n      firstTouch = readCurrentAttribution();\n      currentVisit = firstTouch;\n    }\n  }\n\n  function recoverPostHogAttribution() {\n    const ph = window.posthog;\n    if (!ph || !ph.__loaded || typeof ph.get_property !== \"function\") return false;\n\n    let info;\n    try {\n      info = ph.get_property(\"$initial_person_info\");\n    } catch (e) {\n      return false;\n    }\n\n    // PostHog's `$initial_person_info`: r = first-touch referrer, u = first-touch URL.\n    const personInfo = info \u0026\u0026 typeof info === \"object\" ? info : null;\n    const url = parseUrl(personInfo \u0026\u0026 personInfo.u);\n\n    if (!url) {\n      postHogFirstTouchWasMissing = true;\n      return false;\n    }\n\n    const recovered = collectParams(url, ATTRIBUTION_PARAMS);\n    if (!recovered.ref_domain) {\n      const referrer = personInfo.r === \"$direct\" ? null : parseUrl(personInfo.r);\n      if (referrer \u0026\u0026 !isTavilyHost(referrer.hostname)) {\n        recovered.ref_domain = referrer.hostname;\n      }\n    }\n    if (!recovered.landing) recovered.landing = url.host + url.pathname;\n\n    // Latest-wins: a visit with its own campaign params overrides the stored first-touch.\n    // Otherwise PostHog's recovered value stands, except when an earlier recovery had\n    // failed — then the stored first-touch is kept and recovered only backfills its gaps.\n    if (hasCampaignParams(currentVisit)) {\n      firstTouch = currentVisit;\n    } else if (postHogFirstTouchWasMissing) {\n      firstTouch = { ...recovered, ...firstTouch };\n    } else {\n      firstTouch = recovered;\n    }\n    return true;\n  }\n\n  function updateCurrentUrl(includeAttribution) {\n    const url = new URL(window.location.href);\n    const originalSearch = url.search;\n\n    for (const key of ATTRIBUTION_PARAMS) {\n     