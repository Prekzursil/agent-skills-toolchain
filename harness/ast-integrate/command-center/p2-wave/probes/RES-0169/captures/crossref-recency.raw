-parts":[[2026,3,16]],"date-time":"2026-03-16T02:46:07Z","timestamp":1773629167000},"page":"4736-4743","source":"Crossref","is-referenced-by-count":0,"title":["KAHLT: Kolmogorov-Arnold Hybrid Latent Transformer - A Hybrid Transformer For Classification Tasks"],"prefix":"10.5220","author":[{"given":"Sanyam","family":"Jain","sequence":"first","affiliation":[{"name":"Postman Innovation Lab, Birla Institue of Technology and Science, Pilani, India"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Siddharth","family":"Khare","sequence":"additional","affiliation":[{"name":"Postman Innovation Lab, Birla Institue of Technology and Science, Pilani, India"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Paarth","family":"Goyal","sequence":"additional","affiliation":[{"name":"Postman Innovation Lab, Birla Institue of Technology and Science, Pilani, India"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Jagat","family":"Challa","sequence":"additional","affiliation":[{"name":"Postman Innovation Lab, Birla Institue of Technology and Science, Pilani, India"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"3171","event":{"name":"18th International Conference on Agents and Artificial Intelligence","location":"Marbella, Spain","start":{"date-parts":[[2026,3,5]]},"end":{"date-parts":[[2026,3,8]]}},"container-title":["Proceedings of the 18th International Conference on Agents and Artificial Intelligence"],"original-title":["KAHLT: Kolmogorov-Arnold Hybrid Latent Transformer - A Hybrid Transformer For Classification Tasks"],"deposited":{"date-parts":[[2026,5,14]],"date-time":"2026-05-14T04:25:08Z","timestamp":1778732708000},"score":11.9533,"resource":{"primary":{"URL":"https:\/\/www.scitepress.org\/DigitalLibrary\/Link.aspx?doi=10.5220\/0014488700004052"}},"subtitle":[""],"issued":{"date-parts":[[2026]]},"references-count":0,"URL":"https:\/\/doi.org\/10.5220\/0014488700004052","published":{"date-parts":[[2026]]}},{"indexed":{"date-parts":[[2026,6,30]],"date-time":"2026-06-30T22:52:28Z","timestamp":1782859948639,"version":"3.54.5"},"posted":{"date-parts":[[2025,9,22]]},"reference-count":0,"publisher":"Wiley","content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>In this paper, an impedance transformer with wide operating bandwidth\nand high selectivity is presented. The required impedance parameters can\nbe directly determined based on the specified impedance transformation\nratio, bandwidth, and in-band return loss requirements. For validation\nof the proposed circuit, the impedance transformers are designed at the\ncenter frequency (f0) of 2.4 GHz using an impedance-transforming ratio\n(r) of 0.5. The filtering impedance transformer with FBW = 90% and RL =\n20 dB is fabricated and measured to verify the prediction.<\/jats:p>","DOI":"10.22541\/au.175850840.06590000\/v1","type":"posted-content","created":{"date-parts":[[2025,9,22]],"date-time":"2025-09-22T02:33:32Z","timestamp":1758508412000},"source":"Crossref","is-referenced-by-count":0,"title":["Synthesis Design of Filtering Impedance Transformer With Wide Operating Bandwidth and Enhanced Impedance Transformer Ratio"],"prefix":"10.22541","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-4117-8222","authenticated-orcid":false,"given":"Di","family":"Wang","sequence":"first","affiliation":[{"name":"Nanjing University of Science and Technology"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","link":[{"URL":"https:\/\/www.authorea.com\/doi\/pdf\/10.22541\/au.175850840.06590000\/v1","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,6,30]],"date-time":"2026-06-30T22:05:39Z","timestamp":1782857139000},"score":11.858173,"resource":{"primary":{"URL":"https:\/\/www.authorea.com\/doi\/full\/10.22541\/au.175850840.06590000\/v1"}},"issued":{"date-parts":[[2025,9,22]]},"references-count":0,"URL":"https:\/\/doi.org\/10.22541\/au.175850840.06590000\/v1","published":{"date-parts":[[2025,9,22]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2026,7,16]],"date-time":"2026-07-16T18:05:13Z","timestamp":1784225113232,"version":"3.55.0"},"publisher-location":"Lyon","reference-count":0,"publisher":"ENS \u00c9ditions","isbn-type":[{"value":"9791036208362","type":"electronic"},{"value":"9791036208348","type":"print"}],"license":[{"start":{"date-parts":[[2025,1,1]],"date-time":"2025-01-01T00:00:00Z","timestamp":1735689600000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/www.openedition.org\/12554"}],"content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2025]]},"DOI":"10.4000\/13ybz","type":"book-chapter","created":{"date-parts":[[2025,5,20]],"date-time":"2025-05-20T07:47:56Z","timestamp":1747727276000},"page":"7-10","source":"Crossref","is-referenced-by-count":0,"title":["L\u2019\u00e9cole \u00e9cologique\u00a0: s\u2019ajuster ou transformer\u00a0?"],"prefix":"10.4000","author":[{"given":"H\u00e9l\u00e8ne","family":"Buisson-Fenet","sequence":"first","affiliation":[{"name":"ENS de Lyon"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"2399","container-title":["L\u2019\u00e9cole \u00e9cologique : s\u2019ajuster ou transformer\u00a0?"],"language":"fr","deposited":{"date-parts":[[2026,7,16]],"date-time":"2026-07-16T17:27:21Z","timestamp":1784222841000},"score":11.855446,"resource":{"primary":{"URL":"https:\/\/books.openedition.org\/enseditions\/63051"}},"issued":{"date-parts":[[2025]]},"ISBN":["9791036208362","9791036208348"],"references-count":0,"URL":"https:\/\/doi.org\/10.4000\/13ybz","published":{"date-parts":[[2025]]}},{"indexed":{"date-parts":[[2026,5,25]],"date-time":"2026-05-25T18:04:11Z","timestamp":1779732251324,"version":"3.53.1"},"posted":{"date-parts":[[2026,5,25]]},"reference-count":0,"publisher":"Open Engineering Inc","license":[{"start":{"date-parts":[[2026,5,25]],"date-time":"2026-05-25T00:00:00Z","timestamp":1779667200000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>Diabetic Retinopathy (DR) is a vision-threatening complication of diabetes mellitus that progresses silently through five clinically defined severity grades. Timely automated screening is critical to prevent irreversible vision loss, particularly in resource-constrained healthcare settings. This paper presents a systematic comparative study of three state-ofthe-art deep learning architectures-Vision Transformer (ViTBase\/16), Swin Transformer (swin base patch4 window7 224), and InceptionResNetV2-applied to five-class DR grading on the APTOS 2019 fundus image dataset (3,662 images). All models employ transfer learning from ImageNet-pretrained weights. We analyze each architecture from the perspectives of classification accuracy, per-class F1-score, macro-averaged AUC, GradCAMbased explainability, training dynamics, and parameter efficiency. Our ViT-Base\/16 model, fine-tuned end-to-end with AdamW, cosine annealing, and label smoothing, achieves the highest validation accuracy of 85.40% with a macro-averaged F1-score of 0.7247. Swin Transformer achieves 83.20% accuracy, while InceptionResNetV2 achieves 81.40% through two-stage transfer learning. GradCAM visualizations confirm clinically aligned lesion localization across all architectures. This work provides architectural insights for deploying robust DR screening systems in clinical environments.<\/jats:p>","DOI":"10.31224\/7150","type":"posted-content","created":{"date-parts":[[2026,5,25]],"date-time":"2026-05-25T17:20:38Z","timestamp":1779729638000},"source":"Crossref","is-referenced-by-count":0,"title":["Comparative Study of Deep Learning Architectures for Automated Diabetic Retinopathy Grading: Vision Transformer, Swin Transformer, and InceptionResNetV2"],"prefix":"10.31224","author":[{"given":"Prajwal","family":"Khandait","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"33966","deposited":{"date-parts":[[2026,5,25]],"date-time":"2026-05-25T17:20:38Z","timestamp":1779729638000},"score":11.684093,"resource":{"primary":{"URL":"https:\/\/engrxiv.org\/preprint\/view\/7150\/version\/9280"}},"issued":{"date-parts":[[2026,5,25]]},"references-count":0,"URL":"https:\/\/doi.org\/10.31224\/7150","published":{"date-parts":[[2026,5,25]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2025,5,14]],"date-time":"2025-05-14T04:14:20Z","timestamp":1747196060490,"version":"3.40.5"},"reference-count":0,"publisher":"Science Research Society","issue":"42s","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["jisem"],"abstract":"<jats:p>Transformers are vital in the distribution of power. Their reliability is of utmost importance. Over time, these machines can wear down, leading to potential failures and safety issues. This study aims to identify partial discharge in Transformer #3 GIS Kemang, which has been running for almost three decades. Acoustic Emission method is considered to examine its internal state and gauge the risks of failure. This method was prompted by a troubling rise in acetylene levels from the Dissolved Gas Analysis, revealing signs of arching. High-Frequency Current Transformer and Acoustic Emission sensors were placed in high-risk locations to track PD activity during regular operations. Data were collected in real time with a PowerPD TP500A system, allowing for the classification of PD events based on pulse intervals. The findings revealed a source of partial discharge on the HV\/Tubular side. The AE Sensors captured a repeating butterfly-shaped pattern of wave with intervals of 20.332 milliseconds, and the HFCT sensors picked up bursts with intervals of 0.102 milliseconds. Following the Acoustic Emission and High-Frequency Current Transformer testing, a visual inspection of the transformer's internal components was conducted and confirmed the presence of discharge marks (treeing) on the pertinax magnetic shunt, corroborating the AE sensor data that indicated signs of electrical stress that could hasten the decay of insulation. Additionally, spot marks were observed on the insulation material surrounding the high-voltage (HV) Phase T winding, further supporting the hypothesis that electrical stress contributed to insulation breakdown.<\/jats:p>","DOI":"10.52783\/jisem.v10i42s.7910","type":"journal-article","created":{"date-parts":[[2025,5,13]],"date-time":"2025-05-13T09:45:15Z","timestamp":1747129515000},"page":"490-503","source":"Crossref","is-referenced-by-count":0,"title":["Vibration Analysis of Transformer as an Early Diagnosis of Internal Transformer Faults:  (Case Study of Transformer #3 GIS Kemang)"],"prefix":"10.52783","volume":"10","author":[{"family":"Yuniar Rizky","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"30593","published-online":{"date-parts":[[2025,5,3]]},"container-title":["Journal of Information Systems Engineering and Management"],"link":[{"URL":"https:\/\/jisem-journal.com\/index.php\/journal\/article\/download\/7910\/3617","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jisem-journal.com\/index.php\/journal\/article\/download\/7910\/3617","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,5,13]],"date-time":"2025-05-13T09:45:15Z","timestamp":1747129515000},"score":11.65679,"resource":{"primary":{"URL":"https:\/\/jisem-journal.com\/index.php\/journal\/article\/view\/7910"}},"issued":{"date-parts":[[2025,5,3]]},"references-count":0,"journal-issue":{"issue":"42s","published-online":{"date-parts":[[2025,5,3]]}},"URL":"https:\/\/doi.org\/10.52783\/jisem.v10i42s.7910","ISSN":["2468-4376"],"issn-type":[{"value":"2468-4376","type":"electronic"}],"published":{"date-parts":[[2025,5,3]]}}],"items-per-page":8,"query":{"start-index":0,"search-terms":"transformer"}}}