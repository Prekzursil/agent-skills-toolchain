<script type="text/javascript">
/*<![CDATA[*/

$(document).ready(function() {
var showText='expand';
var hideText='minimize';
$('.toggle').before(' (\<a href="#" class="toggleLink">'+hideText+'\</a>)');
//$('.toggle').hide();
$('a.toggleLink').click(function() {
if($(this).text() == showText){
$(this).text(hideText);
} else {
$(this).text(showText);
}
$(this).next('.toggle').toggle('slow');
return false;
});
$('a.showHideAll').click(function(){
if ($('a.showHideAll').text() == "Expand all") {
$('.toggle').show();
$('a.toggleLink').text(hideText);
$('a.showHideAll').text("Minimize all");
} else {
$('.toggle').hide();
$('a.toggleLink').text(showText);
$('a.showHideAll').text("Expand all");
}
});
});
$(document).on("scroll", function(e) {
var scroll = $(document).scrollTop();
// console.log(scroll);
if(scroll > 558){
var top = scroll - 265;
$(".showHideAll").css('top', top +'px');
} else {
$(".showHideAll").css('top', '300px');
}
});

/*]]>*/
</script>
