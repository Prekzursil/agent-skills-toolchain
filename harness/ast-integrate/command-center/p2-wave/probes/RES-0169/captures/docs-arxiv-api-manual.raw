  document.cookie.split(';').forEach(function(c) {
    var name = c.trim().split('=')[0];
    if (/^(_ga|_gid|_gat|__utm)/.test(name)) {
      document.cookie = name + '=; Max-Age=0; path=/; domain=.arxiv.org;';
    }
  });
</script>

      

  

