{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0102/council-design-note.schema.json",
  "title": "CNL-0102 binding-matrix design note (per-unit; catalog schema is a generated $ref shim)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "declared_metric",
    "information_flow",
    "size_sweep",
    "measured",
    "binding_matrix",
    "nearest_neighbours",
    "metric_blind_spot",
    "tests",
    "negative_controls",
    "reviewer",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "pattern": "^CNL-0102$" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "^SUCCESS:CNL-0102"
    },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "declared_metric": {
      "type": "object",
      "required": ["name", "formula", "chair_beats_when"],
      "properties": {
        "name": { "type": "string", "minLength": 8 },
        "formula": { "type": "string", "minLength": 16 },
        "chair_beats_when": { "type": "string", "minLength": 16 }
      }
    },
    "information_flow": {
      "type": "object",
      "required": ["flat", "chair_led", "what_changes"],
      "properties": {
        "flat": { "type": "string", "minLength": 16 },
        "chair_led": { "type": "string", "minLength": 16 },
        "what_changes": { "type": "string", "minLength": 16 }
      }
    },
    "size_sweep": {
      "type": "object",
      "required": ["crossover_n", "necessary_means", "tidier_means", "rows"],
      "properties": {
        "crossover_n": { "type": "integer", "minimum": 2 },
        "necessary_means": { "type": "string", "minLength": 8 },
        "tidier_means": { "type": "string", "minLength": 8 },
        "rows": { "type": "array", "minItems": 3 }
      }
    },
    "measured": {
      "type": "object",
      "required": [
        "protocol_count",
        "preset_count",
        "pair_count",
        "distinct_signature_count",
        "floor",
        "floor_met",
        "below_threshold_pair_count",
        "below_threshold_pairs"
      ],
      "properties": {
        "protocol_count": { "type": "integer", "const": 58 },
        "preset_count": { "type": "integer", "const": 72 },
        "pair_count": { "type": "integer", "const": 2556 },
        "distinct_signature_count": { "type": "integer", "minimum": 64 },
        "floor": { "type": "integer", "const": 64 },
        "floor_met": { "type": "boolean", "const": true },
        "below_threshold_pair_count": { "type": "integer", "minimum": 1 }
      }
    },
    "binding_matrix": { "type": "array", "minItems": 72, "maxItems": 72 },
    "nearest_neighbours": { "type": "array", "minItems": 72, "maxItems": 72 },
    "metric_blind_spot": { "type": "string", "minLength": 40 },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verbatim"],
        "properties": {
          "id": { "type": "string" },
          "verbatim": { "type": "string", "minLength": 16 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewer_id",
        "verdict",
        "independent",
        "recount_agrees",
        "recounted_distinct_signature_count",
        "recounted_pair_count"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" },
        "recount_agrees": { "type": "boolean", "const": true }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "role": { "type": "string" }
        }
      }
    }
  }
}
