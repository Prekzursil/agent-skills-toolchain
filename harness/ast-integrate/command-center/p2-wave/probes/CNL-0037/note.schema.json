{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/CNL-0037/note.schema.json",
  "title": "CNL-0037 nested-council fan-in design note",
  "$comment": "Unit-local contract. The catalog output_schema is a $ref shim to ast-integrate.invalid and cannot be resolved on this image (jsonschema 4.10 RefResolver). G-1 still requires parse + live probes + per-unit sha. This schema exists so missing negative_controls is a ValidationError rather than a network error.",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "const": "CNL-0037" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:CNL-0037" },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "line", "snippet", "kind", "claim"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "snippet": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": { "const": "PASS" }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rejects", "verbatim"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rejects": { "type": "string", "minLength": 1 },
          "verbatim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "re_ran_both_states"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "verdict": { "const": "PASS" },
        "independent": { "const": true },
        "re_ran_both_states": { "const": true }
      }
    }
  }
}
