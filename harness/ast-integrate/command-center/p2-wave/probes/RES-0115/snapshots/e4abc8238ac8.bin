json`}),` in the project root:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --scope`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` project`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` claude-code-docs`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://code.claude.com/docs/mcp`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Commit `,_jsx(_components.code,{children:`.mcp.json`}),` to version control. Teammates who clone the repository and start Claude Code see a prompt to approve the server, then it connects for them too.`]}),`\n`,_jsx(Heading,{level:`2`,id:`additional-mcp-server-examples`,children:`Additional MCP server examples`}),`\n`,_jsx(_components.p,{children:`The first walkthrough used a hosted server that connects without any sign-in. The examples below cover the other two common shapes, with the same add, check, use flow.`}),`\n`,_jsx(Heading,{level:`3`,id:`add-a-local-server`,children:`Add a local server`}),`\n`,_jsx(_components.p,{children:`A local stdio server is a program Claude Code starts as a subprocess on your machine, rather than a service it reaches over a URL. Use one for tools that need access to local resources like a browser, your filesystem, or a database socket.`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.a,{href:`https://github.com/microsoft/playwright-mcp`,children:`Playwright MCP server`}),` is a good one to try: it gives Claude a browser it can navigate, click, and read, and it needs no account. It runs through `,_jsx(_components.code,{children:`npx`}),`, so it requires `,_jsx(_components.a,{href:`https://nodejs.org/en/download`,children:`Node.js`}),` 18 or later.`]}),`\n`,_jsxs(Steps,{children:[_jsxs(Step,{title:`Add the Playwright server`,children:[_jsx(_components.p,{children:`Register the server with the command Claude Code should run to start it:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` playwright`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` npx`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` -y`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` @playwright/mcp@latest`})]}),`\n`]})})}),_jsx(_components.p,{children:`This command differs from the hosted example in three ways:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`There’s no `,_jsx(_components.code,{children:`--transport`}),` flag, because local servers use the default `,_jsx(_components.code,{children:`stdio`}),` transport.`]}),`\n`,_jsxs(_components.li,{children:[`Everything after the `,_jsx(_components.code,{children:`--`}),` separator is the command Claude Code runs to start the server.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`-y`}),` tells `,_jsx(_components.code,{children:`npx`}),` to install the package without prompting.`]}),`\n`]}),_jsxs(_components.p,{children:[`The command prints a confirmation like `,_jsx(_components.code,{children:`Added stdio MCP server playwright with command: npx -y @playwright/mcp@latest to local config`}),`, followed by a `,_jsx(_components.code,{children:`File modified:`}),` line showing the configuration file it wrote.`]}),_jsxs(_components.p,{children:[`Playwright drives whichever Chrome is already installed on your machine. To use a different browser, append `,_jsx(_components.code,{children:`--browser`}),` with the browser name, for example `,_jsx(_components.code,{children:`--browser firefox`}),`, after `,_jsx(_components.code,{children:`@playwright/mcp@latest`}),`.`]})]}),_jsxs(Step,{title:`Check the connection`,children:[_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`Added`}),` confirmation means the entry was saved, not that the command runs. Check the connection:`]}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` list`})]}),`\n`]})})}),_jsxs(_components.p,{children:[`The first check can show `,_jsx(_components.code,{children:`✘ Failed to connect`}),` while `,_jsx(_components.code,{children:`npx`}),` downloads the package, so wait a moment and run it again. Once the download finishes, the status changes to `,_jsx(_components.code,{children:`✔ Connected`}),`. If it still shows `,_jsx(_components.code,{children:`✘ Failed to connect`}),` after a couple of retries, see `,_jsx(_components.a,{href:`#troubleshooting`,children:`Troubleshooting`}),`.`]})]}),_jsxs(Step,{title:`Use the browser`,children:[_jsx(_components.p,{children:`Give Claude a task that needs the browser:`}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Use playwright to open https://example.com and tell me the page title`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsxs(_components.p,{children:[`A browser window opens so you can watch it work, and the tool calls in Claude’s output are labeled with the `,_jsx(_components.code,{children:`playwright`}),` server name and the action, like `,_jsx(_components.code,{children:`browser_navigate`}),`.`]}),_jsx(_components.p,{children:`Try pointing it at your local dev server to check that a page still renders after a change, or have it walk through a bug report step by step.`})]})]}),`\n`,_jsx(Heading,{level:`3`,id:`connect-a-server-that-requires-sign-in`,children:`Connect a server that requires sign-in`}),`\n`,_jsx(_components.p,{children:`Hosted services like Sentry, Linear, and Notion run their MCP servers behind OAuth: you add the server’s URL, then sign in through your browser.`}),`\n`,_jsxs(_components.p,{children:[`The steps below use Sentry as the example. To connect a different service, substitute its URL, which you can find in the `,_jsx(_components.a,{href:`/en/mcp#find-and-build-mcp-servers`,children:`Anthropic Directory`}),` or the service’s documentation.`]}),`\n`,_jsxs(Steps,{children:[_jsxs(Step,{title:`Add the server`,children:[_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`add`}),` command is the same as for the docs server, with Sentry’s URL:`]}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` sentry`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.sentry.dev/mcp`})]}),`\n`]})})}),_jsxs(_components.p,{children:[`After adding, `,_jsx(_components.code,{children:`claude mcp list`}),` shows the server with `,_jsx(_components.code,{children:`! Needs authentication`}),`. That’s expected: the next step completes the sign-in.`]})]}),_jsxs(Step,{title:`Authenticate in your browser`,children:[_jsx(_components.p,{children:`Start a Claude Code session and open the MCP panel:`}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/mcp`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsxs(_components.p,{children:[`Select `,_jsx(_components.code,{children:`sentry`}),` from the list, press Enter, and choose `,_jsx(_components.code,{children:`Authenticate`}),`. Your browser opens to Sentry’s sign-in page. Approve the connection there.`]}),_jsxs(_components.p,{children:[`Back in Claude Code, the server’s status changes to connected. If sign-in fails or the browser doesn’t open, see `,_jsx(_components.a,{href:`#troubleshooting`,children:`Troubleshooting`}),`.`]})]}),_jsx(Step,{title:`Use the server`,children:_jsxs(_components.p,{children:[`Ask Claude something that needs the service, like `,_jsx(_components.code,{children:`What Sentry projects do I have access to?`}),`, and look for tool calls labeled with the `,_jsx(_components.code,{children:`sentry`}),` server name in its output.`]})})]}),`\n`,_jsxs(_components.p,{children:[`Servers that authenticate with a static token instead of OAuth take the token at add time with `,_jsx(_components.code,{children:`--header \"Authorization: Bearer \u003ctoken\u003e\"`}),`. See the `,_jsx(_components.a,{href:`/en/mcp#example-connect-to-github-for-code-reviews`,children:`GitHub example`}),` for a worked version.`]}),`\n`,_jsx(Heading,{level:`2`,id:`edit-mcp-json-directly`,children:`Edit .mcp.json directly`}),`\n`,_jsxs(_components.p,{children:[`Every file in the `,_jsx(_components.a,{href:`#find-your-configuration-on-disk`,children:`scope table`}),` uses the same JSON format for server entries. This section edits `,_jsx(_components.code,{children:`.mcp.json`}),`, the project-scope file. It’s the one most worth writing by hand because it’s checked into the repository, where it doubles as configuration-as-code for your team.`]}),`\n`,_jsxs(_components.p,{children:[`Create `,_jsx(_components.code,{children:`.mcp.json`}),` in your project root. The example below defines both servers from this guide, the hosted docs server reached over HTTP and the Playwright server as a local `,_jsx(_components.code,{children:`stdio`}),` process:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`13`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`13`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"mcpServers\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"claude-code-docs\"`}),_jsx(_compon