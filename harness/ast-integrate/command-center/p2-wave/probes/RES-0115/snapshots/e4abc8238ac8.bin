ts.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"npx\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"args\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"-y\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"@playwright/mcp@latest\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`The fields differ by server type:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`For HTTP servers, `,_jsx(_components.code,{children:`url`}),` is the endpoint Claude Code connects to.`]}),`\n`,_jsxs(_components.li,{children:[`For stdio servers, `,_jsx(_components.code,{children:`command`}),` and `,_jsx(_components.code,{children:`args`}),` are the program it runs.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`After saving the file, start a new Claude Code session in the project. Claude Code reads `,_jsx(_components.code,{children:`.mcp.json`}),` at startup.`]}),`\n`,_jsxs(_components.p,{children:[`The first time Claude Code sees a project-scoped server, it asks you to approve it. The prompt exists so a repository you clone can’t launch processes on your machine without your consent. Approve the prompt, or run `,_jsx(_components.code,{children:`/mcp`}),` to approve later if you missed it.`]}),`\n`,_jsxs(_components.p,{children:[`Once you’ve approved, run `,_jsx(_components.code,{children:`/mcp`}),` and check that the servers show as connected. If one shows an error instead, see `,_jsx(_components.a,{href:`#troubleshooting`,children:`Troubleshooting`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`connect-from-other-surfaces`,children:`Connect from other surfaces`}),`\n`,_jsxs(_components.p,{children:[`This guide uses the `,_jsx(_components.code,{children:`claude mcp`}),` CLI commands, but every Claude Code surface can connect to MCP servers:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Claude Code desktop app`}),`: add servers through the `,_jsx(_components.a,{href:`/en/desktop#connect-external-tools`,children:`Connectors UI`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Claude Desktop chat app`}),`: a separate app from Claude Code. To copy servers from its `,_jsx(_components.code,{children:`claude_desktop_config.json`}),` into the CLI, run `,_jsx(_components.code,{children:`claude mcp add-from-claude-desktop`}),` on macOS or WSL.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`VS Code`}),`: see `,_jsx(_components.a,{href:`/en/vs-code#connect-to-external-tools-with-mcp`,children:`Connect to external tools with MCP`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Claude Code on the web`}),`: reads `,_jsx(_components.code,{children:`.mcp.json`}),` from your repository. See `,_jsx(_components.a,{href:`#edit-mcp-json-directly`,children:`Edit .mcp.json directly`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Claude.ai`}),`: connectors you add at `,_jsx(_components.a,{href:`https://claude.ai/customize/connectors`,children:`claude.ai/customize/connectors`}),` load automatically in the CLI when you sign in with that account. See `,_jsx(_components.a,{href:`/en/mcp#use-mcp-servers-from-claude-ai`,children:`Use MCP servers from Claude.ai`}),`.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`troubleshooting`,children:`Troubleshooting`}),`\n`,_jsxs(_components.p,{children:[`If a server doesn’t connect, check its status with `,_jsx(_components.code,{children:`/mcp`}),` inside a session or `,_jsx(_components.code,{children:`claude mcp list`}),` from your shell, then match the symptom below. The `,_jsx(_components.code,{children:`/mcp`}),` panel also lets you reconnect or authenticate without leaving the session.`]}),`\n`,_jsxs(AccordionGroup,{children:[_jsxs(Accordion,{title:`/mcp shows No MCP servers configured`,id:`mcp-shows-no-mcp-servers-configured`,children:[_jsx(_components.p,{children:`Claude Code didn’t find any servers for the current directory. The most common causes:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`You ran `,_jsx(_components.code,{children:`claude mcp add`}),` from a different project. Local-scoped servers are tied to the project where you added them: the repository root, or the exact directory if you weren’t in a git repository. Re-add the server from the project you’re in now, or add it with `,_jsx(_components.code,{children:`--scope user`}),` so it isn’t tied to a project.`]}),`\n`,_jsxs(_components.li,{children:[`You edited a configuration file at the wrong path. The correct files are `,_jsx(_components.code,{children:`~/.claude.json`}),` and `,_jsx(_components.code,{children:`\u003cproject\u003e/.mcp.json`}),`. Claude Code doesn’t read paths such as `,_jsx(_components.code,{children:`~/.claude/.mcp.json`}),`, `,_jsx(_components.code,{children:`~/.claude/config/mcp.json`}),`, `,_jsx(_components.code,{children:`~/.claude/mcp.json`}),`, or `,_jsx(_components.code,{children:`%APPDATA%\\\\Claude\\\\mcp.json`}),`. For user-scoped servers, run `,_jsx(_components.code,{children:`claude mcp add --scope user`}),`, which writes to the `,_jsx(_components.code,{children:`mcpServers`}),` key in `,_jsx(_components.code,{children:`~/.claude.json`}),`; for project-scoped servers, edit `,_jsx(_components.code,{children:`.mcp.json`}),` at the project root.`]}),`\n`]})]}),_jsxs(Accordion,{title:`Status shows Failed to connect or Connection error`,id:`status-shows-failed-to-connect-or-connection-error`,children:[_jsxs(_components.p,{children:[`Both statuses mean the server didn’t start or the URL didn’t respond. They can also appear for HTTP servers that reject the token you configured in `,_jsx(_components.code,{children:`headers.Authorization`}),`; a server that wants a token you haven’t configured shows `,_jsx(_components.code,{children:`! Needs authentication`}),` instead, covered in `,_jsx(_components.a,{href:`#connect-a-server-that-requires-sign-in`,children:`Connect a server that requires sign-in`}),`.`]}),_jsx(_components.p,{children:`Your first step depends on which status you see:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`Failed to connect`}),`: start with the failure detail on the status itself. `,_jsx(_components.code,{children:`claude mcp list`}),` and `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` show the HTTP status or error code and any error text the server returned, which often names the problem directly, such as a missing header or a rejected token. Before v2.1.219, `,_jsx(_components.code,{children:`Failed to connect`}),` showed only the bare status, and you needed the curl and command checks later in this section to find the cause.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`Connection error`}),`: Claude Code appends no detail to this status on any version, so go straight to the curl and command checks later in this section.`]}),`\n`]}),_jsxs(_components.p,{children:[`If the detail points to a credential or URL, also check the warnings in the `,_jsx(_components.code,{children:`claude mcp list`}),` output. Claude Code flags config values with hidden leading or trailing whitespace, a common cause of authentication failures after pasting a token.`]}),_jsxs(_components.p,{children:[`If an HTTP server returns `,_jsx(_components.code,{children:`404 Not Found`}),`, Claude Code shows `,_jsx(_components.code,{children:`MCP endpoint not found at \u003corigin\u003e. Check the URL in your MCP config.`}),` when you select the server in `,_jsx(_components.code,{children:`/mcp`}),`. The message names the URL’s origin, such as `,_jsx(_components.code,{children:`https://mcp.example.com`}),`, without its path, so run `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` to see the full URL you configured. Compare its path to the server’s documented MCP endpoint path, then run `,_jsx(_components.code,{children:`claude mcp remove \u003cname\u003e`}),` and re-add with the correct URL. Before v2.1.219, the message included the URL’s path as well, and before v2.1.191, a `,_jsx(_components.code,{children:`404`}),` showed a generic `,_jsx(_components.code,{children:`Error POSTing to endpoint`}),` message without the URL.`]}),_jsx(_components.p,{children:`For HTTP servers, confirm the URL is reachable from your machine:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`curl`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` -I`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://mcp.sentry.dev/mcp`})]}),`\n`]})})}),_jsxs(_components.p,{children:[`In PowerShell, use `,_jsx(_components.code,{children:`curl.exe`}),` instead of `,_jsx(_components.code,{children:`curl`}),` so the request goes to the real curl binary rather than the `,_jsx(_components.code,{children:`Invoke-WebRequest`}),` alias.`]}),_jsx(_components.p,{children:`The response tells you which kind of problem you have:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`A `,_jsx(_components.code,{children:`404`}),` or `,_jsx(_components.code,{children:`405`}),`: the server is up. Many MCP endpoints answer only POST requests, so this still confirms the URL is reachable from your machine.`]}),`\n`,_jsxs(_components.li,{children:[`A `,_jsx(_components.code,{children:`401`}),` or `,_jsx(_components.code,{children:`403`}),`: the server is up and you need to authenticate. Use the browser sign-in in `,_jsx(_components.a,{href:`#connect-a-server-that-requires-sign-in`,children:`Connect a server that requires sign-in`}),`, or for servers that take a token instead, like GitHub’s, pass it with `,_jsx(_components.code,{children:`--header \"Authorization: Bearer \u003ctoken\u003e\"`}),` on the `,_jsx(_components.code,{children:`claude mcp add`}),` command.`]}),`\n`,_jsx(_components.li,{children:`No response at all: check the URL and your network.`}),`\n`]}),_jsx(_components.p,{children:`For stdio servers, run the configured command directly in your terminal to see the underlying error. For the Playwright server from this guide, run:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`npx`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` -y`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` @playwright/mcp@latest`})]}),`\n`]})})}),_jsx(_components.p,{children:`What happens next tells you where the problem is:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`The command starts and waits for input: the server itself works. Run `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` and confirm the command shown there matches what you just ran. If the command shown differs from what you typed, you likely omitted the `,_jsx(_components.code,{children:`--`}),` separator before the server command. Remove the server and re-add it with `,_jsx(_components.code,{children:`--`}),` in place. If you wrote `,_jsx(_components.code,{children:`.mcp.json`}),` by hand, check its syntax and location.`]}),`\n`,_jsx(_components.li,{children:`The command errors: the message names what’s missing, such as Node.js or a browser.`}),`\n`]})]}),_jsxs(Accordion,{title:`Connection timed out at startup`,id:`connection-timed-out-at-startup`,children:[_jsxs(_components.p,{children:[`The server took longer than the default 30-second startup timeout. A stdio server’s first run can be slow while `,_jsx(_components.code,{children:`npx`}),` downloads the package. Increase the limit with the `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MCP_TIMEOUT`})}),` environment variable, in milliseconds:`]}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`MCP_TIMEOUT`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`60000`}),_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:` claude`})]}),`\n`]})})}),_jsx(_components.p,{children:`In PowerShell, set the variable before the command on the same line:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`powershell`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`powershell`,children:_jsxs(_components.code,{language:`powershell`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#9CDCFE`},children:`env:`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`MCP_TIMEOUT`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:` =`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"60000\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`; claude`})]}),`\n`]})})})]}),_jsxs(Accordion,{title:`Server already exists`,id:`server-already-exists`,children:[_jsx(_components.p,{children:`You’ve already added a server with that name at the same scope. Either remove the existing entry first or choose a different name:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` remove`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` claude-code-docs`})]}),`\n`]})})}),_jsxs(_components.p,{children:[`If the name exists at more than one scope, `,_jsx(_components.code,{children:`remove`}),` reports `,_jsx(_components.code,{children:`exists in multiple scopes`}),`. Pass `,_jsx(_components.code,{children:`--scope`}),` to choose which copy to delete, for example `,_jsx(_components.code,{children:`claude mcp remove claude-code-docs --scope local`}),`.`]})]}),_jsxs(Accordion,{title:`Server connects but no tools appear`,id:`server-connects-but-no-tools-appear`,children:[_jsxs(_components.p,{children:[`Run `,_jsx(_components.code,{children:`/mcp`}),` inside a session and select the server to see its tool list. If the list is empty, the server started but didn’t register any tools, which usually means it’s missing a required environment variable such as an API key.`]}),_jsxs(_components.p,{children:[`Pass the variable with `,_jsx(_components.code,{children:`--env KEY=value`}),` on `,_jsx(_components.code,{children:`claude mcp add`}),`, or in the `,_jsx(_components.code,{children:`env`}),` field of the server’s `,_jsx(_components.code,{children:`.mcp.json`}),` entry. The server’s documentation lists the variables it needs.`]})]}),_jsxs(Accordion,{title:`Changes to .mcp.json don't take effect`,id:`changes-to-mcp-json-dont-take-effect`,children:[_jsxs(_components.p,{children:[`Claude Code reads `,_jsx(_components.code,{children:`.mcp.json`}),` at session start. Exit and restart the session after editing the file.`]}),_jsxs(_components.p,{children:[`If your servers still don’t appear, run `,_jsx(_components.code,{children:`/mcp`}),` and look for a parse warning. Claude Code skips malformed entries and shows the offending field there.`]}),_jsx(_components.p,{children:`If you previously rejected the server when prompted, reset project approvals:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` reset-project-choices`})]}),`\n`]})})})]}),_jsx(Accordion,{title:`OAuth sign-in fails or browser doesn't open`,id:`oauth-sign-in-fails-or-browser-doesnt-open`,children:_jsxs(_components.p,{children:[`Run `,_jsx(_components.code,{children:`/mcp`}),`, select the server, and choose `,_jsx(_components.code,{children:`Authenticate`}),` again. If the browser doesn’t open automatically, copy the URL shown in the terminal and open it manually. See `,_jsx(_components.a,{href:`/en/mcp#authenticate-with-remote-mcp-servers`,children:`Authenticate with remote MCP servers`}),` for fixed callback ports and pre-configured credentials.`]})})]}),`\n`,_jsx(Heading,{level:`2`,id:`next-steps`,children:`Next steps`}),`\n`,_jsx(_components.p,{ch