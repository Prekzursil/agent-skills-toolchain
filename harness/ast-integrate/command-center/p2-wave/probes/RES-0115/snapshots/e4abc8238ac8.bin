ocs/_next/static/chunks/ca8fe0ccebe75085.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/f48a8fa65184b0c7.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/329b5be61330e31a.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/ea3a9a65bf1e9fce.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/9090d55f1c6244ff.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/2dd53f5a4cfe6dd5.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"56:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L5b\",null,{\"pageMetadata\":\"$4f:props:pageMetadata\"}]]\n57:[\"$\",\"$L5c\",null,{\"pageMetadata\":\"$4f:props:pageMetadata\"}]\n5d:T1108,"])</script><script>self.__next_f.push([1,"\n/* These styles mirror the internal design system's button component, converted to plain CSS. */\n\n/* Base button styles */\n.btn {\n  position: relative;\n  display: inline-flex;\n  gap: 0.5rem;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  min-width: 5rem;\n  height: 2.25rem;\n  padding: 0.5rem 1rem;\n  white-space: nowrap;\n  font-family: Styrene;\n  font-weight: 600;\n  border-radius: 0.5rem;\n  \u0026:active {\n    transform: scale(0.985);\n  }\n\n  /* Size variants */\n  \u0026.size-xs {\n    height: 1.75rem;\n    min-width: 3.5rem;\n    padding: 0 0.5rem;\n    border-radius: 0.25rem;\n    font-size: 0.75rem;\n    gap: 0.25rem;\n  }\n  \n  \u0026.size-sm {\n    height: 2rem;\n    min-width: 4rem;\n    padding: 0 0.75rem;\n    border-radius: 0.375rem;\n    font-size: 0.75rem;\n  }\n\n  \u0026.size-lg {\n    height: 2.75rem;\n    min-width: 6rem;\n    padding: 0 1.25rem;\n    border-radius: 0.6rem;\n  }\n\n  \u0026:disabled {\n    pointer-events: none;\n    opacity: 0.5;\n    box-shadow: none;\n  }\n\n  \u0026:focus-visible {\n    outline: none;\n    --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n    --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(1px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n    box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow);\n  }\n\n  /* Primary variant */\n  \u0026.primary {\n    font-weight: 600;\n    color: hsl(var(--oncolor-100));\n    background-color: hsl(var(--accent-main-100));\n    background-image: linear-gradient(\n      to right,\n      hsl(var(--accent-main-100)) 0%,\n      hsl(var(--accent-main-200) / 0.5) 50%,\n      hsl(var(--accent-main-200)) 100%\n    );\n    background-size: 200% 100%;\n    background-position: 0% 0%;\n    border: 0.5px solid hsl(var(--border-300) / 0.25);\n    box-shadow: \n      inset 0 0.5px 0px rgba(255, 255, 0, 0.15),\n      0 1px 1px rgba(0, 0, 0, 0.05);\n    text-shadow: 0 1px 2px rgb(0 0 0 / 10%);\n    transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);\n\n    \u0026:hover {\n      background-position: 100% 0%;\n      background-image: linear-gradient(\n        to right,\n        hsl(var(--accent-main-200)) 0%,\n        hsl(var(--accent-main-200)) 100%\n      );\n    }\n\n    \u0026:active {\n      background-color: hsl(var(--accent-main-000));\n      box-shadow: inset 0 1px 6px rgba(0, 0, 0, 0.2);\n      transform: scale(0.985);\n    }\n  }\n\n  /* Flat variant */\n  \u0026.flat {\n    font-weight: 500;\n    color: hsl(var(--oncolor-100));\n    background-color: hsl(var(--accent-main-100));\n    transition: background-color 150ms;\n\n    \u0026:hover {\n      background-color: hsl(var(--accent-main-200));\n    }\n  }\n\n  /* Secondary variant */\n  \u0026.secondary {\n    font-weight: 600;\n    color: hsl(var(--text-100) / 0.9);\n    background-image: radial-gradient(\n      ellipse at center,\n      hsl(var(--bg-500) / 0.1) 50%,\n      hsl(var(--bg-500) / 0.3) 100%\n    );\n    border: 0.5px solid hsl(var(--border-400));\n    transition: color 150ms, background-color 150ms;\n\n    \u0026:hover {\n      color: hsl(var(--text-000));\n      background-color: hsl(var(--bg-500) / 0.6);\n    }\n\n    \u0026:active {\n      background-color: hsl(var(--bg-500) / 0.5);\n    }\n  }\n\n  /* Outline variant */\n  \u0026.outline {\n    font-weight: 600;\n    color: hsl(var(--text-200));\n    background-color: transparent;\n    border: 1.5px solid currentColor;\n    transition: color 150ms, background-color 150ms;\n\n    \u0026:hover {\n      color: hsl(var(--text-100));\n      background-color: hsl(var(--bg-400));\n      border-color: hsl(var(--bg-400));\n    }\n  }\n\n  /* Ghost variant */\n  \u0026.ghost {\n    color: hsl(var(--text-200));\n    border-color: transparent;\n    transition: color 150ms, background-color 150ms;\n\n    \u0026:hover {\n      color: hsl(var(--text-100));\n      background-color: hsl(var(--bg-500) / 0.4);\n    }\n\n    \u0026:active {\n      background-color: hsl(var(--bg-400));\n    }\n  }\n\n  /* Underline variant */\n  \u0026.underline {\n    opacity: 0.8;\n    text-decoration-line: none;\n    text-underline-offset: 3px;\n    transition: all 150ms;\n\n    \u0026:hover {\n      opacity: 1;\n      text-decoration-line: underline;\n    }\n\n    \u0026:active {\n      transform: scale(0.985);\n    }\n  }\n\n  /* Danger variant */\n  \u0026.danger {\n    font-weight: 600;\n    color: hsl(var(--oncolor-100));\n    background-color: hsl(var(--danger-100));\n    transition: background-color 150ms;\n\n    \u0026:hover {\n      background-color: hsl(var(--danger-200));\n    }\n  }\n}\n"])</script><script>self.__next_f.push([1,"58:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"button.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5d\"}}],\"$L5e\"]\n60:Tce9,"])</script><script>self.__next_f.push([1,"/**\n * First-party analytics for code.claude.com/docs.\n *\n * Loads the SDK bundle (window.antalytics) from the CDN and initialises it.\n * The bundle is rebuilt and republished automatically whenever the SDK\n * source changes upstream, so this file rarely needs to change.\n *\n * Consent: events are gated on the anthropic-consent-preferences cookie\n * written by the shared banner (consent-loader.js). Fail-closed when the\n * cookie is absent or unparseable, so visitors who have not opted in via\n * the banner are not tracked.\n */\n;(function () {\n  if (typeof window === 'undefined' || typeof document === 'undefined') return\n\n  function hasAnalyticsConsent() {\n    try {\n      if (navigator.globalPrivacyControl) return false\n      var m = document.cookie.match(/(?:^|;\\s*)anthropic-consent-preferences=([^;]+)/)\n      if (!m) return false\n      return JSON.parse(decodeURIComponent(m[1])).analytics === true\n    } catch (_) {\n      return false\n    }\n  }\n\n  function start() {\n    if (!window.antalytics) return\n    window.antalytics.init({\n      // Matches the x-service-name used by snippets/experiment.jsx so\n      // page-view events and GrowthBook exposure events join on the same\n      // service_name in BigQuery.\n      serviceName: 'claude_code_docs',\n      allowedOrigins: ['https://code.claude.com'],\n      plugins: [\n        {\n          name: 'consentGate',\n          type: 'before',\n          fn: function (event) {\n            return hasAnalyticsConsent() ? event : null\n          },\n        },\n      ],\n      onError: function (error, ctx) {\n        // eslint-disable-next-line no-console\n        console.warn('[antalytics:' + ctx.method + ']', error)\n      },\n    })\n    window.antalytics.page()\n\n    var lastPath = location.pathname\n    function onRouteChange() {\n      if (location.pathname === lastPath) return\n      lastPath = location.pathname\n      window.antalytics.page()\n    }\n    var origPushState = history.pushState\n    history.pushState = function () {\n      origPushState.apply(this, arguments)\n      onRouteChange()\n    }\n    window.addEventListener('popstate', onRouteChange)\n  }\n\n  var loaded = false\n  function loadSdk() {\n    if (loaded) return\n    loaded = true\n    var s = document.createElement('script')\n    s.src = 'https://assets.claude.ai/sdk/antalytics/latest.umd.js'\n    s.async = true\n    // No cookies or page URL sent with the cross-origin fetch.\n    s.crossOrigin = 'anonymous'\n    s.referrerPolicy = 'no-referrer'\n    s.onload = start\n    s.onerror = function () {\n      // eslint-disable-next-line no-console\n      console.warn('[antalytics] failed to load SDK bundle from CDN')\n    }\n    document.head.appendChild(s)\n  }\n\n  // Only fetch the SDK once analytics consent is granted, so visitors who\n  // have not opted in never trigger a request to the CDN at all. Re-check\n  // when the consent cookie changes (banner accept/reject).\n  if (hasAnalyticsConsent()) {\n    loadSdk()\n  }\n  if (typeof window.cookieStore !== 'undefined' \u0026\u0026 window.cookieStore.addEventListener) {\n    window.cookieStore.addEventListener('change', function (e) {\n      for (var i = 0; i \u003c e.changed.length; i++) {\n        if (e.changed[i].name === 'anthropic-consent-preferences' \u0026\u0026 hasAnalyticsConsent()) {\n          loadSdk()\n          return\n        }\n      }\n    })\n  }\n})()\n"])</script><script>self.__next_f.push([1,"61:T1694,"])</script><script>self.__next_f.push([1,"/**\n * Collapse toggle for the right \"On this page\" table of contents.\n *\n * Adds a floating button that hides the ToC column and lets the content\n * area use the freed space (see the matching rules in style.css). The\n * choice persists per browser via localStorage.\n *\n * The button is appended to document.body, outside the Next.js app root,\n * so it survives client-side navigation. Visibility on pages without a\n * ToC and the chevron direction are both handled in style.css, so this\n * script only creates the button and manages state.\n */\n;(function () {\n  if (typeof window === 'undefined' || typeof document === 'undefined') return\n  // The layout rules in style.css depend on :has(). Without support the\n  // ToC would hide but the content column would never widen, so leave\n  // the button out entirely.\n  if (!(window.CSS \u0026\u0026 CSS.supports('selector(:has(*))'))) return\n\n  var STORAGE_KEY = 'docs-toc-collapsed'\n  var COLLAPSED_CLASS = 'toc-collapsed'\n\n  // [hide, show] labels per locale directory. Keyed by URL path segment\n  // because the rendered page's lang attribute carries nonstandard\n  // values (e.g. \"jp\" on /ja/ pages).\n  var LABELS = {\n    en: ['Hide table of contents', 'Show table of contents'],\n    de: ['Inhaltsverzeichnis ausblenden', 'Inhaltsverzeichnis anzeigen'],\n    es: ['Ocultar tabla de contenido', 'Mostrar tabla de contenido'],\n    fr: ['Masquer la table des matières', 'Afficher la table des matières'],\n    id: ['Sembunyikan daftar isi', 'Tampilkan daftar isi'],\n    it: ['Nascondi indice', 'Mostra indice'],\n    ja: ['目次を隠す', '目次を表示'],\n    ko: ['목차 숨기기', '목차 보기'],\n    pt: ['Ocultar sumário', 'Mostrar sumário'],\n    ru: ['Скрыть оглавление', 'Показать оглавление'],\n    'zh-CN': ['隐藏目录', '显示目录'],\n    'zh-TW': ['隱藏目錄', '顯示目錄'],\n  }\n\n  function localeLabels() {\n    // Scan rather than index: production serves under the /docs base\n    // path while mint dev and previews serve root-relative, so the\n    // locale isn't always the first segment. The locale directory comes\n    // before any page slug, so the first matching segment wins.\n    var segments = window.location.pathname.split('/')\n    for (var i = 1; i \u003c segments.length; i++) {\n      if (Object.prototype.hasOwnProperty.call(LABELS, segments[i])) {\n        return LABELS[segments[i]]\n      }\n    }\n    return LABELS.en\n  }\n\n  function isCollapsed() {\n    return document.documentElement.classList.contains(COLLAPSED_CLASS)\n  }\n\n  function setCollapsed(collapsed) {\n    document.documentElement.classList.toggle(COLLAPSED_CLASS, collapsed)\n    try {\n      if (collapsed) {\n        localStorage.setItem(STORAGE_KEY, '1')\n      } else {\n        localStorage.removeItem(STORAGE_KEY)\n      }\n    } catch (_) {}\n  }\n\n  // Apply the saved state as early as possible to minimize layout flash.\n  try {\n    if (localStorage.getItem(STORAGE_KEY) === '1') setCollapsed(true)\n  } catch (_) {}\n\n  function render(btn) {\n    var collapsed = isCollapsed()\n    var label = localeLabels()[collapsed ? 1 : 0]\n    btn.setAttribute('aria-expanded', String(!collapsed))\n    btn.setAttribute('aria-label', label)\n    btn.title = label\n  }\n\n  function start() {\n    if (document.getElementById('toc-collapse-toggle')) return\n\n    var btn = document.createElement('button')\n    btn.id = 'toc-collapse-toggle'\n    btn.type = 'button'\n    btn.setAttribute('aria-controls', 'table-of-contents-layout')\n\n    var SVG_NS = 'http://www.w3.org/2000/svg'\n    function makeIcon(className, d) {\n      var svg = document.createElementNS(SVG_NS, 'svg')\n      svg.setAttribute('viewBox', '0 0 24 24')\n      svg.setAttribute('aria-hidden', 'true')\n      svg.setAttribute('class', className)\n      var path = document.createElementNS(SVG_NS, 'path')\n      path.setAttribute('d', d)\n      svg.appendChild(path)\n      return svg\n    }\n    btn.appendChild(makeIcon('toc-chevron', 'M9 18l6-6-6-6'))\n    // List glyph, shown only while collapsed (see style.css).\n    btn.appendChild(makeIcon('toc-glyph', 'M4 6h16M4 12h10M4 18h16'))\n\n    btn.addEventListener('click', function () {\n      setCollapsed(!isCollapsed())\n      render(btn)\n    })\n    // Re-read the saved state when another tab changes it (storage) and\n    // when this page returns from the back/forward cache, where storage\n    // events fired while cached were never delivered (pageshow).\n    function syncFromStorage() {\n      var stored = false\n      try {\n        stored = localStorage.getItem(STORAGE_KEY) === '1'\n      } catch (_) {}\n      setCollapsed(stored)\n      render(btn)\n    }\n    window.addEventListener('storage', function (e) {\n      if (e.storageArea !== localStorage) return\n      // key is null when localStorage.clear() ran; re-read either way.\n      if (e.key === null || e.key === STORAGE_KEY) syncFromStorage()\n    })\n    window.addEventListener('pageshow', syncFromStorage)\n    // Client-side navigation can cross locale directories, so re-render\n    // the label whenever the route changes.\n    function onNavigate() {\n      setTimeout(function () {\n        render(btn)\n      }, 0)\n    }\n    var origPushState = history.pushState\n    history.pushState = function () {\n      var result = origPushState.apply(this, arguments)\n      onNavigate()\n      return result\n    }\n    window.addEventListener('popstate', onNavigate)\n    render(btn)\n    // Prepend rather than append: the button still lives outside the\n    // app root and survives client-side navigation, but lands at the\n    // start of the tab order instead of after the entire page.\n    document.body.prepend(btn)\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', start, { once: true })\n  } else {\n    start()\n  }\n})()\n"])</script><script>self.__next_f.push([1,"59:[\"$\",\"$L5f\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69bdb9fd7ba705a281409ac4\",\"filePath\":\"consent-loader.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"/**\\n * Consent banner loader for code.claude.com/docs.\\n *\\n * Mintlify auto-includes any .js file in the content root on every page.\\n * This loader injects the shared consent banner hosted on claude.com.\\n */\\n;(function () {\\n  var s = document.createElement('script')\\n  s.src = 'https://claude.com/shared/consent-banner.js'\\n  s.async = true\\n  document.head.appendChild(s)\\n})()\\n\"},{\"_id\":\"69fe40dc388017ee55c19b7a\",\"subdomain\":\"claude-code\",\"filePath\":\"antalytics-loader.js\",\"__v\":0,\"content\":\"$60\"},{\"_id\":\"6a567ad87ec0f756509df168\",\"filePath\":\"toc-collapse.js\",\"subdomain\":\"claude-code\",\"__v\":0,\"content\":\"$61\"}]}]\n"])</script><script>self.__next_f.push([1,"64:Te63a,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,..._provideComponents(),...props.components},{Accordion,AccordionGroup,CodeBlock,Heading,Info,Note,Step,Steps,Table}=_components;if(!Accordion)_missingMdxReference(`Accordion`,true);if(!AccordionGroup)_missingMdxReference(`AccordionGroup`,true);if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!Info)_missingMdxReference(`Info`,true);if(!Note)_missingMdxReference(`Note`,true);if(!Step)_missingMdxReference(`Step`,true);if(!Steps)_missingMdxReference(`Steps`,true);if(!Table)_missingMdxReference(`Table`,true);return _jsxs(_Fragment,{children:[_jsxs(_components.p,{children:[`The `,_jsx(_components.a,{href:`https://modelcontextprotocol.io/introduction`,children:`Model Context Protocol (MCP)`}),` lets Claude Code use tools beyond its built-in set, such as searching an issue tracker, querying a database, or controlling a web browser. These tools come from MCP servers, which run on your machine or as hosted services.`]}),`\n`,_jsx(_components.p,{children:`This guide walks you through connecting one MCP server end to end with the Claude Code CLI. By the end, you’ll have a server connected and responding, know where its configuration lives on disk, and know how to fix the most common connection errors.`}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`You can also add MCP servers from other surfaces, including the desktop app, VS Code, and the web. See `,_jsx(_components.a,{href:`#connect-from-other-surfaces`,children:`Connect from other surfaces`}),`.`]})}),`\n`,_jsxs(_components.p,{children:[`For every way to connect and configure MCP servers in Claude Code, see the `,_jsx(_components.a,{href:`/en/mcp`,children:`MCP reference`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`before-you-begin`,children:`Before you begin`}),`\n`,_jsx(_components.p,{children:`Make sure you have:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`/en/quickstart`,children:`Claude Code installed`}),` and authenticated`]}),`\n`,_jsx(_components.li,{children:`A terminal open in a project directory. Any directory works, including an empty one.`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`add-and-verify-a-server`,children:`Add and verify a server`}),`\n`,_jsxs(_components.p,{children:[`The example below connects to the `,_jsx(_components.a,{href:`https://code.claude.com/docs/mcp`,children:`Claude Code documentation MCP server`}),`, a hosted server with full-text search over the Claude Code docs. It doesn’t require authentication or any special configuration, so it works well as a first server to test the setup flow with.`]}),`\n`,_jsxs(_components.p,{children:[`The steps are the same for any server: add it, check the connection status, then use it in a session, with an optional cleanup step at the end. Some servers add a step, like a browser sign-in, shown in `,_jsx(_components.a,{href:`#additional-mcp-server-examples`,children:`Additional MCP server examples`}),`. For more servers to connect, browse the `,_jsx(_components.a,{href:`/en/mcp#find-and-build-mcp-servers`,children:`Anthropic Directory`}),`.`]}),`\n`,_jsxs(Steps,{children:[_jsxs(Step,{title:`Add the MCP server`,children:[_jsxs(_components.p,{children:[`Register the server with Claude Code. Run this in your terminal, not inside a `,_jsx(_components.code,{children:`claude`}),` session: you’re configuring the server before starting a conversation.`]}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --transport`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` http`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` claude-code-docs`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://code.claude.com/docs/mcp`})]}),`\n`]})})}),_jsx(_components.p,{children:`The parts of the command:`}),_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`claude mcp add`}),`: registers a server with Claude Code.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`--transport http`}),`: the server is hosted at a URL rather than run as a local process.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`claude-code-docs`}),`: a name you make up. Calling the same server `,_jsx(_components.code,{children:`docs`}),` would work identically. Claude Code uses whatever name you pick to label the server’s tools in Claude’s output and to refer to the server in commands like `,_jsx(_components.code,{children:`claude mcp remove`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`https://code.claude.com/docs/mcp`}),`: the URL where the server is hosted.`]}),`\n`]}),_jsxs(_components.p,{children:[`The command prints a confirmation like `,_jsx(_components.code,{children:`Added HTTP MCP server claude-code-docs with URL: https://code.claude.com/docs/mcp to local config`}),`, followed by a `,_jsx(_components.code,{children:`File modified:`}),` line showing the configuration file it wrote. The `,_jsx(_components.code,{children:`local config`}),` part means the server is registered to you, in this project: if you start Claude Code in a different project, this server isn’t active there. To register a server once for all your projects, add it at user scope, covered in `,_jsx(_components.a,{href:`#change-server-scope`,children:`Change server scope`}),`.`]})]}),_jsxs(Step,{title:`Check the connection status`,children:[_jsx(_components.p,{children:`Confirm the server appears in your server list and check its status:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` list`})]}),`\n`]})})}),_jsx(_components.p,{children:`The server appears with a status indicator:`}),_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{style:{textAlign:`left`},children:`Status`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Meaning`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`✔ Connected`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Ready to use. This is what you should see for `,_jsx(_components.code,{children:`claude-code-docs`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`! Connected · tools fetch failed`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`The server connected but couldn’t list its tools. Run `,_jsx(_components.code,{children:`claude mcp get \u003cname\u003e`}),` for the error detail`]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`! Needs authentication`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`The server is reachable but needs a browser sign-in, or a token passed with `,_jsx(_components.code,{children:`--header`}),`. See `,_jsx(_components.a,{href:`#connect-a-server-that-requires-sign-in`,children:`Connect a server that requires sign-in`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`✘ Failed to connect`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`Server didn’t respond. See `,_jsx(_components.a,{href:`#troubleshooting`,children:`Troubleshooting`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`✘ Connection error`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`The connection attempt threw an error. See `,_jsx(_components.a,{href:`#troubleshooting`,children:`Troubleshooting`})]})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:\"⏸ Pending approval (run `claude` to approve)\"})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[`A project-scoped server you haven’t approved yet. See `,_jsx(_components.a,{href:`#edit-mcp-json-directly`,children:`Edit .mcp.json directly`})]})]})]})]}),_jsxs(_components.p,{children:[`Some legacy Windows consoles, such as the default console on Windows 10, don’t support these Unicode glyphs and show `,_jsx(_components.code,{children:`√`}),` and `,_jsx(_components.code,{children:`×`}),` in place of `,_jsx(_components.code,{children:`✔`}),` and `,_jsx(_components.code,{children:`✘`}),`.`]})]}),_jsxs(Step,{title:`Use the server`,children:[_jsx(_components.p,{children:`Start a session and ask Claude to use the new server by name:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`})}),`\n`]})})}),_jsx(CodeBlock,{filename:``,wrap:`true`,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Use the claude-code-docs server to look up what MCP_TIMEOUT does`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),_jsx(Info,{children:_jsx(_components.p,{children:`You don’t normally need to name a server in your prompt, since Claude chooses relevant tools on its own. Naming it here guarantees the demonstration goes through the new server rather than another tool, such as web fetch, that could answer the same question.`})}),_jsx(_components.p,{children:`If Claude Code asks for permission the first time Claude calls the server, approve it. The tool call in Claude’s output is labeled with the server name, which is how you confirm the answer came from the MCP server rather than Claude’s built-in knowledge.`})]}),_jsxs(Step,{title:`Remove the server`,children:[_jsx(_components.p,{children:`This step is optional. When you’re done experimenting, you can remove the server:`}),_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` remove`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` claude-code-docs`})]}),`\n`]})})}),_jsxs(_components.p,{children:[`The command confirms with `,_jsx(_components.code,{children:`Removed MCP server \"claude-code-docs\" from local config`}),` and a `,_jsx(_components.code,{children:`File modified:`}),` line showing the file it updated.`]}),_jsx(Note,{children:_jsxs(_components.p,{children:[`Each connected server takes some space in `,_jsx(_components.a,{href:`/en/how-claude-code-works#the-context-window`,children:`Claude’s context window`}),` because its tool names and server instructions load into every session. Removing servers you no longer use keeps that space free.`]})})]})]}),`\n`,_jsx(Heading,{level:`2`,id:`where-servers-are-saved`,children:`Where servers are saved`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`claude mcp add`}),` command writes the server’s details to a configuration file. By default it registers the server at `,_jsx(_components.code,{children:`local`}),` scope: private to you, active only in the current project. Pass `,_jsx(_components.code,{children:`--scope user`}),` to register it once for all your projects, or `,_jsx(_components.code,{children:`--scope project`}),` to share it with teammates. `,_jsx(_components.a,{href:`#change-server-scope`,children:`Change server scope`}),` walks through both.`]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[_jsx(_components.code,{children:`claude mcp add`}),` works the same in every shell, including PowerShell and Command Prompt. Inside a `,_jsx(_components.code,{children:`claude`}),` session, use the `,_jsx(_components.code,{children:`/mcp`}),` command to check and manage servers you’ve already added.`]})}),`\n`,_jsx(_components.p,{children:`There are other ways to add a server, each covered later on this page:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`#add-a-local-server`,children:`Add a local server`}),`: run a program on your machine instead of connecting to a URL.`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.a,{href:`#edit-mcp-json-directly`,children:[`Edit `,_jsx(_components.code,{children:`.mcp.json`}),` directly`]}),`: write the JSON entry yourself instead of using the command.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`#connect-a-server-that-requires-sign-in`,children:`Connect a server that requires sign-in`}),`: add a hosted server that needs a browser sign-in before its tools work.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`find-your-configuration-on-disk`,children:`Find your configuration on disk`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`claude mcp add`}),` command writes the server to one of three scopes, stored across two files, depending on the `,_jsx(_components.code,{children:`--scope`}),` flag. You don’t need to edit these files directly, but knowing where they are helps with debugging and version control.`]}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{style:{textAlign:`left`},children:`Scope`}),_jsx(_components.th,{style:{textAlign:`left`},children:`File`}),_jsx(_components.th,{style:{textAlign:`left`},children:`Available to`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`local`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`~/.claude.json`}),`, under the entry for this project`]}),_jsx(_components.td,{style:{textAlign:`left`},children:`Only you, only this project. The default`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`project`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`.mcp.json`}),` in your project root`]}),_jsx(_components.td,{style:{textAlign:`left`},children:`Everyone who clones the project`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{style:{textAlign:`left`},children:_jsx(_components.code,{children:`user`})}),_jsxs(_components.td,{style:{textAlign:`left`},children:[_jsx(_components.code,{children:`~/.claude.json`}),`, under the top-level `,_jsx(_components.code,{children:`mcpServers`}),` key`]}),_jsx(_components.td,{style:{textAlign:`left`},children:`Only you, all projects`})]})]})]}),`\n`,_jsxs(_components.p,{children:[`On Windows, `,_jsx(_components.code,{children:`~/.claude.json`}),` resolves to `,_jsx(_components.code,{children:`%USERPROFILE%\\\\.claude.json`}),`, typically `,_jsx(_components.code,{children:`C:\\\\Users\\\\YourName\\\\.claude.json`}),`. If you’ve set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CONFIG_DIR`})}),`, Claude Code reads `,_jsx(_components.code,{children:`.claude.json`}),` from inside that directory instead.`]}),`\n`,_jsxs(_components.p,{children:[`Run `,_jsx(_components.code,{children:`claude mcp get claude-code-docs`}),` to see which scope holds a server’s definition. For how the scopes interact when the same server is defined in more than one, see `,_jsx(_components.a,{href:`/en/mcp#mcp-installation-scopes`,children:`MCP installation scopes`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`change-server-scope`,children:`Change server scope`}),`\n`,_jsx(_components.p,{children:`A server’s scope is fixed when you add it, so changing scope means removing the entry and re-adding it at the new one. Both cases below start by removing the local entry from the first walkthrough, so the server has only one definition. If you already removed it at the end of that walkthrough, skip this command:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` mcp`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` remove`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` claude-code-docs`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --scope`}),_jsx(_compone