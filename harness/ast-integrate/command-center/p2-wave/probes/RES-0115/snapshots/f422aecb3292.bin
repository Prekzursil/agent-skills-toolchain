                  showSubResults: true,
                  showImages: false,
                  resetStyles: false,
                });
                resolve();
              } catch (err) {
                reject(err);
              }
            };
            s.onerror = reject;
            document.head.appendChild(s);
          });
        }

        function openOverlay() {
          overlay.hidden = false;
          document.documentElement.style.overflow = 'hidden';
          loadPagefind().then(function () {
            const input = overlay.querySelector('input');
            if (input) input.focus();
          }).catch(function () {
            const target = overlay.querySelector('#pagefind-search');
            if (target && !target.dataset.devHint) {
              target.dataset.devHint = '1';
              target.innerHTML = '<p class="muted" style="padding:12px;">' + devHint + '</p>';
            }
          });
        }
        function closeOverlay() {
          overlay.hidden = true;
          document.documentElement.style.overflow = '';
        }

        opener.addEventListener('click', openOverlay);
        closers.forEach(function (c) { c.addEventListener('click', closeOverlay); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !overlay.hidden) closeOverlay();
          if (
            e.key === '/' &&
            overlay.hidden &&
            !/^(input|textarea|select)$/i.test(document.activeElement && document.activeElement.tagName || '')
          ) {
            e.preventDefault();
            openOverlay();
          }
        });
      })();
    })();</script> <main>  <article class="panel card stack prose" data-pagefind-body data-pagefind-meta="date:2026-07-19, tags:errors, mcp, claude-code, ai-agents"> <div class="stack"> <div class="row"> <span class="pill">2026-07-19</span>  <a class="pill" href="/tag/errors/">errors</a><a class="pill" href="/tag/mcp/">mcp</a><a class="pill" href="/tag/claude-code/">claude-code</a><a class="pill" href="/tag/ai-agents/">ai-agents</a> <a class="post-edit-link" href="https://github.com/marius-bughiu/start-debugging/edit/main/site/src/content/blog/2026/07/fix-claude-code-misreads-mcp-server-stderr-as-error.md" rel="noopener" target="_blank"> <svg class="post-edit-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"> <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path> </svg>
