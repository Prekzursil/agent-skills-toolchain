m the CLI, such as with `,_jsx(_components.code,{children:`claude --cloud`}),`. Claude Code writes this key to your user settings when you pick an environment with `,_jsx(_components.a,{href:`/en/cloud-environments#select-an-environment-from-the-cli`,children:_jsx(_components.code,{children:`/remote-env`})}),`.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. For a self-hosted environment ID, user or managed settings, or the `,_jsx(_components.code,{children:`--settings`}),` flag only.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, an environment ID such as `,_jsx(_components.code,{children:`env_...`}),` or `,_jsx(_components.code,{children:`ccpool_...`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code uses the Anthropic-hosted environment when one is in your list, and otherwise the first environment it finds`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.code,{children:`--environment`}),` takes precedence over this key for the one cloud session it creates`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`5`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"r