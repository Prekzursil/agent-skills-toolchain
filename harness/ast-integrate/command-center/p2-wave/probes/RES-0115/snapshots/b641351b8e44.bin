<span class="line"><span style="color:#116329;--shiki-dark:#9CDCFE">    &quot;team-tools&quot;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: {</span></span>
<span class="line"><span style="color:#116329;--shiki-dark:#9CDCFE">      &quot;source&quot;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: {</span></span>
