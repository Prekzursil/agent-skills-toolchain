color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`Claude Code ignores project and local entries because it substitutes these values into plugin hook, MCP, and LSP configurations, and a cloned repository must not be able to supply them. Before v2.1.207, project and local settings were also read.`}),`\n`,_jsx(Heading,{level:`2`,id:`mcp`,children:`MCP`}),`\n`,_jsxs(_components.p,{children:[`Control which MCP servers Claude Code connects to and which an organization allows. See `,_jsx(_components.a,{href:`/en/mcp`,children:`Connect to external tools with MCP`}),` and `,_jsx(_components.a,{href:`/en/managed-mcp`,children:`Managed MCP configuration`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`allowallclaudeaimcps`,children:_jsx(_components.code,{children:`allowAllClaudeAiMcps`})}),`\n`,_jsxs(_components.p,{children:[`Load the `,_jsx(_components.a,{href:`/en/mcp#use-mcp-servers-from-claude-ai`,children:`claude.ai connectors`}),` Claude Code fetches itself alongside a deployed `,_jsx(_components.code,{children:`managed-mcp.json`}),`. Without this key, `,_jsx(_components.code,{children:`managed-mcp.json`}),` takes exclusive control of MCP servers and suppresses those connectors.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})}),`. Users can’t re-enable connectors that exclusive control suppressed.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code loads the claude.ai connectors alongside a deployed `,_jsx(_components.code,{children:`managed-mcp.json`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: a deployed `,_jsx(_components.code,{children:`managed-mcp.json`}),` takes exclusive control of MCP servers and suppresses claude.ai connectors`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`}),`, so a deployed `,_jsx(_components.code,{children:`managed-mcp.json`}),` suppresses claude.ai connectors`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"allowAllClaudeAiMcps\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`#allowedmcpservers`,children:_jsx(_components.code,{children:`allowedMcpServers`})}),` and `,_jsx(_components.a,{href:`#deniedmcpservers`,children:_jsx(_components.code,{children:`deniedMcpServers`})}),` still apply to the connectors this key loads. Connectors delivered to `,_jsx(_components.a,{href:`/en/claude-code-on-the-web`,children:`cloud sessions`}),` stay suppressed. See `,_jsx(_components.a,{href:`/en/managed-mcp#allow-claude-ai-connectors-alongside-the-managed-set`,children:`Allow claude.ai connectors alongside the managed set`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`allowedmcpservers`,children:_jsx(_components.code,{children:`allowedMcpServers`})}),`\n`,_jsxs(_components.p,{children:[`Allowlist the MCP servers people can use. Claude Code blocks any server that doesn’t match an entry, whichever settings file or `,_jsx(_components.code,{children:`.mcp.json`}),` defined it, including servers from `,_jsx(_components.code,{children:`managed-mcp.json`}),`. Built-in servers such as Claude in Chrome, IDE-provided servers, and servers the CLI itself configures are exempt from the allowlist; the denylist still applies to them.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Entries from every file merge into one allowlist unless `,_jsx(_components.a,{href:`#allowmanagedmcpserversonly`,children:_jsx(_components.code,{children:`allowManagedMcpServersOnly`})}),` is set. Deploy it in managed settings to enforce it.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: array of objects, each with exactly one key: `,_jsx(_components.code,{children:`serverName`}),`, a string limited to letters, numbers, hyphens, and underscores; `,_jsx(_components.code,{children:`serverCommand`}),`, an array of the command and its arguments matched exactly; or `,_jsx(_components.code,{children:`serverUrl`}),`, a URL pattern with `,_jsx(_components.code,{children:`*`}),` wildcards`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so every server is allowed; an empty array blocks every server`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`This example allows only the stdio server that the listed `,_jsx(_components.code,{children:`npx`}),` command starts:`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`5`,language:`json`,children:_jsx(_components.pre,{clas