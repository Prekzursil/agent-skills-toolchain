n:[_jsx(_components.strong,{children:`Type`}),`: string, a shell command line`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code doesn’t refresh AWS credentials for you`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"awsAuthRefresh\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"aws sso login --profile myprofile\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Use this key when your refresh flow writes to `,_jsx(_components.code,{children:`.aws`}),`; use `,_jsx(_components.a,{href:`#awscredentialexport`,children:_jsx(_components.code,{children:`awsCredentialExport`})}),` when it prints credentials instead. See `,_jsx(_components.a,{href:`/en/amazon-bedrock#advanced-credential-configuration`,children:`advanced credential configuration`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`awscredentialexport`,children:_jsx(_components.code,{children:`awsCredentialExport`})}),`\n`,_jsxs(_components.p,{children:[`Run your own command that prints AWS credentials as JSON, so Claude Code can call `,_jsx(_components.a,{href:`/en/amazon-bedrock`,children:`Amazon Bedrock`}),` with credentials that don’t live in your `,_jsx(_components.code,{children:`.aws`}),` directory. Claude Code accepts the `,_jsx(_components.code,{children:`aws sts`}),` output shape and the flat `,_jsx(_components.code,{children:`aws configure export-credentials`}),` shape, and scopes the credentials to its own Bedrock client, so the shell commands Claude runs still see your ambient credentials.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, a shell command line`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code uses the ambient AWS credential chain`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"awsCredentialExport\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"/bin/generate_aws_grant.sh\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Unlike `,_jsx(_components.a,{href:`#awsauthrefresh`,children:_jsx(_components.code,{children:`awsAuthRefresh`})}),`, Claude Code always runs this command when it’s set, without checking the ambient credentials first. See `,_jsx(_components.a,{href:`/en/amazon-bedrock#advanced-credential-configuration`,children:`advanced credential configuration`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`forceloginmethod`,children:_jsx(_components.code,{children:`forceLoginMethod`})}),`\n`,_jsxs(_components.p,{children:[`Restrict which kind of account people can log in with. Set `,_jsx(_components.code,{children:`\"claudeai\"`}),` to allow only claude.ai accounts, `,_jsx(_components.code,{children:`\"console\"`}),` to allow only Claude Console accounts, or `,_jsx(_components.code,{children:`\"gateway\"`}),` to send people to a `,_jsx(_components.a,{href:`/en/claude-apps-gateway`,children:`cloud gateway`}),` instead of a first-party login. Administrators set it in managed settings and pair it with `,_jsx(_components.a,{href:`#forceloginorguuid`,children:_jsx(_components.code,{children:`forceLoginOrgUUID`})}),` to keep developers’ claude.ai logins inside one organization.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Claude Code honors `,_jsx(_components.code,{children:`\"gateway\"`}),` only from a managed source on the machine: `,_jsx(_components.code,{children:`managed-settings.json`}),`, the macOS plist or Windows HKLM registry, or a policy helper. It treats `,_jsx(_components.code,{children:`\"gateway\"`}),` as unset in user, project, local, HKCU, and server-managed settings, the same rule as `,_jsx(_components.a,{href:`#forcelogingatewayurl`,children:_jsx(_components.code,{children:`forceLoginGatewayUrl`})}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, one of:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"claudeai\"`}),`: only claude.ai accounts can log in`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"console\"`}),`: only Claude Console accounts can log in`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"gateway\"`}),`: Claude Code sends people to a cloud gateway instead of a first-party login`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so people pick a login method`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"forceLoginMethod\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"claudeai\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Every first-party login path applies the restriction, including the `,_jsx(_components.a,{href:`/en/vs-code`,children:`VS Code extension`}),`, the Agent SDK, `,_jsx(_components.code,{children:`claude setup-token`}),`, and `,_jsx(_components.code,{children:`/install-github-app`}),`, except the terminal’s interactive login screen, reached by `,_jsx(_components.code,{children:`/login`}),` or first-run onboarding, which pre-selects the method without enforcing it. Before v2.1.212, only terminal logins applied it. See `,_jsx(_components.a,{href:`/en/authentication#restrict-login-to-your-organization`,children:`Restrict login to your organization`}),` for how each login path, environment credentials, and third-party providers are handled.`]}),`\n`,_jsx(Heading,{level:`3`,id:`forcelogingatewayurl`,children:_jsx(_components.code,{children:`forceLoginGatewayUrl`})}),`\n`,_jsxs(_components.p,{children:[`Set the gateway URL the `,_jsx(_components.code,{children:`/login`}),` Cloud gateway screen connects to, so people reach your `,_jsx(_components.a,{href:`/en/claude-apps-gateway`,children:`cloud gateway`}),` without typing its address. The screen has no URL field: with this key set, it shows your gateway URL and connects when the person presses Enter; without it, it tells them to contact their IT administrator. When `,_jsx(_components.code,{children:`forceLoginMethod`}),` is unset, this key alone opens the Cloud gateway screen. `,_jsx(_components.code,{children:`forceLoginMethod: \"gateway\"`}),` also opens it and removes the login-method picker, and a `,_jsx(_components.code,{children:`claudeai`}),` or `,_jsx(_components.code,{children:`console`}),` value there takes precedence over this key. Set both keys so the screen connects instead of showing an error.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})}),`. Read only from a source on the machine: `,_jsx(_components.code,{children:`managed-settings.json`}),`, the macOS plist or Windows HKLM registry, or a policy helper. Claude Code ignores it in HKCU and server-managed settings.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, a full URL including the scheme`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so the Cloud gateway screen shows an error telling people to contact their IT administrator`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"forceLoginGatewayUrl\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"https://claude-gateway.example.com\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`A value that isn’t a valid URL is dropped on its own; the rest of the managed settings file still applies. See `,_jsx(_components.a,{href:`/en/claude-apps-gateway#set-the-gateway-url`,children:`Set the gateway URL`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`forceloginorguuid`,children:_jsx(_components.code,{children:`forceLoginOrgUUID`})}),`\n`,_jsx(_components.p,{children:`From a managed source, require claude.ai account logins to belong to one Anthropic organization, a single UUID, or to any of several, an array. From any settings file, a single UUID also pre-selects that organization during a claude.ai or Claude Console login; an array pre-selects nothing.`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Only a managed source enforces the restriction; a single UUID in any other settings file pre-selects the organization during login without restricting it.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, one UUID, or array of strings, several UUIDs`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so any organization can log in`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`This example accepts logins from either of two organizations without pre-selecting one:`}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"forceLoginOrgUUID\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#