}),`, which reserves 1% of the context window`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"skillListingBudgetFraction\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`0.02`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`To see how much context the listing uses and which skills contribute most, run `,_jsx(_components.code,{children:`/doctor`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`skilllistingmaxdescchars`,children:_jsx(_components.code,{children:`skillListingMaxDescChars`})}),`\n`,_jsxs(_components.p,{children:[`Each turn, Claude sees a `,_jsx(_components.a,{href:`/en/skills#skill-descriptions-are-cut-short`,children:`listing of your skills`}),` that shows each skill’s `,_jsx(_components.code,{children:`description`}),` and `,_jsx(_components.code,{children:`when_to_use`}),` text. This key caps how many characters of that text Claude Code shows per skill; longer text is cut at the cap.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,