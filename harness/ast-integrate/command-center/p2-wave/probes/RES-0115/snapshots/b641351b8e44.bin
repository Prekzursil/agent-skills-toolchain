ldren:`\"stable\"`}),`: updates follow a version that is typically about one week old and skips releases with major regressions`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code follows `,_jsx(_components.code,{children:`\"latest\"`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"autoUpdatesChannel\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"stable\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Claude Code writes `,_jsx(_components.code,{children:`\"stable\"`}),` to your user settings when you pick it under `,_jsx(_components.strong,{children:`Auto-update channel`}),` in `,_jsx(_components.code,{children:`/config`}),`, and removes the key when you switch back to latest there. `,_jsx(_components.code,{children:`claude install stable`}),` and `,_jsx(_components.code,{children:`claude install latest`}),` also save the channel you name. Switching from `,_jsx(_components.code,{children:`\"latest\"`}),` to `,_jsx(_components.code,{children:`\"stable\"`}),` in `,_jsx(_components.code,{children:`/config`}),` asks whether to allow a downgrade or stay on your current version; staying sets `,_jsx(_components.a,{href:`#minimumversion`,children:_jsx(_components.code,{children:`minimumVersion`})}),`. Homebrew installs ignore this key: the `,_jsx(_components.code,{children:`claude-code`}),` cask tracks stable and `,_jsx(_components.code,{children:`claude-code@latest`}),` tracks latest, and `,_jsx(_components.code,{children:`claude update`}),` defers to `,_jsx(_components.code,{children:`brew upgrade`}),`. To turn auto-updates off entirely, set `,_jsx(_components.a,{href:`/en/setup#disable-auto-updates`,children:_jsx(_components.code,{children:`DISABLE_AUTOUPDATER`})}),` in `,_jsx(_components.code,{children:`env`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`minimumversion`,children:_jsx(_components.code,{children:`minimumVersion`})}),`\n`,_jsxs(_components.p,{children:[`Keep background auto-updates and `,_jsx(_components.code,{children:`claude update`}),` from installing any version below this one, so moving to the `,_jsx(_components.code,{children:`\"stable\"`}),` channel doesn’t downgrade you from a newer `,_jsx(_components.code,{children:`\"latest\"`}),` build. Claude Code writes this key for you when you choose to stay on your current version while switching channels in `,_jsx(_components.code,{children:`/config`}),`, and clears it when you switch back to `,_jsx(_components.code,{children:`\"latest\"`}),`.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Set it in managed settings to pin an organization-wide minimum that user and project settings can’t lower.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, a version number such as `,_jsx(_components.code,{children:`\"2.1.100\"`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so updates can install any version the channel offers`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`This example follows the stable channel and refuses to install any version below 2.1.100:`}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`4`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`4`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"autoUpdatesChannel\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"stable\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"minimumVersion\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"2.1.100\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`This key only constrains updates. To make Claude Code refuse to start below a version, use `,_jsx(_components.a,{href:`#requiredminimumversion`,children:_jsx(_components.code,{children:`requiredMinimumVersion`})}),` instead. See `,_jsx(_components.a,{href:`/en/setup#pin-a-minimum-version`,children:`Pin a minimum version`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`requiredmaximumversion`,children:_jsx(_components.code,{children:`requiredMaximumVersion`})}),`\n`,_jsxs(_components.p,{children:[`Set the newest Claude Code version your organization allows to start. When the running version is newer, Claude Code exits at startup and tells the user to install an approved version through your organization’s approved method; `,_jsx(_components.code,{children:`claude install \u003cversion\u003e`}),` may also work. Requires Claude Code v2.1.163 or later.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})}),`. Claude Code gives no warning when it ignores the key elsewhere.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, a version number such as `,_jsx(_components.code,{children:`\"2.1.150\"`}),`; a value that isn’t a valid version is ignored`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so no ceiling applies`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"requiredMaximumVersion\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"2.1.150\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Background auto-updates and `,_jsx(_components.code,{children:`claude update`}),` skip versions above the ceiling, so an installation inside the range stays inside it. `,_jsx(_components.code,{children:`claude update`}),`, `,_jsx(_components.code,{children:`claude install`}),`, and `,_jsx(_components.code,{children:`claude doctor`}),` keep working above the ceiling so users can recover. Pair it with `,_jsx(_components.a,{href:`#requiredminimumversion`,children:_jsx(_components.code,{children:`requiredMinimumVersion`})}),` to enforce a range. Requires Claude Code v2.1.163 or later.`]}),`\n`,_jsx(Heading,{level:`3`,id:`requiredminimumversion`,children:_jsx(_components.code,{children:`requiredMinimumVersion`})}),`\n`,_jsx(_components.p,{children:`Set the oldest Claude Code version your organization allows to start. When the running version is older, Claude Code exits at startup and tells the user to update through your organization’s approved method. The check runs at startup only, so a session that’s already running continues. Requires Claude Code v2.1.163 or later.`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})}),`. Claude Code gives no warning when it ignores the key elsewhere.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, a version number such as `,_jsx(_components.code,{children:`\"2.1.150\"`}),`; a value that isn’t a valid version is ignored`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so no floor applies`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"requiredMinimumVersion\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"2.1.150\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`claude update`}),`, `,_jsx(_components.code,{children:`claude install`}),`, and `,_jsx(_components.code,{children:`claude doctor`}),` keep working below the floor so users can recover. Unlike `,_jsx(_components.a,{href:`#minimumversion`,children:_jsx(_components.code,{children:`minimumVersion`})}),`, which only prevents downgrades, this key blocks startup. Pair it with `,_jsx(_components.a,{href:`#requiredmaximumversion`,children:_jsx(_components.code,{children:`requiredMaximumVersion`})}),` to enforce a range. Requires Claude Code v2.1.163 or later.`]}),`\n`,_jsx(Heading,{level:`2`,id:`tools`,children:`Tools`}),`\n`,_jsxs(_components.p,{children:[`Turn off specific tools in the `,_jsx(_components.a,{href:`/en/desktop`,children:`Claude Code desktop app`}),`. The terminal CLI ignores these keys. For the tools themselves, see `,_jsx(_components.a,{href:`/en/tools-reference`,children:`Tools available to Claude`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`browserexternalpagetools`,children:_jsx(_components.code,{children:`browserExternalPageTools`})}),`\n`,_jsxs(_components.p,{children:[`Stop Claude from using its tools to read or act on external pages in the desktop app’s `,_jsx(_components.a,{href:`/en/desktop#browse-external-sites`,children:`Browser pane`}),`. People in your organization can still open external sites themselves, and local dev server previews keep working with Claude’s tools. The desktop app reads this key; the terminal CLI ignores it.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, `,_jsx(_components.code,{children:`\"disabled\"`}),`; the desktop app also accepts `,_jsx(_components.code,{children:`\"disable\"`}),`, in either case`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude’s tools work on external pages`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"browserExternalPageTools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"disabled\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Any other value leaves Claude’s tools on, and a non-empty string that isn’t one of the two accepted values logs a warning. To block external sites for people and Claude alike, set `,_jsx(_components.a,{href:`#disablebrowserexternalnavigation`,children:_jsx(_components.code,{children:`disableBrowserExternalNavigation`})}),` instead. See `,_jsx(_components.a,{href:`/en/desktop#restrict-external-browsing-for-your-organization`,children:`Restrict external browsing for your organization`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`disablebrowserexternalnavigation`,children:_jsx(_components.code,{children:`disableBrowserExternalNavigation`})}),`\n`,_jsxs(_components.p,{children:[`Turn off external browsing in the desktop app’s `,_jsx(_components.a,{href:`/en/desktop#browse-external-sites`,children:`Browser pane`}),` for people and Claude alike. Localhost dev server previews keep working. The desktop app reads this key; the terminal CLI ignores it.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean; only the JSON Boolean `,_jsx(_components.code,{children:`true`}),` takes effect`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: the desktop app turns off external browsing in the Browser pane for people and Claude alike; localhost previews keep working`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: external browsing stays on`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so external browsing is on`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"disableBrowserExternalNavigation\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The desktop app ignores any other value, and a value that isn’t a Boolean, such as the string `,_jsx(_components.code,{children:`\"true\"`}),` or `,_jsx(_components.code,{children:`1`}),`, also logs a warning. To leave external browsing on but keep Claude’s tools off external pages, set `,_jsx(_components.a,{href:`#browserexternalpagetools`,children:_jsx(_components.code,{children:`browserExternalPageTools`})}),` instead. See `,_jsx(_components.a,{href:`/en/desktop#restrict-external-browsing-for-your-organization`,children:`Restrict external browsing for your organization`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`disablemobilesimulatortools`,children:_jsx(_components.code,{children:`disableMobileSimulatorTools`})}),`\n`,_jsxs(_components.p,{children:[`Block Claude’s tools for the desktop app’s `,_jsx(_components.a,{href:`/en/desktop-ios-simulator#turn-off-simulator-access`,children:`iOS Simulator pane`}),`. People keep manual use of the pane; only Claude’s access is removed, and nobody can turn it back on from inside the app. The desktop app reads this key; the terminal CLI ignores it.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean; only the JSON Boolean `,_jsx(_components.code,{children:`true`}),` takes effect`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: the desktop app blocks Claude’s tools for the iOS Simulator pane`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: Claude’s simulator tools follow each person’s settings toggle in the desktop app`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude’s simulator tools follow each person’s settings toggle in the desktop app`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"disableMobileSimulatorTools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The desktop app ignores any other value, and a value that isn’t a Boolean, such as the string `,_jsx(_components.code,{children:`\"true\"`}),` or `,_jsx(_components.code,{children:`1`}),`, also logs a warning.`]}),`\n`,_jsx(`span`,{id:`data-and-privacy`}),`\n`,_jsx(Heading,{level:`2`,id:`privacy-and-telemetry`,children:`Privacy and telemetry`}),`\n`,_jsxs(_components.p,{children:[`Control how long Claude Code keeps session data and what it sends. The switches that turn off usage metrics and error reports are environment variables, not settings keys: set `,_jsx(_components.code,{children:`DISABLE_TELEMETRY`}),`, `,_jsx(_components.code,{children:`DISABLE_ERROR_REPORTING`}),`, or `,_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC`}),` in the `,_jsx(_components.a,{href:`#env`,children:_jsx(_components.code,{children:`env`})}),` key or in the shell. `,_jsx(_components.a,{href:`/en/data-usage#telemetry-services`,children:`Telemetry services`}),` says what each one stops. The session survey is the exception: `,_jsx(_components.a,{href:`#feedbacksurveyrate`,children:_jsx(_components.code,{children:`feedbackSurveyRate`})}),` below turns it off from a settings file.`]}),`\n`,_jsx(Heading,{level:`3`,id:`cleanupperioddays`,children:_jsx(_components.code,{children:`cleanupPeriodDays`})}),`\n`,_jsxs(_components.p,{children:[`Set how many days Claude Code keeps `,_jsx(_components.a,{href:`/en/claude-directory#cleaned-up-automatically`,children:`session transcripts and other application data`}),` before deleting them. Claude Code runs the deletion as a background sweep after a session starts, as long as it can safely determine the retention period.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: number of days, a whole number, minimum `,_jsx(_components.code,{children:`1`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`30`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"cleanupPeriodDays\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`20`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Setting `,_jsx(_components.code,{children:`0`}),` fails validation, so pick a large value such as `,_jsx(_components.code,{children:`3650`}),` for long retention. To stop Claude Code from writing transcripts at all, see `,_jsx(_components.a,{href:`/en/claude-directory#plaintext-storage`,children:`Plaintext storage`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`feedbacksurveyrate`,children:_jsx(_components.code,{children:`feedbackSurveyRate`})}),`\n`,_jsxs(_components.p,{children:[`Set the probability that the `,_jsx(_components.a,{href:`/en/data-usage#session-quality-surveys`,children:`session quality survey`}),` appears when a session is eligible for it. Set `,_jsx(_components.code,{children:`0`}),` to keep the survey from appearing.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: number between `,_jsx(_components.code,{children:`0`}),` and `,_jsx(_components.code,{children:`1`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code uses the rate Anthropic sets remotely, or its built-in rate of `,_jsx(_components.code,{children:`0.005`}),` on Amazon Bedrock, Google Cloud’s Agent Platform, and Microsoft Foundry, which don’t receive remote configuration`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY`})}),` set to `,_jsx(_components.code,{children:`1`}),` turns the survey off for one session whatever rate this key sets`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span