which resolve to Claude Code’s current default version of that model family, or a full model ID such as `,_jsx(_components.code,{children:`\"claude-opus-5\"`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so the advisor is off`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.code,{children:`--advisor`}),` takes precedence over this key for one session. `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_ADVISOR_TOOL`})}),` turns the advisor off, and this key can’t turn it back on`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"advisorModel\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"opus\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The key has no effect on Amazon Bedrock, Google Cloud’s Agent Platform, or Microsoft Foundry. `,_jsx(_components.code,{children:`\"fable\"`}),` requires `,_jsx(_components.a,{href:`/en/advisor#choose-an-advisor-model`,children:`Fable 5 access`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`alwaysthinkingenabled`,children:_jsx(_components.code,{children:`alwaysThinkingEnabled`})}),`\n`,_jsxs(_components.p,{children:[`Turn `,_jsx(_components.a,{href:`/en/model-config#extended-thinking`,children:`extended thinking`}),` off for every session by setting this to `,_jsx(_components.code,{children:`false`}),`. Thinking is on by default, so `,_jsx(_components.code,{children:`true`}),` changes nothing. Most people set this through `,_jsx(_components.code,{children:`/config`}),` rather than by editing the file.`]}),`\n`,_jsxs(_components.p,{children:[`On models that always think, such as Fable 5, `,_jsx(_components.code,{children:`false`}),` has no effect. On `,_jsx(_components.a,{href:`/en/third-party-integrations`,children:`third-party providers`}),` Claude Code omits the `,_jsx(_components.code,{children:`thinking`}),` parameter instead of turning thinking off, so adaptive-reasoning models may still think.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: no effect; thinking is already on`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: Claude Code turns extended thinking off for every session`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so thinking is on for models that support it`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`MAX_THINKING_TOKENS`})}),` takes precedence over this key for one session: `,_jsx(_components.code,{children:`0`}),` turns thinking off, under the same model and provider limits as `,_jsx(_components.code,{children:`false`}),`, and a positive value turns thinking on even when this key is `,_jsx(_components.code,{children:`false`}),`. On adaptive-reasoning models the number itself is ignored`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"alwaysThinkingEnabled\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`false`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`availablemodels`,children:_jsx(_components.code,{children:`availableModels`})}),`\n`,_jsxs(_components.p,{children:[`Restrict which models people can select for the main session, `,_jsx(_components.a,{href:`/en/sub-agents`,children:`subagents`}),`, `,_jsx(_components.a,{href:`/en/skills`,children:`skills`}),`, and the `,_jsx(_components.a,{href:`/en/advisor`,children:`advisor`}),`. A managed list constrains `,_jsx(_components.code,{children:`/model`}),`, `,_jsx(_components.code,{children:`--model`}),`, and the `,_jsx(_components.code,{children:`model`}),` key in a developer’s own files; a model outside it can’t be selected. On its own this doesn’t touch the Default option; pair it with `,_jsx(_components.a,{href:`#enforceavailablemodels`,children:_jsx(_components.code,{children:`enforceAvailableModels`})}),` for that.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Deploy it in managed settings to enforce it for an organization.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: array of model aliases or IDs`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so every model is available`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`This example lets people select only Sonnet and Haiku models:`}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"availableModels\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"sonnet\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"haiku\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`See `,_jsx(_components.a,{href:`/en/model-config#restrict-model-selection`,children:`Restrict model selection`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`effortlevel`,children:_jsx(_components.code,{children:`effortLevel`})}),`\n`,_jsxs(_components.p,{children:[`Keep an `,_jsx(_components.a,{href:`/en/model-config#adjust-effort-level`,children:`effort level`}),` across sessions. Lower levels are faster and cheaper on straightforward tasks, and higher levels reason more deeply on complex problems. Claude Code writes this key to your user settings when you run `,_jsx(_components.code,{children:`/effort low`}),`, `,_jsx(_components.code,{children:`medium`}),`, `,_jsx(_components.code,{children:`high`}),`, or `,_jsx(_components.code,{children:`xhigh`}),` in an interactive session on your machine. In a `,_jsx(_components.code,{children:`-p`}),` run, the Agent SDK, or a session attached to a remote worker, `,_jsx(_components.code,{children:`/effort`}),` applies to that session only. The message `,_jsx(_components.code,{children:`/effort`}),` prints says which happened.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, one of:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"low\"`}),`: the least reasoning, for short, scoped, latency-sensitive tasks that aren’t intelligence-sensitive`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"medium\"`}),`: reduces token usage for cost-sensitive work that can trade off some intelligence`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"high\"`}),`: balances token usage and intelligence`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"xhigh\"`}),`: deeper reasoning at higher token spend`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.code,{children:`--effort`}),` takes precedence over this key for one session, and `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_EFFORT_LEVEL`})}),` takes precedence over both`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"effortLevel\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"xhigh\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`On Opus 4.7, Opus 4.8, and Fable 5, Claude Code holds that model’s default effort until you change effort once with `,_jsx(_components.code,{children:`/effort`}),`, `,_jsx(_components.code,{children:`--effort`}),`, or the `,_jsx(_components.code,{children:`/model`}),` picker. After that, it reads this key. See `,_jsx(_components.a,{href:`/en/model-config#adjust-effort-level`,children:`Adjust effort level`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`enforceavailablemodels`,children:_jsx(_components.code,{children:`enforceAvailableModels`})}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`/model`}),` picker has a `,_jsx(_components.strong,{children:`Default`}),` option that resolves to your `,_jsx(_components.a,{href:`/en/model-config#organization-default-model`,children:`organization default model`}),` when one applies, and otherwise to your account type’s default. An `,_jsx(_components.a,{href:`#availablemodels`,children:_jsx(_components.code,{children:`availableModels`})}),` allowlist limits the models you can name, but on its own it leaves `,_jsx(_components.strong,{children:`Default`}),` alone, so `,_jsx(_components.strong,{children:`Default`}),` can still resolve to a model outside the list. This key closes that gap. Requires Claude Code v2.1.175 or later.`]}),`\n`,_jsx(_components.p,{children:`When your organization deploys any managed settings, Claude Code reads this key from the managed source alone and ignores it in your other files.`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: when `,_jsx(_components.strong,{children:`Default`}),` would resolve to a model outside `,_jsx(_components.code,{children:`availableModels`}),`, Claude Code resolves it to the first available model in the list`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: `,_jsx(_components.strong,{children:`Default`}),` resolves as usual, even to a model outside `,_jsx(_components.code,{children:`availableModels`})]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`This example restricts named selections to Sonnet and Haiku models and makes `,_jsx(_components.strong,{children:`Default`}),` resolve to the first of them that is available:`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`4`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`4`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"availableModels\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"sonnet\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"haiku\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`],`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"enforceAvailableModels\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),