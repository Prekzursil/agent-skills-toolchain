es your terminal’s light or dark background`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"dark\"`}),`: the dark theme`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"light\"`}),`: the light theme`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"dark-daltonized\"`}),`: the dark theme with colorblind-friendly colors`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"light-daltonized\"`}),`: the light theme with colorblind-friendly colors`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"dark-ansi\"`}),`: the dark theme using only your terminal’s ANSI color palette`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"light-ansi\"`}),`: the light theme using only your terminal’s ANSI color palette`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"custom:\u003cslug\u003e\"`}),` or `,_jsx(_components.code,{children:`\"custom:\u003cplugin-name\u003e:\u003cslug\u003e\"`}),`: a custom theme from `,_jsx(_components.code,{children:`~/.claude/themes/`}),` or a plugin`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`\"dark\"`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"theme\"`}),_jsx(_compone