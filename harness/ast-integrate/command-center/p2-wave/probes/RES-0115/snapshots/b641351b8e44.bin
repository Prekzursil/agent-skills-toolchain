project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` doesn’t install it for other people. On every path that loads plugins, Claude Code reports the plugin as not installed until each user `,_jsx(_components.a,{href:`/en/discover-plugins#configure-team-marketplaces`,children:`installs it themselves`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`extraknownmarketplaces`,children:_jsx(_components.code,{children:`extraKnownMarketplaces`})}),`\n`,_jsxs(_components.p,{children:[`Register additional plugin marketplaces by name, so that people who open the repository, or everyone your managed settings reach, get the marketplace without adding it themselves. Claude Code registers each marketplace it doesn’t already know. Whether a plugin that `,_jsx(_components.a,{href:`#enabledplugins`,children:_jsx(_components.code,{children:`enabledPlugins`})}),` names from it installs depends on the plugin’s source and which file enables it; that entry has the rules.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Claude Code honors entries in a repository’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` or `,_jsx(_components.code,{children:`.claude/settings.local.json`}),` only after you accept the workspace trust dialog for that folder; in a folder you haven’t trusted, including a `,_jsx(_components.code,{children:`-p`}),` run there, it ignores them without a message.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: object mapping a marketplace name to an object with a `,_jsx(_components.code,{children:`source`}),` object and an optional `,_jsx(_components.code,{children:`autoUpdate`}),` Boolean`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`This example registers a GitHub marketplace and a marketplace from a self-hosted git URL:`}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`16`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`16`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"extraKnownMarketplaces\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"acme-tools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"source\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`        \"source\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"github\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`        \"repo\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"acme-corp/claude-plugins\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`      }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    },`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"security-plugins\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"source\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`        \"source\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"git\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`        \"url\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"https://git.example.com/security/plugins.git\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`      }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`/en/permissions#what-runs-before-you-trust-a-folder`,children:`What runs before you trust a folder`}),` compares the trust gate with the other content a repository can supply. You can also write this key as `,_jsx(_components.code,{children:`additionalMarketplaces`}),`; see `,_jsx(_components.a,{href:`#marketplace-key-aliases`,children:`Marketplace key aliases`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Set `,_jsx(_components.code,{children:`\"autoUpdate\": true`}),` alongside `,_jsx(_components.code,{children:`source`}),` to make Claude Code refresh that marketplace and update its installed plugins in the background after startup. When omitted, `,_jsx(_components.code,{children:`claude-plugins-official`}),` and most other official Anthropic marketplaces default to `,_jsx(_components.code,{children:`true`}),`, and third-party marketplaces default to `,_jsx(_components.code,{children:`false`}),`. See `,_jsx(_components.a,{href:`/en/discover-plugins#configure-auto-updates`,children:`Configure auto-updates`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`When more than one settings file defines a marketplace entry under the same name, Claude Code uses the entry from the `,_jsx(_components.a,{href:`/en/settings#settings-precedence`,children:`highest-precedence file`}),` whole. That entry replaces the lower-precedence entry and inherits none of its fields, so a redefinition can’t combine one file’s `,_jsx(_components.code,{children:`source.headers`}),` credential with a URL another file controls. Before v2.1.228, Claude Code merged same-name entries field by field, so an entry in a higher-precedence file could inherit fields it didn’t set, including another file’s `,_jsx(_components.code,{children:`headers`}),`.`]}),`\n`,_jsx(Heading,{level:`4`,id:`marketplace-source-types`,children:`Marketplace source types`}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`source`}),` object takes one of these forms:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`github`})}),`: a GitHub repository, with `,_jsx(_components.code,{children:`repo`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`git`})}),`: any git URL, with `,_jsx(_components.code,{children:`url`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`url`})}),`: a direct URL to a `,_jsx(_components.code,{children:`marketplace.json`}),` file, with `,_jsx(_components.code,{children:`url`}),` and optional `,_jsx(_components.code,{children:`headers`}),` for authenticated access`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`file`})}),`: a local path to a `,_jsx(_components.code,{children:`marketplace.json`}),` file, with `,_jsx(_components.code,{children:`path`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`directory`})}),`: a local filesystem path, with `,_jsx(_components.code,{children:`path`}),`, for development only`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:_jsx(_components.code,{children:`settings`})}),`: an inline marketplace declared directly in the settings file without a hosted repository, with `,_jsx(_components.code,{children:`name`}),` and `,_jsx(_components.code,{children:`plugins`})]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`git`}),` source type works with any git hosting service, including self-hosted GitLab and Bitbucket. Claude Code clones the repository with the same authentication that `,_jsx(_components.code,{children:`git clone`}),` would use on that machine: configured credential helpers or SSH keys. A provider token such as `,_jsx(_components.code,{children:`GITHUB_TOKEN`}),` takes effect only through a credential helper that reads it. See `,_jsx(_components.a,{href:`/en/plugin-marketplaces#private-repositories`,children:`Private repositories`}),` for setup details.`]}),`\n`,_jsxs(_components.p,{children:[`For `,_jsx(_components.code,{children:`github`}),` and `,_jsx(_components.code,{children:`git`}),` sources, set `,_jsx(_components.code,{children:`\"skipLfs\": true`}),` inside the `,_jsx(_components.code,{children:`source`}),` object, alongside `,_jsx(_components.code,{children:`repo`}),` or `,_jsx(_components.code,{children:`url`}),`, to skip Git LFS downloads when Claude Code clones or updates the marketplace repository. LFS pointer files remain as pointers instead of downloading their content. Use this when the repository contains large LFS objects unrelated to plugin content. Requires Claude Code v2.1.153 or later.`]}),`\n`,_jsxs(_components.p,{children:[`Plugins listed in a `,_jsx(_components.code,{children:`settings`}),` source must reference external sources such as GitHub or npm, and the `,_jsx(_components.code,{children:`name`}),` must match the marketplace key. You still enable each plugin separately in `,_jsx(_components.code,{children:`enabledPlugins`}),`. This example declares one plugin inline:`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`19`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,chil