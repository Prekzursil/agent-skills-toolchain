rd-party providers don’t redact.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: you see full thinking summaries when you expand thinking with `,_jsx(_components.code,{children:`Ctrl+O`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: the Anthropic API redacts thinking blocks and Claude Code shows a collapsed stub`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"showThinkingSummaries\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Redaction only changes what you see, not what the model generates: to reduce thinking spend, `,_jsx(_components.a,{href:`/en/model-config#extended-thinking`,children:`lower the budget or disable thinking`}),` instead. This setting has no effect in non-interactive mode (`,_jsx(_components.code,{children:`-p`}),`), the Agent SDK, or IDE extensions such as VS Code.`]}),`\n`,_jsx(Heading,{level:`3`,id:`switchmodelsonflag`,children:_jsx(_components.code,{children:`switchModelsOnFlag`})}),`\n`,_jsxs(_components.p,{children:[`Choose what happens when a `,_jsx(_components.a,{href:`/en/model-config#automatic-model-fallback`,children:`safety classifier flags a request`}),`: switch to the fallback model and continue, or pause so you can choose between switching and editing the prompt.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. Appears in `,_jsx(_components.code,{children:`/config`}),` as `,_jsx(_components.strong,{children:`Switch models when a message is flagged`}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code switches to the fallback model and continues`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: in an interactive session Claude Code pauses so you can choose between switching and editing the prompt; where no dialog can show, such as a `,_jsx(_components.code,{children:`-p`}),` run, the flagged request ends as an error`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`true`}),`, switch automatically`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"switchModelsOnFlag\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`false`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`See `,_jsx(_components.a,{href:`/en/model-config#ask-before-switching`,children:`Ask before switching`}),`. Requires Claude Code v2.1.170 or later.`]}),`\n`,_jsx(Heading,{level:`3`,id:`ultracode`,children:_jsx(_components.code,{children:`ultracode`})}),`\n`,_jsxs(_components.p,{children:[`Start sessions with `,_jsx(_components.a,{href:`/en/workflows#let-claude-decide-with-ultracode`,children:`ultracode`}),` on. With it on, Claude plans a workflow for each substantive task instead of waiting for you to ask. Claude plans workflows only when `,_jsx(_components.a,{href:`/en/workflows`,children:`dynamic workflows`}),` are enabled for you and your model supports `,_jsx(_components.code,{children:`xhigh`}),` effort. Either way, `,_jsx(_components.code,{children:`ultracode: true`}),` runs the session at `,_jsx(_components.code,{children:`xhigh`}),` effort. Claude Code reads this key but never writes it: `,_jsx(_components.code,{children:`/effort ultracode`}),` turns ultracode on for the current session only.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: sessions start at `,_jsx(_components.code,{children:`xhigh`}),` effort, with ultracode on when dynamic workflows are enabled for you and your model supports `,_jsx(_components.code,{children:`xhigh`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: sessions start with ultracode off`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so ultracode is off`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.code,{children:`/effort ultracode`}),` turns ultracode on for one session without this key. So does `,_jsx(_components.code,{children:`--effort ultracode`}),`, which requires Claude Code v2.1.203 or later`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"ultracode\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-d