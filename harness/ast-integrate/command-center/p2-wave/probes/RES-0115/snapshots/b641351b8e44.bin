en\",\"tabs\":[{\"tab\":\"Getting started\",\"pages\":[{\"title\":\"Getting started\",\"href\":\"/en/overview\"}]},{\"tab\":\"Build with Claude Code\",\"pages\":[{\"title\":\"Build with Claude Code\",\"href\":\"/en/agents\"}]},{\"tab\":\"Administration\",\"pages\":[{\"title\":\"Administration\",\"href\":\"/en/admin-setup\"}]},{\"tab\":\"Configuration\",\"groups\":[{\"group\":\"Settings\",\"pages\":[{\"sidebarTitle\":\"Settings overview\",\"title\":\"Claude Code settings\",\"description\":\"Change Claude Code settings, pick the scope a key belongs in, verify the change, and learn which value Claude Code uses when a key is set in several places.\",\"keywords\":[\"settings.json\",\"settings\",\"config\",\"configuration\",\".claude/settings\",\"settings.local.json\",\"managed-settings.json\",\"precedence\"],\"href\":\"/en/settings\"},{\"sidebarTitle\":\"Settings reference\",\"title\":\"Claude Code settings reference\",\"mode\":\"wide\",\"description\":\"Complete reference for every Claude Code settings.json key: where each one goes, its type and default, and a paste-ready example, with an index of every key.\",\"keywords\":[\"settings.json\",\"settings reference\",\"settings\",\"config\",\"configuration\",\".claude/settings\",\"managed-settings.json\"],\"href\":\"/en/settings-reference\"},{\"title\":\"Example settings files\",\"description\":\"Realistic settings.json files for a developer, a team, and an organization: copy one, keep the keys you want, and change the values.\",\"href\":\"/en/settings-example\"}]},{\"group\":\"Permissions and sandboxing\",\"pages\":[{\"sidebarTitle\":\"Permissions\",\"title\":\"Configure permissions\",\"description\":\"Control what Claude Code can access and do with fine-grained permission rules, modes, and managed policies.\",\"keywords\":[\"permissions\",\"allow\",\"deny\",\"allowlist\",\"permission rules\"],\"href\":\"/en/permissions\"},{\"title\":\"Choose a permission mode\",\"sidebarTitle\":\"Permission modes\",\"description\":\"Control whether Claude asks before acting. Switch permission modes with Shift+Tab in the CLI, the mode indicator in VS Code, or the mode selector in Desktop.\",\"keywords\":[\"auto\",\"auto mode\",\"default permission mode\",\"plan mode\",\"accept edits\",\"manual mode\",\"yolo\",\"bypass permissions\",\"shift tab\"],\"href\":\"/en/permission-modes\"},{\"title\":\"Configure the sandboxed Bash tool\",\"sidebarTitle\":\"Bash sandbox\",\"description\":\"Learn how Claude Code's sandboxed Bash tool provides filesystem and network isolation for safer, more autonomous agent execution.\",\"href\":\"/en/sandboxing\"},{\"title\":\"Choose a sandbox environment\",\"sidebarTitle\":\"Sandbox environments\",\"description\":\"Compare Claude Code sandbox options: the built-in sandboxed Bash tool, sandbox runtime, dev containers, Docker, and VMs. Choose the right isolation for your threat model.\",\"keywords\":[\"sandbox\",\"isolation\",\"dev container\",\"devcontainer\",\"docker\",\"container\",\"vm\",\"virtual machine\",\"bubblewrap\",\"seatbelt\",\"security\",\"dangerously-skip-permissions\",\"bypassPermissions\",\"yolo\",\"yolo mode\"],\"href\":\"/en/sandbox-environments\"}]},{\"group\":\"Environments\",\"pages\":[{\"title\":\"Configure cloud environments\",\"sidebarTitle\":\"Cloud environments\",\"description\":\"Configure cloud environments for Claude Code cloud sessions: network access levels, environment variables, setup scripts, and environment caching.\",\"href\":\"/en/cloud-environments\"},{\"group\":\"Self-hosted environments\",\"root\":{\"title\":\"Self-hosted environments\",\"description\":\"Run Claude Code cloud sessions on infrastructure you control: set up a self-hosted environment, deploy runners, and route sessions to your own compute.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"bring your own compute\",\"cloud sessions\",\"remote sessions\",\"enterprise\",\"Kubernetes\"],\"href\":\"/en/self-hosted-environments\"},\"pages\":[{\"title\":\"Self-hosted environments quickstart\",\"sidebarTitle\":\"Quickstart\",\"description\":\"Set up your first self-hosted environment: install Claude Code, create the environment, start a runner, and route a session to it.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"quickstart\",\"setup\",\"environment secret\"],\"href\":\"/en/self-hosted-environments-quickstart\"},{\"title\":\"Deploy self-hosted environments to production\",\"sidebarTitle\":\"Deploy to production\",\"description\":\"Run self-hosted runners in production: security hardening, network egress control, git credentials, Kubernetes and Compose recipes, and troubleshooting.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"production\",\"security\",\"egress\",\"Kubernetes\",\"Docker Compose\",\"troubleshooting\"],\"href\":\"/en/self-hosted-environments-deploy\"},{\"title\":\"Customize sessions in self-hosted environments\",\"sidebarTitle\":\"Customize sessions\",\"description\":\"Customize self-hosted environment sessions with wrapper scripts for per-session credentials, lifecycle hooks, and on-demand runner spawning.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"wrapper script\",\"lifecycle hooks\",\"checkout hook\",\"post-session hook\",\"on-demand runners\",\"spawn-runner\",\"MCP\",\"permissions\"],\"href\":\"/en/self-hosted-environments-configuration\"},{\"title\":\"Test self-hosted environments end to end\",\"sidebarTitle\":\"Test end to end\",\"description\":\"Verify a self-hosted runner image from CI: dispatch a session with the CLI, read Claude's replies through a Stop hook, and script the full loop.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"CI\",\"smoke test\",\"end-to-end test\",\"dispatch\",\"--environment\"],\"href\":\"/en/self-hosted-environments-testing\"},{\"title\":\"Self-hosted environments reference\",\"sidebarTitle\":\"Reference\",\"description\":\"Complete reference for the self-hosted runner and orchestrator: CLI flags, environment variables, and Prometheus metrics.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"CLI flags\",\"environment variables\",\"telemetry\",\"Prometheus\",\"metrics\",\"healthz\"],\"href\":\"/en/self-hosted-environments-reference\"},{\"title\":\"Verify session identity in self-hosted environments\",\"sidebarTitle\":\"Session identity\",\"description\":\"Verify the CLAUDE_CODE_SESSION_ACCESS_TOKEN JWT so services on your network can trust requests from sessions in your self-hosted environment.\",\"keywords\":[\"self-hosted environment\",\"self-hosted runner\",\"session token\",\"session access token\",\"JWT\",\"JWKS\",\"CLAUDE_CODE_SESSION_ACCESS_TOKEN\",\"workload identity\",\"token exchange\"],\"href\":\"/en/self-hosted-environments-identity\"}]}]},{\"group\":\"Model and responses\",\"pages\":[{\"title\":\"Model configuration\",\"description\":\"Configure which model Claude Code uses, effort levels, extended context, and the auto-compact window\",\"keywords\":[\"model\",\"opus\",\"sonnet\",\"haiku\",\"fable\",\"opusplan\",\"change model\",\"/model\",\"thinking\",\"extended thinking\",\"ultrathink\",\"effort\",\"fallback\",\"org default\",\"role default\",\"organization model restrictions\",\"effort limits\",\"autocompact\",\"auto-compact window\",\"context window\",\"compaction\",\"CLAUDE_CODE_AUTO_COMPACT_WINDOW\"],\"href\":\"/en/model-config\"},{\"title\":\"Speed up responses with fast mode\",\"description\":\"Get faster Opus responses in Claude Code by toggling fast mode.\",\"href\":\"/en/fast-mode\"},{\"title\":\"Escalate hard decisions with the advisor tool\",\"description\":\"Pair your main model with a stronger advisor model that Claude consults at key moments during a task.\",\"href\":\"/en/advisor\"},{\"title\":\"Output styles\",\"description\":\"Adapt Claude Code for uses beyond software engineering\",\"keywords\":[\"output style\",\"output styles\",\"outputStyle\",\"concise\",\"conci\",\"consice\",\"shorter responses\",\"less verbose\",\"terse\",\"brevity\",\"proactive\",\"explanatory\",\"learning\",\"eli5\",\"explain like I'm 5\",\"simple explanations\",\"response format\",\"tone\"],\"href\":\"/en/output-styles\"}]},{\"group\":\"Interface\",\"pages\":[{\"sidebarTitle\":\"Terminal configuration\",\"title\":\"Configure your terminal for Claude Code\",\"description\":\"Fix Shift+Enter for newlines, get a terminal bell when Claude finishes, configure tmux, match the color theme, and enable Vim mode in the Claude Code CLI.\",\"keywords\":[\"shift enter\",\"newline\",\"multiline\",\"terminal bell\",\"notification sound\",\"tmux\",\"iterm2\",\"vscode terminal\",\"ghostty\",\"kitty\",\"warp\",\"windows terminal\",\"git bash\",\"mintty\",\"backspace\",\"ctrl+h\",\"vim mode\",\"option key\",\"meta key\",\"flicker\",\"fullscreen\",\"/terminal-setup\"],\"href\":\"/en/terminal-config\"},{\"title\":\"Fullscreen rendering\",\"description\":\"Enable a smoother, flicker-free rendering mode with mouse support and stable memory usage in long conversations.\",\"href\":\"/en/fullscreen\"},{\"title\":\"Use Claude Code with a screen reader\",\"sidebarTitle\":\"Screen reader mode\",\"description\":\"Set up Claude Code for screen readers such as VoiceOver and NVDA, plus settings for screen magnifiers, reduced motion, and colorblind-friendly themes.\",\"keywords\":[\"screen reader\",\"screenreader\",\"accessibility\",\"a11y\",\"VoiceOver\",\"NVDA\",\"Orca\",\"JAWS\",\"blind\",\"low vision\",\"screen magnifier\",\"magnifier\",\"zoom\",\"reduced motion\",\"colorblind\",\"daltonized\",\"high contrast\",\"terminal bell\",\"assistive technology\",\"ax-screen-reader\"],\"href\":\"/en/accessibility\"},{\"title\":\"Voice dictation\",\"description\":\"Speak your prompts in the Claude Code CLI with hold-to-record or tap-to-record voice dictation.\",\"href\":\"/en/voice-dictation\"},{\"title\":\"Customize your status line\",\"sidebarTitle\":\"Customize status line\",\"description\":\"Configure a custom st