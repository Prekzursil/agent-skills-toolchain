s.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code turns fast mode on for sessions where it’s available`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: fast mode stays off`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so fast mode is off`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_FAST_MODE`})}),` turns fast mode off for one session, and this key can’t turn it back on`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"fastMode\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`fastmodepersessionoptin`,children:_jsx(_components.code,{children:`fastModePerSessionOptIn`})}),`\n`,_jsxs(_components.p,{children:[`Normally, running `,_jsx(_components.code,{children:`/fast`}),` saves `,_jsx(_components.a,{href:`#fastmode`,children:_jsx(_components.code,{children:`fastMode`})}),` to a person’s user settings, so fast mode is on at the start of every later session. Set this key to `,_jsx(_components.code,{children:`true`}),` to stop that: a saved `,_jsx(_components.code,{children:`fastMode: true`}),` no longer turns fast mode on at session start, and each person has to run `,_jsx(_components.code,{children:`/fast`}),` in each session they want it. Claude Code leaves the `,_jsx(_components.code,{children:`fastMode`}),` key in their file, so turning this key off restores the old behavior. Owners on Team or Enterprise plans can deploy it organization-wide through `,_jsx(_components.a,{href:`/en/server-managed-settings`,children:`server-managed settings`}),`.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: a saved `,_jsx(_components.code,{children:`fastMode: true`}),` no longer turns fast mode on at session start, so each person runs `,_jsx(_components.code,{children:`/fast`}),` in each session they want it; a `,_jsx(_components.code,{children:`fastMode: true`}),` passed with `,_jsx(_components.code,{children:`--settings`}),` still counts for that session unless managed settings set this key`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: a saved `,_jsx(_components.code,{children:`fastMode: true`}),` turns fast mode on at the start of every later session`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"fastModePerSessionOptIn\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`See `,_jsx(_components.a,{href:`/en/fast-mode#require-per-session-opt-in`,children:`Require per-session opt-in`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`language`,children:_jsx(_components.code,{children:`language`})}),`\n`,_jsxs(_components.p,{children:[`Have Claude respond in a language other than English by default. There is no fixed list for responses: Claude Code adds the value verbatim to the system prompt as an instruction to always respond in that language, so any language name Claude can read works. Claude Code doesn’t check the value, so a misspelled name reaches Claude as written rather than producing an error. The same value sets the language for `,_jsx(_components.a,{href:`/en/voice-dictation#change-the-dictation-language`,children:`voice dictation`}),`, which does have a fixed list of `,_jsx(_components.a,{href:`/en/voice-dictation#change-the-dictation-language`,children:`supported dictation languages`}),`, and for auto-generated session titles.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, any language name, such as `,_jsx(_components.code,{children:`\"japanese\"`}),`, `,_jsx(_components.code,{children:`\"spanish\"`}),`, or `,_jsx(_components.code,{children:`\"french\"`}),`; Claude Code doesn’t validate it`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset; session titles then match the language of your conversation`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"language\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"japanese\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`model`,children:_jsx(_components.code,{children:`model`})}),`\n`,_jsxs(_components.p,{children:[`Set the model every new session uses, so you don’t have to pick one with `,_jsx(_components.code,{children:`/model`}),` each time. Setting it here doesn’t stop you from switching mid-session. If your admin set an `,_jsx(_components.a,{href:`/en/model-config#organization-default-model`,children:`organization default model`}),` to override user selection, you get that model even when you set this key in user, project, or local settings.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, a model alias or full model ID`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code uses your account’s default model`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.code,{children:`--model`}),` takes precedence over `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`ANTHROPIC_MODEL`})}),`, and both take precedence over this key for one session, including over a managed `,_jsx(_components.code,{children:`model`}),`; an `,_jsx(_components.a,{href:`#availablemodels`,children:_jsx(_components.code,{children:`availableModels`})}),` list still applies to the pick`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.sp