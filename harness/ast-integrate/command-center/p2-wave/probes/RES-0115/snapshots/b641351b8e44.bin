x(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_NO_FLICKER`})}),` and `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN`})}),` take precedence over this key for one session: `,_jsx(_components.code,{children:`CLAUDE_CODE_NO_FLICKER=1`}),` turns fullscreen on, and `,_jsx(_components.code,{children:`CLAUDE_CODE_NO_FLICKER=0`}),` or `,_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1`}),` turns it off; when both are set, Claude Code turns it off`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"tui\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"fullscreen\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Under tmux `,_jsx(_components.code,{children:`-CC`}),` or over SSH to Windows, Claude Code keeps the classic renderer unless you set `,_jsx(_components.code,{children:`CLAUDE_CODE_NO_FLICKER=1`}),`. Background sessions opened from `,_jsx(_components.a,{href:`/en/agent-view`,children:`agent view`}),` always use the fullscreen renderer regardless of this setting.`]}),`\n`,_jsx(Heading,{level:`3`,id:`verbose`,children:_jsx(_components.code,{children:`verbose`})}),`\n`,_jsxs(_components.p,{children:[`By default, the transcript collapses each tool call to a short summary, such as the command Claude ran and a line count of its output, and you press `,_jsx(_components.code,{children:`Ctrl+O`}),` to switch the whole transcript to the expanded view when you want the details. Set this key to `,_jsx(_components.code,{children:`true`}),` to show every tool call’s full input and output inline as it happens, which is useful when you’re debugging a hook, an MCP server, or a long shell command. Appears in `,_jsx(_components.code,{children:`/config`}),` as `,_jsx(_components.strong,{children:`Verbose output`}),`.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})}),`. A value in `,_jsx(_components.code,{children:`~/.claude.json`}),` from an older version applies when no settings file sets it.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: you see full tool output`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: you see truncated summaries of tool output`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.a,{href:`/en/cli-reference#cli-flags`,children:_jsx(_components.code,{children:`--verbose`})}),` takes precedence over this key for one session`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filena