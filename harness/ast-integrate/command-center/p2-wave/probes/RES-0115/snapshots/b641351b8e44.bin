rce of `,_jsx(_components.code,{children:`allow`}),`, `,_jsx(_components.code,{children:`ask`}),`, and `,_jsx(_components.code,{children:`deny`}),` rules; Claude Code ignores rules from other files and `,_jsx(_components.code,{children:`--allowedTools`}),`, hides always-allow choices, and stops saving new rules`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: Claude Code applies permission rules from user, project, local, and `,_jsx(_components.code,{children:`--settings`}),` files in addition to the managed ones`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code applies permission rules from user, project, and local settings and from `,_jsx(_components.code,{children:`--settings`}),`, in addition to the managed ones`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"allowManagedPermissionRulesOnly\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`This key doesn’t lock down the MCP server allowlist; for that, set