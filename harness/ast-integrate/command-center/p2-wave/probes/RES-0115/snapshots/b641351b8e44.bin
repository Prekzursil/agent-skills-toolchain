uch as the built-in Explanatory and Learning styles or one you wrote yourself.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code builds the style into the system prompt once per conversation. An edit to this key takes effect after you run `,_jsx(_components.code,{children:`/clear`}),` or start a new session.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, the name of a `,_jsx(_components.a,{href:`/en/output-styles#built-in-output-styles`,children:`built-in`}),` or `,_jsx(_components.a,{href:`/en/output-styles#create-a-custom-output-style`,children:`custom`}),` output style`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so Claude Code uses the default style`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`This example selects the built-in Explanatory style, which adds educational insights between tasks:`}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"outputStyle\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"Explanatory\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`showthinkingsummaries`,children:_jsx(_components.code,{children:`showThinkingSummaries`})}),`\n`,_jsxs(_components.p,{children:[`See summaries of Claude’s `,_jsx(_components.a,{href:`/en/model-config#extended-thinking`,children:`extended thinking`}),` in interactive sessions. Set it if you want the full summaries when you expand thinking with `,_jsx(_components.code,{children:`Ctrl+O`}),`. When unset or `,_jsx(_components.code,{children:`false`}),`, the Anthropic API redacts thinking blocks and Claude Code shows a collapsed stub; third-party providers don’t redact.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: you see full thinking summaries when you expand thinking with `,_jsx(_components.code,{children:`Ctrl+O`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: the Anthropic API redacts thinking blocks and Claude Code shows a collapsed stub`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children