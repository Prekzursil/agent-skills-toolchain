nents.code,{children:`permissions.allow`}),`. For how permission rules from different files combine, see `,_jsx(_components.a,{href:`/en/permissions#settings-precedence`,children:`how permission rules merge across scopes`}),`; for how settings keys in general combine, see `,_jsx(_components.a,{href:`/en/settings#settings-precedence`,children:`Settings precedence`}),` on the settings guide.`]}),`\n`,_jsx(Heading,{level:`3`,id:`useautomodeduringplan`,children:_jsx(_components.code,{children:`useAutoModeDuringPlan`})}),`\n`,_jsxs(_components.p,{children:[`Choose whether Claude Code uses the auto mode classifier to review shell commands in plan mode. With the default `,_jsx(_components.code,{children:`true`}),`, the classifier reviews each command during planning when auto mode is available and you see no prompt. Set `,_jsx(_components.code,{children:`false`}),` to get a permission prompt for every command outside the built-in read-only set. Appears in `,_jsx(_components.code,{children:`/config`}),` as `,_jsx(_components.strong,{children:`Use auto mode during plan`}),`.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`User, local, or managed`})}),`. A repository can’t turn it off for you.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: the same as unset; when auto mode is available, the classifier reviews each shell command during planning instead of prompting you for it. A `,_jsx(_components.code,{children:`false`}),` in any of these files still turns it off`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: you get a permission prompt for every command outside the built-in read-only set`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_