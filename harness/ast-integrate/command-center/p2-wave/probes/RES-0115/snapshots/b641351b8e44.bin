<span class="line"><span style="color:#116329;--shiki-dark:#9CDCFE">    &quot;enableWeakerNetworkIsolation&quot;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0550AE;--shiki-dark:#569CD6">true</span></span>
