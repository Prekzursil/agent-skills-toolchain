s(_components.li,{children:[_jsx(_components.code,{children:`NO_COLOR`}),` and `,_jsx(_components.code,{children:`FORCE_COLOR`}),` set here reach only subprocesses. To change Claude Code’s own interface colors, set them in your shell before launching `,_jsx(_components.code,{children:`claude`}),`.`]}),`\n`,_jsxs(_components.li,{children:[`Values here are plain text in the settings file and reach every subprocess Claude Code starts. For an OTLP bearer token that rotates, use `,_jsx(_components.a,{href:`#otelheadershelper`,children:_jsx(_components.code,{children:`otelHeadersHelper`})}),`; for API credentials, use `,_jsx(_components.a,{href:`#apikeyhelper`,children:_jsx(_components.code,{children:`apiKeyHelper`})}),`.`]}),`\n`]}),`\n`,_jsxs(Heading,{level:`4`,id:`when-claude-code-applies-env-values`,children:[`When Claude Code applies `,_jsx(_components.code,{children:`env`}),` values`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`From user settings, `,_jsx(_components.code,{children:`--settings`}),`, and managed settings: at startup, and again in the running session when a saved change alters the merged `,_jsx(_components.code,{children:`env`}),`.`]}),`\n`,_jsxs(_components.li,{children:[`From project and local settings: after you trust the workspace, or at startup in `,_jsx(_components.code,{children:`-p`}),` mode, which never shows the trust dialog, and again when a saved change alters the merged `,_jsx(_components.code,{children:`env`}),`.`]}),`\n`,_jsx(_components.li,{children:`Variables Claude Code classifies as safe, such as model selection, timeouts and limits, feature toggles, and telemetry settings: at startup from every settings file.`}),`\n`]}),`\n`,_jsxs(Heading,{level:`4`,id:`variables-claude-code-ignores-in-env`,children:[`Variables Claude Code ignores in `,_jsx(_components.code,{children:`env`})]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Project and local settings can’t set a few variables, such as `,_jsx(_components.code,{children:`CLAUDE_CODE_PROCESS_WRAPPER`}),`, `,_jsx(_components.code,{children:`CLAUDE_CODE_SYNC_SKILLS`}),`, `,_jsx(_components.code,{children:`CLAUDE_CODE_SYNC_PLUGINS`}),`, `,_jsx(_components.code,{children:`CLAUDE_CODE_PLUGIN_CACHE_DIR`}),`, and `,_jsx(_components.code,{children:`CLAUDE_CODE_PLUGIN_SEED_DIR`}),`; set those in user or managed settings.`]}),`\n`,_jsxs(_components.li,{children:[`Identity variables that Claude Code’s hosting environments own, such as `,_jsx(_components.code,{children:`CLAUDE_CODE_REMOTE`}),` and `,_jsx(_components.code,{children:`CLAUDE_CODE_ACCOUNT_UUID`}),`, are ignored from every file.`]}),`\n`,_jsxs(_components.li,{children:[_jsxs(_components.a,{href:`/en/env-vars#variables`,children:[_jsx(_components.code,{children:`CLAUDE_CODE_MESSAGING_SOCKET`}),` and `,_jsx(_components.code,{children:`CLAUDE_CODE_MESSAGING_TOKEN`})]}),`, which Claude Code exports itself, are ignored from every file. Ignoring the socket variable requires Claude Code v2.1.224 or later, and ignoring the token requires v2.1.228 or later.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`/en/sessions#name-the-project-directory-yourself`,children:_jsx(_components.code,{children:`CLAUDE_CODE_PROJECT_DIR_NAME`})}),`, which Claude Code reads from the launch environment only, is ignored from every file; requires v2.1.234 or later.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`filecheckpointingenabled`,children:_jsx(_components.code,{children:`fileCheckpointingEnabled`})}),`\n`,_jsxs(_components.p,{children:[`Have Claude Code snapshot files before each edit so `,_jsx(_components.a,{href:`/en/checkpointing`,children:_jsx(_components.code,{children:`/rewind`})}),` can restore them. Appears in `,_jsx(_components.code,{children:`/config`}),` as `,_jsx(_components.strong,{children:`Rewind code (checkpoints)`}),`, and toggling it there writes this key to your user settings.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code snapshots files before each edit so `,_jsx(_components.code,{children:`/rewind`}),` can restore them`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: Claude Code doesn’t snapshot files, so `,_jsx(_components.code,{children:`/rewind`}),` can’t restore them`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`true`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_FILE_CHECKPOINTING`})}),` turns checkpointing off for one session; whichever of the two turns it off, the other can’t turn it back on`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"fileCheckpointingEnabled\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{colo