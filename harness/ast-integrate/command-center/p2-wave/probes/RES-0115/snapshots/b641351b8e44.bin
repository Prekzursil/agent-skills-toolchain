nents.code,{children:`CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY`})}),` set to `,_jsx(_components.code,{children:`1`}),` turns the survey off for one session whatever rate this key sets`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"feedbackSurveyRate\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`0.05`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`The same rate applies to the survey in the VS Code extension.`}),`\n`,_jsx(Heading,{level:`3`,id:`skipwebfetchpreflight`,children:_jsx(_components.code,{children:`skipWebFetchPreflight`})}),`\n`,_jsxs(_components.p,{children:[`Skip the `,_jsx(_components.a,{href:`/en/data-usage#webfetch-domain-safety-check`,children:`WebFetch domain safety check`}),`, which sends each requested hostname to `,_jsx(_components.code,{children:`api.anthropic.com`}),` before fetching. Set `,_jsx(_components.code,{children:`true`}),` in environments that block traffic to Anthropic, such as Amazon Bedrock, Google Cloud’s Agent Platform, or Microsoft Foundry deployments with restrictive egress.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code skips the WebFetch domain safety check`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: the check runs before the first fetch to each hostname in a session, and again for a hostname whose earlier check was blocked or failed`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset, so the check runs before the first fetch to each hostname in a session`]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"skipWebFetchPreflight\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`With the check skipped, WebFetch attempts any URL without consulting the blocklist, so pair it with `,_jsxs(_components.a,{href:`/en/permissions#webfetch`,children:[_jsx(_components.code,{children:`WebFetch`}),` permission rules`]}),` if you need to restrict which domains Claude can reach.`]}),`\n`,_jsx(`span`,{id:`managed-policy`}),`\n`,_jsx(Heading,{level:`2`,id:`enterprise-and-managed-settings`,children:`Enterprise and managed settings`}),`\n`,_jsxs(_components.p,{children:[`Keys an organization uses to compute, refresh, and combine managed settings. See `,_jsx(_components.a,{href:`/en/admin-setup`,children:`Set up managed settings`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`disablesideloadflags`,children:_jsx(_components.code,{children:`disableSideloadFlags`})}),`\n`,_jsxs(_components.p,{children:[`Reject the `,_jsx(_components.code,{children:`--plugin-dir`}),`, `,_jsx(_components.code,{children:`--plugin-url`}),`, `,_jsx(_components.code,{children:`--agents`}),`, and `,_jsx(_components.code,{children:`--mcp-config`}),` CLI flags at startup, which users could otherwise pass to bypass `,_jsx(_components.a,{href:`#strictknownmarketplaces`,children:_jsx(_components.code,{children:`strictKnownMarketplaces`})}),` for a single run. Claude Code exits with an error naming the rejected flags, and applies the same check to surfaces that start the CLI with these flags internally, currently `,_jsx(_components.a,{href:`/en/desktop`,children:`Cowork`}),` local sessions in the desktop app. In `,_jsx(_components.a,{href:`/en/claude-code-on-the-web`,children:`cloud sessions`}),`, Claude Code drops the MCP servers the server delivered through `,_jsx(_components.code,{children:`--mcp-config`}),`, other than in-process `,_jsx(_components.code,{children:`type: \"sdk\"`}),` entries, and starts the session. Requires Claude Code v2.1.193 or later.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code rejects `,_jsx(_components.code,{children:`--plugin-dir`}),`, `,_jsx(_components.code,{children:`--plugin-url`}),`, `,_jsx(_components.code,{children:`--agents`}),`, and `,_jsx(_components.code,{children:`--mcp-config`}),` at startup and exits with an error naming them, except that in cloud sessions it drops the MCP servers the server delivered through `,_jsx(_components.code,{children:`--mcp-config`}),`, other than in-process `,_jsx(_components.code,{children:`type: \"sdk\"`}),` entries, and starts the session`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: Claude Code accepts those flags`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"disableSideloadFlags\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Claude Code still accepts a `,_jsx(_components.code,{children:`--mcp-config`}),` whose servers are all in-process `,_jsx(_components.code,{children:`type: \"sdk\"`}),` entries, so the Agent SDK and VS Code extension keep working. Users can still add servers with `,_jsx(_components.code,{children:`claude mcp add`}),` or a `,_jsx(_components.code,{children:`.mcp.json`}),` file; for per-server control, set `,_jsx(_components.a,{href:`/en/managed-mcp`,children:_jsx(_components.code,{children:`allowedMcpServers`})}),` as well. Requires Claude Code v2.1.193 or later.`]}),`\n`,_jsxs(_components.p,{children:[`In cloud sessions, Claude Code also ignores server-delivered mid-session MCP updates, the path behind cloud session configuration and SDK `,_jsx(_components.code,{children:`setMcpServers()`}),` on remote workers. In-process `,_jsx(_components.code,{children:`type: \"sdk\"`}),` entries stay exempt there too. Before v2.1.239, a server-delivered `,_jsx(_components.code,{children:`--mcp-config`}),` blocked a cloud session from starting.`]}),`\n`,_jsx(Heading,{level:`3`,id:`forceremotesettingsrefresh`,children:_jsx(_components.code,{children:`forceRemoteSettingsRefresh`})}),`\n`,_jsxs(_components.p,{children:[`Block CLI startup until Claude Code has freshly fetched `,_jsx(_components.a,{href:`/en/server-managed-settings`,children:`server-managed settings`}),`. If the fetch fails, Claude Code exits instead of continuing with cached or no settings. When the key is unset, startup continues without waiting for remote settings. A Cloud gateway session always waits, and exits if the gateway can’t be reached. Set it when your environment can’t accept even a brief window in which a session runs without its managed policy.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})}),`. Claude Code honors a `,_jsx(_components.code,{children:`true`}),` from any admin-controlled managed source, even one that isn’t the highest-priority source.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: Boolean`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`true`}),`: Claude Code blocks startup until it has freshly fetched server-managed settings, and exits if the fetch fails`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`false`}),`: startup continues without waiting for remote settings`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`false`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"forceRemoteSettingsRefresh\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`true`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Set it in an MDM profile or the managed settings file to enforce fail-closed startup before the first server payload arrives. Claude Code applies the check only in sessions that fetch server-managed settings, so a session that `,_jsx(_components.a,{href:`/en/server-managed-settings#platform-availability`,children:`doesn’t fetch them`}),` starts without waiting. The `,_jsx(_components.code,{children:`claude auth`}),` subcommands are exempt, so users can re-authenticate when expired credentials are why the fetch fails. See `,_jsx(_components.a,{href:`/en/server-managed-settings#enforce-fail-closed-startup`,children:`Enforce fail-closed startup`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`parentsettingsbehavior`,children:_jsx(_components.code,{children:`parentSettingsBehavior`})}),`\n`,_jsxs(_components.p,{children:[`Choose whether Claude Code applies managed settings supplied by an embedding host process, such as the Agent SDK or an IDE extension, when an admin-deployed managed tier is also present. With `,_jsx(_components.code,{children:`\"first-wins\"`}),`, Claude Code drops the host-supplied settings; with `,_jsx(_components.code,{children:`\"merge\"`}),`, it applies them under the admin tier through a restrictive-only filter. Set `,_jsx(_components.code,{children:`\"merge\"`}),` when a host needs to pass its own restrictions to the sessions it launches, for example Claude Desktop delivering a gateway’s egress allowlist.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Managed`})}),`. Claude Code reads it from the highest-priority admin-controlled managed source.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: string, one of:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"first-wins\"`}),`: Claude Code drops the host-supplied settings when an admin-deployed managed tier is present`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`\"merge\"`}),`: Claude Code applies the host-supplied settings under the admin tier through a restrictive-only filter`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: `,_jsx(_components.code,{children:`\"first-wins\"`})]}),`\n`]}),`\n`,_jsx(CodeBlock,{filename:`managed-settings.json`,numberOfLines:`3`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"parentSettingsBehavior\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"merge\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`This key has no effect when no admin-deployed managed tier exists: the host’s settings then apply as the only managed tier, still filtered to restrictive values. For the filter’s limits and how the managed sources interact, see `,_jsx(_components.a,{href:`/en/managed-settings#parent-settings-from-embedding-hosts`,children:`Parent settings from embedding hosts`}),` and `,_jsx(_components.a,{href:`/en/claude-apps-gateway#restrict-parent-settings`,children:`Restrict parent settings`}),`.`]}),`\n`,_jsx(`span`,{id:`compute-managed-settings-with-a-policy-helper`}),`\n`,_jsx(Heading,{level:`3`,id:`policyhelper`,children: