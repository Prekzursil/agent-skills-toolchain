es apply to Claude’s built-in file tools and to file commands Claude Code recognizes in Bash, such as `,_jsx(_components.code,{children:`cat`}),`, `,_jsx(_components.code,{children:`head`}),`, `,_jsx(_components.code,{children:`tail`}),`, and `,_jsx(_components.code,{children:`sed`}),`; they don’t apply to arbitrary subprocesses, so for OS-level enforcement `,_jsx(_components.a,{href:`/en/sandboxing`,children:`enable the sandbox`}),`.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Scope`}),`: `,_jsx(_components.a,{href:`#scopes`,children:_jsx(_components.code,{children:`Any file`})})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Type`}),`: array of permission rule strings`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Default`}),`: unset`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Per-session overrides`}),`: `,_jsx(_components.code,{children:`--disallowedTools`}),` adds deny rules for one session alongside this key`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`This example denies reads of `,_jsx(_components.code,{children:`.env`}),` files, the `,_jsx(_components.code,{children:`secrets`}),` directory, and a credentials file, and blocks `,_jsx(_components.code,{children:`curl`}),` commands:`]}),`\n`,_jsx(CodeBlock,{filename:`settings.json`,numberOfLines:`11`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`11`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-d