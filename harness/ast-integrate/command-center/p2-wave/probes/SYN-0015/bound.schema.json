{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/SYN-0015/bound.schema.json",
  "title": "SYN-0015 overclaim-scan discriminator (unit-local)",
  "$comment": "Catalog output_schema is a generated $ref shim (generic_report). jsonschema 4.10 on this image cannot resolve ast-integrate.invalid without a disk store (RefResolutionError, not ValidationError). Even resolved, the physical overclaim-scan profile does not constrain flagged_sentences.corrected_sentence. This bound schema is the discrimination contract: empty rewrite rejected, garbage rejected, two independent reviewers filed without seeing each other, live_corpus files_scanned stated. Do not add these rules to the generated catalog shim.",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report"
  ],
  "properties": {
    "unit_id": { "const": "SYN-0015" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "^SUCCESS:SYN-0015"
    },
    "report": {
      "type": "object",
      "required": [
        "kind",
        "verdict",
        "flagged_sentences",
        "live_corpus",
        "counts",
        "reviewers",
        "observations",
        "control_ids"
      ],
      "properties": {
        "kind": { "const": "overclaim-scan" },
        "verdict": {
          "type": "string",
          "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
        },
        "flagged_sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "sentence",
              "quantifier",
              "asserted_population",
              "measured_population",
              "receipt_anchor",
              "corrected_sentence",
              "classification",
              "underlying_work_verdict"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sentence": { "type": "string", "minLength": 1 },
              "quantifier": { "type": "string", "minLength": 1 },
              "asserted_population": { "type": "string", "minLength": 1 },
              "corrected_sentence": { "type": "string", "minLength": 12 },
              "classification": { "const": "overclaim" },
              "underlying_work_verdict": { "const": "CONFIRMED" },
              "measured_population": {
                "type": "object",
                "required": ["measured_n", "population_n", "coverage"],
                "properties": {
                  "measured_n": { "type": "integer", "minimum": 0 },
                  "population_n": { "type": "integer", "minimum": 1 },
                  "coverage": { "type": "string", "minLength": 1 }
                }
              },
              "receipt_anchor": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "live_corpus": {
          "type": "object",
          "required": ["files_scanned", "absent_outputs", "verdict"],
          "properties": {
            "files_scanned": { "type": "integer", "minimum": 0 },
            "absent_outputs": { "type": "integer", "minimum": 0 },
            "verdict": {
              "type": "string",
              "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
            }
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "flagged_count",
            "flagged_with_rewrite",
            "quoted_mention_flags",
            "already_scoped_flags"
          ],
          "properties": {
            "flagged_count": { "type": "integer", "minimum": 1 },
            "flagged_with_rewrite": { "type": "integer", "minimum": 1 },
            "quoted_mention_flags": { "const": 0 },
            "already_scoped_flags": { "const": 0 }
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "reviewer_id",
              "verdict",
              "independent",
              "saw_other_verdict_before_filing"
            ],
            "properties": {
              "reviewer_id": { "type": "string", "minLength": 1 },
              "verdict": { "const": "PASS" },
              "independent": { "const": true },
              "saw_other_verdict_before_filing": { "const": false }
            }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": true
}
