{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/schema/injection-corpus-result.schema.json",
  "title": "Injection-corpus result (Phase 12 ADV injection units)",
  "description": "Discriminating contract for command-center/adversarial/ADV-*-injection.json. additionalProperties is true so probe payloads can land; garbage without the required spine is rejected.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "title",
    "question_or_target",
    "named_probes",
    "target_verdicts",
    "tests",
    "evidence",
    "negative_controls",
    "reviewer",
    "artifacts",
    "min_bytes_threshold"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^ADV-[0-9]{4}$"
    },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "report_kind": { "type": "string", "const": "injection-corpus-result" },
    "title": { "type": "string", "minLength": 16 },
    "question_or_target": { "type": "string", "minLength": 40 },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "raw_output"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "command": { "type": "string", "minLength": 8 },
          "raw_output": { "type": "string", "minLength": 8 }
        }
      }
    },
    "target_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT-RUN", "NOT-CHECKED"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "verdict"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad_state", "silent_on_good_state"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean" },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "min_bytes_threshold": { "type": "integer", "minimum": 1024 }
  }
}
