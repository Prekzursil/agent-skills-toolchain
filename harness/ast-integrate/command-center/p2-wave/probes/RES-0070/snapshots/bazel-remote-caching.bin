t="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-full! h-full children:my-0! children:shadow-none! children:bg-transparent!"><div class="font-mono whitespace-pre leading-6"><pre class="shiki shiki-themes github-light-default dark-plus" style="background-color:#ffffff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="text"><code language="text" numberOfLines="5"><span class="line"><span>java_library(</span></span>
<span class="line"><span>    name = &quot;target&quot;,</span></span>
<span class="line"><span>    tags = [&quot;no-remote-cache&quot;],</span></span>
