",\"/mintlify-assets/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0890ba15c670d9b1.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/8778b596bb8e1fac.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0285713793f685da.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/3df48e92ab491c72.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/cfd727ba62f1c54c.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/95810dccb4b634b5.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/cc5fb492c7259b04.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/7339e6a0316f2fb6.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/a919d558158c76f7.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/c7c9dfd26f25e785.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/29f5095e175973f9.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/0eb894a8519f24ea.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/ca8fe0ccebe75085.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/f48a8fa65184b0c7.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/329b5be61330e31a.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/ea3a9a65bf1e9fce.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/9090d55f1c6244ff.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\",\"/mintlify-assets/_next/static/chunks/2dd53f5a4cfe6dd5.js?dpl=dpl_6FYZ3SECAF7eWA496xdtRigGS2Lx\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"51:[]\n52:[\"$\",\"$L54\",null,{\"customJsDisabled\":false,\"jsFiles\":[]}]\n57:T8f3d,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,Heading}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`This page covers remote caching, setting up a server to host the cache, and\nrunning builds using the remote cache.`}),`\n`,_jsx(_components.p,{children:`A remote cache is used by a team of developers and/or a continuous integration\n(CI) system to share build outputs. If your build is reproducible, the\noutputs from one machine can be safely reused on another machine, which can\nmake builds significantly faster.`}),`\n`,_jsx(Heading,{level:`2`,id:`overview`,children:`Overview`}),`\n`,_jsx(_components.p,{children:`Bazel breaks a build into discrete steps, which are called actions. Each action\nhas inputs, output names, a command line, and environment variables. Required\ninputs and expected outputs are declared explicitly for each action.`}),`\n`,_jsx(_components.p,{children:`You can set up a server to be a remote cache for build outputs, which are these\naction outputs. These outputs consist of a list of output file names and the\nhashes of their contents. With a remote cache, you can reuse build outputs\nfrom another user’s build rather than building each new output locally.`}),`\n`,_jsx(_components.p,{children:`To use remote caching:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Set up a server as the cache’s backend`}),`\n`,_jsx(_components.li,{children:`Configure the Bazel build to use the remote cache`}),`\n`,_jsx(_components.li,{children:`Use Bazel version 0.10.0 or later`}),`\n`]}),`\n`,_jsx(_components.p,{children:`The remote cache stores two types of data:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`The action cache, which is a map of action hashes to action result metadata.`}),`\n`,_jsx(_components.li,{children:`A content-addressable store (CAS) of output files.`}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Note that the remote cache additionally stores the stdout and stderr for every\naction. Inspecting the stdout/stderr of Bazel thus is not a good signal for\n`,_jsx(_components.a,{href:`/remote/cache-local`,children:`estimating cache hits`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`remote-caching`,children:`How a build uses remote caching`}),`\n`,_jsx(_components.p,{children:`Once a server is set up as the remote cache, you use the cache in multiple\nways:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Read and write to the remote cache`}),`\n`,_jsx(_components.li,{children:`Read and/or write to the remote cache except for specific targets`}),`\n`,_jsx(_components.li,{children:`Only read from the remote cache`}),`\n`,_jsx(_components.li,{children:`Not use the remote cache at all`}),`\n`]}),`\n`,_jsx(_components.p,{children:`When you run a Bazel build that can read and write to the remote cache,\nthe build follows these steps:`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsx(_components.li,{children:`Bazel creates the graph of targets that need to be built, and then creates\na list of required actions. Each of these actions has declared inputs\nand output filenames.`}),`\n`,_jsx(_components.li,{children:`Bazel checks your local machine for existing build outputs and reuses any\nthat it finds.`}),`\n`,_jsx(_components.li,{children:`Bazel checks the cache for existing build outputs. If the output is found,\nBazel retrieves the output. This is a cache hit.`}),`\n`,_jsx(_components.li,{children:`For required actions where the outputs were not found, Bazel executes the\nactions locally and creates the required build outputs.`}),`\n`,_jsx(_components.li,{children:`New build outputs are uploaded to the remote cache.`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`cache-backend`,children:`Setting up a server as the cache’s backend`}),`\n`,_jsxs(_components.p,{children:[`You need to set up a server to act as the cache’s backend. A HTTP/1.1\nserver can treat Bazel’s data as opaque bytes and so many existing servers\ncan be used as a remote caching backend. Bazel’s\n`,_jsx(_components.a,{href:`#http-caching`,children:`HTTP Caching Protocol`}),` is what supports remote\ncaching.`]}),`\n`,_jsx(_components.p,{children:`You are responsible for choosing, setting up, and maintaining the backend\nserver that will store the cached outputs. When choosing a server, consider:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Networking speed. For example, if your team is in the same office, you may\nwant to run your own local server.`}),`\n`,_jsx(_components.li,{children:`Security. The remote cache will have your binaries and so needs to be secure.`}),`\n`,_jsx(_components.li,{children:`Ease of management. For example, Google Cloud Storage is a fully managed service.`}),`\n`]}),`\n`,_jsx(_components.p,{children:`There are many backends that can be used for a remote cache. Some options\ninclude:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`#nginx`,children:`nginx`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`#bazel-remote`,children:`bazel-remote`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`#cloud-storage`,children:`Google Cloud Storage`})}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`nginx`,children:`nginx`}),`\n`,_jsxs(_components.p,{children:[`nginx is an open source web server. With its [WebDAV module], it can be\nused as a remote cache for Bazel. On Debian and Ubuntu you can install the\n`,_jsx(_components.code,{children:`nginx-extras`}),` package. On macOS nginx is available via Homebrew:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`4`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`4`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`brew tap denji/nginx`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`brew install nginx-full --with-webdav`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`Below is an example configuration for nginx. Note that you will need to\nchange `,_jsx(_components.code,{children:`/path/to/cache/dir`}),` to a valid directory where nginx has permission\nto write and read. You may need to change `,_jsx(_components.code,{children:`client_max_body_size`}),` option to a\nlarger value if you have larger output files. The server will require other\nconfiguration such as authentication.`]}),`\n`,_jsxs(_components.p,{children:[`Example configuration for `,_jsx(_components.code,{children:`server`}),` section in `,_jsx(_components.code,{children:`nginx.conf`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`11`,language:`nginx`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`nginx`,children:_jsxs(_components.code,{language:`nginx`,numberOfLines:`11`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`location`}),_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#D4D4D4`},children:` /cache/ `}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`  # The path to the directory where nginx should store the cache contents.`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`  root `}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`/path/to/cache/dir;`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`  # Allow PUT`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`  dav_methods `}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`PUT;`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`  # Allow nginx to create the /ac and /cas subdirectories.`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`  create_full_put_path `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`on`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`;`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`  # The maximum size of a single file.`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`  client_max_body_size `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1G`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`;`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`  allow `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`all`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`;`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`bazel-remote`,children:`bazel-remote`}),`\n`,_jsx(_components.p,{children:`bazel-remote is an open source remote build cache that you can use on\nyour infrastructure. It has been successfully used in production at\nseveral companies since early 2018. Note that the Bazel project does\nnot provide technical support for bazel-remote.`}),`\n`,_jsxs(_components.p,{children:[`This cache stores contents on disk and also provides garbage collection\nto enforce an upper storage limit and clean unused artifacts. The cache is\navailable as a `,_jsx(_components.a,{href:`https://hub.docker.com/r/buchgr/bazel-remote-cache/`,children:`docker image`}),` and its code is available on\n`,_jsx(_components.a,{href:`https://github.com/buchgr/bazel-remote/`,children:`GitHub`}),`.\nBoth the REST and gRPC remote cache APIs are supported.`]}),`\n`,_jsxs(_components.p,{children:[`Refer to the `,_jsx(_components.a,{href:`https://github.com/buchgr/bazel-remote/`,children:`GitHub`}),`\npage for instructions on how to use it.`]}),`\n`,_jsx(Heading,{level:`3`,id:`cloud-storage`,children:`Google Cloud Storage`}),`\n`,_jsx(_components.p,{children:`[Google Cloud Storage] is a fully managed object store which provides an\nHTTP API that is compatible with Bazel’s remote caching protocol. It requires\nthat you have a Google Cloud account with billing enabled.`}),`\n`,_jsx(_components.p,{children:`To use Cloud Storage as the cache:`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`https://cloud.google.com/storage/docs/creating-buckets`,children:`Create a storage bucket`}),`.\nEnsure that you select a bucket location that’s closest to you, as network bandwidth\nis important for the remote cache.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`Create a service account for Bazel to authenticate to Cloud Storage. See\n`,_jsx(_components.a,{href:`https://cloud.google.com/iam/docs/creating-managing-service-accounts#creating_a_service_account`,children:`Creating a service account`}),`.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Generate a secret JSON key and then pass it to Bazel for authentication. Store\nthe key securely, as anyone with the key can read and write arbitrary data\nto/from your GCS bucket.`}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:`Connect to Cloud Storage by adding the following flags to your Bazel command:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`Pass the following URL to Bazel by using the flag:\n`,_jsx(_components.code,{children:`--remote_cache=https://storage.googleapis.com\u003cvar\u003e/bucket-name\u003c/var\u003e`}),` where `,_jsx(_components.code,{children:`bucket-name`}),` is the name of your storage bucket.`]}),`\n`,_jsxs(_components.li,{children:[`Pass the authentication key using the flag: `,_jsx(_components.code,{children:`--google_credentials=\u003cvar\u003e/path/to/your/secret-key\u003c/var\u003e.json`}),`, or\n`,_jsx(_components.code,{children:`--google_default_credentials`}),` to use `,_jsx(_components.a,{href:`https://cloud.google.com/docs/authentication/production`,children:`Application Authentication`}),`.`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[`You can configure Cloud Storage to automatically delete old files. To do so, see\n`,_jsx(_components.a,{href:`https://cloud.google.com/storage/docs/managing-lifecycles`,children:`Managing Object Lifecycles`}),`.`]}),`\n`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`other-servers`,children:`Other servers`}),`\n`,_jsxs(_components.p,{children:[`You can set up any HTTP/1.1 server that supports PUT and GET as the cache’s\nbackend. Users have reported success with caching backends such as `,_jsx(_components.a,{href:`https://hazelcast.com`,children:`Hazelcast`}),`,\n`,_jsx(_components.a,{href:`http://httpd.apache.org`,children:`Apache httpd`}),`, and `,_jsx(_components.a,{href:`https://aws.amazon.com/s3`,children:`AWS S3`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`authentication`,children:`Authentication`}),`\n`,_jsxs(_components.p,{children:[`As of version 0.11.0 support for HTTP Basic Authentication was added to Bazel.\nYou can pass a username and password to Bazel via the remote cache URL. The\nsyntax is `,_jsx(_components.code,{children:`https://username:password@hostname.com:port/path`}),`. Note that\nHTTP Basic Authentication transmits username and password in plaintext over the\nnetwork and it’s thus critical to always use it with HTTPS.`]}),`\n`,_jsx(Heading,{level:`2`,id:`http-caching`,children:`HTTP caching protocol`}),`\n`,_jsxs(_components.p,{children:[`Bazel supports remote caching via HTTP/1.1. The protocol is conceptually simple:\nBinary data (BLOB) is uploaded via PUT requests and downloaded via GET requests.\nAction result metadata is stored under the path `,_jsx(_components.code,{children:`/ac/`}),` and output files are stored\nunder the path `,_jsx(_components.code,{children:`/cas/`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`For example, consider a remote cache running under `,_jsx(_components.code,{children:`http://localhost:8080/cache`}),`.\nA Bazel request to download action result metadata for an action with the SHA256\nhash `,_jsx(_components.code,{children:`01ba4719...`}),` will look as follows:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`4`,language:`http`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`http`,children:_jsxs(_components.code,{language:`http`,numberOfLines:`4`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#C586C0`},children:`GET`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` /cache/ac/01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b `}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`HTTP`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`/`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1.1`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Host`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` localhost:8080`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Accept`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` */*`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Connection`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Keep-Alive`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`A Bazel request to upload an output file with the SHA256 hash `,_jsx(_components.code,{children:`15e2b0d3...`}),` to\nthe CAS will look as follows:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`7`,language:`http`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`http`,children:_jsxs(_components.code,{language:`http`,numberOfLines:`7`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#C586C0`},children:`PUT`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` /cache/cas/15e2b0d3c33891ebb0f1ef609ec419420c20e320ce94c65fbc8c3312448eb225 `}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`HTTP`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`/`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1.1`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Host`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` localhost:8080`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Accept`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` */*`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Content-Length`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` 9`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`Connection`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`:`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` Keep-Alive`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`0x310x320x330x340x350x360x370x380x39`})}),`\n`]})})}),`\n`,_jsx(Heading,{level:`2`,id:`run-remote-cache`,children:`Run Bazel using the remote cache`}),`\n`,_jsx(_components.p,{children:`Once a server is set up as the remote cache, to use the remote cache you\nneed to add flags to your Bazel command. See list of configurations and\ntheir flags below.`}),`\n`,_jsx(_components.p,{children:`You may also need configure authentication, which is specific to your\nchosen server.`}),`\n`,_jsxs(_components.p,{children:[`You may want to add these flags in a `,_jsx(_components.code,{children:`.bazelrc`}),` file so that you don’t\nneed to specify them every time you run Bazel. Depending on your project and\nteam dynamics, you can add flags to a `,_jsx(_components.code,{children:`.bazelrc`}),` file that is:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`On your local machine`}),`\n`,_jsx(_components.li,{children:`In your project’s workspace, shared with the team`}),`\n`,_jsx(_components.li,{children:`On the CI system`}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`read-write-remote-cache`,children:`Read from and write to the remote cache`}),`\n`,_jsx(_components.p,{children:`Take care in who has the ability to write to the remote cache. You may want\nonly your CI system to be able to write to the remote cache.`}),`\n`,_jsx(_components.p,{children:`Use the following flag to read from and write to the remote cache:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`build --remote_cache=http://\u003cvar\u003eyour.host:port\u003c/var\u003e`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`Besides `,_jsx(_components.code,{children:`HTTP`}),`, the following protocols are also supported: `,_jsx(_components.code,{children:`HTTPS`}),`, `,_jsx(_components.code,{children:`grpc`}),`, `,_jsx(_components.code,{children:`grpcs`}),`.`]}),`\n`,_jsx(_components.p,{children:`Use the following flag in addition to the one above to only read from the\nremote cache:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`build --remote_upload_local_results=false`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(Heading,{level:`3`,id:`targets-remote-cache`,children:`Exclude specific targets from using the remote cache`}),`\n`,_jsxs(_components.p,{children:[`To exclude specific targets from using the remote cache, tag the target with\n`,_jsx(_components.code,{children:`no-remote-cache`}),`. For example:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`5`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`java_library(`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`    name = \"target\",`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`    tags = [\"no-remote-cache\"],`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`)`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(Heading,{level:`3`,id:`delete-remote-cache`,children:`Delete content from the remote cache`}),`\n`,_jsx(_components.p,{children:`Deleting content from the remote cache is part of managing your server.\nHow you delete content from the remote cache depends on the server you have\nset up as the cache. When deleting outputs, either delete the entire cache,\nor delete old outputs.`}),`\n`,_jsx(_components.p,{children:`The cached outputs are stored as a set of names and hashes. When deleting\ncontent, there’s no way to distinguish which output belongs to a specific\nbuild.`}),`\n`,_jsx(_components.p,{children:`You may want to delete content from the cache to:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Create a clean cache after a cache was poisoned`}),`\n`,_jsx(_components.li,{children:`Reduce the amount of storage used by deleting old outputs`}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`unix-sockets`,children:`Unix sockets`}),`\n`,_jsxs(_components.p,{children:[`The remote HTTP cache supports connecting over unix domain sockets. The behavior\nis similar to curl’s `,_jsx(_components.code,{children:`--unix-socket`}),` flag. Use the following to configure unix\ndomain socket:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`3`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`3`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`   build --remote_cache=http://\u003cvar\u003eyour.host:port\u003c/var\u003e`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`   build --remote_proxy=unix:/\u003cvar\u003epath/to/socket\u003c/var\u003e`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(_components.p,{children:`This feature is unsupported on Windows.`}),`\n`,_jsx(Heading,{level:`2`,id:`disk-cache`,children:`Disk cache`}),`\n`,_jsx(_components.p,{children:`Bazel can use a directory on the file system as a remote cache. This is\nuseful for sharing build artifacts when switching branches and/or working\non multiple workspaces of the same project, such as multiple checkouts.\nEnable the disk cache as follows:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`2`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`build --disk_cache=\u003cvar\u003epath/to/build/cache\u003c/var\u003e`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.p,{children:[`You can also run `,_jsx(_components.code,{children:`build --disk_cache`}),` with no value to use a default location\nunder your `,_jsx(_components.a,{href:`/reference/user-manual#output-user-root`,children:`output user root`}),`\n(`,_jsx(_components.code,{children:`\u003coutputUserRoot\u003e/cache/disk`}),`), alongside the repository cache. Use\n`,_jsx(_components.code,{children:`build --nodisk_cache`}),` to disable the disk cache explicitly.`]}),`\n`,_jsxs(_components.p,{children:[`You can pass a user-specific path to the `,_jsx(_components.code,{children:`--disk_cache`}),` flag using the `,_jsx(_components.code,{children:`~`}),` alias\n(Bazel will substitute the current user’s home directory). This comes in handy\nwhen enabling the disk cache for all developers of a project via the project’s\nchecked in `,_jsx(_components.code,{children:`.bazelrc`}),` file.`]}),`\n`,_jsx(Heading,{level:`3`,id:`disk-cache-gc`,children:`Garbage collection`}),`\n`,_jsxs(_components.p,{children:[`Starting with Bazel 7.4, you can use `,_jsx(_components.code,{children:`--experimental_disk_cache_gc_max_size`}),` and\n`,_jsx(_components.code,{children:`--experimental_disk_cache_gc_max_age`}),` to set a maximum size for the disk cache\nor for the age of individual cache entries. Bazel will automatically garbage\ncollect the disk cache while idling between builds; the idle timer can be set\nwith `,_jsx(_components.code,{children:`--experimental_disk_cache_gc_idle_delay`}),` (defaulting to 5 minutes).`]}),`\n`,_jsxs(_components.p,{children:[`As an alternative to automatic garbage collection, we also provide a `,_jsx(_components.a,{href:`https://github.com/bazelbuild/bazel/tree/master/src/tools/diskcache`,children:`tool`}),` to run a\ngarbage collection on demand.`]}),`\n`,_jsx(Heading,{level:`2`,id:`known-issues`,children:`Known issues`}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Input file modification during a build`})}),`\n`,_jsxs(_components.p,{children:[`When an input file is modified during a build, Bazel might upload invalid\nresults to the remote cache. You can enable a change detection with\nthe `,_jsx(_components.code,{children:`--experimental_guard_against_concurrent_changes`}),` flag. There\nare no known issues and it will be enabled by default in a future release.\nSee [issue #3360] for updates. Generally, avoid modifying source files during a\nbuild.`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Environment variables leaking into an action`})}),`\n`,_jsxs(_components.p,{children:[`An action definition contains environment variables. This can be a problem for\nsharing remote cache hits across machines. For example, environments with\ndifferent `,_jsx(_components.code,{children:`$PATH`}),` variables won’t share cache hits. Only environment variables\nexplicitly whitelisted via `,_jsx(_components.code,{children:`--action_env`}),` are included in an action\ndefinition. Bazel’s Debian/Ubuntu package used to install `,_jsx(_components.code,{children:`/etc/bazel.bazelrc`}),`\nwith a whitelist of environment variables including `,_jsx(_components.code,{children:`$PATH`}),`. If you are getting\nfewer cache hits than expected, check that your environment doesn’t have an old\n`,_jsx(_components.code,{children:`/etc/bazel.bazelrc`}),` file.`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Bazel does not track tools outside a workspace`})}),`\n`,_jsxs(_components.p,{children:[`Bazel currently does not track tools outside a workspace. This can be a\nproblem if, for example, an action uses a compiler from `,_jsx(_components.code,{children:`/usr/bin/`}),`. Then,\ntwo users with different compilers installed will wrongly share cache hits\nbecause the outputs are different but they have the same action hash. See\n`,_jsx(_components.a,{href:`https://github.com/bazelbuild/bazel/issues/4558`,children:`issue #4558`}),` for updates.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Incremental in-memory state is lost when running builds inside docker containers`}),`\nBazel uses server/client architecture even when running in single docker container.\nOn the server side, Bazel maintains an in-memory state which speeds up builds.\nWhen running builds inside docker containers such as in CI, the in-memory state is lost\nand Bazel must rebuild it before using the remote cache.`]}),`\n`,_jsx(Heading,{level:`2`,id:`external-links`,children:`External links`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Your Build in a Datacenter:`}),` The Bazel team gave a `,_jsx(_components.a,{href:`https://fosdem.org/2018/schedule/event/datacenter_build/`,children:`talk`}),` about remote caching and execution at FOSDEM 2018.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Faster Bazel builds with remote caching: a benchmark:`}),` Nicolò Valigi wrote a `,_jsx(_components.a,{href:`https://nicolovaligi.com/faster-bazel-remote-caching-benchmark.html`,children:`blog post`}),`\nin which he benchmarks remote caching in Bazel.`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`/remote/rules`,children:`Adapting Rules for Remote Execution`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`/remote/sandbox`,children:`Troubleshooting Remote Execution`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://nginx.org/en/docs/http/ngx_http_dav_module.html`,children:`WebDAV module`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://hub.docker.com/r/buchgr/bazel-remote-cache/`,children:`Docker image`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://github.com/buchgr/bazel-remote/`,children:`bazel-remote`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://cloud.google.com/storage`,children:`Google Cloud Storage`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://cloud.google.com/console`,children:`Google Cloud Console`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://cloud.google.com/storage/docs/bucket-locations`,children:`Bucket locations`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://hazelcast.com`,children:`Hazelcast`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`http://httpd.apache.org`,children:`Apache httpd`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://aws.amazon.com/s3`,children:`AWS S3`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://github.com/bazelbuild/bazel/issues/3360`,children:`issue #3360`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://grpc.io/`,children:`gRPC`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://github.com/bazelbuild/remote-apis/blob/main/build/bazel/remote/execution/v2/remote_execution.proto`,children:`gRPC protocol`})}),`\n`]}),`\n`,_jsxs(_components.li,{children:[`\n`,_jsx(_components.p,{children:_jsx(_components.a,{href:`https://github.com/buildbarn`,children:`Buildbarn`})}),`\n`]}),`\n`,_jsxs(_components.li,{child