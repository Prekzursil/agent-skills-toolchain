  try {
    if (window.__mintlifyInitialSidebarScrollDone) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var path = (window.location.pathname || '/').split('#')[0].split('?')[0];
    if (path.endsWith('/index')) path = path.slice(0, -6);
    else if (path === 'index') path = '';

    var candidates = [];
    if (path) candidates.push(path);
    if (path.startsWith('/')) candidates.push(path.slice(1));
    else candidates.push('/' + path);

    var item = null;
    for (var i = 0; i < candidates.length && !item; i++) {
      var matches = document.querySelectorAll('[id="' + candidates[i].replace(/"/g, '\\"') + '"]');
      for (var j = 0; j < matches.length; j++) {
        if (matches[j].closest('#sidebar, #sidebar-content')) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var parentRect = parent.getBoundingClientRect();
    var itemRect = item.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://bazel.build/#organization","name":"Bazel Documentation","url":"https://bazel.build","logo":{"@type":"ImageObject","url":"https://mintcdn.com/bazel/h7ma40U5Tjz5Hf-j/logo/light.svg?fit=max&auto=format&n=h7ma40U5Tjz5Hf-j&q=85&s=fe755972fa71b3fc4db1ccda7a78cb9d"}},{"@type":"WebSite","@id":"https://bazel.build#website","name":"Bazel Documentation","url":"https://bazel.build","publisher":{"@id":"https://bazel.build/#organization"}},{"@type":"WebPage","@id":"https://bazel.build/remote/cache-remote#webpage","url":"https://bazel.build/remote/cache-remote","name":"Debugging Remote Cache Hits for Remote Execution","dateModified":"2026-08-06T10:58:30.536Z","isPartOf":{"@id":"https://bazel.build#website"},"breadcrumb":{"@id":"https://bazel.build/remote/cache-remote#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://bazel.build/remote/cache-remote#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Remote Execution","item":"https://bazel.build/remote/rbe"},{"@type":"ListItem","position":2,"name":"Debugging Remote Cache Hits for Remote Execution","item":"https://bazel.build/remote/cache-remote"}]},{"@type":["Article","TechArticle"],"@id":"https://bazel.build/remote/cache-remote#article","headline":"Debugging Remote Cache Hits for Remote Execution","name":"Debugging Remote Cache Hits for Remote Execution","url":"https://bazel.build/remote/cache-remote","mainEntityOfPage":{"@id":"https://bazel.build/remote/cache-remote#webpage"},"dateModified":"2026-08-06T10:58:30.536Z","publisher":{"@id":"https://bazel.build/#organization"},"isPartOf":{"@id":"https://bazel.build#website"}}]}</script><script>document.documentElement.setAttribute('data-page-mode', "none");</script><span class="fixed inset-0 bg-background-light dark:bg-background-dark -z-10