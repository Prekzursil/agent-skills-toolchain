{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FusionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "id",
    "state",
    "status",
    "sentinel",
    "completion_sentinel",
    "title",
    "output_path",
    "output_schema",
    "local_schema",
    "operator",
    "degeneracy_rule",
    "named_inputs",
    "corpus",
    "families",
    "summary",
    "evidence",
    "tests",
    "reviewer",
    "notes"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "FusionResult" },
    "unit_id": { "type": "string", "const": "WFA-0101" },
    "id": { "type": "string", "const": "WFA-0101" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "status": { "type": "string", "enum": ["DELIVERED"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0101" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0101" },
    "title": { "type": "string", "minLength": 8 },
    "output_path": { "type": "string" },
    "output_schema": { "type": "string" },
    "local_schema": { "type": "string" },
    "schema_pack_present": { "type": "boolean" },
    "operator": { "type": "object" },
    "degeneracy_rule": { "type": "object" },
    "named_inputs": { "type": "object" },
    "corpus": { "type": "object" },
    "families": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": { "type": "object" }
    },
    "summary": { "type": "object" },
    "evidence": { "type": "array" },
    "tests": { "type": "array" },
    "reviewer": { "type": "object" },
    "notes": { "type": "string", "minLength": 16 },
    "timestamps": { "type": "object" }
  }
}
