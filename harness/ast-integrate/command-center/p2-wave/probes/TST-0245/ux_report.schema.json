{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0245/ux_report.schema.json",
  "title": "TST-0245 ux_report — colour-coded terminal signals carry a non-colour token",
  "description": "Discriminating: a SUCCESS report must record the NO_COLOR==stripped-SGR comparison, a token census of every palette role, a visible threshold breach under NO_COLOR, and a colour-cap that a garbage object cannot satisfy.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "question",
    "answer",
    "tests",
    "evidence",
    "token_map",
    "nocolor_equals_stripped_sgr",
    "threshold_breach_visible_nocolor",
    "colour_palette_size",
    "colour_palette_cap",
    "cvd_class_count",
    "color_only_mutant_flagged",
    "trace_hash_comparison",
    "nondeterminism_sources",
    "frozen_clock",
    "fixed_pid",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0245" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:TST-0245" },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "report_kind": { "type": "string", "const": "ux_report" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "nocolor_equals_stripped_sgr": { "type": "boolean", "const": true },
    "threshold_breach_visible_nocolor": { "type": "boolean", "const": true },
    "colour_palette_size": { "type": "integer", "minimum": 2, "maximum": 4 },
    "colour_palette_cap": { "type": "integer", "const": 4 },
    "cvd_class_count": { "type": "integer", "minimum": 1, "maximum": 3 },
    "color_only_mutant_flagged": { "type": "boolean", "const": true },
    "token_map": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "glyph", "token", "sgr", "cvd_class"],
        "properties": {
          "role": { "type": "string", "minLength": 2 },
          "glyph": { "type": "string", "minLength": 1, "maxLength": 1 },
          "token": { "type": "string", "minLength": 2 },
          "sgr": { "type": "string", "pattern": "^[0-9]{1,3}$" },
          "cvd_class": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "properties": {
          "kind": { "type": "string", "minLength": 3 },
          "detail": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
