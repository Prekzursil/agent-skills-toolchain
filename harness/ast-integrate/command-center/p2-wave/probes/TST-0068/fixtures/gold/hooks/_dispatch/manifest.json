{
  "schema_version": 1,
  "dispatcher": "explicit-interpreter-only",
  "hooks": [
    {
      "id": "hook.pre-tool",
      "event": "PreToolUse",
      "matcher": "*",
      "interpreter": "bash",
      "script": "scripts/marker.sh"
    },
    {
      "id": "hook.session-start",
      "event": "SessionStart",
      "matcher": "*",
      "interpreter": "python3",
      "script": "scripts/marker.py"
    },
    {
      "id": "hook.post-tool",
      "event": "PostToolUse",
      "matcher": "*",
      "interpreter": "bash",
      "script": "scripts/marker.sh"
    },
    {
      "id": "hook.stop",
      "event": "Stop",
      "matcher": "*",
      "interpreter": "bash",
      "command": ["bash", "scripts/marker.sh"]
    }
  ]
}
