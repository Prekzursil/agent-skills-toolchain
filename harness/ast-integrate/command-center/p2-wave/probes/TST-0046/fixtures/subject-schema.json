{
  "$id": "command-center/schema/conformance-report.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Discriminating contract for confirmation units that record per-check verdicts with evidence. Garbage documents without the required fields are rejected.",
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "path": {
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "checks": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT-CHECKED",
              "MATCH",
              "DIFF",
              "COMMAND-MISSING",
              "FAILED",
              "TIMEOUT"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "verdict"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "kind": {
            "minLength": 3,
            "type": "string"
          },
          "path": {
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "question": {
      "minLength": 20,
      "type": "string"
    },
    "reviewer": {
      "additionalProperties": true,
      "properties": {
        "reviewer_id": {
          "minLength": 4,
          "type": "string"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "CONTEST"
          ],
          "type": "string"
        }
      },
      "required": [
        "reviewer_id",
        "verdict"
      ],
      "type": "object"
    },
    "sentinel": {
      "minLength": 8,
      "type": "string"
    },
    "state": {
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "BLOCKED",
        "FAILED",
        "TIMEOUT",
        "SEVERED"
      ],
      "type": "string"
    },
    "tests": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "minLength": 2,
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT-CHECKED"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "result"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "unit_id": {
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$",
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "checks",
    "evidence",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "title": "Conformance report",
  "type": "object"
}
