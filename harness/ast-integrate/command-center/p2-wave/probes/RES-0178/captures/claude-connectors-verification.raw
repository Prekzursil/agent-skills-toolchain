arty connectors with remote MCP\",\"description\":\"Connect Claude to your tools using the Model Context Protocol\",\"href\":\"/connectors/custom/remote-mcp\"},{\"title\":\"Desktop extensions\",\"description\":\"Deploy enterprise-grade MCP servers with MCPB\",\"href\":\"/connectors/custom/desktop-extensions\"},{\"sidebarTitle\":\"Submit to directory\",\"title\":\"Submitting to the Connectors Directory\",\"description\":\"Submit your MCP connector to the Connectors Directory\",\"href\":\"/connectors/building/submission\"}]},{\"group\":\"Building Connectors\",\"pages\":[{\"sidebarTitle\":\"Overview\",\"title\":\"Building custom connectors\",\"description\":\"Build your own MCP servers to connect Claude to your tools and data\",\"href\":\"/connectors/building/index\"},{\"sidebarTitle\":\"What to build\",\"title\":\"What should I build: MCP, plugin, or both?\",\"description\":\"Decide between an MCP server, a plugin, or both for your Claude integration\",\"href\":\"/connectors/building/what-to-build\"},{\"sidebarTitle\":\"Authentication\",\"title\":\"Authentication for connectors\",\"description\":\"OAuth and authentication options for MCP servers in Claude\",\"href\":\"/connectors/building/authentication\"},{\"title\":\"Model Context Protocol (MCP)\",\"description\":\"Understanding the open standard powering Claude's connectors\",\"href\":\"/connectors/building/mcp\"},{\"sidebarTitle\":\"Lazy authentication\",\"title\":\"Lazy authentication for MCP servers\",\"description\":\"Let users call public tools immediately and defer OAuth until a protected tool is actually invoked.\",\"href\":\"/connectors/building/lazy-authentication\"},{\"sidebarTitle\":\"Enterprise Managed Auth\",\"title\":\"Enterprise Managed Auth for connectors\",\"description\":\"Accept identity assertions from enterprise SSO so users connect to your MCP server without a separate OAuth consent step.\",\"href\":\"/connectors/building/enterprise-managed-auth\"},{\"sidebarTitle\":\"Directory vs custom\",\"title\":\"Directory connectors vs custom connectors\",\"description\":\"Understand the difference between directory-listed and custom connectors\",\"href\":\"/connectors/building/directory-vs-custom\"},{\"sidebarTitle\":\"Testing\",\"title\":\"Testing your connector\",\"description\":\"Test your MCP server against Claude before submitting to the directory\",\"href\":\"/connectors/building/testing\"},{\"sidebarTitle\":\"Troubleshooting\",\"title\":\"Troubleshooting connectors\",\"description\":\"Diagnose and resolve common connection failures for custom and directory MCP connectors\",\"href\":\"/connectors/building/troubleshooting\"},{\"sidebarTitle\":\"Review criteria\",\"title\":\"Pre-submission checklist\",\"description\":\"What Anthropic reviewers test, so you can pass on the first try\",\"href\":\"/connectors/building/review-criteria\"},{\"sidebarTitle\":\"After publishing\",\"title\":\"Manage your listing after publishing\",\"description\":\"Update your MCP server, plugin, and directory listing after publication\",\"href\":\"/connectors/building/after-publishing\"},{\"sidebarTitle\":\"Manage your listing\",\"title\":\"Managing your directory listing\",\"description\":\"Track submissions, monitor server health and usage metrics, and edit your Connectors Directory listing\",\"href\":\"/connectors/building/managing-your-listing\"},{\"sidebarTitle\":\"MCPB (desktop extensions)\",\"title\":\"Build a desktop extension with MCPB\",\"description\":\"Package a local MCP server as a single-click .mcpb install for Claude Desktop\",\"href\":\"/connectors/building/mcpb\"},{\"group\":\"MCP Apps\",\"pages\":[{\"sidebarTitle\":\"Getting started\",\"title\":\"Get started with MCP Apps\",\"description\":\"Learn how to test MCP Apps in Claude\",\"href\":\"/connectors/building/mcp-apps/getting-started\"},{\"title\":\"Design guidelines\",\"description\":\"Visual and interaction design guidelines for MCP Apps in Claude\",\"href\":\"/connectors/building/mcp-apps/design-guidelines\"},{