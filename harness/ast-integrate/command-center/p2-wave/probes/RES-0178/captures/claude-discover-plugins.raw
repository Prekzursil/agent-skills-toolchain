hiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="shellscript"><code language="shellscript" numberOfLines="1"><span class="line"><span style="color:#953800;--shiki-dark:#DCDCAA">/plugin</span><span style="color:#0A3069;--shiki-dark:#CE9178"> list</span></span>
