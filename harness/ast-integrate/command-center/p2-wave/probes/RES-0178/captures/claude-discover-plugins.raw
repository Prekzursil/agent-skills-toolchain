ted\",\"pages\":[{\"title\":\"Getting started\",\"href\":\"/en/overview\"}]},{\"tab\":\"Build with Claude Code\",\"groups\":[{\"group\":\"Agents and parallel work\",\"pages\":[{\"title\":\"Run agents in parallel\",\"sidebarTitle\":\"Overview\",\"description\":\"Compare the ways Claude Code can take on multiple tasks at once: subagents, agent view, agent teams, and dynamic workflows.\",\"keywords\":[\"agents\",\"parallel\",\"multi-agent\",\"subagent\",\"agent view\",\"agent teams\",\"workflow\",\"workflows\",\"worktree\",\"background\"],\"href\":\"/en/agents\"},{\"title\":\"Create custom subagents\",\"description\":\"Create and use specialized AI subagents in Claude Code for task-specific workflows and improved context management.\",\"keywords\":[\"agent\",\"agents\",\"subagent\",\"sub-agent\",\"sub agent\",\"Task tool\",\"fork\",\"/fork\",\"/subtask\",\"subtask\",\"forked subagent\"],\"href\":\"/en/sub-agents\"},{\"title\":\"Manage multiple agents with agent view\",\"sidebarTitle\":\"Agent view\",\"description\":\"Dispatch and manage many Claude Code sessions from one screen. Agent view shows what every session is doing and which ones need your input.\",\"keywords\":[\"agent view\",\"background agents\",\"claude agents\",\"parallel sessions\",\"multiple sessions\",\"run in background\",\"background tasks\",\"manage agents\",\"daemon\",\"/bg\",\"/background\",\"/fork\",\"fork a session\",\"copy a session\",\"attach\",\"detach\"],\"href\":\"/en/agent-view\"},{\"title\":\"Orchestrate teams of Claude Code sessions\",\"sidebarTitle\":\"Run agent teams\",\"description\":\"Coordinate multiple Claude Code instances working together as a team, with shared tasks, inter-agent messaging, and centralized management.\",\"keywords\":[\"teammate\",\"team\",\"multi-agent\",\"swarm\"],\"href\":\"/en/agent-teams\"},{\"title\":\"Message your other Claude Code sessions\",\"sidebarTitle\":\"Cross-session messaging\",\"description\":\"Let Claude list and message your other Claude Code sessions on this machine, and reach your sessions on other machines or on the web.\",\"keywords\":[\"cross-session messaging\",\"message another session\",\"ListAgents\",\"list agents\",\"/list-agents\",\"/peers\",\"SendMessage\",\"crossSessionInbound\",\"isolatePeerMachines\",\"peer message\",\"notify_when_idle\",\"idle notice\"],\"href\":\"/en/cross-session-messaging\"},{\"title\":\"Orchestrate subagents at scale with dynamic workflows\",\"sidebarTitle\":\"Dynamic workflows\",\"description\":\"Dynamic workflows orchestrate many subagents from a script Claude writes and you can rerun. Use them for codebase audits, large migrations, and cross-checked research.\",\"keywords\":[\"workflow\",\"workflows\",\"dynamic workflows\",\"ultracode\",\"effort\",\"multi-agent\",\"fan out\",\"orchestration\",\"deep research\",\"test-time compute\",\"swarm\",\"/workflows\"],\"href\":\"/en/workflows\"},{\"title\":\"Run parallel sessions with worktrees\",\"sidebarTitle\":\"Isolate sessions with worktrees\",\"description\":\"Isolate parallel Claude Code sessions in separate git worktrees so changes don't collide. Covers the `--worktree` flag, subagent isolation, `.worktreeinclude`, cleanup, and non-git VCS hooks.\",\"keywords\":[\"worktree\",\"git worktree\",\"parallel\",\"isolation\",\".worktreeinclude\",\"EnterWorktree\"],\"href\":\"/en/worktrees\"}]},{\"group\":\"MCP\",\"pages\":[{\"title\":\"Connect to MCP servers\",\"sidebarTitle\":\"Quickstart\",\"description\":\"Add an MCP server to Claude Code, verify the connection, and find the configuration on disk.\",\"href\":\"/en/mcp-quickstart\"},{\"sidebarTitle\":\"Reference\",\"title\":\"Connect Claude Code to tools via MCP\",\"description\":\"Learn how to connect Claude Code to your tools with the Model Context Protocol.\",\"keywords\":[\"mcp\",\"model context protocol\",\"mcp server\",\".mcp.json\",\"figma\",\"linear\"],\"href\":\"/en/mcp\"}]},{\"group\":\"Skills\",\"pages\":[{\"title\":\"Extend Claude with skills\",\"description\":\"Create, manage, and share skills to extend Claude's capabilities in Claude Code. Includes custom commands and bundled skills.\",\"keywords\":[\"skill\",\"skills\",\"SKILL.md\",\"custom command\",\"custom slash command\"],\"href\":\"/en/skills\"}]},{\"group\":\"Plugins\",\"pages\":[{\"title\":\"Discover and install prebuilt plugins through marketplaces\",\"sidebarTitle\":\"Discover and install prebuilt plugins\",\"description\":\"Find and install plugins from marketplaces to extend Claude Code with new skills, agents, and capabilities.\",\"href\":\"/en/discover-plugins\"},{\"title\":\"Create plugins\",\"sidebarTitle\":\"Create plugins\",\"description\":\"Create custom plugins to extend Claude Code with skills, agents, hooks, and MCP servers.\",\"keywords\":[\"plugin\",\"plugins\",\"create plugin\",\"plugin.json\"],\"href\":\"/en/plugins\"}]},{\"group\":\"Artifacts\",\"pages\":[{\"title\":\"Share session output as artifacts\",\"description\":\"Artifacts turn Claude Code's work into live, interactive pages on claude.ai that you can keep private, share with your organization, or publish to a public link.\",\"keywords\":[\"artifact\",\"artifacts\",\"share\",\"public\",\"collaborate\",\"dashboard\",\"html\",\"page\",\"report\",\"visualize\",\"publish\",\"interactive\",\"mcp\",\"connector\",\"connectors\",\"live data\"],\"href\":\"/en/artifacts\"}]},{\"group\":\"Automation\",\"pages\":[{\"title\":\"Automate actions with hooks\",\"sidebarTitle\":\"Automate with hooks\",\"description\":\"Run shell commands automatically when Claude Code edits files, finishes tasks, or needs input. Format code, send notifications, validate commands, and enforce project rules.\",\"href\":\"/en/hooks-guide\"},{\"sidebarTitle\":\"Push external events to Claude\",\"title\":\"Push events into a running session with channels\",\"description\":\"Use channels to push messages, alerts, and webhooks into your Claude Code session from an MCP server. Forward CI results, chat messages, and monitoring events so Claude can react while you're away.\",\"href\":\"/en/channels\"},{\"title\":\"Run prompts on a schedule\",\"description\":\"Use /loop and the cron scheduling tools to run prompts repeatedly, poll for status, or set one-time reminders within a Claude Code session.\",\"keywords\":[\"loop\",\"loops\",\"/loop\",\"cron\",\"recurring\",\"repeat\",\"poll\",\"interval\",\"reminder\",\"/schedule\",\"/routines\"],\"href\":\"/en/scheduled-tasks\"},{\"title\":\"Keep Claude working toward a goal\",\"sidebarTitle\":\"Goals\",\"description\":\"Set a completion condition with /goal and Claude keeps working until it's met, a model judges it impossible, or an error you have to fix clears the goal.\",\"keywords\":[\"goal\",\"/goal\",\"until\",\"condition\",\"keep going\",\"stop hook\",\"iterate\",\"verification loop\",\"verify\"],\"href\":\"/en/goal\"},{\"title\":\"Run Claude Code programmatically\",\"sidebarTitle\":\"Programmatic usage\",\"description\":\"Use the Agent SDK to run Claude Code programmatically from the CLI, Python, or TypeScript.\",\"href\":\"/en/headless\"},{\"title\":\"Launch sessions from links\",\"description\":\"Open a Claude Code terminal session from a URL. Embed `claude-cli://` links in runbooks, alerts, and dashboards so a click opens Claude Code in the right repo with the right prompt.\",\"href\":\"/en/deep-links\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"Set up Claude Code in a monorepo or large codebase\",\"sidebarTitle\":\"Monorepos and large repos\",\"description\":\"Configure Claude Code for monorepos and large single-tree codebases with nested CLAUDE.md files, sparse worktrees, code intelligence, and per-package skills so Claude stays focused on the code you're working in.\",\"href\":\"/en/large-codebases\"}]},{\"group\":\"Troubleshooting\",\"pages\":[{\"title\":\"Troubleshoot installation and login\",\"description\":\"Fix command not found, PATH, permission, network, and authentication errors when installing or signing in to Claude Code.\",\"keywords\":[\"command not found\",\"install\",\"PATH\",\"EACCES\",\"OAuth\",\"login\",\"authentication\",\"403\",\"TLS\",\"proxy\",\"Killed\",\"out of memory\",\"exit code 137\",\"installation was killed before it could finish\",\"claude update hangs\",\"claude doctor hangs\",\"system diagnostics blank\",\"ParseException\",\"ParserError\",\"Invoke-Expression\",\"missing expression after unary operator\",\"running scripts is disabled on this system\",\"PSSecurityException\",\"execution policy\",\"claude native binary not installed\",\"could not find native binary package\",\"ENOTEMPTY\",\"npm error code ENOTEMPTY\"],\"href\":\"/en/troubleshoot-install\"},{\"title\":\"Troubleshooting\",\"sidebarTitle\":\"Troubleshoot performance and stability\",\"description\":\"Fix high CPU or memory usage, hangs, auto-compact thrashing, and search problems in Claude Code, and find the right page for other issues.\",\"keywords\":[\"error\",\"troubleshoot\",\"fix\",\"not working\",\"broken\",\"issue\",\"slow\",\"performance\",\"hang\",\"memory\",\"garbled\",\"corrupted glyphs\"],\"href\":\"/en/troubleshooting\"},{\"title\":\"Debug your configuration\",\"sidebarTitle\":\"Debug configuration\",\"description\":\"Diagnose why CLAUDE.md, settings, hooks, MCP servers, or skills aren't taking effect. Use /context, /doctor, /hooks, and /mcp to see what actually loaded.\",\"href\":\"/en/debug-your-config\"},{\"title\":\"Error reference\",\"description\":\"Look up Claude Code runtime error messages with what each one means and how to fix it.\",\"keywords\":[\"claude code error\",\"api error\",\"500\",\"529\",\"overloaded\",\"429\",\"rate limit\",\"waiting for api response\",\"will retry in\",\"no response from api\",\"401\",\"403\",\"invalid api key\",\"your apiKeyHelper script is failing\",\"apiKeyHelper failed\",\"invalid auth token\",\"fix external auth token\",\"invalid ANTHROPIC_CUSTOM_HEADERS\",\"invalid request header from the environment\",\"contains a line break at character\",\"ant