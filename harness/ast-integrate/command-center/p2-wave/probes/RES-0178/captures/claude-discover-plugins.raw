mponents.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` marketplace`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` add`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` https://example.com/marketplace.json`})]}),`\n`]})})}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`URL-based marketplaces have some limitations compared to Git-based marketplaces. If you encounter “path not found” errors when installing plugins, see `,_jsx(_components.a,{href:`/en/plugin-marketplaces#plugins-with-relative-paths-fail-in-url-based-marketplaces`,children:`Troubleshooting`}),`.`]})}),`\n`,_jsx(Heading,{level:`2`,id:`install-plugins`,children:`Install plugins`}),`\n`,_jsx(_components.p,{children:`Once you’ve added marketplaces, you can install a plugin by name:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` install`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` plugin-name@marketplace-name`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The command opens that plugin’s details, where you choose an `,_jsx(_components.a,{href:`/en/settings#where-settings-live`,children:`installation scope`}),`. You see the same choices when you run `,_jsx(_components.code,{children:`/plugin`}),`, go to the `,_jsx(_components.strong,{children:`Discover`}),` tab, and press `,_jsx(_components.strong,{children:`Enter`}),` on a plugin:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`User scope`}),`: install for yourself across all projects`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Project scope`}),`: install for all collaborators on this repository, which adds the plugin to `,_jsx(_components.code,{children:`.claude/settings.json`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Local scope`}),`: install for yourself in this repository only, not shared with collaborators`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`To install without an interactive step, use the `,_jsx(_components.a,{href:`/en/plugins-reference#plugin-install`,children:_jsx(_components.code,{children:`claude plugin install`})}),` shell command, which installs to user scope unless you pass `,_jsx(_components.code,{children:`--scope`}),`. For a plugin with a `,_jsxs(_components.a,{href:`/en/plugin-marketplaces#how-users-accept-the-command`,children:[_jsx(_components.code,{children:`command`}),` source`]}),`, pass `,_jsx(_components.code,{children:`--yes`}),` to accept the command it displays.`]}),`\n`,_jsxs(_components.p,{children:[`You may also see plugins with `,_jsx(_components.strong,{children:`managed`}),` scope. These are installed by administrators via `,_jsx(_components.a,{href:`/en/managed-settings`,children:`managed settings`}),` and can’t be modified.`]}),`\n`,_jsx(_components.p,{children:`Claude Code looks the plugin up in its local copy of the marketplace catalog. How you name the plugin controls whether Claude Code refreshes that copy first:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`With a marketplace name`}),`: when you install `,_jsx(_components.code,{children:`plugin-name@marketplace-name`}),`, in a session or with `,_jsx(_components.code,{children:`claude plugin install`}),`, Claude Code refreshes that marketplace before the lookup. Claude Code runs the refresh even if you turned off `,_jsx(_components.a,{href:`#configure-auto-updates`,children:`auto-update`}),` for the marketplace or set `,_jsx(_components.code,{children:`DISABLE_AUTOUPDATER`}),`. Before v2.1.232, Claude Code didn’t refresh the marketplace before the lookup. Claude Code skips this refresh when:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`The marketplace wasn’t `,_jsx(_components.a,{href:`#add-marketplaces`,children:`added from GitHub, another Git host, or a remote URL`}),`.`]}),`\n`,_jsxs(_components.li,{children:[`A `,_jsx(_components.a,{href:`/en/plugin-marketplaces#pre-populate-plugins-for-containers`,children:`seed directory`}),` supplies the marketplace.`]}),`\n`,_jsx(_components.li,{children:`Claude Code refreshed the marketplace within the last 30 seconds.`}),`\n`,_jsxs(_components.li,{children:[`You set `,_jsx(_components.a,{href:`/en/env-vars`,children:_jsx(_components.code,{children:`CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC`})}),`.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`/en/plugin-marketplaces#managed-marketplace-restrictions`,children:`Managed settings`}),` block the marketplace, in which case Claude Code also refuses the install.`]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Plugin name only`}),`: when you run `,_jsx(_components.code,{children:`/plugin install plugin-name`}),` in a session, Claude Code refreshes only the marketplaces it also `,_jsx(_components.a,{href:`#configure-auto-updates`,children:`updates in the background`}),`, and only after the lookup misses. When you run `,_jsx(_components.code,{children:`claude plugin install plugin-name`}),`, Claude Code reads the cached catalogs without refreshing. To install a plugin that was published after your last refresh, run `,_jsx(_components.code,{children:`/plugin marketplace update \u003cmarketplace-name\u003e`}),` in a session or `,_jsx(_components.a,{href:`/en/plugin-marketplaces#plugin-marketplace-update`,children:_jsx(_components.code,{children:`claude plugin marketplace update \u003cmarketplace-name\u003e`})}),` in your shell, then retry the install.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`If the refresh before a named install fails, for example because you’re offline, Claude Code looks the plugin up in the cached catalog anyway. `,_jsx(_components.code,{children:`claude plugin install`}),` reports `,_jsx(_components.code,{children:`marketplace not refreshed`}),` in its success message, and `,_jsx(_components.code,{children:`/plugin install`}),` shows the failure above the plugin’s details or in its not-found message.`]}),`\n`,_jsxs(_components.p,{children:[`When you install from the `,_jsx(_components.code,{children:`/plugin`}),` interface, the install summary tells you whether the plugin is active in your current session:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`Plugin is now active.`}),`: Claude Code activated the plugin as part of the install.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.code,{children:`Run /reload-plugins to activate.`}),`: the plugin isn’t active yet, because activating it would `,_jsx(_components.a,{href:`/en/prompt-caching#enabling-or-disabling-a-plugin`,children:`invalidate the prompt cache`}),` or because the activation attempt failed. Run the command to activate the plugin.`]}),`\n`,_jsxs(_components.li,{children:[`If the plugin fails to load, the summary reports the failure and the `,_jsx(_components.code,{children:`/plugin`}),` `,_jsx(_components.strong,{children:`Errors`}),` tab shows the detail.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Before v2.1.221, no install took effect in the current session until you ran `,_jsx(_components.code,{children:`/reload-plugins`}),` or restarted.`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`claude plugin install`}),` shell command doesn’t run in a session, so Claude Code loads the plugins it installs the next time you start Claude Code, or when you run `,_jsx(_components.code,{children:`/reload-plugins`}),` in a session that’s already open.`]}),`\n`,_jsx(Warning,{children:_jsx(_components.p,{children:`Make sure you trust a plugin before installing it. Anthropic doesn’t control what MCP servers, files, or other software are included in plugins and can’t verify that they work as intended. Check each plugin’s homepage for more information.`})}),`\n`,_jsx(Heading,{level:`2`,id:`manage-installed-plugins`,children:`Manage installed plugins`}),`\n`,_jsxs(_components.p,{children:[`Run `,_jsx(_components.code,{children:`/plugin`}),` and go to the `,_jsx(_components.strong,{children:`Installed`}),` tab to view, enable, disable, or uninstall your plugins. The list is grouped by scope and sorted so you see problems first: plugins with load errors or unresolved dependencies appear at the top, followed by your favorites, with disabled plugins folded behind a collapsed header at the bottom.`]}),`\n`,_jsx(_components.p,{children:`From the list you can:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`press `,_jsx(_components.code,{children:`f`}),` to favorite or unfavorite the selected plugin`]}),`\n`,_jsx(_components.li,{children:`type to filter by plugin name or description`}),`\n`,_jsx(_components.li,{children:`press Enter to open a plugin’s detail view and enable, disable, or uninstall it`}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`When you uninstall a plugin that a project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` enables, Claude Code asks which scope you mean: disable it for you alone, which writes an override to your `,_jsx(_components.code,{children:`.claude/settings.local.json`}),` and leaves the plugin installed for the project, or uninstall it for everyone, which removes it from the shared `,_jsx(_components.code,{children:`.claude/settings.json`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`The detail view shows the components the plugin contributes: commands, skills, agents, hooks, MCP servers, and LSP servers. The same inventory is available from the command line with `,_jsx(_components.code,{children:`claude plugin details`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code also lists marketplace plugins you installed yourself but haven’t used in at least two weeks, over a span of at least 10 sessions, under a `,_jsx(_components.strong,{children:`Not used recently`}),` header in the `,_jsx(_components.strong,{children:`Installed`}),` tab. The detail view shows a `,_jsx(_components.strong,{children:`Last used`}),` line for each plugin. Use these to find plugins that still add startup and context cost even though you no longer use them, then disable or uninstall them.`]}),`\n`,_jsx(_components.p,{children:`Two kinds of plugins are never listed as unused:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`plugins that your organization manages or that you load with `,_jsx(_components.code,{children:`--plugin-dir`})]}),`\n`,_jsx(_components.li,{children:`plugins that contribute a theme, output style, monitor, or workflow, since those deliver value without an invocation to track`}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.strong,{children:`Not used recently`}),` header and the `,_jsx(_components.strong,{children:`Last used`}),` line are both hidden when your organization restricts marketplaces with `,_jsx(_components.a,{href:`/en/settings-reference#strictknownmarketplaces`,children:_jsx(_components.code,{children:`strictKnownMarketplaces`})}),`.`]}),`\n`,_jsxs(_components.p,{children:[`A plugin’s `,_jsx(_components.a,{href:`/en/plugins#add-lsp-servers-to-your-plugin`,children:`language server`}),` counts as used when it delivers diagnostics or answers a code navigation request, so an LSP plugin whose server is active in your sessions isn’t listed as unused. Before v2.1.203, language server activity couldn’t be counted as use, so plugins that contribute an LSP server were exempt from the group entirely, the same way theme and output style plugins still are.`]}),`\n`,_jsx(_components.p,{children:`The first session on a version that counts language server activity also resets the usage record of each LSP plugin that hadn’t recorded any use yet, so Claude Code doesn’t judge a plugin you installed earlier as unused based on data recorded before its server activity was tracked.`}),`\n`,_jsx(_components.p,{children:`When you install a plugin that declares dependencies, the install output lists which dependencies were auto-installed alongside it.`}),`\n`,_jsx(_components.p,{children:`You can also manage plugins with direct commands:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[`When you run `,_jsx(_components.code,{children:`/plugin disable`}),`, `,_jsx(_components.code,{children:`/plugin enable`}),`, or `,_jsx(_components.code,{children:`/plugin uninstall`}),`, Claude Code opens the plugin panel to apply the change and leaves it open. Press `,_jsx(_components.strong,{children:`Esc`}),` to close the panel before typing another command.`]}),`\n`,_jsxs(_components.li,{children:[`For scripting, use the `,_jsx(_components.code,{children:`claude plugin`}),` shell commands instead, which don’t open the panel.`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`List installed plugins without opening the menu:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` list`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`Pass `,_jsx(_components.code,{children:`--enabled`}),` or `,_jsx(_components.code,{children:`--disabled`}),` to show only plugins in that state.`]}),`\n`,_jsx(_components.p,{children:`Disable a plugin without uninstalling:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` disable`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` plugin-name@marketplace-name`})]}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`Re-enable a disabled plugin:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` enable`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` plugin-name@marketplace-name`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`In these identifiers, `,_jsx(_components.code,{children:`plugin-name`}),` is the plugin’s `,_jsx(_components.code,{children:`name`}),` in the `,_jsx(_components.a,{href:`/en/plugin-marketplaces#plugin-entries`,children:`marketplace entry`}),`, which can differ from the `,_jsx(_components.code,{children:`name`}),` in the plugin’s own `,_jsx(_components.code,{children:`plugin.json`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`As of Claude Code v2.1.195, `,_jsx(_components.strong,{children:`Enable`}),` and `,_jsx(_components.strong,{children:`Disable`}),` in the `,_jsx(_components.code,{children:`/plugin`}),` interface work for plugins whose two names differ, and `,_jsx(_components.code,{children:`/plugin enable`}),` and `,_jsx(_components.code,{children:`/plugin disable`}),` accept either name. When you disable such a plugin in an earlier version, Claude Code reports `,_jsx(_components.code,{children:`already disabled`}),` and leaves it enabled.`]}),`\n`,_jsx(_components.p,{children:`Completely remove a plugin:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` uninstall`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` plugin-name@marketplace-name`})]}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`The `,_jsx(_components.code,{children:`--scope`}),` option lets you target a specific scope with CLI commands:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` install`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` formatter@your-org`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --scope`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` project`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`claude`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` uninstall`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` formatter@your-org`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:` --scope`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` project`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`apply-plugin-changes-without-restarting`,children:`Apply plugin changes without restarting`}),`\n`,_jsxs(_components.p,{children:[`When the `,_jsx(_components.a,{href:`#install-plugins`,children:`install summary`}),` reports `,_jsx(_components.code,{children:`Plugin is now active.`}),`, Claude Code already activated the plugin, and you can skip this step. For everything else, plugins you enabled or disabled during the session and installs whose summary reports `,_jsx(_components.code,{children:`Run /reload-plugins to activate.`}),`, apply all changes without restarting:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/reload-plugins`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`When the reload would invalidate the prompt cache, the command warns and skips until you rerun it with `,_jsx(_components.code,{children:`--force`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code reloads all active plugins and shows counts for plugins, skills, agents, hooks, plugin MCP servers, and plugin LSP servers. The skills count covers only each plugin’s `,_jsx(_components.code,{children:`commands/`}),` directory, not its `,_jsx(_components.code,{children:`skills/`}),` directory, so the summary can report `,_jsx(_components.code,{children:`0 skills`}),` even when the plugin’s skills reloaded.`]}),`\n`,_jsxs(_components.p,{children:[`Reloading has a token cost on the next request: newly loaded components announce themselves in content appended to the conversation, while the existing history still reads from the prompt cache. A plugin that provides MCP servers costs more when its tools aren’t deferred by `,_jsx(_components.a,{href:`/en/mcp#scale-with-mcp-tool-search`,children:`tool search`}),`: the change invalidates the cache and the next request re-reads the entire conversation. See `,_jsx(_components.a,{href:`/en/prompt-caching#enabling-or-disabling-a-plugin`,children:`enabling or disabling a plugin`}),` for details.`]}),`\n`,_jsx(Heading,{level:`2`,id:`manage-marketplaces`,children:`Manage marketplaces`}),`\n`,_jsxs(_components.p,{children:[`You can manage marketplaces through the interactive `,_jsx(_components.code,{children:`/plugin`}),` interface or with CLI commands.`]}),`\n`,_jsx(Heading,{level:`3`,id:`use-the-interactive-interface`,children:`Use the interactive interface`}),`\n`,_jsxs(_components.p,{children:[`Run `,_jsx(_components.code,{children:`/plugin`}),` and go to the `,_jsx(_components.strong,{children:`Marketplaces`}),` tab to:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`View all your added marketplaces with their sources and status`}),`\n`,_jsx(_components.li,{children:`Add new marketplaces`}),`\n`,_jsx(_components.li,{children:`Update marketplace listings to fetch the latest plugins`}),`\n`,_jsx(_components.li,{children:`Remove marketplaces you no longer need`}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`use-cli-commands`,children:`Use CLI commands`}),`\n`,_jsx(_components.p,{children:`You can also manage marketplaces with direct commands.`}),`\n`,_jsx(_components.p,{children:`List all configured marketplaces:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` marketplace`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` list`})]}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`Refresh plugin listings from a marketplace:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` marketplace`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` update`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` marketplace-name`})]}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`Remove a marketplace:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`1`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`1`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:`/plugin`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` marketplace`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` remove`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` marketplace-name`})]}),`\n`]})})}),`\n`,_jsx(Warning,{children:_jsx(_components.p,{children:`Removing a marketplace will uninstall any plugins you installed from it.`})}),`\n`,_jsx(Heading,{level:`3`,id:`configure-auto-updates`,children:`Configure auto-updates`}),`\n`,_jsx(_components.p,{children:`Claude Code can automatically update marketplaces and their installed plugins in the background after startup. When auto-update is enabled for a marketplace, Claude Code refreshes the marketplace data and updates installed plugins to their latest versions on disk.`}),`\n`,_jsxs(_components.p,{children:[`Claude Code checks for marketplace and plugin updates after your session starts, with a random delay of up to ten minutes, so the running session keeps using the versions it loaded at launch. If any plugins were updated, you’ll see a notification prompting you to run `,_jsx(_components.code,{children:`/reload-plugins`}),`, or the new versions load on your next launch.`]}),`\n`,_jsxs(_components.p,{children:[`Claude Code updates plugins that have a `,_jsxs(_components.a,{href:`/en/plugin-marketplaces#command-sources`,children:[_jsx(_components.code,{children:`command`}),` source`]}),` on a separate cadence from the marketplace auto-update setting and from `,_jsx(_components.code,{children:`DISABLE_AUTOUPDATER`}),`. Instead, it `,_jsx(_components.a,{href:`/en/plugin-marketplaces#when-claude-code-re-runs-the-command`,children:`re-runs the command once per session`}),` and installs the output as a new plugin version when its `,_jsx(_components.a,{href:`/en/plugins-reference#version-management`,children:`hash`}),` has changed.`]}),`\n`,_jsx(_components.p,{children:`Toggle auto-update for individual marketplaces through the UI:`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[`Run `,_jsx(_components.code,{children:`/plugin`}),` to open the plugin manager`]}),`\n`,_jsxs(_components.li,{children:[`Select `,_jsx(_components.strong,{children:`Marketplaces`})]}),`\n`,_jsx(_components.li,{children:`Choose a marketplace from the list`}),`\n`,_jsxs(_components.li,{children:[`Select `,_jsx(_components.strong,{children:`Enable auto-update`}),` or `,_jsx(_components.strong,{children:`Disable auto-update`})]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`claude-plugins-official`}),` and most other official Anthropic marketplaces have auto-update enabled by default. Third-party and local development marketplaces have auto-update disabled by default.`]}),`\n`,_jsxs(_components.p,{children:[`Administrators can also set `,_jsx(_components.code,{children:`\"autoUpdate\": true`}),` on each `,_jsx(_components.a,{href:`/en/settings-reference#extraknownmarketplaces`,children:_jsx(_components.code,{children:`extraKnownMarketplaces`})}),` entry in managed settings to enable auto-update for an organization marketplace without requiring each user to toggle it.`]}),`\n`,_jsxs(_components.p,{children:[`To disable automatic updates for Claude Code and for plugins fetched from marketplaces, set the `,_jsx(_components.code,{children:`DISABLE_AUTOUPDATER`}),` environment variable. Plugins with a `,_jsxs(_components.a,{href:`/en/plugin-marketplaces#command-sources`,children:[_jsx(_components.code,{children:`command`}),` source`]}),` follow their own once-per-session re-resolve. See `,_jsx(_components.a,{href:`/en/setup#auto-updates`,children:`Auto updates`}),` for details.`]}),`\n`,_jsxs(_components.p,{children:[`To keep plugin auto-updates enabled while disabling Claude Code auto-updates, set `,_jsx(_components.code,{children:`FORCE_AUTOUPDATE_PLUGINS=1`}),` along with `,_jsx(_components.code,{children:`DISABLE_AUTOUPDATER`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`2`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`2`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`export`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:` DISABLE_AUTOUPDATER`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#569CD6`},children:`export`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:` FORCE_AUTOUPDATE_PLUGINS`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`1`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`2`,id:`configure-team-marketplaces`,children:`Configure team marketplaces`}),`\n`,_jsxs(_components.p,{children:[`Team admins can set up automatic marketplace installation for projects by adding marketplace configuration to `,_jsx(_components.code,{children:`.claude/settings.json`}),`. Once a team member `,_jsx(_components.a,{href:`/en/permissions#what-runs-before-you-trust-a-folder`,children:`trusts the repository folder`}),`, Claude Code adds these marketplaces without a further prompt.`]}),`\n`,_jsxs(_components.p,{children:[`As of Claude Code v2.1.195, adding the marketplace doesn’t install plugins that come from an external source, on any path that loads plugins. A plugin that only the project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),` enables, and that comes from an external source such as a GitHub repository or npm package, doesn’t load until the team member installs it. Until then, Claude Code reports the plugin as not installed and shows the `,_jsx(_components.code,{children:`claude plugin install`}),` command to run.`]}),`\n`,_jsxs(_components.p,{children:[`Add `,_jsx(_components.code,{children:`extraKnownMarketplaces`}),` to your project’s `,_jsx(_components.code,{children:`.claude/settings.json`}),`:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`10`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`10`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"extraKnownMarketplaces\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"my-team-tools\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`      \"source\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`        \"source\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"github\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`        \"repo\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"your-org/claude-plugins\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`      }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`    }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  }`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsxs(_components.p,{children:[`For full configuration options including `,_jsx(_components.code,{children:`extraKnownMarketplaces`}),` and `,_jsx(_components.code,{children:`enabledPlugins`}),`, see `,_jsx(_components.a,{href:`/en/settings-reference#plugin-settings`,children:`Plugin settings`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`security`,children:`Security`}),`\n`,_jsxs(_components.p,{children:[`Plugins and marketplaces are highly trusted components that can execute arbitrary code on your machine with your user privileges. Only install plugins and add marketplaces from sources you trust. Organizations can restrict which marketplaces users are allowed to add using `,_jsx(_components.a,{href:`/en/plugin-marketplaces#managed-marketplace-restrictions`,children:`managed marketplace restrictions`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`troubleshooting`,children:`Troubleshooting`}),`\n`,_jsx(Heading,{level:`3`,id:`/plugin-command-not-recognized`,children:`/plugin command not recognized`}),`\n`,_jsxs(_components.p,{children:[`If you see “unknown command” or the `,_jsx(_components.code,{children:`/plugin`}),` command doesn’t appear:`]}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Check your version`}),`: run `,_jsx(_components.code,{children:`claude --version`}),` to see what’s installed.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Update Claude Code`}),`:`,`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Homebrew`}),`: `,_jsx(_components.code,{children:`brew upgrade claude-code`}),`, or `,_jsx(_components.code,{children:`brew upgrade claude-code@latest`}),` if you installed that cask`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`npm`}),`: `,_jsx(_components.code,{children:`npm install -g @anthropic-ai/claude-code@latest`})]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Native installer`}),`: re-run the install command from `,_jsx(_components.a,{href:`/en/setup`,children:`Setup`})]}),`\n`]}),`\n`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Restart Claude Code`}),`: after updating, restart your terminal and run `,_jsx(_components.code,{children:`claude`}),` again.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`3`,id:`common-issues`,children:`Common issues`}),`\n`,_jsxs(_components.p,{children:[`If plugin skills don’t appear, clear the cache with `,_jsx(_components.code,{children:`rm -rf ~/.claude/plugins/cache`}),`, restart Claude Code, and reinstall the plugin.`]}),`\n`,_jsxs(_components.p,{children:[`For detailed troubleshooting with solutions, see `,_jsx(_components.a,{href:`/en/plugin-marketplaces#troubleshooting`,children:`Troubleshooting`}),` in the marketplace guide. For debugging tools, see `,_jsx(_components.a,{href:`/en/plugins-reference#debugging-and-development-tools`,children:`Debugging and development tools`}),`.`]}),`\n`,_jsx(Heading,{level:`3`,id:`code-intelligence-issues`,children:`Code intelligence issues`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Language server not starting`}),`: verify the binary is installed and available in your `,_jsx(_components.code,{children:`$PATH`}),`. Check the `,_jsx(_components.code,{children:`/plugin`}),` Errors tab for details.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`High memory usage`}),`: language servers like `,_jsx(_components.code,{children:`rust-analyzer`}),` and `,_jsx(_components.code,{children:`pyright`}),` can consume significant memory on large projects. If you experience memory issues, disable the plugin with `,_jsx(_components.code,{children:`/plugin disable \u003cplugin-name\u003e`}),` and rely on Claude’s built-in search tools instead.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`False positive diagnostics in monorepos`}),`: language servers may report unresolved import errors for internal packages if the workspace isn’t configured correctly. These don’t affect Claude’s ability to edit code.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`next-steps`,children:`Next steps`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Build your own plugins`}),`: see `,_jsx(_components.a,{href:`/en/plugins`,children:`Plugins`}),` to create skills, agents, and hooks`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Create a marketplace`}),`: see `,_jsx(_components.a,{href:`/en/plugin-marketplaces`,children:`Create a plugin marketplace`}),` to distribute plugins to your team or community`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Technical reference`}),`: see `,_jsx(_components.a,{href:`/en/plugins-reference`,children:`Plugins reference`}),` for complete specifications`]}),`\n`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"5c:[\"$\",\"$L61\",null,{\"slug\":\"en/discover-plugins\",\"pageMetadata\":\"$4f:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L62\",null,{\"mdxSource\":{\"compiledSource\":\"$63\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"Discover and install prebuilt plugins through marketplaces\",\"sidebarTitle\":\"Discover and install prebuilt plugins\",\"description\":\"Find and install plugins from marketplaces to extend Claude Code with new skills, agents, and capabilities.\",\"href\":\"/en/discover-plugins\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"code.claude.com/docs\"}]}]\n"])</script></body></html>