	/* Tracking (letter-spacing) */
	--track-display: -0.02em;
	--track-head: 0em;
	--track-subhead: 0em;
	--track-body: 0em;
	--track-cta: 0em;

	/* Leading (line-height) */
	--lh-display: 0.90;
	--lh-head: 1.00;
	--lh-subhead: 1.10;
	--lh-body: 1.30;
	--lh-cta: 1.40;
}

html,
body {
	font-family: "GT Pantheon Micro", ui-sans-serif, system-ui, -apple-system,
		"Segoe UI", Roboto, Arial, sans-serif;
}

h1,
h2 {
	font-weight: 500;
	letter-spacing: var(--track-head);
	line-height: var(--lh-head);
}

p,
li {
	font-weight: 400;
	letter-spacing: var(--track-body);
	line-height: var(--lh-body);
}

/* Role utilities (sizes intentionally omitted per PDF) */
.text-display {
	font-family: "GT Pantheon Micro", ui-sans-serif, system-ui, -apple-system,
		"Segoe UI", Roboto, Arial, sans-serif;
	font-weight: 500;
	letter-spacing: var(--track-display);
	line-height: var(--lh-display);
}

.text-h1,
.text-h2 {
	font-family: "GT Pantheon Micro", ui-sans-serif, system-ui, -apple-system,
		"Segoe UI", Roboto, Arial, sans-serif;
	font-weight: 500;
	letter-spacing: var(--track-head);
	line-height: var(--lh-head);
}

.text-subhead {
	font-family: "GT Pantheon Micro", ui-sans-serif, system-ui, -apple-system,
		"Segoe UI", Roboto, Arial, sans-serif;
	font-weight: 500;
	letter-spacing: var(--track-subhead);
	line-height: var(--lh-subhead);
}

.text-body {
	font-family: "GT Pantheon Micro", ui-sans-serif, system-ui, -apple-system,
		"Segoe UI", Roboto, Arial, sans-serif;
	font-weight: 400;
	letter-spacing: var(--track-body);
