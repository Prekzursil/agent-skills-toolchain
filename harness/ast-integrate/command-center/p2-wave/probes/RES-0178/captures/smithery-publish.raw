":\"book-open\",\"description\":\"Smithery gives agents more agency by connecting them to the outside world — search the web, query databases, control browsers, reach into business tools, and much more.\",\"href\":\"/index\"}]},{\"group\":\"Connect\",\"pages\":[{\"title\":\"Connect to MCPs\",\"description\":\"Manage MCP connections with a simple REST API - OAuth, tokens, and sessions handled for you.\",\"icon\":\"plug-zap\",\"href\":\"/use/connect\"},{\"title\":\"Uplink\",\"description\":\"Expose a local MCP server as a Smithery connection without deploying it.\",\"icon\":\"cable\",\"href\":\"/use/uplink\"},{\"title\":\"Token Scoping\",\"description\":\"Control which connections and operations a token can access — by user, workspace, or any custom dimension.\",\"icon\":\"shield\",\"href\":\"/use/token-scoping\"},{\"title\":\"Deep Linking\",\"description\":\"Deep links provide a seamless way to integrate Smithery MCPs into supported clients.\",\"icon\":\"link\",\"href\":\"/use/deep-linking\"},{\"title\":\"Listing Your Client\",\"icon\":\"list\",\"description\":\"Get your MCP client listed on Smithery for easy discovery and installation by end users\",\"href\":\"/use/listing_your_client\"}]},{\"group\":\"Publish\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Publish your MCP servers on Smithery for distribution and analytics.\",\"icon\":\"binoculars\",\"href\":\"/build/index\"},{\"title\":\"Publish\",\"description\":\"Publish your MCP server on Smithery for distribution and analytics.\",\"icon\":\"rocket\",\"href\":\"/build/publish\"},{\"title\":\"Triggers\",\"description\":\"Expose events from your MCP server so consumers can receive them as webhooks.\",\"icon\":\"radio\",\"href\":\"/build/triggers\"}]},{\"group\":\"Integrations\",\"pages\":[{\"title\":\"Vercel AI SDK Integration\",\"description\":\"Integrate MCP servers with Vercel AI SDK using Smithery\",\"href\":\"/integrations/vercel_ai_sdk\"}]},{\"group\":\"Concepts\",\"pages\":[{\"title\":\"What is MCP?\",\"description\":\"What is MCP? How does it work? What does Smithery do with MCP?\",\"href\":\"/concepts/what_is_mcp\"},{\"title\":\"Namespaces\",\"description\":\"Namespaces group your servers, connections, and skills under a shared identifier.\",\"href\":\"/concepts/namespaces\"},{\"title\":\"Smithery CLI\",\"description\":\"Use the Smithery CLI to search, connect, and manage MCP servers and skills from the command line.\",\"href\":\"/concepts/cli\"}]},{\"group\":\"Cookbooks\",\"pages\":[{\"title\":\"Build an OAuth-compatible client\",\"description\":\"How to build an OAuth client in Typescript using Next.js\",\"href\":\"/cookbooks/typescript_oauth_client\"}]},{\"group\":\"API Reference\",\"pages\":[{\"group\":\"API Reference\",\"pages\":[{\"title\":\"Health check\",\"description\":\"Check if the service is running\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /health\",\"href\":\"/api-reference/health-check\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"servers\",\"pages\":[{\"title\":\"Get a server\",\"description\":\"Retrieve server details including connections, tools, and security status.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}\",\"href\":\"/api-reference/servers/get-a-server\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a server\",\"description\":\"Create a new server. Idempotent — returns success if the server already exists and is owned by the caller.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /servers/{qualifiedName}\",\"href\":\"/api-reference/servers/create-a-server\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a server\",\"description\":\"Permanently delete a server, its releases, and associated resources.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /servers/{qualifiedName}\",\"href\":\"/api-reference/servers/delete-a-server\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a server\",\"description\":\"Update server metadata such as display name, description, repository, icon, or visibility.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml patch /servers/{qualifiedName}\",\"href\":\"/api-reference/servers/update-a-server\",\"autogeneratedByOpenApi\":true},{\"title\":\"Transfer a server\",\"description\":\"Move a server to another namespace. The caller must have server write access to both the source namespace and the destination namespace.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /servers/{qualifiedName}/transfer\",\"href\":\"/api-reference/servers/transfer-a-server\",\"autogeneratedByOpenApi\":true},{\"title\":\"Download server bundle\",\"description\":\"Download the MCPB bundle for the latest successful stdio release.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/download\",\"href\":\"/api-reference/servers/download-server-bundle\",\"autogeneratedByOpenApi\":true},{\"title\":\"List releases\",\"description\":\"List releases ordered by most recent first. Logs are omitted — fetch a specific release to see logs.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/releases\",\"href\":\"/api-reference/servers/list-releases\",\"autogeneratedByOpenApi\":true},{\"title\":\"Publish a server\",\"description\":\"Submit a release via multipart form. Supports hosted (JS module upload), external (URL), and stdio (MCPB bundle) release types.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /servers/{qualifiedName}/releases\",\"href\":\"/api-reference/servers/publish-a-server\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a release\",\"description\":\"Retrieve release details including status, git metadata, pipeline logs, and MCP endpoint URL.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/releases/{id}\",\"href\":\"/api-reference/servers/get-a-release\",\"autogeneratedByOpenApi\":true},{\"title\":\"Stream release logs\",\"description\":\"Real-time SSE stream of release logs and status updates.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/releases/{id}/stream\",\"href\":\"/api-reference/servers/stream-release-logs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Resume a release\",\"description\":\"Resume a paused release (e.g. after OAuth authorization). Use id='latest' to resume the most recent one.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /servers/{qualifiedName}/releases/{id}/resume\",\"href\":\"/api-reference/servers/resume-a-release\",\"autogeneratedByOpenApi\":true},{\"title\":\"List runtime logs\",\"description\":\"Fetch recent runtime logs grouped by invocation.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/logs\",\"href\":\"/api-reference/servers/list-runtime-logs\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get server icon\",\"description\":\"Retrieve the server's icon image. Returns the image directly with appropriate content type.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/icon\",\"href\":\"/api-reference/servers/get-server-icon\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upload server icon\",\"description\":\"Upload or replace the server icon. Accepts a single image file via multipart/form-data. Max 1MB. Supported formats: PNG, JPEG, GIF, SVG, WebP.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /servers/{qualifiedName}/icon\",\"href\":\"/api-reference/servers/upload-server-icon\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete server icon\",\"description\":\"Remove the server's icon.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /servers/{qualifiedName}/icon\",\"href\":\"/api-reference/servers/delete-server-icon\",\"autogeneratedByOpenApi\":true},{\"title\":\"Infer a tool output schema\",\"description\":\"Infer a best-effort Zod schema from recent successful Tinybird tool outputs. All discovered object fields are marked optional.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers/{qualifiedName}/experimental/tools/{toolName}/output-schema\",\"href\":\"/api-reference/servers/infer-a-tool-output-schema\",\"autogeneratedByOpenApi\":true},{\"title\":\"List all servers\",\"description\":\"Search and browse public MCP servers in the Smithery registry. Supports full-text and semantic search via the `q` parameter, and filtering by deployment status, verification, ownership, and more.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /servers\",\"href\":\"/api-reference/servers/list-all-servers\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"domains\",\"pages\":[]},{\"group\":\"skills\",\"pages\":[{\"title\":\"List or search skills\",\"description\":\"Search and browse reusable prompt-based skills. Supports full-text and semantic search via the `q` parameter, and filtering by category, namespace, or slug.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /skills\",\"href\":\"/api-reference/skills/list-or-search-skills\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a new skill (deprecated)\",\"description\":\"**Deprecated:** Use PUT /skills/{namespace}/{slug} instead. Create a new skill by linking a GitHub repository containing a SKILL.md file.\",\"deprecated\":true,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /skills\",\"href\":\"/api-reference/skills/create-a-new-skill-deprecated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a skill\",\"description\":\"Get a single skill by its namespace and slug.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /skills/{namespace}/{slug}\",\"href\":\"/api-reference/skills/get-a-skill\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create or update a skill\",\"description\":\"Idempotent endpoint to create or update a GitHub-backed skill. Send application/json with `gitUrl`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /skills/{namespace}/{slug}\",\"href\":\"/api-reference/skills/create-or-update-a-skill\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a skill\",\"description\":\"Delete a skill by namespace and slug. Requires ownership of the namespace.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /skills/{namespace}/{slug}\",\"href\":\"/api-reference/skills/delete-a-skill\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"tokens\",\"pages\":[{\"title\":\"Create a service token\",\"description\":\"Create a service token for machine-to-machine authentication. Accepts API key or bearer token. Optionally apply restrictions.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /tokens\",\"href\":\"/api-reference/tokens/create-a-service-token\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"namespaces\",\"pages\":[{\"title\":\"Get user's namespaces or search namespaces\",\"description\":\"When called without query params, returns the authenticated user's namespaces (backwards compatible). When query params are provided, searches public namespaces with pagination. Use ownerId to filter by owner, hasServers/hasSkills to filter by content, q for text search.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /namespaces\",\"href\":\"/api-reference/namespaces/get-users-namespaces-or-search-namespaces\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a new namespace with generated name\",\"description\":\"Create a new namespace with a server-generated human-readable name, owned by the authenticated user\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /namespaces\",\"href\":\"/api-reference/namespaces/create-a-new-namespace-with-generated-name\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a new namespace\",\"description\":\"Create a new namespace owned by the authenticated user or an organization. This endpoint is idempotent - if the namespace already exists and is owned by the user/org, returns success. Pass organizationId in the request body to create an org-owned namespace.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /namespaces/{name}\",\"href\":\"/api-reference/namespaces/create-a-new-namespace\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a namespace\",\"description\":\"Delete a namespace owned by the authenticated user. The namespace must not contain any servers. Skills and connections in the namespace will be deleted automatically.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /namespaces/{name}\",\"href\":\"/api-reference/namespaces/delete-a-namespace\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a server under a namespace (deprecated)\",\"description\":\"**Deprecated:** Use PUT /servers/{namespace}/{server} instead. Create a new server under the specified namespace. This endpoint is idempotent.\",\"deprecated\":true,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /namespaces/{namespace}/servers/{server}\",\"href\":\"/api-reference/namespaces/create-a-server-under-a-namespace-deprecated\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"organizations\",\"pages\":[{\"title\":\"List team API keys\",\"description\":\"Returns all API keys belonging to the organization. Requires admin role. Key values are not included in the response.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /organizations/{orgId}/api-keys\",\"href\":\"/api-reference/organizations/list-team-api-keys\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a team API key\",\"description\":\"Creates an API key owned by the organization. Requires admin role.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /organizations/{orgId}/api-keys\",\"href\":\"/api-reference/organizations/create-a-team-api-key\",\"autogeneratedByOpenApi\":true},{\"title\":\"Revoke a team API key\",\"description\":\"Deletes an API key belonging to the organization. Requires admin role.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /organizations/{orgId}/api-keys/{keyId}\",\"href\":\"/api-reference/organizations/revoke-a-team-api-key\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"connect\",\"pages\":[{\"title\":\"List connections\",\"description\":\"List all connections in a namespace. Supports filtering by metadata using `metadata.{key}={value}` query params.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}\",\"href\":\"/api-reference/connect/list-connections\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create connection\",\"description\":\"Create a new MCP connection with an auto-generated ID. Requires API key and namespace ownership.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /connect/{namespace}\",\"href\":\"/api-reference/connect/create-connection\",\"autogeneratedByOpenApi\":true},{\"title\":\"List triggers\",\"description\":\"List trigger types exposed by a connection.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}/{connectionId}/.triggers\",\"href\":\"/api-reference/connect/list-triggers\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get trigger\",\"description\":\"Get the schema for a single trigger type.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}/{connectionId}/.triggers/{triggerName}\",\"href\":\"/api-reference/connect/get-trigger\",\"autogeneratedByOpenApi\":true},{\"title\":\"Subscribe to trigger\",\"description\":\"Subscribe to (or refresh) a trigger. Supplying the same (params, delivery.url) refreshes the TTL and may rotate the secret.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /connect/{namespace}/{connectionId}/.triggers/{triggerName}\",\"href\":\"/api-reference/connect/subscribe-to-trigger\",\"autogeneratedByOpenApi\":true},{\"title\":\"Unsubscribe from trigger\",\"description\":\"Unsubscribe by subscription key (params + delivery.url). Eager teardown — subscriptions also expire naturally on TTL.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /connect/{namespace}/{connectionId}/.triggers/{triggerName}\",\"href\":\"/api-reference/connect/unsubscribe-from-trigger\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get connection\",\"description\":\"Get details for a specific connection. Requires service token with connections:read scope.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}/{connectionId}\",\"href\":\"/api-reference/connect/get-connection\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create or update connection\",\"description\":\"Create or update an MCP connection with the given ID. `server` is the Smithery registry qualified name; `mcpUrl` is for custom MCP URLs. One of them is required when creating a new HTTP connection, but optional when updating. Returns 409 if a different target URL is provided, except while the connection is input_required and the new URL keeps the same host and path.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml put /connect/{namespace}/{connectionId}\",\"href\":\"/api-reference/connect/create-or-update-connection\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete connection\",\"description\":\"Delete a connection and terminate its MCP session. Requires API key and namespace ownership.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml delete /connect/{namespace}/{connectionId}\",\"href\":\"/api-reference/connect/delete-connection\",\"autogeneratedByOpenApi\":true},{\"title\":\"List tools across a namespace\",\"description\":\"List tools for every connection in a namespace in one response. Each connection is wrapped in an envelope so a failure on one upstream doesn't fail the request. Skips connections in `auth_required`/`input_required` states without calling the upstream.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}/.tools\",\"href\":\"/api-reference/connect/list-tools-across-a-namespace\",\"autogeneratedByOpenApi\":true},{\"title\":\"List tools\",\"description\":\"List tools exposed by a connection.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}/{connectionId}/.tools\",\"href\":\"/api-reference/connect/list-tools\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get tool\",\"description\":\"Get one tool or list tools under a slash-separated category.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml get /connect/{namespace}/{connectionId}/.tools/{toolPath}\",\"href\":\"/api-reference/connect/get-tool\",\"autogeneratedByOpenApi\":true},{\"title\":\"Call tool\",\"description\":\"Invoke a tool with JSON arguments.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://app.stainless.com/api/spec/documented/smithery/openapi.documented.yml post /connect/{namespace}/{connectionId}/.tools/{toolPath}\",\"href\":\"/api-reference/connect/call-tool\",\"autogeneratedByOpenApi\":true}]}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L4b\"}]\n"])</script><script>self.__next_f.push([1,"4c:I[763509,[\"/docs/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/1ead5edfe5ae6eee.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/0890ba15c670d9b1.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/8778b596bb8e1fac.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/6eca5dd93b4850f1.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/3df48e92ab491c72.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/cfd727ba62f1c54c.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/95810dccb4b634b5.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/cc5fb492c7259b04.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/3e14be6f7db58aad.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/a919d558158c76f7.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/c7c9dfd26f25e785.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/29f5095e175973f9.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/0eb894a8519f24ea.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/ca8fe0ccebe75085.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/f48a8fa65184b0c7.js?dpl=dpl_DKsz4uvMQTpBZTvKv5tGvpXCq4CX\",\"/docs/_next/static/chunks/329