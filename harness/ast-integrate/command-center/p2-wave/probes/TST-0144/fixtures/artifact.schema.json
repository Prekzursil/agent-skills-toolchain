{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "id": {
      "minLength": 3,
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "payload": {
      "properties": {
        "label": {
          "type": "string"
        },
        "n": {
          "type": "integer"
        }
      },
      "required": [
        "label",
        "n"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "ok",
    "payload"
  ],
  "type": "object"
}
