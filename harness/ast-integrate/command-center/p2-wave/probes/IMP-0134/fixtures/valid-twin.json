{
  "id": "valid-twin",
  "workflow": {
    "id": "wf-valid-twin",
    "params": [
      {
        "name": "region",
        "type": "string",
        "required": true,
        "enum": ["us-east", "eu-west"]
      },
      {
        "name": "replicas",
        "type": "integer",
        "required": false,
        "default": 2
      },
      {
        "name": "token",
        "type": "secret_ref",
        "required": true
      }
    ]
  },
  "values": {
    "region": "eu-west",
    "replicas": "3",
    "token": {"env": "WF_TOKEN"}
  }
}
