{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/CNL-0026/note.schema.json",
  "title": "CNL-0026 council design note (local; global council-design-note.schema.json is absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "corruption_threshold",
    "spec_anchor",
    "tests",
    "reviewer",
    "negative_control",
    "evidence"
  ],
  "properties": {
    "unit_id": { "const": "CNL-0026" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "const": "SUCCESS:CNL-0026" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "corruption_threshold": {
      "type": "object",
      "required": ["value", "n_jurors", "computed_not_asserted", "method"],
      "properties": {
        "value": { "type": "integer", "minimum": 2 },
        "n_jurors": { "type": "integer", "minimum": 3 },
        "computed_not_asserted": { "const": true },
        "method": { "type": "string", "minLength": 16 }
      }
    },
    "spec_anchor": {
      "type": "object",
      "required": ["required_path", "present_on_this_estate", "live_restatements"],
      "properties": {
        "required_path": { "type": "string", "minLength": 16 },
        "present_on_this_estate": { "type": "boolean" },
        "live_restatements": { "type": "array", "minItems": 2 }
      }
    },
    "tests": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "executed_both_states"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string" },
        "independent": { "const": true },
        "executed_both_states": { "const": true }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["state_rejected", "check_does", "verbatim"],
      "properties": {
        "state_rejected": { "type": "string", "minLength": 8 },
        "check_does": { "type": "string", "minLength": 8 },
        "verbatim": { "type": "string", "minLength": 16 }
      }
    },
    "evidence": { "type": "array", "minItems": 3 }
  }
}
