{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WFA-0005 AuditReport (classification vocabulary)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "answer",
    "output_schema",
    "signals",
    "vocabulary",
    "catalog_stated_histogram",
    "signal_a",
    "signal_b",
    "adjudications",
    "vocabulary_deletions",
    "tests",
    "reviewer",
    "artifacts",
    "confirmations",
    "honesty"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0005" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0005" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0005" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "vocabulary_deletions": {
      "type": "array",
      "maxItems": 0
    }
  }
}
