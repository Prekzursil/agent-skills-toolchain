{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0019/note.schema.json",
  "title": "CNL-0019 design note (unit-local; shared schema is contended)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "claim_under_test",
    "declared_signal",
    "which_stops_the_round",
    "claims",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "strongest_surviving_counterargument"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0019" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0019" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "claim_under_test": { "type": "string", "minLength": 16 },
    "declared_signal": { "type": "object" },
    "which_stops_the_round": {
      "type": "object",
      "required": ["stops", "does_not_stop", "satisfy_quota_from_padding"],
      "properties": {
        "stops": { "type": "string", "minLength": 4 },
        "does_not_stop": { "type": "string", "minLength": 4 },
        "satisfy_quota_from_padding": { "type": "boolean", "const": false }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["REFUTED", "CONFIRMED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "kind", "claim"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "line": { "type": "integer", "minimum": 1 },
          "snippet": { "type": "string" },
          "kind": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "command": { "type": "string" },
          "verbatim_output": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rejects", "observed"],
        "properties": {
          "id": { "type": "string" },
          "rejects": { "type": "string" },
          "observed": { "type": "string" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "re_ran_both_states"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" },
        "re_ran_both_states": { "type": "boolean", "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "strongest_surviving_counterargument": { "type": "string", "minLength": 40 }
  }
}
