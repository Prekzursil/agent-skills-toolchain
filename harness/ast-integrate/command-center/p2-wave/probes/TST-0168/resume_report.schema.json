{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/TST-0168/resume_report.schema.json",
  "title": "TST-0168 in-flight dynamic fan-out resume report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "schema_version",
    "report_kind",
    "title",
    "question",
    "engine",
    "both_states",
    "race",
    "mutants",
    "evidence",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0168" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:TST-0168" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:TST-0168" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "report_kind": { "type": "string", "const": "resume_report" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "catalog_schema": { "type": "string" },
    "min_bytes_threshold": { "type": "integer", "minimum": 1024 },
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "catalog_named_path", "catalog_named_present", "api"],
      "properties": {
        "path": {
          "type": "string",
          "const": "tools/lib/handled_ledger.py"
        },
        "catalog_named_path": {
          "type": "string",
          "const": "tools/lib/handled-ledger.mjs"
        },
        "catalog_named_present": { "type": "boolean" },
        "api": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["ok", "before_fanout", "after_complete"],
      "properties": {
        "ok": { "type": "boolean", "const": true },
        "before_fanout": { "type": "object" },
        "after_complete": { "type": "object" },
        "gold": { "type": "object" },
        "first_spawn_tick": { "type": "integer" },
        "n_ticks": { "type": "integer" }
      }
    },
    "race": {
      "type": "object",
      "required": ["ok", "n", "ticks", "seed"],
      "properties": {
        "ok": { "type": "boolean", "const": true },
        "n": { "type": "integer", "const": 20 },
        "ticks": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": { "type": "integer" }
        },
        "seed": { "type": "integer", "const": 168 },
        "first_spawn_tick": { "type": "integer" },
        "last_receipt_tick": { "type": "integer" },
        "gold_ids": { "type": "array" },
        "rows": { "type": "array" }
      }
    },
    "mutants": {
      "type": "object",
      "required": ["ok", "skip_claim", "double_receipt", "silent_on_good"],
      "properties": {
        "ok": { "type": "boolean", "const": true },
        "skip_claim": { "type": "object" },
        "double_receipt": { "type": "object" },
        "silent_on_good": { "type": "object" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["signal", "claim", "verdict"],
        "properties": {
          "signal": { "type": "string" },
          "claim": { "type": "string" },
          "verdict": { "type": "string", "enum": ["CONFIRMED", "REFUTED"] },
          "anchor": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL"] },
          "command": { "type": "string" }
        }
      }
    },
    "negative_controls": { "type": "array" },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string" },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true },
        "notes": { "type": "string" }
      }
    },
    "named_probes": { "type": "array" },
    "cloud_ok": { "type": "boolean" },
    "registered": { "type": "boolean" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "role": { "type": "string" }
        }
      }
    }
  }
}
