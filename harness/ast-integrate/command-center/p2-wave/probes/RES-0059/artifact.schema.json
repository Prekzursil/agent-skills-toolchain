{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0059/artifact.schema.json",
  "title": "RES-0059 single-owner marketplace governance extraction",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "not_legal_advice",
    "question",
    "answer",
    "minimal_clause_set",
    "omitted_clauses",
    "claims",
    "rails",
    "reviewer",
    "owner_signoff"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0059" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 20 },
    "not_legal_advice": { "type": "boolean", "const": true },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "minimal_clause_set": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "text", "citations"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 16 },
          "citations": { "type": "array", "minItems": 1 }
        }
      }
    },
    "omitted_clauses": { "type": "array", "minItems": 1 },
    "claims": { "type": "array", "minItems": 2 },
    "rails": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "owner_signoff": {
      "type": "object",
      "required": ["required_before_downstream_action", "granted"],
      "properties": {
        "required_before_downstream_action": { "type": "boolean", "const": true },
        "granted": { "type": "boolean", "const": false }
      }
    }
  }
}
