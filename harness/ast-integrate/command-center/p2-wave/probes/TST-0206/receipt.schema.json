{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TST-0206 canary-seeded dual-scanner receipt (G-1)",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "evidence",
    "tests",
    "live_produced",
    "agreement",
    "detector_control",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "const": "TST-0206" },
    "state": { "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:TST-0206" },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": { "enum": ["CONFIRMED", "REFUTED"] },
          "anchor": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "const": "PASS" }
        }
      }
    },
    "live_produced": {
      "type": "object",
      "required": ["pattern_canary_hits", "entropy_canary_hits"],
      "properties": {
        "pattern_canary_hits": { "type": "integer", "const": 0 },
        "entropy_canary_hits": { "type": "integer", "const": 0 }
      }
    },
    "agreement": {
      "type": "object",
      "required": ["both_scanners_agree"],
      "properties": {
        "both_scanners_agree": { "const": true }
      }
    },
    "detector_control": {
      "type": "object",
      "required": ["pattern_canary_hits", "entropy_canary_hits"],
      "properties": {
        "pattern_canary_hits": { "type": "integer", "minimum": 1 },
        "entropy_canary_hits": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "verdict": { "const": "PASS" },
        "independent": { "const": true }
      }
    }
  }
}
