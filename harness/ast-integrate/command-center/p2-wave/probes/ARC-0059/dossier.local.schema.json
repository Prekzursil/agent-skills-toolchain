{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/ARC-0059/dossier.local.schema.json",
  "title": "ARC-0059 A9 maximal-hybrid dossier (executable local contract)",
  "$comment": "The catalog output_schema is a generated shim whose $ref does not resolve offline (RefResolutionError to ast-integrate.invalid). This local schema is the discriminator this unit actually runs: required hybrid fields, const ids, and garbage rejection. extra properties are allowed so the dossier can also carry receipt-shaped evidence.",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "architecture_id",
    "control_planes",
    "capability_to_authority_table",
    "borrowed_mechanisms",
    "report"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "ARC-0059" },
    "state": { "type": "string", "const": "SUCCESS" },
    "sentinel": { "type": "string", "const": "SUCCESS:ARC-0059" },
    "architecture_id": { "type": "string", "const": "A9" },
    "control_planes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "governs", "component"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^CP-" },
          "governs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "component": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capability_to_authority_table": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["capability_class", "authority", "authorities"],
        "properties": {
          "capability_class": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1, "pattern": "^CP-" },
          "authorities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "borrowed_mechanisms": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "architecture_id",
          "mechanism",
          "source_path",
          "source_section",
          "lands_in"
        ],
        "properties": {
          "architecture_id": {
            "type": "string",
            "pattern": "^A[1-8]$"
          },
          "mechanism": { "type": "string", "minLength": 8 },
          "source_path": { "type": "string", "minLength": 8 },
          "source_section": { "type": "string", "minLength": 4 },
          "lands_in": { "type": "string", "pattern": "^CP-" }
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["kind", "observations", "control_ids"],
      "properties": {
        "kind": { "type": "string", "const": "architecture-dossier" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "measured", "method", "anchor"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "measured": { "type": ["string", "number", "boolean"] },
              "method": { "type": "string", "minLength": 1 },
              "anchor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
