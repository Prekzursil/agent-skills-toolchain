   "index": 50,
   "name": "vendored-tree import isolation (shared interpreter stays clean)",
   "ci_command": "import importlib.util import sys GENERIC = (\"index\", \"engines\", \"evaluation\") leaked = [] for name in GENERIC: spec = importlib.util.find_spec(name) if spec is not None: leaked.append(f\"{name} -> {spec.origin}\") if leaked: print(\"Vendored generic top-level modules leaked into the SHARED interpreter:\") for entry in leaked: print(f\" {entry}\") print(\"Install that tree into its own venv (see the steps above), not this env.\") sys.exit(1) print(f\"OK: shared interpreter is clean of {GENERIC}.\")",
   "argv": [
