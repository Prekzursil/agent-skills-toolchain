{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNF-0098/macos-reachability.schema.json",
  "title": "CNF-0098 macOS reachability / proof-of-impossibility record",
  "description": "Executable contract for CNF-0098. Catalog path command-center/schema/impossibility-record.schema.json is a generated shim whose $ref is not resolvable offline and carries no unit constraints; this local schema is what both-states controls run against.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "macos_reachable",
    "this_host_darwin",
    "catalogue_macos",
    "hop_available",
    "missing_prerequisite",
    "classification",
    "two_signal_proof",
    "settling_experiment",
    "falsifier",
    "matrix_rows",
    "tests",
    "reviewers"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNF-0098" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "minLength": 40, "pattern": "^SUCCESS:CNF-0098" },
    "question": { "type": "string", "minLength": 40 },
    "macos_reachable": { "type": "boolean" },
    "this_host_darwin": { "type": "boolean" },
    "catalogue_macos": { "type": "boolean" },
    "hop_available": { "type": "boolean" },
    "missing_prerequisite": { "type": "string", "minLength": 8 },
    "classification": {
      "type": "string",
      "enum": [
        "platform-unreachable",
        "untested-claimed-supported",
        "single-signal-blocker"
      ]
    },
    "two_signal_proof": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "method", "observation", "fingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "enum": ["command", "file-read"] },
          "observation": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "minLength": 16 }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["method"],
            "properties": { "method": { "const": "command" } }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["method"],
            "properties": { "method": { "const": "file-read" } }
          }
        }
      ]
    },
    "settling_experiment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "procedure"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "procedure": { "type": "string", "minLength": 8 }
      }
    },
    "falsifier": { "type": "string", "minLength": 16 },
    "matrix_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "os", "declared_tier", "amended_tier", "evidence_state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "os": { "type": "string", "minLength": 1 },
          "declared_tier": { "type": "string", "minLength": 1 },
          "amended_tier": {
            "type": "string",
            "enum": ["tested-pass", "tested-fail", "untested"]
          },
          "evidence_state": {
            "type": "string",
            "enum": ["tested-pass", "tested-fail", "untested"]
          }
        }
      },
      "contains": {
        "type": "object",
        "required": ["os"],
        "properties": { "os": { "const": "macos" } }
      }
    },
    "tests": { "type": "array", "minItems": 3 },
    "reviewers": { "type": "array", "minItems": 2 }
  }
}
