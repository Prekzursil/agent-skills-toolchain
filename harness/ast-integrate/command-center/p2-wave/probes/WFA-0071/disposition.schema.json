{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/wfa-0071/disposition.schema.json",
  "title": "WFA-0071 RETIRE re-adjudication DispositionRecord",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "candidates",
    "terminal_retire_count",
    "files_deleted_by_this_unit",
    "controls",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "owner_signoff",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0071" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "candidates": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24
    },
    "terminal_retire_count": { "type": "integer", "minimum": 0 },
    "files_deleted_by_this_unit": {
      "type": "array",
      "maxItems": 0
    },
    "controls": { "type": "object" },
    "tests": { "type": "array", "minItems": 3 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["independent", "verdict"],
      "properties": {
        "independent": { "type": "boolean" },
        "verdict": { "type": "string" }
      }
    },
    "owner_signoff": {
      "type": "object",
      "required": ["required", "present", "terminal_dispositions_self_certified"],
      "properties": {
        "required": { "type": "boolean" },
        "present": { "type": "boolean" },
        "terminal_dispositions_self_certified": { "type": "integer", "const": 0 }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
