{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0057/regression_fixture.schema.json",
  "title": "WFA-0057 local RegressionFixture contract",
  "description": "Discriminating stand-in used because command-center/wfa/schema/wfa-schema-pack.json (WFA-0001) is absent on this worktree. additionalProperties is false; garbage documents must fail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "id",
    "state",
    "status",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "failure_class",
    "schema_version",
    "min_bytes_threshold",
    "output_schema",
    "local_contract",
    "wfa_pack_status",
    "dependency_status",
    "ir_node_kinds",
    "schema_assertion",
    "end_to_end",
    "both_states",
    "evidence",
    "tests",
    "reviewer",
    "residual_unknowns",
    "artifacts",
    "computed_not_asserted"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "RegressionFixture" },
    "unit_id": { "type": "string", "const": "WFA-0057" },
    "id": { "type": "string", "const": "WFA-0057" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "status": { "type": "string", "minLength": 4 },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0057" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0057" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "failure_class": { "type": "string", "minLength": 8 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "min_bytes_threshold": { "type": "integer", "minimum": 512 },
    "output_schema": { "type": "string", "minLength": 16 },
    "local_contract": { "type": "string", "minLength": 16 },
    "wfa_pack_status": { "type": "string", "minLength": 8 },
    "dependency_status": { "type": "object" },
    "ir_node_kinds": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 2 }
    },
    "schema_assertion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "anchor_required",
        "licence_class_required",
        "empty_string_rejected_as_firmly_as_missing",
        "kinds_tested",
        "missing_anchor_rejected",
        "empty_anchor_rejected"
      ],
      "properties": {
        "anchor_required": { "type": "boolean", "const": true },
        "licence_class_required": { "type": "boolean", "const": true },
        "empty_string_rejected_as_firmly_as_missing": { "type": "boolean", "const": true },
        "kinds_tested": { "type": "array", "minItems": 10 },
        "missing_anchor_rejected": { "type": "integer", "minimum": 10 },
        "empty_anchor_rejected": { "type": "integer", "minimum": 10 }
      }
    },
    "end_to_end": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "hops",
        "crossed_fusion_boundary",
        "native_anchor_count",
        "survived_every_hop",
        "licence_travelled_with_anchor"
      ],
      "properties": {
        "hops": { "type": "array", "minItems": 3 },
        "crossed_fusion_boundary": { "type": "boolean", "const": true },
        "native_anchor_count": { "type": "integer", "minimum": 2 },
        "survived_every_hop": { "type": "boolean", "const": true },
        "licence_travelled_with_anchor": { "type": "boolean", "const": true }
      }
    },
    "both_states": {
      "type": "object",
      "additionalProperties": true,
      "required": ["good_silent", "planted_missing_fires", "planted_empty_fires"],
      "properties": {
        "good_silent": { "type": "boolean", "const": true },
        "planted_missing_fires": { "type": "boolean", "const": true },
        "planted_empty_fires": { "type": "boolean", "const": true }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "residual_unknowns": {
      "type": "array",
      "items": { "type": "object" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "role": { "type": "string" }
        }
      }
    },
    "computed_not_asserted": { "type": "boolean", "const": true },
    "ts": { "type": "string" },
    "notes": { "type": "string" },
    "gate": { "type": "object" },
    "negative_control": { "type": "object" },
    "trace": { "type": "array" }
  }
}
