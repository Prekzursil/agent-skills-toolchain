{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/WFA-0093/disposition_record.schema.json",
  "title": "WFA-0093 local DispositionRecord fallback (does not rebuild WFA-0001 pack)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "status",
    "completion_sentinel",
    "question",
    "title",
    "output_path",
    "output_schema",
    "schema_resolution",
    "cost_rule",
    "upstream",
    "candidates_scored",
    "decisions",
    "histogram",
    "spikes",
    "spike_audit",
    "rule_revisions",
    "tests",
    "reviewer",
    "evidence",
    "answer",
    "emitted_at"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0093" },
    "record_type": { "type": "string", "const": "DispositionRecord" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS"]
    },
    "status": { "type": "string", "enum": ["SUCCESS"] },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0093" },
    "question": { "type": "string", "minLength": 40 },
    "title": { "type": "string", "minLength": 16 },
    "output_path": {
      "type": "string",
      "const": "command-center/wfa/WFA-0093-repair-versus-rebuild-gate.json"
    },
    "output_schema": { "type": "string", "minLength": 16 },
    "schema_resolution": { "type": "object" },
    "cost_rule": { "type": "object" },
    "upstream": { "type": "object" },
    "candidates_scored": { "type": "integer", "minimum": 15, "maximum": 15 },
    "decisions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15
    },
    "histogram": { "type": "object" },
    "spikes": { "type": "array", "minItems": 2 },
    "spike_audit": { "type": "object" },
    "rule_revisions": { "type": "array" },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": { "type": "object" },
    "evidence": { "type": "array", "minItems": 2 },
    "answer": { "type": "string", "minLength": 40 },
    "emitted_at": { "type": "string", "minLength": 20 }
  }
}
