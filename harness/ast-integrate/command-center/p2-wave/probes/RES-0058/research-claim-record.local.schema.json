{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/RES-0058/research-claim-record.local.schema.json",
  "title": "RES-0058 local research-claim-record discriminator",
  "description": "Disk-local Draft-07 contract. Catalog output_schema command-center/schema/research-claim-record.schema.json is a generated $ref shim whose target is https://ast-integrate.invalid/... ; jsonschema 4.10.3 on this worktree fetches that URL. The physical class also does not require claims[].source_lineage. This file rejects garbage and a source_lineage-stripped claim. Not a substitute for the shared family.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "design_table",
    "claims",
    "source_lineage",
    "reviewer",
    "tests"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0058" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "^SUCCESS:RES-0058"
    },
    "question": { "type": "string", "minLength": 40 },
    "design_table": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "design", "survives_git_file_index"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "design": { "type": "string", "minLength": 8 },
          "survives_git_file_index": {
            "type": "string",
            "enum": ["SURVIVES", "DOES-NOT-SURVIVE"]
          },
          "failing_property": { "type": ["string", "null"] }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "claim_id",
          "canonical_mechanism",
          "claim",
          "evidence_tier",
          "source_lineage",
          "named_settling_probe",
          "verdict",
          "strongest_caveat"
        ],
        "properties": {
          "claim_id": { "type": "string", "minLength": 8 },
          "canonical_mechanism": { "type": "string", "minLength": 8 },
          "claim": { "type": "string", "minLength": 24 },
          "evidence_tier": {
            "type": "string",
            "enum": ["E1", "E2", "E3", "E4"]
          },
          "named_settling_probe": { "type": "string", "minLength": 8 },
          "verdict": { "type": "string", "minLength": 4 },
          "strongest_caveat": { "type": "string", "minLength": 16 },
          "source_lineage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "rail",
                "permalink",
                "fetch_timestamp",
                "http_status",
                "sha256",
                "capture_path"
              ],
              "properties": {
                "rail": {
                  "type": "string",
                  "enum": ["structured-api", "prose"]
                },
                "permalink": { "type": "string", "minLength": 12 },
                "fetch_timestamp": { "type": "string", "minLength": 10 },
                "http_status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "capture_path": { "type": "string", "minLength": 8 }
              }
            }
          }
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "default"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean" },
        "default": { "type": "string", "const": "REFUTED" }
      }
    },
    "tests": { "type": "object" }
  }
}
