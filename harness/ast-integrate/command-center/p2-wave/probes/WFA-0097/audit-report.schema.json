{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/WFA-0097/audit-report.schema.json",
  "title": "WFA-0097 differ-scope disclosure AuditReport",
  "description": "Local AuditReport stand-in. Catalog pack command-center/wfa/schema/wfa-schema-pack.json is ABSENT on this tree.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "detection_envelope",
    "undetectable_classes",
    "zero_duplicates_verdicts",
    "lint",
    "tests",
    "reviewer",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0097" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": {
      "type": "string",
      "minLength": 16,
      "pattern": "SUCCESS:WFA-0097"
    },
    "completion_sentinel": { "type": "string", "minLength": 80 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "detection_envelope": {
      "type": "object",
      "required": ["methods", "rows", "undetectable_classes"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        },
        "rows": { "type": "array", "minItems": 8 }
      }
    },
    "undetectable_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "settling_experiment"],
        "properties": {
          "id": { "type": "string", "minLength": 4 },
          "settling_experiment": { "type": "string", "minLength": 24 }
        }
      }
    },
    "zero_duplicates_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "zero_duplicates", "scope"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "zero_duplicates": { "type": "boolean", "const": true },
          "scope": { "type": "object" }
        }
      }
    },
    "lint": {
      "type": "object",
      "required": [
        "planted_omission_fired",
        "trailing_limitations_fired",
        "prose_scope_fired",
        "adjacent_scope_passed"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "independent", "verdict"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "independent": { "type": "boolean", "const": true },
        "verdict": { "type": "string", "minLength": 4 }
      }
    },
    "evidence": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "SUCCESS" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "lint": {
            "properties": {
              "planted_omission_fired": { "const": true },
              "adjacent_scope_passed": { "const": true }
            }
          }
        }
      }
    }
  ]
}
