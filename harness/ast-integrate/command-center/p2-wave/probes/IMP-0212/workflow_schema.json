{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.local/imp-0212/workflow.schema.json",
  "title": "IMP-0212 executable workflow IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "stages", "stopping"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "workflow" },
    "goal": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/stage" }
    },
    "stopping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_stages", "on_error"],
      "properties": {
        "max_stages": { "type": "integer", "minimum": 1 },
        "on_error": { "enum": ["halt", "continue"] }
      }
    },
    "initial_inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "operator": {
          "enum": ["ADOPT", "ADAPT", "MERGE", "COMPOSE", "BUILD"]
        },
        "unit": { "type": "string" },
        "source_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "note": { "type": "string" }
      }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "inputs",
        "outputs",
        "tool",
        "capability",
        "timeout_seconds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "static-scan",
            "write-config",
            "transform",
            "gate",
            "splice",
            "compose",
            "emulate",
            "emit"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tool": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
