{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0011/cost.schema.json",
  "title": "ARC-0011 local architecture-cost-model (catalog shim $ref does not resolve)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "architecture_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "schema_version",
    "question",
    "answer",
    "measurements",
    "analogue",
    "crossover",
    "evidence",
    "tests",
    "artifacts",
    "min_bytes_threshold",
    "report",
    "local_schema",
    "reviewer"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "unit_id": { "type": "string", "const": "ARC-0011" },
    "architecture_id": { "type": "string", "const": "A2" },
    "state": { "type": "string", "enum": ["SUCCESS", "BLOCKED"] },
    "sentinel": {
      "type": "string",
      "pattern": "^(SUCCESS|BLOCKED):ARC-0011$"
    },
    "completion_sentinel": {
      "type": "string",
      "pattern": "^(SUCCESS|BLOCKED):ARC-0011$"
    },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "min_bytes_threshold": { "type": "integer", "minimum": 2048 },
    "local_schema": {
      "type": "string",
      "const": "command-center/p2-wave/probes/ARC-0011/cost.schema.json"
    },
    "measurements": {
      "type": "object",
      "required": ["probe1", "probe2", "probes_agree", "sizes"],
      "properties": {
        "probes_agree": { "type": "boolean" },
        "probe1": { "type": "object", "required": ["sizes"] },
        "probe2": { "type": "object", "required": ["sizes"] },
        "sizes": { "type": "array", "minItems": 2 }
      }
    },
    "analogue": {
      "type": "object",
      "required": ["prototype_path", "libraries_present"],
      "properties": {
        "prototype_path": { "type": "string", "minLength": 8 },
        "libraries_present": { "type": "boolean" }
      }
    },
    "crossover": {
      "type": "object",
      "required": ["reached_at_target", "budget_seconds", "budget_kind"],
      "properties": {
        "reached_at_target": { "type": "boolean" },
        "budget_seconds": { "type": "number" },
        "budget_kind": { "type": "string", "const": "STATED" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "command": { "type": "string", "minLength": 8 },
          "result": {
            "type": "string",
            "enum": ["NOT-RUN", "PASS", "FAIL"]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean" },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["kind", "observations", "control_ids"],
      "properties": {
        "kind": { "type": "string", "const": "architecture-cost-model" },
        "observations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "measured", "method", "anchor"]
          }
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 4 },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "independent": { "type": "boolean" }
      }
    }
  }
}
