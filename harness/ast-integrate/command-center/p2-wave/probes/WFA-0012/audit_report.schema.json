{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0012/audit_report.schema.json",
  "title": "WFA-0012 AuditReport (local; declared pack is WFA-0001)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "kind",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "inputs",
    "signal_a",
    "signal_b",
    "both_states",
    "inspection",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0012" },
    "kind": { "type": "string", "const": "AuditReport" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "minLength": 16 },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0012" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "inputs": { "type": "array", "minItems": 3 },
    "signal_a": {
      "type": "object",
      "required": ["identical_portable_and_ci", "method"],
      "properties": {
        "identical_portable_and_ci": { "type": "boolean", "const": true },
        "method": { "type": "string", "minLength": 8 }
      }
    },
    "signal_b": {
      "type": "object",
      "required": ["pure_eol_delta_equals_line_count", "method"],
      "properties": {
        "pure_eol_delta_equals_line_count": { "type": "boolean", "const": true },
        "method": { "type": "string", "minLength": 8 }
      }
    },
    "both_states": {
      "type": "object",
      "required": ["portability_fix_did_not_disarm"],
      "properties": {
        "portability_fix_did_not_disarm": { "type": "boolean", "const": true }
      }
    },
    "inspection": {
      "type": "object",
      "required": ["pass"],
      "properties": {
        "pass": { "type": "boolean", "const": true }
      }
    },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": {
      "type": "object",
      "required": ["verdict", "independent"],
      "properties": {
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
