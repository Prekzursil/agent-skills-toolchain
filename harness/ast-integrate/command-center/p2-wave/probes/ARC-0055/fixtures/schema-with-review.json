{
  "title": "detector-control: a marketplace entry that DOES declare a review field",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "kind": { "const": "marketplace_entry" },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "owner-approved"]
    },
    "signature": { "type": "string", "minLength": 8 }
  },
  "required": ["id", "kind", "review_status"]
}
