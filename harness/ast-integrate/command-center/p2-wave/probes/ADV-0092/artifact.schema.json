{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ADV-0092/artifact.schema.json",
  "title": "ADV-0092 council-pathology-sim (declared schema absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "question",
    "answer",
    "overall_verdict",
    "target_verdicts",
    "probe1",
    "probe2",
    "named_probes",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts",
    "manifest_registration"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "ADV-0092" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:ADV-0092" },
    "completion_sentinel": { "type": "string", "minLength": 80 },
    "report_kind": { "type": "string", "const": "council-pathology-sim" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "overall_verdict": {
      "type": "string",
      "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
    },
    "target_verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "probe1": { "type": "object", "required": ["mechanism", "check", "collapsed"] },
    "probe2": { "type": "object", "required": ["mechanism", "check", "diverse"] },
    "named_probes": { "type": "array", "minItems": 2 },
    "tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "const": "PASS" }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad_state", "silent_on_good_state"],
        "properties": {
          "fired_on_bad_state": { "type": "boolean", "const": true },
          "silent_on_good_state": { "type": "boolean", "const": true }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["verdict", "independent"],
      "properties": {
        "verdict": { "type": "string", "enum": ["PASS"] },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 },
    "manifest_registration": {
      "type": "object",
      "required": ["registered", "manifest_path"],
      "properties": {
        "registered": { "type": "boolean", "const": true }
      }
    }
  }
}
