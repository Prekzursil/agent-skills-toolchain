{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/schema/agentspec.resume.checkpoint.v1",
  "title": "AgentSpec resumable checkpoint record (IMP-0145)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "workflow_id",
    "spec_version",
    "completed_unit_ids",
    "receipt_hashes",
    "open_nodes",
    "param_bindings",
    "artifact_index",
    "dispatch_count_total"
  ],
  "properties": {
    "schema": {
      "const": "agentspec.resume.checkpoint.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "completed_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "open_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "node_id", "reason"],
        "properties": {
          "unit_id": { "type": "string", "minLength": 1 },
          "node_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "param_bindings": {
      "type": "object"
    },
    "artifact_index": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "dispatch_count_total": {
      "type": "integer",
      "minimum": 0
    },
    "last_invocation_log": {
      "type": "array",
      "items": { "type": "string" }
    },
    "killed": { "type": "boolean" },
    "complete": { "type": "boolean" }
  }
}
