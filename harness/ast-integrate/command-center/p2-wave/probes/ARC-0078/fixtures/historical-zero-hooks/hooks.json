{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "dispatcher": "explicit-interpreter-only",
  "hooks": [
    {
      "id": "hook.pre-tool",
      "event": "PreToolUse",
      "matcher": "*",
      "interpreter": "python3",
      "script": "hooks/pre_tool.py"
    }
  ]
}
