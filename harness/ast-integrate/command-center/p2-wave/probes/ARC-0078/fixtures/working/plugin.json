{
  "name": "ast-integrate-control-plane",
  "version": "1.0.0",
  "description": "Known-good working plugin manifest: every script names an interpreter and hooks load.",
  "author": {"name": "ast-integrate"},
  "license": "UNLICENSED",
  "keywords": ["harness", "hooks"],
  "engines": {
    "host": {
      "min": "1.0.0",
      "max": "3.0.0",
      "clients": ["claude-code", "codex"]
    }
  },
  "commands": [
    {
      "name": "audit",
      "interpreter": "python3",
      "script": "scripts/audit.py"
    },
    {
      "name": "sync",
      "interpreter": "bash",
      "script": "scripts/sync.sh"
    }
  ],
  "hooks": "./hooks.json",
  "x-estate-id": "working-control"
}
