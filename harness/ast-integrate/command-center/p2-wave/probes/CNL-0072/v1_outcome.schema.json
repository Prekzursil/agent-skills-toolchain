{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ast-integrate.invalid/cnl-0072/v1_outcome.schema.json",
 "title": "Reconstructed / live $defs.outcome plus a preset record",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "artifact_type",
  "outcome"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^C-[0-9]{2}$"
  },
  "artifact_type": {
   "type": "string",
   "const": "council-preset"
  },
  "outcome": {
   "type": "string",
   "enum": [
    "decision",
    "conditional_decision",
    "no_decision",
    "irreducible_disagreement",
    "dissent_with_minority_report",
    "proof_of_impossibility",
    "go_no_go",
    "merge_verdict",
    "finding_table",
    "session_close",
    "containment_action",
    "causal_record",
    "recommendation",
    "forecast",
    "escalation",
    "idea_set",
    "normative_ruling"
   ]
  }
 },
 "$defs": {
  "outcome": {
   "type": "string",
   "enum": [
    "decision",
    "conditional_decision",
    "no_decision",
    "irreducible_disagreement",
    "dissent_with_minority_report",
    "proof_of_impossibility",
    "go_no_go",
    "merge_verdict",
    "finding_table",
    "session_close",
    "containment_action",
    "causal_record",
    "recommendation",
    "forecast",
    "escalation",
    "idea_set",
    "normative_ruling"
   ]
  },
  "outcome_variant": {
   "type": "string",
   "enum": [
    "decision",
    "conditional_decision",
    "no_decision",
    "irreducible_disagreement",
    "dissent_with_minority_report",
    "proof_of_impossibility"
   ]
  }
 }
}
