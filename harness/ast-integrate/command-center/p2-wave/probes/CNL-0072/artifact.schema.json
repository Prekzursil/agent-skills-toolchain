{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/cnl-0072/artifact.schema.json",
  "title": "CNL-0072 outcome taxonomy design note (JSON at the catalog .md path)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "answers",
    "claims",
    "enum_17",
    "spec_variants_6",
    "mapping_table",
    "usage",
    "schema_validation",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0072" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "string", "minLength": 8 }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "enum_17": {
      "type": "object",
      "required": ["n", "ids", "source"],
      "properties": {
        "n": { "type": "integer", "const": 17 },
        "ids": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "source": { "type": "string", "minLength": 4 }
      }
    },
    "spec_variants_6": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "mapping_table": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17
    },
    "usage": {
      "type": "object",
      "required": ["outside_count"],
      "properties": {
        "outside_count": { "type": "integer", "minimum": 0 }
      }
    },
    "schema_validation": {
      "type": "object",
      "required": ["good_error_count", "invalid_error_count"],
      "properties": {
        "good_error_count": { "type": "integer", "const": 0 },
        "invalid_error_count": { "type": "integer", "minimum": 1 }
      }
    },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
