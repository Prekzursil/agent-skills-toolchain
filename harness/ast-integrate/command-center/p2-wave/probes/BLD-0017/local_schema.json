{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.invalid/command-center/p2-wave/probes/BLD-0017/local_schema.json",
  "title": "BLD-0017 owner-question-closure local overlay",
  "$comment": "The catalog output_schema is a generated $ref shim to ast-integrate.invalid. jsonschema 4.10.3 on this host follows that $ref on the network and raises RefResolutionError, which is not a ValidationError, so the named probes cannot use the shim as a gate. This overlay is the on-disk validator. It requires closure_table so a mutant with that key removed goes red.",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "closure_table",
    "proceeding_on_default",
    "coverage",
    "controls",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "const": "BLD-0017" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": {
      "type": "string",
      "pattern": "^SUCCESS:BLD-0017"
    },
    "closure_table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "enum": ["ANSWERED", "UNANSWERED"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "proceeding_on_default": {
      "type": "array",
      "minItems": 1
    },
    "coverage": {
      "type": "object",
      "required": ["exact_once", "catalog_count", "table_count"],
      "properties": {
        "exact_once": { "const": true },
        "catalog_count": { "type": "integer", "minimum": 1 },
        "table_count": { "type": "integer", "minimum": 1 }
      }
    },
    "controls": { "type": "object" },
    "reviewer": {
      "type": "object",
      "required": ["verdict", "independent"],
      "properties": {
        "verdict": { "const": "PASS" },
        "independent": { "const": true }
      }
    }
  }
}
