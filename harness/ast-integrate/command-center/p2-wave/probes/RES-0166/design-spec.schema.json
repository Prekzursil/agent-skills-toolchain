{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0166/design-spec.schema.json",
  "title": "Design spec (RES-0166 topology comparison)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "kind",
    "question",
    "answer",
    "topologies",
    "metrics",
    "task_set",
    "controls",
    "hung_worker_injection_arm",
    "comparison",
    "goose_escalation",
    "claims",
    "source_lineage",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "evidence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0166" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:RES-0166" },
    "kind": { "type": "string", "const": "design-spec" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "topologies": { "type": "array", "minItems": 4 },
    "metrics": { "type": "array", "minItems": 5 },
    "task_set": { "type": "array", "minItems": 4 },
    "hung_worker_injection_arm": { "type": "object" },
    "claims": { "type": "array", "minItems": 4 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string" },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    }
  }
}
