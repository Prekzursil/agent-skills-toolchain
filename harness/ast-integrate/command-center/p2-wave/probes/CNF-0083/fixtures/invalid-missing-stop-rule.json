{
  "id": "wf.catalog-class.discovery-only",
  "description": "Invalid: stop_rule omitted. Otherwise identical to the valid control.",
  "tools": ["Read", "Grep", "Glob"],
  "timeout_seconds": 180,
  "stages": [
    {
      "id": "discover",
      "type": "task",
      "tools": ["Read", "Grep", "Glob"],
      "timeout_seconds": 120,
      "inputs": ["repo"],
      "outputs": ["candidates.json"]
    },
    {
      "id": "record",
      "type": "task",
      "tools": ["Read"],
      "timeout_seconds": 60,
      "inputs": ["candidates.json"],
      "outputs": ["blueprint.json"]
    }
  ]
}
