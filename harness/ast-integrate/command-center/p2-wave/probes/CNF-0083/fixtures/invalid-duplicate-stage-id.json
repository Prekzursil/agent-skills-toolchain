{
  "id": "wf.catalog-class.discovery-only",
  "description": "Invalid: two stages share id discover. Otherwise identical to the valid control.",
  "tools": ["Read", "Grep", "Glob"],
  "timeout_seconds": 180,
  "stop_rule": {
    "max_stages": 2,
    "on_error": "halt"
  },
  "stages": [
    {
      "id": "discover",
      "type": "task",
      "tools": ["Read", "Grep", "Glob"],
      "timeout_seconds": 120,
      "inputs": ["repo"],
      "outputs": ["candidates.json"]
    },
    {
      "id": "discover",
      "type": "task",
      "tools": ["Read"],
      "timeout_seconds": 60,
      "inputs": ["candidates.json"],
      "outputs": ["blueprint.json"]
    }
  ]
}
