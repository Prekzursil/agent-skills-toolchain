{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WFA-0058 MechanismRecord (local; WFA-0001 pack is absent on this tree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "vocabulary",
    "mapping_table",
    "discrimination",
    "namespace_audit",
    "both_states",
    "live_source",
    "honesty",
    "evidence_a",
    "evidence_b",
    "tests",
    "reviewer",
    "residual_unknowns",
    "declared_schema",
    "schema_pack_present"
  ],
  "properties": {
    "unit_id": { "const": "WFA-0058" },
    "record_type": { "const": "MechanismRecord" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:WFA-0058" },
    "title": { "type": "string", "minLength": 20 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "vocabulary": {
      "type": "object",
      "required": ["closed", "versioned", "id_namespace", "mechanisms"],
      "properties": {
        "closed": { "const": true },
        "versioned": { "const": true },
        "id_namespace": { "const": "MX-NNNN" }
      }
    },
    "mapping_table": { "type": "array", "minItems": 1 },
    "discrimination": {
      "type": "object",
      "required": ["n", "floor", "passed"],
      "properties": {
        "n": { "const": 20 },
        "passed": { "const": true }
      }
    },
    "namespace_audit": { "type": "object" },
    "both_states": { "type": "object" },
    "live_source": { "type": "object" },
    "honesty": { "type": "string", "minLength": 16 },
    "evidence_a": { "type": "object" },
    "evidence_b": { "type": "object" },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": {
      "type": "object",
      "required": ["verdict", "both_states_rerun"],
      "properties": {
        "verdict": { "const": "PASS" },
        "both_states_rerun": { "const": true }
      }
    },
    "residual_unknowns": { "type": "array", "minItems": 1 },
    "declared_schema": { "type": "string" },
    "schema_pack_present": { "type": "boolean" }
  }
}
