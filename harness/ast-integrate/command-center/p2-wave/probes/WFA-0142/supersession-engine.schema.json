{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0142/supersession-engine.schema.json",
  "title": "WFA-0142 unit-local supersession-engine (catalog pack file is absent)",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "kind",
    "answer",
    "rehearsal",
    "evidence",
    "tests"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0142" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "BLOCKED", "FAILED"]
    },
    "sentinel": { "type": "string", "pattern": "^SUCCESS:WFA-0142" },
    "kind": { "type": "string", "const": "supersession-engine" },
    "cloud_ok": { "type": "boolean" },
    "answer": {
      "type": "object",
      "required": [
        "caller_migration_set",
        "rollback_restores_superseded_workflow",
        "rollback_restores_decomposed_sources",
        "rollback_that_would_drop_a_caller_is_refused"
      ]
    },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 }
  }
}
