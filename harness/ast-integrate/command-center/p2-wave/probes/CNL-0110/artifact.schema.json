{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/p2/cnl-0110/artifact.schema.json",
  "title": "CNL-0110 requirements-council design artifact",
  "$comment": "Executable Draft 2020-12 contract for this unit. Catalog output_schema command-center/schema/council-preset.schema.json is a generated $ref shim to ast-integrate.invalid; jsonschema 4.x on this host tries the network and raises. Do not follow that $ref from named probes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "answers",
    "preset",
    "nearest_sibling",
    "instantiation",
    "negative_control"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0110" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0110" },
    "kind": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "required": [
        "how_separated",
        "unreconcilable_pair_outcome",
        "why_not_blend"
      ],
      "properties": {
        "how_separated": { "type": "string", "minLength": 40 },
        "unreconcilable_pair_outcome": {
          "type": "string",
          "const": "irreducible-disagreement"
        },
        "why_not_blend": { "type": "string", "minLength": 40 }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "kind", "delta", "editable_dials", "default_binding"],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "kind": { "type": "string", "minLength": 8 },
        "delta": {
          "type": "object",
          "required": [
            "roles",
            "protocol_schedule",
            "voting",
            "stopping",
            "outcomes"
          ],
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 5,
              "items": { "type": "string", "minLength": 3 }
            },
            "protocol_schedule": {
              "type": "array",
              "minItems": 2,
              "allOf": [
                { "contains": { "const": "p-elicit" } },
                { "contains": { "const": "p-reconcile" } }
              ]
            },
            "voting": {
              "type": "object",
              "required": ["elicit", "reconcile"],
              "properties": {
                "elicit": {
                  "type": "object",
                  "required": ["rule"],
                  "properties": {
                    "rule": { "type": "string", "const": "record-only" }
                  }
                },
                "reconcile": {
                  "type": "object",
                  "required": ["rule"],
                  "properties": {
                    "rule": {
                      "type": "string",
                      "const": "pairwise-originator-conjunction"
                    }
                  }
                }
              }
            },
            "stopping": { "type": "object" },
            "outcomes": {
              "type": "object",
              "required": ["unreconcilable_pair"],
              "properties": {
                "unreconcilable_pair": {
                  "type": "string",
                  "enum": ["irreducible-disagreement"]
                }
              }
            }
          }
        }
      }
    },
    "nearest_sibling": {
      "type": "object",
      "required": ["named", "distance", "source"],
      "properties": {
        "named": { "type": "string", "minLength": 8 },
        "distance": { "type": "integer", "minimum": 1 },
        "source": { "type": "string", "minLength": 8 }
      }
    },
    "instantiation": {
      "type": "object",
      "required": ["task_id", "roster", "protocol_schedule", "voting", "stopping"]
    },
    "negative_control": {
      "type": "object",
      "required": ["rejects", "verbatim", "planted_blend_fires"]
    }
  }
}
