{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WFA-0002 ProbeReport (local stand-in; WFA-0001 pack absent)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "id",
    "state",
    "status",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "output_path",
    "output_schema",
    "local_schema",
    "schema_gate",
    "corpus_mode",
    "recall_limit",
    "live_sources",
    "evidence",
    "classifications",
    "provenance_resolution_rate",
    "provenance_edges_unresolved",
    "closure_after",
    "fabrication_control",
    "tests",
    "negative_controls",
    "reviewer",
    "residual_unknowns",
    "notes"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "ProbeReport" },
    "unit_id": { "type": "string", "const": "WFA-0002" },
    "id": { "type": "string", "const": "WFA-0002" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "status": { "type": "string", "enum": ["DELIVERED"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0002" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0002" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 8 },
    "output_path": { "type": "string" },
    "output_schema": { "type": "string" },
    "local_schema": { "type": "string" },
    "schema_gate": { "type": "object" },
    "produced_by": { "type": "object" },
    "corpus_mode": { "type": "string" },
    "recall_limit": { "type": "object" },
    "live_sources": { "type": "object" },
    "named_inputs": { "type": "object" },
    "fixture_graph": { "type": "object" },
    "evidence": { "type": "object" },
    "unresolved_before": { "type": "object" },
    "classifications": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40
    },
    "registry_additions": { "type": "array" },
    "citation_corrections": { "type": "array" },
    "drift_findings": { "type": "array" },
    "provenance_resolution_rate": { "type": "number", "minimum": 1, "maximum": 1 },
    "provenance_edges_unresolved": { "type": "integer", "const": 0 },
    "closure_after": { "type": "object" },
    "fabrication_control": { "type": "object" },
    "tests": { "type": "array" },
    "negative_controls": { "type": "array" },
    "reviewer": { "type": "object" },
    "residual_unknowns": { "type": "array" },
    "timestamps": { "type": "object" },
    "notes": { "type": "string", "minLength": 16 },
    "SUCCESS:WFA-0002": { "type": "boolean", "const": true }
  }
}
