{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CouncilSpec v2 participant descriptor (CNL-0005, 9 per-seat dials)",
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["observe", "advise", "vote", "chair", "bind"]
        },
        "can_bind": { "type": "boolean" },
        "can_veto": { "type": "boolean" }
      }
    },
    "participant_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat_id", "model", "role", "authority"],
      "properties": {
        "seat_id": {
          "type": "string",
          "minLength": 1,
          "description": "Roster address. Not a behavioral dial. Duplicate identity with a different seat_id is still DUPLICATE_SEAT."
        },
        "model": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "expertise": { "type": ["string", "null"], "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "authority": { "$ref": "#/$defs/authority" },
        "vote_weight": { "type": "number", "exclusiveMinimum": 0 },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "effort": {
          "type": "string",
          "enum": ["inherit", "low", "medium", "high"]
        },
        "context": { "type": "string", "minLength": 1 }
      }
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seats"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "seats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/participant_descriptor" }
        }
      }
    }
  },
  "$ref": "#/$defs/participant_descriptor"
}
