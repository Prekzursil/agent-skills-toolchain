<!DOCTYPE html><html lang="en"> <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><script>
  (function () {
    try {
      var c = localStorage.getItem("ro-theme");
      var dark =
        c === "dark" ||
        (c == null &&
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      if (dark) document.documentElement.setAttribute("data-theme", "dark");
      else document.documentElement.removeAttribute("data-theme");
    } catch (e) {}
  })();
</script><script>
  (function () {
    if (!location.hash) return;

    document.documentElement.setAttribute("data-initial-anchor", "");
    window.addEventListener(
      "load",
      function () {
        requestAnimationFrame(function () {
          var id;
          try {
            id = decodeURIComponent(location.hash.slice(1));
          } catch (e) {
            id = location.hash.slice(1);
          }
          var target = document.getElementById(id);
          if (target) target.scrollIntoView({ behavior: "auto", block: "start" });
          document.documentElement.removeAttribute("data-initial-anchor");
        });
      },
      { once: true },
    );
  })();
</script><script>
  (function () {
    if (!("scrollRestoration" in history)) return;
    history.scrollRestoration = "manual";

    var KEY = "ro-scroll:";
    function save() {
      try {
        sessionStorage.setItem(KEY + location.pathname, String(window.scrollY));
      } catch (e) {}
    }
    // Persist scroll position as the user leaves the page. "pagehide" also
    // fires when the page enters the back/forward cache, keeping the saved
    // value accurate for a later bfcache restore.
    window.addEventListener("pagehide", save);
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") save();
    });

    window.addEventListener("pageshow", function (event) {
      // Detect back/forward navigation. A non-cached history reload is reported
      // as "back_forward" by the Navigation Timing API; a restore from the
      // back/forward cache is signalled by event.persisted (and in that case
      // the Timing API still reports the document's ORIGINAL load type, so it
      // can't be trusted on its own).
      var nav = performance.getEntriesByType("navigation")[0];
      var isBackForward =
        event.persisted || (nav && nav.type === "back_forward");

      if (isBackForward) {
        // History navigation: land where the user left this page.
        var saved = null;
        try {
          saved = sessionStorage.getItem(KEY + location.pathname);
        } catch (e) {}
        if (saved !== null) {
          window.scrollTo({ top: parseInt(saved, 10) || 0, behavior: "instant" });
        }
        // No saved position (or a bfcache restore the browser already placed):
        // leave the scroll where it is.
        return;
      }

      // Fresh navigation to a #hash: let the browser scroll to the target.
      if (location.hash) return;

      // Fresh navigation: always start at the top.
      window.scrollTo({ top: 0, behavior: "instant" });
    });
  })();
</script><title>Concurrency and cancel-in-progress in GitHub Actions - RunsOn</title><meta name="description" content="Stop wasting CI minutes on redundant runs. The GitHub Actions concurrency keyword: cancel superseded PR runs, serialize deploys, avoid group-key gotchas."><link rel="canonical" href="https://runs-on.com/github-actions/concurrency/"><link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32"><link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16"><link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512"><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"><meta property="og:title" content="Concurrency and cancel-in-progress in GitHub Actions - RunsOn"><meta property="og:description" content="Stop wasting CI minutes on redundant runs. The GitHub Actions concurrency keyword: cancel superseded PR runs, serialize deploys, avoid group-key gotchas."><meta property="og:url" content="https://runs-on.com/github-actions/concurrency/"><meta property="og:image" content="https://runs-on.com/og/github-actions/concurrency.png"><meta property="og:type" content="article"><meta property="og:site_name" content="RunsOn"><meta property="og:locale" content="en_US"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Concurrency and cancel-in-progress in GitHub Actions - RunsOn"><meta name="twitter:description" content="Stop wasting CI minutes on redundant runs. The GitHub Actions concurrency keyword: cancel superseded PR runs, serialize deploys, avoid group-key gotchas."><meta name="twitter:image" content="https://runs-on.com/og/github-actions/concurrency.png"><meta name="twitter:site" content="@RunsOnRunsOn"><script src="https://cdn.usefathom.com/script.js" data-site="LQSGIDCZ" defer></script><script>
  (() => {
    const CONSENT_KEY = "runson_consent_v1";
    const ATTRIBUTION_COOKIE = "runson_ads_click";
    const ATTRIBUTION_MAX_AGE = 60 * 60 * 24 * 90;
    const CLICK_ID_PARAMS = ["gclid", "gbraid", "wbraid"];
    const CONSENT_CONTEXT_URL = "/api/consent-context";

    function readConsent() {
      try {
        return JSON.parse(localStorage.getItem(CONSENT_KEY) || "null");
      } catch {
        return null;
      }
    }

    function writeConsent(granted) {
      const consent = {
        analytics:
          typeof granted === "object" ? Boolean(granted.analytics) : Boolean(granted),
        adMeasurement:
          typeof granted === "object"
            ? Boolean(granted.adMeasurement)
            : Boolean(granted),
        basis:
          typeof granted === "object" && granted.basis
            ? String(granted.basis)
            : "explicit",
        updatedAt: new Date().toISOString(),
      };
      localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
      return consent;
    }

    function encodeCookieValue(value) {
      return btoa(JSON.stringify(value))
        .replace(/\+/g, "-")
        .replace(/\//g, "_")
        .replace(/=+$/, "");
    }

    function setAttributionCookie(click) {
      const secure = window.location.protocol === "https:" ? "; Secure" : "";
      document.cookie = `${ATTRIBUTION_COOKIE}=${encodeCookieValue(click)}; Max-Age=${ATTRIBUTION_MAX_AGE}; Path=/; SameSite=Lax${secure}`;
    }

    function clearAttributionCookie() {
      document.cookie = `${ATTRIBUTION_COOKIE}=; Max-Age=0; Path=/; SameSite=Lax`;
    }

    // install_intent: a secondary Google Ads conversion fired when an ad
    // visitor reaches the install funnel or clicks a "launch stack" link. We
    // only beacon when an eligible ad attribution cookie is present; the
    // backend reads that cookie and self-filters everything else.
    const INSTALL_INTENT_ENDPOINT = "/api/track/install-intent";
    const INSTALL_INTENT_SENT_KEY = "runson_install_intent_sent";
    const INSTALL_INTENT_SELECTOR =
      'a[href*="quickcreate"], a[data-cta="nav_install"], a[data-cta="hero_install"], a[href^="/quickstart"], a[href^="/installation"]';

    function hasAttributionCookie() {
      return document.cookie
        .split("; ")
        .some((entry) => entry.startsWith(`${ATTRIBUTION_COOKIE}=`));
    }

    function isInstallFunnelPath(pathname) {
      return pathname.startsWith("/quickstart") || pathname.startsWith("/installation");
    }

    function sendInstallIntent() {
      if (!hasAttributionCookie()) return;
      try {
        if (sessionStorage.getItem(INSTALL_INTENT_SENT_KEY)) return;
      } catch {}
      let sent = false;
      try {
        sent = Boolean(navigator.sendBeacon?.(INSTALL_INTENT_ENDPOINT));
      } catch {}
      if (!sent) {
        try {
          fetch(INSTALL_INTENT_ENDPOINT, {
            method: "POST",
            keepalive: true,
            credentials: "same-origin",
          }).catch(() => {});
        } catch {}
      }
      try {
        sessionStorage.setItem(INSTALL_INTENT_SENT_KEY, "1");
      } catch {}
    }

    function currentClickId(basis = "explicit") {
      const params = new URLSearchParams(window.location.search);
      for (const type of CLICK_ID_PARAMS) {
        const value = params.get(type);
        if (value) {
          return {
            type,
            value,
            landingPath: `${window.location.pathname}${window.location.search}`,
            capturedAt: new Date().toISOString(),
            consent: "granted",
            basis,
          };
        }
      }
      return null;
    }

    function captureCurrentClickId(basis = "explicit") {
      const click = currentClickId(basis);
      if (click) {
        setAttributionCookie(click);
      }
    }

    function applyConsent(consent) {
      if (consent?.adMeasurement) {
        captureCurrentClickId(consent.basis || "explicit");
      }
    }

    async function readConsentContext() {
      try {
        const response = await fetch(CONSENT_CONTEXT_URL, {
          headers: { Accept: "application/json" },
          cache: "no-store",
        });
        if (!response.ok) return { requiresConsent: true };
        const context = await response.json();
        return {
          requiresConsent: context?.requiresConsent !== false,
          country: context?.country || null,
        };
      } catch {
        return { requiresConsent: true };
      }
    }

    function removeBanner() {
      document.querySelector("[data-consent-banner]")?.remove();
    }

    function renderBanner({ preview = false } = {}) {
      if (
        (!preview && (!currentClickId() || readConsent())) ||
        document.querySelector("[data-consent-banner]")
      ) {
        return;
      }

      const banner = document.createElement("div");
      banner.setAttribute("data-consent-banner", "");
      banner.innerHTML = `
        <div class="ro-cookie" role="dialog" aria-label="Cookie consent">
          <p class="ro-cookie__body">We use cookies for measurement.</p>
          <div class="ro-cookie__actions">
            <button type="button" class="ro-cookie__btn ro-cookie__btn--secondary" data-consent-reject>Reject</button>
            <button type="button" class="ro-cookie__btn ro-cookie__btn--primary ro-cookie__accept" data-consent-accept>Accept</button>
          </div>
        </div>
      `;
      document.body.appendChild(banner);

      banner.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
        if (preview) {
          removeBanner();
          return;
        }
        applyConsent(writeConsent({ analytics: false, adMeasurement: true }));
        removeBanner();
        refreshConsentStatus();
      });
      banner.querySelector("[data-consent-reject]")?.addEventListener("click", () => {
        if (preview) {
          removeBanner();
          return;
        }
        clearAttributionCookie();
        writeConsent({ analytics: false, adMeasurement: false });
        removeBanner();
        refreshConsentStatus();
      });
    }

    window.runsonConsent = {
      show() {
        removeBanner();
        renderBanner({ preview: true });
      },
    };

    function consentStatusLabel() {
      const consent = readConsent();
      if (!consent) {
        return hasAttributionCookie()
          ? "Advertising measurement is active for this ad visit."
          : "Advertising measurement is not active.";
      }
      return consent.adMeasurement
        ? "Advertising measurement is accepted."
        : "Advertising measurement is declined.";
    }

    function refreshConsentStatus() {
      document.querySelectorAll("[data-runson-consent-status]").forEach((el) => {
        el.textContent = consentStatusLabel();
      });
    }

    // The privacy notice can withdraw ad measurement without recreating a
    // prompt on a page that did not originate from a Google Ads click.
    document.addEventListener("click", (event) => {
      const trigger = event.target.closest?.("[data-runson-consent-decline]");
      if (!trigger) return;
      event.preventDefault();
      clearAttributionCookie();
      writeConsent(false);
      removeBanner();
      refreshConsentStatus();
    });

    // Fire install_intent when an install CTA / CloudFormation launch link is
    // clicked. sendBeacon survives the navigation (incl. off-site to AWS).
    document.addEventListener("click", (event) => {
      if (event.target.closest?.(INSTALL_INTENT_SELECTOR)) {
        sendInstallIntent();
      }
    });

    async function onReady() {
      const consent = readConsent();
      if (consent) {
        applyConsent(consent);
        refreshConsentStatus();
        if (isInstallFunnelPath(window.location.pathname)) sendInstallIntent();
        return;
      }

      // A consent decision is only relevant when this page view carries a
      // Google Ads click ID. Existing attribution cookies remain available as
      // the visitor continues through the install or checkout funnel.
      if (!currentClickId()) {
        refreshConsentStatus();
        if (isInstallFunnelPath(window.location.pathname)) sendInstallIntent();
        return;
      }

      const context = await readConsentContext();
      if (!context.requiresConsent) {
        // Outside EEA/UK/CH, capture first-party ad attribution without a
        // consent popup. This does not enable any visitor analytics script.
        applyConsent({
          analytics: false,
          adMeasurement: true,
          basis: "country_non_restricted",
        });
        refreshConsentStatus();
        if (isInstallFunnelPath(window.location.pathname)) sendInstallIntent();
        return;
      }

      renderBanner();
      refreshConsentStatus();
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", onReady, { once: true });
    } else {
      onReady();
    }
  })();
</script> <style>@font-face{font-family:Geist Sans;font-style:normal;font-display:swap;font-weight:400;src:url(/_astro/geist-sans-latin-400-normal.gapTbOY8.woff2) format("woff2"),url(/_astro/geist-sans-latin-400-normal.BOaIZNA2.woff) format("woff")}@font-face{font-family:Geist Sans;font-style:normal;font-display:swap;font-weight:500;src:url(/_astro/geist-sans-latin-500-normal.uokXdC-Q.woff2) format("woff2"),url(/_astro/geist-sans-latin-500-normal.CN2lyvyL.woff) format("woff")}@font-face{font-family:Geist Sans;font-style:normal;font-display:swap;font-weight:600;src:url(/_astro/geist-sans-latin-600-normal.DFOURf8L.woff2) format("woff2"),url(/_astro/geist-sans-latin-600-normal.CA1yjETN.woff) format("woff")}@font-face{font-family:Geist Sans;font-style:normal;font-display:swap;font-weight:700;src:url(/_astro/geist-sans-latin-700-normal.BmN9tIp5.woff2) format("woff2"),url(/_astro/geist-sans-latin-700-normal.CjScfYeH.woff) format("woff")}@font-face{font-family:Geist Mono;font-style:normal;font-display:swap;font-weight:400;src:url(/_astro/geist-mono-cyrillic-400-normal.Ce5q_31Z.woff2) format("woff2"),url(/_astro/geist-mono-cyrillic-400-normal.BPBWmzPh.woff) format("woff");unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}@font-face{font-family:Geist Mono;font-style:normal;font-display:swap;font-weight:400;src:url(/_astro/geist-mono-latin-ext-400-normal.Cgks_Qgx.woff2) format("woff2"),url(/_astro/geist-mono-latin-ext-400-normal.CxNRRMGd.woff) format("woff");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}@font-face{font-family:Geist Mono;font-style:normal;font-display:swap;font-weight:400;src:url(/_astro/geist-mono-latin-400-normal.LC9RFr9I.woff2) format("woff2"),url(/_astro/geist-mono-latin-400-normal.CoULgQGM.woff) format("woff");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0