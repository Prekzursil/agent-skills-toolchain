*,*:before,*:after{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:clip}html[data-initial-anchor]{scroll-behavior:auto}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}a[target=_blank]:after{content:" ↗"}blockquote>p:before{content:open-quote}blockquote>p:after{content:close-quote}blockquote>p{quotes:"“" "”" "‘" "’"}:root{color-scheme:dark}.site-shell{background:#0a0e18;color:#dfe5ef;margin:0;font-family:Geist Sans,system-ui,-apple-system,sans-serif}.marketing-gradient{position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(ellipse at 30% 0%,rgba(10,100,160,.1),transparent 50%),linear-gradient(180deg,#0a0e18,#0d1220,#0a0e18)}code,pre{font-family:Geist Mono,JetBrains Mono,monospace}a{text-decoration:none;color:inherit}:where(a,button,summary,[tabindex],input,select,textarea):focus-visible{outline:2px solid rgba(56,189,248,.75);outline-offset:2px}.not-content img{margin-top:0!important}.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid rgba(255,255,255,.06);background:#0a0e18d9;backdrop-filter:blur(12px)}.brand{display:inline-flex;align-items:center;gap:.625rem;color:#f8fafc;font-size:1.1rem;font-weight:600;letter-spacing:.02em;text-decoration:none;flex-shrink:0}.brand img{border-radius:.25rem}.brand-logo{display:block;width:7rem;height:2.5rem;object-fit:cover;object-position:center;border-radius:0}.site-header .brand-logo,.mobile-sidebar-header .brand-logo{width:6.25rem;height:2.25rem}.nav-link{color:#a3b1c4;text-decoration:none;font-size:.875rem;transition:color .15s ease}.nav-link:hover,.nav-link.is-active{color:#f8fafc}.btn-install{text-decoration:none;background:#0ea5e91a;color:#7dd3fc;font-size:.8125rem;font-weight:500;border-radius:.25rem;padding:.375rem .875rem;border:1px solid rgba(14,165,233,.15);transition:all .15s ease;white-space:nowrap}.btn-install:hover{background:#0ea5e92e;border-color:#0ea5e94d;color:#bae6fd}.site-header-inner{display:flex;align-items:center;gap:1rem;max-width:1400px;margin:0 auto;padding:.625rem 1rem}@media(min-width:640px){.site-header-inner{padding:.625rem 1.5rem}}.mobile-menu-btn{background:none;border:1px solid rgba(255,255,255,.12);border-radius:.5rem;padding:.375rem;color:#e2e8f0;cursor:pointer}.mobile-overlay{display:none;position:fixed;inset:0;background:#0009;z-index:100;opacity:0;transition:opacity .2s ease}.mobile-overlay.is-open{display:block;opacity:1}.mobile-sidebar{position:fixed;top:0;left:0;bottom:0;width:min(300px,85vw);background:#0e1320;z-index:101;transform:translate(-100%);transition:transform .2s ease;overflow-y:auto;border-right:1px solid rgba(255,255,255,.06)}.mobile-sidebar.is-open{transform:translate(0)}.mobile-sidebar-header{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;border-bottom:1px solid rgba(255,255,255,.06)}.mobile-close-btn{background:none;border:none;color:#94a3b8;cursor:pointer;padding:.25rem}.mobile-nav-links{display:grid;gap:.25rem;padding:.75rem}.mobile-nav-link{color:#dbeafe;text-decoration:none;font-size:.95rem;border-radius:.5rem;padding:.5rem .75rem}.mobile-nav-link:hover,.mobile-nav-link.is-active{background:#1e293bcc;color:#f8fafc}.mobile-nav-github{display:inline-flex;align-items:center;gap:.5rem}.mobile-nav-github svg{width:1rem;height:1rem}.mobile-nav-install{margin-top:.5rem;text-decoration:none;border-radius:.25rem;padding:.55rem .75rem;text-align:center;font-size:.92rem;font-weight:500;background:#0ea5e91a;color:#7dd3fc;border:1px solid rgba(14,165,233,.15)}:root{--mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;--sans: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;color-scheme:light;--paper: #ffffff;--paper-2: #f8f8f8;--paper-3: #f1f1f1;--ink: #101010;--ink-2: #484848;--faint: #787878;--ink-4: #a0a0a0;--line: #e6e6e6;--line-2: #d4d4d4;--on-accent: #101010;--accent: #f0c868;--accent-2: #e3b649;--accent-hover: #f3d27e;--accent-wash: #fbf2da;--code-bg: #101010;--code-ink: #e8e8e8;--code-faint: