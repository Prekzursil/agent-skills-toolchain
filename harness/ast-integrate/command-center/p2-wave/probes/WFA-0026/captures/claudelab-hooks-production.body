<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">  "action"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: {</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">    "write_state"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: {</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">      "file"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: </span><span style="--shiki-dark:#96D0FF;--shiki-light:#032F62">".hook-state.json"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">,</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">      "data"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: {</span><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">"NPM_REGISTRY"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: </span><span style="--shiki-dark:#96D0FF;--shiki-light:#032F62">"https://private.registry.com"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">}</span></span>
<span data-line=""><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">    }</span></span>
