<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">    "if_syntax_error"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: </span><span style="--shiki-dark:#96D0FF;--shiki-light:#032F62">"ask_user_to_fix"</span></span>
