<h3 id="section-14">Template 2: Auto-Test and Report with Coverage</h3>
<figure data-rehype-pretty-code-figure=""><pre tabindex="0" data-language="json" data-theme="github-dark-dimmed github-light"><code data-language="json" data-theme="github-dark-dimmed github-light" style="display: grid;"><span data-line=""><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">{</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">  "hooks"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: [</span></span>
<span data-line=""><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">    {</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">      "hook_type"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: </span><span style="--shiki-dark:#96D0FF;--shiki-light:#032F62">"PostToolUse"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">,</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">      "event"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: </span><span style="--shiki-dark:#96D0FF;--shiki-light:#032F62">"npm"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">,</span></span>
<span data-line=""><span style="--shiki-dark:#8DDB8C;--shiki-light:#005CC5">      "condition"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">: </span><span style="--shiki-dark:#96D0FF;--shiki-light:#032F62">"command.includes('test')"</span><span style="--shiki-dark:#ADBAC7;--shiki-light:#24292E">,</span></span>
