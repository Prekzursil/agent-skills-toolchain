,\"BookRecommendation\"]\n22:[\"$\",\"sup\",null,{\"style\":{\"fontSize\":9,\"marginLeft\":3,\"color\":\"var(--text-faint)\"},\"children\":232}]\n23:[\"$\",\"a\",\"Hooks\",{\"href\":\"/en/tag/Hooks\",\"style\":{\"fontSize\":11,\"padding\":\"2px 10px\",\"borderRadius\":3,\"border\":\"1px solid var(--border-subtle)\",\"color\":\"var(--text-dim)\",\"fontFamily\":\"'DM Mono', monospace\",\"textDecoration\":\"none\",\"transition\":\"all 0.2s\"},\"children\":[\"Hooks\",[\"$\",\"sup\",null,{\"style\":{\"fontSize\":9,\"marginLeft\":3,\"color\":\"var(--text-faint)\"},\"children\":6}]]}]\n24:[\"$\",\"a\",\"Automation\",{\"href\":\"/en/tag/Automation\",\"style\":{\"fontSize\":11,\"padding\":\"2px 10px\",\"borderRadius\":3,\"border\":\"1px solid var(--border-subtle)\",\"color\":\"var(--text-dim)\",\"fontFamily\":\"'DM Mono', monospace\",\"textDecoration\":\"none\",\"transition\":\"all 0.2s\"},\"children\":[\"Automation\",[\"$\",\"sup\",null,{\"style\":{\"fontSize\":9,\"marginLeft\":3,\"color\":\"var(--text-faint)\"},\"children\":43}]]}]\n25:[\"$\",\"a\",\"Workflow\",{\"href\":\"/en/tag/Workflow\",\"style\":{\"fontSize\":11,\"padding\":\"2px 10px\",\"borderRadius\":3,\"border\":\"1px solid var(--border-subtle)\",\"color\":\"var(--text-dim)\",\"fontFamily\":\"'DM Mono', monospace\",\"textDecoration\":\"none\",\"transition\":\"all 0.2s\"},\"children\":[\"Workflow\",[\"$\",\"sup\",null,{\"style\":{\"fontSize\":9,\"marginLeft\":3,\"color\":\"var(--text-faint)\"},\"children\":8}]]}]\n26:[\"$\",\"a\",\"Practical Guide\",{\"href\":\"/en/tag/Practical%20Guide\",\"style\":{\"fontSize\":11,\"padding\":\"2px 10px\",\"borderRadius\":3,\"border\":\"1px solid var(--border-subtle)\",\"color\":\"var(--text-dim)\",\"fontFamily\":\"'DM Mono', monospace\",\"textDecoration\":\"none\",\"transition\":\"all 0.2s\"},\"children\":[\"Practical Guide\",false]}]\n27:[\"$\",\"a\",\"Agent Design\",{\"href\":\"/en/tag/Agent%20Design\",\"style\":{\"fontSize\":11,\"padding\":\"2px 10px\",\"borderRadius\":3,\"border\":\"1px solid var(--border-subtle)\",\"color\":\"var(--text-dim)\",\"fontFamily\":\"'DM Mono', monospace\",\"textDecoration\":\"none\",\"transition\":\"all 0.2s\"},\"children\":[\"Agent Design\",[\"$\",\"sup\",null,{\"style\":{\"fontSize\":9,\"marginLeft\":3,\"color\":\"var(--text-faint)\"},\"children\":2}]]}]\n28:[\"$\",\"hr\",null,{\"style\":{\"border\":\"none\",\"borderTop\":\"1px soli"])</script><script>self.__next_f.push([1,"d var(--border-subtle)\",\"marginBottom\":40}}]\n29:[\"$\",\"$L30\",null,{\"locale\":\"en\",\"initialItems\":[{\"id\":\"section-0\",\"text\":\"The Design Philosophy Behind Hooks\",\"level\":2},{\"id\":\"section-1\",\"text\":\"The 8 Hooks: A Complete Reference\",\"level\":2},{\"id\":\"section-2\",\"text\":\"The Hook Firing Sequence (Critical)\",\"level\":2},{\"id\":\"section-3\",\"text\":\"PreToolUse vs PostToolUse: The Foundational Distinction\",\"level\":2},{\"id\":\"section-4\",\"text\":\"UserPromptSubmit: Input Processing and Security\",\"level\":2},{\"id\":\"section-5\",\"text\":\"Stop vs SubagentStop: Don't Confuse These\",\"level\":2},{\"id\":\"section-6\",\"text\":\"SessionStart and SessionEnd: Environment Bookends\",\"level\":2},{\"id\":\"section-7\",\"text\":\"Notification: Fire and Forget External Communication\",\"level\":2},{\"id\":\"section-8\",\"text\":\"Three Production Traps I Hit (And How to Avoid Them)\",\"level\":2},{\"id\":\"section-9\",\"text\":\"Trap 1: Misunderstanding Hook Firing Order\",\"level\":3},{\"id\":\"section-10\",\"text\":\"Trap 2: Async Wait Timeouts in Long-Running Tasks\",\"level\":3},{\"id\":\"section-11\",\"text\":\"Trap 3: Hook Interdependency Loops\",\"level\":3},{\"id\":\"section-12\",\"text\":\"Ready-to-Use Templates\",\"level\":2},{\"id\":\"section-13\",\"text\":\"Template 1: Security Gate for Git Push to Main\",\"level\":3},{\"id\":\"section-14\",\"text\":\"Template 2: Auto-Test and Report with Coverage\",\"level\":3},{\"id\":\"section-15\",\"text\":\"Template 3: Session Init with Full Environment Setup\",\"level\":3},{\"id\":\"section-16\",\"text\":\"How the Config File Actually Looks\",\"level\":2},{\"id\":\"section-17\",\"text\":\"Measuring Hook Overhead\",\"level\":2},{\"id\":\"section-18\",\"text\":\"Operating Hooks in Production\",\"level\":2}]}]\n2a:[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-flex\",\"alignItems\":\"center\",\"gap\":6,\"padding\":\"3px 10px\",\"borderRadius\":4,\"border\":\"1px solid var(--border-subtle)\",\"fontSize\":11,\"color\":\"var(--text-dim)\",\"fontFamily\":\"'DM Mono', monospace\",\"marginBottom\":24},\"children\":[\"✦ \",\"Premium Article\"]}]\n31:T1182,\u003cp\u003eI spent six months running Claude Code in production before I truly understood hooks. The documentation covers \u003cem\u003ewhat\u003c/em\u003e they do, but not \u003cem\u003ewhy\u003c/em\u003e you'd pick one over another in a real scenario. Halfway through, I realized I'd been setting up hooks wrong the whole time: two hooks fighting each other, one never firing because I'd misconfigured the timing, another creating an infinite loop.\u003c/p\u003e\n\u003cp\u003eThe frustration wasn't the hooks themselves—it was the mental model. I was treating them like simple on/off switches when they're actually a control flow system that governs the entire conversation between you, Claude Code, and your tools.\u003c/p\u003e\n\u003cp\u003eThis guide is for people who got hooks working once, then broke something and gave up. Or people who want to avoid that entirely. I'll walk through every hook type, show you when to use it, and reveal the three production bugs I hit that taught me the hard way.\u003c/p\u003e\n\u003ch2 id=\"section-0\"\u003eThe Design Philosophy Behind Hooks\u003c/h2\u003e\n\u003cp\u003eClaude Code hooks aren't just event listeners. They're the connective tissue between what you ask Claude to do and what actually gets executed.\u003c/p\u003e\n\u003cp\u003eThink of the traditional flow: user prompt → code generation → done. One direction, no feedback loop.\u003c/p\u003e\n\u003cp\u003eHooks create: user ⇄ Claude Code (with hooks) ⇄ tools (git, npm, shell, API calls). Bidirectional. The hook system manages that conversation. Each hook type handles a specific phase.\u003c/p\u003e\n\u003cp\u003eThe first principle: \u003cstrong\u003eseparate concerns\u003c/strong\u003e. Don't put PostToolUse logic in PreToolUse. Don't use Stop to handle single-tool failures. Mixing them is where everything breaks.\u003c/p\u003e\n\u003cp\u003eThe second: \u003cstrong\u003ehooks are synchronous by default, but support async\u003c/strong\u003e. If you put a Promise in a hook, Claude Code will wait. But wait too long and the session times out. The balance is tight—that's our first production trap.\u003c/p\u003e\n\u003cp\u003eThe third: \u003cstrong\u003ehooks fire in sequence, not in parallel\u003c/strong\u003e. Misunderstanding this sequence is the most common footgun. Get this wrong and you'll spend hours debugging why a value is undefined or why a tool runs twice.\u003c/p\u003e\n\u003cp\u003eThe fourth: \u003cstrong\u003eeach hook phase has a diff"])</script><script>self.__next_f.push([1,"erent responsibility\u003c/strong\u003e. Don't make SessionStart do what SessionEnd should do. Don't make PreToolUse handle post-execution validation. This separation is what makes debugging possible.\u003c/p\u003e\n\u003ch2 id=\"section-1\"\u003eThe 8 Hooks: A Complete Reference\u003c/h2\u003e\n\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\u003cth\u003eHook\u003c/th\u003e\u003cth\u003eFires\u003c/th\u003e\u003cth\u003eResponsibility\u003c/th\u003e\u003cth\u003eCommon Use\u003c/th\u003e\u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eSessionStart\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eImmediately after session begins\u003c/td\u003e\u003ctd\u003eInitialize environment\u003c/td\u003e\u003ctd\u003eSet up dependencies, env files, initial checks\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eUserPromptSubmit\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eWhen user sends a message (before processing)\u003c/td\u003e\u003ctd\u003ePre-filter and enrich input\u003c/td\u003e\u003ctd\u003eDetect code, validate syntax, security checks\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003ePreToolUse\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eRight before a tool executes\u003c/td\u003e\u003ctd\u003eValidate preconditions\u003c/td\u003e\u003ctd\u003eSecurity gates, permission checks, state validation\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003ePostToolUse\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eRight after a tool executes\u003c/td\u003e\u003ctd\u003eVerify results\u003c/td\u003e\u003ctd\u003eConfirm success, handle errors, log outcomes\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eNotification\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eAnytime, independently\u003c/td\u003e\u003ctd\u003eSend external messages\u003c/td\u003e\u003ctd\u003eSlack notifications, email alerts, webhooks\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eStop\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eWhen deciding whether to end session\u003c/td\u003e\u003ctd\u003eEvaluate completion\u003c/td\u003e\u003ctd\u003eAuto-stop on goal achievement, cleanup\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eSubagentStop\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eWhen a subagent finishes\u003c/td\u003e\u003ctd\u003eCollect and pass results\u003c/td\u003e\u003ctd\u003eFeed subagent output to parent workflow\u003c/td\u003e\u003c/tr\u003e\n    \u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eSessionEnd\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eBefore session closes\u003c/td\u003e\u003ctd\u003eFinal cleanup\u003c/td\u003e\u003ctd\u003eGenerate reports, archive logs, notifications\u003c/td\u003e\u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003eThis table is deceptive because it makes them look independent. They're not. Understanding the firing sequence is the foundation of hooks that actually work.\u003c/p\u003e\n\u003cp\u003eOne note before we go deeper: the JSON in this guide is a conceptual pseudo-schema, written to make each hook's \u003cem\u003eresponsibility\u003c/em\u003e obvious. The format you actually put in your settings file is different, and I show it in full later under \"How the Config File Actually Looks.\" Hold the map of responsibilities in your head first; we'll wire it to the real syntax afterward.\u003c/p\u003e\n2b:[[\"$\",\"div\",null,{\"className\":\"article-content\",\"dangerouslySetInnerHTML\":{\"__html\":\"$31\"}}],\"$L32\",\"$L33\",\"$L34\"]\n2c:[\"$\",\"$L35\",null,{\"title\":\"Claude Code Hooks: A Complete Field Guide to All 8 Hook Types and How to Pick the Right One\",\"url\":\"https://claudelab.net/en/articles/claude-code/claude-code-hooks-complete-guide-2026\",\"tags\":[\"Claude Code\",\"Hooks\",\"Automation\",\"Workflow\",\"Practical Guide\",\"Agent Design\"],\"siteName\":\"ClaudeLab\"}]\n2d:[\"$\",\"section\",null,{\"id\":\"membership-cta\",\"style\":{\"marginTop\":48,\"marginBottom\":32,\"padding\":\"32px 28px\",\"borderRadius\":12,\"border\":\"1px solid var(--border-subtle)\",\"background\":\"var(--bg-surface)\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":17,\"fontWeight\":600,\"color\":\"var(--text-primary)\",\"marginBottom\":8},\"children\":\"Thank You for Reading\"}],[\"$\",\"p\",null,{\"style\":{\"fontSize\":14,\"color\":\"var(--text-muted)\",\"lineHeight\":1.7,\"marginBottom\":16},\"children\":\"Claude Lab is ad-free, supported entirely by members like you. We publish practical guides daily with implementation code, benchmarks, and production-ready patterns. If you've found it useful, we'd love to have you on board.\"}],[\"$\",\"ul\",null,{\"style\":{\"listStyle\":\"none\",\"padding\":0,\"margin\":\"0 0 20px 0\",\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":6},\"children\":[[\"$\",\"li\",\"Copy-paste ready implementation code\",{\"style\":{\"fontSize\":13,\"color\":\"var(--text-dim)\",\"paddingLeft\":20,\"position\":\"relative\"},\"children\":[[\"$\",\"span\",null,{\"style\":{\"position\":\"absolute\",\"left\":0,\"color\":\"var(--accent-coral)\"},\"children\":\"✦\"}],\"Copy-paste ready implementation code\"]}],[\"$\",\"li\",\"New advanced guides published daily\",{\"style\":{\"fontSize\":13,\"color\":\"var(--text-dim)\",\"paddingLeft\":20,\"position\":\"relative\"},\"children\":[[\"$\",\"span\",null,{\"style\":{\"position\":\"abs"])</script><script>self.__next_f.push([1,"olute\",\"left\":0,\"color\":\"var(--accent-coral)\"},\"children\":\"✦\"}],\"New advanced guides published daily\"]}],[\"$\",\"li\",\"$$5/mo or $15 for lifetime access\",{\"style\":{\"fontSize\":13,\"color\":\"var(--text-dim)\",\"paddingLeft\":20,\"position\":\"relative\"},\"children\":[[\"$\",\"span\",null,{\"style\":{\"position\":\"absolute\",\"left\":0,\"color\":\"var(--accent-coral)\"},\"children\":\"✦\"}],\"$$5/mo or $15 for lifetime access\"]}]]}],\"$undefined\",[\"$\",\"a\",null,{\"href\":\"/en/membership\",\"style\":{\"display\":\"inline-block\",\"fontSize\":13,\"fontWeight\":600,\"color\":\"var(--accent-coral)\",\"textDecoration\":\"none\",\"padding\":\"8px 20px\",\"borderRadius\":6,\"border\":\"1px solid color-mix(in srgb, var(--accent-coral) 40%, transparent)\",\"background\":\"color-mix(in srgb, var(--accent-coral) 6%, transparent)\",\"transition\":\"background 0.2s\"},\"children\":\"View Membership →\"}]]}]\n2e:[\"$\",\"div\",null,{\"style\":{\"marginTop\":64,\"paddingTop\":32,\"borderTop\":\"1px solid var(--border-subtle)\"},\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":600,\"color\":\"var(--text-primary)\",\"fontFamily\":\"'DM Mono', monospace\",\"letterSpacing\":\"0.04em\",\"marginBottom\":20},\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":12},\"children\":[[\"$\",\"a\",\"claude-code-hooks-showcase-guide\",{\"href\":\"/en/articles/claude-code/claude-code-hooks-showcase-guide\",\"style\":{\"display\":\"block\",\"padding\":\"16px 20px\",\"borderRadius\":8,\"border\":\"1px solid var(--border-subtle)\",\"textDecoration\":\"none\",\"transition\":\"border-color 0.2s ease, background 0.2s ease\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":8,\"marginBottom\":6},\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"color\":\"var(--accent-blue)\",\"fontFamily\":\"'DM Mono', monospace\"},\"children\":[\"⟐\",\" \",\"Claude Code\"]}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"color\":\"var(--text-faint)\"},\"children\":\"2026-04-02\"}]]}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":600,\"color\":\"var(--text-primary)\",\"lineHeight\":1.5,\"marginBottom\":4},\"children\":\"Claude Code Hooks: Building Automated Workflows in Practice\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":12,\"color\":\"var(--text-muted)\",\"lineHeight\":1.6,\"overflow\":\"hidden\",\"textOverflow\":\"ellipsis\",\"whiteSpace\":\"nowrap\"},\"children\":\"A systematic guide to Claude Code Hooks. Learn how to use PreToolUse, PostToolUse, Stop, and Notification hooks to automate code quality checks, logging, notifications, and more.\"}]]}],[\"$\",\"a\",\"claude-code-subagent-stop-hook-rubric-regrade-loop\",{\"href\":\"/en/articles/claude-code/claude-code-subagent-stop-hook-rubric-regrade-loop\",\"style\":{\"display\":\"block\",\"padding\":\"16px 20px\",\"borderRadius\":8,\"border\":\"1px solid var(--border-subtle)\",\"textDecoration\":\"none\",\"transition\":\"border-color 0.2s ease, background 0.2s ease\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"alignItems\":\"center\",\"gap\":8,\"marginBottom\":6},\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"color\":\"var(--accent-blue)\",\"fontFamily\":\"'DM Mono', monospace\"},\"children\":[\"⟐\",\" \",\"Claude Code\"]}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"color\":\"var(--text-faint)\"},\"children\":\"2026-06-14\"}]]}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":600,\"color\":\"var(--text-primary)\",\"lineHeight\":1.5,\"marginBottom\":4},\"children\":\"A SubagentStop Hook That Grades Subagent Output and Sends It Back to Be Redone\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":12,\"color\":\"var(--text-muted)\",\"lineHeight\":1.6,\"overflow\":\"hidden\",\"textOverflow\":\"ellipsis\",\"whiteSpace\":\"nowrap\"},\"children\":\"When a Claude Code subagent occasionally returns rule-breaking work, a SubagentStop hook can grade it automatically and ask for a redo. Here is a working setup with code and field notes.\"}]]}],[\"$\",\"a\",\"claude-code-hooks-zero-touch-review\",{\"href\":\"/en/articles/claude-code/claude-code-hooks-zero-touch-review\",\"style\":{\"display\":\"block\",\"padding\":\"16px 20px\",\"borderRadius\":8,\"border\":\"1px solid var(--border-subtle)\",\"textDecoration\":\"none\",\"transition\":\"border-color 0.2s ease, background 0.2s ease\"},\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"a"])</script><script>self.__next_f.push([1,"lignItems\":\"center\",\"gap\":8,\"marginBottom\":6},\"children\":[[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"color\":\"var(--accent-blue)\",\"fontFamily\":\"'DM Mono', monospace\"},\"children\":[\"⟐\",\" \",\"Claude Code\"]}],[\"$\",\"span\",null,{\"style\":{\"fontSize\":11,\"color\":\"var(--text-faint)\"},\"children\":\"2026-05-05\"}]]}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":600,\"color\":\"var(--text-primary)\",\"lineHeight\":1.5,\"marginBottom\":4},\"children\":\"Building a Zero-Touch Code Review Environment with Claude Code Hooks\"}],[\"$\",\"div\",null,{\"style\":{\"fontSize\":12,\"color\":\"var(--text-muted)\",\"lineHeight\":1.6,\"overflow\":\"hidden\",\"textOverflow\":\"ellipsis\",\"whiteSpace\":\"nowrap\"},\"children\":\"Learn how to use Claude Code's hook system to automatically review code on every tool execution. Covers PostToolUse, Stop hooks, and the pitfalls to avoid when implementing PreToolUse blockers.\"}]]}]]}]]}]\n2f:[\"$\",\"$L36\",null,{\"locale\":\"en\",\"category\":\"claude-code\"}]\n37:I[41386,[\"/_next/static/chunks/00c6dc972055b57c.js\",\"/_next/static/chunks/7e24b3ef1c24e7bb.js\",\"/_next/static/chunks/38a3667eeacd959d.js\",\"/_next/static/chunks/39f4eed4390ecac0.js\"],\"PremiumPaywall\"]\n38:I[98141,[\"/_next/static/chunks/00c6dc972055b57c.js\",\"/_next/static/chunks/7e24b3ef1c24e7bb.js\",\"/_next/static/chunks/38a3667eeacd959d.js\",\"/_next/static/chunks/39f4eed4390ecac0.js\"],\"SingleArticleCTA\"]\n32:[\"$\",\"$L37\",null,{\"locale\":\"en\",\"highlights\":[\"The real hooks config format in settings.json — matcher, command, the stdin JSON contract, and exit code 2 to block — not the conceptual pseudo-schema\",\"The firing order of all 8 hooks, and why environment variables don't survive between PreToolUse and PostToolUse (with the fix)\",\"Measured per-tool overhead that hooks add, and the latency budget that keeps them from getting in the way\"]}]\n33:[\"$\",\"$L38\",null,{\"locale\":\"en\",\"slug\":\"claude-code-hooks-complete-guide-2026\",\"category\":\"claude-code\"}]\n39:T1546a,\u003ch2 id=\"section-2\"\u003eThe Hook Firing Sequence (Critical)\u003c/h2\u003e\n\u003cp\u003eHooks fire in this order:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\u003cstrong\u003eSessionStart\u003c/strong\u003e — Once per session, first thing\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eUserPromptSubmit\u003c/strong\u003e — Every time the user sends a message\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePreToolUse\u003c/strong\u003e — Before each tool call\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePostToolUse\u003c/strong\u003e — After each tool call (on success)\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eNotification\u003c/strong\u003e — Any time during the flow, runs in parallel\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eStop\u003c/strong\u003e — Evaluated at completion checks\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSessionEnd\u003c/strong\u003e — Once, at the very end\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eSubagents have their own sequence within the parent sequence.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eThis ordering matters more than anything else.\u003c/strong\u003e Skip this section and you'll spend days debugging mysterious failures.\u003c/p\u003e\n\u003cp\u003eThe reason I emphasize this: I once set environment variables in PreToolUse, expecting them to be available in PostToolUse. They weren't. Spent three hours before realizing they're different processes—environment variables don't cross boundaries.\u003c/p\u003e\n\u003ch2 id=\"section-3\"\u003ePreToolUse vs PostToolUse: The Foundational Distinction\u003c/h2\u003e\n\u003cp\u003eYou'll use these two constantly. Getting them right means 80% of your automation works.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003ePreToolUse: Runs before the tool.\u003c/strong\u003e Use it for \"should I even run this?\"\u003c/p\u003e\n\u003cp\u003eExample: before running \u003ccode\u003enpm install\u003c/code\u003e, check if package-lock.json is corrupted. If it is, regenerate it first. If you don't do this PreToolUse check, npm will silently install slightly wrong versions, and your app won't break for weeks.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PreToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-da"])</script><script>self.__next_f.push([1,"rk:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"npm\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"validations\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"verify_package_lock\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"check_for_conflicts\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"block_if_corrupted\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003e\u003cstrong\u003ePostToolUse: Runs after the tool.\u003c/strong\u003e Use it for \"did that actually work?\"\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PostToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"npm\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"validation\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"check_for_warnings\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"run_audit\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"fail_if_vulnerabilities\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003e\u003cstrong\u003eThe critical distinction:\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003ePreToolUse\u003c/strong\u003e prevents bad things from starting\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePostToolUse\u003c/strong\u003e catches problems after they happened\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eBeg"])</script><script>self.__next_f.push([1,"inners often run the same check in both. That's wasteful. Pick one.\u003c/p\u003e\n\u003cp\u003e\"Should we run this git commit?\" → PreToolUse (check uncommitted changes).\u003c/p\u003e\n\u003cp\u003e\"Did the git commit actually work?\" → PostToolUse (verify files were staged correctly).\u003c/p\u003e\n\u003cp\u003eReal production example: git push with GPG signing.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PreToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"git\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"validations\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"check_gpg_key_available\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"check_git_user_configured\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"verify_branch_protection\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"block_if_preconditions_fail\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PostToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"git\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"validation\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"verify_signature\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5"])</script><script>self.__next_f.push([1,"\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"check_remote_acceptance\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"report_if_unsigned_detected\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eWhen you push to a GPG-protected branch, PreToolUse verifies your key exists before attempting the push. PostToolUse verifies the remote actually accepted your signature.\u003c/p\u003e\n\u003ch2 id=\"section-4\"\u003eUserPromptSubmit: Input Processing and Security\u003c/h2\u003e\n\u003cp\u003eThis fires when the user sends a message, before Claude Code processes it. Use it to clean, validate, or enrich user input.\u003c/p\u003e\n\u003cp\u003eReal example: users sometimes paste code snippets. That code might use imports that aren't installed. Catch that \u003cem\u003ebefore\u003c/em\u003e Claude Code tries to run it.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"UserPromptSubmit\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"validation\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"detect_code_blocks\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"parse_imports\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"verify_dependencies\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"if_missing_deps\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"auto_suggest_install\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"if_syntax_error\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"ask_user_to_fix\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eAnot"])</script><script>self.__next_f.push([1,"her critical use: security. Detect if user input looks like injection attacks.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"UserPromptSubmit\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"security\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"detect_sql_injection\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"detect_shell_injection\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"detect_prompt_injection\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"if_high_risk\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"block_and_warn\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"if_medium_risk\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"ask_confirmation\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eReal injection example: user pastes SQL from a bug report.\u003c/p\u003e\n\u003cpre\u003e\u003ccode\u003eQuery: SELECT * FROM users WHERE id = 'x' OR '1'='1'\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eA good UserPromptSubmit hook detects this pattern and alerts before Claude Code tries to execute it. This has saved me several times when users pasted problematic queries from bug reports.\u003c/p\u003e\n\u003cp\u003eYou can also use this hook to inject context. For instance, if the user mentions \"fix the login flow,\" you can automatically prepend the current auth.ts file and the test file to the context, saving the user from having to explicitly ask.\u003c/p\u003e\n\u003ch2 id=\"section-5\"\u003eStop vs SubagentStop: Don't Confuse These\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eStop\u003c/strong\u003e: End the \u003cem\u003eentire session\u003c/em\u003e.\u003c/p\u003e\n\u003cp\u003eUse it when the goal is accomplished. All tests pass, coverage is above 80%, no errors. Stop here.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-lig"])</script><script>self.__next_f.push([1,"ht:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"Stop\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"condition\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"all_tests_passed\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"coverage_threshold\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003e80\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"no_critical_errors\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"auto_end_session\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eThis hook is useful for fully automated workflows. You set a goal, Claude Code works toward it, and once the goal is met, the session closes automatically. No user intervention needed.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSubagentStop\u003c/strong\u003e: End just \u003cem\u003eone subagent\u003c/em\u003e, then feed its results back to the parent.\u003c/p\u003e\n\u003cp\u003eUse it for parallel work. \"Backend development subagent is done. Send results to frontend development subagent.\"\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"SubagentStop\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"subagent_id\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"backend-api\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"condition\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"api_endpoints_complete\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"integration_tests_passing\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shi"])</script><script>self.__next_f.push([1,"ki-light:#005CC5\"\u003e    \"notify_parent\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"pass_results_to\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"frontend-integration\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"trigger_e2e_tests\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eThis is for complex parallel workflows. Imagine you're building a full-stack app. You might have:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eBackend subagent: API, database, middleware\u003c/li\u003e\n\u003cli\u003eFrontend subagent: UI, form validation, state management\u003c/li\u003e\n\u003cli\u003eIntegration subagent: E2E tests, deployment scripts\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eSubagentStop lets you orchestrate these workflows. When backend finishes, notify the integration subagent. When frontend finishes, trigger E2E tests.\u003c/p\u003e\n\u003cp\u003eConfusing these means:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eUsing SubagentStop when you meant Stop → session keeps running, extra unexpected work happens\u003c/li\u003e\n\u003cli\u003eUsing Stop when you meant SubagentStop → parallel work stops prematurely\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eI learned this the hard way. I had a backend subagent finish, but used Stop instead of SubagentStop. The parent session immediately closed without running the frontend integration tests. Took me an hour to realize the order was wrong.\u003c/p\u003e\n\u003ch2 id=\"section-6\"\u003eSessionStart and SessionEnd: Environment Bookends\u003c/h2\u003e\n\u003cp\u003e\u003cstrong\u003eSessionStart\u003c/strong\u003e: Runs first, before anything else. Initialize the environment.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"SessionStart\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"initialization\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"check_node_version\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"18.0.0\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"install_dependencies\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"create_env_files\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \".env.local\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e        \"NODE_ENV\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cs"])</script><script>self.__next_f.push([1,"pan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"development\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e        \"DEBUG\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"true\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e      }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e    },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"run_checks\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: [\u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"git-status\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"npm-audit\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e]\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eSessionStart is where you set up everything Claude Code needs before touching your code. Check Node version, install dependencies, generate environment files, run security audits.\u003c/p\u003e\n\u003cp\u003eThe power here is that Claude Code never makes the mistake of \"oh, I needed Node 18 but only 16 is installed.\" You're baking in those requirements upfront.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSessionEnd\u003c/strong\u003e: Runs last, before the session closes. Cleanup and reporting.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"SessionEnd\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"generate_final_report\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"include_in_report\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: [\u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"files_created\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"tests_run\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"duration\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e],\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"send_email_to\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"team@example.com\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"archive_session_logs\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:"])</script><script>self.__next_f.push([1,"#8DDB8C;--shiki-light:#005CC5\"\u003e    \"cleanup_temp_files\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eSessionEnd is where you clean up and report results. Generate a summary of what was done, send it to stakeholders, archive logs for auditing, delete temporary files.\u003c/p\u003e\n\u003cp\u003eThis is useful for compliance. If your workflow touches production or sensitive data, SessionEnd lets you ensure all audit trails are preserved before the session closes.\u003c/p\u003e\n\u003ch2 id=\"section-7\"\u003eNotification: Fire and Forget External Communication\u003c/h2\u003e\n\u003cp\u003eSend data to external systems. Slack, email, webhooks—doesn't matter. This hook fires independently and doesn't block the session.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"Notification\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"trigger\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"on_git_commit\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"condition\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"branch\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"main\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"commit_message\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"feat:|fix:\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  },\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"notification\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"slack\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"webhook\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"${SLACK_WEBHOOK_URL}\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"message\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"channel\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"#deployments\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005"])</script><script>self.__next_f.push([1,"CC5\"\u003e      \"text\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"Committed to main: {commit_message}\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"attachments\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e        {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e          \"fields\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e            {\u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"title\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"Author\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"value\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"{git_author}\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"short\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e},\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e            {\u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"title\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"Timestamp\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"value\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"{timestamp}\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"short\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e          ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e        }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e      ]\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e    }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eNotifications are async, so they don't slow down your workflow. They're also independent—multiple notifications can fire simultaneously.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eCritical security rule\u003c/strong\u003e: Never hardcode API keys. Always use environment variables.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"webhook\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"${SLACK_WEBHOOK_URL}\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan st"])</script><script>self.__next_f.push([1,"yle=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"auth_token\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"${GITHUB_TOKEN}\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eI've used Notification hooks for several things:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eAlert on branch protection violations\u003c/li\u003e\n\u003cli\u003eNotify on test failures\u003c/li\u003e\n\u003cli\u003eLog successful deployments to #infrastructure\u003c/li\u003e\n\u003cli\u003eSend daily summaries of automated work\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"section-8\"\u003eThree Production Traps I Hit (And How to Avoid Them)\u003c/h2\u003e\n\u003ch3 id=\"section-9\"\u003eTrap 1: Misunderstanding Hook Firing Order\u003c/h3\u003e\n\u003cp\u003eHooks don't fire simultaneously. They fire in a strict sequence:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eSessionStart\u003c/li\u003e\n\u003cli\u003eUserPromptSubmit\u003c/li\u003e\n\u003cli\u003ePreToolUse\u003c/li\u003e\n\u003cli\u003ePostToolUse (only if tool succeeds)\u003c/li\u003e\n\u003cli\u003eNotification (parallel)\u003c/li\u003e\n\u003cli\u003eStop (evaluated)\u003c/li\u003e\n\u003cli\u003eSessionEnd\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eI once set an environment variable in PreToolUse and tried to use it in PostToolUse. It was undefined. Why? Because PreToolUse runs in \u003cem\u003eone subprocess\u003c/em\u003e and PostToolUse runs in \u003cem\u003ea different subprocess\u003c/em\u003e. Environment variables don't cross subprocess boundaries.\u003c/p\u003e\n\u003cp\u003eReal bug I hit:\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PreToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"npm\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"command\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"export NPM_REGISTRY='https://private.registry.com'\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PostToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"npm\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"command\"\u003c/span\u003e\u003cspan styl"])</script><script>self.__next_f.push([1,"e=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"npm view {package} registry\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eThe second hook couldn't see the registry URL set in the first hook because they're different processes.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSolution\u003c/strong\u003e: Save state to a file instead of relying on process-level variables.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PreToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"write_state\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"file\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\".hook-state.json\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"data\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e\"NPM_REGISTRY\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"https://private.registry.com\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e    }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PostToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"read_state\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"file\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\".hook-state.json\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e    }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADB"])</script><script>self.__next_f.push([1,"AC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eNow both hooks can read the same state file.\u003c/p\u003e\n\u003ch3 id=\"section-10\"\u003eTrap 2: Async Wait Timeouts in Long-Running Tasks\u003c/h3\u003e\n\u003cp\u003eIf your hook makes an async call (API request, database query, CI status check), Claude Code will wait. But only for a configurable limit. Exceed it and the session times out.\u003c/p\u003e\n\u003cp\u003eI wrote a hook to wait for CI to finish after a git push. 30 seconds in the test repo, no problem. On a real project with a 20-minute CI pipeline, the session timed out.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PostToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"git\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"action\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e    \"wait_for_ci_completion\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"poll_interval\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003e10\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"max_wait_seconds\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003e300\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"on_timeout\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"continue_async\"\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e    }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e  }\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eThe \u003ccode\u003eon_timeout\u003c/code\u003e action is critical. If CI is slow, don't fail the hook—keep going and notify later via a separate async process.\u003c/p\u003e\n\u003cp\u003eAnother approach: split the work. PreToolUse triggers the CI build. PostToolUse checks if it's done, but doesn't wait. A separate background job checks later and notifies.\u003c/p\u003e\n\u003cp\u003eIf it's the literal \u003ccode\u003ecommand timed out\u003c/code\u003e failure you're chasing rather than the design, I walk through the timeout setting and splitting long work in \u003ca href=\"/articles/claude-code/claude-code-hook-command-timed-out-fix\"\u003eWhen a Claude Code hook fails with \"command timed out\"\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"section-11\"\u003eTrap 3: Hook Interdependency Loops\u003c/h3\u003e\n\u003cp\u003eComplex setups use multiple hooks, each feeding output to the next. But if the dependencies form a loop, you get infinite recursion.\u003c/p\u003e\n\u003cp\u003eReal bug I hit:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eUserPromptSubmit transforms \"git push\" → \"git push -f\"\u003c/li\u003e\n\u003cli\u003ePreToolUse detects \"-f\" is risky, transforms back to \"git push\"\u003c/li\u003e\n\u003cli\u003ePostToolUse sees failure, tries \"git push -f\" again\u003c/li\u003e\n\u003cli\u003ePreToolUse blocks again\u003c/"])</script><script>self.__next_f.push([1,"li\u003e\n\u003cli\u003eLoop forever\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eSolution\u003c/strong\u003e: Explicitly mark which keys each hook owns. Prevent one hook from undoing another's work.\u003c/p\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"UserPromptSubmit\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"output_key\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"user_input_raw\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"protected_keys\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: [\u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"validation_state\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"retry_count\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e]\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PreToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"input_key\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"user_input_raw\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"output_key\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"command_validated\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"check_protected_keys\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\u003c/figure\u003e\n\u003cp\u003eEach hook declares: \"I read from X, I write to Y, don't touch Z.\" That prevents loops.\u003c/p\u003e\n\u003cp\u003eThe specific case where PostToolUse re-fires on its own output has its own writeup with a reproduction and fix: \u003ca href=\"/articles/claude-code/claude-code-hooks-infinite-loop-fix\"\u003eWhen Claude Code Hooks loop forever — stopping PostToolUse from self-triggering\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"section-12\"\u003eReady-to-Use Templates\u003c/h2\u003e\n\u003ch3 id=\"section-13\"\u003eTemplate 1: Security Gate for Git Push to Main\u003c/h3\u003e\n\u003cfigure data-rehype-pretty-code-figure=\"\"\u003e\u003cpre tabindex=\"0\" data-language=\"json\" data-theme=\"github-dark-dimmed github-light\"\u003e\u003ccode data-language=\"json\" data-theme=\"github-dark-dimmed github-light\" style=\"display: grid;\"\u003e\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e{\u003c/span\u003e\u003c"])</script><script>self.__next_f.push([1,"/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e  \"hooks\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: [\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e    {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"hook_type\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"PreToolUse\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"event\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"git\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"condition\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#96D0FF;--shiki-light:#032F62\"\u003e\"command == 'push' \u0026#x26;\u0026#x26; branch == 'main'\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e      \"validations\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: {\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e        \"require_review\"\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e: \u003c/span\u003e\u003cspan style=\"--shiki-dark:#6CB6FF;--shiki-light:#005CC5\"\u003etrue\u003c/span\u003e\u003cspan style=\"--shiki-dark:#ADBAC7;--shiki-light:#24292E\"\u003e,\u003c/span\u003e\u003c/span\u003e\n\u003cspan data-line=\"\"\u003e\u003cspan style=\"--shiki-dark:#8DDB8C;--shiki-light:#005CC5\"\u003e        \"block_force