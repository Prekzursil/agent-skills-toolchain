  <script type="application/ld+json">{"@context":"https://schema.org","@type":"BlogPosting","headline":"LangGraph Human in the Loop: A Complete Tutorial (With Production Considerations)","description":"Learn how LangGraph's interrupt() function works for human-in-the-loop agents, with working Python code and a guide to production limitations.","url":"https://thehandover.xyz/blog/langgraph-human-in-the-loop-tutorial","datePublished":"2026-04-12","author":{"@type":"Organization","name":"The Handover","url":"https://thehandover.xyz"},"publisher":{"@type":"Organization","name":"The Handover","url":"https://thehandover.xyz"}}</script>
  
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    
    :root {
      /* Brand palette — sage on warm paper. See design/colors_and_type.css. */
      --sage-950:#1A2716; --sage-900:#2A3A24; --sage-800:#3B4E34; --sage-700:#4A6141;
      --sage-600:#5A7350; --sage-500:#6D8563; --sage-400:#8AA07F; --sage-300:#A9BC9F;
      --sage-200:#C9D6C1; --sage-100:#E3ECDD; --sage-50:#F1F5ED;  --sage-25:#F8FAF5;

      --ink-950:#10140E; --ink-900:#1C211A; --ink-800:#2B312A; --ink-700:#3E453C;
      --ink-600:#545B52; --ink-500:#6E756B; --ink-400:#8E9489; --ink-300:#B4B9B0;
      --ink-200:#D4D8D0; --ink-100:#E8EAE4; --ink-50:#F3F4EE;

      --paper:#FAFAF5; --paper-pure:#FFFFFF;
      --amber-600:#B4812A; --amber-100:#F5E8C8;
      --red-600:#A83A2A;   --red-100:#F2D7D1;
      --blue-600:#3A5A7A;  --blue-100:#D5E0EA;

      /* Legacy aliases — keep component styles working after the repaint. */
      --surface-0:#FAFAF5;
      --surface-1:#FFFFFF;
      --surface-2:#F8FAF5;
      --surface-3:#E8EAE4;

      --border:        #D4D8D0;
      --border-subtle: #E8EAE4;
      --border-brand:  #C9D6C1;

      --text-primary:   #10140E;
      --text-secondary: #545B52;
      --text-muted:     #8E9489;

      /* Marketing kit aliases (match design/colors_and_type.css naming). */
      --fg:        #10140E;
      --fg-muted:  #545B52;
      --fg-subtle: #8E9489;
      --fg-brand:  #4A6141;
      --bg:         #FAFAF5;
      --surface:    #FFFFFF;

      --accent:      #5A7350;
      --accent-soft: #E3ECDD;
      --accent-hover:#4A6141;

      --success: #4A6141;
      --danger:  #A83A2A;
      --warning: #B4812A;
      --info:    #3A5A7A;

      /* Status pill backgrounds — used by dashboard tables on light. */
      --status-pending-bg: #F5E8C8;
      --status-approved-bg:#E3ECDD;
      --status-denied-bg:  #F2D7D1;
      --key-reveal-bg:     #E3ECDD;
      --row-divider:       #E8EAE4;

      /* Nav bg used by sticky scroll state. */
      --nav-scroll-bg: rgba(250,250,245,.82);

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-xl: 20px;

      /* Typography stacks */
      --font-sans:  'Geist', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
      --font-serif: 'Instrument Serif', ui-serif, Georgia, serif;
      --font-mono:  'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

      /* Motion */
      --ease-out:    cubic-bezier(0.22, 1, 0.36, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --dur-fast:    160ms;
      --dur-base:    240ms;
      --dur-slow:    420ms;

      /* Shadows — soft, slightly greenish ambient */
      --shadow-xs: 0 1px 2px rgba(26,39,22,.04);
      --shadow-sm: 0 1px 3px rgba(26,39,22,.06), 0 1px 2px rgba(26,39,22,.04);
      --shadow-md: 0 4px 12px rgba(26,39,22,.07), 0 2px 4px rgba(26,39,22,.04);
      --shadow-lg: 0 12px 32px rgba(26,39,22,.10), 0 4px 8px rgba(26,39,22,.05);
      --shadow-xl: 0 24px 60px rgba(26,39,22,.14), 0 8px 16px rgba(26,39,22,.06);
    }
    ::selection { background: var(--sage-200); color: var(--sage-900); }

    /* ---------- DARK theme ---------- */
    html[data-theme="dark"] {
      /* Marketing background pair (paper -> deep ink). */
      --paper:#10140E;
      --paper-pure:#1C211A;
      --bg:    #10140E;
      --surface:#1C211A;

      /* Inverted ink ramp — 50 was lightest, 950 was darkest; flip on dark
         so the same vars still mean "near the page color" vs. "deep contrast". */
      --ink-50:#10140E;  --ink-100:#1C211A; --ink-200:#2B312A; --ink-300:#3E453C;
      --ink-400:#545B52; --ink-500:#6E756B; --ink-600:#8E9489; --ink-700:#B4B9B0;
      --ink-800:#D4D8D0; --ink-900:#E8EAE4; --ink-950:#F3F4EE;

      /* Sage ramp — leave 600 as the brand mark; selection still readable. */
      --sage-25: #1A2716; --sage-50: #2A3A24; --sage-100:#3B4E34;
      --sage-200:#4A6141; --sage-300:#6D8563;

      /* Marketing semantic aliases on dark. */
      --fg:        #E8EAE4;
      --fg-muted:  #B4B9B0;
      --fg-subtle: #8E9489;
      --fg-brand:  #A9BC9F;

      --accent:      #8AA07F;
      --accent-soft: #2A3A24;
      --accent-hover:#A9BC9F;

      --success: #A9BC9F;
      --danger:  #D89D8F;
      --warning: #E3CCA1;
      --info:    #98B0C4;

      /* Legacy aliases — dashboard surfaces match the kit's oklch values. */
      --surface-0: #15191A;
      --surface-1: #1B2122;
      --surface-2: #232A2B;
      --surface-3: #2C3334;
      --border:        #38404F;
      --border-subtle: #2C3334;
      --border-brand:  #4A6141;
      --text-primary:   #E8E9EA;
      --text-secondary: #A2A8AE;
      --text-muted:     #7A8087;

      /* Status pill backgrounds — darker tinted bg + semantic text color. */
      --status-pending-bg: #3D331A;
      --status-approved-bg:#1F3326;
      --status-denied-bg:  #3A201C;
      --key-reveal-bg:     #1F3326;
      --row-divider:       #1F2425;

      --nav-scroll-bg: rgba(16, 20, 14, .82);

      --shadow-xs: 0 1px 2px rgba(0,0,0,.40);
      --shadow-sm: 0 1px 3px rgba(0,0,0,.45), 0 1px 2px rgba(0,0,0,.30);
      --shadow-md: 0 4px 12px rgba(0,0,0,.50), 0 2px 4px rgba(0,0,0,.30);
      --shadow-lg: 0 12px 32px rgba(0,0,0,.55), 0 4px 8px rgba(0,0,0,.35);
      --shadow-xl: 0 24px 60px rgba(0,0,0,.65), 0 8px 16px rgba(0,0,0,.40);
    }
    html, body { transition: background-color .25s var(--ease-out), color .25s var(--ease-out); }

    
    html, body {
      font-family: var(--font-sans);
      background: var(--paper);
      color: var(--fg);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    a { color: var(--sage-700); text-decoration-color: var(--sage-300); text-underline-offset: 2px; }
    a:hover { color: var(--sage-800); text-decoration-color: var(--sage-600); }
    html[data-theme="dark"] a { color: var(--sage-300); text-decoration-color: var(--sage-200); }
    html[data-theme="dark"] a:hover { color: var(--accent-hover); }
    code, pre, kbd, samp { font-family: var(--font-mono); font-feature-settings: 'zero' 1, 'ss01' 1; }
    button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--sage-600);
    }

    
    /* ---------- display type ---------- */
    .display-serif { font-family: var(--font-sans); font-weight: 500; font-size: 76px; line-height: 1.02; letter-spacing: -.03em; margin: 24px auto 24px; max-width: 920px; text-wrap: balance }
    .display-serif em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--sage-700) }
    html[data-theme="dark"] .display-serif em { color: var(--sage-300) }
    .lede { font-size: 18px; line-height: 1.55; color: var(--fg-muted); margin: 0 auto; text-wrap: pretty }
    .eyebrow { font-size: 12px; text-transform: uppercase; letter-spacing: .12em; font-weight: 500; color: var(--sage-700); margin-bottom: 14px }
    html[data-theme="dark"] .eyebrow { color: var(--sage-300) }
    .eyebrow-row { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px; border: 1px solid var(--border); background: var(--surface); border-radius: 999px; color: var(--sage-700); font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase }
    html[data-theme="dark"] .eyebrow-row { color: var(--sage-300) }
    .section-title { font-size: 52px; font-weight: 500; letter-spacing: -.025em; line-height: 1.04; margin: 0 0 40px; text-wrap: balance; max-width: 760px }
    .section-title em { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--sage-700) }
    html[data-theme="dark"] .section-title em { color: var(--sage-300) }
    .section-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px }
    .body-sm { font-size: 13px; color: var(--fg-muted); line-height: 1.6 }

    /* ---------- nav ---------- */
    .mkt-nav { position: sticky; top: 0; z-index: 40; transition: all .3s var(--ease-out); background: transparent }
    .mkt-nav.nav-scrolled { background: var(--nav-scroll-bg); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border) }
    .mkt-nav-inner { max-width: 1200px; margin: 0 auto; padding: 18px 32px; display: flex; align-items: center; justify-content: space-between; gap: 24px }
    .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg) }
    .brand-mark { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background: var(--sage-600); border-radius: 8px; padding: 3px }
    .brand-mark img { width: 100%; height: 100%; object-fit: contain; filter: brightness(0) invert(1) }
    .brand-name { font-family: var(--font-sans); font-weight: 500; font-size: 15px; letter-spacing: -.01em }
    .nav-links { display: flex; gap: 28px }
    .nav-links a { color: var(--fg-muted); font-size: 14px; text-decoration: none; transition: color .2s }
    .nav-links a:hover { color: var(--fg) }
    .nav-cta { display: inline-flex; align-items: center; gap: 10px }
    .brand-mark-spin img { animation: swirl 8s linear infinite }
    @keyframes swirl { to { transform: rotate(360deg) } }

    
    .theme-toggle {
      background: transparent; border: 1px solid var(--border); border-radius: 8px;
      cursor: pointer; color: var(--fg-muted); padding: 7px 8px;
      display: inline-flex; align-items: center; line-height: 1;
      transition: color .15s, border-color .15s, background .15s;
    }
    .theme-toggle:hover { color: var(--fg); border-color: var(--ink-300); background: var(--paper); }
    .theme-toggle .icon-moon { display: none; }
    html[data-theme="dark"] .theme-toggle .icon-sun { display: none; }
    html[data-theme="dark"] .theme-toggle .icon-moon { display: inline-flex; }


    /* ---------- buttons ---------- */
    .btn-mkt { font-family: var(--font-sans); font-size: 14px; font-weight: 500; padding: 11px 18px; border-radius: 10px; border: 1px solid transparent; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; transition: all .24s var(--ease-out); line-height: 1 }
    .btn-mkt.btn-primary { background: var(--sage-600); color: #fff }
    .btn-mkt.btn-primary:hover { background: var(--sage-700); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(90,115,80,.25) }
    .btn-mkt.btn-secondary { background: var(--surface); color: var(--fg); border-color: var(--ink-200) }
    .btn-mkt.btn-secondary:hover { background: var(--paper); border-color: var(--ink-300) }
    .btn-mkt.btn-ghost { background: transparent; color: var(--fg-muted) }
    .btn-mkt.btn-ghost:hover { background: var(--ink-50); color: var(--fg) }
    .btn-mkt.btn-sm { padding: 8px 13px; font-size: 13px; border-radius: 8px }
    .btn-mkt.btn-lg { padding: 14px 22px; font-size: 15px }

    /* ---------- chips ---------- */
    .chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font: 500 11px var(--font-sans) }
    .chip .dot { width: 6px; height: 6px; border-radius: 50% }
    .chip-approved { background: var(--sage-100); color: var(--sage-900) }
    .chip-approved .dot { background: var(--sage-600) }
    .chip-pending { background: var(--amber-100); color: #7E5A18 }
    .chip-pending .dot { background: var(--amber-600); animation: chip-pulse 1.6s ease-in-out infinite }
    @keyframes chip-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(180,129,42,.5) } 50% { box-shadow: 0 0 0 5px rgba(180,129,42,0) } }
    .chip-denied { background: var(--red-100); color: #6B231A }
    .chip-denied .dot { background: var(--red-600) }
    .chip-neutral { background: var(--ink-100); color: var(--ink-800) }
    .chip-sq { border-radius: 6px }
    html[data-theme="dark"] .chip-pending { background: #3D331A; color: #E3CCA1 }
    html[data-theme="dark"] .chip-denied { background: #3A201C; color: #D89D8F }
    html[data-theme="dark"] .chip-approved { background: #1F3326; color: #A9BC9F }

    /* ---------- footer ---------- */
    .mkt-footer { background: var(--sage-950); color: var(--sage-200); padding: 80px 0 40px; margin-top: 80px }
    .mkt-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 56px; border-bottom: 1px solid rgba(233,236,221,.1) }
    .mkt-footer h5 { font-size: 12px; font-weight: 500; color: var(--sage-300); text-transform: uppercase; letter-spacing: .12em; margin: 0 0 16px }
    .mkt-footer ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px }
    .mkt-footer a { color: var(--sage-100); font-size: 14px; text-decoration: none; transition: color .2s }
    .mkt-footer a:hover { color: #fff }
    .mkt-footer .brand-name { color: #fff }
    .mkt-footer .brand-mark { background: var(--sage-800) }
    .mkt-footer .body-sm { color: var(--sage-300) }
    .mkt-footer-bottom { padding-top: 24px; display: flex; justify-content: space-between; font-size: 12px; color: var(--sage-400) }
    .mkt-footer-bottom .mono { font-family: var(--font-mono) }

    /* ---------- reveal ---------- */
    .rise { opacity: 0; transform: translateY(14px); transition: opacity .7s var(--ease-out), transform .7s var(--ease-out) }
    .rise.on { opacity: 1; transform: translateY(0) }
    .reveal { opacity: 0; transform: translateY(16px); transition: opacity .7s var(--ease-out), transform .7s var(--ease-out) }
    .reveal.in { opacity: 1; transform: translateY(0) }

    @media (max-width: 900px) {
      .display-serif { font-size: 54px }
      .section-title { font-size: 38px }
      .nav-links { display: none }
      .mkt-footer-grid { grid-template-columns: 1fr 1fr }
    }

    .container { max-width: 760px; margin: 0 auto; padding: 0 24px }
    .container-wide { max-width: 1080px; margin: 0 auto; padding: 0 24px }
    code {
      font-family: var(--font-mono);
      font-size: 13px;
      background: var(--sage-50);
      padding: 2px 6px;
      border-radius: 4px;
      color: var(--sage-800);
    }
    html[data-theme="dark"] code {
      background: rgba(201, 214, 193, .12);
      color: var(--sage-200);
    }
    pre {
      background: var(--sage-950);
      border: 1px solid var(--sage-900);
      border-radius: 12px;
      padding: 22px;
      overflow-x: auto;
      margin: 20px 0;
    }
    html[data-theme="dark"] pre {
      background: #0F1610;
      border-color: #1F2A1B;
    }
    pre code {
      background: none;
      padding: 0;
      font-size: 13px;
      line-height: 1.7;
      color: #E3ECDD;
    }
    .kw { color: #C9D6C1 }
    .str { color: #E3CCA1 }
    .cmt { color: #6D8563; font-style: italic }
    .num { color: #D9B38C }
  </style>

  <style>
    .post-hero { padding: 64px 0 44px; border-bottom: 1px solid var(--ink-100) }
    .post-category {
      font-family: var(--font-mono); font-size: 12px; font-weight: 500;
      text-transform: uppercase; letter-spacing: .08em; color: var(--sage-700);
      margin-bottom: 18px; display: inline-block;
    }
    .post-hero h1 {
      font-family: var(--font-sans); font-size: clamp(30px, 4.3vw, 44px);
      font-weight: 500; letter-spacing: -.025em; line-height: 1.1;
      margin-bottom: 18px; color: var(--ink-900);
    }
    .post-hero h1 em {
      font-family: var(--font-serif); font-style: italic; font-weight: 400;
      color: var(--sage-700);
    }
    .post-hero-meta {
      font-family: var(--font-mono); font-size: 12px;
      color: var(--ink-500); text-transform: uppercase; letter-spacing: .06em;
    }
    .post-body { padding: 56px 0 }
    .post-body p { font-size: 16px; line-height: 1.78; color: var(--ink-700); margin-bottom: 20px }
    .post-body h2 {
      font-family: var(--font-sans); font-size: 26px; font-weight: 500;
      color: var(--ink-900); margin: 48px 0 16px; letter-spacing: -.02em; line-height: 1.3;
    }
    .post-body h3 {
      font-size: 18px; font-weight: 500; color: var(--ink-900);
      margin: 30px 0 10px; letter-spacing: -.01em;
    }
    .post-body ul, .post-body ol { margin: 0 0 22px 22px }
    .post-body li { font-size: 16px; line-height: 1.78; color: var(--ink-700); margin-bottom: 7px }
    .post-body strong { color: var(--ink-900); font-weight: 500 }
    .post-body a { color: var(--sage-700); text-decoration: underline; text-underline-offset: 3px }
    .post-body a:hover { color: var(--sage-800) }
    .post-body blockquote {
      border-left: 3px solid var(--sage-200); padding-left: 20px;
      margin: 24px 0; font-family: var(--font-serif); font-style: italic;
      font-size: 19px; color: var(--ink-700); line-height: 1.6;
    }
    .callout {
      background: var(--sage-25);
      border: 1px solid var(--sage-100);
      border-left: 3px solid var(--sage-600);
      border-radius: 0 10px 10px 0;
      padding: 16px 20px;
      margin: 22px 0;
    }
    .callout p { margin: 0; font-size: 15px; color: var(--ink-700); line-height: 1.7 }
    .callout li { color: var(--ink-700); }
    html[data-theme="dark"] .callout {
      background: rgba(201, 214, 193, .06);
      border-color: rgba(201, 214, 193, .14);
      border-left-color: var(--sage-300);
    }
    html[data-theme="dark"] .callout p,
    html[data-theme="dark"] .callout li { color: var(--ink-800); }
    html[data-theme="dark"] .callout strong { color: var(--ink-900); }
    .post-cta {
      background: var(--sage-25);
      border: 1px solid var(--sage-100);
      border-radius: 14px;
      padding: 36px;
      margin-top: 64px;
      text-align: center;
    }
    html[data-theme="dark"] .post-cta {
      background: rgba(201, 214, 193, .05);
      border-color: rgba(201, 214, 193, .14);
    }
    .post-cta h3 {
      font-size: 22px; font-weight: 500; letter-spacing: -.02em;
      margin-bottom: 8px; color: var(--ink-900);
    }
    .post-cta p { font-size: 15px; color: var(--ink-600); margin-bottom: 22px; line-height: 1.65 }
    .post-cta a {
      display: inline-block;
      background: var(--sage-600);
      color: #fff;
      padding: 12px 26px;
      border-radius: 10px;
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
      letter-spacing: -.005em;
      transition: background .18s, transform .18s;
      box-shadow: 0 1px 0 rgba(0,0,0,.04), 0 8px 22px -12px rgba(90,115,80,.38);
    }
