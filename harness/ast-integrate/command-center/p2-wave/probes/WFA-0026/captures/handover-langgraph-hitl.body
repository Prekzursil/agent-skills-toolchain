  <script>
  
  function toggleTheme(){
    var h=document.documentElement;
    var isDark=h.getAttribute('data-theme')==='dark';
    if(isDark){ h.removeAttribute('data-theme'); try{localStorage.setItem('theme','light')}catch(e){} }
    else{ h.setAttribute('data-theme','dark'); try{localStorage.setItem('theme','dark')}catch(e){} }
  }

  (function(){
    var nav = document.getElementById('mkt-nav');
    if (!nav) return;
    var on = function(){ nav.classList.toggle('nav-scrolled', window.scrollY > 20); };
    window.addEventListener('scroll', on, { passive: true });
    on();
  })();
</script>
