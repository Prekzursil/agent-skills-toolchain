{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0026/sweep_report.schema.json",
  "title": "WFA-0026 local SweepReport stand-in while WFA-0001 pack is absent from this tree",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "answer",
    "trust_grading_rule",
    "sources",
    "mechanisms",
    "tests",
    "reviewer",
    "evidence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0026" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "report_kind": { "type": "string", "const": "SweepReport" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "trust_grading_rule": {
      "type": "object",
      "required": ["rule_id", "sha256", "written_before_grading", "path"],
      "properties": {
        "rule_id": { "type": "string" },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "written_before_grading": { "type": "boolean", "const": true },
        "path": { "type": "string" }
      }
    },
    "sources": { "type": "array", "minItems": 3 },
    "mechanisms": { "type": "array", "minItems": 3 },
    "tests": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 4 },
        "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NOT-REVIEWED"] },
        "independent": { "type": "boolean" }
      }
    },
    "evidence": { "type": "array", "minItems": 4 }
  }
}
