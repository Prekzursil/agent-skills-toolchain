{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ast-integrate.local/command-center/p2-wave/probes/RES-0026/research-claim-record.local.schema.json",
  "title": "RES-0026 local research-claim-record discriminator",
  "description": "Per-unit discriminator used because catalog output_schema command-center/schema/research-claim-record.schema.json is absent (RES-0001). Rejects garbage and single-rail claims. Not a substitute for the shared family.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "claims",
    "control_table",
    "tests",
    "reviewer",
    "evidence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0026" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "claims": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "canonical_mechanism",
          "claim",
          "evidence_tier",
          "confidence_band",
          "source_lineage",
          "named_settling_probe",
          "strongest_caveat",
          "freshness_stamp"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "canonical_mechanism": { "type": "string", "minLength": 8 },
          "claim": { "type": "string", "minLength": 24 },
          "evidence_tier": { "type": "string", "enum": ["E1", "E2", "E3", "E4"] },
          "confidence_band": { "type": "string", "minLength": 4 },
          "named_settling_probe": { "type": "string", "minLength": 8 },
          "strongest_caveat": { "type": "string", "minLength": 16 },
          "freshness_stamp": { "type": "string", "minLength": 10 },
          "source_lineage": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "rail",
                "permalink",
                "fetch_timestamp",
                "http_status",
                "sha256",
                "capture_path"
              ],
              "properties": {
                "rail": {
                  "type": "string",
                  "enum": ["structured-api", "prose-source"]
                },
                "permalink": { "type": "string", "minLength": 12 },
                "fetch_timestamp": { "type": "string", "minLength": 10 },
                "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "capture_path": { "type": "string", "minLength": 8 }
              }
            }
          }
        }
      }
    },
    "control_table": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "control_id",
          "control_name",
          "surface",
          "client_vs_server_enforcement",
          "justification",
          "portable_to_local_runtime"
        ],
        "properties": {
          "control_id": { "type": "string", "minLength": 2 },
          "control_name": { "type": "string", "minLength": 8 },
          "surface": { "type": "string", "minLength": 4 },
          "client_vs_server_enforcement": {
            "type": "string",
            "enum": [
              "CLIENT-SIDE",
              "SERVER-ENFORCED",
              "HYBRID",
              "NOT-ENFORCED-ON-SURFACE"
            ]
          },
          "justification": { "type": "string", "minLength": 24 },
          "portable_to_local_runtime": { "type": "boolean" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "kind": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
