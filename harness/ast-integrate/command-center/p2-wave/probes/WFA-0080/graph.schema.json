{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/wfa/WFA-0080/graph.schema.json",
  "title": "WFA-0080 Graph (unit-local Graph $def; WFA-0001 pack absent on this worktree)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "id",
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "directed",
    "node_kind",
    "edge_relations",
    "nodes",
    "edges",
    "component_report",
    "vocabulary",
    "workflow_level_contrast",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "honesty",
    "produced_by",
    "schema_ref",
    "residual_unknowns"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "Graph" },
    "id": { "type": "string", "minLength": 8 },
    "unit_id": { "type": "string", "const": "WFA-0080" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "FAILED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0080" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0080" },
    "title": { "type": "string", "minLength": 20 },
    "directed": { "type": "boolean", "const": true },
    "node_kind": { "type": "string", "const": "canonical-mechanism" },
    "edge_relations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["implements", "requires", "conflicts-with", "substitutes-for"]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "definition",
          "discriminating_example",
          "catalog_source"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^mech\\.[a-z0-9-]+$" },
          "kind": { "type": "string", "const": "canonical-mechanism" },
          "label": { "type": "string", "minLength": 4 },
          "definition": { "type": "string", "minLength": 40 },
          "discriminating_example": { "type": "string", "minLength": 20 },
          "catalog_source": { "type": "string", "minLength": 8 }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target", "relation", "justification"],
        "properties": {
          "id": { "type": "string", "minLength": 4 },
          "source": { "type": "string", "pattern": "^mech\\.[a-z0-9-]+$" },
          "target": { "type": "string", "pattern": "^mech\\.[a-z0-9-]+$" },
          "relation": {
            "type": "string",
            "enum": ["implements", "requires", "conflicts-with", "substitutes-for"]
          },
          "justification": { "type": "string", "minLength": 24 },
          "worked_substitution": { "type": "object" }
        },
        "if": {
          "properties": { "relation": { "const": "substitutes-for" } },
          "required": ["relation"]
        },
        "then": {
          "required": ["worked_substitution"],
          "properties": {
            "worked_substitution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "construction",
                "ir_rewrite",
                "capability_preserved",
                "capability_lost",
                "not_justified_by"
              ],
              "properties": {
                "construction": { "type": "string", "minLength": 80 },
                "ir_rewrite": { "type": "string", "minLength": 40 },
                "capability_preserved": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 4 }
                },
                "capability_lost": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 4 }
                },
                "not_justified_by": { "type": "string", "const": "similarity" }
              }
            }
          }
        }
      }
    },
    "component_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sizes",
        "largest_size",
        "largest_members",
        "spanning",
        "explanation",
        "components"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 2 },
        "sizes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "largest_size": { "type": "integer", "minimum": 1 },
        "largest_members": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "spanning": { "type": "boolean", "const": false },
        "explanation": { "type": "string", "minLength": 80 },
        "components": { "type": "array", "minItems": 2 }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "n", "ids", "provenance"],
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "n": { "type": "integer", "minimum": 8 },
        "ids": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "provenance": { "type": "string", "minLength": 40 }
      }
    },
    "workflow_level_contrast": { "type": "object" },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 3 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "honesty": { "type": "object" },
    "produced_by": { "type": "object" },
    "schema_ref": { "type": "string" },
    "residual_unknowns": { "type": "array", "minItems": 1 }
  }
}
