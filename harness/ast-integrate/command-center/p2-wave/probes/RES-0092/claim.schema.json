{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0092/claim.schema.json",
  "title": "RES-0092 local claim-record constraints (not the missing global research-claim-record.schema.json)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "implemented_relation",
    "variance_threshold",
    "excluded_relations",
    "claims",
    "source_lineage",
    "evidence",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0092" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "completion_sentinel": { "type": "string", "minLength": 40 },
    "question": { "type": "string", "minLength": 40 },
    "implemented_relation": {
      "type": "object",
      "required": [
        "id",
        "transformation",
        "pipeline_step",
        "threshold",
        "threshold_stated_before_run",
        "run"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "transformation": { "type": "string", "minLength": 8 },
        "pipeline_step": { "type": "string", "minLength": 8 },
        "threshold": { "type": "integer", "minimum": 0 },
        "threshold_stated_before_run": { "type": "boolean", "const": true },
        "run": {
          "type": "object",
          "required": ["distance", "violated", "source_fingerprint", "followup_fingerprint"],
          "properties": {
            "distance": { "type": "integer", "minimum": 0 },
            "violated": { "type": "boolean" },
            "source_fingerprint": { "type": "object" },
            "followup_fingerprint": { "type": "object" }
          }
        }
      }
    },
    "variance_threshold": {
      "type": "object",
      "required": ["value", "metric", "chosen_before_run", "rationale"],
      "properties": {
        "value": { "type": "integer", "const": 0 },
        "metric": { "type": "string", "minLength": 8 },
        "chosen_before_run": { "type": "boolean", "const": true },
        "rationale": { "type": "string", "minLength": 40 }
      }
    },
    "excluded_relations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "excluded", "justification"],
        "properties": {
          "id": { "type": "string", "minLength": 4 },
          "excluded": { "type": "boolean", "const": true },
          "justification": { "type": "string", "minLength": 40 }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "evidence_tier"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "EXCLUDED"]
          },
          "evidence_tier": { "type": "string", "enum": ["E1", "E2", "E3", "E4"] }
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "path", "evidence_tier"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string", "minLength": 4 },
          "evidence_tier": { "type": "string", "enum": ["E1", "E2", "E3", "E4"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "kind", "claim"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "kind": { "type": "string", "minLength": 3 },
          "claim": { "type": "string", "minLength": 8 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "scope_not_agreement"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" },
        "scope_not_agreement": { "type": "boolean", "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
