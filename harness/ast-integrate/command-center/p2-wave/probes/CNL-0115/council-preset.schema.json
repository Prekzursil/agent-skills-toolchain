{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CNL-0115 standing-watch council preset (unit-local contract)",
  "$comment": "Catalog output_schema cites command-center/schema/council-preset.schema.json, a GENERATED SHIM whose $ref is https://ast-integrate.invalid/... . jsonschema 4.10.3 RefResolver tries the network. This file is the executable Draft 2020-12 contract for CNL-0115. It does not replace the shared shim.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "id",
    "title",
    "family",
    "roles",
    "protocol_schedule",
    "voting",
    "stopping",
    "default_binding",
    "editable_dials",
    "watch",
    "nearest_sibling"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0115" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0115" },
    "id": { "$ref": "#/$defs/preset_id" },
    "title": { "type": "string", "minLength": 8 },
    "family": { "type": "string", "minLength": 4 },
    "roles": { "$ref": "#/$defs/roles" },
    "protocol_schedule": { "$ref": "#/$defs/protocol_schedule" },
    "voting": { "$ref": "#/$defs/voting" },
    "stopping": { "$ref": "#/$defs/stopping" },
    "default_binding": { "$ref": "#/$defs/default_binding" },
    "editable_dials": { "$ref": "#/$defs/editable_dials" },
    "watch": { "$ref": "#/$defs/watch" },
    "nearest_sibling": {
      "type": "object",
      "required": ["id", "named_explicitly", "distance", "measurable_diffs"],
      "properties": {
        "id": { "type": "string", "minLength": 4 },
        "named_explicitly": { "type": "boolean", "const": true },
        "distance": { "type": "number", "exclusiveMinimum": 0 },
        "measurable_diffs": { "type": "array", "minItems": 3 }
      }
    }
  },
  "$defs": {
    "preset_id": { "type": "string", "minLength": 4 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "voting": { "type": "boolean" }
        }
      }
    },
    "protocol_schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" }
        }
      }
    },
    "voting": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": { "type": "string", "minLength": 4 },
        "quorum": { "type": "integer", "minimum": 1 }
      }
    },
    "stopping": {
      "type": "object",
      "required": ["max_rounds"],
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1 },
        "expression": { "type": "string", "minLength": 4 }
      }
    },
    "default_binding": {
      "type": "object",
      "required": ["base_spec_ref"],
      "properties": {
        "base_spec_ref": { "type": "string", "minLength": 4 },
        "protocol": { "type": "string" }
      }
    },
    "editable_dials": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "watch": {
      "type": "object",
      "required": [
        "trigger_woken",
        "sleep_default",
        "settled_ledger_blocks_relitigation"
      ],
      "properties": {
        "trigger_woken": { "type": "boolean" },
        "sleep_default": { "type": "boolean" },
        "settled_ledger_blocks_relitigation": { "type": "boolean" },
        "intensity": { "type": "string" }
      }
    },
    "preset_record": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "family",
        "roles",
        "protocol_schedule",
        "voting",
        "stopping",
        "default_binding",
        "editable_dials",
        "watch"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/preset_id" },
        "title": { "type": "string", "minLength": 8 },
        "family": { "type": "string", "minLength": 4 },
        "roles": { "$ref": "#/$defs/roles" },
        "protocol_schedule": { "$ref": "#/$defs/protocol_schedule" },
        "voting": { "$ref": "#/$defs/voting" },
        "stopping": { "$ref": "#/$defs/stopping" },
        "default_binding": { "$ref": "#/$defs/default_binding" },
        "editable_dials": { "$ref": "#/$defs/editable_dials" },
        "watch": { "$ref": "#/$defs/watch" }
      }
    }
  }
}
