			</div>
		</section>
		<section class="fixedsticky sticky-progress-meter hide-for-small">
			<div class="sticky-backdrop">
				<div class="row">
					<div class="content-area--article column">
						<div class="progress-meter">
							<div class="progress-meter-granules">
								<div class="meter-granules-filled"></div>
							</div>
							Performing a Project Premortem
						</div>
					</div>
				</div>
			</div>
		</section>

		<div class="row">
			<div class="content-area--article column">
				<a name="article-top"></a>
				<div class="promo--right hide-for-small hide-for-print">
					<div class="advertising mbl">
								<script type="text/javascript">OX_HBR.showAdUnit("537118183");</script>
					</div>
						<h4 class="mtl hide-for-small">View more from the</h4>
						<div class="promo-contents hide-for-small">
							<h6 class="hed mbs"><a href="/archive-toc/BR0709">September 2007 Issue</a></h6>
							<figure class="medium-magazine-cover mvm">
								<a href="/archive-toc/BR0709">
									<img src="/resources/images/covers/BR0709_500.png">
								</a>
							</figure>
							<div class="mvm dek">
								<a href="/magazine" class="alt-action">Explore the Archive</a>
							</div>
							<personalization-placement class="personalization-placement" data-placement-id="subscribe"></personalization-placement>

						</div>
						<personalization-placement class="personalization-placement hide-for-small" data-placement-id="articles">
							<div class="container mvl">
								<div class="text-center island">
									<div class="loading mrl is-inline-block">
										<div class="pie rotation"></div>
										<div class="pie filler"></div>
										<div class="mask"></div>
									</div>
									<span class="is-inline-block mtm lighter-gray font-light font-size-xlarge">
										Loading...
									</span>
