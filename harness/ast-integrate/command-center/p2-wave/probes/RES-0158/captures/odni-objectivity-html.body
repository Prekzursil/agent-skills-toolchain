<style id="sccss">li.usa-breadcrumb__list-item.usa-current {
	font-weight: lighter !important;
	font-size: 14px !important;
	color: unset;
}

a.wp-block-read-more.has-text-color.has-very-dark-blue-color.has-background.has-light-blue-background-color.usa-link:hover {
    background-color: var(--wp--preset--color--very-dark-blue) !important;
    color: var(--wp--preset--color--white) !important;
    border: 3px solid var(--wp--preset--color--light-blue);
}

a.wp-block-read-more.has-text-color.has-very-dark-blue-color.has-background.has-light-blue-background-color.usa-link {
    border: solid 3px var(--wp--preset--color--light-blue);
	  font-weight: bold !important;
}

.wp-block-uswds-uswds-modal .usa-button--outline[data-open-modal]:hover {
    background-color: var(--wp--preset--color--very-dark-blue) !important;
}

/* DY Overrides - Do NOT Delete until transitioned to Repo*/

.white .usa-breadcrumb__link::before {
	background-color: #fff !important;
}

.clickable-group {
	position: relative;
}
.clickable-group:hover img {
/*   mix-blend-mode: luminosity; */
/* 	filter: var(--wp--preset--duotone--odni-striking-blue); */
	filter: grayscale(100%) url("#wp-duotone-odni-striking-blue");
}
.clickable-group a::after {
	content: "";
	position: absolute;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
	z-index: 2;
	opacity: 0;
	pointer-events: auto;
}

/* #post-stack li.wp-block-post:hover::before,
.newsroom li.wp-block-post:hover .wp-block-cover::before {
	background: var(--wp--preset--color--very-dark-blue) !important;
} */

li.wp-block-post:hover img {
/* 	opacity: .6; */
	mix-blend-mode: luminosity;
	filter: var(--wp--preset--duotone--odni-striking-blue);
}

[id] {
  scroll-margin-top: 150px; /* height of your sticky header */
}

.pgcsimplygalleryblock-grid-collection {
	padding: 0 calc(7% - 24px);
}
.pgc-rev-tags-list-item-view {
	margin: 0 !important;
  border-radius: 0 !important;
	border: solid 3px transparent;
  padding: 10px !important;
}
.pgc-rev-tags-list-view {
	margin: 0 24px;
}
.pgc-rev-tags-list-view .pgc-rev-tags-list-item-title {
	font-size: var(--wp--preset--font-size--medium) !important;
}
.pgcsimplygalleryblock-grid-item-inner.action-lightbox {
	cursor: pointer !important;
}
.pgcsimplygalleryblock-grid-item.hover img {
	mix-blend-mode: luminosity;
	opacity: .6;
}
.pgcsimplygalleryblock-grid-item-hover {
	mix-blend-mode: multiply;
}
.pgcsimplygalleryblock-grid-item .pgcsimplygalleryblock-grid-item-inner.pgc-bottom-align .pgcsimplygalleryblock-grid-title-wrap {
	left: 0;
	bottom: 0 !important;
	text-align: unset;
	padding: 1rem;
	display: none;
}
/* .pgcsimplygalleryblock-grid-item .pgcsimplygalleryblock-grid-item-inner .pgcsimplygalleryblock-grid-title-wrap {
  display: none;
} */

:root :where(.wp-block-button .wp-block-button__link) {
  font-size: var(--wp--preset--font-size--medium) !important;
	padding: 8px 16px;
  border-width: 3px;
  font-weight: bold;
}
:root :where(.wp-block-button .wp-block-button__link):hover {
	border-color: var(--wp--preset--color--light-blue) !important;
}

a.page-numbers {
	color: var(--wp--preset--color--very-dark-blue) !important;
	text-decoration: none !important;
}
.wp-block-query-pagination-previous .is-arrow-chevron::before,
.wp-block-query-pagination-next .is-arrow-chevron::before {
	content: url("/wp-content/uploads/arrow_small.svg");
	height: 16px !important;
	width: 12px !important;
	display: block;
	padding-top: 3px;
	font-size: unset;
}
.wp-block-query-pagination-previous .is-arrow-chevron::before {
	transform: scaleX(-1);
	font-size: unset;
}
.wp-block-query-filter__select {
    min-height: 36px;
    border: 1px solid var(--wp--preset--color--charcoal);
	  padding: .5rem;
}

.usa-input {
	margin: 0 !important;
}
.usa-search__input, [type=search] {
  font-size: var(--wp--preset--font-size--medium-large) !important;
	color: #000 !important;
	height: 38px;
	padding: 18px 12px;
}
.wp-block-search__button {
    margin-left: 0;
}
:where(.wp-block-search__button-inside .wp-block-search__inside-wrapper) {
    border: 1px solid var(--wp--preset--color--charcoal);
    padding: 0;
}

.hide-external-link .usa-link--external::after {
	display: none;
}

.disabled-link {
	pointer-events: none;
	cursor: default;
	text-decoration: none;
}

.no-wrap {
	white-space: nowrap!important;
}

.no-underline .usa-link {
	text-decoration: unset;
}
.no-underline .usa-link:hover {
	text-decoration: underline;
}

.wp-block-cb-carousel-v2 .cb-pagination.swiper-pagination-horizontal {
		align-items: center;
}

.wp-block-post-content a:where(:not(.wp-element-button)),
.usa-prose a:where(:not(.wp-element-button)) {
    text-decoration: underline;
}

.wp-block-uswds-uswds-modal .usa-button--outline {
    background-color: #fff !important;
}
.wp-block-uswds-uswds-modal .usa-button[data-open-modal],
.wp-block-uswds-uswds-modal .usa-button--outline[data-open-modal] {
	margin: 0;
}

.has-white-color p>.usa-link:link, .has-white-color p>.usa-link:visited {
	color: var(--wp--preset--color--white);
}
.has-white-color p>.usa-link:hover {
	color: #DEE7EF !important;
}

/* .wp-block-post-content a:visited, */
.usa-modal a:visited,
.usa-link:visited,
.has-light-gray-background-color .usa-link:hover {
	color: var(--wp--preset--color--odni-blue);
}
.wp-block-post-content a:hover,
.usa-modal a:hover,
.usa-link:hover,
.has-light-gray-background-color .usa-link:hover {
	color: var(--wp--preset--color--very-dark-blue);
}

.usa-modal__heading {
  font-family: var(--wp--preset--font-family--old-standard-tt) !important;
	color: var(--wp--preset--color--odni-blue);
	font-size: var(--wp--preset--font-size--huge) !important;
	line-height: 1.2;
	margin: 0;
}
.usa-prose {
	font-size: var(--wp--preset--font-size--medium-large);
}
.usa-prose>p,
.usa-list li,
.usa-prose>ol li,
.usa-prose>ul li {
	max-width: unset;
}
.usa-modal__header {
	position: relative;
}
.usa-modal__close {
	position: absolute;
  top: 0;
  right: 0;
	border: none;
	padding: 0;
	cursor: pointer;
}
.usa-modal__close:hover {
	opacity: .6;
}
.usa-modal--lg .usa-modal__main {
  max-width: 60rem;
	padding-top: 2rem;
}

.wp-block-cover .has-background-dim.has-background-gradient {
	mix-blend-mode: multiply;
}
.wp-block-cover .has-background-dim.has-background-gradient h1,
.text-shadow h2  {
	text-shadow: 0 2px 20px #000;
}
.wp-block-cover .has-background-dim.has-background-gradient h2,
.text-shadow h2 {
	text-shadow: 0 3px 20px #000;
}
.wp-block-cover .has-background-dim.has-background-gradient p,
.text-shadow p  {
	text-shadow: 0 1px 20px #000;
}

.home-carousel {
	padding: 0 calc(7% - 54px);
}

.add-list-reset {
/* 	margin-top: 16px !important; */
	line-height: 1.6;
}
.add-list-reset ul.dlm-downloads {
	padding: 0;
}
.add-list-reset ul.dlm-downloads li {
	margin-bottom: 10px;
}

nav form.mobile input#search-field-en-big {
	max-width: 100%;
}

/* .mobile .wp-block-navigation .wp-block-navigation-item {
	text-align: right;
} */

.footer-resource-list ul {
  list-style-type: none;
	padding: 0;
}

@media (max-width: 781.98px) {
	.footer-resource-list {
		justify-content: flex-start;
		margin: 1rem 0 !important;
	}
}

@media (max-width: 781.98px) {
	.force-1-col {
		grid-template-columns: 1fr !important;
	}
}
	
@media (min-width: 782px) and (max-width: 1023.98px) {
	.force-2-col {
		display: grid !important;
		grid-template-columns: repeat(2, 1fr) !important;
	}
	.featured-right {
		flex-wrap: wrap;
		max-height: 480px;
	}
}	

@media (min-width: 1024px) {
	.featured {
		font-size: min(1.25vw, var(--wp--preset--font-size--larger)) !important;
	}
}	

@media (min-width: 1400px) {
	.force-3-col {
		display: grid !important;
		grid-template-columns: repeat(3, 1fr) !important;
	}
}	

/* :root {
	--usa-in-page-nav-scroll-offset: 190px;
} */

.usa-prose h2,
.usa-prose h3 {
  scroll-margin-top: 150px;
}

.usa-in-page-nav {
	top: 12rem !important;
	min-width: 25%;
	padding-right: 1.5rem;
}
.usa-in-page-nav__list {
  border-left: 1px solid var(--wp--preset--color--odni-blue);
}
.usa-in-page-nav__item {
	line-height: 1.44;
}
a.usa-in-page-nav__link {
	font-weight: 500;
  font-size: var(--wp--preset--font-size--medium);
	letter-spacing: 1.6px;
	color: var(--wp--preset--color--odni-very-dark-blue) !important;
	text-decoration: none !important;
}
.usa-in-page-nav__list a:not(.usa-button) {
  padding: 12px 24px;
}
.usa-in-page-nav__list a:not(.usa-button):hover {
	font-weight: 600;
}
.usa-in-page-nav__list a:not(.usa-button).usa-current::after {
  bottom: 0;
  left: -1px;
}

.wp-social-link.wp-social-link-truth a {
	content: url("/wp-content/uploads/icon-truth.svg");
  width: 24px;
}
/* .wp-social-link.wp-social-link-truth a:hover {
	content: url("/wp-content/uploads/icon-truth-hover.svg");
} */

ul.no-bullets {
  list-style-type: none;
  padding: 0;
}

.usa-breadcrumb__list {
  margin: 0;
  padding: 0;
/* 	height: 1rem; */
}

.usa-button {
	width: auto;
	padding: 8px 16px;
	line-height: 1.44;
}

/* Responsive Style Overrides */

@media (max-width: 575.98px) {
	.wp-block-query-filter,
	.wp-block-search {
		width: 100%;
	}
}

@media (max-width: 781.98px) {
	.hero {
		min-height: calc(100vh - 140px) !important;
	}
	.block {
		padding-top: 3rem !important;
		padding-bottom: 3rem !important;
	}
	.block-top {
		padding-top: 3rem !important;
	}
	.block-bottom {
		padding-bottom: 3rem !important;
	}
	.cover-featured {
		min-height: 360px !important;
	}
}

@media (min-width: 782px) and (max-width: 1023.98px) {
	.hero {
		min-height: 540px !important;
	}
	.block {
		padding-top: 4.5rem !important;
		padding-bottom: 4.5rem !important;
	}
	.block-top {
		padding-top: 4.5rem !important;
	}
	.block-bottom {
		padding-bottom: 4.5rem !important;
	}
	.col-40 {
		flex-basis: 40% !important;
	}
	.col-60 {
		flex-basis: 60% !important;
	}
	.gap-xl {
		gap: var(--wp--preset--spacing--60) var(--wp--preset--spacing--60);
	}
	.cover-featured {
		min-height: 480px !important;
	}
	.stack-on-tablet {
		flex-wrap: wrap !important;
	}
	.stack-on-tablet .wp-block-column {
		flex-basis: 100% !important;
	}
}

/* @media (max-width: 1023.98px) {
	.negative-margins img {
		max-width: 114%;
		margin-left: -7%;
		margin-right: -7%;
	}
} */

@media (min-width: 1024px) and (max-width: 1399.98px) {
	.stack-on-desktop {
		flex-wrap: wrap !important;
	}
	.stack-on-desktop .wp-block-column {
		flex-basis: 100% !important;
	}
}

:root {
    --wp--preset--font-size--x-small: 12px;
    --wp--preset--font-size--small: 14px;
    --wp--preset--font-size--medium: clamp(14px, 0.875rem + ((1vw - 3.2px) * 0.156), 16px);
    --wp--preset--font-size--medium-large: clamp(16px, 0.875rem + ((1vw - 3.2px) * 0.313), 18px);
    --wp--preset--font-size--large: clamp(18px, 0.875rem + ((1vw - 3.2px) * 0.469), 20px);
    --wp--preset--font-size--custom-1: clamp(20px, 0.915rem + ((1vw - 3.2px) * 0.575), 22px);
    --wp--preset--font-size--larger: clamp(22px, 0.984rem + ((1vw - 3.2px) * 0.645), 24px);
    --wp--preset--font-size--x-large: clamp(24px, 1.052rem + ((1vw - 3.2px) * 0.716), 26px);
    --wp--preset--font-size--even-larger: clamp(26px, 1.25rem + ((1vw - 3.2px) * 0.938), 32px);
    --wp--preset--font-size--super-large: clamp(28px, 1.378rem + ((1vw - 3.2px) * 1.091), 36px);
    --wp--preset--font-size--ultra-large: clamp(30px, 1.502rem + ((1vw - 3.2px) * 1.247), 40px);
    --wp--preset--font-size--huge: clamp(40px, 2.089rem + ((1vw - 3.2px) * 2.077), 60px);
    --wp--preset--font-size--mega: clamp(48px, 2.364rem + ((1vw - 3.2px) * 2.514), 70px);
    --wp--preset--font-size--gigantic: clamp(48px, 2.364rem + ((1vw - 3.2px) * 2.514), 70px);
    --wp--preset--font-size--colossal: clamp(40px, 3.136rem + ((1vw - 3.2px) * 3.893), 100px);
    --wp--preset--font-size--gargantuan: clamp(72px, 5.334rem + ((1vw - 3.2px) * 8.958), 200px);
}

.odni-mobile-menu .wp-block-navigation__responsive-close {
  background-color: var(--wp--preset--color--very-light-blue);
  padding: 1rem;
  border-radius: .5rem;
}
.wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-content .wp-block-navigation-item, .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-content .wp-block-navigation__container, .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-content .wp-block-page-list {
	align-items: start !important;
}
.has-modal-open a.wp-block-pages-list__item__link.wp-block-navigation-item__content {
  font-size: var(--wp--preset--font-size--medium-large) !important;
}
.has-modal-open .wp-block-navigation__submenu-container {
	margin-right: unset !important;
	margin-left: 1rem !important;
	border-right: none !important;
/* 	border-left: 3px solid var(--wp--preset--color--odni-blue) !important; */
	padding: 0 .5rem !important;
	text-align: start;
}

.wp-block-dni-tabs-container .usa-tabs__list {
	width: fit-content;
	height: fit-content;
}

.search-icon {
  transform: scaleX(-1) !important;
}

.wp-block-list {
	padding-inline-start: 1rem;
	margin: 1rem 0;
}
.usa-prose>ol, .usa-prose>ul {
  padding-left: 1rem;
}

.add-list-reset li {
	margin-bottom: .5rem;
}

ul ul>li::marker {
	color: #0e2143;
}

.usa-button--unstyled {
	padding: 0;
}

.wp-block-navigation .wp-block-navigation-item,
.wp-block-navigation .wp-block-navigation-item__content {
   padding-right: .5em;
}
/* .wp-block-navigation__submenu-icon svg {
	transition: transform 0.3s ease;
} */
.wp-block-navigation__submenu-icon:hover svg,
.wp-block-navigation__submenu-icon[aria-expanded="true"] svg {
  transform: rotate(180deg);
	stroke: #0E2143;
}
.wp-block-navigation .wp-block-navigation__submenu-icon {
	margin-left: 0;
}
.wp-block-navigation .wp-block-navigation__submenu-icon svg {
	margin-top: unset;	
}

.grayscale img {
	filter: grayscale(100%) !important;
}

.usa-modal .wp-element-button:visited {
  color: var(--wp--preset--color--very-dark-blue);
}

.usa-banner__header {
	padding-bottom: .5rem;
	padding-top: .5rem;
}
.usa-banner__header-text {
	line-height: 1.2;	
}

.usa-banner__inner {
	padding-right: 1rem;
}
@media (min-width: 64em) {
	.usa-banner__inner {
		padding-right: 2rem;
	}
}

.usa-banner__content {
	padding: 1rem;
}
@media (max-width: 40em) {
	.usa-banner__content {
		padding-top: 0;
	}
	.usa-banner__header-flag {
		float: none;
	}
}</style>
