        <style>
        /* WHAT: Force third level navigation to be visible when second level is expanded */
        /* HOW: Override USWDS hover-only styles with display block */
        /* WHY: Ensure government navigation accessibility and usability */
        
        .wp-block-navigation .wp-block-navigation-item.second.expanded .wp-block-navigation__submenu-container.third {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            position: static !important;
            transform: none !important;
            transition: none !important;
        }
        
        .wp-block-navigation .wp-block-navigation-item.second.expanded .wp-block-navigation__submenu-container.third .wp-block-navigation-item {
            display: block !important;
        }
        
        /* WHAT: Ensure second level items are also always visible */
        /* HOW: Override any potential hover restrictions */
        /* WHY: Maintain consistent navigation state */
        .wp-block-navigation .wp-block-navigation-item.second .wp-block-navigation__submenu-container {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        /* WHAT: Reset any positioning that might hide elements */
        /* HOW: Use static positioning for expanded navigation */
        /* WHY: Prevent absolute/fixed positioning from hiding content */
        .wp-block-navigation .wp-block-navigation-item.second.expanded ul {
            position: static !important;
            left: auto !important;
            top: auto !important;
        }
        </style>
