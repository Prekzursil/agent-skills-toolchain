{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0158/artifact.schema.json",
  "title": "RES-0158 SAT-to-protocol transfer record",
  "type": "object",
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "answer",
    "techniques",
    "claims",
    "negative_controls",
    "reviewer",
    "plain_debate_baseline"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0158" },
    "state": { "type": "string", "enum": ["SUCCESS", "DELIVERED"] },
    "sentinel": { "type": "string", "minLength": 8 },
    "report_kind": { "type": "string", "const": "gem-candidate" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "techniques": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "transfer_verdict",
          "plain_debate_delta",
          "failure_mode",
          "source_lineage"
        ],
        "properties": {
          "id": { "type": "string" },
          "transfer_verdict": {
            "type": "string",
            "enum": ["directly-implementable", "not-a-protocol-blueprint"]
          },
          "plain_debate_delta": { "type": "string", "minLength": 24 },
          "failure_mode": { "type": "object" },
          "source_lineage": { "type": "array", "minItems": 2 }
        }
      }
    },
    "claims": { "type": "array", "minItems": 6 },
    "negative_controls": { "type": "array", "minItems": 2 },
    "reviewer": {
      "type": "object",
      "required": ["independent", "verdict"],
      "properties": {
        "independent": { "type": "boolean" },
        "verdict": { "type": "string" }
      }
    },
    "plain_debate_baseline": { "type": "object" }
  }
}
