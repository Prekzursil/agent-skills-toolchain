      "required_tools": ["read", "task"],
      "context": ["command-center/WORK-UNIT-CATALOG.json"],
      "timeout_seconds": 120,
      "split": "test",
      "stratum": "claude-only",
      "provenance": "TST-0316 fixture; Task is Claude-only",
      "oracle_kind": "deterministic"
