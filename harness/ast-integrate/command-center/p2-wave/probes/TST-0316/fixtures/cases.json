    {
      "id": "cv-codex-mcp",
      "prompt": "Dispatch this case through mcp__codex__codex as the Codex transport.",
      "required_tools": ["read", "mcp__codex__codex"],
      "context": ["command-center/WORK-UNIT-CATALOG.json"],
      "timeout_seconds": 120,
      "split": "test",
      "stratum": "codex-only",
      "provenance": "TST-0316 fixture; mcp__codex__codex is Codex-only",
      "oracle_kind": "deterministic"
    },
    {
      "id": "cv-webfetch-vs-search",
      "prompt": "Fetch the live vendor capability page and extract the tool list.",
