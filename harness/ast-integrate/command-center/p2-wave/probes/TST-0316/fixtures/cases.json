      "context": ["src/a.py", "src/b.py"],
      "timeout_seconds": 120,
      "split": "test",
      "stratum": "portable",
      "provenance": "TST-0316 fixture; portable intersection of Claude and Codex canonical tools",
      "oracle_kind": "deterministic"
    },
    {
      "id": "cv-p-02",
      "prompt": "Rewrite README.md so the install stanza matches pyproject.toml.",
      "required_tools": ["read", "write", "grep"],
      "context": ["README.md", "pyproject.toml"],
      "timeout_seconds": 90,
      "split": "test",
      "stratum": "portable",
      "provenance": "TST-0316 fixture; portable write+grep",
      "oracle_kind": "deterministic"
    },
    {
      "id": "cv-p-03",
      "prompt": "Run the unit tests for tools/cross_vendor and report the exit code.",
      "required_tools": ["exec", "read"],
      "context": ["tools/cross_vendor/parity_bench.py"],
      "timeout_seconds": 60,
      "split": "dev",
      "stratum": "portable",
