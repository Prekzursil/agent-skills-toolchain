{
  "unit_id": "TST-0316",
  "note": "Cross-vendor parity slice. Catalog input command-center/bench/cases/ is unbuilt (TST-0295); this unit ships a closed fixture corpus so request-diff and empty-diff scoring are executable without a live model call.",
  "cases": [
    {
      "id": "cv-p-01",
      "prompt": "Count the Python modules under src/ and name each file.",
