      "context": ["tools/"],
      "timeout_seconds": 150,
      "split": "test",
      "stratum": "portable",
      "provenance": "TST-0316 fixture; portable grep+glob; 150s is under Codex max 180",
      "oracle_kind": "deterministic"
    },
    {
      "id": "cv-timeout-clamp",
      "prompt": "Hold a long-running replica rebuild that needs a 300s adapter timeout.",
      "required_tools": ["read", "exec"],
      "context": ["ops/rebuild.sh"],
      "timeout_seconds": 300,
      "split": "test",
      "stratum": "timeout-leak",
      "provenance": "TST-0316 fixture; Codex max_timeout=180 clamps 300s",
      "oracle_kind": "deterministic"
