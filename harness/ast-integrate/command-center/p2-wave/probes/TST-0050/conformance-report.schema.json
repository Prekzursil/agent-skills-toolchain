{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0050/conformance-report.schema.json",
  "title": "TST-0050 telemetry/privacy conformance report",
  "$comment": "Local envelope. Catalog command-center/schema/conformance-report.schema.json is a generated $ref shim to https://ast-integrate.invalid/...; jsonschema 4.10.3 on this box raises RefResolutionError. This file rejects the empty object and unrelated garbage without a network fetch.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "schema_version",
    "report_kind",
    "title",
    "question",
    "sentinel",
    "verdict",
    "answer",
    "declared_fields",
    "live_canonical",
    "live_checked",
    "empty_live_is_not_a_pass",
    "tests",
    "negative_controls",
    "reviewers",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "TST-0050" },
    "id": { "type": "string", "const": "TST-0050" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "schema_version": { "type": "integer", "minimum": 1 },
    "report_kind": { "type": "string", "minLength": 8 },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "sentinel": { "type": "string", "minLength": 8 },
    "completion_sentinel": { "type": "string", "minLength": 8 },
    "verdict": { "type": "string", "minLength": 16 },
    "answer": { "type": "string", "minLength": 16 },
    "declared_fields": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "live_canonical": {
      "type": "object",
      "required": [
        "emitter_files",
        "payload_count",
        "empty_live_is_not_a_pass"
      ],
      "properties": {
        "emitter_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "payload_count": { "type": "integer", "minimum": 0 },
        "empty_live_is_not_a_pass": { "const": true }
      }
    },
    "live_checked": { "type": "array" },
    "empty_live_is_not_a_pass": { "const": true },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "ERROR", "SKIP", "NOT-RUN"]
          },
          "command": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad", "silent_on_good"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "fired_on_bad": { "type": "boolean" },
          "silent_on_good": { "type": "boolean" }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "reviewer_id",
          "verdict",
          "independent",
          "saw_other_verdict_before_filing"
        ],
        "properties": {
          "reviewer_id": { "type": "string", "minLength": 3 },
          "verdict": { "type": "string", "minLength": 4 },
          "independent": { "const": true },
          "saw_other_verdict_before_filing": { "const": false },
          "role": { "type": "string" },
          "basis": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "NOT-CHECKED", "PARTIAL"]
          },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
