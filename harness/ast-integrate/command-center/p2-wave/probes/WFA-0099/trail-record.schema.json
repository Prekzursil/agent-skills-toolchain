{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0099/trail-record.schema.json",
  "title": "WFA-0099 collapse trail record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "seq",
    "prev_hash",
    "event_hash",
    "ts",
    "surviving_id",
    "absorbed_ids",
    "primary_signal",
    "deciding_signals",
    "signals_fired",
    "scores",
    "preserved_union",
    "pre_records",
    "merged_record",
    "duplicate_of_edges"
  ],
  "properties": {
    "kind": { "type": "string", "const": "collapse" },
    "seq": { "type": "integer", "minimum": 1 },
    "prev_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "event_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "ts": { "type": "string", "minLength": 8 },
    "surviving_id": { "type": "string", "minLength": 3 },
    "absorbed_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "primary_signal": {
      "type": "string",
      "enum": ["LEXICAL", "EMBEDDING", "STRUCTURAL"]
    },
    "deciding_signals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["LEXICAL", "EMBEDDING", "STRUCTURAL"] }
    },
    "signals_fired": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scores": { "type": "array", "minItems": 1 },
    "preserved_union": {
      "type": "object",
      "required": [
        "mechanisms",
        "provenance_anchors",
        "licence_obligations",
        "licence_governing",
        "stop_rules"
      ],
      "properties": {
        "mechanisms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "provenance_anchors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "licence_obligations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "licence_governing": { "type": "string", "minLength": 3 },
        "stop_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "pre_records": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "type": "object" }
    },
    "merged_record": { "type": "object", "required": ["id", "mechanisms"] },
    "duplicate_of_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string", "const": "duplicate-of" }
        }
      }
    }
  }
}
