{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/ARC-0088/hook-contract.schema.json",
  "title": "ARC-0088 hook contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "event_types",
    "stdin_json_shape",
    "exit_code_semantics",
    "inject_do_not_block",
    "fail_open",
    "timeout",
    "wiring_proof",
    "registration_record",
    "tests",
    "reviewer",
    "artifacts",
    "evidence",
    "input_presence"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "ARC-0088" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:ARC-0088" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "event_types": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 4 }
    },
    "stdin_json_shape": {
      "type": "object",
      "required": ["required_fields", "encoding", "delivery"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" }
        },
        "encoding": { "type": "string", "const": "utf-8-json-object-on-stdin" },
        "delivery": { "type": "string", "minLength": 8 }
      }
    },
    "exit_code_semantics": {
      "type": "object",
      "required": ["exit_0", "exit_2", "other_nonzero", "exit_2_reserved_for"],
      "properties": {
        "exit_0": { "type": "string", "minLength": 8 },
        "exit_2": { "type": "string", "minLength": 8 },
        "other_nonzero": { "type": "string", "minLength": 8 },
        "exit_2_reserved_for": {
          "type": "string",
          "const": "irreversible_danger_only"
        }
      }
    },
    "inject_do_not_block": {
      "type": "object",
      "required": ["rule", "channel", "cannot_produce_exit_2"],
      "properties": {
        "rule": { "type": "string", "minLength": 16 },
        "channel": { "type": "string", "minLength": 8 },
        "cannot_produce_exit_2": { "type": "boolean", "const": true }
      }
    },
    "fail_open": {
      "type": "object",
      "required": ["on_internal_error", "session_continues", "process_exit"],
      "properties": {
        "on_internal_error": { "type": "string", "minLength": 16 },
        "session_continues": { "type": "boolean", "const": true },
        "process_exit": { "type": "integer", "const": 0 }
      }
    },
    "timeout": {
      "type": "object",
      "required": ["default_ms", "on_timeout", "process_exit"],
      "properties": {
        "default_ms": { "type": "integer", "minimum": 1 },
        "on_timeout": { "type": "string", "minLength": 8 },
        "process_exit": { "type": "integer", "const": 0 }
      }
    },
    "wiring_proof": {
      "type": "object",
      "required": [
        "manifest_file_is_not_proof",
        "required_signals",
        "wired_iff"
      ],
      "properties": {
        "manifest_file_is_not_proof": { "type": "boolean", "const": true },
        "required_signals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "wired_iff": { "type": "string", "minLength": 16 }
      }
    },
    "registration_record": {
      "type": "object",
      "required": ["required_fields", "explicit_interpreter"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string" }
        },
        "explicit_interpreter": { "type": "boolean", "const": true }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": [
        "contract_reviewer_id",
        "consumer_reviewer_id",
        "independent",
        "verdict"
      ],
      "properties": {
        "contract_reviewer_id": { "type": "string", "minLength": 3 },
        "consumer_reviewer_id": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean", "const": true },
        "verdict": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "input_presence": { "type": "object" }
  }
}
