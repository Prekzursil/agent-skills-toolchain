</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/a290e83c40f85081242594b91a6ca4a3fa0a473a" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:6.874ex; height:2.176ex;" alt="{\displaystyle \forall b\in A}"/></span> such that <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt27" id="mwPw" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"(b,a) \\in R, \\exists c \\in E"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle (b,a)\in R,\exists c\in E}">
