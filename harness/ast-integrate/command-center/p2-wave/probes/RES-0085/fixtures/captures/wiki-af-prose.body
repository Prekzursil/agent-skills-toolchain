        </mrow>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle {\textit {valprefs}}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/62f120fd1b2318ab3acc49230d66ec32c269318e" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; margin-right: -0.021ex; width:7.778ex; height:2.509ex;" alt="{\displaystyle {\textit {valprefs}}}"/></span> is a preference relation (transitive, irreflexive and asymmetric) on <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt137" id="mwASU" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"V \\times V"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle V\times V}">
  <semantics>
