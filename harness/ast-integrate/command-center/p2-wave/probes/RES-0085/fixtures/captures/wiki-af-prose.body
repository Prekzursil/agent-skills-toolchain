          <mrow class="MJX-TeXAtom-ORD">
            <mi class="MJX-tex-caligraphic" mathvariant="script">R</mi>
          </mrow>
        </mrow>
        <mo fence="false" stretchy="false">⟩<!-- ⟩ --></mo>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \langle {\mathcal {L}},{\mathcal {R}}\rangle }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/6aa2f11d261c34fd74d0b47cab074427cef764e2" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:6.418ex; height:2.843ex;" alt="{\displaystyle \langle {\mathcal {L}},{\mathcal {R}}\rangle }"/></span> and set of assumptions <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt172" id="mwAV0" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\mathcal{A}\\subseteq\\mathcal{L}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\mathcal {A}}\subseteq {\mathcal {L}}}">
