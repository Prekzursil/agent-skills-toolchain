</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/31c7ce58c24134313deec2c50940aff2c4986fa9" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:6.009ex; height:2.843ex;" alt="{\displaystyle (\Phi ,\alpha )}"/></span> if and only if <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt128" id="mwARU" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\beta \\Leftrightarrow \\neg \\alpha"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle \beta \Leftrightarrow \neg \alpha }">
