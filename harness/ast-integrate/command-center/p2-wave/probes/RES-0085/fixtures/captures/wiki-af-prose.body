</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/af0f6064540e84211d0ffe4dac72098adfa52845" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.338ex; width:1.787ex; height:2.176ex;" alt="{\displaystyle V}"/></span>, and <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt136" id="mwASQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\textit{valprefs}"}}'><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" alttext="{\displaystyle {\textit {valprefs}}}">
