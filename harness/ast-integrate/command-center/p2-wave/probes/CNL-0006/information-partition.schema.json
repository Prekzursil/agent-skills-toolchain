{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/CNL-0006/information-partition.schema.json",
  "title": "InformationPartition lattice instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["type_name", "seats", "stage_count", "atoms", "grants"],
  "properties": {
    "type_name": { "const": "InformationPartition" },
    "seats": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "stage_count": { "type": "integer", "minimum": 1 },
    "atoms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "kind", "canary"],
        "properties": {
          "atom_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "producer": { "type": ["string", "null"] },
          "canary": { "type": "string", "minLength": 8, "pattern": "^CNL6-CANARY-" },
          "paraphrase_stems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "audience", "from_stage"],
        "properties": {
          "atom_id": { "type": "string", "minLength": 1 },
          "audience": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "from_stage": { "type": "integer", "minimum": 0 },
          "until_stage": { "type": ["integer", "null"], "minimum": 1 },
          "carriers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["prompt", "tool_result", "scratchpad", "summary", "transcript"]
            }
          }
        }
      }
    }
  }
}
