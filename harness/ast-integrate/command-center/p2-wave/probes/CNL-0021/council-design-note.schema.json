{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0021/council-design-note.schema.json",
  "title": "CNL-0021 design note (per-unit; shared catalog schema is contested by other CNL units)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "title",
    "question",
    "answer",
    "claims",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts",
    "not_checked",
    "measured"
  ],
  "properties": {
    "unit_id": { "type": "string", "pattern": "^CNL-0021$" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 12, "pattern": "^SUCCESS:CNL-0021" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 80 },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reject_state", "check_does", "verbatim"],
        "properties": {
          "id": { "type": "string" },
          "reject_state": { "type": "string", "minLength": 8 },
          "check_does": { "type": "string", "minLength": 8 },
          "verbatim": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "recount_agrees"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" },
        "recount_agrees": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    },
    "not_checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "reason"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    },
    "measured": {
      "type": "object",
      "required": [
        "honest_status",
        "honest_inherited",
        "same_base_pair_count",
        "different_pair_count"
      ],
      "properties": {
        "honest_status": { "type": "string", "minLength": 4 },
        "honest_inherited": { "type": "integer", "minimum": 0 },
        "same_base_pair_count": { "type": "integer", "minimum": 0 },
        "different_pair_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
