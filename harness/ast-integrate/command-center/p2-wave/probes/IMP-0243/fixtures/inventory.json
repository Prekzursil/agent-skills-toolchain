{
  "components": [
    {
      "id": "dispatch",
      "kind": "runtime",
      "trust_zone": "control-plane",
      "permissions": ["spawn", "read"],
      "data": ["work-units"]
    },
    {
      "id": "receipts",
      "kind": "store",
      "trust_zone": "artifacts",
      "permissions": ["write"],
      "data": ["receipts"]
    },
    {
      "id": "secrets-env",
      "kind": "credential-source",
      "trust_zone": "host",
      "permissions": ["read"],
      "data": ["env", "credentials"]
    }
  ],
  "flows": [
    {
      "from": "secrets-env",
      "to": "dispatch",
      "data": ["credentials"]
    }
  ]
}
