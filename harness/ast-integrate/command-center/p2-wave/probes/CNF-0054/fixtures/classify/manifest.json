{
  "name": "cnf-0054-dispatch-manifest",
  "hooks": [
    {
      "id": "hook.session-start",
      "event": "SessionStart",
      "enabled": true,
      "exit_code": 0,
      "command": "hook_runner.py"
    },
    {
      "id": "hook.user-prompt",
      "event": "UserPromptSubmit",
      "enabled": true,
      "exit_code": 0,
      "command": "hook_runner.py"
    },
    {
      "id": "hook.pre-tool",
      "event": "PreToolUse",
      "enabled": true,
      "exit_code": 0,
      "command": "hook_runner.py"
    },
    {
      "id": "hook.post-tool",
      "event": "PostToolUse",
      "enabled": true,
      "exit_code": 0,
      "command": "hook_runner.py"
    },
    {
      "id": "hook.notification",
      "event": "Notification",
      "enabled": false,
      "exit_code": 0,
      "command": "hook_runner.py"
    },
    {
      "id": "hook.stop",
      "event": "Stop",
      "enabled": true,
      "exit_code": 1,
      "command": "hook_runner.py"
    },
    {
      "id": "hook.session-end",
      "event": "SessionEnd",
      "enabled": true,
      "exit_code": 0,
      "command": "hook_runner.py"
    }
  ]
}
