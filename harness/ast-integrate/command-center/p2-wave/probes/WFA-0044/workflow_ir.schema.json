{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/wfa/WFA-0044-workflow-ir.schema.json",
  "title": "WFA-0044 WorkflowIR specification record",
  "description": "Local contract for this unit's artifact. The catalog $ref command-center/wfa/schema/wfa-schema-pack.json#/$defs/WorkflowIR is not on this worktree (WFA-0001 pack absent). Every IR node still requires id, kind, and source_anchor.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "record_type",
    "ir_version",
    "execution_semantics",
    "not_a_runtime",
    "nodes",
    "lossy_field_ledger",
    "round_trip",
    "title",
    "question",
    "tests",
    "negative_controls",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0044" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0044" },
    "record_type": { "type": "string", "const": "WorkflowIR" },
    "ir_version": { "type": "string", "minLength": 3 },
    "execution_semantics": { "type": "string", "const": "none" },
    "not_a_runtime": { "type": "boolean", "const": true },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "source_anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "source_anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "lossy_field_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "construct", "disposition"],
        "properties": {
          "code": { "type": "string", "minLength": 3 },
          "construct": { "type": "string", "minLength": 3 },
          "disposition": {
            "type": "string",
            "enum": ["recorded", "unmapped", "live-absent"]
          }
        }
      }
    },
    "round_trip": { "type": "object" },
    "title": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
