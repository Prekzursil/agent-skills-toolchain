{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0282/coverage.schema.json",
  "title": "TST-0282 objective coverage schema (stand-in for absent council-spec.schema.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["subquestions", "required_categories", "evidence_classes"],
  "properties": {
    "subquestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 8 }
        }
      }
    },
    "required_categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
