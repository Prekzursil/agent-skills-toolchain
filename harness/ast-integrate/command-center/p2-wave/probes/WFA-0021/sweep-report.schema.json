{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0021/sweep-report.schema.json",
  "title": "WFA-0021 SweepReport (local; WFA-0001 pack absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "record_type",
    "question",
    "generated_at",
    "upstream_registry",
    "join_key",
    "sources",
    "mechanisms",
    "summary",
    "injection_log",
    "evidence",
    "tests",
    "controls",
    "residual_unknowns",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "const": "WFA-0021" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:WFA-0021" },
    "record_type": { "const": "SweepReport" },
    "question": { "type": "string", "minLength": 40 },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "upstream_registry": {
      "type": "object",
      "required": ["present", "last_known_n", "last_known_sha256"],
      "properties": {
        "present": { "const": false },
        "last_known_n": { "const": 284 }
      }
    },
    "join_key": {
      "type": "object",
      "required": ["name", "content_hash_trap"]
    },
    "sources": { "type": "array", "minItems": 8 },
    "mechanisms": { "type": "array", "minItems": 6 },
    "summary": {
      "type": "object",
      "required": [
        "n_mechanisms",
        "verified",
        "unverified",
        "represented_in_reconstructed_index",
        "not_represented_in_reconstructed_index"
      ]
    },
    "injection_log": { "type": "array" },
    "evidence": { "type": "object", "required": ["A", "B"] },
    "tests": { "type": "array", "minItems": 2 },
    "controls": { "type": "object" },
    "residual_unknowns": { "type": "array", "minItems": 1 },
    "reviewer": {
      "type": "object",
      "required": ["independent", "reviewer_id", "verdict"]
    }
  }
}
