{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0116/artifact.schema.json",
  "title": "WFA-0116 RegressionFixture (declared wfa-schema-pack.json is absent on this worktree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "unit_id",
    "state",
    "sentinel",
    "failure_class",
    "question_or_target",
    "answer",
    "planted",
    "detector",
    "both_states",
    "voiding",
    "evidence",
    "tests",
    "reviewer",
    "artifacts",
    "schema_pack_status"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "RegressionFixture" },
    "unit_id": { "type": "string", "const": "WFA-0116" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0116" },
    "failure_class": { "type": "string", "const": "benchmark-gaming" },
    "question_or_target": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "planted": { "type": "object" },
    "detector": { "type": "object" },
    "both_states": { "type": "object" },
    "voiding": { "type": "object" },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 },
    "schema_pack_status": { "type": "object" }
  }
}
