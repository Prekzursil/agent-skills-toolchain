{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WFA-0107 fusion-precondition-checker RegressionFixture (local; catalog pack $ref is a network shim)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts",
    "both_states",
    "cartesian_cells",
    "completion_sentinel",
    "evidence",
    "honesty",
    "id",
    "inputs_consumed",
    "legality_counts",
    "local_schema",
    "min_bytes_threshold",
    "named_probes",
    "operators",
    "output_path",
    "output_schema",
    "question_or_target",
    "report_kind",
    "reviewer",
    "samples",
    "schema_gate",
    "schema_version",
    "sentinel",
    "state",
    "tests",
    "title",
    "ts",
    "unit_id",
    "verdicts"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "role": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "both_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_attempts_succeed_both_directions",
        "illegal_attempts_fail_or_invalid",
        "licence_blocks_despite_structural_compat",
        "copyleft_plus_permissive_legal"
      ],
      "properties": {
        "legal_attempts_succeed_both_directions": { "type": "boolean", "const": true },
        "illegal_attempts_fail_or_invalid": { "type": "boolean", "const": true },
        "licence_blocks_despite_structural_compat": { "type": "boolean", "const": true },
        "copyleft_plus_permissive_legal": { "type": "boolean", "const": true }
      }
    },
    "cartesian_cells": { "type": "integer", "minimum": 1 },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0107" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "type": "string", "minLength": 40 },
        "B": { "type": "string", "minLength": 40 }
      }
    },
    "honesty": { "type": "object" },
    "host": { "type": "object" },
    "id": { "type": "string", "const": "WFA-0107" },
    "inputs_consumed": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "object" }
    },
    "legality_counts": {
      "type": "object",
      "required": ["LEGAL", "ILLEGAL", "cells", "per_operator"],
      "properties": {
        "LEGAL": { "type": "integer", "minimum": 1 },
        "ILLEGAL": { "type": "integer", "minimum": 1 },
        "cells": { "type": "integer", "minimum": 1 },
        "per_operator": { "type": "object" }
      },
      "additionalProperties": true
    },
    "local_schema": {
      "type": "string",
      "const": "command-center/p2-wave/probes/WFA-0107/regression-fixture.schema.json"
    },
    "min_bytes_threshold": { "type": "integer", "minimum": 2048 },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "operators": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "output_path": {
      "type": "string",
      "const": "command-center/wfa/WFA-0107-fusion-precondition-checker.json"
    },
    "output_schema": {
      "type": "string",
      "const": "command-center/wfa/schema/wfa-schema-pack.json#/$defs/RegressionFixture"
    },
    "question_or_target": { "type": "string", "minLength": 40 },
    "report_kind": { "type": "string", "const": "RegressionFixture" },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true },
        "note": { "type": "string" }
      },
      "additionalProperties": true
    },
    "samples": {
      "type": "object",
      "required": ["legal", "illegal"],
      "properties": {
        "legal": { "type": "array", "minItems": 1 },
        "illegal": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    },
    "schema_gate": { "type": "object" },
    "schema_version": { "type": "integer", "const": 1 },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0107" },
    "state": { "type": "string", "const": "SUCCESS" },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "const": "PASS" },
          "detail": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "title": { "type": "string", "minLength": 8 },
    "ts": { "type": "string", "minLength": 20 },
    "unit_id": { "type": "string", "const": "WFA-0107" },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["left", "right", "operator", "verdict", "reason"],
        "properties": {
          "left": { "type": "string" },
          "right": { "type": "string" },
          "operator": { "type": "string" },
          "verdict": { "type": "string", "enum": ["LEGAL", "ILLEGAL"] },
          "blocking_edge": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 8 }
        },
        "additionalProperties": true
      }
    }
  }
}
