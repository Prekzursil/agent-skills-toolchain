{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/CNL-0101/fixtures/preset.record.schema.json",
  "title": "CouncilPresetDelta record (typed overlay, not a forked CouncilSpec)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "default_binding",
    "editable_dials",
    "spec_id",
    "spec_version"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "minLength": 3 },
    "default_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id"],
      "properties": {
        "protocol_id": { "type": "string", "minLength": 2 },
        "protocol_family": { "type": "string", "minLength": 2 }
      }
    },
    "editable_dials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "charter",
          "participants",
          "roles",
          "engagement",
          "budgets",
          "evidence",
          "voting",
          "stopping",
          "outcomes",
          "integrity",
          "anti_failure",
          "audit",
          "consensus"
        ]
      },
      "uniqueItems": true
    },
    "spec_id": { "type": "string", "minLength": 3 },
    "spec_version": { "type": "string", "minLength": 1 },
    "charter": { "type": "object" },
    "participants": { "type": "array" },
    "roles": { "type": "array", "items": { "type": "string" } },
    "engagement": { "type": "object" },
    "budgets": { "type": "object" },
    "evidence": { "type": "object" },
    "voting": { "type": "object" },
    "stopping": { "type": "object" },
    "outcomes": { "type": "string" },
    "integrity": { "type": "object" },
    "anti_failure": { "type": "object" },
    "audit": { "type": "object" },
    "consensus": { "type": "object" }
  }
}
