{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/SYN-0005/decision-trace.schema.json",
  "title": "SYN-0005 decision-trace (unit-local). Catalog command-center/schema/decision-trace.schema.json is a generated $ref shim that distro jsonschema 4.10 cannot resolve offline.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "decisions",
    "breaks",
    "hop_break_counts",
    "reverse_index",
    "reviewer",
    "named_probes",
    "input_inventory"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "SYN-0005" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": {
      "type": "string",
      "minLength": 40,
      "pattern": "^SUCCESS:SYN-0005"
    },
    "report_kind": { "type": "string", "const": "decision-trace" },
    "question": { "type": "string", "minLength": 40 },
    "phase": { "type": "string" },
    "decision_count": { "type": "integer", "minimum": 10 },
    "decision_ids": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 2 }
    },
    "decisions": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/definitions/decision" }
    },
    "breaks": {
      "type": "array",
      "items": { "$ref": "#/definitions/break_row" }
    },
    "hop_break_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "option", "unit", "artifact", "test"],
      "properties": {
        "source": { "type": "integer", "minimum": 0 },
        "option": { "type": "integer", "minimum": 0 },
        "unit": { "type": "integer", "minimum": 0 },
        "artifact": { "type": "integer", "minimum": 0 },
        "test": { "type": "integer", "minimum": 0 }
      }
    },
    "reverse_index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "unit_id", "decision_id"],
        "properties": {
          "path": { "type": "string", "minLength": 4 },
          "unit_id": { "type": "string", "minLength": 3 },
          "decision_id": { "type": "string", "minLength": 2 },
          "source_anchor": { "type": "string" }
        }
      }
    },
    "input_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "present", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 3 },
          "present": { "type": "boolean" },
          "role": { "type": "string", "minLength": 2 }
        }
      }
    },
    "orphans": { "type": "array" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "UNVERIFIED"]
          },
          "anchor": { "type": "string", "minLength": 4 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "command": { "type": "string", "minLength": 8 },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "ERROR", "SKIP", "NOT-RUN"]
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reviewer_id", "verdict", "independent", "vendor"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true },
        "vendor": {
          "type": "string",
          "minLength": 3,
          "not": { "enum": ["anthropic", "Anthropic", "ANTHROPIC"] }
        }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "command": { "type": "string", "minLength": 8 },
          "role": { "type": "string" }
        }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 1 }
  },
  "definitions": {
    "decision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source_anchor",
        "hops",
        "artifacts",
        "option_resolutions",
        "unit_ids",
        "outcome"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "decision_state": { "type": "string" },
        "source_anchor": { "type": "string", "minLength": 8 },
        "decision_text": { "type": "string" },
        "outcome": { "type": "string", "minLength": 2 },
        "unit_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hops": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {
                "type": "string",
                "enum": ["source", "option", "unit", "artifact", "test"]
              },
              "status": {
                "type": "string",
                "enum": ["OK", "BROKEN", "EMPTY"]
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "present", "unit_id"],
            "properties": {
              "path": { "type": "string" },
              "present": { "type": "boolean" },
              "unit_id": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "option_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["token", "status"],
            "properties": {
              "token": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["RESOLVED", "REJECTED", "UNRESOLVED"]
              },
              "namespace": { "type": ["string", "null"] },
              "classification": { "type": ["string", "null"] },
              "kind": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "tests": { "type": "array" }
      }
    },
    "break_row": {
      "type": "object",
      "additionalProperties": true,
      "required": ["hop", "classification"],
      "properties": {
        "decision_id": { "type": ["string", "null"] },
        "hop": { "type": "string", "minLength": 2 },
        "classification": { "type": "string", "minLength": 4 },
        "detail": { "type": "string" },
        "token": { "type": "string" },
        "path": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
