{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wfa-0119-standin://CertificationRecord",
  "title": "WFA-0119 CertificationRecord stand-in (declared pack WFA-0001 is absent)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "unit_id",
    "id",
    "state",
    "sentinel",
    "decision",
    "workflow_id",
    "certified",
    "conditions",
    "supersession",
    "evidence",
    "tests",
    "reviewer",
    "scope"
  ],
  "properties": {
    "record_type": { "const": "CertificationRecord" },
    "schema_ref": { "type": "string" },
    "schema_status": { "type": "string" },
    "unit_id": { "const": "WFA-0119" },
    "id": { "type": "string", "minLength": 8 },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "minLength": 8 },
    "decision": { "type": "string", "minLength": 4 },
    "workflow_id": { "type": "string", "minLength": 4 },
    "certified": { "type": "boolean" },
    "owner_approval_required": { "type": "boolean" },
    "production_retirement": { "type": "string" },
    "generated_at": { "type": "string" },
    "dependencies": { "type": "object" },
    "conditions": { "type": "object" },
    "supersession": { "type": "object" },
    "negative_controls": { "type": "array" },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "object" },
    "reviewer": { "type": "object" },
    "scope": { "type": "string", "minLength": 8 },
    "named_probes": { "type": "array" }
  }
}
