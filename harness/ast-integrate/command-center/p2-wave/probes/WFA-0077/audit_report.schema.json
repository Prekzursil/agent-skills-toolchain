{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0077/audit_report.schema.json",
  "title": "WFA-0077 owner-approval gate list (AuditReport stand-in; WFA-0001 pack absent)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "unit_id",
    "state",
    "sentinel",
    "question",
    "spec_named_actions",
    "action_unit_map",
    "decision_record_search",
    "classifications",
    "ask_queue",
    "tests",
    "reviewer",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "AuditReport" },
    "unit_id": { "type": "string", "const": "WFA-0077" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0077" },
    "question": { "type": "string", "minLength": 40 },
    "spec_named_actions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "type": "string" }
    },
    "action_unit_map": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["action", "triggering_units", "disposition"],
        "properties": {
          "action": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["ASK", "SETTLED", "REMOVED"]
          },
          "triggering_units": { "type": "array" }
        }
      }
    },
    "decision_record_search": {
      "type": "object",
      "required": ["checked_before_ask", "records"],
      "properties": {
        "checked_before_ask": { "type": "boolean", "const": true },
        "records": { "type": "array", "minItems": 1 }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "disposition",
          "decision_log_checked"
        ],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["ASK", "SETTLED", "REMOVED"]
          },
          "decision_log_checked": { "type": "boolean", "const": true }
        }
      }
    },
    "ask_queue": {
      "type": "object",
      "required": ["presentation_rule", "presented_now", "deferred_ids"],
      "properties": {
        "presentation_rule": {
          "type": "string",
          "const": "one_foundation_question_at_a_time"
        },
        "deferred_ids": { "type": "array" }
      }
    },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string" },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "evidence": { "type": "array", "minItems": 3 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
