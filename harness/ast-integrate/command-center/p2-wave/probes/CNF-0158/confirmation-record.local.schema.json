{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNF-0158/confirmation-record.local.schema.json",
  "title": "CNF-0158 confirmation record (unit-local; catalog confirmation-record.schema.json is a generated $ref shim)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kind",
    "claim_id",
    "unit_id",
    "state",
    "sentinel",
    "verdict",
    "confirmer",
    "blinding_attestation_hash",
    "baseline_repro",
    "corrected_repro",
    "rollback_repro",
    "regression_diff",
    "discrepancies",
    "source_probe",
    "verifier_probe",
    "residual_caveat",
    "leaks",
    "tests"
  ],
  "properties": {
    "kind": { "type": "string", "const": "confirmation-record" },
    "claim_id": { "type": "string", "const": "CNF-0158" },
    "unit_id": { "type": "string", "const": "CNF-0158" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "const": "SUCCESS:CNF-0158" },
    "verdict": {
      "type": "string",
      "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
    },
    "confirmer": {
      "type": "object",
      "required": ["identity", "vendor", "role"],
      "properties": {
        "identity": { "type": "string", "minLength": 3 },
        "vendor": { "type": "string", "minLength": 3 },
        "role": { "type": "string", "minLength": 3 }
      }
    },
    "blinding_attestation_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_repro": { "type": "object" },
    "corrected_repro": { "type": "object" },
    "rollback_repro": { "type": "object" },
    "regression_diff": { "type": "object" },
    "discrepancies": { "type": "array" },
    "source_probe": {
      "type": "object",
      "required": ["id", "command", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "command": { "type": "string", "minLength": 8 },
        "fingerprint": { "type": "string", "minLength": 16 }
      }
    },
    "verifier_probe": {
      "type": "object",
      "required": ["id", "command", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "command": { "type": "string", "minLength": 8 },
        "fingerprint": { "type": "string", "minLength": 16 }
      }
    },
    "residual_caveat": { "type": "string", "minLength": 24 },
    "leaks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["leak_id", "verdict", "reproduction_commands", "observed_divergence"],
        "properties": {
          "leak_id": { "type": "string", "minLength": 4 },
          "verdict": {
            "type": "string",
            "enum": ["REPRODUCED", "FIXED", "NEVER-REAL", "ABSENT-AS-EXPECTED"]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4
    }
  }
}
