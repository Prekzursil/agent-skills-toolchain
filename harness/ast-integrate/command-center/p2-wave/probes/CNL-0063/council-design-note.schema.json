{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/CNL-0063/council-design-note.schema.json",
  "title": "CNL-0063 pairwise Condorcet cycle-completion design note",
  "$comment": "Executable contract for this unit. The catalog path command-center/schema/council-design-note.schema.json is a GENERATED SHIM ($ref to artifact-class-profiles) that jsonschema 4.10 cannot retrieve from ast-integrate.invalid.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "kind",
    "title",
    "question",
    "answer",
    "answers",
    "claimed_rule",
    "freeze_contract",
    "pairwise_tabulation",
    "measured_cycle",
    "measured_condorcet_winner",
    "measured_posthoc",
    "independent_recount",
    "markdown",
    "tests",
    "claims",
    "evidence",
    "negative_controls",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "CNL-0063" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:CNL-0063" },
    "kind": { "type": "string", "const": "council-design-note" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "answers": {
      "type": "object",
      "required": [
        "cycle_completion_declared",
        "freeze_before_ballots",
        "condorcet_winner_overrides_completion"
      ]
    },
    "claimed_rule": {
      "type": "object",
      "required": [
        "method",
        "cycle_completion_declared",
        "cycle_completion_swap",
        "when_cycle",
        "when_condorcet_winner"
      ],
      "properties": {
        "method": { "type": "string", "const": "pairwise_condorcet" },
        "cycle_completion_declared": { "type": "string", "const": "schulze" },
        "cycle_completion_swap": { "type": "string", "const": "plurality_in_smith" }
      }
    },
    "freeze_contract": {
      "type": "object",
      "required": [
        "moment",
        "token",
        "declared_completion",
        "post_ingest_rebind"
      ],
      "properties": {
        "moment": { "type": "string", "const": "before-ballot-ingest" },
        "token": { "type": "string", "minLength": 64, "maxLength": 64 },
        "declared_completion": { "type": "string", "const": "schulze" },
        "post_ingest_rebind": { "type": "string", "const": "rejected" }
      }
    },
    "pairwise_tabulation": { "type": "object" },
    "measured_cycle": {
      "type": "object",
      "required": [
        "pairwise",
        "cycle_detected",
        "declared_winner",
        "swap_winner",
        "load_bearing",
        "verbatim"
      ],
      "properties": {
        "cycle_detected": { "type": "boolean", "const": true },
        "declared_winner": { "type": "string", "const": "B" },
        "swap_winner": { "type": "string", "const": "A" },
        "load_bearing": { "type": "boolean", "const": true },
        "verbatim": { "type": "string", "minLength": 24 }
      }
    },
    "measured_condorcet_winner": {
      "type": "object",
      "required": [
        "cycle_detected",
        "condorcet_winner",
        "winner",
        "swap_winner",
        "verbatim"
      ],
      "properties": {
        "cycle_detected": { "type": "boolean", "const": false },
        "condorcet_winner": { "type": "string", "const": "A" },
        "winner": { "type": "string", "const": "A" },
        "swap_winner": { "type": "string", "const": "A" }
      }
    },
    "measured_posthoc": {
      "type": "object",
      "required": ["ok", "reason", "verbatim"],
      "properties": {
        "ok": { "type": "boolean", "const": false },
        "reason": { "type": "string", "minLength": 8 }
      }
    },
    "independent_recount": {
      "type": "object",
      "required": [
        "mechanism",
        "pairwise",
        "winner",
        "pairwise_cells_match",
        "winner_match"
      ],
      "properties": {
        "pairwise_cells_match": { "type": "boolean", "const": true },
        "winner_match": { "type": "boolean", "const": true },
        "winner": { "type": "string", "const": "B" }
      }
    },
    "markdown": { "type": "string", "minLength": 40 },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict"]
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rejects",
          "fired_on_bad_state",
          "silent_on_good_state",
          "verbatim",
          "verbatim_good",
          "verbatim_bad"
        ],
        "properties": {
          "id": { "type": "string" },
          "rejects": { "type": "string", "minLength": 8 },
          "fired_on_bad_state": { "type": "boolean", "const": true },
          "silent_on_good_state": { "type": "boolean", "const": true },
          "verbatim": { "type": "string", "minLength": 16 },
          "verbatim_good": { "type": "string", "minLength": 8 },
          "verbatim_bad": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string" }
        }
      }
    }
  }
}
