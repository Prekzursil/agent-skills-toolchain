{
  "minimum_n": 11,
  "explicit_gaps": [],
  "aliases": {
    "architect": "proposer",
    "skeptic": "critic",
    "pragmatist": "synthesiser",
    "devils-advocate": "critic",
    "moderator": "chair",
    "facilitator": "chair",
    "editor": "chair",
    "scribe": "clerk",
    "timekeeper": "chair",
    "questioner": "critic",
    "respondent": "proposer",
    "foreperson": "chair",
    "red": "critic",
    "blue": "proposer",
    "proposition": "proposer",
    "opposition": "critic"
  },
  "templates": {
    "chair": {
      "obligations": ["allocate_turns", "keep_agenda"],
      "permissions": ["recognise_speaker", "extend_round"],
      "rights": ["procedure_voice_cannot_be_stripped"],
      "capabilities": {
        "authors": ["agenda"],
        "judges": ["procedure"],
        "votes_on": [],
        "may_speak": true,
        "may_vote": false,
        "may_veto": false,
        "may_chair": true,
        "may_synthesise": false
      }
    },
    "proposer": {
      "obligations": ["produce_proposal"],
      "permissions": ["cite_evidence", "revise_proposal"],
      "rights": ["must_be_heard_once"],
      "capabilities": {
        "authors": ["proposal"],
        "judges": [],
        "votes_on": ["proposal", "objection"],
        "may_speak": true,
        "may_vote": true,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "critic": {
      "obligations": ["produce_objection"],
      "permissions": ["demand_evidence", "cross_examine"],
      "rights": ["objection_must_be_recorded"],
      "capabilities": {
        "authors": ["objection"],
        "judges": [],
        "votes_on": ["proposal", "objection"],
        "may_speak": true,
        "may_vote": true,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "synthesiser": {
      "obligations": ["produce_synthesis_covering_dissent"],
      "permissions": ["compress_record"],
      "rights": ["may_not_be_required_to_propose"],
      "capabilities": {
        "authors": ["synthesis"],
        "judges": [],
        "votes_on": [],
        "may_speak": true,
        "may_vote": false,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": true
      }
    },
    "judge": {
      "obligations": ["rule_admissibility", "issue_ruling"],
      "permissions": ["exclude_evidence"],
      "rights": ["ruling_must_cite_a_critique_or_standard"],
      "capabilities": {
        "authors": ["ruling"],
        "judges": ["proposal", "evidence"],
        "votes_on": [],
        "may_speak": true,
        "may_vote": false,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "juror": {
      "obligations": ["decide_merits"],
      "permissions": ["ask_clarifying_question"],
      "rights": ["hung_verdict_is_representable"],
      "capabilities": {
        "authors": [],
        "judges": ["proposal"],
        "votes_on": ["proposal"],
        "may_speak": true,
        "may_vote": true,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "observer": {
      "obligations": ["remain_silent_until_invited"],
      "permissions": ["take_notes"],
      "rights": ["cannot_be_counted_as_a_vote"],
      "capabilities": {
        "authors": [],
        "judges": [],
        "votes_on": [],
        "may_speak": false,
        "may_vote": false,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "estimator": {
      "obligations": ["produce_estimate_or_forecast"],
      "permissions": ["revise_after_feedback_round"],
      "rights": ["anonymity_until_declared_lift_point"],
      "capabilities": {
        "authors": ["estimate"],
        "judges": [],
        "votes_on": [],
        "may_speak": false,
        "may_vote": false,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "clerk": {
      "obligations": ["custody_of_evidence_record"],
      "permissions": ["flag_missing_exhibit"],
      "rights": ["cannot_be_asked_to_rule"],
      "capabilities": {
        "authors": ["evidence_record"],
        "judges": [],
        "votes_on": [],
        "may_speak": true,
        "may_vote": false,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "scorer": {
      "obligations": ["apply_declared_scoring_rule"],
      "permissions": ["publish_leaderboard"],
      "rights": ["cannot_author_the_scored_forecast"],
      "capabilities": {
        "authors": ["score"],
        "judges": [],
        "votes_on": [],
        "may_speak": true,
        "may_vote": false,
        "may_veto": false,
        "may_chair": false,
        "may_synthesise": false
      }
    },
    "owner": {
      "obligations": ["approve_or_reject_each_step"],
      "permissions": ["pause_resume"],
      "rights": ["stepwise_approval_cannot_be_stripped"],
      "capabilities": {
        "authors": [],
        "judges": ["step"],
        "votes_on": ["step"],
        "may_speak": true,
        "may_vote": true,
        "may_veto": true,
        "may_chair": false,
        "may_synthesise": false
      }
    }
  }
}
