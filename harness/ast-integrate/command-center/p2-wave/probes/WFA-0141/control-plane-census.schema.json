{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0141/control-plane-census.schema.json",
  "title": "WFA-0141 control-plane-census (live control plane)",
  "$comment": "Catalog command-center/schema/foundry-artifact.schema.json#/$defs/control-plane-census is a GENERATED SHIM whose $ref is https://ast-integrate.invalid/... . jsonschema 4.10.3 RefResolver tries the network (measured: RefResolutionError / gaierror). G-1 does not require that hop. This per-unit schema is the live if-then: a census must name both trigger points, the shared counter, both-states controls, and the raised-above-one rows. Do not overwrite the shared catalog shim.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "kind",
    "question",
    "answer",
    "home_plane",
    "shared_counter",
    "trigger_points",
    "acquisition_census",
    "fusion_census",
    "raised_above_one",
    "planted_controls",
    "report",
    "evidence",
    "tests",
    "negative_controls"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0141" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "kind": { "type": "string", "const": "control-plane-census" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "home_plane": { "type": "string", "minLength": 1 },
    "shared_counter": {
      "type": "object",
      "required": ["module", "function", "used_at"],
      "properties": {
        "module": { "type": "string", "minLength": 8 },
        "function": { "type": "string", "const": "count_planes" },
        "used_at": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "enum": ["acquisition", "fusion"] }
        }
      }
    },
    "trigger_points": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "enum": ["acquisition", "fusion"] }
    },
    "acquisition_census": { "type": "object", "minProperties": 1 },
    "fusion_census": { "type": "object", "minProperties": 1 },
    "raised_above_one": { "type": "object", "minProperties": 1 },
    "planted_controls": {
      "type": "object",
      "required": [
        "own_runner_acquisition",
        "pure_mechanism_acquisition",
        "dup_plane_fusion",
        "single_plane_fusion"
      ]
    },
    "report": {
      "type": "object",
      "required": ["kind", "observations", "control_ids"],
      "properties": {
        "kind": { "const": "control-plane-census" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "measured", "method", "anchor"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "measured": { "type": ["string", "number", "boolean"] },
              "method": { "type": "string", "minLength": 1 },
              "anchor": { "type": "string", "minLength": 1 }
            }
          }
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 2 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "SUCCESS" } }, "required": ["state"] },
      "then": {
        "properties": {
          "sentinel": { "pattern": "^SUCCESS:WFA-0141" }
        }
      }
    }
  ]
}
