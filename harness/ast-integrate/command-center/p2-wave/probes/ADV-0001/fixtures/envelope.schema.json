{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ADV-0001/fixtures/envelope.schema.json",
  "title": "Syntactic 12-condition receipt envelope (does not constrain records)",
  "description": "Accepts schema-valid-but-unusable payloads. Consumer fields such as records are additionalProperties and are not required. Garbage objects fail.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "min_bytes_threshold",
    "artifacts",
    "evidence",
    "tests",
    "negative_controls",
    "reviewer",
    "manifest_registration",
    "downstream_consumers",
    "output_schema"
  ],
  "properties": {
    "unit_id": { "type": "string", "minLength": 3 },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "min_bytes_threshold": { "type": "integer", "minimum": 128 },
    "output_schema": { "type": "string", "minLength": 8 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 4 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "exists": { "type": "boolean" },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor", "probes"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": { "type": "string", "minLength": 4 },
          "anchor": { "type": "string", "minLength": 4 },
          "probes": { "type": "array", "minItems": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad_state", "silent_on_good_state"],
        "properties": {
          "id": { "type": "string" },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "manifest_registration": {
      "type": "object",
      "required": ["registered", "manifest_path"],
      "properties": {
        "registered": { "type": "boolean" },
        "manifest_path": { "type": "string" }
      }
    },
    "downstream_consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["consumer", "executed", "read_ok"],
        "properties": {
          "consumer": { "type": "string", "minLength": 3 },
          "executed": { "type": "boolean" },
          "read_ok": { "type": "boolean" }
        }
      }
    }
  }
}
