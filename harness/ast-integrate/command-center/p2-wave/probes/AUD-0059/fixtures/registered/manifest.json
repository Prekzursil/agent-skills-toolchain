{
  "schema_version": 1,
  "source": "AUD-0059-local-dispatch-corpus",
  "note": "Estate hooks/_dispatch/manifest.json is absent on this Linux worktree. This corpus is the executable registered set used to prove firing versus registration.",
  "hooks": [
    {
      "id": "pre-tool",
      "event": "PreToolUse",
      "script": "hooks/pre_tool.py",
      "enabled": true,
      "effect": "inject-context"
    },
    {
      "id": "block-call",
      "event": "PreToolUse",
      "script": "hooks/block_call.py",
      "enabled": true,
      "effect": "blocked-call"
    },
    {
      "id": "post-tool",
      "event": "PostToolUse",
      "script": "hooks/post_tool.py",
      "enabled": true,
      "effect": "ledger-row"
    },
    {
      "id": "stop",
      "event": "Stop",
      "script": "hooks/stop.py",
      "enabled": true,
      "effect": "ledger-row"
    }
  ]
}
