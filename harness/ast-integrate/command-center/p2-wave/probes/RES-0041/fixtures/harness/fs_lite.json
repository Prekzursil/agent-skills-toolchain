{
  "id": "harness.mcp.fs-lite",
  "origin": "harness-fixture",
  "kind": "mcp_server",
  "transport": "stdio-schema-fixture",
  "title": "Small filesystem analogue (medium schema set)",
  "tools": [
    {
      "name": "list_dir",
      "description": "List entries in a directory under the sandbox root.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory path relative to the sandbox root."
          },
          "max_entries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from the sandbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to the sandbox root."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "search",
      "description": "Search file contents under a directory for a literal needle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "needle": {
            "type": "string",
            "minLength": 1
          },
          "glob": {
            "type": "string",
            "description": "Optional filename glob such as *.py"
          }
        },
        "required": ["root", "needle"],
        "additionalProperties": false
      }
    }
  ]
}
