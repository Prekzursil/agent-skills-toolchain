{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0017/sweep_report.schema.json",
  "title": "WFA-0017 local SweepReport stand-in while WFA-0001 pack omits SweepReport",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "question",
    "answer",
    "detector_control",
    "load_semantics",
    "g_family_96",
    "tests",
    "reviewer"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0017" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "report_kind": { "type": "string", "const": "SweepReport" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 }
  }
}
