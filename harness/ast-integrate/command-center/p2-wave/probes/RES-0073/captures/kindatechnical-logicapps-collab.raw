<!-- Analytics (lightweight, privacy-first) -->
<script>
(function(){
  var API = 'https://7rr5rkp6sr3gy3ajuohdci2cuq0ogqtw.lambda-url.us-east-1.on.aws';
  var ctx = window.KT_PAGE_CONTEXT || {};
  var anonId;
  try { var g = JSON.parse(localStorage.getItem('kt_global')); anonId = g && g.anonId; } catch(e) {}
  if (!anonId) return;

  function send(type, data) {
    var ev = Object.assign({ type: type, anonId: anonId, t: Date.now() }, data || {});
    if (navigator.sendBeacon) {
      navigator.sendBeacon(API + '/event', JSON.stringify(ev));
    } else {
      fetch(API + '/event', { method: 'POST', body: JSON.stringify(ev), keepalive: true }).catch(function(){});
    }
  }

  // Track page view
  send('page_view', { courseId: ctx.courseId || null, path: location.pathname });

  // Expose for gamification.js hooks
  window._ktAnalytics = function(type, data) { send(type, data); };
})();
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Code highlighting
    Prism.highlightAll();

    // Course/topics tree toggle
    var toggles = document.querySelectorAll('.toggle');
    toggles.forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var ul = this.parentElement.nextElementSibling;
        if (ul) {
          ul.classList.toggle('collapsed');
          this.textContent = this.textContent === '+' ? '-' : '+';
        }
      });
    });

    // Dark mode toggle
    var themeToggle = document.getElementById('kt-theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', function() {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('kt-theme', next);
      });
    }

    // Mobile bottom nav: Progress button opens gamification dashboard
    var progressBtn = document.getElementById('kt-mobile-progress-btn');
    if (progressBtn) {
      progressBtn.addEventListener('click', function() {
        if (typeof window.KTGamification !== 'undefined' && window.KTGamification.openDashboard) {
          window.KTGamification.openDashboard();
        }
      });
    }

    // Mobile bottom nav: Menu button toggles navbar
    var menuBtn = document.getElementById('kt-mobile-menu-btn');
    if (menuBtn) {
      menuBtn.addEventListener('click', function() {
        $('#navigation').collapse('toggle');
      });
    }

    // Highlight active mobile nav item
    var currentPath = window.location.pathname;
    document.querySelectorAll('.kt-mobile-nav-item').forEach(function(item) {
      var href = item.getAttribute('href');
      if (href && currentPath === href) {
        item.classList.add('active');
      }
    });
  });
</script>


