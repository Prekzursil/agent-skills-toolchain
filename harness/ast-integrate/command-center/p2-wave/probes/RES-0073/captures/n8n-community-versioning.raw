/user_avatar/community.n8n.io/system/{size}/36532_2.png","admin":true,"moderator":true,"trust_level":4}},{"extras":null,"description":"Recent Poster","user":{"id":3026,"username":"bartv","name":"","avatar_template":"/user_avatar/community.n8n.io/bartv/{size}/156374_2.png","primary_group_name":"n8n_Team","flair_name":"n8n_Team","flair_url":"https://europe1.discourse-cdn.com/n8n/original/2X/4/4429de47116c2122388acdf61087c1d1ee1eae5f.png","flair_group_id":46,"admin":true,"moderator":true,"trust_level":2}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","laughing","open_mouth","clap","confetti_ball","hugs"],"accepted_answers":[{"id":550304,"username":"Niffzy","avatar_template":"/user_avatar/community.n8n.io/niffzy/{size}/158156_2.png","created_at":"2026-05-14T11:03:02.270Z","cooked":"\u003cp\u003eHi \u003ca class=\"mention\" href=\"/u/kabrooks\"\u003e@Kabrooks\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eMost production teams use: Separate n8n instances for Dev → Staging → Production\u003c/p\u003e\n\u003cp\u003einstead of editing workflows directly in production.\u003c/p\u003e\n\u003cp\u003eYou will Build and test in Dev\u003c/p\u003e\n\u003cp\u003eTest again in Staging, Move to Production only when everything works\u003c/p\u003e\n\u003cp\u003eThen you Save/export workflows to Git for version history\u003cbr\u003e\nUse environment variables for API keys, URLs, and database settings\u003cbr\u003e\nKeep credentials different for each environment\u003c/p\u003e\n\u003cp\u003eThis works best and Easier to track changes\u003c/p\u003e\n\u003cp\u003eSafer updates\u003c/p\u003e\n\u003cp\u003eEasy rollback if something breaks\u003c/p\u003e\n\u003cp\u003eLower chance of breaking production workflows\u003c/p\u003e","post_number":4,"topic_id":295660,"url":"/t/versioning-and-deploying-n8n-workflows-across-dev-staging-and-production/295660/4"}],"has_accepted_answer":true,"shared_issue_count":0,"can_create_shared_issue":false,"shared_issue_visible":true,