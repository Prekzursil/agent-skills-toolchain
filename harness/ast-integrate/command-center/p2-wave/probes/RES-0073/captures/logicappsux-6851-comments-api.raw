orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-31T15:50:04Z","updated_at":"2025-03-31T15:50:04Z","body":"The automation is based on the Label, but it does need to be added/removed manually. I'll take a look at this issue today and investigate why its happening","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2766655309/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2767097715","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2767097715","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2767097715,"node_id":"IC_kwDOF9Gzt86k7o9z","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-03-31T18:42:46Z","updated_at":"2025-03-31T18:42:46Z","body":"Cheers, mate ... I thought I'd added a bunch of additional information ... hadn't meant to bother you. Sorry!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2767097715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2770821634","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2770821634","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2770821634,"node_id":"IC_kwDOF9Gzt86lJ2IC","user":{"login":"Eric-B-Wu","id":95886809,"node_id":"U_kgDOBbcd2Q","avatar_url":"https://avatars.githubusercontent.com/u/95886809?v=4","gravatar_id":"","url":"https://api.github.com/users/Eric-B-Wu","html_url":"https://github.com/Eric-B-Wu","followers_url":"https://api.github.com/users/Eric-B-Wu/followers","following_url":"https://api.github.com/users/Eric-B-Wu/following{/other_user}","gists_url":"https://api.github.com/users/Eric-B-Wu/gists{/gist_id}","starred_url":"https://api.github.com/users/Eric-B-Wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eric-B-Wu/subscriptions","organizations_url":"https://api.github.com/users/Eric-B-Wu/orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-01T22:25:27Z","updated_at":"2025-04-01T22:26:01Z","body":"@influential-eliot, I tried to reproduce this issue; however I haven't been able to do so in the Logic Apps portal. I'll attach a screen recording - You had mentioned this is happening in Power Automate, and I just wanted to let you know that Power Automate and Logic Apps have forked code bases, so if this is only occurring in Power Automate the bug will need to be fixed on their end. \n\nhttps://github.com/user-attachments/assets/56b27723-b4a5-4c35-937f-9bbe8690cad1\n\nIf you're still able to reproduce the issue in Logic Apps, please feel free to leave any additional information and I can try to reproduce on my end","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2770821634/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2772297612","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2772297612","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2772297612,"node_id":"IC_kwDOF9Gzt86lPeeM","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-02T11:42:26Z","updated_at":"2025-04-02T11:42:26Z","body":"Actually, I stated that this was happening in Logic Apps, and have provided the data above that shows where and when that occurred.\nhttps://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2751449583\n\n\nI also stated that it [happened](https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2752359723) past tense, I have not seen this recur, since, but I do not know if it has affected anything else.\n> On the notcontains() issue, I literally replicated the Power Automate user's issues myself, in Power Automate and Logic Apps (since removed). So it definitely was happening, whether or not it is STILL happening, is not really something that I have had any time to test.\nClearly changes have occurred on the contains() functionaality, lately, with new (undocutmented) abilities to query object key names. I posited (perhaps elsewhere) that this may be tied into those changes ... however back-end that they were.\n\nThe mention of Power Automate was indicating that the same behaviour had been observed (now, by multiple people) over on that platform.\n\nIf the two applications are now split, where is the public recourse for them to raise such issues with their version of things? (_no, you don't need to answer that question, it's mostly sardonic_)\n\nStill ... I'd wager that multiple users, on two separate platforms (me on Logic Apps others on PAuto) are experiencing identical problems ... then ... 🤔  ... I dunno ... just ... feels like perhaps it's something worth mentioning at the very least ... right?\n\n---\n\nMultiple users are still finding my LinkedIn posts about this ... for what it's worth ... and thanking me for at least providing a workaround.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2772297612/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2775896103","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2775896103","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2775896103,"node_id":"IC_kwDOF9Gzt86ldNAn","user":{"login":"hartra344","id":13208452,"node_id":"MDQ6VXNlcjEzMjA4NDUy","avatar_url":"https://avatars.githubusercontent.com/u/13208452?v=4","gravatar_id":"","url":"https://api.github.com/users/hartra344","html_url":"https://github.com/hartra344","followers_url":"https://api.github.com/users/hartra344/followers","following_url":"https://api.github.com/users/hartra344/following{/other_user}","gists_url":"https://api.github.com/users/hartra344/gists{/gist_id}","starred_url":"https://api.github.com/users/hartra344/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hartra344/subscriptions","organizations_url":"https://api.github.com/users/hartra344/orgs","repos_url":"https://api.github.com/users/hartra344/repos","events_url":"https://api.github.com/users/hartra344/events{/privacy}","received_events_url":"https://api.github.com/users/hartra344/received_events","type":"User","user_view_type":"public","site_admin":true},"created_at":"2025-04-03T14:00:57Z","updated_at":"2025-04-03T14:00:57Z","body":"It’s possible that we have fixed the issue on Logic Apps if you’re not seeing it there anymore. Power Automate however might not have, at the end of last year they forked this code so they could make changes that allow them to provide deeper platform specific integration.  I’ll send them a ping so they know about it.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2775896103/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2776294033","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2776294033","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2776294033,"node_id":"IC_kwDOF9Gzt86leuKR","user":{"login":"Eric-B-Wu","id":95886809,"node_id":"U_kgDOBbcd2Q","avatar_url":"https://avatars.githubusercontent.com/u/95886809?v=4","gravatar_id":"","url":"https://api.github.com/users/Eric-B-Wu","html_url":"https://github.com/Eric-B-Wu","followers_url":"https://api.github.com/users/Eric-B-Wu/followers","following_url":"https://api.github.com/users/Eric-B-Wu/following{/other_user}","gists_url":"https://api.github.com/users/Eric-B-Wu/gists{/gist_id}","starred_url":"https://api.github.com/users/Eric-B-Wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eric-B-Wu/subscriptions","organizations_url":"https://api.github.com/users/Eric-B-Wu/orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-03T16:08:08Z","updated_at":"2025-04-03T16:08:08Z","body":"It could be this PR https://github.com/Azure/LogicAppsUX/pull/5980 which PA doesn't have in their repo ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2776294033/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2778472081","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2778472081","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2778472081,"node_id":"IC_kwDOF9Gzt86lnB6R","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-04T11:52:54Z","updated_at":"2025-04-04T11:52:54Z","body":"Thanks,@hartra344 ! \n> It’s possible that we have fixed the issue on Logic Apps if you’re not seeing it there anymore. \n\nOn the PAuto, I'll 'spoiler' it so as not to diverge this thread ( _and let you ignore if needed_ 😏).\n    <details> <summary>... On Power Automate Forking Off ...</summary>  ... I'll stop discussing it after this ... promise (_!_) ...\n> Power Automate however might not have, at the end of last year they forked this code so they could make changes that allow them to provide deeper platform specific integration. I’ll send them a ping so they know about it.\n... but I would just say that it is a shame that they do not have a more ... public ... presence, like this GitHub repo. \n\nBecause they then end up with a lot of uninformed, sometimes angry, users with no real way to verify what they're experiencing. But that's not a problem for you to fix, I suppose. :) I do also know that Microsoft's public GitHub repos do get a modicum of '_incorrect_' usage, too, in users raising issues that are not strictly for that place. Like, here, you may get issues raised which are just people not understanding HOW `contains()` works, rather than that it might be getting mangled. ( _which is perhaps one of the contributing factors to the removal of the Learn Documentation repo - which I was saddened by_)\n    </details>\n\n---\n\nThat also looks VERY much like the same thing, @Eric-B-Wu ... \n>It could be this PR **5980** which PA doesn't have in their repo\n\nI don't know if I'm reading that fix right, it looks like it is reactionary for when there is bad code generated, right?\n\nIf I **am** reading that right 😅  ... would it be odd to suggest that rather than _reacting_ to the UI making bad changes and reversing them, that it might be a potentially not ideal way for said system to operate in the first place? That perhaps if it didn't malform the code in the first place might be a grander goal?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2778472081/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2779477878","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2779477878","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2779477878,"node_id":"IC_kwDOF9Gzt86lq3d2","user":{"login":"Eric-B-Wu","id":95886809,"node_id":"U_kgDOBbcd2Q","avatar_url":"https://avatars.githubusercontent.com/u/95886809?v=4","gravatar_id":"","url":"https://api.github.com/users/Eric-B-Wu","html_url":"https://github.com/Eric-B-Wu","followers_url":"https://api.github.com/users/Eric-B-Wu/followers","following_url":"https://api.github.com/users/Eric-B-Wu/following{/other_user}","gists_url":"https://api.github.com/users/Eric-B-Wu/gists{/gist_id}","starred_url":"https://api.github.com/users/Eric-B-Wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eric-B-Wu/subscriptions","organizations_url":"https://api.github.com/users/Eric-B-Wu/orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-04T18:29:10Z","updated_at":"2025-04-04T18:29:10Z","body":"When I created this bugfix I saw the issue happen in this case:\n1. User creates a query using @not(contains()) and saves\n2. Looking at code view save is correct\n3. User reopens Designer and views the query\n4. Query is deserialized incorrectly, and thus causes the bug\n5. If users saves again without modifying the query back to normal, it'll save as incorrect causing a save to be on the malformed value\n\n\nThis [PR](https://github.com/Azure/LogicAppsUX/pull/5980/files) is for derserialization (step4) where it converts a serialized value (the value saved in code view) to an editor-readable form of the parameter. I believe the issue isn't that we save it incorrectly, but that we take a saved value and deserialize it wrongly causing future saves to save incorrectly.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2779477878/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2784286767","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2784286767","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2784286767,"node_id":"IC_kwDOF9Gzt86l9Ngv","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"created_at":"2025-04-07T19:02:17Z","updated_at":"2025-04-07T19:02:17Z","body":"We requested more information to triage this issue. If the issue goes more than 7 days with no more information it'll be automatically closed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2784286767/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":15368,"client_id":"Iv1.05c79e9ad1f6bdfa","slug":"github-actions","node_id":"MDM6QXBwMTUzNjg=","owner":{"login":"github","id":9919,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/9919?v=4","gravatar_id":"","url":"https://api.github.com/users/github","html_url":"https://github.com/github","followers_url":"https://api.github.com/users/github/followers","following_url":"https://api.github.com/users/github/following{/other_user}","gists_url":"https://api.github.com/users/github/gists{/gist_id}","starred_url":"https://api.github.com/users/github/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github/subscriptions","organizations_url":"https://api.github.com/users/github/orgs","repos_url":"https://api.github.com/users/github/repos","events_url":"https://api.github.com/users/github/events{/privacy}","received_events_url":"https://api.github.com/users/github/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"GitHub Actions","description":"Automate your workflow from idea to production","external_url":"https://help.github.com/en/actions","html_url":"https://github.com/apps/github-actions","created_at":"2018-07-30T09:30:17Z","updated_at":"2026-06-18T16:17:48Z","permissions":{"actions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","drives":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]},"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2784417135","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2784417135","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2784417135,"node_id":"IC_kwDOF9Gzt86l9tVv","user":{"login":"Eric-B-Wu","id":95886809,"node_id":"U_kgDOBbcd2Q","avatar_url":"https://avatars.githubusercontent.com/u/95886809?v=4","gravatar_id":"","url":"https://api.github.com/users/Eric-B-Wu","html_url":"https://github.com/Eric-B-Wu","followers_url":"https://api.github.com/users/Eric-B-Wu/followers","following_url":"https://api.github.com/users/Eric-B-Wu/following{/other_user}","gists_url":"https://api.github.com/users/Eric-B-Wu/gists{/gist_id}","starred_url":"https://api.github.com/users/Eric-B-Wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eric-B-Wu/subscriptions","organizations_url":"https://api.github.com/users/Eric-B-Wu/orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-07T19:26:08Z","updated_at":"2025-04-07T19:26:08Z","body":"Closing the issue as this seems to be only happening in PA now","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2784417135/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2794318689","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2794318689","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2794318689,"node_id":"IC_kwDOF9Gzt86mjeth","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-10T15:49:20Z","updated_at":"2025-04-10T15:49:20Z","body":"Not sure if this is related, but without me going close to the staticResults in any updates (_FireFox, latest_), it is now returning a very strange response in the GUI when I wanted to go and update them:\n\n![Image](https://github.com/user-attachments/assets/7c66896d-42f2-4eb2-95b2-c3cae96b2af9)\n\nI have not altered anything on that action, and yet it is stating that they are required ... when they are / were already set.\n\n---\n\nThe workflow runs OK, and the expected staticResults are sent ... but the error persists, like they were removed.\n\nI don't have the time, right now, to log this anew, but I will ... I just thought that I would mention it (_without need for response_) in the context of this issue (_above_) and those ongoing on PAuto. 👍 \n\n---\n \nI have gone into code view and updated them (_again, changing nothing else_) and it *still* runs with the staticResult after that ... so I'm not sure what this is. But will update once I have the chance to restart the browser.\n\n![Image](https://github.com/user-attachments/assets/eea94d65-d9d3-4f02-baae-63561cb2a68d)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2794318689/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2810406919","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2810406919","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2810406919,"node_id":"IC_kwDOF9Gzt86ng2gH","user":{"login":"ek68794998","id":1350074,"node_id":"MDQ6VXNlcjEzNTAwNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/1350074?v=4","gravatar_id":"","url":"https://api.github.com/users/ek68794998","html_url":"https://github.com/ek68794998","followers_url":"https://api.github.com/users/ek68794998/followers","following_url":"https://api.github.com/users/ek68794998/following{/other_user}","gists_url":"https://api.github.com/users/ek68794998/gists{/gist_id}","starred_url":"https://api.github.com/users/ek68794998/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ek68794998/subscriptions","organizations_url":"https://api.github.com/users/ek68794998/orgs","repos_url":"https://api.github.com/users/ek68794998/repos","events_url":"https://api.github.com/users/ek68794998/events{/privacy}","received_events_url":"https://api.github.com/users/ek68794998/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T18:37:02Z","updated_at":"2025-04-16T18:37:02Z","body":"> It could be this PR [#5980](https://github.com/Azure/LogicAppsUX/pull/5980) which PA doesn't have in their repo\n\n@Eric-B-Wu We actually took this fix back in January and it was available to all users in mid-February ([commit](https://dev.azure.com/msazure/OneAgile/_git/2fa825bf-ee67-4231-bcb1-329c2e4979a7/commit/398576c26a7094259425b2dd4bd15bdccd44bd30)). I'm wondering if maybe the fix is incomplete? Do we still have a consistent repro in PA which is not repro-able in LA?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2810406919/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2810831339","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2810831339","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2810831339,"node_id":"IC_kwDOF9Gzt86nieHr","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T21:25:42Z","updated_at":"2025-04-16T21:49:23Z","body":"@ek68794998 and @Eric-B-Wu  ... this literally just occurred again on PROD on Logic Apps.\n \nNot sure how I can send you any information, because this is a client's Logic App, so there's the confidentiality, there... but here's the failure of a run ... on PROD ... on Logic Apps ... due to the notcontains() variant of this issue.\n\nPretty sure that this is a reopen, no?\n\n![Image](https://github.com/user-attachments/assets/50f6ed2e-7b0e-453f-997b-44410aaa96bc)\n\nI'll try to grab more from the logs.\n\n# First Instance\n## **1.a** Check Action\n![Image](https://github.com/user-attachments/assets/3c76b40d-2b87-4de6-895a-50b33c8f4722)\n## **1.b** Check Action Code\n![Image](https://github.com/user-attachments/assets/c3edee7f-b2a4-4bda-8bb9-a26c5bb29993)\n## **2.a** Tap In Where Condition Then Tap Out\n![Image](https://github.com/user-attachments/assets/a10e0408-52fa-4e3e-9f72-2f45f51f071f)\n## **2.b** Action Code - No Change\n![Image](https://github.com/user-attachments/assets/d97e1182-6fba-4f42-83cc-6d6f47455501)\n## **3.a** Open Advanced Where Condition But Don't Tap In\n![Image](https://github.com/user-attachments/assets/ef39c0d0-1727-41bb-99dc-d36920982ec9)\n## **3.b** Action Code - No Change\n![Image](https://github.com/user-attachments/assets/497d2363-8f31-4e85-8449-ef2633e16f2c)\n## **3.a** Tap **In** Advanced Where Condition Then Tap Out (Code View Afterwards)\n![Image](https://github.com/user-attachments/assets/6d57d737-3ce5-4e95-bf33-e3d9b5d17b43)]\n\n## Log Information\nThis occurred at ~2106 UK time ...\n![Image](https://github.com/user-attachments/assets/815fff60-ad47-4b70-92e1-0cde0f9a76ac)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2810831339/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2810899263","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2810899263","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2810899263,"node_id":"IC_kwDOF9Gzt86nius_","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-04-16T21:53:57Z","updated_at":"2025-04-16T21:53:57Z","body":"I might have an idea about the cause, too ... I was doing some heavy mucking around with Run After stuff ... and I remember it taking a hot second to course correct ... but then eventually it displayed the sequence of actions (at the end of the flow) as it should have.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2810899263/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2860324519","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2860324519","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2860324519,"node_id":"IC_kwDOF9Gzt86qfRan","user":{"login":"ek68794998","id":1350074,"node_id":"MDQ6VXNlcjEzNTAwNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/1350074?v=4","gravatar_id":"","url":"https://api.github.com/users/ek68794998","html_url":"https://github.com/ek68794998","followers_url":"https://api.github.com/users/ek68794998/followers","following_url":"https://api.github.com/users/ek68794998/following{/other_user}","gists_url":"https://api.github.com/users/ek68794998/gists{/gist_id}","starred_url":"https://api.github.com/users/ek68794998/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ek68794998/subscriptions","organizations_url":"https://api.github.com/users/ek68794998/orgs","repos_url":"https://api.github.com/users/ek68794998/repos","events_url":"https://api.github.com/users/ek68794998/events{/privacy}","received_events_url":"https://api.github.com/users/ek68794998/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-07T20:52:48Z","updated_at":"2025-05-07T20:52:48Z","body":"I think this is because `operationLiteral` is based on `operation` which has been converted to `notcontains`. I think the `operationLiteral` needs to retain the `not(contains(` structure (and `endingLiteral` needs the `))`).\n\n![Image](https://github.com/user-attachments/assets/e9a61173-8023-467e-90b7-3139a35ee54a)\n\ncc @Eric-B-Wu ","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2860324519/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2860355840","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2860355840","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2860355840,"node_id":"IC_kwDOF9Gzt86qfZEA","user":{"login":"ek68794998","id":1350074,"node_id":"MDQ6VXNlcjEzNTAwNzQ=","avatar_url":"https://avatars.githubusercontent.com/u/1350074?v=4","gravatar_id":"","url":"https://api.github.com/users/ek68794998","html_url":"https://github.com/ek68794998","followers_url":"https://api.github.com/users/ek68794998/followers","following_url":"https://api.github.com/users/ek68794998/following{/other_user}","gists_url":"https://api.github.com/users/ek68794998/gists{/gist_id}","starred_url":"https://api.github.com/users/ek68794998/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ek68794998/subscriptions","organizations_url":"https://api.github.com/users/ek68794998/orgs","repos_url":"https://api.github.com/users/ek68794998/repos","events_url":"https://api.github.com/users/ek68794998/events{/privacy}","received_events_url":"https://api.github.com/users/ek68794998/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-07T21:02:13Z","updated_at":"2025-05-07T21:02:13Z","body":"What's interesting is that if I make a change to resolve the above, it explicitly runs into a test case that is expecting `notcontains`: [`helper.spec.ts:3504`](https://github.com/Azure/LogicAppsUX/blob/36699ad1df8e3a72fff8f198f75834bc9d88fb80/libs/designer/src/lib/core/utils/parameters/__test__/helper.spec.ts#L3504)\n\n![Image](https://github.com/user-attachments/assets/624a33b2-0993-40fc-9c8f-7718a88f377d)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2860355840/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2862175735","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2862175735","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2862175735,"node_id":"IC_kwDOF9Gzt86qmVX3","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-08T08:15:57Z","updated_at":"2025-05-08T08:15:57Z","body":"I can't pretend to understand it all, but I think I'm with you, @ek68794998 ... I think that this alone might be worthy of reopening this, no?\n \nMight I be so bold as to remind of **[the other item that is getting mangled whilst it's trying its best to put all the new line and tab entries in everything for when we put our expressions in with hierarchy](https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2751449583)**?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2862175735/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2863674745","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2863674745","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2863674745,"node_id":"IC_kwDOF9Gzt86qsDV5","user":{"login":"Eric-B-Wu","id":95886809,"node_id":"U_kgDOBbcd2Q","avatar_url":"https://avatars.githubusercontent.com/u/95886809?v=4","gravatar_id":"","url":"https://api.github.com/users/Eric-B-Wu","html_url":"https://github.com/Eric-B-Wu","followers_url":"https://api.github.com/users/Eric-B-Wu/followers","following_url":"https://api.github.com/users/Eric-B-Wu/following{/other_user}","gists_url":"https://api.github.com/users/Eric-B-Wu/gists{/gist_id}","starred_url":"https://api.github.com/users/Eric-B-Wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eric-B-Wu/subscriptions","organizations_url":"https://api.github.com/users/Eric-B-Wu/orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-08T16:42:51Z","updated_at":"2025-05-08T16:42:51Z","body":"I think the issue lies here:\nPreviously we had serialized with an incorrect `@notcontains(` which ends up failing backend validation. However, we created a fix later on that converts it back to `@not(contains(` . However, that is more of a bandaid fix, as the problem now is that because we don't apply validation on advanced mode, if users explicitly set the filter expression to be something like `@notcontains('test1','test2')` from either the advanced mode or code view; although not \"valid\" we allow it to be converted back to the non-advanced mode and serialize as valid because we previously expected that form. I'll reopen this to address the `@notcontains` being the form at the editor-level when it should not be","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2863674745/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2866508472","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2866508472","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2866508472,"node_id":"IC_kwDOF9Gzt86q23K4","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-09T13:18:21Z","updated_at":"2025-05-09T13:33:29Z","body":"Could it have anything to do with any of this code being used elsewhere?\n\nI am specifically referring to Power Apps, where there are expressions there that **_would_** be valid using `notcontains()` ... at least ... I think there are ... I am not an **expert** in that venue.\n\nAgain, though, @Eric-B-Wu ... I'd like to just remind that it wasn't just confined to the notcontains() ... there was also the 'stringifying' of action inputs that were JSON based data (_which changes the 'type' of the 'input' key in the code into an object_) which were dependent on an expression as a part of that. Those inputs were nullified by undue code transformation making the whole input just a string of text, rather than a valid JSON object. I mentioned about this in the comment just before yours.\n\n( _sorry, I'm not trying to be a nag about any of this, just making sure that it's noted / etc :)_ )","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2866508472/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2866595776","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2866595776","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2866595776,"node_id":"IC_kwDOF9Gzt86q3MfA","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-09T13:40:10Z","updated_at":"2025-05-09T14:10:50Z","body":"# Recurrence Of `notcontains()`\nIncidentally, the `notcontains()` occurred, again, today, in a DEV Logic App, after amending unrelated actions, in a standard Firefox browser.\n\nI worked around this using the by searching codeview for `notcontains(` to identify '_broken_' actions, then applied the workaround mentioned in a previous comment (_tap the 'where' advanced, tap into the expression, tap the 'where' basic, and save_) to good affect.\n\n**EDIT** - It just occurred again.\n\n---\n\n# Finding Broken Code - Stringified JSON Method\nFor the reference of anyone that arrives here from a web-search, I also think I have check that you can do for where you have Compose (_or other?_) actions which are dependent on being recognised as JSON. The issue is that the designer changes your entire JSON object into string. \n\nThe way to find these is to switch to code view (_or download an export from Power Automate_) and search for `\"inputs\": \"{` (_or possibly `\"inputs\":\"{`_) as that will indicate a compose that has changed a JSON object into a string.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2866595776/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2872936685","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2872936685","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2872936685,"node_id":"IC_kwDOF9Gzt86rPYjt","user":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"created_at":"2025-05-12T15:02:58Z","updated_at":"2025-05-12T15:02:58Z","body":"We requested more information to triage this issue. If the issue goes more than 7 days with no more information it'll be automatically closed.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2872936685/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":{"id":15368,"client_id":"Iv1.05c79e9ad1f6bdfa","slug":"github-actions","node_id":"MDM6QXBwMTUzNjg=","owner":{"login":"github","id":9919,"node_id":"MDEyOk9yZ2FuaXphdGlvbjk5MTk=","avatar_url":"https://avatars.githubusercontent.com/u/9919?v=4","gravatar_id":"","url":"https://api.github.com/users/github","html_url":"https://github.com/github","followers_url":"https://api.github.com/users/github/followers","following_url":"https://api.github.com/users/github/following{/other_user}","gists_url":"https://api.github.com/users/github/gists{/gist_id}","starred_url":"https://api.github.com/users/github/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github/subscriptions","organizations_url":"https://api.github.com/users/github/orgs","repos_url":"https://api.github.com/users/github/repos","events_url":"https://api.github.com/users/github/events{/privacy}","received_events_url":"https://api.github.com/users/github/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"GitHub Actions","description":"Automate your workflow from idea to production","external_url":"https://help.github.com/en/actions","html_url":"https://github.com/apps/github-actions","created_at":"2018-07-30T09:30:17Z","updated_at":"2026-06-18T16:17:48Z","permissions":{"actions":"write","administration":"read","artifact_metadata":"write","attestations":"write","checks":"write","code_quality":"write","contents":"write","copilot_requests":"write","deployments":"write","discussions":"write","drives":"write","issues":"write","merge_queues":"write","metadata":"read","models":"read","packages":"write","pages":"write","pull_requests":"write","repository_hooks":"write","repository_projects":"write","security_events":"write","statuses":"write","vulnerability_alerts":"read"},"events":["branch_protection_rule","check_run","check_suite","create","delete","deployment","deployment_status","discussion","discussion_comment","fork","gollum","issues","issue_comment","label","merge_group","milestone","page_build","public","pull_request","pull_request_review","pull_request_review_comment","push","registry_package","release","repository","repository_dispatch","status","watch","workflow_dispatch","workflow_run"]},"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2879760614","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2879760614","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2879760614,"node_id":"IC_kwDOF9Gzt86rpajm","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-14T11:00:45Z","updated_at":"2025-05-14T11:00:53Z","body":"Sorry to @ again, @Eric-B-Wu ... would you maybe agree that the '_more info_' automation can be turned off on this one? ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2879760614/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2883206699","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2883206699","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2883206699,"node_id":"IC_kwDOF9Gzt86r2j4r","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-15T09:42:37Z","updated_at":"2025-05-15T09:53:54Z","body":"Oh, and not to pile on (_perhaps they should be separated out?_) but I've found another instance of the code changing I listed **[here](https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2751449583)**.\n \n# Recurrence Of Undue Background Code Change / Stringification\nThis occurrence (_again, completely unbidden_) changed the following code (_no sensitive data_) for a **Parse JSON** action named as \"_SharePointListDataConstantsObjCNST_\" in my workflow.\n\nI have done a cursory check of the other Parse JSON actions in the workflow and they appear to be OK, all but one of which ran successfully in last night's run and passed muster.\n\n1. <details><summary>Original <strong>Parse JSON</strong> code ...</summary>\n\n     ```json\n     {\n       \"type\": \"ParseJson\",\n       \"description\": \"This presents as much of the SharePoint List Data in a useable format, where required.\",\n       \"inputs\": {\n         \"content\": {\n           \"NoId\": \"@json(\\n\\tif(\\n\\t\\tequals(\\n\\t\\t\\tlength(body('SelectFormatSpItemsForObjectConversionArrCNST')), \\n\\t\\t\\t0\\n\\t\\t), \\n\\t\\t'{}', \\n\\t\\treplace(\\n\\t\\t\\tjoin(\\n\\t\\t\\t\\tbody('SelectFormatSpItemsForObjectConversionArrCNST'), \\n\\t\\t\\t\\t'sdofh$$gkfjbgdkfjb'\\n\\t\\t\\t), \\n\\t\\t\\t'}sdofh$$gkfjbgdkfjb{', \\n\\t\\t\\t','\\n\\t\\t)\\n\\t)\\n)\",\n           \"PersonIdExternalToId\": \"@json(\\n\\tif(\\n\\t\\tequals(\\n\\t\\t\\tlength(body('SelectPersonIdSpIdArrCNST')), \\n\\t\\t\\t0\\n\\t\\t), \\n\\t\\t'{}', \\n\\t\\treplace(\\n\\t\\t\\tjoin(\\n\\t\\t\\t\\tbody('SelectPersonIdSpIdArrCNST'), \\n\\t\\t\\t\\t'sdofh$$gkfjbgdkfjb'\\n\\t\\t\\t), \\n\\t\\t\\t'}sdofh$$gkfjbgdkfjb{', \\n\\t\\t\\t','\\n\\t\\t)\\n\\t)\\n)\",\n           \"PersonIdExternals\": \"@body('SelectPersonIdExternalSpArrCNST')\",\n           \"HrDataPersonIdExternals\": \"@body('SelectListOfPersonIdExternalFromApiArrCNST')\",\n           \"HrDataListCountLessThanSharePoint\": \"@less(\\n\\tlength(body('SelectListOfPersonIdExternalFromApiArrCNST')), \\n\\tlength(body('SelectPersonIdExternalSpArrCNST'))\\n)\",\n           \"HrDataListContainsDupes\": \"@less(\\n\\tlength(\\n\\t\\tunion(\\n\\t\\t\\tbody('SelectUnionToOneObjectArrCNST'), \\n\\t\\t\\tbody('SelectUnionToOneObjectArrCNST')\\n\\t\\t)\\n\\t),\\n\\tlength(\\n\\t\\tbody('SelectUnionToOneObjectArrCNST')\\n\\t)\\n)\"\n         },\n         \"schema\": {\n           \"description\": \"This provides simple lists, some arrays converted to objects, and more.\",\n           \"properties\": {\n             \"HrDataListContainsDupes\": {\n               \"description\": \"This lists all of the items in the SharePoint List as an Object without their ID for comparison purposes.\",\n               \"title\": \"- Has Dupes In HR Data List\",\n               \"type\": \"boolean\"\n             },\n             \"NoId\": {\n               \"description\": \"This lists all of the items in the SharePoint List as an Object without their ID for comparison purposes.\",\n               \"title\": \"- Comparison Items\",\n               \"type\": \"object\"\n             },\n             \"PersonIdExternalToId\": {\n               \"description\": \"This is just an object that provides a given 'personIdExternal' its relevant SharePoint ID.\",\n               \"title\": \"- ID\",\n               \"type\": \"object\"\n             },\n             \"PersonIdExternals\": {\n               \"description\": \"This lists all of the PersonIdExternal IDs in the SharePoint List as a simple array.\",\n               \"title\": \"- Person ID Externals List\",\n               \"type\": \"array\"\n             },\n             \"HrDataPersonIdExternals\": {\n               \"description\": \"This lists all of the PersonIdExternal IDs in from the API request as a simple array.\",\n               \"title\": \"- Hr Data Person ID Externals List\",\n               \"type\": \"array\"\n             },\n             \"HrDataListCountLessThanSharePoint\": {\n               \"description\": \"This states if the API results are less than the SharePoint results (meaning that someone has left the department).\",\n               \"title\": \"- Hr Data Person ID Externals List\",\n               \"type\": \"boolean\"\n             }\n           },\n           \"title\": \"SharePoint Data Manipulations\",\n           \"type\": \"object\"\n         }\n       },\n       \"runAfter\": {\n         \"SelectFormatSpItemsForObjectConversionArrCNST\": [\n           \"Succeeded\"\n         ],\n         \"SelectPersonIdExternalSpArrCNST\": [\n           \"Succeeded\"\n         ],\n         \"SelectPersonIdSpIdArrCNST\": [\n           \"Succeeded\"\n         ],\n         \"SelectListOfPersonIdExternalFromApiArrCNST\": [\n           \"Succeeded\"\n         ]\n       }\n     }\n     ```\n   </details>\n\n2. <details><summary>New, <strong><em>wrongly changed</em> Parse JSON</strong> code ...</summary>\n\n     ```json\n     {\n       \"type\": \"ParseJson\",\n       \"description\": \"This presents as much of the SharePoint List Data in a useable format, where required.\",\n       \"inputs\": {\n         \"content\": {\n           \"NoId\": \"@{json(\\n\\tif(\\n\\t\\tequals(\\n\\t\\t\\tlength(body('SelectFormatSpItemsForObjectConversionArrCNST')), \\n\\t\\t\\t0\\n\\t\\t), \\n\\t\\t'{}', \\n\\t\\treplace(\\n\\t\\t\\tjoin(\\n\\t\\t\\t\\tbody('SelectFormatSpItemsForObjectConversionArrCNST'), \\n\\t\\t\\t\\t'sdofh$$gkfjbgdkfjb'\\n\\t\\t\\t), \\n\\t\\t\\t'}sdofh$$gkfjbgdkfjb{', \\n\\t\\t\\t','\\n\\t\\t)\\n\\t)\\n)}\",\n           \"PersonIdExternalToId\": \"@{json(\\n\\tif(\\n\\t\\tequals(\\n\\t\\t\\tlength(body('SelectPersonIdSpIdArrCNST')), \\n\\t\\t\\t0\\n\\t\\t), \\n\\t\\t'{}', \\n\\t\\treplace(\\n\\t\\t\\tjoin(\\n\\t\\t\\t\\tbody('SelectPersonIdSpIdArrCNST'), \\n\\t\\t\\t\\t'sdofh$$gkfjbgdkfjb'\\n\\t\\t\\t), \\n\\t\\t\\t'}sdofh$$gkfjbgdkfjb{', \\n\\t\\t\\t','\\n\\t\\t)\\n\\t)\\n)}\",\n           \"PersonIdExternals\": \"@{body('SelectPersonIdExternalSpArrCNST')}\",\n           \"HrDataPersonIdExternals\": \"@{body('SelectListOfPersonIdExternalFromApiArrCNST')}\",\n           \"HrDataListCountLessThanSharePoint\": \"@{less(\\n\\tlength(body('SelectListOfPersonIdExternalFromApiArrCNST')), \\n\\tlength(body('SelectPersonIdExternalSpArrCNST'))\\n)}\",\n           \"HrDataListContainsDupes\": \"@{less(\\n\\tlength(\\n\\t\\tunion(\\n\\t\\t\\tbody('SelectUnionToOneObjectArrCNST'), \\n\\t\\t\\tbody('SelectUnionToOneObjectArrCNST')\\n\\t\\t)\\n\\t),\\n\\tlength(\\n\\t\\tbody('SelectUnionToOneObjectArrCNST')\\n\\t)\\n)}\"\n         },\n         \"schema\": {\n           \"description\": \"This provides simple lists, some arrays converted to objects, and more.\",\n           \"properties\": {\n             \"HrDataListContainsDupes\": {\n               \"description\": \"This lists all of the items in the SharePoint List as an Object without their ID for comparison purposes.\",\n               \"title\": \"- Has Dupes In HR Data List\",\n               \"type\": \"boolean\"\n             },\n             \"NoId\": {\n               \"description\": \"This lists all of the items in the SharePoint List as an Object without their ID for comparison purposes.\",\n               \"title\": \"- Comparison Items\",\n               \"type\": \"object\"\n             },\n             \"PersonIdExternalToId\": {\n               \"description\": \"This is just an object that provides a given 'personIdExternal' its relevant SharePoint ID.\",\n               \"title\": \"- ID\",\n               \"type\": \"object\"\n             },\n             \"PersonIdExternals\": {\n               \"description\": \"This lists all of the PersonIdExternal IDs in the SharePoint List as a simple array.\",\n               \"title\": \"- Person ID Externals List\",\n               \"type\": \"array\"\n             },\n             \"HrDataPersonIdExternals\": {\n               \"description\": \"This lists all of the PersonIdExternal IDs in from the API request as a simple array.\",\n               \"title\": \"- Hr Data Person ID Externals List\",\n               \"type\": \"array\"\n             },\n             \"HrDataListCountLessThanSharePoint\": {\n               \"description\": \"This states if the API results are less than the SharePoint results (meaning that someone has left the department).\",\n               \"title\": \"- Hr Data Person ID Externals List\",\n               \"type\": \"boolean\"\n             }\n           },\n           \"title\": \"SharePoint Data Manipulations\",\n           \"type\": \"object\"\n         }\n       },\n       \"runAfter\": {\n         \"SelectFormatSpItemsForObjectConversionArrCNST\": [\n           \"Succeeded\"\n         ],\n         \"SelectPersonIdExternalSpArrCNST\": [\n           \"Succeeded\"\n         ],\n         \"SelectPersonIdSpIdArrCNST\": [\n           \"Succeeded\"\n         ],\n         \"SelectListOfPersonIdExternalFromApiArrCNST\": [\n           \"Succeeded\"\n         ]\n       }\n     }\n     ```\n   </details> \n\nAs you can see it has wrapped the expressions in curly brackets making the values a string type rather than those that they should be. \n\nThis obviously breaks the LA at runtime as the schema validation on the produced data will fail.\n\n---\n\nAgain, it's seemingly random :(, because I went nowhere near that particular action apart from to look at it (load it in the flyout on the right) but I didn't tap in any boxes.\n\nSorry to put undue pressure on this ... but it occurred on a PROD LA, too ... 😩 ... I checked the DEV version (_basically a separate Resource Group on a separate subscription ... same region_) and the changes did NOT occur on that.\n \n## Additional Context ( _very much read if/when you have time_ )\n<details><summary>I didn't catch this with my previously mentioned checks ...</summary>\n\n... because I thought it was focused on the pure input for an action.\n\nHowever, this is kind of going to be hard to catch, to be honest. \n\nLike, even if it was **_going_** to (_wrongly_) change that code to something I did not want it to be, why wouldn't it do it before now?\n\nI am trying to keep undue pressures around the whole '_PROD environment_' of it all from this issue, so I can discuss this more privately on LinkedIn if needs be, my vanity URL is `eliot.cole` over there. \n\nAdditionally, if this would help, the firm I am working at is a Microsoft Partner, so if you think some of this should *also* be raised via the admin tools, I'm happy to do that, too ... I'd just not want to eat into any support costs if it's not something that is '_user issue_' ... if you catch my drift. 👍\n</details>","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2883206699/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2890323852","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2890323852","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2890323852,"node_id":"IC_kwDOF9Gzt86sRteM","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-19T09:31:52Z","updated_at":"2025-05-19T09:32:38Z","body":"There is a new wrinkle in this ... the designer is now exclusively showing all expression based key values in a made object as a string value ... despite them actually being an object or an array, or a boolean, etc.\n\nThis is true in the version view and the designer view itself ... the following example is of a Parse JSON action in PROD.\n\nGUI AS ENTERED:\n\n![Image](https://github.com/user-attachments/assets/bdf06d12-129e-4913-a302-0993f00e442f)\n\nGUI REFRESHED:\n\n![Image](https://github.com/user-attachments/assets/ed5ab9dd-5511-47d6-9671-5ef5bac762f1)\n\nCODE VIEW:\n\n![Image](https://github.com/user-attachments/assets/1a77870a-d617-4944-a25a-b072ebb81422)\n\nThis makes it even harder to distinguish when the data has been changed wrongly. 😩 \n \nThis is really all just piling up, it's making it much harder to do actual work on this system.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2890323852/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2893682497","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2893682497","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2893682497,"node_id":"IC_kwDOF9Gzt86sehdB","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-20T09:43:47Z","updated_at":"2025-05-20T12:38:55Z","body":"This has occurred again, breaking on PROD, didn't spot it as it was an action that I'd not even opened the scope that it was in.\n\n![Image](https://github.com/user-attachments/assets/ec06eac4-7a30-4cd9-8412-6842b7ba44ac)\n\nImage shows where items that would clearly be JSON objects are going to be created as strings, this was not the only occurrence, happy to ask our client if you want access to the history, but that's their data, unfortunately.\n\nPROD actions failed as a result of this and it's getting a bit debilitating. ( _sorry, not meaning that to imply pressure, but, yeah_ )\n\nThere is also a `notcontains()` in there, too ... \n\n![Image](https://github.com/user-attachments/assets/bb353a47-94a0-49b3-b779-f11432bb0d85)\n\n**EDIT**\nHere's a separate example on a completely different tenancy of a Parse JSON action (_as were the above that aren't Filter actions, I think_) having its values changed without being touched:\n\n![Image](https://github.com/user-attachments/assets/98159be1-8e3e-40ac-b25b-2ced2e5b183c)\n\nHere's a second of basically the same LA but in a different resource group (_RG's as environments_):\n\n![Image](https://github.com/user-attachments/assets/6bb0cd02-0050-4f7f-b386-d2bb929d4d95)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2893682497/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2901972282","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2901972282","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2901972282,"node_id":"IC_kwDOF9Gzt86s-JU6","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-22T17:05:21Z","updated_at":"2025-05-22T17:05:21Z","body":"A client has just seen this occur in Power Automate in a Select action, unfortunately I don't have much more than this image to show you:\n\n![Image](https://github.com/user-attachments/assets/2db4db62-a149-4e6e-bf92-e3f304bc7f39)\n\nHowever, that `if()` expression was manipulated into a string value. They hadn't modified anything there.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2901972282/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2943588573","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2943588573","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2943588573,"node_id":"IC_kwDOF9Gzt86vc5jd","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-05T10:14:19Z","updated_at":"2025-06-05T10:14:19Z","body":"I have had another occurrence of this on a client's systems (_luckily not in PROD_) ... \n\nAnnoyingly, I HAD checked for changes that were not those which I had made myself, but I forgot to check for bad JSON or the `@notcontains()` version.\n\nI will update this message with more details as and when I can.\n\nI really hope that you won't be insulted if I start to raise this via our MS Partner portal, either ... as this is affecting actual work, and the ability to perform that properly.\n\n( _an option to be able to use the V2 designer in Logic Apps would be VERY useful, tbh ... if you wish to provide a URL for that, I'll happily take receipt of that, [here](https://github.com/influential-eliot/githubsocial/discussions)_ )","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2943588573/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2954178634","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2954178634","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2954178634,"node_id":"IC_kwDOF9Gzt86wFTBK","user":{"login":"hartra344","id":13208452,"node_id":"MDQ6VXNlcjEzMjA4NDUy","avatar_url":"https://avatars.githubusercontent.com/u/13208452?v=4","gravatar_id":"","url":"https://api.github.com/users/hartra344","html_url":"https://github.com/hartra344","followers_url":"https://api.github.com/users/hartra344/followers","following_url":"https://api.github.com/users/hartra344/following{/other_user}","gists_url":"https://api.github.com/users/hartra344/gists{/gist_id}","starred_url":"https://api.github.com/users/hartra344/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hartra344/subscriptions","organizations_url":"https://api.github.com/users/hartra344/orgs","repos_url":"https://api.github.com/users/hartra344/repos","events_url":"https://api.github.com/users/hartra344/events{/privacy}","received_events_url":"https://api.github.com/users/hartra344/received_events","type":"User","user_view_type":"public","site_admin":true},"created_at":"2025-06-08T17:02:57Z","updated_at":"2025-06-08T17:02:57Z","body":"Unfortunately the old designer is completely unusable anymore and not going to be able to come back. We have 1 small place where it's still needed that we're chasing before it's completely deleted from the codebase. Will have @Eric-B-Wu take a look though","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2954178634/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2977481031","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2977481031","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2977481031,"node_id":"IC_kwDOF9Gzt86xeMFH","user":{"login":"Eric-B-Wu","id":95886809,"node_id":"U_kgDOBbcd2Q","avatar_url":"https://avatars.githubusercontent.com/u/95886809?v=4","gravatar_id":"","url":"https://api.github.com/users/Eric-B-Wu","html_url":"https://github.com/Eric-B-Wu","followers_url":"https://api.github.com/users/Eric-B-Wu/followers","following_url":"https://api.github.com/users/Eric-B-Wu/following{/other_user}","gists_url":"https://api.github.com/users/Eric-B-Wu/gists{/gist_id}","starred_url":"https://api.github.com/users/Eric-B-Wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Eric-B-Wu/subscriptions","organizations_url":"https://api.github.com/users/Eric-B-Wu/orgs","repos_url":"https://api.github.com/users/Eric-B-Wu/repos","events_url":"https://api.github.com/users/Eric-B-Wu/events{/privacy}","received_events_url":"https://api.github.com/users/Eric-B-Wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-16T17:40:58Z","updated_at":"2025-06-16T17:40:58Z","body":"Hey @influential-eliot, last month I had created a fix for the original issue because I think we finally were able to find a repro of it:\nhttps://github.com/Azure/LogicAppsUX/pull/7210 - this has just gone into production to all regions 06/10, so hopefully you are no longer seeing the issue.\n\nI'll try to address the other issues mentioned here in this issue, but likely we'll want to open new issues so they don't get lost in conversation.\n1. Power Automate Select action - unfortunately this may be out our hands with PA split from our designer, they've implemented changes from their side, tagging @ek68794998 to see if they are aware of this issue on their end\n2. String Interpolation issue (quotes being added around tokens): This was an issue with some changes we made, I created a revert hotfix so this no longer should be happening: https://github.com/Azure/LogicAppsUX/pull/7267\n\nLet me know if you're still running into any more of these issues, we're winding down on some of our other work, so will be able to provide more immediate responses going forward\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2977481031/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2978311234","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2978311234","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2978311234,"node_id":"IC_kwDOF9Gzt86xhWxC","user":{"login":"influential-eliot","id":112952958,"node_id":"U_kgDOBruGfg","avatar_url":"https://avatars.githubusercontent.com/u/112952958?v=4","gravatar_id":"","url":"https://api.github.com/users/influential-eliot","html_url":"https://github.com/influential-eliot","followers_url":"https://api.github.com/users/influential-eliot/followers","following_url":"https://api.github.com/users/influential-eliot/following{/other_user}","gists_url":"https://api.github.com/users/influential-eliot/gists{/gist_id}","starred_url":"https://api.github.com/users/influential-eliot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/influential-eliot/subscriptions","organizations_url":"https://api.github.com/users/influential-eliot/orgs","repos_url":"https://api.github.com/users/influential-eliot/repos","events_url":"https://api.github.com/users/influential-eliot/events{/privacy}","received_events_url":"https://api.github.com/users/influential-eliot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-16T22:09:50Z","updated_at":"2025-06-16T22:09:50Z","body":"Great news, @Eric-B-Wu ... I should be ramping back up in the next week, so I will almost certainly be stress testing LAs that saw this occur repeatedly in for almost all of the problems I've raised above.\n \nGlad to see that PAuto are not lagging on this, too ... I suspect that this would kind of hit PAuto flows a lot harder, because there are less obvious ways to check as to whether something like this has happened, so it's good to know. :-)\n \nWill get on it over the next week.\n \nIn terms of getting others to show their problems in the area ... I *have* tried to have _LinkedIn'ers_ log in, here, to show their instances ... but ... heh ... you know how it is. 😏 ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2978311234/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2978725859","html_url":"https://github.com/Azure/LogicAppsUX/issues/6851#issuecomment-2978725859","issue_url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/6851","id":2978725859,"node_id":"IC_kwDOF9Gzt86xi7_j","user":{"login":"hartra344","id":13208452,"node_id":"MDQ6VXNlcjEzMjA4NDUy","avatar_url":"https://avatars.githubusercontent.com/u/13208452?v=4","gravatar_id":"","url":"https://api.github.com/users/hartra344","html_url":"https://github.com/hartra344","followers_url":"https://api.github.com/users/hartra344/followers","following_url":"https://api.github.com/users/hartra344/following{/other_user}","gists_url":"https://api.github.com/users/hartra344/gists{/gist_id}","starred_url":"https://api.github.com/users/hartra344/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/hartra344/subscriptions","organizations_url":"https://api.github.com/users/hartra344/orgs","repos_url":"https://api.github.com/users/hartra344/repos","events_url":"https://api.github.com/users/hartra344/events{/privacy}","received_events_url":"https://api.github.com/users/hartra344/received_events","type":"User","user_view_type":"public","site_admin":true},"created_at":"2025-06-17T02:29:15Z","updated_at":"2025-06-17T02:29:15Z","body":"@influential-eliot  if you see anything on linked in that you think we should see, feel free to connect with me and ping me on it. I try to keep an eye out there myself. https://www.linkedin.com/in/travis-harris/ ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/Azure/LogicAppsUX/issues/comments/2978725859/reactions","total_count":1,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]