{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "__PYTHON__ -B hooks/effect.py PostToolUse",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "__PYTHON__ -B hooks/effect.py PreToolUse",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "__PYTHON__ -B hooks/effect.py SessionStart",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "__PYTHON__ -B hooks/effect.py Stop",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
