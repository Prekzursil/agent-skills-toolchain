{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0030/probe-report.schema.json",
  "title": "WFA-0030 ProbeReport (local; declared pack is WFA-0001)",
  "description": "Discriminating contract for the acquisition-cache probe report. The catalog pointer command-center/wfa/schema/wfa-schema-pack.json#/$defs/ProbeReport is WFA-0001's job and is absent here; this local schema is the executable contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "kind",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "answer",
    "evidence",
    "tests",
    "measured",
    "reviewer",
    "artifacts",
    "transport"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0030" },
    "record_type": { "type": "string", "const": "ProbeReport" },
    "kind": { "type": "string", "const": "ProbeReport" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0030" },
    "completion_sentinel": { "type": "string", "const": "SUCCESS:WFA-0030" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "evidence": {
      "type": "object",
      "required": ["A", "B"],
      "properties": {
        "A": {
          "type": "object",
          "required": ["warm_network_calls", "reports_byte_identical"],
          "properties": {
            "warm_network_calls": { "type": "integer", "const": 0 },
            "reports_byte_identical": { "type": "boolean", "const": true }
          }
        },
        "B": {
          "type": "object",
          "required": ["empty_cache_ok", "expired_refetch"],
          "properties": {
            "empty_cache_ok": { "type": "boolean", "const": false },
            "expired_refetch": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "tests": { "type": "array", "minItems": 3 },
    "measured": {
      "type": "object",
      "required": [
        "empty_cache_ok",
        "warm_network_calls",
        "cold_network_calls",
        "reports_byte_identical",
        "expired_refetch",
        "truncated_rejected",
        "query_keys_distinct"
      ],
      "properties": {
        "empty_cache_ok": { "type": "boolean", "const": false },
        "warm_network_calls": { "type": "integer", "const": 0 },
        "cold_network_calls": { "type": "integer", "minimum": 2 },
        "reports_byte_identical": { "type": "boolean", "const": true },
        "expired_refetch": { "type": "boolean", "const": true },
        "truncated_rejected": { "type": "boolean", "const": true },
        "query_keys_distinct": { "type": "boolean", "const": true }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["independent", "reviewer_id", "verdict"],
      "properties": {
        "independent": { "type": "boolean", "const": true },
        "verdict": { "type": "string", "const": "PASS" }
      }
    },
    "artifacts": { "type": "array", "minItems": 1 },
    "transport": {
      "type": "object",
      "required": ["kind", "live_http"],
      "properties": {
        "kind": { "type": "string" },
        "live_http": { "type": "boolean", "const": false }
      }
    }
  }
}
