{
  "id": "RES-0152-sherman-kent-calibration-v1",
  "title": "Calibration of Sherman-Kent bands against independently resolved outcomes",
  "frozen_before_count": true,
  "same_rule_all_vendors": true,
  "item_unit": "One forward-looking claim whose outcome is resolved from a durable artifact that is not the claiming document.",
  "exclude_unit_ids": [
    "RES-0152"
  ],
  "window": {
    "start": "2026-07-23",
    "end": "2026-08-24",
    "days": 33,
    "kind": "catalog-authorship-through-this-worktree-measure"
  },
  "sherman_kent_bands": {
    "almost-certain": {
      "lo": 0.93,
      "hi": 0.99,
      "mid": 0.96
    },
    "highly-likely": {
      "lo": 0.8000000000000002,
      "hi": 0.9299999999999999,
      "mid": 0.865
    },
    "likely": {
      "lo": 0.55,
      "hi": 0.8,
      "mid": 0.675
    },
    "roughly-even": {
      "lo": 0.45,
      "hi": 0.55,
      "mid": 0.5
    },
    "unlikely": {
      "lo": 0.2,
      "hi": 0.45,
      "mid": 0.325
    },
    "remote": {
      "lo": 0.01,
      "hi": 0.1,
      "mid": 0.055
    }
  },
  "token_map": {
    "almost-certain": "almost-certain",
    "almost certain": "almost-certain",
    "highly-likely": "highly-likely",
    "highly likely": "highly-likely",
    "very likely": "highly-likely",
    "likely": "likely",
    "roughly-even": "roughly-even",
    "roughly even": "roughly-even",
    "even chance": "roughly-even",
    "unlikely": "unlikely",
    "remote": "remote"
  },
  "unmapped_tokens": [
    "high",
    "medium",
    "low",
    "refuse",
    "normal"
  ],
  "numeric_rule": "p in [0.55, 0.80] is likely; p in (0.80, 0.93) is highly-likely; p in [0.93, 1.00] is almost-certain. Boundary 0.80 is likely, not highly-likely.",
  "forward_looking_catalog_completion": {
    "claim_template": "Unit {id} will produce a non-blocked artifact at {output_path}.",
    "band": "unbanded",
    "register": "forward-looking",
    "note": "Catalog authorship is the claim. Disk state at output_path is the outcome. The claiming document's later verdict field is never the outcome."
  },
  "outcome_resolver": {
    "HELD": "output_path exists, non-empty, and JSON state is not BLOCKED/FAILED/SEVERED/TIMEOUT (missing state with a present file is HELD). Non-JSON present files are HELD.",
    "MISSED": "output_path exists but JSON state is BLOCKED/FAILED/SEVERED/TIMEOUT, or JSON is unparseable.",
    "UNKNOWN": "output_path absent or empty. Right-censored: not-yet-delivered is not a miss.",
    "forbidden_outcome_source": "verdict/state written by the same agent inside the claiming document"
  },
  "unknown_control": {
    "n": 5,
    "rule": "Five planted claims in planted_unknown_controls whose output_path files are absent on this worktree and must never be created.",
    "why_unknown": "Outcome is right-censored by construction. Scoring them silently biases the calibration. Cloud SUCCESS:delivered is not used as an outcome.",
    "scoring_them_is_a_fail": true
  },
