{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/CNL-0003/charter_block.schema.json",
  "title": "CNL-0003 charter block instance (compiler branch keys)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "risk_tier",
    "desired_output",
    "consensus_intent"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "Prose. Not a compiler branch key."
    },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "desired_output": {
      "type": "string",
      "enum": [
        "decision",
        "ranked_options",
        "specification",
        "review",
        "counterexample",
        "plan"
      ]
    },
    "success_criteria": {
      "type": "string",
      "description": "Prose. Optional. Not a compiler branch key."
    },
    "consensus_intent": {
      "type": "string",
      "enum": [
        "unanimous",
        "supermajority",
        "majority",
        "owner_decides",
        "dissent_required"
      ]
    }
  }
}
