{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/RES-0086/artifact.schema.json",
  "title": "RES-0086 dissent-preservation research claim record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "mechanism_table",
    "hard_gate",
    "claims",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "named_probes",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "RES-0086" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "mechanism_table": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "institution_class",
          "mechanism",
          "enforcement_classification",
          "checkable_artifact_field",
          "recommended_as_gate",
          "rails"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "institution_class": { "type": "string", "minLength": 3 },
          "mechanism": { "type": "string", "minLength": 16 },
          "enforcement_classification": {
            "type": "string",
            "enum": ["structurally-enforced", "norm-dependent"]
          },
          "checkable_artifact_field": { "type": "string", "minLength": 1 },
          "recommended_as_gate": { "type": "boolean" },
          "rails": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "permalink",
                "fetched_at",
                "http_status",
                "sha256"
              ]
            }
          }
        }
      }
    },
    "hard_gate": {
      "type": "object",
      "required": ["artifact_field", "required_item_keys", "predicate"],
      "properties": {
        "artifact_field": { "type": "string", "minLength": 3 },
        "required_item_keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "predicate": { "type": "string", "minLength": 16 }
      }
    },
    "claims": { "type": "array", "minItems": 8 },
    "tests": { "type": "array", "minItems": 2 },
    "negative_controls": { "type": "array", "minItems": 1 },
    "evidence": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "named_probes": { "type": "array", "minItems": 2 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
