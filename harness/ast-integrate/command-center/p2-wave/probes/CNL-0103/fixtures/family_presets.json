        ],
        "jaccard_threshold": 0.85,
        "canonical_match_is_duplicate": true,
        "accept_rule": "distinctness_pass AND novelty_score >= novelty_floor",
        "novelty_floor": 0.7
      },
      "editable_dials": [
        "stopping.unique_ideas_target",
        "stopping.max_rounds",
        "weighting.novelty",
        "weighting.feasibility",
        "distinctness_gate.novelty_floor"
      ],
      "default_binding": {
