{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/CNL-0103/fixtures/preset.record.schema.json",
  "title": "CNL-0103 projected generative typed-delta preset record",
  "$comment": "Unit-local. The catalog council-preset.schema.json is a receipt envelope shim and does not constrain inner preset records. Do not copy this into the shared catalog schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "relation",
    "base_spec",
    "extends_c_ids",
    "roles",
    "voting",
    "stopping",
    "protocol_schedule",
    "editable_dials",
    "non_editable_dials",
    "default_binding",
    "weighting",
    "distinctness_gate",
    "generation_critique_split"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 3 },
    "kind": { "const": "typed_delta" },
    "relation": { "type": "string", "minLength": 1 },
    "base_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "extends_c_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "obligation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "obligation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "voting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "quorum"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "quorum": { "type": "integer", "minimum": 1 }
      }
    },
    "stopping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "max_rounds"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "max_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "protocol_schedule": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "editable_dials": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_editable_dials": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "default_binding": { "type": "string", "minLength": 1 },
    "weighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["novelty", "feasibility"],
      "properties": {
        "novelty": { "type": "number", "minimum": 0, "maximum": 1 },
        "feasibility": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "distinctness_gate": {
      "type": "object",
      "required": ["accept_rule", "novelty_floor"],
      "properties": {
        "accept_rule": { "type": "string", "minLength": 1 },
        "novelty_floor": { "type": "number" },
        "signals": { "type": "array" },
        "jaccard_threshold": { "type": "number" },
        "canonical_match_is_duplicate": { "type": "boolean" }
      }
    },
    "generation_critique_split": {
      "type": "object",
      "required": ["generation_round_roles", "critique_round_roles"],
      "properties": {
        "leak_policy": { "type": "string" },
        "generation_round_roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "critique_round_roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
