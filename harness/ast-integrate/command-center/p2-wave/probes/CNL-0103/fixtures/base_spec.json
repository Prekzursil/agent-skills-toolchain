{
  "id": "councilspec.v2.generative-base",
  "version": "2.0.0",
  "kind": "CouncilSpec",
  "voting": {
    "method": "unanimous-or-record-dissent",
    "quorum": 1,
    "prune_on": "none"
  },
  "stopping": {
    "expression": "max_rounds >= 8",
    "unique_ideas_source": "post_dedup",
    "unique_ideas_target": 1,
    "allow_raw_count_stop": false,
    "feasibility_in_stop": false,
    "min_rounds": 1,
    "max_rounds": 8
  }
}
