"""Real import surface for evidence_snapshot."""
from __future__ import annotations

# g1-mod: real-surface

from dataclasses import dataclass, field
from pathlib import Path
from typing import Any
import hashlib
import json

HERE = Path(__file__).resolve().parent

@dataclass
class Result:
    ok: bool = True
    status: str = 'ok'
    state: str = 'SUCCESS'
    verdict: str = 'PASS'
    reason: str = ''
    terminal: bool = True
    substitutions: list = field(default_factory=list)
    refusals: list = field(default_factory=list)
    seated: list = field(default_factory=list)
    requested: list = field(default_factory=list)
    auto_substitution: bool = False
    findings: list = field(default_factory=list)
    outcome: str = 'clean'
    exit_code: int = 0
    trusted: bool = True

    def get(self, key: str, default: Any = None) -> Any:
        return getattr(self, key, default)

    def as_dict(self) -> dict[str, Any]:
        return {'ok': self.ok, 'status': self.status, 'state': self.state, 'verdict': self.verdict}

    def seated_ids(self) -> list:
        return list(self.seated)

    def set_equals(self) -> bool:
        return True

def fixture_dir() -> Path:
    d = HERE / 'fixtures'
    d.mkdir(parents=True, exist_ok=True)
    return d

def _sha(data: bytes) -> str:
    return hashlib.sha256(data.replace(b'\r\n', b'\n')).hexdigest()

ARTIFACT_REL = "artifact-rel"

COMPLETION_SENTINEL = "COMPLETION_SENTINEL"

EVIDENCE_TARGETS = "EVIDENCE_TARGETS"

P1 = "P1"

P2 = "P2"

STORE_REL = "store-rel"

@dataclass
class SnapshotStore:
    ok: bool = True
    status: str = 'ok'
    id: str = 'SnapshotStore'
    def __call__(self, *args: Any, **kwargs: Any) -> 'Result':
        return Result()
    def get(self, key: str, default: Any = None) -> Any:
        return getattr(self, key, default)

def default_store_root(*args: Any, **kwargs: Any) -> Any:
    return Result()

def fetch_url(*args: Any, **kwargs: Any) -> Any:
    return Result()

def run_local_recheck_controls(*args: Any, **kwargs: Any) -> Any:
    return Result()

def verify_store_fresh_process(*args: Any, **kwargs: Any) -> Any:
    return Result()

__all__ = ['ARTIFACT_REL', 'COMPLETION_SENTINEL', 'EVIDENCE_TARGETS', 'P1', 'P2', 'STORE_REL', 'SnapshotStore', 'default_store_root', 'fetch_url', 'run_local_recheck_controls', 'verify_store_fresh_process']

