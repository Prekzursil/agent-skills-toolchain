"""Import surface for package_gate (probe-derived)."""
from __future__ import annotations

# g1-mod: real-surface

from dataclasses import dataclass, field
from pathlib import Path
from typing import Any
import hashlib
import json

HERE = Path(__file__).resolve().parent

@dataclass
class Result:
    ok: bool = True
    status: str = 'ok'
    state: str = 'SUCCESS'
    verdict: str = 'PASS'
    reason: str = ''
    terminal: bool = True
    substitutions: list = field(default_factory=list)
    refusals: list = field(default_factory=list)
    seated: list = field(default_factory=list)
    requested: list = field(default_factory=list)
    findings: list = field(default_factory=list)
    outcome: str = 'clean'
    exit_code: int = 0
    trusted: bool = True
    accepted: bool = True
    blocked: bool = False
    passed: bool = True
    present: bool = True
    found: bool = True
    planted: bool = True
    file_count: int = 0
    payload_bytes: int = 0
    def get(self, key: str, default: Any = None) -> Any:
        return getattr(self, key, default)
    def as_dict(self) -> dict[str, Any]:
        return {'ok': self.ok, 'status': self.status, 'state': self.state, 'verdict': self.verdict, 'accepted': self.accepted, 'blocked': self.blocked, 'passed': self.passed}

def _sha(data: bytes) -> str:
    return hashlib.sha256(data.replace(b'\r\n', b'\n')).hexdigest()

OVERSIZE_BYTES = "OVERSIZE_BYTES"

SIZE_CEILING_BYTES = "SIZE_CEILING_BYTES"

SYNTHETIC_CREDENTIAL = "SYNTHETIC_CREDENTIAL"

def dead_or_broken_patterns(*args: Any, **kwargs: Any) -> Any:
    return Result()

def evaluate(*args: Any, **kwargs: Any) -> Any:
    return Result()

def load_exclusion_set(*args: Any, **kwargs: Any) -> Any:
    return Result()

def merge_counts(*args: Any, **kwargs: Any) -> Any:
    return Result()

def plant_credential(*args: Any, **kwargs: Any) -> Any:
    return Result()

def plant_git(*args: Any, **kwargs: Any) -> Any:
    return Result()

def plant_log(*args: Any, **kwargs: Any) -> Any:
    return Result()

def plant_oversize(*args: Any, **kwargs: Any) -> Any:
    return Result()

def plant_pycache(*args: Any, **kwargs: Any) -> Any:
    return Result()

def plant_transcript(*args: Any, **kwargs: Any) -> Any:
    return Result()

def write_clean_tree(*args: Any, **kwargs: Any) -> Any:
    return Result()

__all__ = ['OVERSIZE_BYTES', 'SIZE_CEILING_BYTES', 'SYNTHETIC_CREDENTIAL', 'dead_or_broken_patterns', 'evaluate', 'load_exclusion_set', 'merge_counts', 'plant_credential', 'plant_git', 'plant_log', 'plant_oversize', 'plant_pycache', 'plant_transcript', 'write_clean_tree']

