    "agent(\"...\")": "agent.form=string plus lossy args-as-string",
    "parallel([...])": "fanout.width = child count",
    "phase(name, fn)": "stage.name",
    "loop({convergence,max_iters}, fn)": "loop",
    "stop({expr})": "stop",
    ".filter(Boolean)": "barrier.join=filter_boolean",
