  "sentinel": "SUCCESS:ARC-0081",
  "completion_sentinel": "SUCCESS:ARC-0081",
  "phase": "4",
  "owner_approval_required": true,
  "question": "Specify the typed permission vocabulary and its evaluation semantics: the grant and deny forms, precedence when both match, wildcard expansion rules, escalation and delegation, the single location where evaluation occurs, and the machine-checkable statement of least privilege (declared permissions must be a superset of observed use and nothing more). Define what a permission means for each capability class: tool call, file path, network egress, subprocess, and credential read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "permissions"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Component, plugin, workflow, or principal the set binds to."
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission_statement"
      }
    }
  },
  "$defs": {
    "permission_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "class",
        "selector"
      ],
      "properties": {
        "effect": {
          "type": "string",
          "enum": [
            "grant",
            "deny"
          ]
        },
        "class": {
          "type": "string",
          "enum": [
            "tool",
            "path",
            "egress",
            "subprocess",
            "credential"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "effect",
              "class"
            ],
            "properties": {
              "effect": {
                "const": "grant"
              },
              "class": {
                "const": "credential"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*?]+$",
                "description": "Named credential id only. A wildcard here would grant credential read and is rejected at validation time."
              },
              "action": {
                "type": "string",
                "enum": [
                  "read"
                ]
              }
            }
          }
        }
      ]
    },
    "capability_class": {
      "type": "string",
      "enum": [
        "tool",
        "path",
        "egress",
        "subprocess",
        "credential"
      ]
    },
    "effect": {
      "type": "string",
      "enum": [
        "grant",
        "deny"
      ]
    }
  },
  "vocabulary": {
    "effects": [
      "grant",
      "deny"
    ],
    "classes": [
      "tool",
      "path",
      "egress",
      "subprocess",
      "credential"
    ],
    "actions_by_class": {
      "tool": [
        "invoke"
      ],
      "path": [
        "read",
        "write",
        "delete",
        "exec"
      ],
      "egress": [
        "connect"
      ],
      "subprocess": [
        "spawn"
      ],
      "credential": [
        "read"
      ]
    },
    "default_action_by_class": {
      "tool": "invoke",
      "path": "read",
      "egress": "connect",
      "subprocess": "spawn",
      "credential": "read"
    },
    "forms": {
      "grant": {
        "shape": {
          "effect": "grant",
          "class": "<class>",
          "action": "<optional; defaults per class>",
          "selector": "<concrete or glob except credential>"
        },
        "means": "If this statement matches a request and no deny matches, the request is GRANT."
      },
      "deny": {
        "shape": {
          "effect": "deny",
          "class": "<class>",
          "action": "<optional>",
          "selector": "<concrete or glob>"
        },
        "means": "If this statement matches a request, the request is DENY even when a grant also matches."
      }
    }
  },
  "capability_class_meanings": {
    "tool": {
      "request": "invoke a named tool (catalog examples: Read, Grep, Glob, Bash, Write, Edit).",
      "selector": "tool name or glob inside this class only",
      "does_not_imply": [
        "file path access",
        "network egress",
        "subprocess spawn",
        "credential read"
      ]
    },
    "path": {
      "request": "filesystem action (read|write|delete|exec) on a concrete POSIX path.",
      "selector": "path glob; * is one segment, ** crosses slashes",
      "does_not_imply": [
        "credential-class read of the secret VALUE",
        "tool invoke",
        "subprocess",
        "egress"
      ],
      "residual": "A path grant whose glob happens to include a secrets file is still a path grant, not a credential grant. Credential values require class=credential. A sibling deny-credential-reads control may still block secret-shaped paths; that control is not this contract."
    },
    "egress": {
      "request": "connect to host:port (or URL authority).",
      "selector": "host[:port] or glob inside this class",
      "does_not_imply": [
        "credential read",
        "tool invoke",
        "path write"
      ]
    },
    "subprocess": {
      "request": "spawn a named executable.",
      "selector": "executable path or name",
      "child_permissions": "empty unless separately granted; spawn does not inherit a superset",
      "does_not_imply": [
        "the child's network, path, or credential rights"
      ]
    },
    "credential": {
      "request": "read a named secret id (env:NAME, file:PATH, keyring:ID).",
      "selector": "must be concrete on grant; wildcards are validation errors",
      "value_handling": "Evaluation returns GRANT or DENY only. It never returns, logs, or prints the secret value. Presence of the id is enough.",
      "does_not_imply": [
        "rotation",
        "revocation",
        "printing the value"
      ]
    }
  },
  "wildcard_expansion": {
    "token_classes": [
      "tool",
      "egress",
      "subprocess",
      "credential"
    ],
    "path_class": "path",
    "rules": [
      "* on a path matches zero or more characters except / (one segment).",
      "** on a path matches across slashes.",
      "* on a token class matches any string in that class (re .*).",
      "Matching is class-scoped: a match never crosses capability class.",
      "Requests MUST be concrete; a wildcard in a request is DENY (invalid-request)."
    ],
    "forbidden": [
      "grant + class=credential + wildcard selector or action=*"
    ]
  },
  "precedence": {
    "rule": "deny-overrides, then grant, else closed-world deny",
    "when_both_match": "DENY",
    "tie_break": "effect, not specificity: any matching deny beats any matching grant",
    "default": "DENY",
    "steps": [
      "Normalize the request. Wildcard or unknown-class requests DENY as invalid-request.",
      "A statement matches iff class equal, action equal (or statement default, or non-credential *), and selector glob-matches.",
      "If any matching statement has effect=deny -> DENY reason=deny-overrides.",
      "Else if any matching statement has effect=grant -> GRANT reason=grant-match.",
      "Else DENY reason=closed-world-default."
    ]
  },
  "choke_point": {
    "id": "ARC-0081-evaluate_request",
    "module": "command-center/p2-wave/probes/ARC-0081/model.py",
    "function": "evaluate_request",
    "rule": "This function is the single location where grant vs deny is decided for every capability class. No other path may authorize a tool call, path action, egress connect, subprocess spawn, or credential read.",
    "validation_entry": "validate_permission_set",
    "load_time": "A permission set is frozen only after validate_permission_set returns no errors. Credential-read wildcards die at that gate."
  },
  "escalation_and_delegation": {
    "escalation": "S' escalates S iff there exists a concrete request r such that evaluate(S,r)=DENY and evaluate(S',r)=GRANT. Adding a grant, widening a selector, or removing a matching deny are the usual forms.",
    "delegation": "Principal A may delegate set D to B only if every grant in D is covered by A (evaluate(A, concretized grant)=GRANT for exact grants; wildcard child grants require an equal or * /** parent grant of the same class). Credential grants delegate only as the same named selector.",
    "forbidden_delegation": [
      "delegating a credential the parent does not hold by name",
      "delegating class=credential with a wildcard (already unvalidatable)"
    ]
  },
  "least_privilege": {
    "statement": "Declared grants must be a superset of observed use and nothing more: every observed request evaluates to GRANT, and every declared grant matches at least one observed request.",
    "predicate": "holds <=> unused_grants=[] and undeclared_use=[]",
    "function": "least_privilege",
    "wildcard_residual": "A wildcard grant that matched one observed request passes unused detection but still permits unobserved invocations in its expansion. Tightness of wildcards beyond 'at least one use' is NOT-CHECKED. Credential wildcards cannot appear (validation reject), so that residual does not apply to credential read."
  },
  "evaluation_semantics_source": "command-center/p2-wave/probes/ARC-0081/model.py",
