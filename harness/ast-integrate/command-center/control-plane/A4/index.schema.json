{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "a4-index/v1",
  "title": "A4 gateway capability index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "records"],
  "properties": {
    "schema": { "const": "a4-index/v1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "selector_tags",
          "summary",
          "body_rel",
          "activation_cost_processes",
          "deactivate_method",
          "leaks_after_deactivate",
          "installed"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "hook",
              "rule",
              "workflow_blueprint",
              "council_preset",
              "mcp_mount"
            ]
          },
          "selector_tags": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "summary": { "type": "string", "minLength": 8, "maxLength": 280 },
          "body_rel": { "type": "string", "minLength": 3 },
          "activation_cost_processes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "deactivate_method": { "type": "string", "minLength": 4 },
          "leaks_after_deactivate": { "type": "boolean" },
          "installed": { "type": "boolean" },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
