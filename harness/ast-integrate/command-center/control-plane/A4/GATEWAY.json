{
  "schema": "a4-gateway/v1",
  "gateway_id": "a4-gateway",
  "always_resident": [
    "INDEX.json",
    "GATEWAY.json",
    "index.schema.json"
  ],
  "selection": {
    "interface": "Gateway.select",
    "method": "tag-overlap",
    "threshold": 1,
    "activates": false
  },
  "budget": {
    "max_activated_bytes": 20000,
    "max_activated_processes": 1,
    "on_exhaustion": "REFUSE",
    "warn_is_not_enforcement": true
  },
  "lifecycle": {
    "states": [
      "indexed",
      "selected",
      "activating",
      "active",
      "deactivating",
      "indexed"
    ],
    "not_installed_is_not_not_selected": true
  }
}
