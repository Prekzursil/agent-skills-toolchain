{
  "id": "wf.catalog-class.discovery-only",
  "discovery_only": true,
  "stages": [
    {
      "id": "discover",
      "kind": "static-scan",
      "inputs": ["repo"],
      "outputs": ["candidates.json"]
    },
    {
      "id": "record",
      "kind": "write-config",
      "inputs": ["candidates.json"],
      "outputs": ["blueprint.json"]
    }
  ],
  "gates": [
    {
      "id": "human-ack",
      "when": "before-publish",
      "type": "checkpoint"
    }
  ],
  "stopping": {
    "max_stages": 2,
    "on_error": "halt"
  },
  "deactivate": "drop-compiled-stages",
  "padding": "workflow-body-not-resident-until-activate-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
}
