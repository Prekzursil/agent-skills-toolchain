 "declared_output_schema": "command-center/schema/gem-candidate.schema.json",
 "declared_output_schema_present": false,
 "local_schema": "command-center/p2-wave/probes/RES-0158/artifact.schema.json",
 "question": "Which structured analytic techniques - analysis of competing hypotheses, key assumptions check, devil's advocacy, team A/team B, premortem, ICD-203 analytic standards - are directly implementable as council protocol blueprints, and what does each require that a plain debate protocol does not?",
 "answer": "Five of the six named structured analytic techniques are directly implementable as council protocol blueprints on the IMP-0264 kernel (expressible, no extra primitive): ACH as P38, key-assumptions-check as P39, devil's advocacy as P10, team A/team B as P11, premortem as P43. Each requires an obligation P01 free-form debate does not have (matrix cells, assumption stress, mandatory attack, visibility partition, prospective-hindsight failure ledger). ICD-203 is not a protocol blueprint: it governs production and evaluation of analytic products (five analytic standards including nine tradecraft standards) and transfers only as product-evaluation gates, not as a P-id. ACH's published weakness is recorded, not pitched away: Heuer states that if the correct hypothesis is never generated the analyst will not get the correct answer; the 2009 primer lists 'Analysts seldom generate a full set' as the opening miss; Mandel, Karvetski and Dhami (2018) found ACH failed to improve accuracy versus unaided controls. A transfer that omits that critique, or that marks ICD-203 as a deliberation protocol, is illegal on this unit.",
 "plain_debate_baseline": {
  "protocol_id": "P01",
  "slug": "free-form-moderated-panel",
  "family": "DELIBERATIVE",
  "kernel_status": "expressible",
  "obligations": [
   "p01-open-nonempty"
  ]
 },
 "techniques": [
  {
   "id": "ach",
   "name": "analysis of competing hypotheses",
   "transfer_verdict": "directly-implementable",
   "protocol_id": "P38",
   "protocol_slug": "analysis-of-competing-hypotheses",
   "kernel_status": "expressible",
   "plain_debate_delta": "P01 only obliges a contribution on a shared floor. ACH requires an explicit hypothesis inventory, a hypothesis-by-evidence matrix with cell ratings (P38 obligations ['p38-open-nonempty', 'p38-close-nonempty']), diagnosticity (items consistent with every hypothesis do not discriminate), and disconfirm-not-confirm scoring.",
   "failure_mode": {
    "entrench_bad_hypothesis_set": true,
    "published_critique": true,
    "summary": "ACH evaluates a listed set. Heuer: if the correct hypothesis is never generated, the matrix cannot recover it. The 2009 primer itself lists 'Analysts seldom generate a full set' as the opening failure ACH is meant to treat; working the matrix can still make a closed, bad set look complete. Mandel, Karvetski and Dhami (2018, JDM) found ACH failed to improve accuracy versus unaided controls."
   },
   "sherman_kent_band": "likely",
