  {
   "kind": "mature-registry-lockfile-shape",
   "note": "npm package-lock records tarball integrity (SRI) plus resolved URL, not per-file hashes. poetry.lock records distribution hashes plus a content-hash of the declaration. cargo.lock records crate checksums. Those are library-version locks. A prompts/scripts package has no resolved library version, so the lock must name each file, its blob digest, the source commit, and the order files are written. Hashing a git-archive tarball would bake in export-time CRLF and fail blob identity.",
   "role": "contrast-not-copied"
  }
 ],
