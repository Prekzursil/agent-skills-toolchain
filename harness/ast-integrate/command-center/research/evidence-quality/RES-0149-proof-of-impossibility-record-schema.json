{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/research/evidence-quality/RES-0149-proof-of-impossibility-record-schema.json",
  "unit_id": "RES-0149",
  "state": "SUCCESS",
  "sentinel": "SUCCESS:RES-0149",
  "completion_sentinel": "SUCCESS:RES-0149",
  "title": "Proof-of-impossibility record: the schema that distinguishes 'cannot be obtained' from 'not found'",
  "question": "Specify and conformance-test the record that closes a research question as unanswerable: the exhausted source classes, the exact queries run with counts, the access barrier encountered, the expiry after which it must be retried, and the falsifier \u2014 what single observation would overturn it.",
  "output_schema_declared": "command-center/schema/design-spec.schema.json",
  "output_schema_on_disk": false,
  "output_schema_note": "Catalog output_schema design-spec.schema.json is absent on this tree. This artifact is a design spec envelope that carries the record JSON Schema, a live worked example, and both-states controls. It is not validated against the missing shared schema.",
  "distinction": {
    "cannot_be_obtained": "Every applicable source class was attempted; each attempt has an exact query and a result_count; an access_barrier names why further retrieval is blocked; retry_after forces a later try; a falsifier names the single observation that would overturn the close.",
    "not_found": "A search that returned zero hits, or an exhausted_sources list that is empty. That is a not-found, not an impossibility. The validator rejects it."
  },
  "source_class_vocabulary": {
    "names": [
      "official-docs",
      "source-code",
      "issue-trackers",
      "changelogs-release-notes",
      "standards",
      "papers",
      "engineering-blogs",
      "forums",
      "archival",
      "niche",
      "multilingual",
      "anecdotal",
      "video-talk-transcripts",
      "public-tor",
      "mailing-lists",
      "q-and-a"
    ],
    "provenance": "Reconstructed from catalog fragments (official-docs, code, papers, forums, archival, public-tor, changelogs, issue trackers, standards, engineering-blogs, niche, multilingual, anecdotal, video-talk-transcripts). Canonical 16-name list is _USER-PROMPTS.md:10683, which is not on this worktree."
  },
  "record_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "command-center/research/evidence-quality/RES-0149-proof-of-impossibility-record-schema.json#/record_schema",
    "title": "Proof-of-impossibility record",
    "description": "Closes a research question as unanswerable. Distinguishes 'cannot be obtained' from 'not found' by requiring a non-empty exhausted_sources list, exact queries with counts, an access barrier, a retry_after expiry, and a single-observation falsifier.",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "record_kind",
      "question",
      "program_unit_id",
      "exhausted_sources",
      "access_barrier",
      "retry_after",
      "falsifier",
      "claims"
    ],
    "properties": {
      "record_kind": {
        "type": "string",
        "const": "proof-of-impossibility"
      },
      "question": {
        "type": "string",
        "minLength": 24
      },
      "program_unit_id": {
        "type": "string",
        "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
      },
      "exhausted_sources": {
        "type": "array",
        "minItems": 1,
        "description": "Empty list is a not-found masquerading as impossible and MUST be rejected.",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "source_class",
            "queries",
            "status"
          ],
          "properties": {
            "source_class": {
              "type": "string",
              "minLength": 3
            },
            "status": {
              "type": "string",
              "enum": [
                "exhausted",
                "blocked-unattempted"
              ]
            },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "query",
                  "result_count",
                  "backend"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "backend": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hit_summary": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      },
      "access_barrier": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 4
          },
          "description": {
            "type": "string",
            "minLength": 16
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_gate": {
            "type": "string"
          }
        }
      },
      "retry_after": {
        "type": "string",
        "minLength": 20,
        "description": "ISO-8601 UTC instant after which the record must be retried."
      },
      "retry_triggers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "falsifier": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "single_observation",
          "how_it_overturns"
        ],
        "properties": {
          "single_observation": {
            "type": "string",
            "minLength": 16
          },
          "how_it_overturns": {
            "type": "string",
            "minLength": 16
          }
        }
      },
      "claims": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "text",
            "verdict",
            "sherman_kent_band",
            "lineage",
            "independent_verification_path",
            "signals"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 2
            },
            "text": {
              "type": "string",
              "minLength": 16
            },
            "verdict": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "REFUTED",
                "PARTIAL",
                "NOT-CHECKED",
                "BLOCKED"
              ]
            },
            "sherman_kent_band": {
              "type": "string",
              "enum": [
                "almost-certain",
                "likely",
                "roughly-even",
                "unlikely",
                "remote"
              ]
            },
            "lineage": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "resolved_url",
                  "fetch_timestamp",
                  "sha256_of_fetched_bytes"
                ],
                "properties": {
                  "resolved_url": {
                    "type": "string",
                    "minLength": 8
                  },
                  "fetch_timestamp": {
                    "type": "string",
                    "minLength": 20
                  },
                  "sha256_of_fetched_bytes": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "http_status": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "independent_verification_path": {
              "type": "string",
              "minLength": 8
            },
            "signals": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "mechanism",
                  "observation"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "mechanism": {
                    "type": "string",
                    "minLength": 4
                  },
                  "observation": {
                    "type": "string",
                    "minLength": 4
                  }
                }
              }
            }
          }
        }
      },
      "closed_as": {
        "type": "string",
        "enum": [
          "unanswerable",
          "cannot-be-obtained"
        ]
      },
      "notes": {
        "type": "string"
      }
    }
  },
