  "completion_sentinel": "SUCCESS:RES-0150",
  "design": {
    "honest_under_quota_path": {
      "must_not": "Must not add vacuous, restated, unsourced, or duplicate objections to reach QUOTA-MET. Filling is the failure this unit exists to prevent.",
      "verdict": "UNDER-QUOTA-HONEST",
      "when": "Search is exhausted and qualifying unfavorable count is still below required_n, including after rejecting padding."
    },
    "padding_detector": {
      "both_states": true,
      "flags": [
        "PAD-NEAR-DUP",
        "PAD-MECH-COLLAPSE",
        "PAD-VACUOUS",
        "PAD-RESTATE",
        "PAD-NO-LINEAGE",
        "PAD-POLARITY",
        "PAD-NOT-IN-CORPUS",
        "PAD-SUPPORT-CITED-AS-DISCONFIRM"
      ],
      "id": "PAD-RES-0150-dual-space",
      "procedure": "Accept genuine disconfirming items first. Each later candidate is flagged if vacuous, restating, unlined, not in corpus, citing SUPPORT as DISCONFIRM, mechanism-subset of an accepted item, or Jaccard >= 0.5 with an accepted item. Flags reject; they do not fill."
    },
    "quality_floor": [
      {
        "id": "QF-POLARITY",
        "rule": "Item polarity must be disconfirming to count toward the unfavorable quota."
      },
      {
        "id": "QF-CORPUS-DISCONFIRM",
        "rule": "Item must cite a corpus document labeled DISCONFIRM; SUPPORT cited as disconfirm is padding."
      },
      {
        "id": "QF-LINEAGE",
        "rule": "Resolved url, fetched_at, and sha256 of the fetched bytes must match the live file."
      },
      {
        "id": "QF-FALSIFIER",
        "rule": "Named falsifier at least 24 characters; hedge-only text without a mechanism is vacuous."
      },
      {
        "id": "QF-NON-RESTATE",
        "rule": "Objection text must not be a high-Jaccard restatement of the claim."
      },
      {
        "id": "QF-MECHANISM-DISTINCT",
        "rule": "Mechanism key must not collapse into an already accepted objection."
      },
      {
        "id": "QF-KENT-BAND",
        "rule": "Each counted objection carries a Sherman-Kent estimative band."
      },
      {
        "id": "QF-INDEPENDENT-PATH",
        "rule": "Each counted objection names a verification path a second agent can re-run."
      }
    ],
    "quota_definition": {
      "anti_suppression": true,
      "filling_forbidden": true,
      "formula": "required_n = max(min_n, ceil(min_share * qualifying_total)); qualifying_total includes all quality-passing polarities; padded rejects never enter the numerator",
      "honest_verdict_token": "UNDER-QUOTA-HONEST",
      "min_qualifying_unfavorable": 2,
      "min_share": 0.25,
      "name": "quality-gated-unfavorable-share-with-honest-under-quota"
    }
  },
