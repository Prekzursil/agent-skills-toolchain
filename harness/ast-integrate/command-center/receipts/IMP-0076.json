  "state": "SUCCESS",
  "sentinel": "SUCCESS:IMP-0076",
  "spec_anchor": "command-center/WORK-UNIT-CATALOG.json#IMP-0076; owner_questions Q9 (OPEN) measurement-only ratings; inputs IMP-0075 publisher identity, IMP-0094 conformance score",
  "question": "Compute a publisher trust level from measurable, auditable inputs (signed releases, conformance pass rate, advisory response time, provenance completeness) and explicitly exclude download counts, stars and ratings, per the estate's measurement-only stance on quality signals.",
  "answer": "Trust is a four-term integer millipoint average (formula tl-v1-millipoints-10000). Weights: signed_releases 30, conformance_pass_rate 30, advisory_response_time 20, provenance_completeness 20. Floor division throughout. UNRATED iff published_version_count=0. LOW < 4000 mp, MEDIUM < 7000 mp, else HIGH. DEFAULT-TRUSTED is not a level. Popularity keys are walked, listed, and discarded; they never enter scoring_input_sha256. Advisory_count=0 is N/A (excluded). Zero conformance runs on a published publisher scores 0 and stays in the average so skipping the validator cannot renormalize to HIGH. Q9 remains OPEN as an owner question; this unit implements the contracted measurement-only computational stance without closing Q9.",
  "formula": {
    "version": "tl-v1-millipoints-10000",
    "weights": {
      "signed_releases": 30,
      "conformance_pass_rate": 30,
      "advisory_response_time": 20,
      "provenance_completeness": 20
    },
    "signed": "millipoints = (ratio_mp * volume_mp) // 10000 where ratio_mp = (signed * 10000) // (signed+unsigned) and volume_mp = min(10000, (signed * 10000) // 5)",
    "conformance": "millipoints = (passes * 10000) // runs; zero runs on a publisher with published versions scores 0 (included)",
    "advisory": "if advisory_count==0: N/A excluded; else max(0, 10000 - (median_hours * 10000) // 720); null median (unanswered) scores 0",
    "provenance": "millipoints = (complete * 10000) // published_version_count",
    "aggregate": "sum(weight * millipoints for included) // sum(included weights)",
    "levels": {
      "UNRATED": "no published versions",
      "LOW": "score_millipoints < 4000",
      "MEDIUM": "4000 <= score_millipoints < 7000",
      "HIGH": "score_millipoints >= 7000"
    },
    "excluded_inputs": [
      "downloads",
      "stars",
      "ratings",
      "install_count",
      "and aliases listed in trust_levels.POPULARITY_KEYS"
    ]
  },
  "min_bytes_threshold": 128,
