{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/schema/common/identity.json",
  "title": "Canonical identity fields (shared across envelopes)",
  "type": "object",
  "$defs": {
    "artifact_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1
    }
  }
}
