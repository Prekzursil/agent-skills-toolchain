# Per-user multi-account credential store (accounts.py / AccountStore).
# It MAY hold literal secrets (env-mode account bundles).
# accounts.json is committed ENCRYPTED via git-crypt (see root .gitattributes);
# it decrypts to plaintext only after `git-crypt unlock`. So it is intentionally
# NOT ignored here. The committed accounts.example.json shows the ${ENV} shape.
accounts.json.tmp

# Python caches
__pycache__/
.pytest_cache/
