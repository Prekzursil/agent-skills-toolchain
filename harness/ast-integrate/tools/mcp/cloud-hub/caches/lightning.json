  "tools": {
    "tools": [
      {
        "name": "lightning_machine_types",
        "description": "List the Studio/Job machine (GPU) types available in the SDK.",
        "inputSchema": {
          "properties": {},
          "title": "lightning_machine_typesArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_machine_typesOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_studio_start",
        "description": "Start (or attach a machine to) a Lightning Studio. Bills by the second.",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "machine": {
              "default": "CPU",
              "title": "Machine",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "lightning_studio_startArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_studio_startOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_studio_stop",
        "description": "Stop a running Lightning Studio (releases the billed machine).",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "lightning_studio_stopArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_studio_stopOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_studio_run",
        "description": "Run a shell command inside a started Lightning Studio.",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "command": {
              "title": "Command",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            }
          },
          "required": [
            "name",
            "command"
          ],
          "title": "lightning_studio_runArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_studio_runOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_studio_switch_machine",
        "description": "Hot-swap a running Studio to a different machine (GPU) type in place.\n\nKeeps the Studio's filesystem; only the attached compute changes. Bills the\nnew machine by the second -- stop the Studio when done.\n",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "machine": {
              "title": "Machine",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            },
            "interruptible": {
              "default": false,
              "title": "Interruptible",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "machine"
          ],
          "title": "lightning_studio_switch_machineArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_studio_switch_machineOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_studio_upload_file",
        "description": "Upload a local file into a started Studio's filesystem.\n\n``remote_path`` defaults to the basename in the Studio home. The Studio must\nbe started (a machine attached) for the upload to land. The SDK progress bar\nis disabled so it cannot corrupt this server's stdio JSON-RPC stream.\n",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "file_path": {
              "title": "File Path",
              "type": "string"
            },
            "remote_path": {
              "default": "",
              "title": "Remote Path",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            }
          },
          "required": [
            "name",
            "file_path"
          ],
          "title": "lightning_studio_upload_fileArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_studio_upload_fileOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_job_submit",
        "description": "Submit an async Lightning Job on a machine. Bills while running.",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "command": {
              "title": "Command",
              "type": "string"
            },
            "machine": {
              "default": "T4",
              "title": "Machine",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            },
            "studio": {
              "default": "",
              "title": "Studio",
              "type": "string"
            }
          },
          "required": [
            "name",
            "command"
          ],
          "title": "lightning_job_submitArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_job_submitOutput",
          "type": "object"
        }
      },
