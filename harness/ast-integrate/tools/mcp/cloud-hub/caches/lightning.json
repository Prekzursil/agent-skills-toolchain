              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "lightning_job_statusOutput",
          "type": "object"
        }
      },
      {
        "name": "lightning_job_stop",
        "description": "Stop a running Lightning Job by name.",
        "inputSchema": {
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "teamspace": {
              "default": "",
              "title": "Teamspace",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "title": "lightning_job_stopArguments",
          "type": "object"
