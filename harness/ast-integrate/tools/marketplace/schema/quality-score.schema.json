{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/schema/marketplace.quality-score.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "package_id",
    "version",
    "components_bp",
    "weights_bp",
    "score_bp",
    "scale",
    "worksheet"
  ],
  "properties": {
    "package_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "score_bp": { "type": "integer" },
    "scale": { "type": "integer", "minimum": 1 },
    "components_bp": { "type": "object" },
    "weights_bp": { "type": "object" },
    "worksheet": { "type": "array" }
  }
}
