{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/marketplace/schema/benchmark-evidence.schema.json",
  "title": "Marketplace benchmark evidence reference",
  "description": "Benchmark evidence on a listing is a reference into the results ledger, never a free-text claim. Closed: no additional properties, every key pattern-constrained.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "case_set_id",
    "harness_version",
    "commit_sha"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]{2,80}$",
      "description": "results-ledger run id"
    },
    "case_set_id": {
      "type": "string",
      "pattern": "^cs-[A-Za-z0-9][A-Za-z0-9._-]{2,80}$",
      "description": "case-set id the run executed"
    },
    "harness_version": {
      "type": "string",
      "pattern": "^harness-[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "harness release that produced the run"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "commit the run measured"
    }
  }
}
