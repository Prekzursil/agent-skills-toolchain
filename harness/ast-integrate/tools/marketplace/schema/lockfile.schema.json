{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prekzursil.dev/ast-integrate/schema/lockfile.schema.json",
  "title": "Marketplace lockfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockfileVersion", "packages"],
  "properties": {
    "lockfileVersion": { "type": "integer", "minimum": 1 },
    "packages": { "type": "object" },
    "pins": { "type": "object" },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integrity": { "type": "string" }
  }
}
