{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/tools/marketplace/schema/dependency.schema.json",
  "title": "marketplace-dependency-graph",
  "type": "object",
  "required": ["packages"],
  "additionalProperties": false,
  "properties": {
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "dependencies": {
            "type": "object",
            "properties": {
              "required": { "type": "object", "additionalProperties": { "type": "string" } },
              "optional": { "type": "object", "additionalProperties": { "type": "string" } },
              "peer": { "type": "object", "additionalProperties": { "type": "string" } },
              "dev": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
