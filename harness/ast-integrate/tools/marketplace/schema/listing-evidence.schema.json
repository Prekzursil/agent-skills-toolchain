{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/marketplace/schema/listing-evidence.schema.json",
  "title": "Marketplace listing with benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "evidence"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "$ref": "benchmark-evidence.schema.json"
    }
  }
}
