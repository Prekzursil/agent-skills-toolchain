{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "councilspec.7a.envelope.json",
  "title": "CouncilSpec Phase-7A envelope",
  "description": "Closed envelope the Phase-7A acceptor takes: every section named, no unknown root keys, no deliberation state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "charter",
    "participants",
    "roles",
    "engagement",
    "budgets",
    "evidence",
    "voting",
    "stopping",
    "outcomes",
    "integrity",
    "artifacts",
    "execution",
    "meta"
  ],
  "properties": {
    "charter": {"type": "object", "required": ["question", "risk_tier"]},
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
    },
    "roles": {"type": "array", "items": {"type": "object", "required": ["id"]}},
    "engagement": {"type": "object", "required": ["mode", "rounds"], "properties": {"rounds": {"type": "integer", "minimum": 1}}},
    "budgets": {"type": "object"},
    "evidence": {"type": "object"},
    "voting": {"type": "object", "required": ["rule"]},
    "stopping": {"type": "object", "required": ["expr"]},
    "outcomes": {"type": "object"},
    "integrity": {"type": "object"},
    "artifacts": {"type": "object"},
    "execution": {
      "type": "object",
      "required": ["runtime", "deliberation_executed"],
      "properties": {"deliberation_executed": {"type": "boolean", "const": false}}
    },
    "meta": {"type": "object"}
  }
}
