{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-foundry-partial-artifact.schema.json",
  "type": "object",
  "required": ["state", "progress_pct", "claims", "checkpoint"],
  "properties": {
    "state": { "enum": ["PARTIAL", "COMPLETE"] },
    "progress_pct": { "type": "number" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string" },
          "verdict": { "enum": ["PROVEN", "UNKNOWN"] }
        }
      }
    },
    "checkpoint": { "type": "object" }
  }
}
