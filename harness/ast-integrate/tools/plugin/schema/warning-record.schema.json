{
  "$id": "https://prekzursil.dev/ast-integrate/schema/warning-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Degrade-loudly warning record (one JSONL line)",
  "description": "Written by tools/plugin/degrade_loudly.py before warn() returns. code is the join key to the IMP-0051 taxonomy; message is truncated at 2048 characters (truncated=true).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "code", "message", "pid", "seq", "level", "truncated", "context"],
  "properties": {
    "ts": {"type": "string", "minLength": 20},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string"},
    "pid": {"type": "integer"},
    "seq": {"type": "integer"},
    "level": {"type": "string", "minLength": 1},
    "truncated": {"type": "boolean"},
    "context": {"type": "object"}
  }
}
