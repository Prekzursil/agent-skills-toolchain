{
  "$id": "https://prekzursil.dev/ast-integrate/schema/secret-finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`excerpt_shape` is pattern-pinned to a length+entropy descriptor, so a finding physically cannot carry the matched secret.",
  "properties": {
    "artifact": {
      "const": "secret-finding"
    },
    "blocking": {
      "minimum": 0,
      "type": "integer"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "excerpt_shape": {
            "pattern": "^len=\\d+ entropy=\\d+\\.\\d+bits$",
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "rule": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocking",
              "advisory"
            ]
          }
        },
        "required": [
          "path",
          "rule",
          "line",
          "severity",
          "excerpt_shape"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "scanned_files": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "artifact",
    "scanned_files",
    "blocking",
    "findings"
  ],
  "title": "Credential-exposure finding (shape only, never the value)",
  "type": "object"
}
