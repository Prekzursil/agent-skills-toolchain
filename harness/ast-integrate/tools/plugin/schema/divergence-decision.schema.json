{
  "$id": "https://prekzursil.dev/ast-integrate/schema/divergence-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`chosen` is pinned to null: a packet emitted by the tool can never be mistaken for a resolution, so the owner decision cannot be forged by the tool that found the conflict.",
  "properties": {
    "artifact": {
      "const": "divergence-decision"
    },
    "auto_resolved": {
      "const": false
    },
    "decision_required": {
      "minimum": 0,
      "type": "integer"
    },
    "decisions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "chosen": {
            "type": "null"
          },
          "live_path": {
            "minLength": 1,
            "type": "string"
          },
          "live_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "items": {
              "enum": [
                "keep_live",
                "take_source",
                "merge_manually"
              ]
            },
            "minItems": 3,
            "type": "array"
          },
          "provenance_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "live_path",
          "reason",
          "options",
          "chosen"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "auto_resolved",
    "decision_required",
    "decisions"
  ],
  "title": "Diverged-file decision packet (never auto-resolved)",
  "type": "object"
}
