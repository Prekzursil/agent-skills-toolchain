{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/tools/plugin/schema/health-report.schema.json",
  "title": "health-report",
  "type": "object",
  "required": ["healthy", "aggregate", "probes"],
  "properties": {
    "healthy": { "type": "boolean" },
    "aggregate": { "type": "string", "enum": ["HEALTHY", "NOT-HEALTHY"] },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["probe_id", "state"],
        "properties": {
          "probe_id": { "type": "string" },
          "state": { "type": "string", "enum": ["SUCCESS", "FAILED", "BLOCKED"] },
          "reason": { "type": "string" },
          "evidence": { "type": "object" }
        }
      }
    },
    "blocked_ids": { "type": "array", "items": { "type": "string" } },
    "failed_ids": { "type": "array", "items": { "type": "string" } },
    "missing_unrun": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string" },
    "unit_id": { "type": "string" },
    "both_states": { "type": "array" }
  }
}
