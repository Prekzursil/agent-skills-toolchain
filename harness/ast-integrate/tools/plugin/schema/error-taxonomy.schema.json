{
  "$id": "https://prekzursil.dev/ast-integrate/schema/error-taxonomy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "minItems is pinned to the current class count, so removing a published error class is a schema violation rather than a silent contract break. `next_command` is required: a message with no next step is not a user-facing error.",
  "properties": {
    "artifact": {
      "const": "error-taxonomy"
    },
    "classes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cause": {
            "minLength": 1,
            "type": "string"
          },
          "code": {
            "pattern": "^E_[A-Z_]+$",
            "type": "string"
          },
          "exit_code": {
            "maximum": 125,
            "minimum": 0,
            "type": "integer"
          },
          "fail_mode": {
            "enum": [
              "fail-open",
              "fail-closed"
            ]
          },
          "impact": {
            "minLength": 1,
            "type": "string"
          },
          "next_command": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "exit_code",
          "title",
          "cause",
          "impact",
          "next_command",
          "fail_mode"
        ],
        "type": "object"
      },
      "minItems": 16,
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "artifact",
    "version",
    "classes"
  ],
  "title": "Stable, documented error-code taxonomy",
  "type": "object"
}
