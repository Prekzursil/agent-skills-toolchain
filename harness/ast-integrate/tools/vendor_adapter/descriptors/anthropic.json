{
  "adapter_id": "anthropic-claude-work-unit-adapter",
  "vendor": "anthropic",
  "tools": ["Read", "Write", "Edit", "Bash:python", "Task"],
  "context_window_tokens": 1000000,
  "permission_model": {
    "kind": "dispatch_enforced_tool_permissions",
    "fail_closed": true,
    "output_last_message_file": false
  },
  "streaming": {"token_stream": true, "blocking_foreground": true},
  "schema_support": {
    "json_schema": true,
    "typed_work_result": true,
    "structured_outputs": true
  },
  "prompt_transport": {"inline_allowed": true, "file_required": false},
  "leaks": [
    "prompt:inline_allowed",
    "tool:Task",
    "streaming:token_stream",
    "context_window_tokens=1000000",
    "permission_model:dispatch_enforced_tool_permissions"
  ]
}
