{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handled ledger",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "payload"],
        "properties": {
          "id": { "type": "string" },
          "payload": { "type": "object" },
          "wall_ms": { "type": "number" },
          "pid": { "type": "integer" }
        }
      }
    }
  }
}
