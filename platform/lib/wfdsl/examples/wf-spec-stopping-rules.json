{
  "dsl_version": "1.0.0",
  "id": "council.spec-stopping-rules",
  "name": "The six spec-mandated stopping expressions, verbatim",
  "description": "Every executable stopping expression the spec REQUIRES (_USER-PROMPTS.md:10937-10942), carried verbatim so a test can parse and evaluate each one. If any of these six stops parsing, the 'composable stopping rules' capability has regressed.",
  "version": "1.0.0",
  "kind": "council",
  "stopping_rules": [
    { "id": "spec-1-idea-quota", "expression": "unique_ideas >= 100 AND completeness_score >= 0.90" },
    { "id": "spec-2-consensus", "expression": "consensus >= 0.95 AND no_new_objection_rounds >= 2" },
    { "id": "spec-3-unanimity-or-cap", "expression": "unanimity == true OR max_rounds == 12" },
    { "id": "spec-4-quality-gate", "expression": "quality_gate == PASS AND unresolved_load_bearing_counterexample == 0" },
    { "id": "spec-5-saturation", "expression": "evidence_saturation == true OR time_minutes >= 180" },
    { "id": "spec-6-impossibility", "expression": "proof_of_impossibility == true" },
    {
      "id": "structured-equivalent-of-spec-1",
      "expression": {
        "all": [
          { "cmp": { "left": "unique_ideas", "op": ">=", "right": 100 } },
          { "cmp": { "left": "completeness_score", "op": ">=", "right": 0.9 } }
        ]
      }
    }
  ],
  "stages": [
    {
      "id": "deliberate",
      "kind": "council",
      "council_spec_ref": "command-center/schema/councilspec.v2.schema.json",
      "stopping_rules": [
        { "id": "spec-2-consensus", "expression": "consensus >= 0.95 AND no_new_objection_rounds >= 2" }
      ]
    }
  ]
}
