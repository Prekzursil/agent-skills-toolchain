{
 "dsl_version": "1.0.0",
 "id": "bp-req-05.intent-to-prd-with-reviewer",
 "name": "Intent-to-PRD with Testability Lint",
 "description": "Convert a CLOSED decision log into requirements whose acceptance criteria a test can later assert. The adaptation over the source skill is two mechanical checks that run BEFORE any reviewer is spent: every requirement must carry a machine-checkable acceptance criterion, and every requirement must trace to a decision-log ancestor - an orphan requirement is scope creep. A PRD over an unsettled decision log is fiction.",
 "version": "1.0.0",
 "kind": "workflow",
 "categories": [
  "product-design-and-strategy"
 ],
 "tags": [
  "prd",
  "acceptance-criteria",
  "traceability",
  "lint-before-llm"
 ],
 "flagship": true,
 "params": {
  "decision_log_path": {
   "type": "path",
   "required": true,
   "description": "The CLOSED decision log"
  },
  "definition_of_done": {
   "type": "string",
   "required": true,
   "min_length": 10,
   "description": "The owner's DoD"
  },
  "non_goals": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "default": [],
   "description": "Explicit non-goals; a requirement contradicting one is a violation"
  },
  "allow_unverifiable": {
   "type": "boolean",
   "default": false,
   "description": "When false, a requirement with testable=false blocks; the owner may accept one explicitly"
  }
 },
 "roles": {
  "author": {
   "description": "Writes requirements strictly from settled decisions, inventing nothing",
   "model": "opus",
   "vendor": "anthropic",
   "effort": "high",
   "authority": "advisory",
   "tool_permissions": [
    "Read",
    "Grep",
    "Write(command-center/prd/**)"
   ],
   "write_paths": [
    "command-center/prd/**"
   ]
  },
  "feasibility_reviewer": {
   "description": "Adversarial lens: can this be built at all, with what is actually available",
   "model": "opus",
   "vendor": "anthropic",
   "effort": "high",
   "authority": "veto",
   "independence": "independent",
   "tool_permissions": [
    "Read",
    "Grep"
   ],
   "speaking_rights": "always"
  },
  "completeness_reviewer": {
   "description": "Adversarial lens: what the DoD requires and the PRD omits",
   "model": "opus",
   "vendor": "anthropic",
   "effort": "high",
   "authority": "veto",
   "independence": "independent",
   "tool_permissions": [
    "Read",
    "Grep"
   ],
   "speaking_rights": "always"
  },
  "scope_reviewer": {
   "description": "Adversarial lens: requirements that exceed the decision log or contradict a non-goal",
   "model": "gpt-5-codex",
   "vendor": "openai",
   "effort": "high",
   "authority": "veto",
   "independence": "independent",
   "cross_vendor_required": true,
   "tool_permissions": [
    "Read",
    "Grep"
   ],
   "speaking_rights": "always"
  },
  "owner": {
   "description": "Accepts, explicitly and in writing, any requirement that cannot be verified",
   "vendor": "human",
   "authority": "owner",
   "speaking_rights": "on-request"
  }
 },
 "tool_policy": {
  "default": "deny",
  "allow": [
   "Read",
   "Grep",
   "Glob",
   "Write(command-center/prd/**)"
  ],
  "deny": [
   "Bash",
   "WebFetch"
  ],
  "network": "none",
  "require_owner_approval": [
   "Write(command-center/prd/accepted-unverifiable.json)"
  ],
  "write_paths": [
   "command-center/prd/**"
  ]
 },
 "model_routing": {
  "strategy": "vendor-diverse",
  "default": {
   "model": "opus",
   "vendor": "anthropic",
   "effort": "high"
  },
  "routes": [
   {
    "when": "stage_role == scope_reviewer",
    "target": {
     "model": "gpt-5-codex",
     "vendor": "openai",
     "effort": "high"
    },
    "reason": "the scope lens is the one most likely to share the author's frame, so it is cross-vendor"
   }
  ],
  "forbid_downgrade_below": "opus"
 },
 "gates": {
  "testability-lint": {
   "predicate": "custom-expression",
   "expression": "untestable_requirements == 0 OR allow_unverifiable == true",
   "blocking": true,
   "evidence_required": true,
   "on_fail": "fail"
  },
  "traceability-lint": {
   "predicate": "custom-expression",
   "expression": "orphan_requirements == 0",
   "blocking": true,
   "evidence_required": true,
   "on_fail": "fail"
  },
  "trio-pass": {
   "predicate": "custom-expression",
   "expression": "reviewers_passed == 3",
   "blocking": true,
   "evidence_required": true,
   "on_fail": "repair"
  }
 },
 "stages": [
  {
   "id": "s0-author",
   "title": "S0 AUTHOR requirements from the decision log",
   "kind": "task",
   "role": "author",
   "timeout_seconds": 1800,
   "checkpoint": true,
   "work_unit": {
    "id": "BP3-REQ05-S0",
    "title": "Author requirements that each cite the decision that produced them",
    "phase": "2B",
    "question_or_target": "Turn each settled decision into one or more requirements, each with an acceptance criterion and a decision id.",
    "inputs": [
     "params.decision_log_path",
     "params.definition_of_done",
     "params.non_goals"
    ],
    "dependencies": [],
    "assigned_model_vendor_role": {
     "model": "opus",
     "vendor": "anthropic",
     "role": "author",
     "basis": "substantive subagents default to Opus"
    },
    "tool_permissions": [
     "Read",
     "Grep",
     "Write(command-center/prd/**)"
    ],
    "execution_substrate": "local-single",
    "timeout_seconds": 1800,
    "output_path": "command-center/prd/req05-requirements.json",
    "output_schema": "command-center/schema/requirement-record.schema.json",
    "evidence_requirement": "every requirement carries the decision-log id it descends from and a criterion with a comparator and a quantity",
    "tests_required": [
     "a requirement phrased 'should feel fast' must be emitted with testable=false so the lint can reject it",
     "a requirement with no decision id must be emitted so the traceability lint can flag it"
    ],
    "reviewer_requirement": "the adversarial trio, after the mechanical lints pass",
    "completion_sentinel": "SUCCESS:BP3-REQ05-S0 only when every requirement carries an acceptance criterion field, even when testable=false; otherwise FAILED:BP3-REQ05-S0 <reason>",
    "retry_policy": "two strikes then pivot; a third authoring pass on the same frame is banned",
    "failure_classification": [
     "spec-underspecified",
     "scope-creep"
    ],
    "owner_approval_required": false
   },
   "produces": [
    {
     "path": "command-center/prd/req05-requirements.json",
     "schema_ref": "command-center/schema/requirement-record.schema.json",
     "min_bytes": 512,
     "register_in_manifest": true,
     "sentinel": "SUCCESS:BP3-REQ05-S0",
     "consumers": [
      "s1-lint",
      "s1b-trace",
      "s2-review"
     ]
    }
   ]
  },
  {
   "id": "s1-lint",
   "title": "S1 LINT: every acceptance criterion must be machine-checkable",
   "kind": "gate",
   "depends_on": [
    "s0-author"
   ],
   "gate_ref": "testability-lint"
  },
  {
   "id": "s1b-trace",
   "title": "S1b TRACE every requirement to a decision-log ancestor",
   "kind": "gate",
   "depends_on": [
    "s1-lint"
   ],
   "gate_ref": "traceability-lint"
  },
  {
   "id": "s2-review",
   "title": "S2 REVIEW adversarially - three independent lenses in parallel",
   "kind": "fanout",
   "depends_on": [
    "s1b-trace"
   ],
   "over": {
    "source": "literal",
    "items": [
     "feasibility",
     "completeness",
     "scope"
    ],
    "item_var": "lens",
    "key_field": "lens"
   },
   "max_concurrency": 3,
   "arrival_stagger_ms": 250,
   "on_item_failure": "continue",
   "body": [
    {
     "id": "review-lens",
     "kind": "task",
     "role": "feasibility_reviewer",
     "timeout_seconds": 1800,
     "work_unit": {
      "id": "BP3-REQ05-S2",
      "title": "Review the PRD through exactly one named lens",
      "phase": "2B",
      "question_or_target": "Return a typed PASS or FAIL for one lens, with every blocking item anchored to a requirement id.",
      "inputs": [
       "command-center/prd/req05-requirements.json"
      ],
      "dependencies": [
       "BP3-REQ05-S0"
      ],
      "assigned_model_vendor_role": {
       "model": "opus",
       "vendor": "anthropic",
       "role": "feasibility_reviewer",
       "basis": "one lens per agent so a single reviewer cannot average two verdicts together"
      },
      "tool_permissions": [
       "Read",
       "Grep"
      ],
      "execution_substrate": "local-parallel",
      "timeout_seconds": 1800,
      "output_path": "command-center/prd/req05-review.json",
      "output_schema": "command-center/schema/meta-review-finding.schema.json",
      "evidence_requirement": "each blocking item names the requirement id and the reason it cannot pass",
      "tests_required": [
       "a reviewer returning prose instead of a typed verdict is retried once with the vocabulary enumerated inline, then treated as a null lens"
      ],
      "reviewer_requirement": "the aggregator, which counts lenses rather than averaging opinions",
      "completion_sentinel": "SUCCESS:BP3-REQ05-S2 only when the artifact carries a recognised verdict token and every blocking item names a requirement id; otherwise FAILED:BP3-REQ05-S2 <reason>",
      "retry_policy": "one retry with the verdict vocabulary enumerated inline, then null lens",
      "failure_classification": [
       "schema-invalid",
       "null-lens"
      ],
      "owner_approval_required": false
     }
    }
   ],
   "barrier": {
    "mode": "all",
    "on_partial": "proceed-with-quarantine",
    "reject_result_matching": [
     "started in the background",
     "Check /codex:status"
    ],
    "verify_artifact_exists": true
   }
  },
  {
   "id": "s2-gate",
   "title": "S2 gate: all three lenses must PASS",
   "kind": "gate",
   "depends_on": [
    "s2-review"
   ],
   "gate_ref": "trio-pass"
  },
  {
   "id": "s3-revise",
   "title": "S3 REVISE against the blocking items, then re-lint",
   "kind": "loop",
   "depends_on": [
    "s2-gate"
   ],
   "loop_var": "revision",
   "body": [
    {
     "id": "apply-revision",
     "kind": "task",
     "role": "author",
     "timeout_seconds": 1800,
     "work_unit": {
      "id": "BP3-REQ05-S3",
      "title": "Rewrite only the blocked requirements",
      "phase": "2B",
      "question_or_target": "Rewrite each blocked requirement so its criterion is machine-checkable, or escalate it for explicit owner acceptance.",
      "inputs": [
       "command-center/prd/req05-review.json"
      ],
      "dependencies": [
       "BP3-REQ05-S2"
      ],
      "assigned_model_vendor_role": {
       "model": "opus",
       "vendor": "anthropic",
       "role": "author",
       "basis": "the author owns the revision; reviewers do not rewrite"
      },
      "tool_permissions": [
       "Read",
       "Write(command-center/prd/**)"
      ],
      "execution_substrate": "local-single",
      "timeout_seconds": 1800,
      "output_path": "command-center/prd/req05-requirements.json",
      "output_schema": "command-center/schema/requirement-record.schema.json",
      "evidence_requirement": "each revised requirement links the blocking item it answers",
      "tests_required": [
       "a revision that silently drops a blocked requirement rather than fixing it must be caught by the closure count"
      ],
      "reviewer_requirement": "the same three lenses, re-run on the revised document",
      "completion_sentinel": "SUCCESS:BP3-REQ05-S3 only when the revised requirement count is not lower than the original minus explicitly withdrawn items; otherwise FAILED:BP3-REQ05-S3 <reason>",
      "retry_policy": "bounded by the loop convergence, never by an inner retry",
      "failure_classification": [
       "overclaim",
       "scope-creep"
      ],
      "owner_approval_required": false
     }
    }
   ],
   "convergence": {
    "max_iterations": 3,
    "min_iterations": 1,
    "converged_when": "blocking_items == 0 AND untestable_requirements == 0",
    "no_progress_rounds": 2,
    "metrics": [
     {
      "name": "blocking_items",
      "direction": "decrease",
      "target": 0
     },
     {
      "name": "untestable_requirements",
      "direction": "decrease",
      "target": 0
     }
    ],
    "on_no_convergence": "escalate"
   }
  },
  {
   "id": "s3b-owner-accept",
   "title": "S3b OWNER accepts any requirement that stays unverifiable",
   "kind": "human_checkpoint",
   "depends_on": [
    "s3-revise"
   ],
   "when": "untestable_requirements > 0",
   "prompt": "One or more requirements cannot be expressed as a machine-checkable criterion. Accept them as explicitly unverifiable, or send them back for rewriting.",
   "approvers": [
    "owner"
   ],
   "approval_mode": "owner-only",
   "timeout_seconds": 86400,
   "on_timeout": "fail",
   "owner_approval_required": true,
   "options": [
    "accept-as-unverifiable",
    "return-for-rewrite"
   ],
   "decision_artifact": {
    "path": "command-center/prd/accepted-unverifiable.json",
    "schema_ref": "command-center/schema/owner-decision-packet.schema.json",
    "min_bytes": 128,
    "register_in_manifest": true
   }
  }
 ],
 "stopping_rules": [
  {
   "id": "prd-closed",
   "expression": "untestable_requirements == 0 AND orphan_requirements == 0 AND reviewers_passed == 3",
   "applies_to": "workflow",
   "minimum_conditions": "requirements_count >= 1",
   "on_stop": "complete"
  },
  {
   "id": "decision-log-open",
   "expression": "decision_log_closed == false",
   "applies_to": "workflow",
   "on_stop": "escalate"
  }
 ],
 "retry_policy": {
  "strategy": "two-strikes-then-pivot",
  "max_attempts": 3,
  "backoff_seconds": 15,
  "jitter": true,
  "retry_on": [
   "schema-invalid",
   "null-lens"
  ],
  "no_retry_on": [
   "owner-blocked",
   "spec-underspecified"
  ],
  "pivot": {
   "after_attempts": 2,
   "enumerate_alternatives_min": 2,
   "escalate_to": "s3b-owner-accept"
  }
 },
 "failure_policy": {
  "on_failure": "escalate-to-human",
  "classify_as": [
   "spec-underspecified",
   "scope-creep",
   "null-lens"
  ],
  "terminal_state_required": true,
  "never_silent": true,
  "preserve_partial_artifact": true,
  "escalate_to": "s3b-owner-accept",
  "quarantine_path": "command-center/quarantine/req05"
 },
 "resume": {
  "enabled": true,
  "checkpoint_store": "command-center/checkpoints/req05",
  "granularity": "stage",
  "idempotency_key_from": [
   "workflow_id",
   "workflow_version",
   "stage_id",
   "inputs_hash"
  ],
  "resume_from": "last-checkpoint",
  "stale_checkpoint_seconds": 86400,
  "on_stale": "warn-and-resume"
 },
 "replay": {
  "deterministic": true,
  "seed": 20260810,
  "journal_path": "command-center/replay/req05.jsonl",
  "record": [
   "params",
   "inputs",
   "model_outputs"
  ],
  "forbid_nondeterministic_sources": [
   "clock",
   "random",
   "filesystem-order",
   "process-id"
  ],
  "replay_source": "recorded-journal",
  "verify": "schema-equal",
  "hash_algorithm": "sha256",
  "on_divergence": "record-discrepancy"
 },
 "cache": {
  "enabled": true,
  "scope": "workflow",
  "key_from": [
   "workflow_version",
   "stage_id",
   "inputs_hash"
  ],
  "store": "command-center/cache/req05",
  "ttl_seconds": 604800,
  "verify_integrity": true,
  "invalidate_on": [
   "schema-version-change",
   "tool-version-change"
  ],
  "read_only": false
 },
 "dry_run": {
  "supported": true,
  "side_effect_free": true,
  "emits": [
   "plan",
   "estimate",
   "artifact-diff"
  ],
  "plan_artifact": "command-center/dry-run/req05-plan.json",
  "forbid_tools": [
   "Write(command-center/prd/**)"
  ]
 },
 "estimate": {
  "basis": "static-declared",
  "wallclock_seconds": {
   "min": 600,
   "expected": 2400,
   "max": 7200
  },
  "tokens": {
   "min": 60000,
   "expected": 250000,
   "max": 700000
  },
  "tool_calls": {
   "expected": 30,
   "max": 220
  },
  "impact": {
   "risk": "low",
   "reversibility": "reversible",
   "blast_radius": "writes only under command-center/prd/**; produces a document, changes no code",
   "requires_owner_approval": false
  }
 },
 "portability": {
  "export": {
   "format": "bundle",
   "includes": [
    "definition",
    "examples",
    "tests",
    "lineage"
   ],
   "redact_secrets": true,
   "bundle_path": "command-center/export/bp-req-05.bundle.json"
  },
  "import": {
   "validate_against": "platform/schema/workflow-dsl.schema.json",
   "on_version_mismatch": "reject",
   "trust": {
    "require_signature": false,
    "allow_publishers": [
     "prekzursil"
    ]
   }
  }
 },
 "lineage": {
  "derived_from": [
   {
    "source": "skills/to-prd",
    "relation": "EXTEND",
    "license": "owner-proprietary",
    "credit": "owner / program design corpus"
   },
   {
    "source": "workflows/plan-gate.mjs",
    "relation": "DISTILL",
    "license": "owner-proprietary",
    "credit": "owner / program design corpus"
   },
   {
    "source": "metaswarm/plan-review-gate",
    "relation": "COMPOSE",
    "license": "owner-proprietary",
    "credit": "owner / program design corpus"
   },
   {
    "source": "09-WORKFLOW-BLUEPRINT-LIBRARY.md#BP-REQ-05",
    "relation": "REBUILD-FROM-SPEC",
    "license": "owner-proprietary",
    "credit": "owner / program design corpus"
   }
  ],
  "decomposable_back_to_sources": true
 },
 "outputs": {
  "prd": {
   "path": "command-center/prd/req05-requirements.json",
   "schema_ref": "command-center/schema/requirement-record.schema.json",
   "min_bytes": 512,
   "register_in_manifest": true,
   "consumers": [
    "bp-pln-01.mechanical-plan-lint-then-adversarial-trio",
    "the test phase"
   ]
  },
  "closure": {
   "path": "command-center/prd/req05-closure.json",
   "schema_ref": "command-center/schema/requirement-closure.schema.json",
   "min_bytes": 192,
   "register_in_manifest": true,
   "consumers": [
    "the implementation phase"
   ]
  },
  "traceability": {
   "path": "command-center/prd/req05-traceability.json",
   "schema_ref": "command-center/schema/traceability-matrix.schema.json",
   "min_bytes": 192,
   "register_in_manifest": true,
   "consumers": [
    "the owner",
    "bp-pln-01.mechanical-plan-lint-then-adversarial-trio"
   ]
  }
 },
 "x_extensions": {
  "design_card": "09-WORKFLOW-BLUEPRINT-LIBRARY.md#BP-REQ-05 (doc-order 27 of 96)",
  "distinguishing_mechanism": "two MECHANICAL lints (criterion testability, decision-log ancestry) gate the reviewers, so no adversarial budget is spent on a document a script can reject. BP-PLN-01 applies the same ordering to a PLAN (the HOW); this applies it to REQUIREMENTS (the WHAT).",
  "worked_example": {
   "name": "should-feel-fast and an orphan requirement",
   "narrative": "Four requirements are authored. 'The export should feel fast' has no comparator and no quantity, so the testability lint rejects it. 'Add a dark theme' traces to no decision id, so the traceability lint flags it as scope creep. The two well-formed requirements pass both lints.",
   "mechanism": "mechanisms.is_testable + mechanisms.orphan_requirements",
   "input": {
    "criteria": {
     "R1": "p95 export latency <= 2000 ms measured over 100 runs",
     "R2": "The export should feel fast",
     "R3": "exactly 0 rows are dropped when the source file is truncated",
     "R4": "the UI is clean and modern"
    },
    "ancestors": {
     "R1": "D-004",
     "R2": "D-004",
     "R3": "D-007",
     "R4": null
    },
    "decision_ids": [
     "D-004",
     "D-007"
    ]
   },
   "expected": {
    "testable": {
     "R1": true,
     "R2": false,
     "R3": true,
     "R4": false
    },
    "orphans": [
     "R4"
    ]
   },
   "controls": [
    {
     "mutate": "rewrite R2 as 'p95 export latency <= 2000 ms'",
     "expected_testable": true,
     "why": "a comparator plus a quantity is exactly what makes it assertable"
    }
   ]
  }
 }
}
