  "preset": "architecture_review_board",
  "participation": "hybrid",
  "objective": {
    "statement": "Decide a load-bearing architecture question by splitting it across three independent subcouncils and having a meta council reduce their returns.",
    "charter": "Council of councils for architecture. The meta council may overrule a subcouncil ONLY on a PROCESS defect (it did not run its protocol, or it voted without evidence) - never because it dislikes the conclusion. A subcouncil that cannot reach a verdict returns DISARMED, which counts as complete.",
    "risk_tier": "high",
    "desired_output": "decision",
    "success_criteria": [
      "all three subcouncils returned a verdict or an explicit DISARMED",
      "at least three meta rounds ran",
      "any meta overrule of a subcouncil cites a PROCESS defect, not a preference"
    ],
    "consensus_intent": "seek_consensus",
    "confidence_target": 0.85,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 3,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": true,
      "deadline_minutes": 180,
      "budget_ceiling_tokens": 800000
    }
  },
