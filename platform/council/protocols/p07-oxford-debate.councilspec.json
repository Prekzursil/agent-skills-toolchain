{
  "schema_version": "1.0.0",
  "council_id": "p07-oxford-debate",
  "participation": "agent_only",
  "objective": {
    "statement": "Resolve a binary motion by hearing the strongest case for each side and measuring how much the panel MOVED, not what it believed beforehand.",
    "charter": "Oxford / parliamentary debate. Motion stated; proposition opening, opposition opening, cross-examination x2, rebuttals, closings in reverse order; audience seats vote before and after and the DELTA is the signal.",
    "risk_tier": "high",
    "desired_output": "go_no_go",
    "success_criteria": [
      "both sides filed an opening before any cross-examination",
      "the pre-vote and post-vote were both recorded and the delta computed",
      "no claim carried into the closing without an evidence anchor"
    ],
    "consensus_intent": "adjudicate",
    "confidence_target": 0.8,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 3,
      "evidence_outranks_votes": true
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "adversarial"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 8,
      "min": 8,
      "max": 8
    },
    "diversity": {
      "min_distinct_vendors": 3,
      "min_distinct_expertise": 5
    },
    "roster": [
      {
        "participant_id": "speaker-chair",
        "display_name": "Speaker (procedural chair, non-voting)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "debate procedure"
        ],
        "role": "moderator",
        "authority": "chair",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "prop-lead",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "the motion under debate"
        ],
        "role": "proposer",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "prop-second",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "implementation feasibility"
        ],
        "role": "proposer",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "opp-lead",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "falsification"
        ],
        "role": "critic",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "opp-second",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "operational risk"
        ],
        "role": "critic",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "audience-1",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "program strategy"
        ],
        "role": "juror",
        "authority": "voter",
        "vote_weight": 1.0,
        "independence": {
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "audience-2",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "cost and schedule"
        ],
        "role": "juror",
        "authority": "voter",
        "vote_weight": 1.0,
        "independence": {
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "evidence-clerk",
        "display_name": "Evidence clerk (anchors every claim)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "evidence grading",
          "citation checking"
        ],
        "role": "verifier",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      }
    ],
    "replacement": {
      "enabled": true,
      "triggers": [
        "role_collapse",
        "policy_violation"
      ],
      "preserve_prior_positions": true
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "recuse_from_vote"
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 3,
    "required_artifacts": [
      "evidence_pack",
      "position_memo"
    ]
  },
  "topology": {
    "kind": "caucus",
    "caucuses": [
      {
        "caucus_id": "proposition",
        "members": [
          "prop-lead",
          "prop-second"
        ],
        "private_rounds": 1
      },
      {
        "caucus_id": "opposition",
        "members": [
          "opp-lead",
          "opp-second"
        ],
        "private_rounds": 1
      }
    ]
  },
  "protocol": {
    "sequence": [
      {
        "kind": "custom",
        "stage_id": "pre-vote",
        "custom_name": "audience_pre_vote",
        "participants": [
          "audience-1",
          "audience-2"
        ],
        "anonymous": true,
        "independent": true
      },
      {
        "kind": "oxford",
        "stage_id": "openings",
        "rounds": 1
      },
      {
        "kind": "cross_examination",
        "stage_id": "xexam",
        "rounds": 2,
        "quotas": {
          "objections_per_participant": 2,
          "counterexamples_per_round": 1
        }
      },
      {
        "kind": "steelman_before_rebuttal",
        "stage_id": "rebuttals",
        "rounds": 1,
        "quotas": {
          "counterexamples_per_round": 1
        }
      },
      {
        "kind": "custom",
        "stage_id": "closings",
        "custom_name": "closings_in_reverse_order"
      },
      {
        "kind": "custom",
        "stage_id": "post-vote",
        "custom_name": "audience_post_vote",
        "participants": [
          "audience-1",
          "audience-2"
        ],
        "anonymous": true,
        "independent": true
      }
    ],
    "speaking_order": "chair_directed",
    "rounds": {
      "min": 3,
      "max": 6,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 700
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "steelman_before_rebuttal": true,
      "cross_examination": true,
      "rebuttal_required": true,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "maximally_adversarial",
    "experiments": {
      "allowed": true,
      "max_experiments": 2,
      "runner": "ci"
    }
  },
  "budgets": {
    "effort": "xhigh",
    "time_minutes": 150,
    "tool_calls": 200,
    "sources": 30,
    "turns": 40,
    "max_inactivity_rounds": 1,
    "rebuttal_depth": 3
  },
  "targets": {
    "unique_ideas": 10,
    "novelty_ratio": 0.4,
    "objections": 10,
    "counterexamples": 4,
    "evidence_items": 24,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.82,
      "trivial_variant_policy": "reject"
    }
  },
  "voting": {
    "method": "majority",
    "quorum": {
      "min_voters": 2,
      "on_failure": "recruit"
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true,
      "strategic_abstention_check": true
    },
    "belief_aggregation": {
      "method": "linear_pool",
      "require_confidence_per_vote": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "no_decision"
  },
  "consensus": {
    "threshold": 0.8,
    "measure": "vote_share",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true,
      "min_dissenters_to_block": 1
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "expression": {
      "all_of": [
        {
          "metric": "custom:pre_post_vote_delta_recorded",
          "op": "==",
          "value": true,
          "value_type": "boolean",
          "producer": "speaker-chair pre-vote and post-vote stages"
        },
        {
          "metric": "custom:unsupported_claims_open",
          "op": "==",
          "value": 0,
          "value_type": "number",
          "producer": "evidence-clerk claim ledger"
        },
        {
          "metric": "every_objection_addressed",
          "op": "==",
          "value": true
        },
        {
          "metric": "rounds_elapsed",
          "op": ">=",
          "value": 3
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 4,
      "every_participant_spoke": true,
      "min_evidence_items": 16,
      "min_objections_addressed": 6
    },
    "hard_caps": {
      "max_rounds": 6,
      "max_minutes": 150,
      "on_cap": "no_decision"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "irreducible_disagreement",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "the strongest surviving counterexample is re-tested after the motion is enacted"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.9,
      "vote_oscillation_rounds": 2
    },
    "resolution": [
      "run_experiment",
      "strongest_counterexample",
      "narrow_scope",
      "judge_ruling",
      "declare_no_decision"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "judge"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": false,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "evidence_free_majority",
      "strategic_voting",
      "circular_debate",
      "role_collapse",
      "premature_convergence"
    ],
    "fast_unanimity_response": [
      "blind_re_evaluation",
      "strongest_counterexample",
      "recruit_independent_critic"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "transcript",
      "argument_graph",
      "claim_evidence_contradiction_graph",
      "evidence_map",
      "votes_by_round",
      "confidence_trajectory",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "calibration_report",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "P07 oxford debate",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:206",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:219"
    ],
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#P07"
    ],
    "notes": "ADVERSARIAL. The pre/post vote delta is unique to this protocol - it measures persuasion, not prior. Debaters do not vote (rights.may_vote=false); only the audience jurors do, twice. The card's mitigation for a rhetorical win on a wrong side (pair with an evidence clerk) is a seat plus a stopping conjunct.\n\nanti-failure controls, each mapped to the field implementing it:\n  evidence_free_majority -> an evidence clerk seat scores every claim and voting.evidence_gate.reject_evidence_free_majority is on; the card's failure mode is a rhetorical win on a factually wrong side, so a persuasion delta alone cannot close the council - custom:unsupported_claims_open == 0 is a stopping conjunct\n  strategic_voting -> audience seats vote BEFORE and AFTER (custom stages audience_pre_vote / audience_post_vote) and the signal is the delta, not the tally; voting.abstention.strategic_abstention_check is on\n  circular_debate -> deadlock.detection.repetition_similarity 0.9 with no_progress_rounds 2, and budgets.rebuttal_depth caps rebuttal recursion at 3\n  role_collapse -> proposition and opposition are caucuses with assigned sides; a side that stops arguing its brief trips participants.replacement.triggers=role_collapse\n  premature_convergence -> stopping.minimum_deliberation.min_rounds=3 covers opening, cross-exam and closing before any close"
  }
}
