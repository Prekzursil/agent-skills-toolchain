{
  "schema_version": "1.0.0",
  "council_id": "p04-consensus-conference",
  "participation": "hybrid",
  "objective": {
    "statement": "Produce a verdict that carries buy-in across incompatible interests by giving question-ownership to a lay panel and answer-ownership to experts.",
    "charter": "Danish consensus-conference model. Phase 1 lay panel frames the questions; phase 2 experts answer only those questions; phase 3 the lay panel drafts the verdict and experts may correct facts but not conclusions.",
    "risk_tier": "moderate",
    "desired_output": "decision",
    "success_criteria": [
      "the frozen question set hash is unchanged at synthesis",
      "no expert seat saw a question before the freeze",
      "every lay verdict clause cites the expert answer it rests on"
    ],
    "consensus_intent": "seek_consensus",
    "confidence_target": 0.8,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "any",
      "min_independent_sources": 3,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": true,
      "deadline_minutes": 180
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "stakeholder_balanced"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 7,
      "min": 7,
      "max": 7
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 5
    },
    "roster": [
      {
        "participant_id": "lay-chair",
        "display_name": "Lay panel chair",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "owner intent",
          "plain-language framing"
        ],
        "role": "chair",
        "authority": "chair",
        "vote_weight": 1.0
      },
      {
        "participant_id": "lay-user-advocate",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "day-to-day workflows"
        ],
        "role": "user_advocate",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "lay-owner",
        "kind": "human",
        "vendor": "human",
        "expertise": [
          "owner priorities"
        ],
        "role": "stakeholder",
        "authority": "owner",
        "vote_weight": 1.0,
        "rights": {
          "may_speak": true,
          "may_vote": true
        }
      },
      {
        "participant_id": "expert-architecture",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "system architecture"
        ],
        "role": "domain_expert",
        "authority": "contributor",
        "vote_weight": 0,
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "context": {
          "partition_id": "frozen-questions"
        }
      },
      {
        "participant_id": "expert-security",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "threat modeling"
        ],
        "role": "security_reviewer",
        "authority": "contributor",
        "vote_weight": 0,
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "context": {
          "partition_id": "frozen-questions"
        }
      },
      {
        "participant_id": "expert-legal",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "licensing",
          "compliance"
        ],
        "role": "legal_ethics",
        "authority": "contributor",
        "vote_weight": 0,
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "context": {
          "partition_id": "frozen-questions"
        }
      },
      {
        "participant_id": "freeze-clerk",
        "display_name": "Freeze clerk (hashes the question set)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "record keeping",
          "hashing"
        ],
        "role": "scribe",
        "authority": "contributor",
        "vote_weight": 0,
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      }
    ],
    "information_partition": {
      "enabled": true,
      "strategy": "staged_release",
      "partitions": [
        {
          "partition_id": "frozen-questions",
          "visible_to": [
            "expert-architecture",
            "expert-security",
            "expert-legal"
          ],
          "sources": [
            "question-set.frozen.json"
          ]
        }
      ]
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "recuse_from_vote"
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 3,
    "prep_time_minutes": 30,
    "required_artifacts": [
      "evidence_pack",
      "position_memo"
    ]
  },
  "topology": {
    "kind": "committee",
    "committees": [
      {
        "committee_id": "lay-panel",
        "mandate": "owns the questions and owns the final verdict",
        "members": [
          "lay-chair",
          "lay-user-advocate",
          "lay-owner"
        ]
      },
      {
        "committee_id": "expert-panel",
        "mandate": "answers only the frozen questions; may correct facts, not conclusions",
        "members": [
          "expert-architecture",
          "expert-security",
          "expert-legal"
        ]
      }
    ]
  },
  "protocol": {
    "sequence": [
      {
        "kind": "nominal_group",
        "stage_id": "frame-questions",
        "participants": [
          "lay-chair",
          "lay-user-advocate",
          "lay-owner"
        ],
        "independent": true,
        "quotas": {
          "ideas_per_participant": 5,
          "novel_ideas_per_round": 2
        }
      },
      {
        "kind": "custom",
        "stage_id": "freeze",
        "custom_name": "question_set_freeze_hash",
        "participants": [
          "freeze-clerk"
        ]
      },
      {
        "kind": "socratic",
        "stage_id": "expert-answers",
        "rounds": 2,
        "participants": [
          "expert-architecture",
          "expert-security",
          "expert-legal"
        ],
        "quotas": {
          "objections_per_participant": 2
        }
      },
      {
        "kind": "custom",
        "stage_id": "fact-correction",
        "custom_name": "experts_may_correct_facts_only",
        "rounds": 1
      },
      {
        "kind": "synthesis",
        "stage_id": "lay-verdict",
        "participants": [
          "lay-chair",
          "lay-user-advocate",
          "lay-owner"
        ]
      }
    ],
    "speaking_order": "chair_directed",
    "rounds": {
      "min": 3,
      "max": 7,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 600
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "cross_examination": true,
      "rebuttal_required": false,
      "steelman_before_rebuttal": false,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "standard"
  },
  "budgets": {
    "effort": "high",
    "time_minutes": 180,
    "tool_calls": 180,
    "sources": 30,
    "turns": 40,
    "max_inactivity_rounds": 2,
    "rebuttal_depth": 2
  },
  "targets": {
    "unique_ideas": 24,
    "categories": 5,
    "novelty_ratio": 0.5,
    "coverage_score": 0.85,
    "objections": 6,
    "evidence_items": 18,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.82,
      "trivial_variant_policy": "reject"
    }
  },
  "voting": {
    "method": "weighted",
    "weights": {
      "lay-chair": 1.0,
      "lay-user-advocate": 1.0,
      "lay-owner": 1.0,
      "expert-architecture": 0,
      "expert-security": 0,
      "expert-legal": 0,
      "freeze-clerk": 0
    },
    "quorum": {
      "min_voters": 3,
      "on_failure": "escalate_to_owner"
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "owner"
  },
  "consensus": {
    "threshold": 0.9,
    "measure": "vote_share",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true,
      "min_dissenters_to_block": 1
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "expression": {
      "all_of": [
        {
          "metric": "custom:question_set_hash_unchanged",
          "op": "==",
          "value": true,
          "value_type": "boolean",
          "producer": "freeze-clerk freeze stage"
        },
        {
          "metric": "consent_reached",
          "op": "==",
          "value": true
        },
        {
          "metric": "every_objection_addressed",
          "op": "==",
          "value": true
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 3,
      "min_evidence_items": 12,
      "min_objections_addressed": 4
    },
    "hard_caps": {
      "max_rounds": 7,
      "max_minutes": 180,
      "on_cap": "escalate_to_owner"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "an expert fact-correction is accepted by the lay panel without changing a conclusion"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "circular_citation_check": true
    },
    "resolution": [
      "narrow_scope",
      "split_question",
      "recruit_independent_critic",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "moderator_capture",
      "hallucinated_expertise",
      "echo_chamber",
      "evidence_free_majority",
      "lost_dissent"
    ],
    "fast_unanimity_response": [
      "blind_re_evaluation",
      "forced_dissent",
      "recruit_independent_critic"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "transcript",
      "idea_catalog",
      "evidence_map",
      "votes_by_round",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release",
        "publish"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "P04 consensus conference",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:161",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:174"
    ],
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#P04"
    ],
    "notes": "DELIBERATIVE. Inverts authority: the non-expert seats own the verdict. The card's adoption proof - freeze-hash the question set before experts are dispatched and verify it unchanged at synthesis - is a stopping conjunct, so a council that cannot show the hash cannot close.\n\nanti-failure controls, each mapped to the field implementing it:\n  moderator_capture -> participants.information_partition (staged_release) hides the question set from the expert committee until it is frozen, and stopping.expression requires custom:question_set_hash_unchanged == true, so expert capture of the framing phase is detectable after the fact\n  hallucinated_expertise -> voting.evidence_gate.votes_require_evidence + objective.evidence_requirements.min_independent_sources=3; an expert answer with no anchor cannot move the verdict\n  echo_chamber -> the lay committee drafts the verdict and experts may correct facts but not conclusions - encoded as voting.method=weighted with expert weights pinned to 0\n  evidence_free_majority -> voting.evidence_gate.reject_evidence_free_majority + evidence_outranks_majority\n  lost_dissent -> consensus.minority_report=required with dissent_policy.preserve_verbatim"
  }
}
