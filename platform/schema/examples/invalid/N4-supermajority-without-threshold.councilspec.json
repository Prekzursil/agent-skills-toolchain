{
  "schema_version": "1.0.0",
  "council_id": "e2-architecture-review-board",
  "preset": "architecture_review_board",
  "participation": "hybrid",
  "objective": {
    "statement": "Decide whether the gateway/lazy-activation architecture supersedes the config-first minimal architecture.",
    "charter": "Architecture Review Board, standing, quorate at 4 voters.",
    "risk_tier": "high",
    "desired_output": "decision",
    "success_criteria": [
      "95% consensus or an explicit minority report",
      "no new objection raised for two consecutive rounds"
    ],
    "consensus_intent": "seek_consensus",
    "confidence_target": 0.85,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 3,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": true,
      "deadline_minutes": 240
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 5,
      "min": 5,
      "max": 5
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 4
    },
    "roster": [
      {
        "participant_id": "chair-arch",
        "display_name": "Chair (Principal Architect)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "distributed systems",
          "plugin platforms"
        ],
        "role": "chair",
        "authority": "chair",
        "vote_weight": 1.5,
        "rights": {
          "may_speak": true,
          "may_vote": true,
          "may_recruit": true
        }
      },
      {
        "participant_id": "sec-reviewer",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "threat modeling",
          "permission models"
        ],
        "role": "security_reviewer",
        "authority": "veto_holder",
        "vote_weight": 1.0,
        "rights": {
          "may_speak": true,
          "may_vote": true,
          "may_veto": true
        }
      },
      {
        "participant_id": "cost-analyst",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "cost modeling",
          "complexity analysis"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "migration-lead",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "migration design",
          "rollback"
        ],
        "role": "architect",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "owner-human",
        "kind": "human",
        "vendor": "human",
        "expertise": [
          "owner intent"
        ],
        "role": "stakeholder",
        "authority": "owner",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      }
    ],
    "replacement": {
      "enabled": true,
      "triggers": [
        "inactivity",
        "conflict_of_interest",
        "role_collapse"
      ],
      "preserve_prior_positions": true
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "recuse_from_vote"
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 3,
    "required_artifacts": [
      "position_memo",
      "risk_list",
      "benchmark_baseline"
    ]
  },
  "topology": {
    "kind": "chair_led",
    "chair": "chair-arch",
    "committees": [
      {
        "committee_id": "security",
        "mandate": "permission + supply chain",
        "members": [
          "sec-reviewer",
          "migration-lead"
        ]
      }
    ]
  },
  "protocol": {
    "sequence": [
      {
        "kind": "blind_independent_first_pass",
        "stage_id": "opening",
        "independent": true
      },
      {
        "kind": "cross_examination",
        "stage_id": "xexam",
        "rounds": 2
      },
      {
        "kind": "steelman_before_rebuttal",
        "stage_id": "steelman",
        "rounds": 2
      },
      {
        "kind": "premortem",
        "stage_id": "premortem"
      },
      {
        "kind": "synthesis",
        "stage_id": "synthesis"
      }
    ],
    "speaking_order": "chair_directed",
    "rounds": {
      "min": 3,
      "max": 10,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 700
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "steelman_before_rebuttal": true,
      "cross_examination": true,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "adversarial",
    "experiments": {
      "allowed": true,
      "max_experiments": 3,
      "runner": "ci"
    }
  },
  "budgets": {
    "effort": "xhigh",
    "time_minutes": 240,
    "tool_calls": 400,
    "sources": 40,
    "turns": 60,
    "max_inactivity_rounds": 2,
    "rebuttal_depth": 3
  },
  "targets": {
    "objections": 8,
    "counterexamples": 4,
    "evidence_items": 30,
    "coverage_score": 0.9
  },
  "voting": {
    "method": "supermajority",
    "quorum": {
      "min_voters": 4,
      "on_failure": "extend_rounds"
    },
    "veto": {
      "holders": [
        "sec-reviewer"
      ],
      "scope": "safety_only",
      "must_justify": true,
      "overridable_by_owner": true
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true,
      "strategic_abstention_check": true
    },
    "belief_aggregation": {
      "method": "calibration_weighted",
      "require_confidence_per_vote": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "chair"
  },
  "consensus": {
    "threshold": 0.95,
    "measure": "vote_share",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "consensus >= 0.95 AND no_new_objection_rounds >= 2",
    "expression": {
      "all_of": [
        {
          "metric": "consensus",
          "op": ">=",
          "value": 0.95
        },
        {
          "metric": "no_new_objection_rounds",
          "op": ">=",
          "value": 2
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 4,
      "every_participant_spoke": true,
      "min_evidence_items": 10
    },
    "hard_caps": {
      "max_rounds": 10,
      "max_minutes": 240,
      "on_cap": "escalate_to_owner"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "migration rehearsal passes",
      "rollback drill recorded"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "circular_citation_check": true,
      "vote_oscillation_rounds": 2
    },
    "resolution": [
      "run_experiment",
      "strongest_counterexample",
      "chair_ruling",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "sycophancy",
      "moderator_capture",
      "evidence_free_majority",
      "lost_dissent",
      "minority_suppression",
      "hidden_conflict_of_interest"
    ],
    "fast_unanimity_response": [
      "blind_re_evaluation",
      "forced_dissent",
      "strongest_counterexample"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "argument_graph",
      "claim_evidence_contradiction_graph",
      "votes_by_round",
      "confidence_trajectory",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "calibration_report",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "Architecture review board",
    "spec_citations": [
      "_USER-PROMPTS.md:10938",
      "_USER-PROMPTS.md:11203"
    ],
    "notes": "Spec example 2 of 6: consensus >= 0.95 AND no_new_objection_rounds >= 2"
  }
}
