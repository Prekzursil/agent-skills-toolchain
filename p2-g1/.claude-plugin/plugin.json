{
  "name": "agent-skills-toolchain",
  "version": "0.3.0",
  "description": "Prekzursil's personal Claude Code skill library - install the whole skills surface in one command instead of copying skills one by one. Works on the local CLI and (when this repo is connected) on Claude Code on the web.",
  "author": {
    "name": "Prekzursil"
  },
  "license": "MIT",
  "compatibility": {
    "min_client": "1.0.0",
    "schema_version": 1
  },
  "keywords": [
    "skills",
    "reverse-engineering",
    "scholarly-research",
    "drug-discovery",
    "codex",
    "agent-ops",
    "cloud"
  ],
  "entrypoints": [
    {
      "id": "hook.prompt-submit",
      "kind": "hook",
      "path": "hooks/_dispatch/prompt_submit.py",
      "interpreter": "python3",
      "min_version": "3.11"
    },
    {
      "id": "hook.pre-tool",
      "kind": "hook",
      "path": "hooks/_dispatch/pre_tool.py",
      "interpreter": "python3",
      "min_version": "3.11"
    },
    {
      "id": "hook.dispatch-run",
      "kind": "hook",
      "path": "hooks/_dispatch/run.py",
      "interpreter": "python3",
      "min_version": "3.11"
    },
    {
      "id": "ci.emit-hook-manifest",
      "kind": "ci",
      "path": "ci/emit_hook_manifest.py",
      "interpreter": "python3",
      "min_version": "3.11"
    },
    {
      "id": "ci.gen-skills-manifest",
      "kind": "ci",
      "path": "ci/gen_skills_manifest.py",
      "interpreter": "python3",
      "min_version": "3.11"
    },
    {
      "id": "plugin.cli",
      "kind": "cli",
      "path": "tools/plugin/cli.py",
      "interpreter": "python3",
      "min_version": "3.11"
    }
  ]
}
