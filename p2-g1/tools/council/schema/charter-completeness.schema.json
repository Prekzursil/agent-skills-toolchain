{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "charter-completeness.schema.json",
  "title": "Charter completeness census result (IMP-0356)",
  "description": "Shape of the census emitted by tools/council/outcomes/completeness.py: per-output presence AND non-vacuity across recorded councils. Presence of a key is not completeness.",
  "type": "object",
  "required": [
    "n_councils",
    "n_pass",
    "n_fail",
    "missing_most_often",
    "per_output"
  ],
  "additionalProperties": true,
  "properties": {
    "n_councils": { "type": "integer", "minimum": 1 },
    "n_pass": { "type": "integer", "minimum": 0 },
    "n_fail": { "type": "integer", "minimum": 0 },
    "missing_most_often": { "type": "string", "minLength": 1 },
    "per_output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["output", "incomplete", "absent", "vacuous"],
        "additionalProperties": false,
        "properties": {
          "output": { "type": "string" },
          "incomplete": { "type": "integer", "minimum": 0 },
          "absent": { "type": "integer", "minimum": 0 },
          "vacuous": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["council_id", "pass", "missing", "present", "vacuous"],
        "additionalProperties": true,
        "properties": {
          "council_id": { "type": ["string", "null"] },
          "pass": { "type": "boolean" },
          "missing": { "type": "array", "items": { "type": "string" } },
          "present": { "type": "object" },
          "vacuous": { "type": "object" },
          "fail_reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "n_pass + n_fail must equal n_councils: the census partitions the corpus.",
      "properties": {
        "n_pass": {},
        "n_fail": {},
        "n_councils": {}
      }
    }
  ]
}
