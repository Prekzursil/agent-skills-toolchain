{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/council/schema/councilspec.schema.json",
  "title": "CouncilSpec",
  "oneOf": [
    { "$ref": "#/$defs/spec" },
    { "$ref": "#/$defs/preset" },
    { "$ref": "#/$defs/protocol" }
  ],
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stopping", "charter", "participants", "voting"],
      "properties": {
        "artifacts": { "type": "object" },
        "budgets": { "type": "object" },
        "charter": { "type": "object" },
        "engagement": { "type": "object" },
        "evidence": { "type": "object" },
        "execution": { "type": "object" },
        "integrity": { "type": "object" },
        "kind": { "type": "string", "const": "councilspec" },
        "meta": { "type": "object" },
        "outcomes": { "type": "object" },
        "participants": { "type": "object" },
        "roles": { "type": "object" },
        "stopping": { "type": "object" },
        "voting": { "type": "object" }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "stopping", "name"],
      "properties": {
        "base_spec_version": { "type": "string" },
        "binds_protocol": { "type": "string" },
        "budgets_delta": { "type": "object" },
        "charter_delta": { "type": "object" },
        "consensus_intent": { "type": "string" },
        "default_binding": { "type": ["boolean", "string"] },
        "description": { "type": "string" },
        "editable_dials": { "type": "array" },
        "engagement_delta": { "type": "object" },
        "family": { "type": "string" },
        "id": { "type": "string" },
        "kind": { "const": "preset" },
        "name": { "type": "string" },
        "outcomes_delta": { "type": "object" },
        "risk_tier": { "type": "string" },
        "roles": { "type": "array" },
        "stopping": { "type": "object" },
        "target_overrides": { "type": "object" },
        "version": { "type": "string" },
        "voting": { "type": "object" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "protocol" },
        "name": { "type": "string" },
        "family": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
