{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "admission.schema.json",
  "title": "Claim admission record (IMP-0365)",
  "description": "Shape of an admit_claim/bind_decision admission row: classification is done on source.type, never on the claimant's assertion.",
  "type": "object",
  "required": ["claim_id", "admitted", "classifier_input_field"],
  "additionalProperties": true,
  "properties": {
    "claim_id": { "type": ["string", "null"] },
    "admitted": { "type": "boolean" },
    "classifier_input_field": { "const": "source.type" },
    "classifier_input_value": { "type": ["string", "null"] },
    "classified_tier": {
      "type": "string",
      "enum": ["anecdote", "cited-source", "replicated-study",
               "peer-reviewed-only", "executable-proof-only"]
    }
  }
}
