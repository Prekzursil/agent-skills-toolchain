{
  "adapter_id": "openai-codex-work-unit-adapter",
  "vendor": "openai",
  "tools": ["Read", "Write", "Edit", "Bash:python", "Bash:codex"],
  "context_window_tokens": 272000,
  "permission_model": {
    "kind": "cli_ignore_user_config",
    "fail_closed": true,
    "output_last_message_file": true
  },
  "streaming": {"token_stream": false, "blocking_foreground": true},
  "schema_support": {
    "json_schema": true,
    "typed_work_result": true,
    "structured_outputs": true
  },
  "prompt_transport": {"inline_allowed": false, "file_required": true},
  "leaks": [
    "prompt:file_required",
    "tool:Bash:codex",
    "permission:output_last_message_file",
    "permission_model:cli_ignore_user_config"
  ]
}
