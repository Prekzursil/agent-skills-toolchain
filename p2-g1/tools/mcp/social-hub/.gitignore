# Per-user multi-account credential store (shared _shared/accounts.py).
# It MAY hold literal secrets (env-mode account bundles) -> NEVER commit it.
# The committed accounts.example.json shows the shape with ${ENV} references.
accounts.json
accounts.json.tmp

# Per-account session/cookie/auth artifacts (FILE-based social logins), if a
# user keeps them inside the hub dir. The account 'files' map points at these
# per-account session.json / cookies.json / Baileys auth_info dirs; a real
# session/cookie/QR credential must never be committed.
accounts/
sessions/
*.session.json
*.cookies.json
auth_info/

# Python caches
__pycache__/
.pytest_cache/
