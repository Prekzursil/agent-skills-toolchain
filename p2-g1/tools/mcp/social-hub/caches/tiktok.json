{
  "initialize": {
    "protocolVersion": "2024-11-05",
    "capabilities": {
      "experimental": {},
      "prompts": {
        "listChanged": false
      },
      "resources": {
        "subscribe": false,
        "listChanged": false
      },
      "tools": {
        "listChanged": false
      }
    },
    "serverInfo": {
      "name": "tiktok",
      "version": "1.27.2"
    }
  },
  "tools": {
    "tools": [
      {
        "name": "tiktok_trending",
        "description": "Public TikTok trending feed (geo-localized to the egress IP/proxy region).\n    Read-only. count is clamped to [1, 50].",
        "inputSchema": {
          "properties": {
            "count": {
              "default": 20,
              "title": "Count",
              "type": "integer"
            }
          },
          "title": "tiktok_trendingArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_trendingDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_user_info",
        "description": "Public profile + stats for a TikTok creator by @username (without the @).\n    Read-only.",
        "inputSchema": {
          "properties": {
            "username": {
              "title": "Username",
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "title": "tiktok_user_infoArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_user_infoDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_user_posts",
        "description": "A creator's recent PUBLIC posts by @username (without the @). Read-only.\n    count is clamped to [1, 50].",
        "inputSchema": {
          "properties": {
            "username": {
              "title": "Username",
              "type": "string"
            },
            "count": {
              "default": 20,
              "title": "Count",
              "type": "integer"
            }
          },
          "required": [
            "username"
          ],
          "title": "tiktok_user_postsArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_user_postsDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_user_liked",
        "description": "A creator's PUBLIC likes by @username — ONLY works if that user made their liked\n    videos public (most accounts keep them private → expect empty). Read-only. Clamp [1,50].",
        "inputSchema": {
          "properties": {
            "username": {
              "title": "Username",
              "type": "string"
            },
            "count": {
              "default": 20,
              "title": "Count",
              "type": "integer"
            }
          },
          "required": [
            "username"
          ],
          "title": "tiktok_user_likedArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_user_likedDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_hashtag",
        "description": "Recent PUBLIC videos for a hashtag (without the #). Read-only. Clamp [1, 50].",
        "inputSchema": {
          "properties": {
            "tag": {
              "title": "Tag",
              "type": "string"
            },
            "count": {
              "default": 20,
              "title": "Count",
              "type": "integer"
            }
          },
          "required": [
            "tag"
          ],
          "title": "tiktok_hashtagArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_hashtagDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_video_details",
        "description": "Metadata for one public TikTok video — pass a full video URL (preferred) or a\n    numeric video id. Read-only.",
        "inputSchema": {
          "properties": {
            "url_or_id": {
              "title": "Url Or Id",
              "type": "string"
            }
          },
          "required": [
            "url_or_id"
          ],
          "title": "tiktok_video_detailsArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_video_detailsDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_comments",
        "description": "Top-level comments on a public TikTok video (URL preferred, or numeric id).\n    Read-only. count is clamped to [1, 50].",
        "inputSchema": {
          "properties": {
            "url_or_id": {
              "title": "Url Or Id",
              "type": "string"
            },
            "count": {
              "default": 20,
              "title": "Count",
              "type": "integer"
            }
          },
          "required": [
            "url_or_id"
          ],
          "title": "tiktok_commentsArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_commentsDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_related_videos",
        "description": "Videos TikTok relates to a given public video (URL preferred, or numeric id).\n    Read-only. count is clamped to [1, 50].",
        "inputSchema": {
          "properties": {
            "url_or_id": {
              "title": "Url Or Id",
              "type": "string"
            },
            "count": {
              "default": 20,
              "title": "Count",
              "type": "integer"
            }
          },
          "required": [
            "url_or_id"
          ],
          "title": "tiktok_related_videosArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_related_videosDictOutput",
          "type": "object"
        }
      },
      {
        "name": "tiktok_search_users",
        "description": "Search TikTok for public user accounts by name/keyword. Read-only. Clamp [1, 50].\n    NOTE: TikTok-Api 7.x exposes user search only — there is no generic video search;\n    use tiktok_hashtag / tiktok_trending for video discovery.",
        "inputSchema": {
          "properties": {
            "query": {
              "title": "Query",
              "type": "string"
            },
            "count": {
              "default": 10,
              "title": "Count",
              "type": "integer"
            }
          },
          "required": [
            "query"
          ],
          "title": "tiktok_search_usersArguments",
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "title": "tiktok_search_usersDictOutput",
          "type": "object"
        }
      }
    ]
  }
}