{
  "name": "imp0460-load-probe-fixture",
  "version": "1.0.0",
  "description": "Fixture plugin: 4 declared hooks, each emits a HOOK-LOAD-MARKER on session start",
  "hooks": [
    {"id": "session-telemetry", "type": "command", "command": "hooks/session-telemetry.py", "timeout": 10, "enabled": true},
    {"id": "session-policy", "type": "command", "command": "hooks/session-policy.py", "timeout": 10, "enabled": true},
    {"id": "session-canary", "type": "command", "command": "hooks/session-canary.py", "timeout": 10, "enabled": true},
    {"id": "pre-tool-guard", "type": "command", "command": "hooks/pre-tool-guard.py", "timeout": 10, "enabled": true}
  ]
}
