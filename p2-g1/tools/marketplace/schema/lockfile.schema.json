{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prekzursil.dev/ast-integrate/schema/lockfile.schema.json",
  "title": "Marketplace lockfile",
  "description": "Resolved install set with integrity digests. Format matches tools/marketplace/lockfile.py generate_lockfile (IMP-0084): a package whose fetched digest differs from its lockfile entry is refused before any write.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolver_version",
    "packages"
  ],
  "properties": {
    "resolver_version": {
      "type": "string",
      "description": "Version of the resolver that produced this lockfile; install warns when it is stale."
    },
    "packages": {
      "type": "array",
      "description": "Pinned rows, sorted by (name, version).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "source_url",
          "sha256",
          "bytes"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
