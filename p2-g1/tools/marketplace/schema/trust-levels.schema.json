{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prekzursil.dev/ast-integrate/schema/trust-levels.schema.json",
  "title": "Publisher trust level",
  "type": "object",
  "additionalProperties": true,
  "required": ["level", "score_millipoints", "scoring_input_sha256", "components"],
  "properties": {
    "level": {
      "type": "string",
      "enum": ["UNRATED", "LOW", "MEDIUM", "HIGH"]
    },
    "score_millipoints": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 10000
    },
    "scoring_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "ignored_popularity_fields": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
