{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "type": "object",
  "required": ["states", "legal_transitions", "owner_gated_targets"],
  "properties": {
    "states": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string" }
    },
    "legal_transitions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "owner_gated_targets": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
