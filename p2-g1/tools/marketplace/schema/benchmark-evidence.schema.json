{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prekzursil.dev/schemas/marketplace/benchmark-evidence.schema.json",
  "title": "Marketplace benchmark evidence record",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "package_name",
    "package_version",
    "harness_version",
    "case_set_id",
    "case_set_path",
    "case_set_sha256",
    "environment_fingerprint",
    "commit_sha",
    "captured_at",
    "metric",
    "reproduction_command",
    "tolerance"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "package_name": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "minLength": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "case_set_id": {"type": "string", "minLength": 1},
    "case_set_path": {"type": "string", "minLength": 1},
    "case_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_fingerprint": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "metric": {
      "type": "object",
      "required": ["name", "unit", "value"],
      "properties": {
        "name": {"type": "string"},
        "unit": {"type": "string"},
        "value": {"type": "number"}
      }
    },
    "reproduction_command": {"type": "string", "minLength": 8},
    "tolerance": {
      "type": "object",
      "properties": {
        "absolute": {"type": "number"}
      }
    }
  },
  "additionalProperties": true
}
