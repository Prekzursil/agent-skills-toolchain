{
  "artifact": "payload-allowlist",
  "policy": "deny-by-default",
  "include": [
    {"glob": ".claude-plugin/plugin.json", "reason": "plugin manifest"},
    {"glob": ".claude-plugin/marketplace.json", "reason": "marketplace descriptor"},
    {"glob": "LICENSE", "reason": "license"},
    {"glob": "README.md", "reason": "docs"},
    {"glob": "commands/*.md", "reason": "slash commands, no nested rogue"},
    {"glob": "hooks/*.py", "reason": "hook scripts"},
    {"glob": "hooks/_dispatch/manifest.json", "reason": "hook dispatch manifest"},
    {"glob": "skills/*/SKILL.md", "reason": "skill surfaces"},
    {"glob": "skills/DEPLOYED-MANIFEST.json", "reason": "deployed skill census"},
    {"glob": "tools/plugin/schema/*.json", "reason": "plugin schemas"}
  ],
  "budget": {"max_bytes": 52428800, "max_files": 4096},
  "forbidden_classes": {
    "git": [".git/**"],
    "logs": ["**/*.log"]
  }
}
