{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/tools/plugin/schema/health-report.schema.json",
  "title": "health-report",
  "type": "object",
  "required": ["healthy", "aggregate", "probes"],
  "properties": {
    "healthy": { "type": "boolean" },
    "aggregate": { "type": "string" },
    "probes": { "type": "array" },
    "blocked_ids": { "type": "array" },
    "missing_unrun": { "type": "array" },
    "reason": { "type": "string" }
  }
}
