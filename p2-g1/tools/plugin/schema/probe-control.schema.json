{
  "$id": "https://prekzursil.dev/ast-integrate/schema/probe-control.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A probe with no declared break_() is recorded NOT-CHECKED, never folded into the valid count.",
  "properties": {
    "artifact": {
      "const": "probe-control"
    },
    "invalid": {
      "minimum": 0,
      "type": "integer"
    },
    "not_checked": {
      "minimum": 0,
      "type": "integer"
    },
    "probe_count": {
      "minimum": 1,
      "type": "integer"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "broken_status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP",
              null
            ]
          },
          "discriminates": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "healthy_status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "probe": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "restored_status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "verdict": {
            "enum": [
              "VALID",
              "INVALID",
              "SKIP",
              "NOT-CHECKED"
            ]
          }
        },
        "required": [
          "probe",
          "healthy_status",
          "verdict"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "valid": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "artifact",
    "probe_count",
    "valid",
    "invalid",
    "not_checked",
    "rows"
  ],
  "title": "Both-states control results for every health probe",
  "type": "object"
}
