{
  "$id": "https://prekzursil.dev/ast-integrate/schema/log-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Records are emitted one per line as JSONL; this schema validates one line.",
  "properties": {
    "event": {
      "minLength": 1,
      "type": "string"
    },
    "fields": {
      "type": "object"
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "op": {
      "minLength": 1,
      "type": "string"
    },
    "ts": {
      "type": "number"
    }
  },
  "required": [
    "ts",
    "level",
    "op",
    "event",
    "fields"
  ],
  "title": "Structured log record with mandatory redaction",
  "type": "object"
}
