{
  "$id": "https://prekzursil.dev/ast-integrate/schema/payload-allowlist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An exclude-only policy is unsound: the first unlisted junk directory ships. `policy` is pinned to deny-by-default so a widened build cannot claim conformance.",
  "properties": {
    "artifact": {
      "const": "payload-allowlist"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "max_files": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_bytes",
        "max_files"
      ],
      "type": "object"
    },
    "forbidden_classes": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "minProperties": 1,
      "type": "object"
    },
    "policy": {
      "const": "deny-by-default"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "glob": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "glob",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "policy",
    "rules",
    "budget",
    "forbidden_classes"
  ],
  "title": "Package payload allowlist (deny-by-default include set)",
  "type": "object"
}
