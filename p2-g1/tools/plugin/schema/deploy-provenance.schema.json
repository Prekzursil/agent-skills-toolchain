{
  "$id": "https://prekzursil.dev/ast-integrate/schema/deploy-provenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The provenance hash is the third reading the drift classifier needs; without it only a one-directional comparison is possible and DIVERGED is invisible.",
  "properties": {
    "artifact": {
      "const": "deploy-provenance"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "deployed_at": {
            "type": "number"
          },
          "live_path": {
            "minLength": 1,
            "type": "string"
          },
          "mode": {
            "enum": [
              "copy",
              "link",
              "merge"
            ]
          },
          "source_path": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "live_path",
          "source_path",
          "version",
          "content_sha256",
          "deployed_at",
          "mode"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "record_count",
    "records"
  ],
  "title": "Per-file deploy provenance",
  "type": "object"
}
