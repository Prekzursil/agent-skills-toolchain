{
  "$id": "https://prekzursil.dev/ast-integrate/schema/projection-map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Records the per-OS argv array each entrypoint resolves to, so the projection is auditable without running the plugin.",
  "properties": {
    "artifact": {
      "const": "projection-map"
    },
    "entrypoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "interpreter": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "command",
              "hook",
              "script",
              "skill"
            ]
          },
          "launch": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "launch"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "plugin": {
      "type": "string"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "file_count": {
            "minimum": 0,
            "type": "integer"
          },
          "mode": {
            "enum": [
              "copy",
              "link",
              "merge"
            ]
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "target",
          "mode",
          "file_count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "artifact",
    "plugin",
    "version",
    "targets",
    "entrypoints"
  ],
  "title": "Manifest-to-live-config projection map",
  "type": "object"
}
