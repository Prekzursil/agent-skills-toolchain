{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marketplace index",
  "description": "Canonical marketplace index schema. plugin_entry deliberately carries NO digest, integrity, or origin field and closes with additionalProperties:false — ADV-0029 documents the dependency-confusion consequence of that hole.",
  "type": "object",
  "required": ["name", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "owner": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}}
    },
    "plugins": {
      "type": "array",
      "items": {"$ref": "#/definitions/plugin_entry"}
    }
  },
  "definitions": {
    "plugin_entry": {
      "type": "object",
      "required": ["name", "source"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  }
}
