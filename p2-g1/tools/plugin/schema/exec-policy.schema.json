{
  "$id": "https://prekzursil.dev/ast-integrate/schema/exec-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`credential_read_allowed` is a const false and `install_runs_shipped_code` a const false: neither can be widened by editing the policy document.",
  "properties": {
    "artifact": {
      "const": "exec-policy"
    },
    "credential_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "default_trigger": {
      "const": "explicit-invocation-only"
    },
    "install_runs_shipped_code": {
      "const": false
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "credential_read_allowed": {
            "const": false
          },
          "entrypoint_kind": {
            "enum": [
              "command",
              "hook",
              "script",
              "skill"
            ]
          },
          "interpreter_required": {
            "type": "boolean"
          },
          "network_allowed": {
            "type": "boolean"
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          },
          "trigger": {
            "enum": [
              "explicit-invocation-only",
              "on-install",
              "automatic"
            ]
          }
        },
        "required": [
          "entrypoint_kind",
          "trigger",
          "interpreter_required",
          "network_allowed",
          "credential_read_allowed",
          "rationale"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "default_trigger",
    "install_runs_shipped_code",
    "credential_boundary",
    "rules"
  ],
  "title": "Execution policy for plugin-shipped scripts",
  "type": "object"
}
