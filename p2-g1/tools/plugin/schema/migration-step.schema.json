{
  "$id": "https://prekzursil.dev/ast-integrate/schema/migration-step.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every step carries a non-empty `inverse`; a step with no inverse cannot be planned.",
  "properties": {
    "artifact": {
      "const": "migration-step"
    },
    "detected_layout": {
      "minLength": 1,
      "type": "string"
    },
    "step_count": {
      "minimum": 0,
      "type": "integer"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "inverse": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "inverse"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "detected_layout",
    "step_count",
    "steps"
  ],
  "title": "Planned migration steps for a detected legacy layout",
  "type": "object"
}
