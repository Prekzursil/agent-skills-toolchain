{
  "$id": "https://prekzursil.dev/ast-integrate/schema/txn-journal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "const": "txn-journal"
    },
    "open_transactions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "prefix": {
      "minLength": 1,
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "event": {
            "enum": [
              "open",
              "step",
              "commit",
              "abort",
              "recovered",
              "unparseable"
            ]
          },
          "op": {
            "type": "string"
          },
          "ts": {
            "type": "number"
          },
          "txn": {
            "type": "string"
          }
        },
        "required": [
          "ts",
          "event"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "prefix",
    "record_count",
    "open_transactions",
    "records"
  ],
  "title": "Lifecycle transaction journal",
  "type": "object"
}
