{
  "$id": "https://prekzursil.dev/ast-integrate/schema/compatibility.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "const": "compatibility"
    },
    "client": {
      "type": [
        "object",
        "null"
      ]
    },
    "compatible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "interpreters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "floor": {
            "type": [
              "string",
              "null"
            ]
          },
          "found": {
            "type": "boolean"
          },
          "interpreter": {
            "enum": [
              "bash",
              "node",
              "pwsh",
              "python3"
            ]
          },
          "meets_floor": {
            "type": "boolean"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "interpreter",
          "found",
          "meets_floor",
          "detail"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "os": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "plugin": {
      "type": "object"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_interpreters": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "shell": {
      "type": "object"
    }
  },
  "required": [
    "artifact",
    "os",
    "shell",
    "interpreters",
    "compatible",
    "reasons"
  ],
  "title": "Client / OS / shell compatibility diagnostics",
  "type": "object"
}
