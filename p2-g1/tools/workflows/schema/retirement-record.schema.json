{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools/workflows/schema/retirement-record.schema.json",
  "title": "Workflow retirement record (IMP-0204)",
  "$comment": "Admits only SUPERSESSION (successor + migration required) or DEPRECATION (reason + removal_date required). A DELETION kind is rejected: retirement is never silent removal (FC-11347).",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["SUPERSESSION", "DEPRECATION"]
    },
    "retired_id": { "type": "string", "minLength": 1 },
    "successor_id": { "type": "string", "minLength": 1 },
    "migration": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "required": ["path"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "removal_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "retired_at": { "type": ["string", "null"] }
  },
  "required": ["kind", "retired_id"],
  "oneOf": [
    {
      "$comment": "SUPERSESSION branch",
      "properties": { "kind": { "const": "SUPERSESSION" } },
      "required": ["kind", "retired_id", "successor_id", "migration"]
    },
    {
      "$comment": "DEPRECATION branch",
      "properties": { "kind": { "const": "DEPRECATION" } },
      "required": ["kind", "retired_id", "reason", "removal_date"]
    }
  ],
  "not": {
    "properties": { "kind": { "const": "DELETION" } },
    "required": ["kind"]
  }
}
