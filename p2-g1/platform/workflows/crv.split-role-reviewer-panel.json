      "NOT a council: no rounds, no consensus, no rebuttal - if you need deliberation use the D4-council family"
    ],
    "benchmark_cases": [
      {
        "name": "planted-injection-sink",
        "setup": "a diff carrying a deliberate command-injection sink",
        "expected": "the security role reports it; a panel that misses it fails the benchmark"
      },
      {
        "name": "clean-diff",
        "setup": "a diff with no defects",
        "expected": "few findings, and none manufactured; a nonzero blocking_count here is a false-positive failure"
      }
    ],
    "why_not_a_duplicate": "BP-CRV-02 folds in git HISTORY to judge what the delta INTRODUCES; this is a role-partitioned read of the diff alone and is history-blind by construction.",
    "unverified": "UNVERIFIED (roughly-even) that all four roles carry non-overlapping recall on this estate; settling experiment = run the panel over ten diffs and count findings unique to each role. A role with zero unique findings is redundant and min_unique_findings_per_role exists to make that measurable.",
    "owner_decision": null,
    "worked_example": {
      "name": "review a 240-line auth refactor authored by the orchestrator",
      "params": {
        "diff_path": "command-center/review/inbox/auth-refactor.diff",
        "language": "python",
        "author_identity": "orchestrator",
        "include_cross_vendor_role": true,
        "min_unique_findings_per_role": 1
      },
      "narrative": "Four roles dispatched, four returned. The security role found one HIGH (a widened token scope); senior found two MEDIUM; consistency found one naming NOTE with no failure scenario, which the evidence gate downgrades rather than counting as a finding.",
      "context": {
        "author_is_reviewer": false,
        "roles_dispatched": 4,
        "roles_returned": 4,
        "findings_without_file_line": 0,
