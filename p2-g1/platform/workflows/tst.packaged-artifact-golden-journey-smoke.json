        "credit": "owner"
      }
    ],
    "decomposable_back_to_sources": true,
    "rollback_to": [
      "skills/packaged-artifact-smoke"
    ]
  },
  "outputs": {
    "smoke-report": {
      "path": "command-center/smoke/qlt-58-smoke-report.json",
      "schema_ref": "command-center/schema/smoke-report.schema.json",
      "min_bytes": 384,
      "register_in_manifest": true,
      "consumers": [
        "command-center/CLAIM-REGISTRY.json"
      ]
    }
  },
  "x_extensions": {
    "library_card": "BP-TST-05",
    "card_index": 58,
    "family": "D11-testing",
    "acquisition_route": "ADOPT",
    "mechanism_fingerprint": {
      "subject": "packaged-artifact",
      "oracle": "deterministic-artifact-measurement",
      "execution_required": true,
      "mutation_target": "none",
      "comparison_axis": "produced-output-vs-expected-measurement",
      "output_type": "journey-postconditions",
      "information_barrier": false
    },
    "mechanism": "Run the DELIVERABLE, not the tree, along fixed journeys, and measure the file each journey produced. The oracle is a property measurement of an output artifact.",
    "contraindications": [
      "NOT a unit or integration substitute",
      "NOT for pixel critique",
      "NOT applicable before a packaged artifact exists",
      "NOT satisfied by 'it did not crash' - that probe is refused"
    ],
    "benchmark_cases": [
      {
        "name": "removed-runtime-dependency",
        "setup": "strip a runtime dep from the package",
        "expected": "the smoke FAILS - the both-states control proving the smoke can see a packaging gap"
      },
      {
        "name": "healthy-build",
        "setup": "a correct package",
        "expected": "every postcondition is a measurement (codec, resolution, byte size), not an absence claim"
      }
    ],
    "why_not_a_duplicate": "BP-TST-04 drives interaction RANDOMLY and asserts invariants on app state; this drives FIXED journeys and measures the OUTPUT artifact. BP-TST-01 runs the source tree's own suite and never touches a package.",
    "unverified": "UNVERIFIED (almost-certain for the Electron path from the Reframe precedent, unmeasured for the python-wheel path here); settling experiment = the removed-dependency both-states control on a wheel.",
    "owner_decision": null,
    "worked_example": {
      "name": "pre-release smoke of a built Electron reframing app",
      "params": {
        "artifact_path": "dist/ReframeSetup-1.4.2.exe",
        "artifact_kind": "electron",
        "journeys": [
          "import-clip",
          "reframe-16x9-to-9x16",
          "export-vertical"
        ],
        "clean_env": "container",
        "postcondition_probes": [
          "ffprobe-stream-properties",
          "file-exists-and-min-size"
        ]
      },
      "narrative": "The binary launched in a clean container with its resolved dependency list recorded. All 3 journeys ran. The export journey's output measured 1080x1920 h264, 12.04s - a measurement, not a no-crash assertion. The postcondition gate rejected a proposed fourth probe that only checked the process exit code.",
      "context": {
        "probes_asserting_only_absence_of_crash": 0,
        "probes_measuring_produced_artifact": 3,
        "source_tree_green_used_as_journey_evidence": false,
        "ambient_dependency_leakage_checked": true,
        "env_kind_recorded": true,
        "journeys_attempted": 3,
        "journeys_declared": 3,
        "launch_succeeded": true,
        "launch_diagnostics_recorded": false,
        "stage_role": "POSTCONDITION_PROBER"
      },
      "expected_gate_pass": [
        "postcondition-is-a-measurement",
        "source-green-not-evidence",
        "clean-environment",
        "every-journey-attempted"
      ],
      "expected_stop": [
        "all-journeys-attempted"
      ],
      "negative_control": {
        "gate": "postcondition-is-a-measurement",
        "overrides": {
          "probes_asserting_only_absence_of_crash": 1,
          "probes_measuring_produced_artifact": 0
        },
        "expected": false,
        "why": "an absence-of-crash probe is exactly the theatre this blueprint exists to prevent and must fail the gate"
      }
    }
  }
}
