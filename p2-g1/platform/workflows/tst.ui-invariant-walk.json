      "NOT trustworthy as a null result unless routes_visited > 1"
    ],
    "benchmark_cases": [
      {
        "name": "planted-dead-button",
        "setup": "a control that renders enabled and visible but has no handler",
        "expected": "the walk finds it and shrinks to a minimal click sequence"
      },
      {
        "name": "healthy-app-null",
        "setup": "an app with no known defects",
        "expected": "zero violations AND routes_visited > 1; a null over a one-route walk measured nothing"
      }
    ],
    "why_not_a_duplicate": "BP-TST-05 asserts deterministic postconditions on a PACKAGED artifact's OUTPUT along fixed journeys; this asserts invariants during RANDOM interaction and its product is a minimal sequence. Fixed-vs-random and output-vs-invariant are both different axes.",
    "unverified": "UNVERIFIED (roughly-even) coverage depth versus the scripted E2E suite; settling experiment = instrument route coverage during a walk and check it exceeds the scripted suite's. Random walks miss deep states without journey seeding, which is why seed_from_golden_journey defaults true.",
    "owner_decision": null,
    "worked_example": {
      "name": "walk a local Vite dev server with a 120-command budget",
      "params": {
        "app_target": "http://127.0.0.1:5173",
        "command_model_ref": "command-center/ui/models/studio-commands.json",
        "invariants": [
          "no-dead-enabled-control",
          "no-error-route"
        ],
        "walk_length": 120,
        "walk_seed": 20260818,
        "seed_from_golden_journey": true
      },
      "narrative": "Seeded from the export journey, the walk executed 74 commands across 5 routes before hitting a no-dead-enabled-control violation on a settings toggle. Shrinking reduced the repro from 74 commands to 3. The report records seed 20260818, so the 3-command sequence replays exactly.",
      "context": {
        "routes_visited": 5,
        "commands_executed": 74,
        "violations_found": 1,
        "violations_without_minimal_sequence": 0,
        "seed_recorded": true,
        "blocks_ci": false,
        "nags": false,
        "sink_bounded": true,
        "target_is_production": false,
        "walk_length": 120,
        "sequence_length": 3,
        "sequence_length_stable": true,
        "attached": true,
        "attach_diagnostics_recorded": false,
        "stage_role": "WALKER"
      },
      "expected_gate_pass": [
        "walk-actually-moved",
        "minimal-sequence-required",
        "shadow-only",
        "not-production"
      ],
      "expected_stop": [
        "walk-budget-or-violation"
      ],
      "negative_control": {
        "gate": "walk-actually-moved",
