{
  "amendment": {
    "process": "An amendment is a pull request that changes BOTH this document and GOVERNANCE.md in the same commit. MKT-L17 fails when a publish precondition named here is absent from the prose, so the two cannot drift: a governance value the prose does not state is a value nobody agreed to. Release mode is PR-ONLY, so every amendment is reviewed before it is effective.",
    "quorum": 1
  },
  "policy_version": "1.0.0",
  "prose_document": "GOVERNANCE.md",
  "publish_preconditions": [
    "license-basis-present",
    "license-aggregate-consistent",
    "signature-present",
    "sbom-complete",
    "payload-allowlist-explicit",
    "no-secret-findings",
    "permissions-within-ceiling",
    "conformance-score-floor",
    "provenance-complete"
  ],
  "roles": [
    {
      "may": ["publish-package", "yank-version", "install-package", "file-appeal"],
      "role": "publisher"
    },
    {
      "may": ["sign-index", "revoke-package", "yank-version", "operate-mirror", "install-package"],
      "role": "registry-maintainer"
    },
    {
      "may": ["open-moderation-case", "close-moderation-case", "revoke-package"],
      "role": "moderator"
    },
    {
      "may": ["publish-advisory", "revoke-package", "open-moderation-case"],
      "role": "security-response"
    },
    {
      "may": ["install-package", "open-moderation-case"],
      "role": "consumer"
    }
  ],
  "schema_version": "1.0.0",
  "slas": {
    "advisory_triage_days": 7,
    "appeal_window_days": 30,
    "moderation_triage_days": 14
  }
}
