{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/platform/marketplace/schema/lint-report.schema.json",
  "title": "Marketplace lint report",
  "description": "Output of the marketplace linter (spec 10873). The report asserts a POSITIVE: `rules_evaluated` lists every rule id that actually ran and `rules_total` is the count the linter declares it owns, so an aggregate consumer must compare them. A guard that swallowed an exception and reported `0 findings / 0 rules` is the worst defect class in this program -- an empty `findings` array alone is NOT a pass, and this schema makes that unstatable by requiring both counts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "verdict", "rules_total", "rules_evaluated", "findings", "linted_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "target": { "type": "string", "minLength": 1, "maxLength": 400 },
    "target_kind": { "enum": ["package", "registry", "bundle", "trust-policy", "governance"] },
    "verdict": { "enum": ["PASS", "FAIL", "ERROR"] },
    "rules_total": { "type": "integer", "minimum": 1 },
    "rules_evaluated": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^MKT-L[0-9]{2}$" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "severity", "message"],
        "properties": {
          "rule": { "type": "string", "pattern": "^MKT-L[0-9]{2}$" },
          "severity": { "enum": ["error", "warning"] },
          "message": { "type": "string", "minLength": 4, "maxLength": 800 },
          "path": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "linted_at": { "$ref": "common.schema.json#/$defs/iso8601" }
  }
}
