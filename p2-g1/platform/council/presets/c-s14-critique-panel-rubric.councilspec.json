{
  "schema_version": "1.0.0",
  "council_id": "c-s14-critique-panel-rubric",
  "preset": "benchmark_results_jury",
  "participation": "agent_only",
  "objective": {
    "statement": "Score an artifact against a fixed rubric - every dimension, one dimension per call - and return a weighted composite plus the critical-error override that can cap it.",
    "charter": "A rubric jury, not a debate. Five personas each score the SAME dimension set on a 0-4 scale; a single call never scores more than one dimension, because bundling dimensions into one response is where scores drift into a vibe. A critical error forces that dimension to zero and CAPS the composite regardless of the other scores - a weighted average must not be able to launder a critical failure.",
    "risk_tier": "low",
    "desired_output": "review_verdict",
    "success_criteria": [
      "every rubric dimension has a score from every persona, with no dimension skipped",
      "each score cites the observed evidence, not a preference",
      "any critical error is recorded, forces its dimension to zero, and caps the composite",
      "the composite is computed from the declared weights, not asserted"
    ],
    "consensus_intent": "elicit_distribution",
    "confidence_target": 0.75,
    "evidence_requirements": { "citation_required": true, "anchor_style": "any", "min_independent_sources": 1, "evidence_outranks_votes": true },
    "owner_constraints": { "approval_required": false, "deadline_minutes": 15 }
  },
  "participants": {
    "selection": { "mode": "exact", "strategies": ["exact", "stratified"], "explain_choices": true, "owner_override_allowed": true },
    "count": { "mode": "exact", "exact_n": 5, "min": 5, "max": 5 },
    "diversity": { "min_distinct_vendors": 2, "min_distinct_expertise": 5 },
    "roster": [
      {
        "participant_id": "persona-designer",
        "display_name": "Persona 1: visual/interaction designer",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": ["visual design", "layout"],
        "role": "designer",
        "authority": "voter",
        "vote_weight": 1.2,
        "rights": { "may_speak": true, "may_vote": true },
        "effort": "high"
      },
      {
        "participant_id": "persona-a11y",
        "display_name": "Persona 2: accessibility reviewer (owns the contrast dimension)",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": ["accessibility", "colour contrast"],
        "role": "custom:accessibility_reviewer",
        "authority": "voter",
        "vote_weight": 1.5,
        "rights": { "may_speak": true, "may_vote": true },
        "effort": "high"
      },
      {
        "participant_id": "persona-user",
        "display_name": "Persona 3: user advocate (first-run experience)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": ["usability", "first-run experience"],
        "role": "user_advocate",
        "authority": "voter",
        "vote_weight": 1,
        "rights": { "may_speak": true, "may_vote": true },
        "effort": "medium"
      },
      {
        "participant_id": "persona-engineer",
        "display_name": "Persona 4: implementation reviewer (is the artifact buildable as scored)",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": ["implementation", "component structure"],
        "role": "architect",
        "authority": "voter",
        "vote_weight": 1,
        "rights": { "may_speak": true, "may_vote": true },
        "effort": "medium"
      },
      {
        "participant_id": "persona-product",
        "display_name": "Persona 5: product reviewer (does it serve the job)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": ["product fit"],
        "role": "product_manager",
        "authority": "voter",
        "vote_weight": 1,
        "rights": { "may_speak": true, "may_vote": true },
        "effort": "medium"
      }
    ],
    "role_templates": ["designer", "custom:accessibility_reviewer", "user_advocate", "architect", "product_manager"],
    "anonymity": { "mode": "blind_to_peers", "reveal_after_round": 1 },
    "conflicts_policy": { "disclosure_required": true, "on_conflict": "disclose_only" },
    "duplicate_detection": { "enabled": true, "dimensions": ["expertise", "position_similarity"], "max_similarity": 0.9 }
  },
  "preparation": { "research_required": false, "independent_prep": true, "min_sources": 1, "required_artifacts": ["benchmark_baseline"] },
  "topology": { "kind": "jury" },
  "protocol": {
    "sequence": [
      { "kind": "custom", "custom_name": "one-dimension-per-call-scoring", "stage_id": "scoring", "rounds": 1, "independent": true, "anonymous": true },
      { "kind": "synthesis", "stage_id": "composite" }
    ],
    "speaking_order": "simultaneous",
    "rounds": { "min": 1, "max": 2 },
    "turn": { "max_words": 300 },
    "obligations": { "must_cite_evidence": true, "declare_confidence": true },
    "critique_intensity": "standard",
    "experiments": { "allowed": false, "max_experiments": 0 }
  },
  "budgets": { "effort": "high", "time_minutes": 15, "tokens": 80000, "tool_calls": 60, "turns": 10, "speaking_quota_per_participant": 9 },
  "targets": { "coverage_score": 1.0, "evidence_items": 9 },
  "voting": {
    "method": "weighted",
    "weights": {
      "persona-designer": 1.2,
      "persona-a11y": 1.5,
      "persona-user": 1,
      "persona-engineer": 1,
      "persona-product": 1
    },
    "score_scale": { "min": 0, "max": 4 },
    "abstention": { "allowed": false, "counts_toward_quorum": false },
    "belief_aggregation": { "method": "trimmed_mean", "require_confidence_per_vote": true },
    "evidence_gate": { "votes_require_evidence": true, "evidence_outranks_majority": true, "reject_evidence_free_majority": true },
    "tie_break": "no_decision"
  },
  "consensus": {
    "threshold": 0.7,
    "measure": "confidence_overlap",
    "minority_report": "optional",
    "dissent_policy": { "preserve_verbatim": true, "attributed": true },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": false
  },
  "stopping": {
    "expression": {
      "all_of": [
        {
          "metric": "custom:all_rubric_dimensions_scored",
          "op": "==",
          "value": true,
          "value_type": "boolean",
          "producer": "stage 'scoring': for every (persona, dimension) pair a 0-4 score exists with an evidence anchor; zero missing cells, and any critical error is recorded with its forced zero",
          "note": "This is the rubric dial. Edit the dimension list in the rubric the producer reads; do not encode dimension names here, or the preset stops being reusable."
        },
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true,
          "note": "A composite computed from four of five personas is a different measurement, not a tolerable approximation."
        }
      ]
    },
    "minimum_deliberation": { "min_rounds": 1, "min_independent_positions": 5, "every_participant_spoke": true, "min_evidence_items": 9 },
    "hard_caps": { "max_rounds": 2, "max_minutes": 15, "on_cap": "no_decision" }
  },
  "outcomes": {
    "allowed": ["decision", "dissent"],
    "conditional_decision_requires": []
  },
  "deadlock": {
    "detection": { "no_progress_rounds": 1, "vote_oscillation_rounds": 2 },
    "resolution": ["blind_re_evaluation", "narrow_scope", "declare_no_decision"],
    "escalation": { "after_attempts": 1, "to": "owner" },
    "owner_intervention": { "allowed": true, "may_override_vote": false, "must_be_logged": true }
  },
  "anti_failure": {
    "controls": ["sycophancy", "participant_dominance", "evidence_free_majority", "weak_synthesis", "prompt_injection"],
    "injection_defense": { "treat_artifacts_as_data": true, "strip_instructions_from_participant_output": true }
  },
  "outputs": {
    "required": ["transcript", "evidence_map", "votes_by_round", "confidence_trajectory", "final_recommendation", "calibration_report"],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": false,
    "determinism": "deterministic_where_possible",
    "privacy": { "redact_secrets": true, "redaction_policy": "deny_by_default", "retain_days": 60 },
    "persistence": { "store": "both", "checkpoint_every_round": false },
    "calibration": { "post_run": true, "score": "brier" }
  },
  "metadata": {
    "title": "C-S14 critique-panel-rubric",
    "notes": "HUMAN-STOP: custom:all_rubric_dimensions_scored == true AND all_participants_spoke == true | EDITABLE-DIALS: voting.weights AND participants.roster[*].vote_weight together (weights - they are two views of one number and MUST be edited in lockstep; the schema does not cross-check them) . the rubric dimension list read by the stopping producer (rubric) . voting.score_scale | NO-SOURCE-EXPRESSION: the custom leaf carries producer + note, which SEM-001 exact-equality forbids alongside source_expression; the HUMAN-STOP line is proven equivalent by _probe_lane1_presets.py | RUBRIC: the reference rubric is DESIGN-EVAL v1 (nine dimensions, 0-4 each, colour-contrast weighted highest, critical-error override that forces a zero and caps the verdict). The dimension names are deliberately NOT hardcoded here so the same preset can score a different artifact class. | OUTCOME-MAP: CONSENSUS -> decision . MAJORITY_WITH_DISSENT -> decision + dissent . the design allows no other outcome, so no_decision is deliberately absent from outcomes.allowed and a stalled panel exits through stopping.hard_caps.on_cap instead | VOTING-MAP: design weighted_rubric -> voting.method=weighted with an explicit weights map (SEM-005 requires at least one positive weight and rejects unknown participant ids) | BINDING: advisory.",
    "spec_citations": [
      "_USER-PROMPTS.md:10746-10768",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:1344-1357"
    ],
    "owner": "Prekzursil",
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#C-S14 critique-panel-rubric",
      "protocol P45 scientific-peer-review",
      "DESIGN-EVAL v1 rubric (nine dimensions, 0-4, critical-error override)"
    ]
  }
}
