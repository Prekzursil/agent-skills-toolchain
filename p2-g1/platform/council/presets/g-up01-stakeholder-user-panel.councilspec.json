{
  "schema_version": "1.0.0",
  "council_id": "g-up01-stakeholder-user-panel",
  "preset": "stakeholder_user_panel",
  "participation": "hybrid",
  "objective": {
    "statement": "Elicit what the people who actually use the thing experience, as evidence, before any decision is taken about changing it.",
    "charter": "Stakeholder / user panel. This council does NOT decide and does NOT bargain - it REPORTS. Each seat speaks from one usage position and must cite a concrete episode, not a preference. A panel that produces a decision has overwritten the evidence it was convened to gather.",
    "risk_tier": "moderate",
    "desired_output": "review_verdict",
    "success_criteria": [
      "every seat cited at least two concrete episodes, with when and what happened",
      "no seat argued for a solution; each described experience",
      "disagreement between usage positions is preserved, not averaged away"
    ],
    "consensus_intent": "elicit_distribution",
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "any",
      "min_independent_sources": 2,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": false,
      "deadline_minutes": 45
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "stakeholder_balanced",
        "model_diverse"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 6,
      "min": 6,
      "max": 6
    },
    "diversity": {
      "min_distinct_vendors": 3,
      "min_distinct_expertise": 5
    },
    "roster": [
      {
        "participant_id": "user-daily",
        "display_name": "Daily driver (uses it every session)",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "role": "user_advocate",
        "authority": "contributor",
        "effort": "high",
        "expertise": [
          "everyday workflow"
        ],
        "rights": {
          "may_speak": true,
          "may_vote": true
        },
        "independence": {
          "fresh_context": true,
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "user-new",
        "display_name": "New user (first week)",
        "kind": "agent",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "role": "user_advocate",
        "authority": "contributor",
        "effort": "high",
        "expertise": [
          "onboarding friction"
        ],
        "rights": {
          "may_speak": true,
          "may_vote": true
        },
        "independence": {
          "fresh_context": true,
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "user-power",
        "display_name": "Power user (edge cases and scale)",
        "kind": "agent",
        "model": "gemini-3-pro",
        "vendor": "google",
        "role": "user_advocate",
        "authority": "contributor",
        "effort": "high",
        "expertise": [
          "scale and edge cases"
        ],
        "rights": {
          "may_speak": true,
          "may_vote": true
        },
        "independence": {
          "fresh_context": true,
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "user-recovering",
        "display_name": "Recovering user (hit a failure and worked around it)",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "role": "user_advocate",
        "authority": "contributor",
        "effort": "high",
        "expertise": [
          "failure recovery and workarounds"
        ],
        "rights": {
          "may_speak": true,
          "may_vote": true
        },
        "independence": {
          "fresh_context": true,
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "facilitator",
        "display_name": "Facilitator (asks, never advocates)",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "role": "facilitator",
        "authority": "chair",
        "effort": "high",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "owner-observer",
        "display_name": "Owner (observes, does not steer the panel)",
        "kind": "human",
        "vendor": "human",
        "role": "observer",
        "authority": "observer",
        "expertise": [
          "owner intent"
        ],
        "rights": {
          "may_speak": false,
          "may_vote": false
        }
      }
    ],
    "anonymity": {
      "mode": "pseudonymous",
      "reveal_after_round": 2
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "disclose_only"
    },
    "duplicate_detection": {
      "enabled": true,
      "dimensions": [
        "position_similarity",
        "expertise"
      ],
      "max_similarity": 0.75
    }
  },
  "preparation": {
    "research_required": false,
    "independent_prep": true,
    "required_artifacts": [
      "position_memo"
    ]
  },
  "topology": {
    "kind": "chair_led",
    "chair": "facilitator"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "blind_independent_first_pass",
        "stage_id": "episodes",
        "independent": true,
        "anonymous": true,
        "quotas": {
          "ideas_per_participant": 2
        },
        "exit_when": {
          "all_of": [
            {
              "metric": "independent_positions",
              "op": ">=",
              "value": 4,
              "note": "one independent account per user seat, gathered before any seat hears another - a panel that talks first converges on the loudest episode"
            },
            {
              "metric": "evidence_items",
              "op": ">=",
              "value": 8,
              "note": "two concrete episodes per user seat"
            }
          ]
        }
      },
      {
        "kind": "fishbowl",
        "stage_id": "panel-discussion",
        "rounds": 2
      },
      {
        "kind": "custom",
        "stage_id": "divergence-map",
        "custom_name": "map where the usage positions DISAGREE and keep both accounts",
        "participants": [
          "facilitator"
        ]
      },
      {
        "kind": "synthesis",
        "stage_id": "experience-report"
      }
    ],
    "speaking_order": "round_robin",
    "rounds": {
      "min": 3,
      "max": 5,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 500
    },
    "obligations": {
      "must_cite_evidence": true,
      "must_respond_to_prior": false,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "gentle"
  },
  "budgets": {
    "effort": "high",
    "time_minutes": 45,
    "tool_calls": 60,
    "turns": 30,
    "speaking_quota_per_participant": 5,
    "max_inactivity_rounds": 2
  },
  "targets": {
    "evidence_items": 12,
    "coverage_score": 0.85,
    "diversity_index": 0.6
  },
  "voting": {
    "method": "score",
    "score_scale": {
      "min": 1,
      "max": 5
    },
    "quorum": {
      "min_voters": 3,
      "on_failure": "extend_rounds"
    },
    "belief_aggregation": {
      "method": "median",
      "require_confidence_per_vote": true
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "no_decision"
  },
  "consensus": {
    "measure": "confidence_overlap",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": false,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "independent_positions >= 4 AND evidence_items >= 12 AND all_participants_spoke == true",
    "expression": {
      "all_of": [
        {
          "metric": "independent_positions",
          "op": ">=",
          "value": 4
        },
        {
          "metric": "evidence_items",
          "op": ">=",
          "value": 12
        },
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 4,
      "min_evidence_items": 12,
      "every_participant_spoke": true
    },
    "hard_caps": {
      "max_rounds": 5,
      "max_minutes": 45,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "dissent",
      "irreducible_disagreement",
      "no_decision",
      "conditional_decision",
      "proof_of_impossibility",
      "minority_report"
    ],
    "conditional_decision_requires": [
      "the report names which usage position each finding came from"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.85
    },
    "resolution": [
      "narrow_scope",
      "split_question",
      "recruit_independent_critic",
      "declare_no_decision"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": false,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "participant_dominance",
      "echo_chamber",
      "premature_convergence",
      "instant_unanimity",
      "lost_dissent",
      "minority_suppression",
      "moderator_capture",
      "prompt_injection"
    ],
    "fast_unanimity_response": [
      "blind_re_evaluation",
      "forced_dissent"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "transcript",
      "evidence_map",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "pii_policy": "redact",
      "retain_days": 180
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "Stakeholder / user experience panel (4 users + facilitator + owner observer)",
    "owner": "Prekzursil",
    "lineage": [
      "spec REQUIRED preset: stakeholder/user panel",
      "adjacent card C-S28 stakeholder-negotiation-5 (a DIFFERENT council)",
      "P03 fishbowl",
      "P23 silent-start-pooling"
    ],
    "spec_citations": [
      "_USER-PROMPTS.md:10473-11437"
    ],
    "notes": "DESIGN LINEAGE: (no design card in indices 17-32; authored from the spec's required-preset list) in 12-COUNCIL-PROTOCOLS-AND-PRESETS.md (seats: 0; roles: user_advocate_x4,facilitator,owner_observer).\nPRESET LABEL: stakeholder_user_panel - a spec-REQUIRED archetype that a directory-wide measurement showed no file carried.\nOUTCOME MAPPING (card vocabulary -> schema outcomes.allowed): CONSENSUS->decision, MAJORITY_WITH_DISSENT->dissent, IRREDUCIBLE_DISAGREEMENT->irreducible_disagreement, INSUFFICIENT_EVIDENCE->no_decision, CONDITIONAL_DECISION->conditional_decision, DEFER->no_decision, PROOF_OF_IMPOSSIBILITY->proof_of_impossibility, MINORITY_REPORT->minority_report.\nEDITABLE DIALS (pointer -> what it changes):\n  - $.participants.roster (the four user seats) : WHICH usage positions are at the table. The four here (daily, new, power, recovering) are chosen to disagree; four seats that use the thing the same way produce one account, not four\n  - $.participants.anonymity.reveal_after_round : pseudonymity protects a negative account from being softened; unmask later, not never\n  - $.voting.method + $.score_scale : score with a median aggregate. The panel rates experience; it does not elect an option\n  - $.protocol.critique_intensity : gentle on purpose - adversarial pressure on a user account suppresses the accounts you most need\nLANE-2 GAP FILL, NOT A LANE-2 SLICE MEMBER, and NOT a relabel of C-S28. C-S28 stakeholder-negotiation-5 in this same lane bargains over an ALLOCATION with BATNAs and concessions; this council gathers EVIDENCE about experience and is forbidden from deciding (tie_break=no_decision, owner may not steer, may_speak=false on the owner seat). IF ANOTHER LANE ALSO BUILT stakeholder_user_panel, DEDUPE - this file is namespaced g-up01-* rather than c-* precisely so the duplicate is trivially detectable. This lane's FIRST gap-fill attempt (general_purpose_auto_composed, g00-*) was deleted for exactly that reason once c-g73-* was measured in the directory.\nEVERY field in this file is a dial; the ones above are the ones the owner is expected to change first. See README.md in this directory for the full table."
  }
}
