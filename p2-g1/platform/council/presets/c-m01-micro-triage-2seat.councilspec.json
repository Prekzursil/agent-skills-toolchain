{
  "schema_version": "1.0.0",
  "council_id": "c-m01-micro-triage-2seat",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Route an incoming question: handle it here, promote it to a heavier council, or defer for want of evidence. The merits are deliberately OUT of scope.",
    "charter": "Front door. Two seats, one round, ninety seconds. This council decides WHERE a question goes, never WHAT the answer is; if it starts arguing the merits it has failed its charter.",
    "risk_tier": "low",
    "desired_output": "recommendation",
    "success_criteria": [
      "a routing target is named (handle here / promote to preset X / defer)",
      "the promotion threshold that fired is quoted verbatim",
      "no position on the underlying question appears in the output"
    ],
    "consensus_intent": "adjudicate",
    "confidence_target": 0.7,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "any",
      "min_independent_sources": 0,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": false,
      "deadline_minutes": 1.5,
      "budget_ceiling_tokens": 8000
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": ["exact"],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": { "mode": "exact", "exact_n": 2, "min": 2, "max": 2 },
    "roster": [
      {
        "participant_id": "chair",
        "display_name": "Chair (routes, does not adjudicate merits)",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": ["triage", "process routing"],
        "role": "chair",
        "authority": "chair",
        "vote_weight": 1,
        "rights": { "may_speak": true, "may_vote": true, "may_recruit": true },
        "effort": "low",
        "context": {
          "briefing": "You receive only the question and the routing table. Name a destination and the threshold that fired. Do NOT answer the question."
        }
      },
      {
        "participant_id": "generalist",
        "display_name": "Generalist second seat",
        "kind": "agent",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": ["general reasoning"],
        "role": "custom:generalist",
        "authority": "voter",
        "vote_weight": 1,
        "rights": { "may_speak": true, "may_vote": true },
        "effort": "low",
        "context": {
          "briefing": "Disagree with the chair's routing when the question is heavier or lighter than the chair judged. Silence is assent and is recorded as such."
        }
      }
    ],
    "role_templates": ["chair", "custom:generalist"],
    "conflicts_policy": { "disclosure_required": false, "on_conflict": "disclose_only" }
  },
  "preparation": {
    "research_required": false,
    "independent_prep": false,
    "min_sources": 0,
    "prep_time_minutes": 0
  },
  "topology": { "kind": "chair_led", "chair": "chair" },
  "protocol": {
    "sequence": [
      { "kind": "round_robin", "stage_id": "route", "rounds": 1 }
    ],
    "speaking_order": "chair_directed",
    "rounds": { "min": 1, "max": 1, "divergence_before_convergence": false },
    "turn": { "max_words": 180, "time_limit_seconds": 45 },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": false,
      "declare_confidence": true
    },
    "critique_intensity": "gentle",
    "experiments": { "allowed": false, "required_before_decision": false, "max_experiments": 0 }
  },
  "budgets": {
    "effort": "low",
    "time_minutes": 1.5,
    "tokens": 8000,
    "tool_calls": 4,
    "turns": 2,
    "min_engagement_turns": 1,
    "max_inactivity_rounds": 1
  },
  "voting": {
    "method": "unanimity",
    "abstention": { "allowed": false, "counts_toward_quorum": false },
    "evidence_gate": { "votes_require_evidence": false, "evidence_outranks_majority": true },
    "tie_break": "owner"
  },
  "consensus": {
    "threshold": 1.0,
    "measure": "vote_share",
    "minority_report": "optional",
    "dissent_policy": { "preserve_verbatim": true, "attributed": true },
    "irreducible_disagreement_allowed": false,
    "fast_unanimity_is_suspicious": false
  },
  "stopping": {
    "source_expression": "ANY[rounds_elapsed >= 1, confidence >= 0.7]",
    "expression": {
      "any_of": [
        { "metric": "rounds_elapsed", "op": ">=", "value": 1 },
        { "metric": "confidence", "op": ">=", "value": 0.7 }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 1,
      "min_independent_positions": 2,
      "every_participant_spoke": true
    },
    "hard_caps": { "max_rounds": 1, "max_minutes": 1.5, "max_tokens": 8000, "on_cap": "escalate_to_owner" }
  },
  "outcomes": {
    "allowed": ["decision", "no_decision"],
    "conditional_decision_requires": []
  },
  "deadlock": {
    "detection": { "no_progress_rounds": 1 },
    "resolution": ["chair_ruling", "escalate_to_owner"],
    "escalation": { "after_attempts": 1, "to": "owner" },
    "owner_intervention": { "allowed": true, "may_override_vote": true, "must_be_logged": true }
  },
  "anti_failure": {
    "controls": ["silence", "prompt_injection"],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": ["transcript", "final_recommendation", "decision_lineage"],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": false,
    "determinism": "seeded",
    "privacy": { "redact_secrets": true, "redaction_policy": "deny_by_default", "retain_days": 30 },
    "persistence": { "store": "ledger", "checkpoint_every_round": false }
  },
  "metadata": {
    "title": "C-M01 micro-triage-2seat",
    "notes": "HUMAN-STOP: ANY[rounds_elapsed >= 1, confidence >= 0.7] | EDITABLE-DIALS: participants.count.exact_n (seats) . budgets.time_minutes + stopping.hard_caps.max_minutes (wall) . the 0.7 in stopping.expression (promotion_threshold) | METRIC-MAP: the design's chair_confident maps to the registered numeric metric confidence >= 0.7, so no custom metric and no unproducible signal | OUTCOME-MAP: design PROCEED -> decision . INSUFFICIENT_EVIDENCE and DEFER -> no_decision (the schema outcome vocabulary has seven members; the design tier used its own) | VOTING-MAP: design unanimity_else_escalate -> voting.method=unanimity plus deadlock.escalation.to=owner | ANTI-SYCOPHANCY: off by design, so consensus.fast_unanimity_is_suspicious=false; flip it to true and add anti_failure.fast_unanimity_response to arm it | BINDING: advisory.",
    "spec_citations": [
      "_USER-PROMPTS.md:10746-10768",
      "_USER-PROMPTS.md:11200-11225",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:1149-1162"
    ],
    "owner": "Prekzursil",
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#C-M01 micro-triage-2seat",
      "protocol P16 grand-jury-threshold",
      "protocol P53 escalation-ladder"
    ]
  }
}
