    "anonymity": {
      "mode": "double_blind"
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "disclose_only"
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 2,
    "required_artifacts": [
      "benchmark_baseline"
    ]
  },
  "topology": {
    "kind": "delphi",
    "chair": "facilitator"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "delphi_round",
        "stage_id": "round-1",
        "independent": true,
        "anonymous": true
      },
      {
        "kind": "delphi_round",
        "stage_id": "round-2",
        "anonymous": true
      },
      {
        "kind": "delphi_round",
        "stage_id": "round-3",
        "anonymous": true
      },
      {
        "kind": "synthesis",
        "stage_id": "median-and-spread",
        "participants": [
          "facilitator"
        ]
      }
    ],
    "speaking_order": "simultaneous",
    "rounds": {
      "min": 3,
      "max": 5
    },
    "turn": {
      "max_words": 350
    },
    "obligations": {
      "declare_confidence": true,
      "must_cite_evidence": true,
      "forced_dissent": true
    },
    "critique_intensity": "standard"
  },
  "budgets": {
    "effort": "high",
    "time_minutes": 30,
    "turns": 21,
    "tool_calls": 60
  },
  "targets": {
    "evidence_items": 10
  },
  "voting": {
    "method": "score",
    "score_scale": {
      "min": 0,
      "max": 100
    },
    "quorum": {
      "min_voters": 4,
      "min_fraction": 0.6,
      "on_failure": "extend_rounds"
    },
    "belief_aggregation": {
      "method": "median",
      "require_confidence_per_vote": true,
      "calibration_source": "prior council calibration reports"
    },
    "abstention": {
      "allowed": false,
      "counts_toward_quorum": false
    },
    "tie_break": "extend_rounds"
  },
  "consensus": {
    "measure": "confidence_overlap",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": false,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "rounds_elapsed >= 3 AND independent_positions >= 5",
    "expression": {
      "all_of": [
        {
          "metric": "rounds_elapsed",
          "op": ">=",
          "value": 3
        },
        {
          "metric": "independent_positions",
          "op": ">=",
          "value": 5
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 5
    },
    "hard_caps": {
      "max_rounds": 5,
      "max_minutes": 30,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "dissent",
      "no_decision",
      "conditional_decision",
      "minority_report"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "vote_oscillation_rounds": 3
    },
    "resolution": [
      "forced_dissent",
      "recruit_independent_critic",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    }
  },
  "anti_failure": {
    "controls": [
      "premature_convergence",
      "echo_chamber",
      "lost_dissent",
      "minority_suppression",
      "strategic_voting",
      "prompt_injection"
    ],
    "fast_unanimity_response": [
      "forced_dissent",
      "blind_re_evaluation"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "votes_by_round",
      "confidence_trajectory",
      "dissent_minority_report",
      "calibration_report",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "pii_policy": "redact",
      "retain_days": 90
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "Anonymous Delphi estimate (5 experts, 3 rounds)",
    "owner": "Prekzursil",
    "lineage": [
      "C-S23 delphi-5-anon-3rounds",
      "P20 delphi-anonymous-rounds"
    ],
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:1471-1484"
    ],
    "notes": "DESIGN LINEAGE: C-S23 delphi-5-anon-3rounds in 12-COUNCIL-PROTOCOLS-AND-PRESETS.md (seats: 5; roles: domain_expert_x5,facilitator).\nPRESET LABEL: custom - forecasting_council is the adjacent required archetype but its natural card is C-D36 deep-prediction-tournament-12 (design index 36, a different lane). Labelling this one forecasting_council would collide.\nOUTCOME MAPPING (card vocabulary -> schema outcomes.allowed): CONSENSUS->decision, MAJORITY_WITH_DISSENT->dissent, INSUFFICIENT_EVIDENCE->no_decision, CONDITIONAL_DECISION->conditional_decision, DEFER->no_decision, MINORITY_REPORT->minority_report.\nEDITABLE DIALS (pointer -> what it changes):\n  - $.protocol.rounds + $.stopping.expression rounds_elapsed : rounds dial (3 is the card default)\n  - $.participants.anonymity.mode : anonymity_level dial: none|pseudonymous|blind_to_peers|double_blind\n  - $.voting.belief_aggregation.method : median (card) vs trimmed_mean vs linear_pool\n  - $.voting.score_scale : the estimate scale - change to the unit you are estimating in\nconsensus.minority_report is REQUIRED, so outcomes.allowed must contain minority_report or SEM-009 fails. It is present via MAJORITY_WITH_DISSENT->dissent plus an explicit minority_report entry appended by the builder.\nEVERY field in this file is a dial; the ones above are the ones the owner is expected to change first. See README.md in this directory for the full table."
  }
}
