{
  "schema_version": "1.0.0",
  "council_id": "c-s23-delphi-5-anon-3rounds",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Produce an estimate as a median with a reported spread, over three anonymous Delphi rounds.",
    "charter": "Anonymous Delphi. Between rounds the facilitator returns the OUTLIER RATIONALES, not just the spread - returning only the spread is what manufactures false convergence.",
    "risk_tier": "moderate",
    "desired_output": "forecast",
    "success_criteria": [
      "three rounds ran",
      "the final spread is reported alongside the median, never suppressed",
      "each round returned the outlier RATIONALES to the panel, not just the numbers"
    ],
    "consensus_intent": "elicit_distribution",
    "confidence_target": 0.7,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "any",
      "min_independent_sources": 1
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "expertise_ranked",
        "model_diverse"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 6,
      "min": 6,
      "max": 6
    },
    "diversity": {
      "min_distinct_vendors": 3,
      "min_distinct_expertise": 5
    },
