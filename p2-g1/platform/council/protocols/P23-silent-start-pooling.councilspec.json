{
  "schema_version": "1.0.0",
  "council_id": "p23-silent-start-pooling",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Preserve independence by having every seat write a full brief with zero sibling visibility, pool them simultaneously, and only then open discussion.",
    "charter": "ANONYMOUS family. The frozen pre-discussion brief set IS the artifact: it is the independence baseline against which the movement caused by discussion is measured. Discussion may not begin until the baseline hashes exist.",
    "risk_tier": "high",
    "desired_output": "recommendation",
    "success_criteria": [
      "baseline hashes exist for all six briefs before any discussion turn is dispatched",
      "no seat read another seat's brief before pooling",
      "the report quantifies how far discussion moved each seat from its baseline"
    ],
    "consensus_intent": "seek_consensus",
    "confidence_target": 0.85,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 2,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": false,
      "deadline_minutes": 150
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "expertise_ranked"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 6,
      "min": 6,
      "max": 6
    },
    "diversity": {
      "min_distinct_vendors": 3,
      "min_distinct_expertise": 6
    },
    "roster": [
      {
        "participant_id": "brief-1",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "architecture"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0,
        "context": {
          "partition_id": "isolated-brief-1"
        },
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      },
      {
        "participant_id": "brief-2",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "implementation"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0,
        "context": {
          "partition_id": "isolated-brief-2"
        },
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      },
      {
        "participant_id": "brief-3",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "measurement",
          "statistics"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0,
        "context": {
          "partition_id": "isolated-brief-3"
        },
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      },
      {
        "participant_id": "brief-4",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "security"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0,
        "context": {
          "partition_id": "isolated-brief-4"
        },
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      },
      {
        "participant_id": "brief-5",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "operations",
          "rollback"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0,
        "context": {
          "partition_id": "isolated-brief-5"
        },
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      },
      {
        "participant_id": "brief-6",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "owner intent",
          "scope"
        ],
        "role": "domain_expert",
        "authority": "voter",
        "vote_weight": 1.0,
        "context": {
          "partition_id": "isolated-brief-6"
        },
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      }
    ],
    "anonymity": {
      "mode": "blind_to_peers",
      "reveal_after_round": 1
    },
    "information_partition": {
      "enabled": true,
      "strategy": "staged_release",
      "partitions": [
        {
          "partition_id": "isolated-brief-1",
          "visible_to": [
            "brief-1"
          ],
          "sources": [
            "the question",
            "the shared evidence pack"
          ]
        },
        {
          "partition_id": "isolated-brief-2",
          "visible_to": [
            "brief-2"
          ],
          "sources": [
            "the question",
            "the shared evidence pack"
          ]
        },
        {
          "partition_id": "isolated-brief-3",
          "visible_to": [
            "brief-3"
          ],
          "sources": [
            "the question",
            "the shared evidence pack"
          ]
        },
        {
          "partition_id": "isolated-brief-4",
          "visible_to": [
            "brief-4"
          ],
          "sources": [
            "the question",
            "the shared evidence pack"
          ]
        },
        {
          "partition_id": "isolated-brief-5",
          "visible_to": [
            "brief-5"
          ],
          "sources": [
            "the question",
            "the shared evidence pack"
          ]
        },
        {
          "partition_id": "isolated-brief-6",
          "visible_to": [
            "brief-6"
          ],
          "sources": [
            "the question",
            "the shared evidence pack"
          ]
        }
      ]
    },
    "duplicate_detection": {
      "enabled": true,
      "dimensions": [
        "position_similarity",
        "prompt"
      ],
      "max_similarity": 0.85
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "recuse_from_vote"
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 3,
    "prep_time_minutes": 40,
    "required_artifacts": [
      "position_memo",
      "evidence_pack",
      "risk_list"
    ]
  },
  "topology": {
    "kind": "flat"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "blind_independent_first_pass",
        "stage_id": "silent-briefs",
        "independent": true,
        "rounds": 1,
        "quotas": {
          "objections_per_participant": 2
        }
      },
      {
        "kind": "custom",
        "custom_name": "freeze_and_hash_independence_baseline",
        "stage_id": "freeze-baseline",
        "rounds": 1,
        "exit_when": {
          "metric": "custom:baseline_hashes_present",
          "op": "==",
          "value": true,
          "value_type": "boolean",
          "producer": "baseline_hash_manifest",
          "note": "no discussion turn may be dispatched until every brief is hashed and archived"
        }
      },
      {
        "kind": "round_robin",
        "stage_id": "pooled-discussion",
        "rounds": 3,
        "quotas": {
          "objections_per_participant": 3,
          "counterexamples_per_round": 1
        }
      },
      {
        "kind": "custom",
        "custom_name": "measure_movement_against_baseline",
        "stage_id": "movement-report",
        "rounds": 1,
        "exit_when": {
          "metric": "custom:seats_with_measured_movement",
          "op": ">=",
          "value": 6,
          "value_type": "number",
          "producer": "baseline_movement_differ",
          "note": "the counterfactual is only usable if every seat's drift from its own baseline is measured"
        }
      },
      {
        "kind": "synthesis",
        "stage_id": "pooled-recommendation",
        "rounds": 1
      }
    ],
    "speaking_order": "random",
    "rounds": {
      "min": 3,
      "max": 6,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 600
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "cross_examination": true,
      "rebuttal_required": true,
      "steelman_before_rebuttal": true,
      "declare_confidence": true,
      "declare_conflicts": true,
      "forced_dissent": false
    },
    "critique_intensity": "adversarial",
    "experiments": {
      "allowed": true,
      "max_experiments": 3,
      "runner": "ci"
    }
  },
  "budgets": {
    "effort": "high",
    "time_minutes": 150,
    "tool_calls": 180,
    "sources": 30,
    "turns": 36,
    "speaking_quota_per_participant": 6,
    "min_engagement_turns": 3,
    "max_inactivity_rounds": 2,
    "rebuttal_depth": 2
  },
  "targets": {
    "objections": 8,
    "counterexamples": 3,
    "evidence_items": 20,
    "coverage_score": 0.9,
    "novelty_ratio": 0.5,
    "diversity_index": 0.6,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.85,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "supermajority",
    "supermajority_threshold": 0.75,
    "quorum": {
      "min_voters": 5,
      "on_failure": "extend_rounds"
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true,
      "strategic_abstention_check": true
    },
    "belief_aggregation": {
      "method": "calibration_weighted",
      "require_confidence_per_vote": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "extend_rounds"
  },
  "consensus": {
    "threshold": 0.75,
    "measure": "vote_share",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "independent_positions >= 6 AND all_participants_spoke == true AND (consensus >= 0.75 OR no_new_objection_rounds >= 2 OR rounds_elapsed >= 5)",
    "expression": {
      "all_of": [
        {
          "metric": "independent_positions",
          "op": ">=",
          "value": 6
        },
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true
        },
        {
          "any_of": [
            {
              "metric": "consensus",
              "op": ">=",
              "value": 0.75
            },
            {
              "metric": "no_new_objection_rounds",
              "op": ">=",
              "value": 2
            },
            {
              "metric": "rounds_elapsed",
              "op": ">=",
              "value": 5
            }
          ]
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 6,
      "every_participant_spoke": true,
      "min_evidence_items": 12,
      "min_objections_addressed": 4
    },
    "hard_caps": {
      "max_rounds": 6,
      "max_minutes": 150,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "irreducible_disagreement",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "the frozen baseline briefs are archived with their hashes",
      "the movement report names every seat whose position changed and why"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.88,
      "circular_citation_check": true
    },
    "resolution": [
      "blind_re_evaluation",
      "strongest_counterexample",
      "run_experiment",
      "narrow_scope"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": false,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "echo_chamber",
      "premature_convergence",
      "sycophancy",
      "participant_dominance",
      "silence",
      "lost_dissent",
      "moderator_capture"
    ],
    "fast_unanimity_response": [
      "blind_re_evaluation",
      "forced_dissent",
      "strongest_counterexample"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "transcript",
      "argument_graph",
      "evidence_map",
      "votes_by_round",
      "confidence_trajectory",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "P23 silent-start pooling",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:471-486"
    ],
    "notes": "The card's leak failure mode (briefs escaping via a shared scratch path) is answered by one information_partition per seat with visible_to = that seat only, plus per-seat context.partition_id and fresh_context. The independent_positions >= 6 conjunct is what makes the baseline load-bearing: the negative snapshot with 4 positions must evaluate FALSE."
  }
}
