{
  "schema_version": "1.0.0",
  "council_id": "p15-claim-by-claim-adjudication",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Adjudicate an artifact one atomic claim at a time so a document verdict is a function of claim verdicts, not a global impression.",
    "charter": "JUDICIAL family. Verdict granularity is the CLAIM. Each claim gets CONFIRMED / REFUTED / UNVERIFIED / SCOPED with its own anchor. A coverage line (claims_found vs claims_adjudicated) with a truncation flag is mandatory.",
    "risk_tier": "high",
    "desired_output": "review_verdict",
    "success_criteria": [
      "every extracted claim carries an independent verdict and its own anchor",
      "the coverage line reports claims_found and claims_adjudicated with a truncation flag",
      "a seeded overclaim is returned REFUTED while its correctly-scoped sibling is CONFIRMED"
    ],
    "consensus_intent": "adjudicate",
    "confidence_target": 0.9,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 2,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": false,
      "deadline_minutes": 180
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "expertise_ranked"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 6,
      "min": 6,
      "max": 6
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 4
    },
    "roster": [
      {
        "participant_id": "extractor-a",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "claim extraction",
          "implicit premises"
        ],
        "role": "verifier",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "independence": {
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "extractor-b",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "claim extraction",
          "scope analysis"
        ],
        "role": "verifier",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "independence": {
          "sees_peers_before_first_position": false
        }
      },
      {
        "participant_id": "adjudicator-1",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "evidence grading",
          "overclaim detection"
        ],
        "role": "juror",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "adjudicator-2",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "evidence grading",
          "reproduction"
        ],
        "role": "juror",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "adjudicator-3",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "measurement validity",
          "statistics"
        ],
        "role": "juror",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "coverage-clerk",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "coverage accounting",
          "truncation flags"
        ],
        "role": "scribe",
        "authority": "observer",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      }
    ],
    "duplicate_detection": {
      "enabled": true,
      "dimensions": [
        "prompt",
        "position_similarity"
      ],
      "max_similarity": 0.8
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "recuse_from_vote"
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 2,
    "required_artifacts": [
      "evidence_pack",
      "prior_art_scan"
    ]
  },
  "topology": {
    "kind": "committee",
    "committees": [
      {
        "committee_id": "extraction",
        "mandate": "enumerate atomic claims, including implicit ones, and emit the coverage line",
        "members": [
          "extractor-a",
          "extractor-b",
          "coverage-clerk"
        ]
      },
      {
        "committee_id": "adjudication",
        "mandate": "one independent verdict per claim, each with its own anchor",
        "members": [
          "adjudicator-1",
          "adjudicator-2",
          "adjudicator-3"
        ]
      }
    ]
  },
  "protocol": {
    "sequence": [
      {
        "kind": "blind_independent_first_pass",
        "stage_id": "claim-extraction",
        "independent": true,
        "rounds": 1,
        "participants": [
          "extractor-a",
          "extractor-b"
        ]
      },
      {
        "kind": "custom",
        "custom_name": "coverage_line_and_truncation_flag",
        "stage_id": "coverage-line",
        "rounds": 1,
        "participants": [
          "coverage-clerk"
        ],
        "exit_when": {
          "metric": "custom:claims_unadjudicated",
          "op": "==",
          "value": 0,
          "value_type": "number",
          "producer": "claim_coverage_line",
          "note": "claims_found minus claims_adjudicated must be zero, or the truncation flag is set and the artifact verdict is PARTIAL"
        }
      },
      {
        "kind": "jury",
        "stage_id": "per-claim-verdicts",
        "rounds": 2,
        "participants": [
          "adjudicator-1",
          "adjudicator-2",
          "adjudicator-3"
        ],
        "quotas": {
          "objections_per_participant": 5,
          "counterexamples_per_round": 2
        }
      },
      {
        "kind": "cross_examination",
        "stage_id": "contested-claims",
        "rounds": 2,
        "quotas": {
          "counterexamples_per_round": 2
        }
      },
      {
        "kind": "synthesis",
        "stage_id": "document-verdict",
        "rounds": 1
      }
    ],
    "speaking_order": "round_robin",
    "rounds": {
      "min": 3,
      "max": 10,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 500
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "cross_examination": true,
      "rebuttal_required": true,
      "steelman_before_rebuttal": true,
      "declare_confidence": true,
      "declare_conflicts": true,
      "forced_dissent": false
    },
    "critique_intensity": "adversarial",
    "experiments": {
      "allowed": true,
      "max_experiments": 5,
      "runner": "ci"
    }
  },
  "budgets": {
    "effort": "xhigh",
    "time_minutes": 180,
    "tool_calls": 300,
    "sources": 40,
    "turns": 50,
    "speaking_quota_per_participant": 12,
    "min_engagement_turns": 3,
    "max_inactivity_rounds": 2,
    "rebuttal_depth": 2
  },
  "targets": {
    "objections": 10,
    "counterexamples": 5,
    "evidence_items": 40,
    "coverage_score": 0.95,
    "novelty_ratio": 0.4,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.9,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "juror",
    "quorum": {
      "min_voters": 3,
      "on_failure": "recruit"
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true,
      "strategic_abstention_check": true
    },
    "belief_aggregation": {
      "method": "median",
      "require_confidence_per_vote": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "no_decision"
  },
  "consensus": {
    "threshold": 0.9,
    "measure": "pairwise_agreement",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "coverage_score >= 0.95 AND objections_open == 0 AND (evidence_items >= 40 OR evidence_saturation == true)",
    "expression": {
      "all_of": [
        {
          "metric": "coverage_score",
          "op": ">=",
          "value": 0.95
        },
        {
          "metric": "objections_open",
          "op": "==",
          "value": 0
        },
        {
          "any_of": [
            {
              "metric": "evidence_items",
              "op": ">=",
              "value": 40
            },
            {
              "metric": "evidence_saturation",
              "op": "==",
              "value": true
            }
          ]
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 2,
      "every_participant_spoke": true,
      "min_evidence_items": 20,
      "min_objections_addressed": 5
    },
    "hard_caps": {
      "max_rounds": 10,
      "max_minutes": 180,
      "on_cap": "conditional_decision"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "irreducible_disagreement",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "the coverage line is published with its truncation flag",
      "every UNVERIFIED claim names the experiment that would settle it",
      "every REFUTED overclaim is accompanied by its correctly-scoped rewrite"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.9,
      "circular_citation_check": true
    },
    "resolution": [
      "run_experiment",
      "split_question",
      "strongest_counterexample",
      "declare_no_decision"
    ],
    "escalation": {
      "after_attempts": 3,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": false,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "weak_synthesis",
      "premature_convergence",
      "evidence_free_majority",
      "idea_count_gaming",
      "lost_dissent",
      "circular_citation",
      "sycophancy"
    ],
    "fast_unanimity_response": [
      "blind_re_evaluation",
      "strongest_counterexample",
      "recruit_independent_critic"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "transcript",
      "claim_evidence_contradiction_graph",
      "evidence_map",
      "argument_ledger",
      "votes_by_round",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 90,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "P15 claim-by-claim adjudication",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:340-355"
    ],
    "notes": "idea_count_gaming is declared here for the INVERSE of brainstorming: splitting one claim into trivial variants to inflate the adjudicated count. dedup.trivial_variant_policy=merge plus targets.coverage_score is the mechanical guard. The seeded-overclaim adoption proof needs a live executor and is NOT-CHECKED by this unit."
  }
}
