{
  "schema_version": "1.0.0",
  "council_id": "p09-dialectical-inquiry",
  "participation": "agent_only",
  "objective": {
    "statement": "Approve or reject a plan by exposing the assumptions that make it look right, and by building a rival plan out of their negations.",
    "charter": "Dialectical inquiry (Mason / Mitroff strategic assumption surfacing). Thesis seats state the plan plus its assumption ledger; antithesis seats build a counterplan from the negation of each load-bearing assumption; a synthesis seat reconciles or declares irreducible conflict.",
    "risk_tier": "high",
    "desired_output": "plan",
    "success_criteria": [
      "every load-bearing assumption is listed with a confidence band",
      "the counterplan passes the same feasibility lint as the thesis",
      "the synthesis names what was reconciled and what was not"
    ],
    "consensus_intent": "surface_disagreement",
    "confidence_target": 0.8,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 3,
      "evidence_outranks_votes": true
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "adversarial"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 6,
      "min": 6,
      "max": 6
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 5
    },
    "roster": [
      {
        "participant_id": "thesis-lead",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "the plan under review"
        ],
        "role": "proposer",
        "authority": "contributor",
        "independence": {
          "fresh_context": false,
          "shares_context_with": [
            "thesis-analyst"
          ]
        }
      },
      {
        "participant_id": "thesis-analyst",
        "model": "gemini-3-pro",
        "vendor": "google",
        "expertise": [
          "delivery sequencing"
        ],
        "role": "domain_expert",
        "authority": "contributor"
      },
      {
        "participant_id": "assumption-auditor",
        "display_name": "Assumption auditor (builds the ledger, grades confidence)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "assumption ledgers",
          "confidence calibration"
        ],
        "role": "verifier",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "antithesis-lead",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "counterplanning"
        ],
        "role": "devils_advocate",
        "authority": "contributor",
        "independence": {
          "fresh_context": true,
          "shares_context_with": []
        }
      },
      {
        "participant_id": "antithesis-analyst",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "feasibility and cost"
        ],
        "role": "critic",
        "authority": "contributor",
        "independence": {
          "fresh_context": true,
          "shares_context_with": []
        }
      },
      {
        "participant_id": "synthesizer",
        "display_name": "Synthesizer (reconciles or declares irreducible conflict)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "synthesis",
          "argument mapping"
        ],
        "role": "synthesizer",
        "authority": "judge",
        "vote_weight": 1.0,
        "rights": {
          "may_speak": true,
          "may_vote": true
        }
      }
    ],
    "replacement": {
      "enabled": true,
      "triggers": [
        "role_collapse",
        "inactivity"
      ]
    }
  },
  "preparation": {
    "research_required": true,
    "independent_prep": true,
    "min_sources": 3,
    "required_artifacts": [
      "position_memo",
      "risk_list",
      "prior_art_scan"
    ]
  },
  "topology": {
    "kind": "caucus",
    "caucuses": [
      {
        "caucus_id": "thesis",
        "members": [
          "thesis-lead",
          "thesis-analyst"
        ],
        "private_rounds": 1
      },
      {
        "caucus_id": "antithesis",
        "members": [
          "antithesis-lead",
          "antithesis-analyst"
        ],
        "private_rounds": 2
      }
    ]
  },
  "protocol": {
    "sequence": [
      {
        "kind": "custom",
        "stage_id": "assumption-ledger",
        "custom_name": "load_bearing_assumption_ledger",
        "participants": [
          "thesis-lead",
          "thesis-analyst",
          "assumption-auditor"
        ],
        "quotas": {
          "ideas_per_participant": 4
        }
      },
      {
        "kind": "custom",
        "stage_id": "counterplan",
        "custom_name": "counterplan_from_assumption_negations",
        "rounds": 2,
        "participants": [
          "antithesis-lead",
          "antithesis-analyst"
        ],
        "quotas": {
          "novel_ideas_per_round": 2,
          "counterexamples_per_round": 2
        },
        "exit_when": {
          "metric": "custom:counterplan_feasibility_lint",
          "op": "==",
          "value": "PASS",
          "value_type": "string",
          "producer": "assumption-auditor feasibility lint"
        }
      },
      {
        "kind": "cross_examination",
        "stage_id": "thesis-vs-antithesis",
        "rounds": 2,
        "quotas": {
          "objections_per_participant": 3
        }
      },
      {
        "kind": "steelman_before_rebuttal",
        "stage_id": "steelman",
        "rounds": 1
      },
      {
        "kind": "synthesis",
        "stage_id": "synthesis",
        "participants": [
          "synthesizer"
        ]
      }
    ],
    "speaking_order": "chair_directed",
    "rounds": {
      "min": 3,
      "max": 8,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 800
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "steelman_before_rebuttal": true,
      "forced_dissent": true,
      "cross_examination": true,
      "rebuttal_required": true,
      "declare_confidence": true,
      "declare_conflicts": true
    },
    "critique_intensity": "adversarial",
    "experiments": {
      "allowed": true,
      "max_experiments": 4,
      "runner": "ci"
    }
  },
  "budgets": {
    "effort": "xhigh",
    "time_minutes": 210,
    "tool_calls": 260,
    "sources": 35,
    "experiments": 4,
    "turns": 48,
    "max_inactivity_rounds": 1,
    "rebuttal_depth": 3
  },
  "targets": {
    "unique_ideas": 16,
    "novelty_ratio": 0.55,
    "coverage_score": 0.85,
    "objections": 10,
    "counterexamples": 5,
    "evidence_items": 24,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.82,
      "trivial_variant_policy": "reject"
    }
  },
  "voting": {
    "method": "synthesis_only",
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": false,
      "must_justify": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "tie_break": "judge"
  },
  "consensus": {
    "threshold": 0.8,
    "measure": "agreement_index",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true,
      "min_dissenters_to_block": 1
    },
    "irreducible_disagreement_allowed": true,
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "expression": {
      "any_of": [
        {
          "all_of": [
            {
              "metric": "custom:load_bearing_assumptions_negated",
              "op": ">=",
              "value": 3,
              "value_type": "number",
              "producer": "assumption-auditor ledger"
            },
            {
              "metric": "custom:counterplan_feasibility_lint",
              "op": "==",
              "value": "PASS",
              "value_type": "string",
              "producer": "assumption-auditor feasibility lint"
            },
            {
              "metric": "every_objection_addressed",
              "op": "==",
              "value": true
            },
            {
              "metric": "consensus",
              "op": ">=",
              "value": 0.8
            }
          ]
        },
        {
          "all_of": [
            {
              "metric": "deadlock_detected",
              "op": "==",
              "value": true
            },
            {
              "metric": "minority_report_present",
              "op": "==",
              "value": true
            }
          ]
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 3,
      "min_independent_positions": 4,
      "min_evidence_items": 16,
      "min_objections_addressed": 6
    },
    "hard_caps": {
      "max_rounds": 8,
      "max_minutes": 210,
      "on_cap": "escalate_to_owner"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "irreducible_disagreement",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "each negated assumption that survived is re-checked before the plan's second phase"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.88,
      "circular_citation_check": true
    },
    "resolution": [
      "run_experiment",
      "strongest_counterexample",
      "split_question",
      "judge_ruling",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "premature_convergence",
      "role_collapse",
      "echo_chamber",
      "weak_synthesis",
      "sycophancy"
    ],
    "fast_unanimity_response": [
      "forced_dissent",
      "strongest_counterexample",
      "blind_re_evaluation"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true,
      "quarantine_untrusted_sources": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "transcript",
      "argument_graph",
      "claim_evidence_contradiction_graph",
      "option_cards",
      "votes_by_round",
      "dissent_minority_report",
      "unresolved_unknowns",
      "final_recommendation",
      "action_plan",
      "decision_lineage"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "retain_days": 120,
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true,
      "owner_approval_for": [
        "merge",
        "release"
      ]
    },
    "persistence": {
      "store": "both",
      "checkpoint_every_round": true
    },
    "calibration": {
      "post_run": true,
      "score": "brier"
    }
  },
  "metadata": {
    "title": "P09 dialectical inquiry",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:234",
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:247"
    ],
    "lineage": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md#P09",
      "AGENTS.md 1b assumption ledger"
    ],
    "notes": "ADVERSARIAL. Attacks the assumption SET, not the conclusion - that is what separates it from a key-assumptions check, which never builds a rival plan. The counterplan cannot be a strawman: the stage will not exit until it passes the same feasibility lint as the thesis.\n\nanti-failure controls, each mapped to the field implementing it:\n  premature_convergence -> the antithesis caucus must build a counterplan from the NEGATION of each load-bearing assumption before synthesis opens; stopping requires custom:load_bearing_assumptions_negated >= 3\n  role_collapse -> the card's failure mode is a strawman counterplan, so the counterplan stage's exit_when demands custom:counterplan_feasibility_lint == PASS - the counterplan must be fundable under the same budget as the thesis\n  echo_chamber -> topology.caucuses give thesis and antithesis private rounds and independence.shares_context_with=[] keeps the two chains from merging early\n  weak_synthesis -> voting.method=synthesis_only with a dedicated synthesizer seat, and outcomes.allowed includes irreducible_disagreement so a forced reconciliation is not the only way to close\n  sycophancy -> protocol.obligations.forced_dissent + critique_intensity=adversarial + consensus.fast_unanimity_is_suspicious"
  }
}
