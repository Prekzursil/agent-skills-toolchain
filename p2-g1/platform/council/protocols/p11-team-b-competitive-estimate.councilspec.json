{
  "schema_version": "1.0.0",
  "council_id": "p11-team-b-competitive-estimate",
  "participation": "hybrid",
  "objective": {
    "statement": "Test whether a load-bearing analytic claim survives full independent re-derivation, by having a second team answer the same question from the same raw sources without ever seeing the first team's product.",
    "charter": "Team A / Team B competitive estimate (US IC, 1976). Two isolated cells, one pinned source set, byte-identical conclusion-free briefs; the two products are compared only after both are final and the divergences are adjudicated.",
    "risk_tier": "critical",
    "desired_output": "forecast",
    "success_criteria": [
      "both briefs hash identically and contain no conclusion",
      "no Team A output token appears in Team B's brief or context",
      "every divergence between the two estimates is adjudicated on the record"
    ],
    "consensus_intent": "adjudicate",
    "confidence_target": 0.9,
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "file_line",
      "min_independent_sources": 3,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": true,
      "deadline_minutes": 480
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "vendor_diverse"
      ],
      "explain_choices": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 5,
      "min": 5,
      "max": 5
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 4
    },
    "roster": [
      {
        "participant_id": "adjudication-chair",
        "display_name": "Adjudication chair (sees both products, only after both are final)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "analytic tradecraft",
          "divergence adjudication"
        ],
        "role": "judge",
        "authority": "judge",
        "vote_weight": 1.0
      },
      {
        "participant_id": "brief-clerk",
        "display_name": "Brief clerk (hashes both briefs, scans for leakage)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "hashing",
          "leak detection"
        ],
        "role": "verifier",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      },
      {
        "participant_id": "divergence-analyst",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "comparative analysis"
        ],
        "role": "statistician",
        "authority": "voter",
        "vote_weight": 1.0
      },
      {
        "participant_id": "team-a-lead",
        "display_name": "Team A lead (reports A's product; does not see B's)",
        "model": "opus-5",
        "vendor": "anthropic",
        "expertise": [
          "analytic tradecraft"
        ],
        "role": "proposer",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": false
        },
        "independence": {
          "fresh_context": true,
          "shares_context_with": []
        }
      },
      {
        "participant_id": "team-b-lead",
        "display_name": "Team B lead (reports B's product; does not see A's)",
        "model": "gpt-5-codex",
        "vendor": "openai",
        "expertise": [
          "analytic tradecraft"
        ],
        "role": "proposer",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
