  "protocol": {
    "sequence": [
      {
        "kind": "custom",
        "stage_id": "admission",
        "custom_name": "prior-conditions-admission-gate",
        "rounds": 1,
        "participants": [
          "conditions-registrar",
          "board-chair"
        ],
        "exit_when": {
          "all_of": [
            {
              "metric": "custom:open_conditions_from_prior_review",
              "op": "==",
              "value": 0,
              "value_type": "number",
              "producer": "conditions_register",
              "note": "Card proof gate: open-condition count must GATE the next submission - tested with a deliberately unclosed condition."
            },
            {
              "metric": "custom:conditions_without_owner",
              "op": "==",
              "value": 0,
              "value_type": "number",
              "producer": "conditions_register",
              "note": "Card failure mode: conditions are issued and never closed."
            },
            {
              "metric": "custom:conditions_without_closure_test",
              "op": "==",
              "value": 0,
              "value_type": "number",
              "producer": "conditions_register"
            }
          ]
        }
      },
      {
        "kind": "fishbowl",
        "stage_id": "subcouncil-readout"
      },
      {
        "kind": "cross_examination",
        "stage_id": "board-questions",
        "rounds": 2,
        "quotas": {
          "objections_per_participant": 2
        }
      },
      {
        "kind": "synthesis",
        "stage_id": "board-verdict"
      }
    ],
    "speaking_order": "seniority",
    "rounds": {
      "min": 2,
      "max": 5
    },
    "obligations": {
      "must_respond_to_prior": true,
      "must_cite_evidence": true,
      "cross_examination": true,
      "rebuttal_required": true,
      "declare_confidence": true,
      "declare_conflicts": true,
      "forced_dissent": true
    },
    "critique_intensity": "adversarial",
    "experiments": {
      "allowed": true,
      "required_before_decision": false,
      "max_experiments": 3,
      "runner": "ci"
    }
  },
  "budgets": {
    "effort": "high",
    "time_minutes": 90,
    "turns": 30,
    "speaking_quota_per_participant": 7,
    "min_engagement_turns": 2,
    "max_inactivity_rounds": 2
  },
  "targets": {
    "evidence_items": 6,
    "objections": 8,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.85,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "supermajority",
    "supermajority_threshold": 0.6,
    "quorum": {
      "min_voters": 3,
      "min_fraction": 0.75,
      "on_failure": "extend_rounds"
    },
    "delegation": {
      "allowed": true,
      "max_chain_length": 2,
      "cycles_forbidden": true,
      "map": {
        "cost-chair": "sre-chair"
      }
    },
    "veto": {
      "holders": [
        "security-chair"
      ],
      "scope": "safety_only",
      "must_justify": true,
      "overridable_by_owner": true
    },
    "evidence_gate": {
      "votes_require_evidence": true,
      "evidence_outranks_majority": true,
      "reject_evidence_free_majority": true
    },
    "abstention": {
      "allowed": true,
      "counts_toward_quorum": true,
      "must_justify": true,
      "strategic_abstention_check": true
    },
    "tie_break": "chair"
  },
  "consensus": {
    "threshold": 0.6,
    "measure": "vote_share",
    "minority_report": "required",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "min_dissenters_to_block": 1,
      "suppression_check": true
    },
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "quorum_met == true AND consensus >= 0.6 AND objections_open == 0 AND subcouncils_complete >= 3",
    "expression": {
      "all_of": [
        {
          "metric": "quorum_met",
          "op": "==",
          "value": true
        },
        {
          "metric": "consensus",
          "op": ">=",
          "value": 0.6
        },
        {
          "metric": "objections_open",
          "op": "==",
          "value": 0
        },
        {
          "metric": "subcouncils_complete",
          "op": ">=",
          "value": 3
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 2,
      "min_independent_positions": 3,
      "min_objections_addressed": 3,
      "every_participant_spoke": true
    },
    "hard_caps": {
      "max_rounds": 5,
      "max_minutes": 90,
      "on_cap": "escalate_to_owner"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "no_decision",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "every issued condition has an owner and a closure test",
      "the conditions register shows zero open conditions before the next submission"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "vote_oscillation_rounds": 2
    },
    "resolution": [
      "chair_ruling",
      "narrow_scope",
      "split_question",
      "recruit_independent_critic",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    },
    "owner_intervention": {
      "allowed": true,
      "may_override_vote": true,
      "must_be_logged": true
    }
  },
  "anti_failure": {
    "controls": [
      "moderator_capture",
      "sycophancy",
      "participant_dominance",
      "instant_unanimity",
      "strategic_voting",
      "strategic_abstention",
      "evidence_free_majority",
      "lost_dissent",
      "role_collapse",
      "hidden_conflict_of_interest",
      "minority_suppression"
    ],
    "fast_unanimity_response": [
      "forced_dissent",
      "role_rotation",
      "recruit_independent_critic"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true,
      "strip_instructions_from_participant_output": true
    }
  },
  "outputs": {
    "required": [
      "transcript",
      "option_cards",
      "evidence_map",
      "votes_by_round",
      "dissent_minority_report",
      "action_plan",
      "final_recommendation",
      "decision_lineage",
      "resumable_state"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "deterministic_where_possible",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
