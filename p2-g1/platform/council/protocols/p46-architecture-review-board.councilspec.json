{
  "schema_version": "1.0.0",
  "council_id": "p46-architecture-review-board",
  "preset": "architecture_review_board",
  "participation": "agent_only",
  "objective": {
    "statement": "A standing board reviews cross-cutting submissions and tracks its conditions to closure.",
    "charter": "Fixed seats, a submission template, and APPROVE / APPROVE-WITH-CONDITIONS / RETURN. Standing membership is the point: conditions carry ACROSS submissions, and an open condition from a prior review blocks the next one.",
    "risk_tier": "high",
    "desired_output": "go_no_go",
    "success_criteria": [
      "a verdict of APPROVE, APPROVE-WITH-CONDITIONS or RETURN",
      "every condition recorded with an owner and a closure test",
      "no submission admitted while a prior condition is open"
    ],
    "consensus_intent": "seek_consensus",
    "evidence_requirements": {
      "citation_required": true,
      "anchor_style": "any",
      "min_independent_sources": 1,
      "evidence_outranks_votes": true
    },
    "owner_constraints": {
      "approval_required": true,
      "forbidden_actions": [
        "closing a condition without its closure test"
      ]
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact",
        "stakeholder_balanced",
        "expertise_ranked"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 5
    },
    "diversity": {
      "min_distinct_vendors": 2,
      "min_distinct_expertise": 5
    },
    "roster": [
      {
        "participant_id": "board-chair",
        "role": "chair",
        "expertise": [
          "architecture governance"
        ],
        "model": "opus-5",
        "vendor": "anthropic",
        "authority": "chair",
        "rights": {
          "may_speak": true,
          "may_vote": true,
          "may_recruit": true
        }
      },
      {
        "participant_id": "security-chair",
        "role": "security_reviewer",
        "expertise": [
          "threat modelling"
        ],
        "model": "gpt-5-codex",
        "vendor": "openai",
        "authority": "veto_holder",
        "rights": {
          "may_speak": true,
          "may_vote": true,
          "may_veto": true
        }
      },
      {
        "participant_id": "cost-chair",
        "role": "custom:cost_officer",
        "expertise": [
          "run cost"
        ],
        "model": "opus-5",
        "vendor": "anthropic",
        "authority": "voter"
      },
      {
        "participant_id": "sre-chair",
        "role": "risk_officer",
        "expertise": [
          "operability"
        ],
        "model": "gemini-3-pro",
        "vendor": "google",
        "authority": "voter"
      },
      {
        "participant_id": "conditions-registrar",
        "role": "scribe",
        "expertise": [
          "conditions register"
        ],
        "model": "opus-5",
        "vendor": "anthropic",
        "authority": "contributor",
        "tools": [
          "conditions_register"
        ],
        "rights": {
          "may_speak": true,
          "may_vote": false
        }
      }
    ],
    "replacement": {
      "enabled": true,
      "triggers": [
        "inactivity",
        "conflict_of_interest",
        "dominance"
      ],
      "preserve_prior_positions": true
    },
    "conflicts_policy": {
      "disclosure_required": true,
      "on_conflict": "recuse_from_vote"
    }
  },
  "topology": {
    "kind": "council_of_councils",
    "chair": "board-chair",
    "committees": [
      {
        "committee_id": "standing-board",
        "mandate": "Standing seats that carry memory across submissions.",
        "members": [
          "board-chair",
          "security-chair",
          "cost-chair",
          "sre-chair"
        ]
      }
    ],
    "fan_in": {
      "reducer": "vote_of_chairs",
      "require_all_subcouncils_complete": true
    },
    "subcouncils": [
      {
        "schema_version": "1.0.0",
        "council_id": "p46-sub-security-review",
        "objective": {
          "statement": "Assess the submission against the estate threat model and issue conditions.",
          "risk_tier": "moderate",
          "desired_output": "recommendation",
          "success_criteria": [
            "a domain verdict with itemised conditions"
          ],
          "consensus_intent": "seek_consensus",
          "evidence_requirements": {
            "citation_required": true,
            "anchor_style": "any",
            "min_independent_sources": 1,
            "evidence_outranks_votes": true
          }
        },
        "participants": {
          "selection": {
            "mode": "exact",
            "strategies": [
              "exact",
              "expertise_ranked"
            ]
          },
          "count": {
            "mode": "exact",
            "exact_n": 2
          },
          "roster": [
            {
              "participant_id": "sec-a",
              "role": "security_reviewer",
              "expertise": [
                "threat modelling"
              ],
              "model": "opus-5",
              "vendor": "anthropic",
              "authority": "voter"
            },
            {
              "participant_id": "sec-b",
              "role": "red_team",
              "expertise": [
                "attack paths"
              ],
              "model": "gpt-5-codex",
              "vendor": "openai",
              "authority": "voter"
            }
          ]
        },
        "topology": {
          "kind": "flat"
        },
        "protocol": {
          "sequence": [
            {
              "kind": "blind_independent_first_pass",
              "stage_id": "read",
              "independent": true
            },
            {
              "kind": "round_robin",
              "stage_id": "discuss",
              "rounds": 2,
              "quotas": {
                "objections_per_participant": 2
              }
            },
            {
              "kind": "synthesis",
              "stage_id": "domain-verdict"
            }
          ],
          "speaking_order": "round_robin",
          "rounds": {
            "min": 1,
            "max": 3
          },
          "obligations": {
            "must_respond_to_prior": true,
            "must_cite_evidence": true,
            "declare_confidence": true,
            "declare_conflicts": true
          },
          "critique_intensity": "adversarial"
        },
        "voting": {
          "method": "consent_no_objection",
          "evidence_gate": {
            "votes_require_evidence": true,
            "evidence_outranks_majority": true,
            "reject_evidence_free_majority": true
          },
          "tie_break": "extend_rounds"
        },
        "consensus": {
          "threshold": 0.6,
          "measure": "vote_share",
          "minority_report": "optional",
          "dissent_policy": {
            "preserve_verbatim": true,
            "attributed": true,
            "suppression_check": true
          },
          "fast_unanimity_is_suspicious": true
        },
        "stopping": {
          "source_expression": "objections_open == 0 AND evidence_items >= 3",
          "expression": {
            "all_of": [
              {
                "metric": "objections_open",
                "op": "==",
                "value": 0
              },
              {
                "metric": "evidence_items",
                "op": ">=",
                "value": 3
              }
            ]
          },
          "minimum_deliberation": {
            "min_rounds": 1,
            "every_participant_spoke": true
          },
          "hard_caps": {
            "max_rounds": 3,
            "on_cap": "escalate_to_owner"
          }
        },
        "outcomes": {
          "allowed": [
            "decision",
            "conditional_decision",
            "no_decision",
            "dissent"
          ]
        },
        "anti_failure": {
          "controls": [
            "sycophancy",
            "instant_unanimity",
            "evidence_free_majority",
            "silence",
            "missing_expertise"
          ],
          "fast_unanimity_response": [
            "forced_dissent",
            "strongest_counterexample"
          ]
        },
        "outputs": {
          "required": [
            "independent_opening_positions",
            "argument_ledger",
            "final_recommendation"
          ]
        },
        "metadata": {
          "title": "ARB security subcouncil",
          "notes": "Domain subcouncil of the ARB; its verdict feeds the chairs' vote."
        }
      },
      {
