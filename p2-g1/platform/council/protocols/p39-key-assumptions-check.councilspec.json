{
  "schema_version": "1.0.0",
  "council_id": "p39-key-assumptions-check",
  "preset": "custom",
  "participation": "agent_only",
  "objective": {
    "statement": "Expose and rate every load-bearing assumption, and force an action on each LOW-confidence one.",
    "charter": "AGENTS.md 1b mechanised. Produces no decision - it produces a rated assumption ledger plus an escalation per LOW+load-bearing pair. A blank required field defaults to worst case.",
    "risk_tier": "moderate",
    "desired_output": "risk_register",
    "success_criteria": [
      "every load-bearing assumption listed",
      "every assumption rated high/medium/low",
      "every LOW+load-bearing assumption converted to a verification or a clarify question"
    ],
    "consensus_intent": "surface_disagreement",
    "evidence_requirements": {
      "citation_required": false,
      "anchor_style": "any",
      "min_independent_sources": 0
    }
  },
  "participants": {
    "selection": {
      "mode": "exact",
      "strategies": [
        "exact"
      ],
      "explain_choices": true,
      "owner_override_allowed": true
    },
    "count": {
      "mode": "exact",
      "exact_n": 3
    },
    "roster": [
      {
        "participant_id": "assumption-scribe",
        "role": "scribe",
        "expertise": [
          "assumption ledgers"
        ],
        "model": "opus-5",
        "vendor": "anthropic",
        "authority": "contributor",
        "rights": {
          "may_speak": true,
          "may_vote": true
        }
      },
      {
        "participant_id": "plan-owner",
        "role": "proposer",
        "expertise": [
          "the plan under review"
        ],
        "model": "opus-5",
        "vendor": "anthropic",
        "authority": "voter"
      },
      {
        "participant_id": "skeptic",
        "role": "critic",
        "expertise": [
          "falsification",
          "adverse inference"
        ],
        "model": "gpt-5-codex",
        "vendor": "openai",
        "authority": "voter",
        "independence": {
          "sees_peers_before_first_position": false,
          "fresh_context": true
        }
      }
    ],
    "anonymity": {
      "mode": "none"
    }
  },
  "topology": {
    "kind": "flat"
  },
  "protocol": {
    "sequence": [
      {
        "kind": "blind_independent_first_pass",
        "stage_id": "list",
        "independent": true,
        "quotas": {
          "ideas_per_participant": 5
        }
      },
      {
        "kind": "steelman_before_rebuttal",
        "stage_id": "steelman-each-assumption",
        "rounds": 1,
        "quotas": {
          "objections_per_participant": 2
        }
      },
      {
        "kind": "custom",
        "stage_id": "rate",
        "custom_name": "confidence-rating-pass",
        "rounds": 1,
        "exit_when": {
          "all_of": [
            {
              "metric": "custom:unrated_assumptions",
              "op": "==",
              "value": 0,
              "value_type": "number",
              "producer": "assumption_ledger.rate",
              "note": "An assumption listed but not rated is the card's first failure mode."
            },
            {
              "metric": "custom:open_low_confidence_load_bearing",
              "op": "==",
              "value": 0,
              "value_type": "number",
              "producer": "assumption_ledger.escalate",
              "note": "Card failure mode: rated without consequence. A LOW+load-bearing pair MUST trigger an action, so this must reach 0 by escalation, not by re-rating."
            }
          ]
        }
      },
      {
        "kind": "synthesis",
        "stage_id": "ledger"
      }
    ],
    "speaking_order": "lowest_confidence_first",
    "rounds": {
      "min": 1,
      "max": 3,
      "divergence_before_convergence": true
    },
    "turn": {
      "max_words": 200
    },
    "obligations": {
      "must_respond_to_prior": true,
      "declare_confidence": true,
      "forced_dissent": true,
      "steelman_before_rebuttal": true,
      "rebuttal_required": true
    },
    "critique_intensity": "standard",
    "experiments": {
      "allowed": true,
      "required_before_decision": false,
      "max_experiments": 2,
      "runner": "local"
    }
  },
  "budgets": {
    "effort": "low",
    "time_minutes": 20,
    "turns": 9,
    "speaking_quota_per_participant": 3,
    "max_inactivity_rounds": 1
  },
  "targets": {
    "unique_ideas": 10,
    "categories": 2,
    "objections": 3,
    "dedup": {
      "enabled": true,
      "max_similarity": 0.8,
      "trivial_variant_policy": "merge"
    }
  },
  "voting": {
    "method": "consent_no_objection",
    "abstention": {
      "allowed": false,
      "must_justify": true
    },
    "evidence_gate": {
      "votes_require_evidence": false,
      "evidence_outranks_majority": true
    },
    "tie_break": "extend_rounds"
  },
  "consensus": {
    "threshold": 1.0,
    "measure": "vote_share",
    "minority_report": "optional",
    "dissent_policy": {
      "preserve_verbatim": true,
      "attributed": true,
      "suppression_check": true
    },
    "fast_unanimity_is_suspicious": true
  },
  "stopping": {
    "source_expression": "all_participants_spoke == true AND objections_open == 0 AND divergence_complete == true",
    "expression": {
      "all_of": [
        {
          "metric": "all_participants_spoke",
          "op": "==",
          "value": true
        },
        {
          "metric": "objections_open",
          "op": "==",
          "value": 0
        },
        {
          "metric": "divergence_complete",
          "op": "==",
          "value": true
        }
      ]
    },
    "minimum_deliberation": {
      "min_rounds": 1,
      "min_independent_positions": 3,
      "every_participant_spoke": true
    },
    "hard_caps": {
      "max_rounds": 3,
      "max_minutes": 20,
      "on_cap": "synthesize_best_effort"
    }
  },
  "outcomes": {
    "allowed": [
      "decision",
      "conditional_decision",
      "minority_report",
      "dissent"
    ],
    "conditional_decision_requires": [
      "each escalated LOW+load-bearing assumption verified or answered"
    ]
  },
  "deadlock": {
    "detection": {
      "no_progress_rounds": 2,
      "repetition_similarity": 0.9
    },
    "resolution": [
      "forced_dissent",
      "narrow_scope",
      "escalate_to_owner"
    ],
    "escalation": {
      "after_attempts": 2,
      "to": "owner"
    }
  },
  "anti_failure": {
    "controls": [
      "silence",
      "sycophancy",
      "premature_convergence",
      "echo_chamber",
      "lost_dissent",
      "weak_synthesis",
      "instant_unanimity"
    ],
    "fast_unanimity_response": [
      "forced_dissent",
      "blind_re_evaluation"
    ],
    "injection_defense": {
      "treat_artifacts_as_data": true
    }
  },
  "outputs": {
    "required": [
      "independent_opening_positions",
      "idea_ledger",
      "unresolved_unknowns",
      "action_plan",
      "final_recommendation"
    ],
    "receipt_schema": "platform/schema/receipt.schema.json"
  },
  "audit": {
    "transcript": true,
    "replay": true,
    "resume": true,
    "determinism": "seeded",
    "privacy": {
      "redact_secrets": true,
      "redaction_policy": "deny_by_default",
      "pii_policy": "redact"
    },
    "safety": {
      "forbid_irreversible_actions": true
    },
    "persistence": {
      "store": "ledger",
      "checkpoint_every_round": true
    }
  },
  "metadata": {
    "title": "P39 key-assumptions-check",
    "spec_citations": [
      "12-COUNCIL-PROTOCOLS-AND-PRESETS.md:736-750",
      "_USER-PROMPTS.md:10927"
    ],
    "lineage": [
      "P39 key-assumptions-check",
      "IC structured analytic techniques",
      "AGENTS.md 1b assumption ledger"
    ],
    "notes": "speaking_order is lowest_confidence_first so the least certain seat is not anchored by the most certain one - the direct countermeasure to the echo-chamber/sycophancy pair on a 3-seat council. Consent (not majority) because a single unresolved assumption should block. receipt_schema points at platform/schema/receipt.schema.json (the file that exists). The catalog's own output_schema for these units says command-center/schema/receipt.schema.json, which does NOT exist and has no deploy mapping. UNVERIFIED which path the runtime will load; settled by whichever unit lands the deploy mapping."
  }
}
