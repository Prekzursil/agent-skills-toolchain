{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.skills/critique-panel/persona.schema.json",
  "title": "critique-panel persona verdict",
  "type": "object",
  "required": [
    "id",
    "persona",
    "dimensions"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^critique-panel-"
    },
    "persona": {
      "enum": [
        "user-advocate",
        "systems-consistency",
        "a11y",
        "brand-aesthetic"
      ]
    },
    "audit_id": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "score",
          "confidence"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "visual-hierarchy",
              "spacing-rhythm",
              "alignment",
              "type-scale",
              "color-contrast",
              "consistency",
              "empty-error-states",
              "affordance",
              "motion"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "iLike": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "iWish": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "evidence",
                "recommendation"
              ],
              "additionalProperties": true,
              "properties": {
                "severity": {
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "info"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "whatIf": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}