    "verdict": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "UNKNOWN"
      ],
      "description": "COMPLETE iff every applicable condition is TRUE. INCOMPLETE if any applicable condition is FALSE. UNKNOWN if no applicable FALSE and at least one applicable UNKNOWN. NOT-APPLICABLE rows never decide the aggregate."
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "evaluated_from_exit_code_alone": {
      "type": "boolean",
      "description": "Must be false. Exit 0 is never a completion proof."
    },
