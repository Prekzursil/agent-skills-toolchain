{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/phase4/contracts/ARC-0087.json",
  "title": "ARC-0087 shared completion-predicate verdict",
  "description": "SUCCESS:ARC-0087. Formal contract for the shared 12-condition completion predicate: typed per-condition results, per-unit-class applicability, UNKNOWN distinct from FALSE, NOT-APPLICABLE never counted as a pass, and exit code 0 structurally incapable of COMPLETE. A unit is complete only when all applicable conditions hold:\n1. process/task reached a valid terminal state;\n2. expected artifact exists;\n3. artifact is non-empty and exceeds a meaningful minimum size;\n4. artifact parses against its schema;\n5. required sentinel is present;\n6. required evidence anchors exist;\n7. required tests ran and passed;\n8. negative controls or mutations fail as expected;\n9. independent reviewer status is PASS;\n10. no unresolved P0/P1 defect is attached;\n11. output was registered in the artifact manifest;\n12. downstream consumers can read it.\nExit code zero alone is never success. A plausible digest is not a receipt. A file path in text is not proof the file exists.",
  "$comment": "SUCCESS:ARC-0087 predicate_id=shared-completion-predicate-12 min_artifact_bytes=32. Callers MUST emit the per-condition array, never a lone boolean. applicable_pass_count counts only result=TRUE on applicable conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "predicate_id",
    "schema_id",
    "unit_id",
    "unit_class",
    "verdict",
    "exit_code",
    "evaluated_from_exit_code_alone",
    "min_artifact_bytes",
    "applicable_pass_count",
    "applicable_fail_count",
    "applicable_unknown_count",
    "not_applicable_count",
    "anti_patterns",
    "conditions"
  ],
