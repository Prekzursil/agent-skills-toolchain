{
  "$defs": {
    "artifact_envelope": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact_class": {
                "const": "contract"
              }
            },
            "required": [
              "artifact_class"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 16384,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_class": {
                "const": "dossier"
              }
            },
            "required": [
              "artifact_class"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 512,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_class": {
                "const": "manifest"
              }
            },
            "required": [
              "artifact_class"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 512,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_class": {
                "const": "markdown"
              }
            },
            "required": [
              "artifact_class"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 1024,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_class": {
                "const": "receipt"
              }
            },
            "required": [
              "artifact_class"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 1024,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifact_class": {
                "const": "schema"
              }
            },
            "required": [
              "artifact_class"
            ]
          },
          "then": {
            "properties": {
              "byte_size": {
                "minimum": 512,
                "type": "integer"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_class": {
          "enum": [
            "contract",
            "dossier",
            "manifest",
            "markdown",
            "receipt",
            "schema"
          ],
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[A-Z]{2,5}-[0-9]{4}:[A-Za-z0-9._-]{1,64}$",
          "type": "string"
        },
        "byte_size": {
          "minimum": 2,
          "type": "integer"
        },
        "content_hash": {
          "$ref": "#/$defs/content_hash"
        },
        "evidence_anchors": {
          "items": {
            "$ref": "#/$defs/evidence_anchor"
          },
          "minItems": 1,
          "type": "array"
        },
        "manifest_registration": {
          "$ref": "#/$defs/manifest_registration_record"
        },
        "path": {
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._/=+-][A-Za-z0-9._/=+-]*$",
          "type": "string"
        },
        "producing_unit": {
          "pattern": "^[A-Z]{2,5}-[0-9]{4}$",
          "type": "string"
        },
        "retention_class": {
          "enum": [
            "session",
            "unit",
            "program",
            "archival"
          ],
          "type": "string"
        },
        "schema_reference": {
          "minLength": 8,
          "type": "string"
        },
        "sentinel": {
          "minLength": 8,
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "producing_unit",
        "content_hash",
        "byte_size",
        "schema_reference",
        "sentinel",
        "evidence_anchors",
        "retention_class",
        "manifest_registration",
        "path",
        "artifact_class"
      ],
      "type": "object"
    },
    "artifact_manifest": {
      "additionalProperties": true,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/manifest_registration_record"
          },
          "type": "array"
        },
        "contract": {
          "minLength": 8,
          "type": "string"
        },
        "derivation": {
          "type": "string"
        },
        "expected": {
          "minimum": 0,
          "type": "integer"
        },
        "present": {
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "verified_on_disk": {
          "const": true
        }
      },
      "required": [
        "schema_version",
        "verified_on_disk",
        "artifacts"
      ],
      "type": "object"
    },
    "content_hash": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "sha256"
        },
        "hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "alg",
        "hex"
      ],
      "type": "object"
    },
    "evidence_anchor": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "minLength": 8,
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 3,
          "type": "string"
        },
        "snippet": {
          "minLength": 4,
          "type": "string"
        }
      },
      "required": [
        "path",
        "claim"
      ],
      "type": "object"
    },
    "manifest_registration_record": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "manifest_path": {
          "pattern": ".*ARTIFACT-MANIFEST\\.json$",
          "type": "string"
        },
        "path": {
          "minLength": 3,
          "type": "string"
        },
        "present": {
          "type": "boolean"
        },
        "producing_unit": {
          "pattern": "^[A-Z]{2,5}-[0-9]{4}$",
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^([0-9a-f]{64}|\\(self\\)|)$",
          "type": "string"
        }
      },
      "required": [
        "manifest_path",
        "path",
        "sha256",
        "bytes",
        "present",
        "producing_unit"
      ],
      "type": "object"
    }
  },
  "$id": "command-center/phase4/contracts/ARC-0084.json",
  "$ref": "#/$defs/artifact_envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "completeness_rule": "An artifact is complete only if (1) the path exists on disk, (2) CRLF-normalized byte size meets the class floor, (3) the sha256 of those bytes matches the envelope content_hash, and (4) ARTIFACT-MANIFEST.json, read from disk, contains a present=true row for that path whose sha256 matches the live digest. A path that exists but is unregistered fails. A plausible digest for an absent file fails.",
  "description": "Canonical envelope for a produced artifact: artifact id, producing unit, content hash, byte size, schema reference, sentinel, evidence anchors, retention class, and the manifest registration record. An artifact that exists on disk but is absent from the on-disk ARTIFACT-MANIFEST.json is not complete. Size floors are derived from the live distribution (never one byte). SUCCESS:ARC-0084",
  "mandated_envelope_fields": [
    "artifact_id",
    "producing_unit",
    "content_hash",
    "byte_size",
    "schema_reference",
    "sentinel",
    "evidence_anchors",
    "retention_class",
    "manifest_registration"
  ],
  "min_bytes_threshold": 16384,
  "sentinel": "SUCCESS:ARC-0084",
