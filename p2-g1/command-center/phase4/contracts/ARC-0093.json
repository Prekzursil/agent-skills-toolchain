      },
      "reversibility": {
        "status": "REVERSIBLE",
        "statement": "A migration is REVERSIBLE when every forward step has a declared inverse, no step is lossy (remove without a prior copy is irreversible unless the migration is explicitly declared IRREVERSIBLE), and canonical-json-v1(reverse(forward(doc))) equals canonical-json-v1(doc) for every TRANSFORMED record. This record's forward set/add pair inverts by remove/set and is therefore REVERSIBLE.",
        "byte_recovery_encoding": "canonical-json-v1",
        "reverse_steps": [
          {
            "op": "remove",
            "path": "format_family"
          },
          {
            "op": "set",
            "path": "schema_version",
            "value": 1
