        "would_transform": 3,
        "would_quarantine": 0,
        "would_drop": 0,
        "evidence_status": "CHECKED"
      },
      "forward_compatibility": {
        "rule": "An N+1 reader MUST either accept an N artifact because it still validates under the N+1 schema, or refuse it and require this migration record. Silent reinterpretation of N as N+1 is forbidden.",
        "n_still_validates_under_n_plus_1": false,
        "therefore": "mechanically-transformable"
      },
      "backward_compatibility": {
        "rule": "An N reader MUST refuse an N+1 artifact until the declared reverse runs. Unknown required N+1 fields must not be ignored.",
        "n_plus_1_validates_under_n": false,
        "return_path": "declared-reverse"
      },
      "transformation_obligation": {
        "rule": "An artifact written under version N must either still validate under version N+1 or be mechanically transformable to it. If neither holds, the change is not a version bump; it is a break and must not ship.",
        "this_pair": "N does not still validate under strict N+1; transform is required and executed"
      },
      "untransformable_policy": {
        "action": "QUARANTINE",
        "report": true,
        "silent_drop": false,
        "rule": "A record the transform cannot handle is copied into quarantine with original bytes and a reason, and is listed in the dry-run / apply report. It is never omitted from the accounting identity records_in == transformed + quarantined."
      },
