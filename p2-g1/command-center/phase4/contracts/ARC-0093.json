{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/phase4/contracts/ARC-0093.json",
  "title": "Contract: Migration record format and the transformation obligation",
  "description": "ARC-0093 formal contract. A Migration Record is the only object that may authorise a versioned-artifact shape change after freeze. Required fields: from_version, to_version, transform, reversibility, dry_run. REVERSIBLE means canonical-json-v1(reverse(forward(doc))) recovers doc and no step is lossy. Untransformable records are QUARANTINED and reported; silent drop is a contract violation. SUCCESS:ARC-0093",
  "unit_id": "ARC-0093",
  "state": "SUCCESS",
  "sentinel": "SUCCESS:ARC-0093",
  "completion_sentinel": "SUCCESS:ARC-0093",
  "question": "Specify the migration record: its required fields (from-version, to-version, the transform itself, the reversibility statement, the dry-run result), the forward and backward compatibility obligations a versioned artifact must meet, and the transformation obligation - an artifact written under version N must either still validate under version N+1 or be mechanically transformable to it. Define what makes a migration REVERSIBLE, and what a migration must do with a record it cannot transform.",
  "cloud_ok": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "from_version",
    "to_version",
    "transform",
    "reversibility",
    "dry_run",
    "forward_compatibility",
    "backward_compatibility",
    "transformation_obligation",
    "untransformable_policy",
    "evidence"
  ],
  "properties": {
    "from_version": {
      "type": "integer",
      "minimum": 0
    },
    "to_version": {
      "type": "integer",
      "minimum": 1
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "engine",
        "encoding",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4
        },
        "engine": {
          "type": "string",
          "minLength": 8
        },
        "encoding": {
          "type": "string",
          "const": "canonical-json-v1"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "statement",
        "byte_recovery_encoding",
        "reverse_steps"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "REVERSIBLE",
            "IRREVERSIBLE"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 64
        },
        "byte_recovery_encoding": {
          "type": "string",
          "const": "canonical-json-v1"
        },
        "reverse_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVERSIBLE"
              }
            }
          },
          "then": {
            "properties": {
              "reverse_steps": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "dry_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "records_in",
        "would_transform",
        "would_quarantine",
        "would_drop",
        "evidence_status"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "records_in": {
          "type": "integer",
          "minimum": 0
        },
        "would_transform": {
          "type": "integer",
          "minimum": 0
        },
        "would_quarantine": {
          "type": "integer",
          "minimum": 0
        },
        "would_drop": {
          "type": "integer",
          "const": 0
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "CHECKED",
            "NOT-CHECKED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executed": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "evidence_status": {
                "const": "NOT-CHECKED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "executed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "evidence_status": {
                "const": "CHECKED"
              }
            }
          }
        }
      ]
    },
    "forward_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "n_still_validates_under_n_plus_1",
        "therefore"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 32
        },
        "n_still_validates_under_n_plus_1": {
          "type": "boolean"
        },
        "therefore": {
          "type": "string",
          "enum": [
            "still-validates",
            "mechanically-transformable"
          ]
        }
      }
    },
    "backward_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "n_plus_1_validates_under_n",
        "return_path"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 32
        },
        "n_plus_1_validates_under_n": {
          "type": "boolean"
        },
        "return_path": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "transformation_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "this_pair"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 32
        },
        "this_pair": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "untransformable_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "report",
        "silent_drop",
        "rule"
      ],
      "properties": {
        "action": {
          "type": "string",
          "const": "QUARANTINE"
        },
        "report": {
          "type": "boolean",
          "const": true
        },
        "silent_drop": {
          "type": "boolean",
          "const": false
        },
        "rule": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "from_version",
          "to_version",
          "byte_recovered",
          "n_plus_1_valid_before",
          "n_plus_1_valid_after",
          "original_canonical_sha256",
          "forward_canonical_sha256",
          "recovered_canonical_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 8
          },
          "from_version": {
            "type": "integer"
          },
          "to_version": {
            "type": "integer"
          },
          "byte_recovered": {
            "type": "boolean"
          },
          "n_plus_1_valid_before": {
            "type": "boolean"
          },
          "n_plus_1_valid_after": {
            "type": "boolean"
          },
          "original_canonical_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "forward_canonical_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recovered_canonical_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "set",
            "add",
            "remove"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "value": true
      }
    }
  },
