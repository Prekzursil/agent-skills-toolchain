{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.invalid/command-center/phase4/contracts/ARC-0089.json",
  "$comment": "SUCCESS:ARC-0089. Skill contract pack. Load mode is measured from the turn-zero context bag (injected body bytes), not inferred by a frontmatter classifier. Control field is `paths`: absence means ALWAYS-ON (body injected at turn zero); presence \u2014 including paths: [\"**/*\"] \u2014 means LAZY (index card only until a matching path is touched). Deploy parity: every repo skill id must exist with identical SKILL.md sha256 in BOTH live trees (~/.claude/skills and ~/.agents/skills). Named failure class: skill exists in repo but not in a live directory. Measurement command: PYTHONDONTWRITEBYTECODE=1 python3 -B command-center/p2-wave/probes/ARC-0089/probe2_load_semantics.py",
  "title": "Skill contract: package shape, router-facing description, load mode, repo-to-live deploy parity",
  "description": "Draft 2020-12 bundle for skill packages, turn-zero load traces, and three-way deploy-parity censuses. Specify the skill contract: directory and file shape, the frontmatter and description fields the capability router consumes, path-scoping semantics, always-on versus lazily-loaded semantics and which frontmatter field controls that, and the deploy-parity requirement between the repository copy and the live skill trees. SUCCESS:ARC-0089",
  "oneOf": [
    {
      "$ref": "#/$defs/SkillPackage"
    },
    {
      "$ref": "#/$defs/TurnZeroLoadTrace"
    },
    {
      "$ref": "#/$defs/DeployParityCensus"
    }
  ],
  "$defs": {
    "SkillFrontmatter": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 16,
          "maxLength": 1024
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disable-model-invocation": {
          "type": "boolean"
        }
      }
    },
    "SkillPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "directory",
        "entrypoint",
        "package_shape",
        "frontmatter",
        "router_consumes",
        "load_mode_control_field",
        "paths_key_present",
        "load_mode",
        "body_injected_at_turn_zero",
        "deploy_parity_required"
      ],
      "properties": {
        "kind": {
          "const": "skill-package"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "entrypoint": {
          "const": "SKILL.md"
        },
        "package_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_files"
          ],
          "properties": {
            "required_files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "const": "SKILL.md"
              }
            },
            "optional_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "frontmatter": {
          "$ref": "#/$defs/SkillFrontmatter"
        },
        "router_consumes": {
          "const": [
            "name",
            "description"
          ]
        },
        "load_mode_control_field": {
          "const": "paths"
        },
        "paths_key_present": {
          "type": "boolean"
        },
        "load_mode": {
          "enum": [
            "ALWAYS-ON",
            "LAZY"
          ]
        },
        "body_injected_at_turn_zero": {
          "type": "boolean"
        },
        "deploy_parity_required": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "paths_key_present": {
                "const": true
              }
            },
            "required": [
              "paths_key_present"
            ]
          },
          "then": {
            "properties": {
              "load_mode": {
                "const": "LAZY"
              },
              "body_injected_at_turn_zero": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "paths_key_present": {
                "const": false
              }
            },
            "required": [
              "paths_key_present"
            ]
          },
          "then": {
            "properties": {
              "load_mode": {
                "const": "ALWAYS-ON"
              },
              "body_injected_at_turn_zero": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "TurnZeroLoadTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instrument",
        "measurement_command",
        "injected_ids",
        "always_on_ids",
        "lazy_ids",
        "known_always_on_named",
        "index_card_ids",
        "router_fields",
        "load_mode_control_field"
      ],
      "properties": {
        "kind": {
          "const": "turn-zero-load-trace"
        },
        "instrument": {
          "type": "string",
          "minLength": 16
        },
        "measurement_command": {
          "type": "string",
          "minLength": 16
        },
        "touched_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "injected_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "always_on_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lazy_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_always_on_named": {
          "const": true
        },
        "index_card_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "router_fields": {
          "const": [
            "name",
            "description"
          ]
        },
        "load_mode_control_field": {
          "const": "paths"
        }
      }
    },
    "HashMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "present_in",
        "sha256",
        "bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "present_in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "repo",
              "live_claude",
              "live_agents"
            ]
          }
        },
        "sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "bytes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "DifferenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_not_in_live_claude",
        "repo_not_in_live_agents",
        "live_claude_not_in_repo",
        "live_agents_not_in_repo",
        "live_claude_not_in_live_agents",
        "live_agents_not_in_live_claude",
        "hash_mismatch"
      ],
      "properties": {
        "repo_not_in_live_claude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repo_not_in_live_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "live_claude_not_in_repo": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "live_agents_not_in_repo": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "live_claude_not_in_live_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "live_agents_not_in_live_claude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hash_mismatch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HashMismatch"
          }
        }
      }
    },
    "DeployParityCensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trees",
        "ids",
        "identical",
        "difference_set",
        "parity_ok",
        "failure_class_repo_not_in_live",
        "signals"
      ],
      "properties": {
        "kind": {
          "const": "deploy-parity-census"
        },
        "trees": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "live_claude",
            "live_agents"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "live_claude": {
              "type": "string",
              "minLength": 1
            },
            "live_agents": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "live_claude",
            "live_agents",
            "union"
          ],
          "properties": {
            "repo": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "live_claude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "live_agents": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "union": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "identical": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "difference_set": {
          "$ref": "#/$defs/DifferenceSet"
        },
        "parity_ok": {
          "type": "boolean"
        },
        "failure_class_repo_not_in_live": {
          "type": "boolean"
        },
        "signals": {
          "const": [
            "sha256",
            "byte-size"
          ]
        }
      }
    }
  },
  "x-unit-id": "ARC-0089",
  "x-completion-sentinel": "SUCCESS:ARC-0089",
  "state": "SUCCESS",
  "sentinel": "SUCCESS:ARC-0089",
  "x-load-semantics": {
    "control_field": "paths",
    "absent": "ALWAYS-ON: full body injected at turn zero",
    "present": "LAZY: router index only at turn zero; body on path match",
    "demotion": "adding paths, including [\"**/*\"], demotes always-on to lazy",
    "do_not": "infer load behaviour from frontmatter without a context-bag measurement",
    "measurement_command": "PYTHONDONTWRITEBYTECODE=1 python3 -B command-center/p2-wave/probes/ARC-0089/probe2_load_semantics.py"
  },
  "x-package-shape": {
    "directory": "<skill-id>/",
    "required": [
      "SKILL.md"
    ],
    "optional": [
      "reference.md",
      "examples.md",
      "scripts/"
    ],
    "live_trees": [
      "~/.claude/skills",
      "~/.agents/skills"
    ],
    "repo_trees": [
      "skills/",
      ".claude/skills",
      ".cursor/skills"
    ]
  },
  "x-router-consumes": [
    "name",
    "description"
  ]
}
