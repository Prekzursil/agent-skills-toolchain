{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ast-integrate.local/command-center/phase4/contracts/ARC-0080.json",
  "title": "Package metadata, content boundary and exclusion contract (ARC-0080)",
  "description": "Package content-boundary contract (ARC-0080).\nSUCCESS:ARC-0080\nA package IS the allowlisted member set after mandatory exclusion, not the repository tree and not 'everything except a denylist'.\nContent boundary: selection_policy is allowlist-only. The glob '**' is forbidden; deny-by-default would collapse into shipping the tree.\nMandatory exclusions (fail-loud, never silent omit): .git, caches, logs, transcripts, credentials. A planted .git directory or canary credential in the build input is excluded from members AND the build fails rather than producing an archive.\nSize ceiling: max_total_bytes is 1..hard_ceiling_bytes. Exceeding the ceiling fails the build (on_exceed=fail). Warn is unrepresentable. Unrelated gigabyte blobs cannot be packaged.\nIntegrity digest is sha256 over sorted (path, content-sha256) pairs of packaged members only.\nBuild reproducibility: sorted members, timestamps pinned to 1980-01-01, generator_id+generator_version recorded, repeat digest must agree.\nThis document is a Draft 2020-12 JSON Schema. Used as a contract it must reject the empty object, unrelated garbage, on_exceed=warn, selection_policy=denylist, and a report missing integrity.\nConsumer call site: command-center/p2-wave/probes/ARC-0080/packer.py.\nNo ADV rebuild of ARC-0077 is required to freeze this substrate-agnostic package-boundary schema.",
  "$comment": "SUCCESS:ARC-0080 A package is the allowlisted member set after mandatory exclusion. selection_policy=allowlist; on_exceed=fail; denylist and warn are unrepresentable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "package_id",
    "package_version",
    "content_boundary",
    "mandatory_exclusions",
    "size_ceiling",
    "integrity",
    "reproducibility",
    "members",
    "failures",
    "verdict"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "ARC-0080"
    },
    "package_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_surface",
        "selection_policy",
        "allowlist_globs"
      ],
      "properties": {
        "evaluation_surface": {
          "type": "string",
          "const": "stage-walk then mandatory-exclusion then credential-needles then allowlist-select then archive-member-rescan"
        },
        "selection_policy": {
          "type": "string",
          "const": "allowlist"
        },
        "allowlist_globs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          }
        }
      }
    },
    "mandatory_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git",
        "caches",
        "logs",
        "transcripts",
        "credentials"
      ],
      "properties": {
        "git": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          },
          "uniqueItems": true
        },
        "caches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          },
          "uniqueItems": true
        },
        "logs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          },
          "uniqueItems": true
        },
        "transcripts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          },
          "uniqueItems": true
        },
        "credentials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          },
          "uniqueItems": true
        }
      }
    },
    "size_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_bytes",
        "on_exceed"
      ],
      "properties": {
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5242880
        },
        "on_exceed": {
          "type": "string",
          "const": "fail"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "member_count",
        "total_bytes"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "member_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "sorted_members",
        "normalized_timestamps",
        "generator_id",
        "generator_version",
        "repeat_digest_agrees"
      ],
      "properties": {
        "declared": {
          "type": "boolean",
          "const": true
        },
        "sorted_members": {
          "type": "boolean",
          "const": true
        },
        "normalized_timestamps": {
          "type": "boolean",
          "const": true
        },
        "generator_id": {
          "type": "string",
          "const": "arc-0080-allowlist-packer"
        },
        "generator_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "repeat_digest_agrees": {
          "type": "boolean"
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "allowlist_glob",
          "exists_in_repository",
          "justification"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\.\\./)(?!/)[A-Za-z0-9._+@=-]+(/[A-Za-z0-9._+@=-]+)*$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "allowlist_glob": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "not": {
              "const": "**"
            }
          },
          "exists_in_repository": {
            "type": "boolean"
          },
          "justification": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "path",
          "message"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "declaration",
              "size_ceiling",
              "symlink",
              "git",
              "caches",
              "logs",
              "transcripts",
              "credentials"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "message": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "accept",
        "reject"
      ]
    }
  },
  "state": "SUCCESS",
  "x-normative": {
    "contract_id": "ARC-0080",
    "evaluation_surface": "stage-walk then mandatory-exclusion then credential-needles then allowlist-select then archive-member-rescan",
    "selection_policy": "allowlist",
    "on_exceed": "fail",
    "hard_ceiling_bytes": 5242880,
    "digest_algorithm": "sha256",
    "generator_id": "arc-0080-allowlist-packer",
    "generator_version": "1.0.0",
    "exclusion_classes": {
      "git": [
        ".git",
        ".git/**",
        "**/.git",
        "**/.git/**"
      ],
      "caches": [
        "**/.cache/**",
        "**/__pycache__/**",
        "**/*.pyc",
        "**/node_modules/**",
        "**/.pytest_cache/**"
      ],
      "logs": [
        "**/*.log",
        "**/logs/**"
      ],
      "transcripts": [
        "**/transcripts/**",
        "**/*.transcript",
        "**/*transcript*.jsonl"
      ],
      "credentials": [
        "**/*.credentials",
        "**/*credential*",
        "**/.env",
        "**/.env.*",
        "**/secrets/**",
        "**/*.pem",
        "**/*.key"
      ]
    },
    "credential_content_needles": [
      "CANARY_CREDENTIAL_ARC0080",
      "BEGIN OPENSSH PRIVATE KEY",
      "BEGIN RSA PRIVATE KEY",
      "AWS_SECRET_ACCESS_KEY="
    ],
    "total_wildcard_forbidden": true,
    "silent_omit_forbidden": true,
    "denylist_unrepresentable": true,
    "warn_unrepresentable": true
  },
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "const": "**"
      }
    },
    "rel_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.\\./)(?!/)[A-Za-z0-9._+@=-]+(/[A-Za-z0-9._+@=-]+)*$"
    },
    "sha256_hex": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "allowlist_glob",
        "exists_in_repository",
        "justification"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!\\.\\./)(?!/)[A-Za-z0-9._+@=-]+(/[A-Za-z0-9._+@=-]+)*$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "allowlist_glob": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "const": "**"
          }
        },
        "exists_in_repository": {
          "type": "boolean"
        },
        "justification": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "path",
        "message"
      ],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "declaration",
            "size_ceiling",
            "symlink",
            "git",
            "caches",
            "logs",
            "transcripts",
            "credentials"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512
        }
      }
    }
  }
}
