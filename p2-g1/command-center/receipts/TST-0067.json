  "evidence": [
    {
      "claim": "A persistent-store write of NEW is visible to the setter self-read and invisible to a child spawned from the same session. Two consumer signals (os.environ and /proc/pid/environ) agree on unset.",
      "verdict": "CONFIRMED",
      "anchor": "command-center/p2-wave/probes/TST-0067/harness.py:measure_persistent_miss_and_session_hit",
      "confidence": "almost-certain",
      "probes": [
        {
          "role": "source",
          "method": "child-process-json",
          "command": "observe_child userspace os.environ",
          "raw_output": "{\"consumer_userspace\": null, \"setter_self_read\": \"session-new-value\", \"written\": \"session-new-value\"}"
        },
        {
          "role": "verifier",
          "method": "procfs",
          "command": "read /proc/<pid>/environ while child alive",
          "raw_output": "{\"consumer_kernel\": null, \"signals_agree\": true}"
        }
      ]
    },
    {
      "claim": "When NEW is placed in the child environment at spawn, the child process observes NEW on both signals in that same session. The parent process environment is not mutated.",
      "verdict": "CONFIRMED",
      "anchor": "command-center/p2-wave/probes/TST-0067/harness.py:session_hit",
      "confidence": "almost-certain",
      "probes": [
        {
          "role": "source",
          "method": "child-process-json",
          "command": "observe_child with env overlay",
          "raw_output": "{\"consumer_userspace\": \"session-new-value\", \"written\": \"session-new-value\"}"
        },
        {
          "role": "verifier",
          "method": "procfs",
          "command": "read /proc/<pid>/environ while child alive",
          "raw_output": "{\"consumer_kernel\": \"session-new-value\", \"signals_agree\": true}"
        }
      ]
    },
    {
      "claim": "A config key written at root scope is inert for a consumer that opens project/settings.json. The same key written at project scope is observed. Setter self-read of the root file would false-green the write.",
      "verdict": "CONFIRMED",
      "anchor": "command-center/p2-wave/probes/TST-0067/harness.py:measure_wrong_scope_inert",
      "confidence": "almost-certain",
      "probes": [
        {
          "role": "source",
          "method": "child-process-json",
          "command": "observe_child TST0067_SCOPE_FILE=project/settings.json",
          "raw_output": "{\"after_project\": \"project-scope-write-live\", \"after_root\": \"session-old-value\"}"
        },
        {
          "role": "verifier",
          "method": "detector-control",
          "command": "measure_detector_control",
