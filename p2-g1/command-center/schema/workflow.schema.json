{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/command-center/schema/workflow.schema.json",
  "title": "Catalog-class workflow",
  "description": "Declarative workflow accepted by command-center/schema/validate_workflow.py. Semantic IDs (unknown stage type, missing stop rule, cyclic subworkflow, undeclared tool, negative timeout, duplicate stage id) live in the validator; this schema is the structural floor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tools", "stop_rule", "stages"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string" },
    "tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "timeout_seconds": { "type": "integer" },
    "stop_rule": { "$ref": "#/$defs/stop_rule" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "subworkflows": {
      "type": "object",
      "additionalProperties": { "$ref": "#" }
    }
  },
  "$defs": {
    "stop_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_stages"],
      "properties": {
        "max_stages": { "type": "integer", "minimum": 1 },
        "on_error": { "type": "string", "enum": ["halt", "continue"] }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "tools": { "type": "array", "items": { "type": "string" } },
        "timeout_seconds": { "type": "integer" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "subworkflow": { "type": "string" }
      }
    }
  }
}
