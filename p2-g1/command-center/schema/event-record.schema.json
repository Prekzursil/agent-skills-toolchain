{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/schema/event-record.schema.json",
  "title": "Append-only event record (ARC-0086)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "seq",
    "ts",
    "actor",
    "unit_id",
    "phase",
    "from_state",
    "to_state",
    "correlation_id",
    "causality_id",
    "substrate",
    "writer_id",
    "payload",
    "redactions",
    "prev_sha256",
    "sha256",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 3
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "type": "string",
      "description": "RFC3339 / ISO-8601 datetime with explicit timezone.",
      "minLength": 20
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "from_state": {
      "type": "string",
      "minLength": 1
    },
    "to_state": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causality_id": {
      "type": "string",
      "minLength": 1,
      "description": "Parent event_id this record happens-after, or 'genesis'."
    },
    "substrate": {
      "type": "string",
      "minLength": 1
    },
    "writer_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "action"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "prev_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
