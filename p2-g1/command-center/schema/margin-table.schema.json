{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/command-center/schema/margin-table.schema.json",
  "title": "B07 per-metric non-inferiority margin table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "decided_at",
    "git_state",
    "at_margin_resolves",
    "at_margin_rule",
    "metrics"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "b07-margin-table" },
    "decided_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "git_state": { "type": "string", "minLength": 8 },
    "at_margin_resolves": { "type": "string", "const": "NON_INFERIOR" },
    "at_margin_rule": { "type": "string", "const": "worse_delta <= margin" },
    "freeze_identity": { "type": "string" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "polarity", "margin", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["primary", "secondary"] },
          "polarity": {
            "type": "string",
            "enum": ["higher_is_better", "lower_is_better"]
          },
          "margin": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
