{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/command-center/schema/bench-case.schema.json",
  "title": "TST-0295 benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task_input",
    "oracle",
    "known_good_solution",
    "known_bad_solution",
    "provenance",
    "difficulty_stratum",
    "split"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "pattern": "^CASE-[A-Z0-9-]+$"
    },
    "task_input": {
      "type": "object",
      "required": ["instruction"],
      "additionalProperties": true,
      "properties": {
        "instruction": { "type": "string", "minLength": 8 }
      }
    },
    "oracle": {
      "type": "object",
      "required": ["kind", "oracle_type"],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "both_states_detector",
            "capability_partition",
            "intersection_gate",
            "judged_rubric"
          ]
        },
        "oracle_type": {
          "type": "string",
          "enum": ["deterministic", "judged"]
        }
      }
    },
    "known_good_solution": {
      "type": "object",
      "minProperties": 1
    },
    "known_bad_solution": {
      "type": "object",
      "minProperties": 1
    },
    "provenance": {
      "type": "object",
      "required": ["source", "derived_from_real_defect"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "derived_from_real_defect": { "type": "boolean" },
        "source_kind": { "type": "string", "minLength": 1 }
      }
    },
    "difficulty_stratum": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "split": {
      "type": "string",
      "enum": ["dev", "test", "held-out-shadow"]
    },
    "workflow_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
