{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/command-center/schema/discrepancy-record.schema.json",
  "title": "Discrepancy record (spec 11039)",
  "$comment": "CNF-0001 authored the discriminating constraints. This is not a generated shim: garbage documents must fail, and a routed record names a closed-set disposition. extra properties are allowed so a router artifact (CNF-0013) can carry evidence beside the contract fields.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "claim_id",
    "disposition",
    "residual"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "discrepancy_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "disposition": {
      "type": "string",
      "enum": [
        "implementation-defect",
        "confirmation-defect",
        "specification-ambiguity",
        "environment-difference",
        "accepted-residual"
      ]
    },
    "confirmer": { "type": ["string", "object"] },
    "source_probe": { "type": ["string", "object"] },
    "verifier_probe": { "type": ["string", "object"] },
    "verbatim_probe_output": { "type": "string", "minLength": 1 },
    "residual": { "type": "string", "minLength": 1 },
    "settling_experiment": { "type": "string", "minLength": 1 },
    "defect": { "type": "object" },
    "first_observation": { "type": "object" },
    "later_observation": { "type": "object" }
  }
}
