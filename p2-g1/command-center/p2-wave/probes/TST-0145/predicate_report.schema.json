{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0145/predicate_report.schema.json",
  "title": "Predicate report (condition-vector tester)",
  "description": "Discriminating contract for a live completion-predicate test receipt. Catalog receipt.schema.json#/$defs/predicate_report is absent on this worktree; this file carries the constraints. Garbage objects are rejected.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "report_kind",
    "cases",
    "tests",
    "negative_controls",
    "evidence",
    "reviewer",
    "artifacts",
    "named_probes"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
    },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "report_kind": { "type": "string", "const": "predicate_report" },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "c5_outcome", "schema_valid", "bytes"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "c5_outcome": {
            "type": "string",
            "enum": ["SATISFIED", "UNSATISFIED"]
          },
          "schema_valid": { "type": "boolean" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "result": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT-RUN", "BLOCKED", "NOT-CHECKED"]
          }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fired_on_bad_state", "silent_on_good_state"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["claim", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string", "minLength": 3 },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "command": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
