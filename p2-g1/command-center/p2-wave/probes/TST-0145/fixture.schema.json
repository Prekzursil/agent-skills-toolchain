{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/TST-0145/fixture.schema.json",
  "title": "TST-0145 condition-5 fixture artifact",
  "description": "Schema-valid non-empty JSON used as a planted completion artifact. Garbage objects are rejected.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "question",
    "answer",
    "artifacts",
    "case_id"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
    },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "case_id": { "type": "string", "minLength": 3 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean" },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
