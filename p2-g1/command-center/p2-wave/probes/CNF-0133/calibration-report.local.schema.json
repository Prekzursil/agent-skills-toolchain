{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CNF-0133 calibration report (local contract)",
  "type": "object",
  "additionalProperties": true,
  "required": ["report_kind", "unit_id", "state", "sentinel", "confusion_matrix",
    "planted_items", "false_pass_rate", "wilson_interval", "per_set", "stability",
    "arithmetic_recompute", "both_states"],
  "properties": {
    "report_kind": {"const": "calibration-report"},
    "unit_id": {"const": "CNF-0133"},
    "state": {"type": "string"},
    "sentinel": {"type": "string", "pattern": "^SUCCESS:"},
    "confusion_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["true_positive", "false_positive", "true_negative", "false_negative"],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0}
      }
    },
    "planted_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "set_id", "oracle_label", "confirmer_verdict", "operator_class"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-0133-[0-9a-f]{12}$"},
          "set_id": {"enum": ["set_a", "set_b"]},
          "oracle_label": {"enum": ["true", "false"]},
          "confirmer_verdict": {"enum": ["CONFIRMED", "REFUNDED", "REFUTED", "BLOCKED"]},
          "operator_class": {"enum": ["none", "killed", "surviving"]}
        }
      }
    },
    "false_pass_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "value"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1},
        "value": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "wilson_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "k", "z", "low", "high"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 0},
 "z": {"type": "number"},
        "low": {"type": "number", "minimum": 0, "maximum": 1},
        "high": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "per_set": {"type": "object"},
    "stability": {"type": "object"},
    "arithmetic_recompute": {"type": "object"},
    "both_states": {"type": "object"}
  }
}
