{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CNF-0133 confirmation record (local contract)",
  "type": "object",
  "additionalProperties": true,
  "required": ["claim_id", "verdict", "confirmer", "source_probe", "verifier_probe", "baseline_repro"],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-0133-[0-9a-f]{12}$"
    },
    "verdict": {"enum": ["CONFIRMED", "REFUTED", "BLOCKED"]},
    "confirmer": {
      "type": "object",
      "required": ["id", "vendor"],
      "properties": {
        "id": {"type": "string"},
        "vendor": {"type": "string"}
      }
    },
    "source_probe": {
      "type": "object",
      "required": ["id", "fingerprint"],
      "properties": {
        "id": {"type": "string"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "verifier_probe": {"type": "object"},
    "baseline_repro": {"type": "object"}
  }
}
