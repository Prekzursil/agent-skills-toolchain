{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/AUD-0066/artifact.schema.json",
  "title": "AUD-0066 scheduled-task and background-service dependency inventory",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "question",
    "answer",
    "os_state",
    "health",
    "findings",
    "defects",
    "tests",
    "named_probes",
    "reviewer",
    "artifacts",
    "downstream_consumers"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "AUD-0066" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "os_state": { "type": "object" },
    "health": { "type": "object" },
    "findings": { "type": "array" },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "summary"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "waived-by-owner", "superseded"]
          }
        }
      }
    },
    "tests": { "type": "array", "minItems": 2 },
    "named_probes": { "type": "array", "minItems": 2 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 },
    "downstream_consumers": { "type": "array", "minItems": 1 }
  }
}
