{
  "permissions": {
    "allow": [
      "Bash(rm *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(find *)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "id": "intent-gate-rm",
            "command": "block-rm.sh",
            "if": "Bash(rm *)"
          }
        ]
      },
      {
        "matcher": "^rm",
        "hooks": [
          {
            "type": "command",
            "id": "wrong-field-tool-name",
            "command": "wrong-field.sh"
          }
        ]
      }
    ]
  }
}
