ate":"uploaded","size":227554,"digest":null,"download_count":24,"created_at":"2024-08-21T19:37:48Z","updated_at":"2024-08-21T19:37:49Z","browser_download_url":"https://github.com/pallets/werkzeug/releases/download/3.0.4/werkzeug-3.0.4-py3-none-any.whl"},{"url":"https://api.github.com/repos/pallets/werkzeug/releases/assets/187469493","id":187469493,"node_id":"RA_kwDOAA832s4LLI61","name":"werkzeug-3.0.4.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":803966,"digest":null,"download_count":41,"created_at":"2024-08-21T19:37:48Z","updated_at":"2024-08-21T19:37:49Z","browser_download_url":"https://github.com/pallets/werkzeug/releases/download/3.0.4/werkzeug-3.0.4.tar.gz"}],"tarball_url":"https://api.github.com/repos/pallets/werkzeug/tarball/3.0.4","zipball_url":"https://api.github.com/repos/pallets/werkzeug/zipball/3.0.4","body":"This is the Werkzeug 3.0.4 fix release, which fixes bugs but does not otherwise change behavior and should not result in breaking changes.\r\n\r\nPyPI: https://pypi.org/project/Werkzeug/3.0.4/\r\nChanges: https://werkzeug.palletsprojects.com/en/3.0.x/changes/#version-3-0-4\r\nMilestone: https://github.com/pallets/werkzeug/milestone/36?closed=1\r\n\r\n-   Restore behavior where parsing `multipart/x-www-form-urlencoded` data with\r\n    invalid UTF-8 bytes in the body results in no form data parsed rather than a\r\n    413 error. #2930\r\n-   Improve ``parse_options_header`` performance when parsing unterminated\r\n    quoted string values. #2904\r\n-   Debugger pin auth is synchronized across threads/processes when tracking\r\n    failed entries. #2916\r\n-   Dev server handles unexpected `SSLEOFError` due to issue in Python < 3.13.\r\n    #2926\r\n-   Debugger pin auth works when the URL already contains a query string.\r\n    #2918","reactions":{"url":"https://api.github.com/repos/pallets/werkzeug/releases/171344023/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/pallets/werkzeug/releases/154325516","assets_url":"https://api.github.com/repos/pallets/werkzeug/releases/154325516/assets","upload_url":"https://uploads.github.com/repos/pallets/werkzeug/releases/154325516/assets{?name,label}","html_url":"https://github.com/pallets/werkzeug/releases/tag/3.0.3","id":154325516,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{