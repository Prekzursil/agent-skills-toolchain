m/aio-libs/aiohttp/releases/download/v3.13.2/aiohttp-3.13.2-cp39-cp39-win_amd64.whl"},{"url":"https://api.github.com/repos/aio-libs/aiohttp/releases/assets/309841557","id":309841557,"node_id":"RA_kwDOAMpNN84Sd86V","name":"aiohttp-3.13.2.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"raw","state":"uploaded","size":7837994,"digest":"sha256:40176a52c186aefef6eb3cad2cdd30cd06e3afbe88fe8ab2af9c0b90f228daca","download_count":284,"created_at":"2025-10-28T20:53:37Z","updated_at":"2025-10-28T20:53:38Z","browser_download_url":"https://github.com/aio-libs/aiohttp/releases/download/v3.13.2/aiohttp-3.13.2.tar.gz"}],"tarball_url":"https://api.github.com/repos/aio-libs/aiohttp/tarball/v3.13.2","zipball_url":"https://api.github.com/repos/aio-libs/aiohttp/zipball/v3.13.2","body":"Bug fixes\n---------\n\n- Fixed cookie parser to continue parsing subsequent cookies when encountering a malformed cookie that fails regex validation, such as Google's ``g_state`` cookie with unescaped quotes -- by :user:`bdraco`.\n\n\n  *Related issues and pull requests on GitHub:*\n  #11632.\n\n\n\n- Fixed loading netrc credentials from the default :file:`~/.netrc` (:file:`~/_netrc` on Windows) location when the :envvar:`NETRC` environment variable is not set -- by :user:`bdraco`.\n\n\n  *Related issues and pull requests on GitHub:*\n  #11713, #11714.\n\n\n\n- Fixed WebSocket compressed sends to be cancellation safe. Tasks are now shielded during compression to prevent compressor state corruption. This ensures that the stateful compressor remains consistent even when send operations are cancelled -- by :user:`bdraco`.\n\n\n  *Related issues and pull requests on GitHub:*\n  #11725.\n\n\n\n\n----","reactions":{"url":"https://api.github.com/repos/aio-libs/aiohttp/releases/257974878/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/aio-libs/aiohttp/releases/255326255","assets_url":"https://api.github.com/repos/aio-libs/aiohttp/releases/255326255/assets","upload_url":"https://uploads.github.com/repos/aio-libs/aiohttp/releases/255326255/assets{?name,label}","html_url":"https://github.com/aio-libs/aiohttp/releases/tag/v3.13.1","id":255326255,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.githu