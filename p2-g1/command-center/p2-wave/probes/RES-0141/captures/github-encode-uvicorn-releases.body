Kludex/uvicorn/releases/328496192/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.48.0","id":328496192,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84TlHRA","tag_name":"0.48.0","target_commitish":"main","name":"Version 0.48.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-05-24T12:03:53Z","updated_at":"2026-05-24T12:07:53Z","published_at":"2026-05-24T12:07:53Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.48.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.48.0","body":"## What's Changed\r\n* Default `ssl_ciphers` to `None` and use OpenSSL defaults by @Kludex in https://github.com/Kludex/uvicorn/pull/2940\r\n* Ignore duplicate forwarding headers in `ProxyHeadersMiddleware` by @Kludex in https://github.com/Kludex/uvicorn/pull/2944\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.47.0...0.48.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/328496192/reactions","total_count":12,"+1":5,"-1":0,"laugh":0,"hooray":6,"confused":0,"heart":1,"rocket":0,"eyes":0},"mentions_count":1},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/322549220","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/322549220/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/322549220/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.47.0","id":322549220,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84TObXk","tag_name":"0.47.0","target_commitish":"main","name":"Version 0.47.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-05-14T13:20:53Z","updated_at":"2026-05-14T13:21:46Z","published_at":"2026-05-14T13:21:46Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.47.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.47.0","body":"## What's Changed\r\n* Eagerly import the ASGI app in the parent process by @Kludex in https://github.com/Kludex/uvicorn/pull/2919\r\n* Add `ssl_context_factory` for custom `SSLContext` configuration by @Kludex in https://github.com/Kludex/uvicorn/pull/2920\r\n* Treat `fd=0` as a valid file descriptor with reload/workers by @eltoder in https://github.com/Kludex/uvicorn/pull/2927\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.46.0...0.47.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/322549220/reactions","total_count":7,"+1":2,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":0,"rocket":1,"eyes":0},"mentions_count":2},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/312573620","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/312573620/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/312573620/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.46.0","id":312573620,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84SoX60","tag_name":"0.46.0","target_commitish":"main","name":"Version 0.46.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-04-23T06:33:22Z","updated_at":"2026-04-23T06:34:38Z","published_at":"2026-04-23T06:34:38Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.46.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.46.0","body":"## What's Changed\r\n* Support `ws_max_size` in `wsproto` implementation by @Kludex in https://github.com/Kludex/uvicorn/pull/2915\r\n* Support `ws_ping_interval` and `ws_ping_timeout` in `wsproto` implementation by @Kludex in https://github.com/Kludex/uvicorn/pull/2916\r\n* Use `bytearray` for incoming WebSocket message buffer in websockets-sansio by @Kludex in https://github.com/Kludex/uvicorn/pull/2917\r\n\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.45.0...0.46.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/312573620/reactions","total_count":7,"+1":4,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":1,"eyes":0},"mentions_count":1},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/311659237","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/311659237/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/311659237/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.45.0","id":311659237,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84Sk4rl","tag_name":"0.45.0","target_commitish":"main","name":"Version 0.45.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-04-21T10:42:06Z","updated_at":"2026-04-21T10:42:50Z","published_at":"2026-04-21T10:42:50Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.45.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.45.0","body":"## What's Changed\r\n\r\n* Preserve forwarded client ports in proxy headers middleware by @Kludex in https://github.com/Kludex/uvicorn/pull/2903\r\n* Accept `os.PathLike` for `log_config` by @Kludex in https://github.com/Kludex/uvicorn/pull/2905\r\n* Accept `log_level` strings case-insensitively by @Kludex in https://github.com/Kludex/uvicorn/pull/2907\r\n* Raise helpful `ImportError` when PyYAML is missing for YAML log config by @Kludex in https://github.com/Kludex/uvicorn/pull/2906\r\n* Revert empty context for ASGI runs by @Kludex in https://github.com/Kludex/uvicorn/pull/2911\r\n* Add `--reset-contextvars` flag to isolate ASGI request context by @Kludex in https://github.com/Kludex/uvicorn/pull/2912\r\n* Revert \"Emit `http.disconnect` on server shutdown for streaming responses\" (#2829) by @Kludex in https://github.com/Kludex/uvicorn/pull/2913\r\n\r\n## New Contributors\r\n* @Krishnachaitanyakc made their first contribution in https://github.com/Kludex/uvicorn/pull/2870\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.44.0...0.45.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/311659237/reactions","total_count":9,"+1":6,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":1,"eyes":0},"mentions_count":2},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/305584491","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/305584491/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/305584491/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.44.0","id":305584491,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84SNtlr","tag_name":"0.44.0","target_commitish":"main","name":"Version 0.44.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-04-06T09:21:24Z","updated_at":"2026-04-06T09:22:08Z","published_at":"2026-04-06T09:22:08Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.44.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.44.0","body":"## What's Changed\r\n* Implement websocket keepalive pings for websockets-sansio by @Kludex in https://github.com/Kludex/uvicorn/pull/2888\r\n\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.43.0...0.44.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/305584491/reactions","total_count":10,"+1":8,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":1,"eyes":0},"mentions_count":1},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/305123957","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/305123957/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/305123957/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.43.0","id":305123957,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84SL9J1","tag_name":"0.43.0","target_commitish":"main","name":"Version 0.43.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-04-03T18:33:18Z","updated_at":"2026-04-03T18:36:18Z","published_at":"2026-04-03T18:36:18Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.43.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.43.0","body":"## Changed\r\n\r\n* Emit `http.disconnect` ASGI `receive()` event on server shutting down for streaming responses (#2829)\r\n* Use native `context` parameter for `create_task` on Python 3.11+ (#2859)\r\n* Drop cast in ASGI types (#2875)\r\n\r\n---\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.42.0...0.43.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/305123957/reactions","total_count":5,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0}},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/297319894","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/297319894/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/297319894/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.42.0","id":297319894,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84RuL3W","tag_name":"0.42.0","target_commitish":"main","name":"Version 0.42.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-03-16T06:11:15Z","updated_at":"2026-03-16T06:17:08Z","published_at":"2026-03-16T06:17:08Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.42.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.42.0","body":"## Changed\r\n\r\n* Use `bytearray` for request body accumulation to avoid O(n^2) allocation on fragmented bodies (#2845)\r\n\r\n## Fixed\r\n\r\n* Escape brackets and backslash in httptools `HEADER_RE` regex (#2824)\r\n* Fix multiple issues in websockets sans-io implementation (#2825)\r\n\r\n---\r\n\r\n## New Contributors\r\n* @bysiber made their first contribution in https://github.com/Kludex/uvicorn/pull/2825\r\n\r\n---\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.41.0...0.42.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/297319894/reactions","total_count":13,"+1":6,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":5,"rocket":0,"eyes":0},"mentions_count":1},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/287019289","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/287019289/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/287019289/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.41.0","id":287019289,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravatar_id":"","url":"https://api.github.com/users/Kludex","html_url":"https://github.com/Kludex","followers_url":"https://api.github.com/users/Kludex/followers","following_url":"https://api.github.com/users/Kludex/following{/other_user}","gists_url":"https://api.github.com/users/Kludex/gists{/gist_id}","starred_url":"https://api.github.com/users/Kludex/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Kludex/subscriptions","organizations_url":"https://api.github.com/users/Kludex/orgs","repos_url":"https://api.github.com/users/Kludex/repos","events_url":"https://api.github.com/users/Kludex/events{/privacy}","received_events_url":"https://api.github.com/users/Kludex/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOBYpCG84RG5EZ","tag_name":"0.41.0","target_commitish":"main","name":"Version 0.41.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-02-16T22:33:52Z","updated_at":"2026-02-16T22:56:24Z","published_at":"2026-02-16T22:56:24Z","assets":[],"tarball_url":"https://api.github.com/repos/Kludex/uvicorn/tarball/0.41.0","zipball_url":"https://api.github.com/repos/Kludex/uvicorn/zipball/0.41.0","body":"## Added\r\n\r\n* Add `--limit-max-requests-jitter` to stagger worker restarts (#2707)\r\n* Add socket path to `scope[\"server\"]` (#2561)\r\n\r\n## Changed\r\n\r\n* Rename `LifespanOn.error_occured` to `error_occurred` (#2776)\r\n\r\n## Fixed\r\n\r\n* Ignore permission denied errors in watchfiles reloader (#2817)\r\n* Ensure lifespan shutdown runs when `should_exit` is set during startup (#2812)\r\n* Reduce the log level of 'request limit exceeded' messages (#2788)\r\n\r\n---\r\n\r\n## New Contributors\r\n* @t-kawasumi made their first contribution in https://github.com/Kludex/uvicorn/pull/2776\r\n* @fardyn made their first contribution in https://github.com/Kludex/uvicorn/pull/2800\r\n* @ewie made their first contribution in https://github.com/Kludex/uvicorn/pull/2807\r\n* @shevron made their first contribution in https://github.com/Kludex/uvicorn/pull/2788\r\n* @jonashaag made their first contribution in https://github.com/Kludex/uvicorn/pull/2707\r\n\r\n---\r\n\r\n**Full Changelog**: https://github.com/Kludex/uvicorn/compare/0.40.0...0.41.0","reactions":{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/287019289/reactions","total_count":23,"+1":6,"-1":0,"laugh":3,"hooray":4,"confused":0,"heart":3,"rocket":4,"eyes":3},"mentions_count":5},{"url":"https://api.github.com/repos/Kludex/uvicorn/releases/272024068","assets_url":"https://api.github.com/repos/Kludex/uvicorn/releases/272024068/assets","upload_url":"https://uploads.github.com/repos/Kludex/uvicorn/releases/272024068/assets{?name,label}","html_url":"https://github.com/Kludex/uvicorn/releases/tag/0.40.0","id":272024068,"author":{"login":"Kludex","id":7353520,"node_id":"MDQ6VXNlcjczNTM1MjA=","avatar_url":"https://avatars.githubusercontent.com/u/7353520?v=4","gravat