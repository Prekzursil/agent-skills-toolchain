%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":108274,"digest":"sha256:981153a64e25f12d547d3426c367a4857371575ee7ad18df2a6183ab0545b2a6","download_count":50,"created_at":"2025-11-15T20:42:47Z","updated_at":"2025-11-15T20:42:47Z","browser_download_url":"https://github.com/pallets/click/releases/download/8.3.1/click-8.3.1-py3-none-any.whl"},{"url":"https://api.github.com/repos/pallets/click/releases/assets/316844209","id":316844209,"node_id":"RA_kwDOASN_zM4S4qix","name":"click-8.3.1.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":295065,"digest":"sha256:12ff4785d337a1bb490bb7e9c2b1ee5da3112e94a8622f26a6c77f5d2fc6842a","download_count":60,"created_at":"2025-11-15T20:42:47Z","updated_at":"2025-11-15T20:42:47Z","browser_download_url":"https://github.com/pallets/click/releases/download/8.3.1/click-8.3.1.tar.gz"}],"tarball_url":"https://api.github.com/repos/pallets/click/tarball/8.3.1","zipball_url":"https://api.github.com/repos/pallets/click/zipball/8.3.1","body":"This is the Click 8.3.1 fix release, which fixes bugs but does not otherwise change behavior and should not result in breaking changes compared to the latest feature release.\r\n\r\nPyPI: https://pypi.org/project/click/8.3.1/\r\nChanges: https://click.palletsprojects.com/page/changes/#version-8-3-1\r\nMilestone: https://github.com/pallets/click/milestone/28\r\n\r\n-   Don't discard pager arguments by correctly using ``subprocess.Popen``. #3039 #3055\r\n-   Replace ``Sentinel.UNSET`` default values by ``None`` as they're passed through the ``Context.invoke()`` method. #3066 #3065 #3068\r\n-   Fix conversion of ``Sentinel.UNSET`` happening too early, which caused incorrect behavior for multiple parameters using the same name. #3071 #3079\r\n-   Fix rendering when ``prompt`` and ``confirm`` parameter ``prompt_suffix`` is empty. #3019 #3021\r\n-   When ``Sentinel.UNSET`` is found during parsing, it will skip calls to ``type_cast_value``. #3069 #3090 \r\n-   Hide ``Sentinel.UNSET`` values as ``None`` when looking up for other parameters through the context inside parameter callbacks. #3136 #3137","reactions":{"url":"https://api.github.com/repos/pallets/click/releases/262701271/reactions","total_count":4,"+1":3,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/pallets/click/releases/246948311","assets_url":"https://api.github.com/repos/pallets/click/releases/246948311/assets","upload_url":"https://uploads.github.com/repos/pallets/click/releases/246948311/assets{?name,label}","html_url":"https://github.com/pallets/click/releases/tag/8.3.0","id":246948311,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOASN_zM4OuCHX","tag_name":"8.3.0","target_commitish":"main","name":"8.3.0","draft":false,"immutable":false,"prerelease":false,"created_at":"2025-09-13T05:44:24Z","updated_at":"2025-09-18T17:34:57Z","published_at":"2025-09-18T17:34:57Z","assets":[{"url":"https://api.github.com/repos/pallets/click/releases/assets/292769517","id":292769517,"node_id":"RA_kwDOASN_zM4Rc07t","name":"click-8.3.0-py3-none-any.whl","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":107295,"digest":"sha256:9b9f285302c6e3064f4330c05f05b81945b2a39544279343e6e7c5f27a9baddc","download_count":40,"created_at":"2025-09-13T05:45:02Z","updated_at":"2025-09-13T05:45:02Z","browser_download_url":"https://github.com/pallets/click/releases/download/8.3.0/click-8.3.0-py3-none-any.whl"},{"url":"https://api.github.com/repos/pallets/click/releases/assets/292769516","id":292769516,"node_id":"RA_kwDOASN_zM4Rc07s","name":"click-8.3.0.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":276943,"digest":"sha256:e7b8232224eba16f4ebe410c25ced9f7875cb5f3263ffc93cc3e8da705e229c4","download_count":51,"created_at":"2025-09-13T05:45:02Z","updated_at":"2025-09-13T05:45:02Z","browser_download_url":"https://github.com/pallets/click/releases/download/8.3.0/click-8.3.0.tar.gz"}],"tarball_url":"https://api.github.com/repos/pallets/click/tarball/8.3.0","zipball_url":"https://api.github.com/repos/pallets/click/zipball/8.3.0","body":"This is the Click 8.3.0 feature release. A feature release may include new features, remove previously deprecated code, add new deprecation, or introduce potentially breaking changes.\r\n\r\nWe encourage everyone to upgrade. You can read more about our [Version Support Policy][version] on our website.\r\n\r\n[version]: https://palletsprojects.com/versions\r\n\r\nPyPI: https://pypi.org/project/click/8.3.0/\r\nChanges:  https://click.palletsprojects.com/page/changes/#version-8-3-0\r\nMilestone https://github.com/pallets/click/milestone/27\r\n\r\n-   **Improved flag option handling**: Reworked the relationship between ``flag_value``\r\n    and ``default`` parameters for better consistency:\r\n\r\n    * The ``default`` parameter value is now preserved as-is and passed directly\r\n      to CLI functions (no more unexpected transformations)\r\n    * Exception: flag options with ``default=True`` maintain backward compatibility\r\n      by defaulting to their ``flag_value``\r\n    * The ``default`` parameter can now be any type (``bool``, ``None``, etc.)\r\n    * Fixes inconsistencies reported in: #1992  #2514 #2610\r\n      #3024  #3030\r\n-   Allow ``default`` to be set on ``Argument`` for ``nargs = -1``. #2164\r\n    #3030\r\n-   Show correct auto complete value for ``nargs`` option in combination with flag\r\n    option #2813\r\n-   Show correct auto complete value for nargs option in combination with flag option #2813\r\n-   Fix handling of quoted and escaped parameters in Fish autocompletion. #2995 #3013\r\n-   Lazily import ``shutil``.  #3023\r\n-   Properly forward exception information to resources registered with\r\n    ``click.core.Context.with_resource()``. #2447  #3058\r\n-   Fix regression related to EOF handling in CliRunner.  #2939 #2940","reactions":{"url":"https://api.github.com/repos/pallets/click/releases/246948311/reactions","total_count":9,"+1":4,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0}},{"url":"https://api.github.com/repos/pallets/click/releases/237031828","assets_url":"https://api.github.com/repos/pallets/click/releases/237031828/assets","upload_url":"https://uploads.github.com/repos/pallets/click/releases/237031828/assets{?name,label}","html_url":"https://github.com/pallets/click/releases/tag/8.2.2","id":237031828,"author":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/rec