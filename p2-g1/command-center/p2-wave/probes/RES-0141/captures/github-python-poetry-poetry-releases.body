ype":"application/x-gtar","state":"uploaded","size":3433288,"digest":null,"download_count":471,"created_at":"2025-02-16T21:05:19Z","updated_at":"2025-02-16T21:05:19Z","browser_download_url":"https://github.com/python-poetry/poetry/releases/download/2.1.1/poetry-2.1.1.tar.gz"}],"tarball_url":"https://api.github.com/repos/python-poetry/poetry/tarball/2.1.1","zipball_url":"https://api.github.com/repos/python-poetry/poetry/zipball/2.1.1","body":"### Fixed\r\n\r\n- Fix an issue where `poetry env use python` does not choose the Python from the PATH ([#10187](https://github.com/python-poetry/poetry/pull/10187)).\r\n\r\n### poetry-core ([`2.1.1`](https://github.com/python-poetry/poetry-core/releases/tag/2.1.1))\r\n\r\n- Fix an issue where simplifying a `python_version` marker resulted in an invalid marker ([#838](https://github.com/python-poetry/poetry-core/pull/838)).\r\n","reactions":{"url":"https://api.github.com/repos/python-poetry/poetry/releases/200595094/reactions","total_count":12,"+1":2,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":3,"rocket":6,"eyes":0}},{"url":"https://api.github.com/repos/python-poetry/poetry/releases/200525748","assets_url":"https://api.github.com/repos/python-poetry/poetry/releases/200525748/assets","upload_url":"https://uploads.github.com/repos/python-poetry/poetry/releases/200525748/assets{?name,label}","html_url":"https://github.com/python-poetry/poetry/releases/tag/2.1.0","id":200525748,"author":{"login":"radoering","id":30527984,"node_id":"MDQ6VXNlcjMwNTI3OTg0","avatar_url":"https://avatars.githubusercontent.com/u/30527984?v=4","gravatar_id":"","url":"https://api.github.com/users/radoering","html_url":"https://github.com/radoering","followers_url":"https://api.github.com/users/radoering/followers","following_url":"https://api.github.com/users/radoering/following{/other_user}","gists_url":"https://api.github.com/users/radoering/gists{/gist_id}","starred_url":"https://api.github.com/users/radoering/starred{/owner}{/repo}","subscriptions_