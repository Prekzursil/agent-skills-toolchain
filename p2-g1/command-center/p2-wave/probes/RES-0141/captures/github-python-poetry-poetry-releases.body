s/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":1519105,"digest":null,"download_count":482,"created_at":"2024-10-14T15:43:26Z","updated_at":"2024-10-14T15:43:26Z","browser_download_url":"https://github.com/python-poetry/poetry/releases/download/1.8.4/poetry-1.8.4.tar.gz"}],"tarball_url":"https://api.github.com/repos/python-poetry/poetry/tarball/1.8.4","zipball_url":"https://api.github.com/repos/python-poetry/poetry/zipball/1.8.4","body":"### Added\r\n\r\n- **Add official support for Python 3.13** ([#9523](https://github.com/python-poetry/poetry/pull/9523)).\r\n\r\n### Changed\r\n\r\n- Require `virtualenv>=20.26.6` to mitigate potential command injection when running `poetry shell` in untrusted projects ([#9757](https://github.com/python-poetry/poetry/pull/9757)).\r\n\r\n### poetry-core ([`1.9.1`](https://github.com/python-poetry/poetry-core/releases/tag/1.9.1))\r\n\r\n- Add `3.13` to the list of available Python versions ([#747](https://github.com/python-poetry/poetry-core/pull/747)).\r\n","reactions":{"url":"https://api.github.com/repos/python-poetry/poetry/releases/179849232/reactions","total_count":77,"+1":42,"-1":0,"laugh":2,"hooray":4,"confused":0,"heart":14,"rocket":12,"eyes":3}},{"url":"https://api.github.com/repos/python-poetry/poetry/releases/154777647","assets_url":"https://api.github.com/repos/python-poetry/poetry/releases/154777647/assets","upload_url":"https://uploads.github.com/repos/python-poetry/poetry/releases/154777