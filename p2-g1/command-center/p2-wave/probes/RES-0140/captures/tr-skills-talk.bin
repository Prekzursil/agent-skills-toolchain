(function () {
    var vids = document.querySelectorAll('video[data-src], video[data-lazy-src]');
    if (!vids.length || !('IntersectionObserver' in window)) return;

    // Reduced motion: leave the posters, never fetch a video at all.
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function load(v) {
        if (v.src) return;
        var src = v.getAttribute('data-src') || v.getAttribute('data-lazy-src');
        if (src) v.src = src;
    }

    function play(v) {
        load(v);
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
    }

    var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) play(e.target);
            else if (!e.target.paused) e.target.pause();
        });
    }, { rootMargin: '200px 0px', threshold: 0.15 });

    for (var i = 0; i < vids.length; i++) io.observe(vids[i]);

    // Hovering a card restarts its clip even if it never left the viewport.
    document.addEventListener('mouseover', function (e) {
        var card = e.target.closest && e.target.closest('.bento-card, .hp-case-card, .case-card');
        if (!card) return;
        var v = card.querySelector('video[data-src], video[data-lazy-src]');
        if (v) play(v);
    }, { passive: true });
})();
</script><div class="getapp-modal" id="getapp-modal" hidden><div class="getapp-modal__backdrop" data-getapp-close></div><div class="getapp-modal__panel cine-surface" role="dialog" aria-modal="true" aria-labelledby="getapp-modal-title"><button type="button" class="getapp-modal__close" data-getapp-close aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button><p class="getapp-modal__kicker">Point your camera</p><h2 class="getapp-modal__title" id="getapp-modal-title">SozAI runs on your phone</h2><p class="getapp-modal__lead">Scan the code to open the download page on iOS or Android. 30 minutes of transcription free, no card.</p><div class="getapp-modal__qr"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 31 31" shape-rendering="crispEdges"><path fill="#ffffff" d="M0 0h31v31H0z" /><path stroke="#000000" d="M1 1.5h7m1 0h4m3 0h6m1 0h7M1 2.5h1m5 0h1m1 0h1m5 0h2m1 0h2m1 0h1m1 0h1m5 0h1M1 3.5h1m1 0h3m1 0h1m3 0h1m1 0h4m4 0h1m1 0h1m1 0h3m1 0h1M1 4.5h1m1 0h3m1 0h1m1 0h2m2 0h1m3 0h2m1 0h1m2 0h1m1 0h3m1 0h1M1 5.5h1m1 0h3m1 0h1m2 0h2m1 0h2m5 0h1m2 0h1m1 0h3m1 0h1M1 6.5h1m5 0h1m2 0h3m2 0h1m2 0h4m1 0h1m5 0h1M1 7.5h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7M9 8.5h2m2 0h3m2 0h3M1 9.5h1m1 0h2m1 0h3m3 0h1m1 0h2m1 0h5m1 0h1m2 0h1m1 0h2M1 10.5h1m1 0h2m3 0h1m7 0h2m1 0h7m3 0h1M1 11.5h1m3 0h1m1 0h1m1 0h2m2 0h1m1 0h2m1 0h1m4 0h1m3 0h2M3 12.5h1m1 0h2m3 0h1m1 0h5m2 0h1m1 0h3m5 0h1M1 13.5h1m4 0h2m1 0h1m1 0h1m1 0h1m3 0h2m1 0h1m1 0h1m3 0h2M2 14.5h1m2 0h2m1 0h1m2 0h2m1 0h1m3 0h1m1 0h1m2 0h1m3 0h3M1 15.5h2m3 0h3m2 0h1m3 0h1m3 0h2m1 0h1m2 0h1m1 0h3M1 16.5h1m2 0h1m1 0h1m1 0h1m4 0h2m1 0h1m2 0h1m1 0h3m4 0h1M3 17.5h2m2 0h1m4 0h2m7 0h2m2 0h2m1 0h1M2 18.5h1m1 0h2m5 0h1m1 0h2m3 0h1m2 0h1m2 0h1m1 0h3M1 19.5h1m3 0h1m1 0h1m1 0h1m1 0h1m1 0h1m4 0h1m2 0h2m1 0h1m2 0h1M4 20.5h2m4 0h1m1 0h2m2 0h5m1 0h1m2 0h1m1 0h1M2 21.5h1m1 0h2m1 0h1m1 0h3m2 0h1m1 0h1m4 0h7M9 22.5h1m2 0h5m1 0h2m1 0h1m3 0h5M1 23.5h7m1 0h1m3 0h2m2 0h1m1 0h3m1 0h1m1 0h2m1 0h1M1 24.5h1m5 0h1m1 0h5m3 0h2m1 0h2m3 0h2m1 0h1M1 25.5h1m1 0h3m1 0h1m7 0h2m4 0h5m1 0h3M1 26.5h1m1 0h3m1 0h1m1 0h1m3 0h1m1 0h1m1 0h2m2 0h2m1 0h3m1 0h1M1 27.5h1m1 0h3m1 0h1m1 0h2m1 0h1m1 0h4m2 0h1m1 0h1m1 0h1m2 0h1m1 0h1M1 28.5h1m5 0h1m2 0h4m3 0h1m2 0h3m1 0h1m1 0h1m1 0h1M1 29.5h7m1 0h1m4 0h5m1 0h2m2 0h1m1 0h1m1 0h1" /></svg></div><div class="getapp-modal__stores"><a href="https://apps.apple.com/app/apple-store/id6749206949?pt=127157325&#038;ct=en-getapp-modal-transcript_build-skills-&#038;mt=8" target="_blank" rel="nofollow noopener" data-ga-location="getapp-modal"><img src="https://sozai.app/wp-content/themes/sozai/assets/images/app-store.svg" alt="Download on the App Store" width="120" height="40" loading="lazy"></a><a href="https://play.google.com/store/apps/details?id=com.soz.app&#038;referrer=utm_source%3Dsozai_app%26utm_medium%3Dweb_cta%26utm_campaign%3Dtranscript_build-skills-instead-agents-anthropic%26utm_content%3Dgetapp-modal%26utm_term%3Den" target="_blank" rel="nofollow noopener" data-ga-location="getapp-modal"><img src="https://sozai.app/wp-content/themes/sozai/assets/images/google-play.svg" alt="Get it on Google Play" width="120" height="40" loading="lazy"></a></div></div></div><script>
(function () {
    var modal = document.getElementById('getapp-modal');
    if (!modal) return;

    // The dialog is rendered wherever the first button sits, which may be
    // inside a stacking context (the inked hero uses isolation: isolate).
    // position:fixed cannot escape that, so re-parent it to <body> once.
    if (modal.parentNode !== document.body) {
        document.body.appendChild(modal);
    }

    var lastFocus = null;

    function platform() {
        var ua = navigator.userAgent || '';
        // iPadOS 13+ reports as Macintosh; the touch-point check separates it.
        var iOS = /iPad|iPhone|iPod/.test(ua) ||
                  (/Macintosh/.test(ua) && typeof navigator.maxTouchPoints === 'number' && navigator.maxTouchPoints > 1);
        if (iOS) return 'ios';
        if (/Android/i.test(ua)) return 'android';
        return 'desktop';
    }

    function open(trigger) {
        lastFocus = trigger || document.activeElement;
        modal.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        var close = modal.querySelector('.getapp-modal__close');
        if (close) close.focus();
        document.addEventListener('keydown', onKey);
    }

    function close() {
        modal.hidden = true;
        document.documentElement.style.overflow = '';
        document.removeEventListener('keydown', onKey);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function onKey(e) { if (e.key === 'Escape') close(); }

    modal.querySelectorAll('[data-getapp-close]').forEach(function (el) {
        el.addEventListener('click', close);
    });

    document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('[data-getapp]');
        if (!btn) return;

        var os = platform();
        if (os === 'desktop') {
            e.preventDefault();
            open(btn);
            return;
        }

        var url = btn.getAttribute(os === 'ios' ? 'data-ios' : 'data-android');
        if (!url) return; // fall through to /download/

        e.preventDefault();
        // The href is /download/, so the generic store-hostname tracker in
        // ga4-events.js cannot see this click. Report it explicitly.
        if (typeof window.sozaiTrack === 'function') {
            window.sozaiTrack('app_install_click', {
                platform: os,
                location: btn.dataset.gaLocation || 'get-app',
                page_path: location.pathname,
                page_lang: (document.documentElement.lang || '').slice(0, 5) || 'unknown'
            });
        }
        window.location.href = url;
    });
})();
</script><div id="rw-widget" class="rw-wrap" style="display:none"><div class="rw-typing"><span class="rw-typing-dot"></span><span class="rw-typing-dot"></span><span class="rw-typing-dot"></span></div><div class="rw-bubble" style="position:relative"><button class="rw-close" aria-label="Close">&times;</button><div class="rw-header"><img class="rw-avatar" src="https://sozai.app/wp-content/themes/sozai/assets/images/appicon.png" alt="SozAI" width="36" height="36" loading="lazy" style="border-radius:8px"><div><div class="rw-name">SozAI</div><div class="rw-role">iPhone &middot; Android &middot; Mac</div></div></div><div class="rw-text"></div><div class="rw-buttons"><a class="rw-btn rw-btn--apple" href="https://apps.apple.com/app/apple-store/id6749206949?pt=127157325&#038;ct=en-offer_widget-transcript_build-skills-&#038;mt=8" target="_blank" rel="noopener" data-ga-location="review_widget"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg> App Store </a><a class="rw-btn rw-btn--google" href="https://play.google.com/store/apps/details?id=com.soz.app&#038;referrer=utm_source%3Dsozai_app%26utm_medium%3Dweb_cta%26utm_campaign%3Dtranscript_build-skills-instead-agents-anthropic%26utm_content%3Doffer_widget%26utm_term%3Den" target="_blank" rel="noopener" data-ga-location="review_widget"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626a1 1 0 0 1 0 1.732l-2.807 1.626L15.206 12l2.492-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/></svg> Google Play </a></div></div></div></body></html>