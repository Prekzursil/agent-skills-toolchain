ding-[1.3] font-dia tracking-[-0.02em]"><span class="text-[hsl(17,3%,45%)] font-400 text-[12px] leading-none tracking-normal uppercase">Legal</span><div class="flex flex-col"><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/terms-of-service">Terms of Service</a><a href="/commercial-agreement" target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Commercial Agreement</a><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/privacy-policy">Privacy</a><a href="/subprocessors" target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Subprocessors</a><a href="/dpa" target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">DPA</a><a href="https://docs.replit.com/legal-and-security-info/abuse-report" target="_blank" rel="noopener noreferrer" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Report Abuse</a></div></div><div class="flex flex-col gap-[16px] font-500 text-[21px] leading-[1.3] font-dia tracking-[-0.02em]"><span class="text-[hsl(17,3%,45%)] font-400 text-[12px] leading-none tracking-normal uppercase">Company</span><div class="flex flex-col"><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/about">About Us</a><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/news">News</a><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/careers">Careers</a><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/brand">Brand Center</a><a target="_self" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80" href="/enterprise">Contact Us</a></div></div><div class="flex flex-col gap-[16px] font-500 text-[21px] leading-[1.3] font-dia tracking-[-0.02em]"><span class="text-[hsl(17,3%,45%)] font-400 text-[12px] leading-none tracking-normal uppercase">Social</span><div class="flex flex-col"><a href="https://x.com/replit" target="_blank" rel="noopener noreferrer" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Twitter/X</a><a href="https://www.linkedin.com/company/repl-it/" target="_blank" rel="noopener noreferrer" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Linkedin</a><a href="https://www.instagram.com/repl.it" target="_blank" rel="noopener noreferrer" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Instagram</a><a href="https://www.facebook.com/replit/" target="_blank" rel="noopener noreferrer" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Facebook</a><a href="https://www.tiktok.com/@replit" target="_blank" rel="noopener noreferrer" class="text-[hsl(17,3%,45%)] no-underline hover:opacity-80">Tiktok</a></div></div></div></div></div></div></footer></div></main></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"data":{"_createdAt":"2024-09-12T17:29:40Z","_id":"602df755-ad37-49af-a75e-688cd24d843f","_rev":"T2cpqLQBjnwIAZvsfK5Ve6","_type":"post","_updatedAt":"2025-04-25T20:31:59Z","authors":[{"alumnusOf":null,"bio":null,"bioLong":null,"email":null,"employer":null,"externalUrl":"https://replit.com","image":"https://cdn.sanity.io/images/bj34pdbp/migration/1caa9c698f108ffd46cd8119f002386c8daeb885-400x400.jpg","jobTitle":null,"knowsAbout":null,"knowsLanguages":null,"location":null,"name":"The Replit Team","replitUrl":"https://replit.com/@replit","sameAs":null,"slug":"replit","socialUrl":null}],"body":[{"_key":"4f05a0142c7a","_type":"block","children":[{"_key":"9021bd65784f","_type":"span","marks":[],"text":"Last week, we launched Replit Agent, our AI system that can create and deploy applications. Now, with only a few sentences and a few minutes, you can take an application from idea to deployment."}],"markDefs":[],"style":"normal"},{"_key":"b761311e3c89","_type":"videoFigure","enableControls":true,"youtubeURL":"https://www.youtube.com/embed/aWBiZc5XKJM"},{"_key":"2ae29c4e8ddb","_type":"block","children":[{"_key":"68a395c1e8a3","_type":"span","marks":[],"text":"You can think about the Agent like a pair programmer. It configures your development environment, installs dependencies, and executes code. From your laptop or the Replit mobile app, the Agent is changing how our users build software."}],"markDefs":[],"style":"normal"},{"_key":"f49fb3bc018f","_type":"videoFigure","youtubeURL":"https://www.youtube.com/embed/NZSPy9DN3HU?si=zp2kj-uXa0zuQSXw"},{"_key":"ee62ac497376","_type":"block","children":[{"_key":"dc800ca09a55","_type":"span","marks":[],"text":"If you'd like to learn more, we've compiled some of our favorite examples, tutorials, and articles on the agent so far. "}],"markDefs":[],"style":"normal"},{"_key":"09421828c679","_type":"button","link":"https://replit.com/pricing?utm_source=matt\u0026utm_medium=blog\u0026utm_campaign=introducing-agent","text":"Get started with Replit Core"},{"_key":"b86e7dce3f94","_type":"block","children":[{"_key":"945a78759906","_type":"span","marks":[],"text":"Amazing examples of the Agent"}],"markDefs":[],"style":"h3"},{"_key":"f19a8837337f","_type":"block","children":[{"_key":"cca0c4dc7292","_type":"span","marks":[],"text":"Since launch, we’ve seen resoundingly positive impact from our community. Builders of all types are using our "},{"_key":"7bcdff2a861e","_type":"span","marks":["strong","adbcce62efa7"],"text":"AI app builder"},{"_key":"2e4254273f4d","_type":"span","marks":[],"text":" to create tools that help them drive impact."}],"markDefs":[{"_key":"adbcce62efa7","_type":"link","href":"https://replit.com/usecases/ai-app-builder"}],"style":"normal"},{"_key":"cf66a047150c","_type":"block","children":[{"_key":"a943ca88e448","_type":"span","marks":[],"text":"Custom health dashboards"}],"markDefs":[],"style":"h4"},{"_key":"9b56bbb5b60f","_type":"block","children":[{"_key":"f291d1666d59","_type":"span","marks":[],"text":"A doctor was able to deploy custom dashboards for their patients to help improve health outcomes."}],"markDefs":[],"style":"normal"},{"_key":"34a3ee74a37c","_type":"embed","description":"Agent-built custom health dashboards","url":"https://twitter.com/healthspan_md/status/1834379412848214467"},{"_key":"416b5c228a4f","_type":"block","children":[{"_key":"6e5c8ceebdd8","_type":"span","marks":[],"text":"We're not entirely sure what he means by \"stool heat map,\" but this is the one time we're ok with seeing those words in the same sentence."}],"markDefs":[],"style":"normal"},{"_key":"b2c52d28396b","_type":"block","children":[{"_key":"ec45952ba503","_type":"span","marks":[],"text":"Interactive campus parking map"}],"markDefs":[],"style":"h4"},{"_key":"ace22e90b0f2","_type":"block","children":[{"_key":"4ca2855616b80","_type":"span","marks":[],"text":"If you’ve ever been a student in the US, you know parking on campus can be a nightmare. One Replit user solved parking with a campus map, complete with availability reports."}],"markDefs":[],"style":"normal"},{"_key":"0b9b2cd046b4","_type":"embed","description":"Custom parking maps for easy campus navigation","url":"https://twitter.com/saksham_adh/status/1833922584494440802"},{"_key":"e74f8e6555c6","_type":"block","children":[{"_key":"1e0a1e117112","_type":"span","marks":[],"text":"I certainly wish this was around when I was in school, perhaps I wouldn't have had all those tickets."}],"markDefs":[],"style":"normal"},{"_key":"ef15aed485e4","_type":"block","children":[{"_key":"c15cd9dbf624","_type":"span","marks":[],"text":"Replacing workflow automation tools"}],"markDefs":[],"style":"h4"},{"_key":"e9342c7b3316","_type":"block","children":[{"_key":"dabd4c8ee5350","_type":"span","marks":[],"text":"There are even users replacing expensive workflow automation tools, like Zapier or Make."}],"markDefs":[],"style":"normal"},{"_key":"2f3c13804912","_type":"embed","description":"Replace expensive workflow automation tools with Replit","url":"https://twitter.com/itsPaulAi/status/1833602228692603058"},{"_key":"a68bc73fcc37","_type":"block","children":[{"_key":"df9e301d6739","_type":"span","marks":[],"text":"Stop spending hundreds / thousands on no-/low-code tools. With the Agent, you can build and deploy the solutions you've always wanted."}],"markDefs":[],"style":"normal"},{"_key":"dc92beddd0a9","_type":"block","children":[{"_key":"13b541a2c921","_type":"span","marks":[],"text":"A curated collection of Agent examples"}],"markDefs":[],"style":"h4"},{"_key":"e5620084fa68","_type":"block","children":[{"_key":"a29e2ea113cd","_type":"span","marks":["f63cd8292cf4"],"text":"Andrew Davison"},{"_key":"737386db3cd7","_type":"span","marks":[],"text":" started compiling some of these examples (he built the page with the Agent!) You can check out the full list "},{"_key":"71bfc834fd3d","_type":"span","marks":["9b71dd1f8ad8"],"text":"here"},{"_key":"0ae6fb1d99a4","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"9b71dd1f8ad8","_type":"link","href":"https://this-is-a.replit.app/apps"},{"_key":"f63cd8292cf4","_type":"link","href":"https://x.com/AndrewJDavison"}],"style":"normal"},{"_key":"ba8c72710826","_type":"imageFigure","alt":"Thanks to Andrew Davison for curating some of the first apps built with the Agent!","aspectRatio":1.7206165703275529,"asset":null,"caption":"Thanks to Andrew Davison for curating some of the first apps built with the Agent!","crop":null,"customRatio":null,"dimensions":{"height":3114,"width":5358},"hostedImageURL":null,"hotspot":null,"id":"96c61cbca9f7e54a2be4af98fbd343ceee4bcddc","image":{"_type":"image","asset":{"_ref":"image-96c61cbca9f7e54a2be4af98fbd343ceee4bcddc-5358x3114-png","_type":"reference"}},"lqip":"data:image/png;base64,","type":"image/png","url":"https://cdn.sanity.io/images/bj34pdbp/migration/96c61cbca9f7e54a2be4af98fbd343ceee4bcddc-5358x3114.png"},{"_key":"6bd7d7b1b2bf","_type":"block","children":[{"_key":"a61fb356c4af","_type":"span","marks":[],"text":"Agent reviews and articles"}],"markDefs":[],"style":"h3"},{"_key":"e79e4f3cf65e","_type":"block","children":[{"_key":"2d6e6d79e1180","_type":"span","marks":[],"text":"If you're looking for a full review, here are a few of our favorites. Helena Liu created an excellent walkthrough, available on YouTube."}],"markDefs":[],"style":"normal"},{"_key":"d5333da46d8a","_type":"videoFigure","youtubeURL":"https://www.youtube.com/embed/Lq0FSpimDcs"},{"_key":"3b1d380f9b50","_type":"block","children":[{"_key":"ba342c30cd640","_type":"span","marks":[],"text":"We've also seen some amazing written reviews, though our favorite is this "},{"_key":"86efdcb7ff99","_type":"span","marks":["d0da8f00dc18"],"text":"Maginative article"},{"_key":"3767c2d03025","_type":"span","marks":[],"text":", curtesy of Chris McKay."}],"markDefs":[{"_key":"d0da8f00dc18","_type":"link","href":"https://www.maginative.com/article/tell-replits-ai-agent-your-app-idea-and-itll-code-and-deploy-it-for-you/"}],"style":"normal"},{"_key":"cc1de2d6239c","_type":"block","children":[{"_key":"9bf459bd33b80","_type":"span","marks":[],"text":"The agent is available today in "},{"_key":"9bf459bd33b81","_type":"span","marks":["em"],"text":"early access"},{"_key":"9bf459bd33b82","_type":"span","marks":[],"text":" to all Replit Core subscribers. Though we're continuously improving the product, it should be treated as \"alpha\" software. Still, we're seeing "},{"_key":"7b68d9372604","_type":"span","marks":["em"],"text":"everyone"},{"_key":"3734b29db7c5","_type":"span","marks":[],"text":" benefit from the Agent, regardless of their technical experience."}],"markDefs":[],"style":"normal"},{"_key":"184fc4b30447","_type":"block","children":[{"_key":"fcee77e45ae7","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"da4556f95425","_type":"block","children":[{"_key":"3c5c47a8fc0c","_type":"span","marks":[],"text":"Check it out and start shipping now:"}],"markDefs":[],"style":"normal"},{"_key":"57cd26a5eee4","_type":"button","link":"https://replit.com/pricing?utm_source=matt\u0026utm_medium=blog\u0026utm_campaign=introducing-agent","text":"Get started with Replit Core"},{"_key":"3be7fa4a5f34","_type":"block","children":[{"_key":"17c795e388ed","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"categories":[{"_id":"category-ai","description":null,"slug":"ai","title":"AI"}],"coverImage":{"alt":null,"aspectRatio":1.7787610619469028,"asset":{"_createdAt":"2024-09-12T17:36:20Z","_id":"image-6bbe03f8f6670b91d0939d3b3fb328e105fc89ea-1809x1017-png","_rev":"Er9fVWVp45dHLEOSTbaKaY","_type":"sanity.imageAsset","_updatedAt":"2024-09-12T17:36:20Z","assetId":"6bbe03f8f6670b91d0939d3b3fb328e105fc89ea","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"M66H$fs^Dnj]R_t8ajahocWB00Rx%aaysu","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7787610619469028,"height":1017,"width":1809},"hasAlpha":true,"isOpaque":false,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#302e64","foreground":"#fff","population":0.13,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#1c1464","foreground":"#fff","population":0.13,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#6862a5","foreground":"#fff","population":0.57,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#b2b7c8","foreground":"#000","population":0.22,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#8c74fc","foreground":"#fff","population":0,"title":"#fff"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#6862a5","foreground":"#fff","population":0.57,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#543ce4","foreground":"#fff","population":0,"title":"#fff"}}},"mimeType":"image/png","originalFilename":"Frame 2055246277.png","path":"images/bj34pdbp/migration/6bbe03f8f6670b91d0939d3b3fb328e105fc89ea-1809x1017.png","sha1hash":"6bbe03f8f6670b91d0939d3b3fb328e105fc89ea","size":43749,"uploadId":"TfYLAnZIJKhpBf8GQ1VPM7AIymsm3183","url":"https://cdn.sanity.io/images/bj34pdbp/migration/6bbe03f8f6670b91d0939d3b3fb328e105fc89ea-1809x1017.png"},"crop":null,"customRatio":null,"hotspot":null,"id":"6bbe03f8f6670b91d0939d3b3fb328e105fc89ea","lqip":"data:image/png;base64,","type":"image/png"},"cta":null,"publishedAt":"2024-09-16T17:36:53.567Z","seo":null,"similarPosts":[{"_createdAt":"2026-08-03T16:15:31Z","_id":"ac12093f-5b4f-42d4-87d5-23c3286f9bff","authors":[{"alumnusOf":null,"bio":null,"bioLong":null,"email":null,"employer":"Replit","externalUrl":null,"image":"https://cdn.sanity.io/images/bj34pdbp/migration/a461c2afa749cbd31877184a6cc6fdd0ba576919-512x512.jpg","jobTitle":"Operations Lead","knowsAbout":null,"knowsLanguages":null,"location":null,"name":"Jon Eide","replitUrl":null,"sameAs":["https://www.linkedin.com/in/jonathaneide"],"slug":"jon-eide","socialUrl":null},{"alumnusOf":null,"bio":null,"bioLong":null,"email":null,"employer":"Replit","externalUrl":null,"image":"https://cdn.sanity.io/images/bj34pdbp/migration/71d6c810a3df2bf0af1f18fa60d81c599c7a0f7b-512x512.jpg","jobTitle":"Member of Technical Staff","knowsAbout":null,"knowsLanguages":null,"location":null,"name":"Aadil Hussaini","replitUrl":null,"sameAs":["https://www.linkedin.com/in/aadilhussaini"],"slug":"aadil-hussaini","socialUrl":null}],"categories":[{"_id":"category-ai","description":null,"slug":"ai","title":"AI"},{"_id":"category-eng","description":null,"slug":"eng","title":"Engineering"},{"_id":"category-data","description":null,"slug":"data","title":"Data"}],"coverImage":{"alt":null,"aspectRatio":1.7777777777777777,"asset":{"_createdAt":"2026-08-03T16:17:04Z","_id":"image-a66d3a0fce27c3ba894def847fc0194bce6456a4-1280x720-jpg","_rev":"hxP7FlbP607sJ8JXfVIr9y","_type":"sanity.imageAsset","_updatedAt":"2026-08-03T16:17:04Z","assetId":"a66d3a0fce27c3ba894def847fc0194bce6456a4","extension":"jpg","metadata":{"_type":"sanity.imageMetadata","blurHash":"MESFqoIAV@.8xu%2WVt7t7WV.m%#jFMxRj","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":720,"width":1280},"hasAlpha":false,"isOpaque":true,"lqip":"data:image/jpeg;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#3e423b","foreground":"#fff","population":0.17,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#c24223","foreground":"#fff","population":0.22,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#f13a10","foreground":"#fff","population":1.28,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#b4ccc4","foreground":"#000","population":0.01,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#e89f91","foreground":"#000","population":0.48,"title":"#fff"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#9a5a48","foreground":"#fff","population":0.13,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#f13a10","foreground":"#fff","population":1.28,"title":"#fff"}},"thumbHash":"ehgGDIJzm7iGiHfPV4uJeJCIBw=="},"mimeType":"image/jpeg","originalFilename":"cover-variant-blocks.jpg","path":"images/bj34pdbp/migration/a66d3a0fce27c3ba894def847fc0194bce6456a4-1280x720.jpg","sha1hash":"a66d3a0fce27c3ba894def847fc0194bce6456a4","size":39995,"uploadId":"8e99cf152862dda51b0584cf51cc8de8f50636c8","url":"https://cdn.sanity.io/images/bj34pdbp/migration/a66d3a0fce27c3ba894def847fc0194bce6456a4-1280x720.jpg"},"crop":null,"customRatio":null,"hotspot":null,"id":"a66d3a0fce27c3ba894def847fc0194bce6456a4","lqip":"data:image/jpeg;base64,","type":"image/jpeg"},"publishedAt":"2026-08-03T16:15:17.465Z","seo":null,"slug":"ai-adoption","subtitle":null,"summary":"The semantic layer is the foundation\n\nAI adoption is limited by trust. A user who gets burned by a confidently wrong answer will double-check the next one, eventually routing consequential work around the system entirely. Once that happens, AI remains a tool at the edges rather than infrastructure at the center… useful, but never trusted with the workflows where its value compounds. Before a company can benefit from more capable agents, those agents need a reliable way to know what the company considers true.\n\nA semantic layer tells an agent which tables are sources of truth and how they relate. That's the floor. It is necessary, and it isn't sufficient.\n\nA semantic layer is not plumbing. It is the first act of governance for an AI-native company: the shared definitions of the business, the canonical metrics, the sources of truth, and the relationships an agent is allowed to rely on. Without it, an agent does not have a data problem. It has a language problem: several tables can each look plausible, and the model has no grounded way to know which one means \"revenue,\" \"active user,\" or \"customer.\"\n\nGetting that floor right changes the shape of everything above it. A semantic layer is not the product; it is the shared contract that lets a company safely add a system of specialized capabilities instead of one generic chatbot. Once an agent can ground itself in the right entities, metrics, and relationships, it can reliably run multi-step workflows, call focused tools, retain reviewed knowledge across runs, reuse validation and analysis code, and operate through durable services where work already happens.","title":"AI adoption starts with truth"},{"_createdAt":"2026-07-28T18:09:16Z","_id":"cab064b7-c7a0-4a16-b369-30f0f9b02515","authors":[{"alumnusOf":null,"bio":null,"bioLong":null,"email":null,"employer":null,"externalUrl":"https://replit.com","image":"https://cdn.sanity.io/images/bj34pdbp/migration/1caa9c698f108ffd46cd8119f002386c8daeb885-400x400.jpg","jobTitle":null,"knowsAbout":null,"knowsLanguages":null,"location":null,"name":"The Replit Team","replitUrl":"https://replit.com/@replit","sameAs":null,"slug":"replit","socialUrl":null}],"categories":[{"_id":"category-product","description":null,"slug":"product","title":"Product"},{"_id":"category-ai","description":null,"slug":"ai","title":"AI"}],"coverImage":{"alt":null,"aspectRatio":1.7778936392075078,"asset":{"_createdAt":"2026-07-29T22:33:29Z","_id":"image-4d60c596e06c7d85e57259852cb2cba518a14ea4-1705x959-png","_rev":"mblhZ1nBvr2qdByse2NRK7","_type":"sanity.imageAsset","_updatedAt":"2026-07-29T22:33:29Z","assetId":"4d60c596e06c7d85e57259852cb2cba518a14ea4","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"MGIhEFNG~U%f%LtRRP00IVs8Rj%MtRafV@","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7778936392075078,"height":959,"width":1705},"hasAlpha":true,"isOpaque":false,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#715731","foreground":"#fff","population":6.02,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#563d1e","foreground":"#fff","population":4.44,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#c7b294","foreground":"#000","population":6.37,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#c7b294","foreground":"#000","population":6.37,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#fcecc1","foreground":"#000","population":0.01,"title":"#000"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#a48c68","foreground":"#fff","population":2.23,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#d4814c","foreground":"#fff","population":0.01,"title":"#fff"}},"thumbHash":"4RiKC4IPtYp6YJf6spkPmw8Pi4d0uEg="},"mimeType":"image/png","originalFilename":"Now anyone can be a designer_16x9.png","path":"images/bj34pdbp/migration/4d60c596e06c7d85e57259852cb2cba518a14ea4-1705x959.png","sha1hash":"4d60c596e06c7d85e57259852cb2cba518a14ea4","size":2630716,"uploadId":"f388677add90ee4c105a81a978388b2d0c9e5891","url":"https://cdn.sanity.io/images/bj34pdbp/migration/4d60c596e06c7d85e57259852cb2cba518a14ea4-1705x959.png"},"crop":null,"customRatio":null,"hotspot":null,"id":"4d60c596e06c7d85e57259852cb2cba518a14ea4","lqip":"data:image/png;base64,","type":"image/png"},"publishedAt":"2026-07-29T16:00:00.000Z","seo":null,"slug":"introducing-replit-design","subtitle":"The next era of design, for everyone","summary":"A new creative class is rising: people who see an idea in their mind and refuse to wait to make it.\n\n\n\nToday, we’re launching Replit Design, a new creative suite where anyone can shape what they see as fast as they can think it.\n\n\n\nReplit Design is the fastest way to go from idea to design. Ambient Intelligence guides and inspires you at every step, and because everything lives on Replit, there are no handoffs, exports, or rebuilds that cause you to lose the beauty of what you created.","title":"Introducing Replit Design"},{"_createdAt":"2026-07-16T00:08:28Z","_id":"2cc0b43c-6fc9-4575-8d08-9c80a2ed3105","authors":[{"alumnusOf":null,"bio":"Amjad Masad is a Jordanian American entrepreneur and engineer. He is the founder and CEO of Replit, the world's leading online programming environment and community. Before Replit, Amjad worked at Facebook, overseeing the JavaScript infrastructure team and building some of the world's most popular open-source developer tools. Before that, he was a founding engineer at Codecademy, the world's leading online coding school.","bioLong":null,"email":null,"employer":"Replit","externalUrl":"https://amasad.me","image":"https://cdn.sanity.io/images/bj34pdbp/migration/34acdd3c40a6b8b5de72375b97dfd853818ebfcb-1200x800.jpg","jobTitle":"Founder \u0026 CEO","knowsAbout":null,"knowsLanguages":null,"location":null,"name":"Amjad Masad","replitUrl":"https://replit.com/@amasad","sameAs":["https://www.linkedin.com/in/amjadmasad/","https://x.com/amasad"],"slug":"amjad-masad","socialUrl":"https://github.com/amasad"},{"alumnusOf":null,"bio":"I'm Scott and I manage the Platform Engineering team at Replit. I joined Replit because I think programming is supposed to be about the joy of brining your ideas to life. Replit helps capture that feeling in a way modern software development has forgotten.","bioLong":null,"email":null,"employer":"Replit","externalUrl":"https://www.scottkennedy.us","image":"https://cdn.sanity.io/images/bj34pdbp/migration/6c26147d7163587a724d61e3788f2e84d10fbefb-540x540.jpg","jobTitle":"Engineering Lead","knowsAbout":null,"knowsLanguages":null,"location":null,"name":"Scott Kennedy","replitUrl":"https://replit.com/@scottatreplit","sameAs":["https://www.linkedin.com/in/stkenned/"],"slug":"scott-kennedy","socialUrl":null}],"categories":[{"_id":"category-ai","description":null,"slug":"ai","title":"AI"}],"coverImage":{"alt":null,"aspectRatio":1.7777777777777777,"asset":{"_createdAt":"2026-07-16T17:09:00Z","_id":"image-d52c029ac77689f23a2160c4ef9db64d44ae582b-3600x2025-png","_rev":"l72z3O0hQ2KcBshVn5AjL9","_type":"sanity.imageAsset","_updatedAt":"2026-07-16T17:09:00Z","assetId":"d52c029ac77689f23a2160c4ef9db64d44ae582b","extension":"png","metadata":{"_type":"sanity.imageMetadata","blurHash":"MES60yH?Xm-;xa?ut7RjRjWBy?yDn3RjW;","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":2025,"width":3600},"hasAlpha":false,"isOpaque":true,"lqip":"data:image/png;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#445454","foreground":"#fff","population":0,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#810e03","foreground":"#fff","population":0,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#f91c06","foreground":"#fff","population":0.01,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#b4cca4","foreground":"#000","population":0,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#fcbc74","foreground":"#000","population":0.01,"title":"#fff"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#a86c7c","foreground":"#fff","population":0.01,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#f91c06","foreground":"#fff","population":0.01,"title":"#fff"}},"thumbHash":"eRgGDISRmrqbZoe/ZmNad6B1Bw=="},"mimeType":"image/png","originalFilename":"self-driving-company-cover-current.png","path":"images/bj34pdbp/migration/d52c029ac77689f23a2160c4ef9db64d44ae582b-3600x2025.png","sha1hash":"d52c029ac77689f23a2160c4ef9db64d44ae582b","size":139698,"uploadId":"98c47308102cf1075b92e20949f54a7210ec30fa","url":"https://cdn.sanity.io/images/bj34pdbp/migration/d52c029ac77689f23a2160c4ef9db64d44ae582b-3600x2025.png"},"crop":null,"customRatio":null,"hotspot":null,"id":"d52c029ac77689f23a2160c4ef9db64d44ae582b","lqip":"data:image/png;base64,","type":"image/png"},"publishedAt":"2026-07-16T17:01:00.000Z","seo":null,"slug":"self-driving-company","subtitle":"We are beginning to see what happens when a company learns to operate itself.","summary":"In the past six months, engineers at Replit have nearly tripled code output. Review times held steady. Reversions and product incidents have stayed flat. Quality metrics improved, and releases have accelerated. All the typical trade-offs you might expect have not occurred.\n\n\n\nWhile the code is the visible part, what's happening under the surface is much more interesting.\n\n\n\nAgents now investigate production incidents, review pull requests, answer questions, analyze business data, triage support tickets, research sales accounts, and improve the systems that power Replit Agent itself.\n\n","title":"The Self-Driving Company"}],"slug":"introducing-replit-agent","subtitle":null,"summary":"Last week, we launched Replit Agent, our AI system that can create and deploy applications. Now, with only a few sentences and a few minutes, you can take an application from idea to deployment.\n\nYou can think about the Agent like a pair programmer. It configures your development environment, installs dependencies, and executes code. From your laptop or the Replit mobile app, the Agent is changing how our users build software.\n\nIf you'd like to learn more, we've compiled some of our favorite examples, tutorials, and articles on the agent so far. ","title":"Introducing Replit Agent"},"initial":{"data":{"defaultSeo":{"seo":{"description":null,"image":{"_key":null,"_type":"image","aspectRatio":1.8461538461538463,"asset":{"_createdAt":"2026-03-13T21:10:35Z","_id":"image-f957e195237fea65362557c1d7d299df89f5348d-1200x650-jpg","_rev":"smT5c93Bt6WEZGwrW1V8GI","_type":"sanity.imageAsset","_updatedAt":"2026-03-13T21:10:35Z","assetId":"f957e195237fea65362557c1d7d299df89f5348d","extension":"jpg","metadata":{"_type":"sanity.imageMetadata","blurHash":"MDJZb,00~p00X,9[0zt6=|IU0fR6-AO@rr","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.8461538461538463,"height":650,"width":1200},"hasAlpha":false,"isOpaque":true,"lqip":"data:image/jpeg;base64,","palette":{"_type":"sanity.imagePalette","darkMuted":{"_type":"sanity.imagePaletteSwatch","background":"#583a31","foreground":"#fff","population":9.08,"title":"#fff"},"darkVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#812a14","foreground":"#fff","population":0.43,"title":"#fff"},"dominant":{"_type":"sanity.imagePaletteSwatch","background":"#b37b64","foreground":"#fff","population":9.42,"title":"#fff"},"lightMuted":{"_type":"sanity.imagePaletteSwatch","background":"#d4bdae","foreground":"#000","population":0.12,"title":"#fff"},"lightVibrant":{"_type":"sanity.imagePaletteSwatch","background":"#fcc47c","foreground":"#000","population":0,"title":"#000"},"muted":{"_type":"sanity.imagePaletteSwatch","background":"#b37b64","foreground":"#fff","population":9.42,"title":"#fff"},"vibrant":{"_type":"sanity.imagePaletteSwatch","background":"#bb4520","foreground":"#fff","population":0.36,"title":"#fff"}},"thumbHash":"HlkKDIKzkHlFmJZ