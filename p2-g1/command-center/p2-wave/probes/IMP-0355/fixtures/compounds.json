{
  "independent": [
    {
      "id": "fx-ind-01",
      "text": "What is the p50 latency of checkout, and what is the storage class of the receipts bucket?",
      "clauses": [
        {
          "id": "q-p50",
          "text": "What is the p50 latency of checkout?",
          "binds": ["checkout.p50_latency"],
          "needs": [],
          "domain": "slo"
        },
        {
          "id": "q-storage",
          "text": "What is the storage class of the receipts bucket?",
          "binds": ["receipts.storage_class"],
          "needs": [],
          "domain": "infra"
        }
      ],
      "answers": [
        {
          "sub_id": "q-p50",
          "text": "checkout p50 latency is 120ms",
          "claims": [
            {
              "id": "c-p50",
              "text": "checkout p50 latency is 120ms",
              "value": "120ms",
              "variable": "checkout.p50_latency"
            }
          ]
        },
        {
          "sub_id": "q-storage",
          "text": "receipts bucket storage class is STANDARD_IA",
          "claims": [
            {
              "id": "c-storage",
              "text": "receipts bucket storage class is STANDARD_IA",
              "value": "STANDARD_IA",
              "variable": "receipts.storage_class"
            }
          ]
        }
      ]
