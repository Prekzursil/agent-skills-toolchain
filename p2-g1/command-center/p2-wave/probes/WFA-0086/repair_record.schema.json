{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0086/repair_record.schema.json",
  "title": "WFA-0086 RepairRecord (unit-local). Catalog names wfa-schema-pack.json#/$defs/RepairRecord whose $ref is unresolved on this tree.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "sentinel",
    "question",
    "answer",
    "identity_claim",
    "windows_source",
    "records",
    "summary",
    "controls",
    "control_records",
    "tests",
    "reviewer",
    "evidence",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0086" },
    "record_type": { "type": "string", "const": "RepairRecord" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0086" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "identity_claim": { "type": "string", "minLength": 40 },
    "windows_source": {
      "type": "object",
      "required": ["registry_present", "blueprint_present", "tried_paths", "blocker"],
      "properties": {
        "registry_present": { "type": "boolean" },
        "blueprint_present": { "type": "boolean" },
        "tried_paths": { "type": "array", "minItems": 1 },
        "blocker": { "type": "string", "minLength": 8 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "classification",
          "command",
          "expected",
          "observed",
          "red_reproduced",
          "verbatim_output",
          "second_surface",
          "repair_may_begin",
          "red_test_kept"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 8 },
          "classification": { "type": "string", "const": "REPAIR" },
          "command": { "type": "string", "minLength": 8 },
          "expected": { "type": "string", "minLength": 8 },
          "observed": { "type": "string", "minLength": 4 },
          "verbatim_output": { "type": "string", "minLength": 1 },
          "red_reproduced": { "type": "boolean", "const": true },
          "red_test_kept": { "type": "boolean", "const": true },
          "repair_may_begin": { "type": "boolean", "const": true },
          "second_surface": {
            "type": "object",
            "required": ["kind", "ok", "detail"],
            "properties": {
              "kind": { "type": "string", "minLength": 4 },
              "ok": { "type": "boolean", "const": false },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "repair_candidates",
        "repaired_route_blueprints",
        "red_reproduced",
        "repair_may_begin_true"
      ],
      "properties": {
        "repair_candidates": { "type": "integer", "const": 15 },
        "repaired_route_blueprints": { "type": "integer", "const": 13 },
        "red_reproduced": { "type": "integer", "const": 28 },
        "repair_may_begin_true": { "type": "integer", "const": 28 }
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "no_red_refuses_repair",
        "unreproducible_reclassified",
        "naive_repair_without_red_caught",
        "all_passed"
      ],
      "properties": {
        "no_red_refuses_repair": { "type": "boolean", "const": true },
        "unreproducible_reclassified": { "type": "boolean", "const": true },
        "naive_repair_without_red_caught": { "type": "boolean", "const": true },
        "all_passed": { "type": "boolean", "const": true }
      }
    },
    "control_records": {
      "type": "object",
      "required": ["unreproducible", "no_red"],
      "properties": {
        "unreproducible": {
          "type": "object",
          "required": ["reclassified_to", "repair_may_begin"],
          "properties": {
            "reclassified_to": {
              "type": "string",
              "const": "RECLASSIFIED-UNREPRODUCIBLE"
            },
            "repair_may_begin": { "type": "boolean", "const": false }
          }
        },
        "no_red": {
          "type": "object",
          "required": ["repair_may_begin", "red_reproduced"],
          "properties": {
            "repair_may_begin": { "type": "boolean", "const": false },
            "red_reproduced": { "type": "boolean", "const": false }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "result"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "result": { "type": "string" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" },
        "independent": { "type": "boolean", "const": true }
      }
    },
    "evidence": { "type": "array", "minItems": 4 },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
