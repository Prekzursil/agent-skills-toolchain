    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    transition: all var(--transition);
  }
  
  .feature-card:hover .feature-icon {
    transform: scale(1.1);
    background: var(--color-primary-dark);
  }
  
  .feature-icon i {
    font-size: 1.5rem;
