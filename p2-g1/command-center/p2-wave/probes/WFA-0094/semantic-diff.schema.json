{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WFA-0094 SemanticDiff engine report (local; WFA-0001 pack is absent on this tree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "record_type",
    "state",
    "sentinel",
    "title",
    "question",
    "dimensions",
    "engine",
    "evidence_a",
    "evidence_b",
    "tests",
    "reviewer",
    "residual_unknowns",
    "downstream_consumers",
    "declared_schema",
    "schema_pack_present"
  ],
  "properties": {
    "unit_id": { "const": "WFA-0094" },
    "record_type": { "const": "SemanticDiff" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:WFA-0094" },
    "title": { "type": "string", "minLength": 20 },
    "question": { "type": "string", "minLength": 40 },
    "dimensions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": ["stage", "role", "gate", "tool", "stop-rule"]
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "module",
        "comparison",
        "absent_distinct_from_present_but_different",
        "order_insensitive_as_sets"
      ],
      "properties": {
        "module": { "type": "string" },
        "comparison": { "const": "set-per-dimension" },
        "absent_distinct_from_present_but_different": { "const": true },
        "order_insensitive_as_sets": { "const": true }
      }
    },
    "evidence_a": { "type": "object" },
    "evidence_b": { "type": "object" },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": {
      "type": "object",
      "required": ["verdict", "both_states_rerun"],
      "properties": {
        "verdict": { "const": "PASS" },
        "both_states_rerun": { "const": true }
      }
    },
    "residual_unknowns": { "type": "array", "minItems": 1 },
    "downstream_consumers": { "type": "array", "minItems": 1 },
    "declared_schema": { "type": "string" },
    "schema_pack_present": { "type": "boolean" }
  }
}
