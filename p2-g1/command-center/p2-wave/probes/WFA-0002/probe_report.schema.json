{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Local ProbeReport stand-in for WFA-0002 (the receipt's declared local_schema). The wfa-schema-pack is the declared output_schema; see probe1's pack-delta report.",
  "title": "ProbeReport",
  "type": "object",
  "required": ["record_type", "unit_id", "state", "sentinel", "evidence", "reviewer", "notes"],
  "properties": {
    "record_type": {"const": "ProbeReport"},
    "unit_id": {"const": "WFA-0002"},
    "state": {"const": "SUCCESS"},
    "sentinel": {"const": "SUCCESS:WFA-0002"},
    "completion_sentinel": {"const": "SUCCESS:WFA-0002"},
    "evidence": {"type": "object"},
    "reviewer": {"type": "object"},
    "notes": {"type": "string"},
    "provenance_resolution_rate": {"const": 1.0},
    "provenance_edges_unresolved": {"const": 0}
  }
}
