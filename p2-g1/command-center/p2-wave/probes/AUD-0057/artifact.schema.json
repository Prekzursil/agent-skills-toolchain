{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/AUD-0057/artifact.schema.json",
  "title": "AUD-0057 assertion-strength census (audit-finding)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "report_kind",
    "census",
    "mutation",
    "evidence",
    "tests",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "AUD-0057" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "minLength": 8 },
    "report_kind": { "type": "string", "const": "audit-finding" },
    "census": { "type": "object" },
    "mutation": { "type": "object" },
    "evidence": { "type": "array", "minItems": 3 },
    "tests": { "type": "array", "minItems": 3 },
    "reviewer": { "type": "object" },
    "artifacts": { "type": "array", "minItems": 1 }
  }
}
