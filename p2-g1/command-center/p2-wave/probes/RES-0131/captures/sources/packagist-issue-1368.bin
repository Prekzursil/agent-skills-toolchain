symfony/pull/49831\r\n![Selection_1379](https://user-images.githubusercontent.com/21358010/228387633-92e65e54-e62f-4a7d-b2ff-725e0d79f867.png)\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/composer/packagist/issues/1368/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/composer/packagist/issues/1368/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}