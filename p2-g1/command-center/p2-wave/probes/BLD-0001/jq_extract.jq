[.. | objects | select((.type? == "tool_use") or ((.name? == "Read" or .name? == "Grep" or .name? == "Glob" or .name? == "Bash" or .name? == "Shell") and ((.input? | type) == "object")))][] | {name: (.name // ""), file_path: (.input.file_path // null), path: (.input.path // null), target_directory: (.input.target_directory // null), command: (.input.command // null)} | select(.name != "")
