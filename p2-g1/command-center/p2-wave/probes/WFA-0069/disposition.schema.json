{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/WFA-0069/disposition.schema.json",
  "title": "WFA-0069 ADOPT-AS-IS executable adoption test (DispositionRecord)",
  "description": "Local DispositionRecord used because command-center/wfa/schema/wfa-schema-pack.json is WFA-0001 and is not rebuilt here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "artifacts",
    "both_states",
    "bounds",
    "claims",
    "evidence",
    "expected_adopt_as_is_count",
    "histogram",
    "id",
    "output_schema_declared",
    "question",
    "records",
    "registry",
    "report_kind",
    "reviewer",
    "sentinel",
    "state",
    "tests",
    "unit_id"
  ],
  "properties": {
    "answer": { "type": "string", "minLength": 40 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "both_states": {
      "type": "object",
      "required": [
        "broken_copy_failed_same_smoke",
        "good_passed",
        "unconstructable_reclassified"
      ],
      "properties": {
        "broken_copy_failed_same_smoke": { "type": "boolean", "const": true },
        "good_passed": { "type": "boolean", "const": true },
        "unconstructable_reclassified": { "type": "boolean", "const": true },
        "good_candidate_id": { "type": "string" },
        "broken_candidate_id": { "type": "string" },
        "unconstructable_disposition": { "type": "string" }
      }
    },
    "bounds": {
      "type": "object",
      "required": [
        "max_in_flight",
        "no_network",
        "per_candidate_timeout_s",
        "serialized"
      ],
      "properties": {
        "max_in_flight": { "type": "integer", "maximum": 1 },
        "no_network": { "type": "boolean", "const": true },
        "per_candidate_timeout_s": { "type": "number", "minimum": 0.1 },
        "serialized": { "type": "boolean", "const": true }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "claim", "verdict", "anchor"],
        "properties": {
          "id": { "type": "string" },
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["REFUTED", "CONFIRMED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 8 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "kind": { "type": "string", "minLength": 3 }
        }
      }
    },
    "expected_adopt_as_is_count": { "type": "integer", "const": 122 },
    "histogram": {
      "type": "object",
      "required": ["ADOPT-AS-IS", "UNKNOWN-NEEDS-PROBE"],
      "properties": {
        "ADOPT-AS-IS": { "type": "integer", "minimum": 0 },
        "UNKNOWN-NEEDS-PROBE": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "id": { "type": "string", "const": "WFA-0069" },
    "output_schema_declared": {
      "type": "string",
      "const": "command-center/wfa/schema/wfa-schema-pack.json#/$defs/DispositionRecord"
    },
    "question": { "type": "string", "minLength": 40 },
    "records": {
      "type": "array",
      "minItems": 122,
      "maxItems": 122,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "disposition",
          "prior_classification",
          "reason",
          "receipt_path",
          "smoke_run"
        ],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 3 },
          "discovery_id_known": { "type": "boolean" },
          "disposition": {
            "type": "string",
            "enum": [
              "ADOPT-AS-IS",
              "ADOPT-WITH-WRAPPER",
              "CLEAN-ROOM-REIMPLEMENT",
              "COMPOSE",
              "DISTILL",
              "EXTEND",
              "GENERALIZE",
              "MERGE",
              "REBUILD-FROM-SPEC",
              "REJECT",
              "REPAIR",
              "RETIRE",
              "SPECIALIZE",
              "TRANSLATE",
              "UNKNOWN-NEEDS-PROBE"
            ]
          },
          "prior_classification": { "type": "string", "const": "ADOPT-AS-IS" },
          "reason": { "type": "string", "minLength": 8 },
          "receipt_bytes": { "type": "integer", "minimum": 1 },
          "receipt_path": { "type": "string", "minLength": 8 },
          "receipt_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
          "smoke_run": {
            "type": "object",
            "required": ["command", "constructed", "terminal"],
            "properties": {
              "command": { "type": "string", "minLength": 8 },
              "constructed": { "type": "boolean" },
              "exit_code": { "type": ["integer", "null"] },
              "source_unchanged": { "type": ["boolean", "null"] },
              "terminal": { "type": "string", "minLength": 3 },
              "timeout_s": { "type": "number" }
            }
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "required": ["found", "searched_paths"],
      "properties": {
        "found": { "type": "boolean" },
        "path": { "type": ["string", "null"] },
        "searched_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "sha256": { "type": ["string", "null"] },
        "adopt_as_is_count": { "type": "integer", "minimum": 0 }
      }
    },
    "report_kind": { "type": "string", "const": "DispositionRecord" },
    "reviewer": {
      "type": "object",
      "required": ["independent", "reviewer_id", "verdict"],
      "properties": {
        "independent": { "type": "boolean", "const": true },
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "const": "PASS" }
      }
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0069" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "tests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "ts": { "type": "string" },
    "unit_id": { "type": "string", "const": "WFA-0069" }
  }
}
