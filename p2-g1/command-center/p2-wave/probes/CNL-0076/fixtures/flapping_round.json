{
  "comment": "Intra-round flap: predicate true after turn 1, false at round end. Halt must follow the frozen end-of-round snapshot, not the mid-round peak.",
  "expression": {
    "op": "cmp",
    "rel": ">=",
    "left": {"op": "var", "name": "unique_ideas"},
    "right": {"op": "const", "value": 100}
  },
  "cases": [
    {
      "id": "flap-true-then-false",
      "turns": [
        {"id": "t1", "metrics": {"unique_ideas": 120, "round": 1}},
        {"id": "t2", "metrics": {"unique_ideas": 90, "round": 1}},
        {"id": "t3", "metrics": {"unique_ideas": 90, "round": 1}}
      ],
      "expected_halt": false,
      "expected_result": false,
      "expected_path": [true, false, false]
    },
    {
      "id": "flap-false-then-true-at-round-end",
      "turns": [
        {"id": "t1", "metrics": {"unique_ideas": 40, "round": 2}},
        {"id": "t2", "metrics": {"unique_ideas": 130, "round": 2}},
        {"id": "t3", "metrics": {"unique_ideas": 110, "round": 2}}
      ],
      "expected_halt": true,
      "expected_result": true,
      "expected_path": [false, true, true]
    },
    {
      "id": "stable-false",
      "turns": [
        {"id": "t1", "metrics": {"unique_ideas": 10, "round": 3}},
        {"id": "t2", "metrics": {"unique_ideas": 11, "round": 3}}
      ],
      "expected_halt": false,
      "expected_result": false,
      "expected_path": [false, false]
    }
  ]
}
