{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ADV-0127/fault-injection-run.schema.json",
  "title": "ADV-0127 clock-skew fault-injection run",
  "description": "Discriminating contract for ADV-0127. Catalog output_schema cites command-center/schema/fault-injection-run.schema.json which is absent on this tree (shim would live under platform/schema). Garbage objects, BLOCKED-only stubs, and a state:=SUCCESS mutant without targets/probes/controls are rejected.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "report_kind",
    "overall_verdict",
    "question",
    "headline_answer",
    "targets",
    "tests",
    "controls",
    "negative_tests",
    "evidence",
    "named_probes",
    "reviewer",
    "artifacts"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "ADV-0127" },
    "state": { "type": "string", "enum": ["SUCCESS", "PARTIAL"] },
    "sentinel": { "type": "string", "minLength": 16 },
    "completion_sentinel": { "type": "string", "minLength": 40 },
    "report_kind": { "type": "string", "const": "fault-injection-run" },
    "overall_verdict": {
      "type": "string",
      "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
    },
    "question": { "type": "string", "minLength": 40 },
    "headline_answer": { "type": "string", "minLength": 40 },
    "targets": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED", "BLOCKED"]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "negative_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "object" }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "command", "raw_output"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "command": { "type": "string", "minLength": 8 },
          "raw_output": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
