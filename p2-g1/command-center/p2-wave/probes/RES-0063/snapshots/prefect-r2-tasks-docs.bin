<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">        self</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">.adjusted_rate </span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#0550AE;--shiki-dark:#569CD6"> self</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">.base_rate </span><span style="color:#CF222E;--shiki-dark:#D4D4D4">*</span><span style="color:#0550AE;--shiki-dark:#B5CEA8"> 1.5</span></span>
