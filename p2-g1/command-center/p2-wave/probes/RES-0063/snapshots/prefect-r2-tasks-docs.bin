on\":\"The runtime context allows global access to information about the current run.\",\"keywords\":[\"runtime context\",\"flow run\",\"task run\",\"metadata\",\"run information\"],\"href\":\"/v3/concepts/runtime-context\"},{\"title\":\"Artifacts\",\"description\":\"Artifacts are persisted outputs designed for human consumption and available in the UI.\",\"keywords\":[\"artifact\",\"markdown\",\"table\",\"result\",\"UI\",\"report\"],\"href\":\"/v3/concepts/artifacts\"},{\"title\":\"Task runners\",\"description\":\"Learn about task runners for concurrent, parallel or distributed execution of tasks.\",\"keywords\":[\"task runner\",\"concurrent\",\"parallel\",\"distributed\",\"ThreadPoolTaskRunner\",\"DaskTaskRunner\",\"RayTaskRunner\"],\"href\":\"/v3/concepts/task-runners\"},{\"title\":\"Global concurrency limits\",\"description\":\"Understand how global concurrency limits control execution and manage resource usage.\",\"keywords\":[\"concurrency\",\"concurrency limits\",\"rate limits\",\"resource management\",\"execution control\",\"slot decay\",\"task orchestration\"],\"href\":\"/v3/concepts/global-concurrency-limits\"},{\"title\":\"Tag-based concurrency limits\",\"description\":\"Understand how tag-based concurrency limits prevent too many tasks from running simultaneously.\",\"keywords\":[\"concurrency\",\"concurrency limits\",\"task tags\",\"task orchestration\",\"execution behavior\",\"resource management\",\"parallel processing\"],\"href\":\"/v3/concepts/tag-based-concurrency-limits\"}]},{\"group\":\"Deployments\",\"pages\":[{\"title\":\"Deployments\",\"sidebarTitle\":\"Deployments\",\"description\":\"Learn how to use deployments to trigger flow runs remotely.\",\"keywords\":[\"deployment\",\"remote execution\",\"schedule\",\"trigger\",\"serve\",\"deploy\",\"naming\"],\"href\":\"/v3/concepts/deployments\"},{\"title\":\"Schedule flow runs\",\"sidebarTitle\":\"Schedules\",\"description\":\"Prefect can schedule when to automatically create new flow runs.\",\"keywords\":[\"schedule\",\"cron\",\"interval\",\"rrule\",\"recurring\",\"automated\"],\"href\":\"/v3/concepts/schedules\"},{\"title\":\"Work pools\",\"description\":\"Learn how to configure dynamic infrastructure provisioning with work pools\",\"keywords\":[\"work pool\",\"infrastructure\",\"dynamic provisioning\",\"worker\",\"execution environment\"],\"href\":\"/v3/concepts/work-pools\"},{\"title\":\"Workers\",\"description\":\"Workers poll work pools for new runs to execute.\",\"keywords\":[\"worker\",\"work pool\",\"polling\",\"execution\",\"infrastructure\",\"agent\"],\"href\":\"/v3/concepts/workers\"}]},{\"group\":\"Configuration\",\"pages\":[{\"title\":\"Variables\",\"description\":\"Variables are dynamically-named, mutable JSON values that can be used to store and reuse non-sensitive bits of data.\",\"keywords\":[\"variable\",\"configuration\",\"dynamic\",\"key-value\",\"reusable\"],\"href\":\"/v3/concepts/variables\"},{\"title\":\"Blocks\",\"description\":\"Prefect blocks allow you to manage configuration schemas, infrastructure, and secrets for use with deployments or flow scripts.\",\"keywords\":[\"block\",\"configuration\",\"credentials\",\"infrastructure\",\"storage\",\"secret\"],\"href\":\"/v3/concepts/blocks\"},{\"title\":\"Settings and profiles\",\"description\":\"Prefect settings let you customize behavior across different environments.\",\"keywords\":[\"settings\",\"profile\",\"configuration\",\"environment variable\",\"PREFECT_API_URL\"],\"href\":\"/v3/concepts/settings-and-profiles\"},{\"title\":\"Prefect server\",\"description\":\"Self-host your own Prefect server instance.\",\"keywords\":[\"server\",\"self-hosted\",\"API\",\"database\",\"SQLite\",\"PostgreSQL\"],\"href\":\"/v3/concepts/server\"},{\"title\":\"Telemetry\",\"sidebarTitle\":\"Telemetry\",\"description\":\"Learn about Prefect's anonymous usage telemetry\",\"keywords\":[\"telemetry\",\"analytics\",\"anonymous usage\",\"opt-out\",\"privacy\"],\"href\":\"/v3/concepts/telemetry\"}]},{\"group\":\"Automations\",\"pages\":[{\"title\":\"Events\",\"description\":\"An event is a notification of a change - a record of activity in your stack.\",\"keywords\":[\"event\",\"notification\",\"activity\",\"observability\",\"event stream\"],\"href\":\"/v3/concepts/events\"},{\"title\":\"Automations\",\"description\":\"Learn how to automatically take action in response to events.\",\"keywords\":[\"automation\",\"action\",\"trigger\",\"event-driven\",\"reactive\",\"notification\"],\"href\":\"/v3/concepts/automations\"},{\"title\":\"Define event triggers\",\"sidebarTitle\":\"Event triggers\",\"description\":\"Define a custom trigger to react to many kinds of events and metrics.\",\"keywords\":[\"event trigger\",\"automation\",\"reactive\",\"trigger condition\",\"custom trigger\"],\"href\":\"/v3/concepts/event-triggers\"}]},{\"group\":\"Prefect Cloud\",\"pages\":[{\"title\":\"Rate limits and data retention\",\"description\":\"Understand Prefect Cloud's API rate limits, request size limits, and data retention policies.\",\"keywords\":[\"rate limits\",\"data retention\",\"prefect cloud\",\"api rate limits\",429,\"throttling\",\"request size\",413,\"payload size\"],\"href\":\"/v3/concepts/rate-limits\"},{\"title\":\"Measure reliability with Service Level Agreements\",\"sidebarTitle\":\"SLAs\",\"description\":\"Define the performance expectations for your flows and to enable automated alerts when those expectations are not met.\",\"keywords\":[\"SLA\",\"service level agreement\",\"reliability\",\"alerts\",\"monitoring\",\"performance\"],\"href\":\"/v3/concepts/slas\"},{\"title\":\"Webhooks\",\"description\":\"Understand Prefect Cloud webhooks, their configuration, and how to use templates to transform incoming HTTP requests into Prefect events.\",\"keywords\":[\"webhook\",\"HTTP\",\"event\",\"template\",\"Prefect Cloud\",\"external trigger\"],\"href\":\"/v3/concepts/webhooks\"}]}]},{\"tab\":\"How-to Guides\",\"pages\":[{\"title\":\"How-to Guides\",\"href\":\"/v3/how-to-guides\"}]},{\"tab\":\"Advanced\",\"pages\":[{\"title\":\"Advanced\",\"href\":\"/v3/advanced\"}]},{\"tab\":\"Examples\",\"pages\":[{\"title\":\"Examples\",\"href\":\"/v3/examples\"}]},{\"tab\":\"Integrations\",\"pages\":[{\"title\":\"Integrations\",\"href\":\"/integrations/integrations\"}]},{\"tab\":\"API Reference\",\"pages\":[{\"title\":\"API Reference\",\"href\":\"/v3/api-ref\"}]},{\"tab\":\"Contribute\",\"pages\":[{\"title\":\"Contribute\",\"href\":\"/contribute\"}]},{\"tab\":\"Release Notes\",\"pages\":[{\"title\":\"Release Notes\",\"href\":\"/v3/release-notes\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L37\"}]\n"])</script><script>self.__next_f.push([1,"38:I[604804,[\"/mintlify-assets/_next/static/chunks/19ae1768f166fab9.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/f5976305ab1768eb.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/a5edc6734daa1561.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/d36f426683a01ecd.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/cde9521bba917b79.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/0890ba15c670d9b1.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/8778b596bb8e1fac.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/e88058605a510f6f.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/3df48e92ab491c72.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/cfd727ba62f1c54c.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/95810dccb4b634b5.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintlify-assets/_next/static/chunks/cc5fb492c7259b04.js?dpl=dpl_CMw9JJ1UMoMP34UCdriEg3MQPWU8\",\"/mintl