<span class="line"></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#C586C0">from</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> prefect </span><span style="color:#CF222E;--shiki-dark:#C586C0">import</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> flow, task</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#C586C0">from</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> prefect.utilities.annotations </span><span style="color:#CF222E;--shiki-dark:#C586C0">import</span><span style="color:#1F2328;--shiki-dark:#D4D4D4"> quote</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span style="color:#8250DF;--shiki-dark:#DCDCAA">@dataclass</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#569CD6">class</span><span style="color:#953800;--shiki-dark:#4EC9B0"> Pipeline</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">:</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">    base_rate: </span><span style="color:#0550AE;--shiki-dark:#4EC9B0">float</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#D4D4D4">    adjusted_rate: </span><span style="color:#0550AE;--shiki-dark:#4EC9B0">float</span><span style="color:#CF222E;--shiki-dark:#D4D4D4"> =</span><span style="color:#0550AE;--shiki-dark:#B5CEA8"> 0.0</span></span>
<span class="line"></span>
