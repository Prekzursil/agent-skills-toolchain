nh6 {\n  font-family: \"Roboto\", sans-serif;\n}\n\n/* Other custom styles */\np {\n  font-family: \"Inter\", sans-serif;\n}\n\n[role=\"listitem\"] *:last-child:not(.code-block, .link) {\n  border-bottom: none !important;\n}\n\n/* Cloud-only feature badge.\n   Used as `\u003cspan class=\"badge cloud\"\u003e\u003c/span\u003e` on its own line to mark the\n   section or page that follows as available only in Prefect Cloud. The label\n   is supplied here so authors only need the empty span. */\n.badge {\n  display: table;\n  margin: 0 0 1rem;\n  font-family: \"Inter\", sans-serif;\n  font-size: 0.6875rem;\n  font-weight: 600;\n  line-height: 1;\n  letter-spacing: 0.02em;\n  text-transform: uppercase;\n  padding: 0.35em 0.6em;\n  border-radius: 0.375rem;\n  white-space: nowrap;\n}\n\n.badge.cloud {\n  color: #fff;\n  background-color: #2d6df6;\n}\n\n.badge.cloud::after {\n  content: \"Prefect Cloud\";\n}\n"])</script><script>self.__next_f.push([1,"49:[\"$\",\"$L4a\",null,{\"theme\":\"mint\",\"pageMetadata\":{\"title\":\"Caching\",\"keywords\":[\"cache\",\"caching\",\"cache key\",\"result caching\",\"memoization\",\"cache policy\"],\"description\":null,\"href\":\"/v3/concepts/caching\"},\"children\":[\"$\",\"$L4b\",null,{\"value\":{\"apiReferenceData\":{},\"graphqlReferenceData\":\"$undefined\"},\"children\":[\"$\",\"$L4c\",null,{\"value\":{\"pageMetadata\":\"$49:props:pageMetadata\",\"lastModified\":\"2026-08-20T19:28:31.205Z\",\"gitLastModified\":\"$undefined\",\"originalFileLocation\":\"v3/concepts/caching.mdx\",\"description\":null,\"mdxExtracts\":{\"tableOfContents\":[{\"title\":\"Cache keys\",\"slug\":\"cache-keys\",\"depth\":2,\"children\":[]},{\"title\":\"Cache policies\",\"slug\":\"cache-policies\",\"depth\":2,\"children\":[]},{\"title\":\"Customizing the cache\",\"slug\":\"customizing-the-cache\",\"depth\":2,\"children\":[{\"title\":\"Cache expiration\",\"slug\":\"cache-expiration\",\"depth\":3,\"children\":[]},{\"title\":\"Cache policies\",\"slug\":\"cache-poli