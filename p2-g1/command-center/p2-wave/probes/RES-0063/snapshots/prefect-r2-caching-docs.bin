<span class="line"></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#569CD6">def</span><span style="color:#8250DF;--shiki-dark:#DCDCAA"> static_cache_key</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">(</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">context</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">, </span><span style="color:#1F2328;--shiki-dark:#9CDCFE">parameters</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">):</span></span>
<span class="line"><span style="color:#6E7781;--shiki-dark:#6A9955">    # return a constant</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#C586C0">    return</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;static cache key&quot;</span></span>
<span class="line"></span>
<span class="line"></span>
<span class="line"><span style="color:#8250DF;--shiki-dark:#DCDCAA">@task</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">(</span><span style="color:#953800;--shiki-dark:#9CDCFE">cache_key_fn</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">static_cache_key)</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#569CD6">def</span><span style="color:#8250DF;--shiki-dark:#DCDCAA"> my_cached_task</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">(</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">x</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0550AE;--shiki-dark:#4EC9B0">int</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">):</span></span>
