r:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`(`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`x`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#4EC9B0`},children:`int`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`):`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#C586C0`},children:`    return`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:` x `}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`+`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:` 1`})]}),`\n`]})})}),`\n`,_jsx(Heading,{level:`3`,id:`cache-storage`,children:`Cache storage`}),`\n`,_jsxs(_components.p,{children:[`By default, cache records are collocated with task results and files containing task results will include metadata used for caching.\nConfiguring a cache policy with a `,_jsx(_components.code,{children:`key_storage`}),` argument allows cache records to be stored separately from task results.`]}),`\n`,_jsx(_components.p,{children:`When cache key storage is configured, persisted task results will only include the return value of your task and cache records can be deleted or modified\nwithout effecting your task results.`}),`\n`,_jsxs(_components.p,{children:[`You can configure where cache records are stored by using the `,_jsx(_components.code,{children:`.configure`}),` method with a `,_jsx(_components.code,{children:`key_storage`}),` argument on a cache policy.\nThe `,_jsx(_components.code,{children:`key_storage`}),` argument accepts either a path to a local directory or a storage block.`]}),`\n`,_jsx(Heading,{level:`3`,id:`cache-isolation`,children:`Cache isolation`}),`\n`,_jsxs(_components.p,{children:[`Cache isolation controls how concurrent task runs interact with cache records. Prefect supports two isolation levels: `,_jsx(_components.code,{children:`READ_COMMITTED`}),` and `,_jsx(_components.code,{children:`SERIALIZABLE`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`By default, cache records operate with a `,_jsx(_components.code,{children:`READ_COMMITTED`}),` isolation level. This guarantees that reading a cache record will see the latest committed cache value,\nbut allows multiple executions of the same task to occur simultaneously.`]}),`\n`,_jsxs(_components.p,{children:[`For stricter isolation, you can use the `,_jsx(_components.code,{children:`SERIALIZABLE`}),` isolation level. This ensures that only one execution of a task occurs at a time for a given cache\nrecord via a locking mechanism.`]}),`\n`,_jsxs(_components.p,{children:[`To configure the isolation level, use the `,_jsx(_components.code,{children:`.configure`}),` method with an `,_jsx(_components.code,{children:`isolation_level`}),` argument on a cache policy. When using `,_jsx(_components.code,{children:`SERIALIZABLE`}),`, you must\nalso provide a `,_jsx(_components.code,{children:`lock_manager`}),` that implements locking logic for your system.`]}),`\n`,_jsx(Heading,{level:`4`,id:`recommended-lock-managers-by-execution-context`,children:`Recommended Lock Managers by Execution Context`}),`\n`,_jsx(_components.p,{children:`We recommend using a locking implementation that matches how you are running your work concurrently.`}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Execution Context`}),_jsx(_components.th,{children:`Recommended Lock Manager`}),_jsx(_components.th,{children:`Notes`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Threads/Coroutines`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`MemoryLockManager`})}),_jsx(_components.td,{children:`In-memory locking suitable for single-process execution`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Processes`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`FileSystemLockManager`})}),_jsx(_components.td,{children:`File-based locking for multiple processes on same machine`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Multiple Machines`}),_jsx(_components.td,{children:_jsx(_components.code,{children:`RedisLockManager`})}),_jsx(_components.td,{children:`Distributed locking via Redis for cross-machine coordination`})]})]})]}),`\n`,_jsx(Heading,{level:`2`,id:`multi-task-caching`,children:`Multi-task caching`}),`\n`,_jsxs(_components.p,{children:[`There are some situations in which multiple tasks need to always run together or not at all.\nThis can be achieved in Prefect by configuring these tasks to always write to their caches within\na single `,_jsx(_components.a,{href:`/v3/develop/transactions`,children:_jsx(_components.em,{children:`transaction`})}),`.`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L59\",null,{\"slug\":\"v3/concepts/caching\",\"pageMetadata\":\"$49:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5a\",null,{\"mdxSource\":{\"compiledSource\":\"$5b\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"Caching\",\"keywords\":[\"cache\",\"caching\",\"cache key\",\"result caching\",\"memoization\",\"cache policy\"],\"href\":\"/v3/concepts/caching\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"docs.prefect.io