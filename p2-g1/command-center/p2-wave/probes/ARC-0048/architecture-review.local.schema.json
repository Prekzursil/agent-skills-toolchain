{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/ARC-0048/architecture-review.local.schema.json",
  "title": "ARC-0048 architecture-review (unit-local; catalog schema is a remote $ref shim)",
  "$comment": "command-center/schema/architecture-review.schema.json $refs ast-integrate.invalid and Draft7Validator would fetch. This envelope rejects garbage and requires the G-1 fields probes actually read.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "question",
    "answer",
    "claims",
    "evidence",
    "escalation_paths",
    "marker_payload",
    "reviewer",
    "report",
    "adv_rebuild_circle"
  ],
  "properties": {
    "unit_id": { "const": "ARC-0048" },
    "state": { "type": "string", "enum": ["SUCCESS"] },
    "sentinel": { "const": "SUCCESS:ARC-0048" },
    "completion_sentinel": { "const": "SUCCESS:ARC-0048" },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "adv_rebuild_circle": { "const": false },
    "claims": {
      "type": "array",
      "minItems": 3
    },
    "evidence": {
      "type": "array",
      "minItems": 2
    },
    "escalation_paths": {
      "type": "array",
      "minItems": 8
    },
    "marker_payload": {
      "type": "object",
      "required": [
        "intact_any_reached",
        "mutant_any_reached",
        "mention_silent"
      ],
      "properties": {
        "intact_any_reached": { "const": false },
        "mutant_any_reached": { "const": true },
        "mention_silent": { "const": true }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "scope_not_agreement"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "const": "PASS" },
        "independent": { "const": true },
        "scope_not_agreement": { "const": true }
      }
    },
    "report": {
      "type": "object",
      "required": ["kind", "observations", "control_ids"],
      "properties": {
        "kind": { "const": "architecture-review" },
        "observations": {
          "type": "array",
          "minItems": 1
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
