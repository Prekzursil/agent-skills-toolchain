{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-center/p2-wave/probes/WFA-0084/handoff-contract.schema.json",
  "title": "WFA-0084 HandoffContract (unit-local; catalog pack WFA-0001 is a separate unit)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "state",
    "sentinel",
    "completion_sentinel",
    "schema_version",
    "record_type",
    "title",
    "question",
    "interface",
    "query_types",
    "producers",
    "consumers",
    "residual_unknowns",
    "evidence",
    "tests",
    "reviewer",
    "artifacts",
    "scope",
    "named_probes"
  ],
  "properties": {
    "unit_id": { "type": "string", "const": "WFA-0084" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "BLOCKED", "FAILED", "TIMEOUT", "SEVERED"]
    },
    "sentinel": { "type": "string", "const": "SUCCESS:WFA-0084" },
    "completion_sentinel": { "type": "string", "minLength": 16 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "record_type": { "type": "string", "const": "HandoffContract" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "interface": {
      "type": "object",
      "required": [
        "version",
        "schema_fingerprint",
        "module",
        "query_method",
        "empty_result_status",
        "error_ids_are_null"
      ],
      "properties": {
        "version": { "type": "string" },
        "schema_fingerprint": { "type": "string", "minLength": 64, "maxLength": 64 },
        "module": { "type": "string" },
        "query_method": { "type": "string" },
        "empty_result_status": { "type": "string", "const": "EMPTY" },
        "error_ids_are_null": { "type": "boolean", "const": true }
      }
    },
    "query_types": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string" }
    },
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "present", "role"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "present": { "type": "boolean" },
          "role": { "type": "string" }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "driven_through", "module"],
        "properties": {
          "id": { "type": "string" },
          "driven_through": { "type": "string" },
          "module": { "type": "string" }
        }
      }
    },
    "residual_unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "settling_experiment"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "settling_experiment": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["signal_a", "signal_b"],
      "properties": {
        "signal_a": { "type": "object" },
        "signal_b": { "type": "object" }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] },
          "detail": { "type": "string" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent"],
      "properties": {
        "reviewer_id": { "type": "string" },
        "verdict": { "type": "string" },
        "independent": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "role": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["proof_surface", "does_not_claim"],
      "properties": {
        "proof_surface": { "type": "string" },
        "does_not_claim": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        }
      }
    },
    "named_probes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "catalog_output_schema": { "type": "string" },
    "schema_pack_present": { "type": "boolean" },
    "produced_by": { "type": "object" },
    "cloud_ok": { "type": "boolean" },
    "captured_at": { "type": "string" }
  }
}
