{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-center/p2-wave/probes/BLD-0010/coverage_matrix.schema.json",
  "title": "BLD-0010 locale/codepage/timezone coverage matrix (local; catalog coverage-matrix.schema.json is absent on this tree)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "record_type",
    "report_kind",
    "unit_id",
    "id",
    "state",
    "sentinel",
    "completion_sentinel",
    "title",
    "question",
    "answer",
    "axes",
    "cells",
    "sites",
    "environment_runs",
    "tests",
    "evidence",
    "negative_controls",
    "reviewer",
    "artifacts",
    "catalog_schema_present",
    "b08_smoke_set_present",
    "min_bytes_threshold"
  ],
  "properties": {
    "record_type": { "type": "string", "const": "CoverageMatrix" },
    "report_kind": { "type": "string", "const": "coverage-matrix" },
    "unit_id": { "type": "string", "const": "BLD-0010" },
    "id": { "type": "string", "const": "BLD-0010" },
    "state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL"]
    },
    "sentinel": { "type": "string", "pattern": "^SUCCESS:BLD-0010" },
    "completion_sentinel": { "type": "string", "pattern": "SUCCESS:BLD-0010" },
    "title": { "type": "string", "minLength": 16 },
    "question": { "type": "string", "minLength": 40 },
    "answer": { "type": "string", "minLength": 40 },
    "axes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "label": { "type": "string", "minLength": 8 }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "site_kind", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "site_kind": {
            "type": "string",
            "enum": ["datetime", "sort", "console", "timestamped-filename", "smoke"]
          },
          "status": {
            "type": "string",
            "enum": ["EVIDENCED", "HONEST-NULL", "EMPTY", "FAIL"]
          }
        }
      }
    },
    "sites": {
      "type": "object",
      "required": ["scanned_root", "counts"],
      "properties": {
        "scanned_root": { "type": "string", "minLength": 3 },
        "counts": { "type": "object" }
      }
    },
    "environment_runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requested",
          "actual",
          "pythonioencoding_set"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "requested": { "type": "object" },
          "actual": { "type": "object" },
          "pythonioencoding_set": { "type": "boolean" }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "command": { "type": "string", "minLength": 8 },
          "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT-RUN"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["claim", "verdict", "anchor"],
        "properties": {
          "claim": { "type": "string", "minLength": 8 },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "REFUTED", "PARTIAL", "NOT-CHECKED"]
          },
          "anchor": { "type": "string", "minLength": 3 }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "description",
          "fired_on_bad_state",
          "silent_on_good_state"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "kind": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 16 },
          "fired_on_bad_state": { "type": "boolean" },
          "silent_on_good_state": { "type": "boolean" }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "required": ["reviewer_id", "verdict", "independent", "scope_not_agreement"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 8 },
        "verdict": { "type": "string", "enum": ["PASS"] },
        "independent": { "type": "boolean", "const": true },
        "scope_not_agreement": { "type": "boolean", "const": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "exists", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 8 },
          "exists": { "type": "boolean", "const": true },
          "role": { "type": "string", "minLength": 3 }
        }
      }
    },
    "catalog_schema_present": { "type": "boolean" },
    "b08_smoke_set_present": { "type": "boolean" },
    "min_bytes_threshold": { "type": "integer", "minimum": 512 }
  }
}
