   "answer": {
    "cnl_0059_interaction": "Instant-unanimity suspicion (round 1, no independent briefs) holds finalization as AGREEMENT_HELD_FOR_REVALUATION. Timer exhaustion at round 12 with disagreement never takes that path and must not be read as unanimity or as instant unanimity.",
    "consumer_must_key": [
     "outcome_kind",
     "unanimity",
     "stop_reason",
     "branch_fired"
    ],
    "consumer_must_not_key": [
     "stopped",
     "expression_true"
    ],
    "timer_distinguishable_from_unanimity": true,
    "when_both_at_round_12": {
     "note": "Not TIMER_EXHAUSTION. Agreement is retained.",
     "outcome_kind": "AGREEMENT_AT_CEILING",
     "stop_reason": "BOTH",
     "unanimity": true
    },
    "when_real_unanimity": {
     "branch_fired": [
      "unanimity == true"
     ],
     "expression_true": true,
     "outcome_kind": "AGREEMENT",
     "stop_reason": "UNANIMITY",
     "stopped": true,
     "unanimity": true
    },
    "when_timer_not_agreement": {
     "branch_fired": [
      "max_rounds == 12"
     ],
     "expression_true": true,
     "instant_unanimity_trigger": false,
     "outcome_kind": "TIMER_EXHAUSTION",
     "stop_reason": "MAX_ROUNDS",
     "stopped": true,
     "unanimity": false
    },
    "why": "The disjunction is true for two different worlds. If the outcome record only says stopped=true, a downstream consumer cannot tell persuasion-failed-at-the-ceiling from all-seats-agreed. The record therefore keeps vote-state unanimity independent of stop_reason, and names TIMER_EXHAUSTION as a distinct outcome_kind from AGREEMENT."
   },
   "bindings": {
    "max_rounds": {
     "binds_to": "clock.round_index",
     "configured_ceiling_field": "stopping.configured_max_rounds",
     "literal_12": 12,
     "rule": "1-based index of the round just completed. Must NOT bind to stopping.configured_max_rounds: when the ceiling is 12, max_rounds == 12 would be a tautology and the disjunction would FIRE on round 1 with no agreement."
    },
    "unanimity": {
     "binds_to": "computed.unanimity_from_ballots",
     "rule": "true iff every seated participant has a non-ABSTAIN ballot and all ballot values are identical. Missing ballot or ABSTAIN breaks unanimity. This field is the vote state; it is never copied from stop_reason or stopped."
    }
   },
