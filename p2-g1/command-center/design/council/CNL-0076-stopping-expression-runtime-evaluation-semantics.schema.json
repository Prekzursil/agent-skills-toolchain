  "answers": {
    "cadence": "end-of-round",
    "end_of_turn": "SNAPSHOT-UPDATE-ONLY-NO-HALT",
    "flapping_rule": "sample-at-end-of-round-no-latch",
    "floors_seam": "halt_eligible = (result is true) AND floors_met; floors are CNL-0077. This unit's fixtures treat floors_met as true.",
    "mid_turn": "FORBIDDEN",
    "purity_enforcement": "bind-time-reject",
    "rationale": {
      "why_not_end_of_turn": "End-of-turn halt would skip remaining seats in the round. Speaker order would change whether a flap is observed. CNL-0077 floors (every mandated role having spoken) cannot be stated if halt is allowed between seats of one round.",
      "why_not_mid_turn": "A mid-turn sample would halt on a speaker's in-progress metric write before the turn ledger closes, making halt order-dependent on tool-call interleaving inside one seat.",
      "why_reject_effects": "A mutating term would make AND/OR evaluation order observable. Rejecting effects makes order irrelevant and keeps the snapshot frozen. Purity is a gate, not a hope.",
      "why_sample_not_latch": "Latch-on-true requires observing intra-round values. This unit forbids those observations as evaluation events. Sampling the frozen end-of-round snapshot is the unique deterministic function of the round's closing metrics."
    },
    "side_effect_free": true,
    "unknown_does_not_halt": true
  },
