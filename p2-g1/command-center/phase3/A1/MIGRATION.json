  "provenance_procedure": {
    "timestamps_do_not_authorise_overwrite": true,
    "notes": "Signal 1 is git log -1 --format=%cI on the repo path (or the fixture committer ledger when git is absent). Signal 2 is live mtime plus the LF-normalised line diff. Classification is by line-set inclusion, not by which clock is newer. A unique line on either side forbids taking the other side as a one-directional overwrite.",
    "signals": [
      {
        "id": "signal-1-repo-git-committer",
        "command_or_method": "git log -1 --format=%cI -- <path>",
        "reads": "repo committer timestamp (independent of filesystem mtime)"
      },
      {
        "id": "signal-2-live-mtime-and-content-diff",
        "command_or_method": "stat.st_mtime + set(lines_live) - set(lines_repo)",
        "reads": "live mtime plus unique-line counts after LF normalisation"
      }
    ],
    "decision_table": [
      {
        "when": "BYTE-IDENTICAL-LF or EOL-ONLY",
        "do": "IDENTICAL / take repo bytes after LF"
      },
      {
        "when": "REPO-ONLY",
        "do": "TAKE-REPO-LIVE-ABSENT"
      },
      {
        "when": "LIVE-ONLY",
        "do": "TAKE-LIVE-REPO-ABSENT"
      },
      {
        "when": "LIVE-SUPERSET",
        "do": "TAKE-LIVE (repo lines already present)"
      },
      {
        "when": "REPO-SUPERSET",
        "do": "TAKE-REPO (live lines already present)"
      },
      {
        "when": "BOTH-UNIQUE",
        "do": "ADJUDICATE; hold both unique-line sets; preview = UNION-MERGE"
      },
      {
        "when": "requested TAKE-REPO while live has unique lines",
        "do": "REFUSE-ONE-DIRECTIONAL-OVERWRITE"
      }
    ]
  },
