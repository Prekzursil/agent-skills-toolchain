  "decision": {
   "hard_rule": "No judge may score an artifact they or their vendor authored. Authorship is the union of (1) the artifact's own provenance/produced_by vendor and author_id when present and (2) the catalog assignment vendor. A catalog-vs-disk mismatch recuses BOTH vendors. Self-declaration is not evidence and cannot waive recusal.",
   "information_partition": {
    "before_scoring_may_see": [
     "de-identified dossier bytes from ARC-0067 once that bundle exists",
     "the pre-registered rubric (ARC-0002) when present, as a hashed file",
     "this panel's independence rules without per-artifact recusal reasons",
     "opaque entry labels, never architecture names",
     "the judge's own notes"
    ],
    "before_scoring_must_not_see": [
     "architecture ids A1-A9 and class names (config-first, generated SSOT, ...)",
     "produced_by / provenance of the dossier under score",
     "catalog assigned_model_vendor_role for that dossier",
     "peer scorecards, peer identities, peer recusal reasons",
     "the ARC-0067 sealed label-to-architecture map",
     "which vendor the detector recused and why"
    ],
    "peer_scores_readable_only_after": "every seated eligible judge has submitted or abstained"
   },
   "model_diversity_minimum": 3,
   "panel_size": 5,
   "quorum": {
    "abstention": "an abstention that does not name missing evidence counts as zero, not as a quorum seat",
    "below_quorum": "VOID",
    "minimum_eligible_judges_per_artifact": 3,
    "void_means": "No architecture verdict is recorded. Seat a bench replacement whose vendor is not in the recused set; if the bench cannot restore quorum, the entry remains unscored."
   },
   "recusal": {
    "detector": "command-center/p2-wave/probes/ARC-0066/conflicts.py",
    "on_conflict": "RECUSE. The ballot does not count. The judge is not given the artifact. Replacement is seated from the bench only if quorum would otherwise fail.",
    "pre_recusal_contributions": "retained, never deleted",
    "reason_visibility": "Recusal reasons stay in the dispatch layer. Showing PROVENANCE_VENDOR=cursor to a judge would identify the author and break the information partition.",
    "replacement_does_not_inherit_votes": true,
    "self_declaration": "ignored",
    "when": [
     "once at seating, over the 63-lens census",
     "again immediately before each (judge, artifact) dispatch"
    ]
   },
   "summary": "Seat five model-diverse judges from five vendors. Independence is the complement of mechanical recusal (author_id, provenance vendor, catalog vendor). Diversity minimum is three vendors and three models, computed from the seated roster. Quorum is three eligible scores; below that the verdict is VOID.",
