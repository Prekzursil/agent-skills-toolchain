    "architecture_id": "A7",
    "architecture_name": "security-first",
    "title": "Least-privilege migration: observed-use grants staged behind a shadow deny-log",
    "question": "Design the migration to least privilege WITHOUT breaking working automation: derive each capability's ACTUAL required permission set from observed tool use over a stated window, stage the tightening behind a shadow-mode deny-log that records what WOULD have been blocked, and specify the rollback for a tightened grant that breaks a live workflow.",
    "observation_window": {
      "start": "2026-08-25T00:49:00Z",
      "end": "2026-08-25T01:00:05Z",
      "sample_size": 10,
      "transcript_files": 113,
      "tool_events_in_window": 7213,
      "coverage_threshold_events": 10,
      "sources": [
        "/root/.cursor/projects/opt-p2-ast-integrate/agent-transcripts",
        "command-center/p2-wave/probes/<id>/SUBAGENT-RETURN.json named_probes.command"
      ],
      "notes": "Signal 1 attributes jsonl tool_use.name to the P2-deliver unit id in that transcript. Signal 2 counts python3/pwsh tokens in that unit's named-probe command strings. Shell maps to Bash; StrReplace maps to Edit. Unmapped tools (TodoWrite, GetDynamicTools) are unmodeled, not would-have-blocked events."
    },
    "derivation_procedure": {
      "signals": [
        {
          "id": "signal-1-transcript-tool-use-name",
          "command_or_method": "parse agent-transcripts/*.jsonl tool_use.name keyed by P2-deliver unit id",
          "reads": "jsonl tool_use.name counts (not command strings)"
        },
        {
          "id": "signal-2-named-probe-command-tokens",
          "command_or_method": "SUBAGENT-RETURN.json named_probes[].command token scan (python3 vs pwsh)",
          "reads": "probe command strings (different field than jsonl names)"
        }
      ],
      "decision_table": [
        {
          "when": "either signal observed the permission",
          "do": "keep; label OBSERVED"
        },
        {
          "when": "both signals unused and coverage_ok",
          "do": "candidate-drop; stage behind shadow deny-log"
        },
        {
          "when": "unused but transcript_events < coverage threshold",
          "do": "INFERRED-KEEP; do not tighten"
        },
        {
          "when": "signals disagree used vs unused",
          "do": "keep the wider grant; record both counts; do not pick"
        },
        {
          "when": "shadow would-have-blocked > 0",
          "do": "refuse tighten"
        },
        {
          "when": "shadow would-have-blocked == 0 across the window",
          "do": "allow tighten of that candidate drop"
        },
        {
          "when": "observed call is absent from declared grant",
          "do": "record underdeclared OBSERVED addition; do not claim least-privilege complete"
        },
        {
          "when": "tightened grant breaks a live workflow",
          "do": "one-step restore of the snapshot taken before tighten"
        }
      ],
      "observed_vs_inferred": "OBSERVED means a count on signal 1 or signal 2. OBSERVED-ABSENT means both counts are zero with coverage_ok. INFERRED means the catalog still lists the permission but traces are too thin to treat absence as unused.",
      "notes": "This unit does not rewrite WORK-UNIT-CATALOG.json. The plan names the procedure, proves it on ten live capabilities, and refuses to arm a drop while the deny-log is non-empty."
    },
