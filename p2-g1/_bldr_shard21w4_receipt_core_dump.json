{
 "type": "object",
 "properties": {
  "schema_version": {
   "type": "integer",
   "const": 1
  },
  "unit_id": {
   "$ref": "#/$defs/unit_id"
  },
  "state": {
   "$ref": "#/$defs/terminal_state"
  },
  "disposition": {
   "$ref": "#/$defs/disposition"
  },
  "sentinel": {
   "$ref": "#/$defs/sentinel"
  },
  "profile": {
   "type": "string",
   "description": "Optional receipt profile, e.g. council-runtime-module. 30 profile= variants occur in the catalog; all declare the same required core, so a profile narrows nothing structurally and is carried for routing only.",
   "maxLength": 128,
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "spec_anchor": {
   "type": "string",
   "description": "Anchor into the governing spec, e.g. _USER-PROMPTS.md:10631-10644.",
   "minLength": 3,
   "maxLength": 1024
  },
  "min_bytes_threshold": {
   "type": "integer",
   "description": "The DECLARED meaningful minimum size for condition 3. It must be declared, not implied: an undeclared threshold makes 'exceeds a meaningful minimum' unfalsifiable. The reducer compares every primary artifact against it.",
   "minimum": 1
  },
  "artifacts": {
   "type": "array",
   "minItems": 1,
   "maxItems": 512,
   "items": {
    "$ref": "#/$defs/artifact"
   }
  },
  "evidence": {
   "type": "array",
   "description": "Two mechanically independent signals are the estate default; minItems is 1 here because a BLOCKED unit may only have the blocker probe, and the reducer requires the pair for SUCCESS.",
   "minItems": 1,
   "maxItems": 256,
   "items": {
    "$ref": "#/$defs/evidence_item"
   }
  },
  "tests": {
   "type": "array",
   "maxItems": 4096,
   "items": {
    "$ref": "#/$defs/test_result"
   }
  },
  "negative_controls": {
   "type": "array",
   "maxItems": 512,
   "items": {
    "$ref": "#/$defs/negative_control"
   }
  },
  "reviewer": {
   "$ref": "#/$defs/reviewer"
  },
  "defects": {
   "type": "array",
   "maxItems": 512,
   "items": {
    "$ref": "#/$defs/defect"
   }
  },
  "manifest_registration": {
   "$ref": "#/$defs/manifest_registration"
  },
  "downstream_consumers": {
   "type": "array",
   "maxItems": 128,
   "items": {
    "$ref": "#/$defs/downstream_consumer"
   }
  },
  "timestamps": {
   "$ref": "#/$defs/timestamps"
  },
  "retry": {
   "$ref": "#/$defs/retry"
  },
  "failure": {
   "$ref": "#/$defs/failure"
  },
  "residual_unknowns": {
   "type": "array",
   "maxItems": 256,
   "items": {
    "$ref": "#/$defs/residual_unknown"
   }
  },
  "produced_by": {
   "type": "object",
   "properties": {
    "vendor": {
     "$ref": "#/$defs/vendor_id"
    },
    "model": {
     "type": "string",
     "maxLength": 128
    },
    "role": {
     "type": "string",
     "maxLength": 128
    },
    "execution_substrate": {
     "type": "string",
     "maxLength": 128
    }
   },
   "required": [
    "vendor",
    "model"
   ],
   "additionalProperties": false
  },
  "report": {
   "type": "object",
   "description": "Domain payload. Narrowed by the profile subschemas in $defs (security_report, benchmark_result, ...) which 128 units reference directly by JSON pointer.",
   "minProperties": 1
  },
  "extensions": {
   "type": "object",
   "description": "The sanctioned forward-compatibility channel. additionalProperties is false everywhere else so a misspelled core field is a hard error instead of a silently dropped one; genuinely new data goes here."
  }
 },
 "required": [
  "schema_version",
  "unit_id",
  "state",
  "sentinel",
  "spec_anchor",
  "min_bytes_threshold",
  "artifacts",
  "evidence",
  "timestamps",
  "retry"
 ],
 "additionalProperties": true,
 "allOf": [
  {
   "$comment": "Condition 10 for every state: an OPEN P0/P1 defect can never be attached to a receipt that is being offered as complete.",
   "if": {
    "properties": {
     "state": {
      "const": "SUCCESS"
     }
    },
    "required": [
     "state"
    ]
   },
   "then": {
    "required": [
     "tests",
     "negative_controls",
     "reviewer",
     "manifest_registration",
     "downstream_consumers",
     "residual_unknowns"
    ],
    "properties": {
     "sentinel": {
      "$comment": "A SUCCESS receipt may not carry a FAILED sentinel.",
      "pattern": "^(?:SUCCESS:|SENTINEL:)"
     },
     "evidence": {
      "$comment": "Two mechanically independent signals (source + verifier) are mandatory for a SUCCESS.",
      "minItems": 2
     },
     "tests": {
      "minItems": 1,
      "not": {
       "contains": {
        "properties": {
         "result": {
          "enum": [
           "FAIL",
           "ERROR",
           "SKIP",
           "NOT-RUN"
          ]
         }
        },
        "required": [
         "result"
        ]
       }
      }
     },
     "negative_controls": {
      "$comment": "Condition 8 plus the both-states rule. A control that did not fire on the bad state, or was not silent on the good state, measures nothing.",
      "minItems": 1,
      "allOf": [
       {
        "not": {
         "contains": {
          "properties": {
           "fired_on_bad_state": {
            "const": false
           }
          },
          "required": [
           "fired_on_bad_state"
          ]
         }
        }
       },
       {
        "not": {
         "contains": {
          "properties": {
           "silent_on_good_state": {
            "const": false
           }
          },
          "required": [
           "silent_on_good_state"
          ]
         }
        }
       }
      ]
     },
     "reviewer": {
      "properties": {
       "verdict": {
        "const": "PASS"
       },
       "independent": {
        "const": true
       }
      },
      "required": [
       "verdict",
       "independent"
      ]
     },
     "manifest_registration": {
      "properties": {
       "registered": {
        "const": true
       }
      },
      "required": [
       "registered"
      ]
     },
     "downstream_consumers": {
      "$comment": "Condition 12 made non-decorative: at least one consumer must have been executed and read the artifact.",
      "minItems": 1,
      "allOf": [
       {
        "not": {
         "contains": {
          "properties": {
           "executed": {
            "const": false
           }
          },
          "required": [
           "executed"
          ]
         }
        }
       },
       {
        "not": {
         "contains": {
          "properties": {
           "read_ok": {
            "const": false
           }
          },
          "required": [
           "read_ok"
          ]
         }
        }
       }
      ]
     },
     "defects": {
      "not": {
       "contains": {
        "allOf": [
         {
          "properties": {
           "severity": {
            "enum": [
             "P0",
             "P1"
            ]
           }
          },
          "required": [
           "severity"
          ]
         },
         {
          "properties": {
           "status": {
            "const": "open"
           }
          },
          "required": [
           "status"
          ]
         }
        ]
       }
      }
     }
    }
   }
  },
  {
   "$comment": "Every non-SUCCESS terminal state must classify itself. An unclassified failure becomes a silent success at the fan-in barrier.",
   "if": {
    "properties": {
     "state": {
      "enum": [
       "FAILED",
       "BLOCKED",
       "SEVERED",
       "TIMEOUT"
      ]
     }
    },
    "required": [
     "state"
    ]
   },
   "then": {
    "required": [
     "failure"
    ]
   }
  },
  {
   "$comment": "A FAILED sentinel and a SUCCESS state are mutually exclusive.",
   "if": {
    "properties": {
     "sentinel": {
      "pattern": "^FAILED:"
     }
    },
    "required": [
     "sentinel"
    ]
   },
   "then": {
    "properties": {
     "state": {
      "not": {
       "const": "SUCCESS"
      }
     }
    }
   }
  },
  {
   "$comment": "SUPERSEDED and DROPPED-BY-OWNER must say by what, so a dead end is retired rather than re-walked.",
   "if": {
    "properties": {
     "state": {
      "enum": [
       "SUPERSEDED",
       "DROPPED-BY-OWNER"
      ]
     }
    },
    "required": [
     "state"
    ]
   },
   "then": {
    "required": [
     "disposition"
    ]
   }
  }
 ]
}