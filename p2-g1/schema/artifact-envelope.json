{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file:///C:/Users/Prekzursil/source/ast-integrate/schema/artifact-envelope.json",
  "title": "Artifact envelope (canonical id, digest, size, schema ref, registration)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "producing_unit",
    "sha256",
    "bytes",
    "schema_ref",
    "sentinel",
    "retention_class",
    "registered"
  ],
  "properties": {
    "artifact_id": {
      "$ref": "file:///C:/Users/Prekzursil/source/ast-integrate/schema/common/identity.json#/$defs/artifact_id"
    },
    "producing_unit": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[0-9]{4}$"
    },
    "sha256": {
      "$ref": "file:///C:/Users/Prekzursil/source/ast-integrate/schema/common/identity.json#/$defs/sha256"
    },
    "bytes": {
      "$ref": "file:///C:/Users/Prekzursil/source/ast-integrate/schema/common/identity.json#/$defs/byte_size"
    },
    "schema_ref": {
      "type": "string",
      "minLength": 8
    },
    "sentinel": {
      "type": "string",
      "minLength": 8
    },
    "retention_class": {
      "type": "string",
      "enum": ["ephemeral", "standard", "archival"]
    },
    "registered": {
      "type": "boolean",
      "const": true
    },
    "evidence_anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
