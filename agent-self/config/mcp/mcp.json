      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "binary-ninja-mcp",
        "--host",
        "localhost",
        "--port",
        "9009"
      ]
    },
    "browserstack": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@browserstack/mcp-server@1.2.11"
