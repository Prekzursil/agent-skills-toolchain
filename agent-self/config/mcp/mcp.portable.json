{
  "_comment": "Codespace/Linux-safe MCP servers. Secrets are ${PLACEHOLDERS} - supply them via Codespaces Secrets, never commit values.",
  "mcpServers": {
    "agent-mail": {
      "type": "http",
      "url": "http://127.0.0.1:8812/mcp"
    },
    "apify": {
      "headers": {
        "Authorization": "${AUTHORIZATION}"
      },
      "type": "http",
      "url": "https://mcp.apify.com/"
    },
    "basic-memory": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp"
    },
    "binary-ninja-mcp": {
      "args": [
        "-y",
        "binary-ninja-mcp"
      ],
      "command": "npx",
      "env": {}
    },
    "brightdata": {
      "type": "http",
      "url": "https://mcp.brightdata.com/mcp?token=${BRIGHTDATA_TOKEN}"
    },
    "browserstack": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@browserstack/mcp-server@1.2.28"
      ],
      "command": "cmd",
      "env": {
        "BROWSERSTACK_ACCESS_KEY": "${BROWSERSTACK_ACCESS_KEY}",
        "BROWSERSTACK_USERNAME": "${BROWSERSTACK_USERNAME}"
      }
    },
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp"
      ],
      "command": "npx"
    },
    "claude-code-mcp": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@steipete/claude-code-mcp@1.10.12"
      ],
      "command": "cmd",
      "env": {
        "CLAUDE_CLI_NAME": "claude"
      }
    },
    "codacy": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@codacy/codacy-mcp@0.6.22"
      ],
      "command": "cmd",
      "env": {
        "CODACY_ACCOUNT_TOKEN": "${CODACY_ACCOUNT_TOKEN}",
        "CODACY_API_TOKEN": "${CODACY_API_TOKEN}"
      }
    },
    "codecov": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@egulatee/mcp-codecov@2.4.0"
      ],
      "command": "cmd",
      "env": {
        "CODECOV_BASE_URL": "${CODECOV_BASE_URL}",
        "CODECOV_TOKEN": "${CODECOV_TOKEN}"
      }
    },
    "codex": {
      "args": [
        "mcp-server"
      ],
      "command": "codex",
      "env": {},
      "type": "stdio"
    },
    "context7": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "command": "cmd",
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "type": "stdio"
    },
    "cve-mcp": {
      "args": [
        "-y",
        "cve-mcp"
      ],
      "command": "npx"
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "digitalocean": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@digitalocean/mcp",
        "--services",
        "apps",
        "--transport",
        "stdio"
      ],
      "command": "cmd",
      "env": {
        "DIGITALOCEAN_API_TOKEN": "${DIGITALOCEAN_API_TOKEN}"
      }
    },
    "elevenlabs": {
      "args": [
        "elevenlabs-mcp"
      ],
      "command": "uvx",
      "env": {},
      "type": "stdio"
    },
    "fiddler": {
      "headers": {
        "Authorization": "${AUTHORIZATION}"
      },
      "type": "http",
      "url": "http://localhost:8868/mcp"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "figma-rest": {
      "args": [
        "/c",
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "command": "cmd",
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      },
      "type": "stdio"
    },
    "firecrawl": {
      "args": [
        "/c",
        "npx",
        "-y",
        "firecrawl-mcp@3.22.3"
      ],
      "command": "cmd",
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "github": {
      "headers": {
        "Authorization": "${AUTHORIZATION}"
      },
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "github_cli": {
      "args": [],
      "command": "gh-cli-mcp",
      "env": {
        "GH_TOKEN": "${GH_TOKEN}",
        "GITHUB_MCP_PAT": "${GITHUB_MCP_PAT}"
      },
      "type": "stdio"
    },
    "gitlab": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "command": "cmd",
      "env": {
        "GITLAB_API_URL": "${GITLAB_API_URL}",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}"
      },
      "type": "stdio"
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "mcp-graphql": {
      "args": [
        "/c",
        "npx",
        "mcp-graphql"
      ],
      "command": "cmd",
      "env": {
        "ENDPOINT": "${ENDPOINT}"
      }
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "pdf-reader": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@sylphx/pdf-reader-mcp"
      ],
      "command": "cmd",
      "env": {},
      "type": "stdio"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@0.0.78"
      ],
      "command": "npx"
    },
    "playwright-cdp": {
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ],
      "command": "npx"
    },
    "playwright-extension": {
      "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--extension"
      ],
      "command": "npx"
    },
    "postgres": {
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/pgedge/postgres-mcp@sha256:56218d3c3827e4fa2348339aaf369dcf6b485a5c7206552707c19f67d43a9fc3"
      ],
      "command": "docker"
    },
    "repomix": {
      "args": [
        "/c",
        "npx",
        "-y",
        "repomix",
        "--mcp"
      ],
      "command": "cmd",
      "env": {},
      "type": "stdio"
    },
    "searxng": {
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-searxng@1.8.0"
      ],
      "command": "cmd",
      "env": {
        "SEARXNG_URL": "http://127.0.0.1:8890"
      },
      "type": "stdio"
    },
    "sentry": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@sentry/mcp-server@0.37.0"
      ],
      "command": "cmd",
      "env": {
        "SENTRY_ACCESS_TOKEN": "${SENTRY_ACCESS_TOKEN}",
        "SENTRY_HOST": "${SENTRY_HOST}"
      }
    },
    "serena": {
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ],
      "command": "uvx",
      "env": {},
      "type": "stdio"
    },
    "sonarqube": {
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_IDE_PORT",
        "docker.io/mcp/sonarqube@sha256:925c88bc7cab2a1e1025b0bd43f0af504cd8ce1b99e9663ececaca914fb632e7"
      ],
      "command": "docker",
      "env": {
        "SONARQUBE_IDE_PORT": "${SONARQUBE_IDE_PORT}",
        "SONARQUBE_ORG": "${SONARQUBE_ORG}",
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN}",
        "SONARQUBE_URL": "${SONARQUBE_URL}"
      }
    },
    "tooluniverse": {
      "args": [
        "tooluniverse==1.2.4"
      ],
      "command": "uvx"
    }
  }
}
