{
  "mcpServers": {
    "mcp-funnel": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-funnel",
        "{{USER_HOME}}/.mcp-funnel.json"
      ]
    },
    "huggingface": {
      "url": "https://huggingface.co/mcp?login"
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "insta-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "{{USER_HOME}}/source/repos/insta-mcp/dist/index.js"
      ],
      "env": {}
    },
    "tooluniverse": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "tooluniverse==1.2.4"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "schrodinger": {
      "type": "stdio",
      "command": "C:\\Users\\{{USER}}\\source\\repos\\schrodinger-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\Users\\{{USER}}\\source\\repos\\schrodinger-mcp\\server.py"
      ],
      "env": {
        "SCHRODINGER": "D:\\Program Files\\Schrodinger 2022-4"
      }
    },
    "rdkit": {
      "type": "stdio",
      "command": "C:\\Users\\{{USER}}\\source\\repos\\rdkit-mcp-server\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\Users\\{{USER}}\\source\\repos\\rdkit-mcp-server\\run_server.py",
        "--transport",
        "stdio"
      ],
      "env": {}
    },
    "fb-messenger": {
      "type": "stdio",
      "command": "C:\\Users\\{{USER}}\\source\\repos\\fb-messenger-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\Users\\{{USER}}\\source\\repos\\fb-messenger-mcp\\server.py"
      ],
      "env": {}
    },
    "tiktok": {
      "type": "stdio",
      "command": "C:\\Users\\{{USER}}\\source\\repos\\tiktok-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "C:\\Users\\{{USER}}\\source\\repos\\tiktok-mcp\\server.py"
      ],
      "env": {}
    },
    "scholarly-access": {
      "type": "stdio",
      "command": "C:\\Users\\{{USER}}\\source\\agent-skills-toolchain\\tools\\scholarly-access-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "scholarly_access.server"
      ],
      "env": {}
    },
    "basic-memory": {
      "type": "stdio",
      "command": "C:\\Users\\{{USER}}\\.local\\bin\\basic-memory.exe",
      "args": [
        "mcp"
      ],
      "env": {
        "BASIC_MEMORY_HOME": "D:\\basic-memory",
        "FASTEMBED_CACHE_PATH": "D:\\basic-memory\\.models",
        "HF_HOME": "D:\\basic-memory\\.hf",
        "DO_NOT_TRACK": "1"
      }
    },
    "ocr": {
      "type": "stdio",
      "command": "D:\\mcp-servers\\abbyy-finereader-ocr-mcp\\.venv\\Scripts\\python.exe",
      "args": [
        "D:\\mcp-servers\\abbyy-finereader-ocr-mcp\\index.py"
      ],
      "env": {}
    }
  }
}
