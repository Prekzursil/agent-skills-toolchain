{
  "cleanupPeriodDays": 365,
  "skillListingBudgetFraction": 0.04,
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "${CLAUDE_CODE_MAX_OUTPUT_TOKENS}",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MCP_TIMEOUT": "120000",
    "MCP_TOOL_TIMEOUT": "600000",
    "MAX_MCP_OUTPUT_TOKENS": "${MAX_MCP_OUTPUT_TOKENS}",
    "MCP_CLIENT_SESSION_TIMEOUT_SECONDS": "600",
    "ECC_CONTEXT_MONITOR_COST_WARNINGS": "0",
    "ECC_GATEGUARD": "off",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "90",
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
    "CLAUDE_CODE_DISABLE_MOUSE": "1"
