    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.credentials*)",
      "Read(**/CrossDevice/**)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "C:",
      "D:"
    ]
  },
  "fallbackModel": [
    "claude-sonnet-5"
  ],
  "deniedMcpServers": [
    {
      "serverName": "markitdown"
    },
    {
      "serverName": "rdkit"
    },
    {
      "serverName": "serena"
    },
    {
      "serverName": "gitlab"
    },
    {
      "serverName": "meta-tool"
    }
