  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "mcp__codex__codex",
      "mcp__codex__codex-reply",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "NotebookEdit",
      "WebSearch",
      "WebFetch",
      "TodoWrite",
      "Task",
      "Skill",
      "Monitor",
      "TaskStop",
      "SendUserFile",
      "Artifact",
      "ToolSearch",
      "mcp__basic-memory",
      "mcp__context7",
      "mcp__deepwiki",
      "mcp__repomix",
      "mcp__plugin_serena_serena",
      "mcp__github_cli",
      "mcp__search-hub",
      "mcp__tavily",
      "mcp__perplexity",
      "mcp__firecrawl",
      "mcp__huggingface",
      "mcp__paper-search",
      "mcp__scholarly-access",
      "mcp__playwright",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)"
