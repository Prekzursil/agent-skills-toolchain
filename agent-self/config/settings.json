{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MCP_TIMEOUT": "120000",
    "MCP_TOOL_TIMEOUT": "300000",
    "ECC_CONTEXT_MONITOR_COST_WARNINGS": "0",
    "ECC_GATEGUARD": "off",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "C:",
      "D:"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__ida-pro-mcp__.*|mcp__ghidra-mcp__.*|mcp__frida-mcp__.*|mcp__binary-ninja-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/anti-degen/fingerprint.py",
            "timeout": 10,
            "statusMessage": "Anti-degen fingerprint check"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/claim-guard/ledger-write.py",
            "timeout": 5,
            "statusMessage": "Claim-guard: recording Bash result to ledger"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/memory-guard/scan.py",
            "timeout": 10,
            "statusMessage": "Inbound injection guard (ASI06)"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/async-validate/validate.py",
            "asyncRewake": true,
            "statusMessage": "Async file validator (background)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/cmd-rewrite/compress-output.py",
            "timeout": 10,
            "statusMessage": "Compressing noisy Bash output"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{USER_HOME}}/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.ps1",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/goal-reinject/reinject.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/test-tamper-guard/guard.py",
            "timeout": 20,
            "statusMessage": "EvilGenie TDD-guard scanning staged test diffs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/cmd-rewrite/inject-nopager.py",
            "timeout": 5,
            "statusMessage": "Injecting --no-pager into git commands"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/mcp-defaults/enforce-mcp-defaults.py",
            "timeout": 10,
            "statusMessage": "Enforcing MCP defaults"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{USER_HOME}}/.claude/hooks/harness-trim/compact-restore.ps1",
            "timeout": 15,
            "statusMessage": "Restoring pre-compaction snapshot"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/event-ledger/sessionstart-replay.py",
            "timeout": 10,
            "statusMessage": "Replaying event-ledger (recovery)"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/beads/sessionstart-ready.py",
            "timeout": 25,
            "statusMessage": "Surfacing beads ready work (if .beads present)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{USER_HOME}}/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.ps1",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/inquisitiveness/prompt-guard.py",
            "timeout": 10,
            "statusMessage": "Inquisitiveness guard (EVPI-gated)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{USER_HOME}}/.claude/hooks/precompact-snapshot/snapshot.ps1",
            "timeout": 15,
            "statusMessage": "Snapshotting context before compaction"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File {{USER_HOME}}/.claude/hooks/precompact-basicmemory/capture.ps1",
            "timeout": 15,
            "statusMessage": "Capturing context to basic-memory"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{USER_HOME}}/.claude/hooks/harness-trim/instructions-loaded-log.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/event-ledger/stop-hook.py",
            "timeout": 10,
            "statusMessage": "Recording turn to event-ledger"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/claim-guard/claim-check.py",
            "timeout": 10,
            "statusMessage": "Claim-guard: checking unverified success claims"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|overloaded|billing_error|server_error|authentication_failed",
        "hooks": [
          {
            "type": "command",
            "command": "python {{USER_HOME}}/.claude/hooks/stopfailure-notify/notify.py",
            "timeout": 15,
            "statusMessage": "StopFailure: logging API error + notifying"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{USER_HOME}}/.claude/statusline-command.sh"
  },
