  "enabledPlugins": {
    "aikido@claude-plugins-official": false,
    "circleback@claude-plugins-official": false,
    "greptile@claude-plugins-official": false,
    "data-agent-kit-starter-pack@claude-plugins-official": false
  },
  "outputStyle": "default",
  "prefersReducedMotion": false
