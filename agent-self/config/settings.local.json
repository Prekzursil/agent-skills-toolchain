      "Bash(claude mcp:*)",
      "Bash(claude plugin:*)",
      "Bash(wmic process:*)",
      "Bash(python3:*)",
      "Bash(bash:*)",
      "Bash(pip install:*)",
      "Bash(git clone:*)",
      "Bash(ls {{USER_HOME}}/.agents/skills/metaswarm-*)",
      "Bash(cat {{USER_HOME}}/.gemini/extensions/metaswarm*)",
