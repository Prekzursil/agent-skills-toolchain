{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/agent-harness/hook-result.schema.json",
  "title": "Shared Hook Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "action",
    "reason_code",
    "additional_context"
  ],
  "properties": {
    "status": {
      "type": "string",
      "pattern": "^(SUCCESS|FAILED):[A-Za-z0-9._-]+$"
    },
    "action": {
      "enum": ["allow", "block", "inject", "continue"]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "additional_context": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "continuation": {
      "type": ["string", "null"],
      "maxLength": 4000
    }
  }
}

