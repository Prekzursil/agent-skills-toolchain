{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.skills/ui-audit/critique.schema.json",
  "title": "ui-audit Track-B design critique",
  "type": "object",
  "required": [
    "id",
    "verdict",
    "dimensions",
    "prioritizedFindings"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ui-critique-"
    },
    "audit_id": {
      "type": "string"
    },
    "verdict": {
      "type": "object",
      "required": [
        "looksGood",
        "score",
        "headline",
        "summary"
      ],
      "properties": {
        "looksGood": {
          "enum": [
            "good",
            "needs-work",
            "poor"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "rating",
          "confidence",
          "findings"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "visual-hierarchy",
              "spacing-rhythm",
              "alignment",
              "type-scale",
              "color-contrast",
              "consistency",
              "empty-error-states",
              "affordance",
              "motion",
              "overall"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "criticalError": {
            "type": "boolean"
          },
          "rating": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "evidence",
                "recommendation"
              ],
              "additionalProperties": true,
              "properties": {
                "severity": {
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "info"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recommendation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "prioritizedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "severity",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "rank": {
            "type": "number"
          },
          "dimension": {
            "enum": [
              "visual-hierarchy",
              "spacing-rhythm",
              "alignment",
              "type-scale",
              "color-contrast",
              "consistency",
              "empty-error-states",
              "affordance",
              "motion",
              "overall"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "uiclip": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "score": {
              "type": [
                "number",
                "null"
              ]
            },
            "status": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}