{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.skills/critique-panel/synthesis.schema.json",
  "title": "critique-panel synthesis",
  "type": "object",
  "required": [
    "id",
    "verdict",
    "dimensionScores",
    "prioritizedFindings"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^critique-panel-"
    },
    "audit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "personas": {
      "type": "array",
      "items": {
        "enum": [
          "user-advocate",
          "systems-consistency",
          "a11y",
          "brand-aesthetic"
        ]
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "looksGood",
        "composite",
        "meanScore",
        "criticalErrors"
      ],
      "properties": {
        "looksGood": {
          "enum": [
            "good",
            "needs-work",
            "poor"
          ]
        },
        "composite": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "meanScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "criticalErrors": {
          "type": "integer",
          "minimum": 0
        },
        "shipGate": {
          "type": "boolean"
        },
        "headline": {
          "type": "string"
        }
      }
    },
    "dimensionScores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "weight",
          "score"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "visual-hierarchy",
              "spacing-rhythm",
              "alignment",
              "type-scale",
              "color-contrast",
              "consistency",
              "empty-error-states",
              "affordance",
              "motion"
            ]
          },
          "weight": {
            "type": "number"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "rawMean": {
            "type": "number"
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    },
    "prioritizedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "dimension",
          "severity",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "rank": {
            "type": "number"
          },
          "dimension": {
            "enum": [
              "visual-hierarchy",
              "spacing-rhythm",
              "alignment",
              "type-scale",
              "color-contrast",
              "consistency",
              "empty-error-states",
              "affordance",
              "motion"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "raisedBy": {
            "type": "array",
            "items": {
              "enum": [
                "user-advocate",
                "systems-consistency",
                "a11y",
                "brand-aesthetic"
              ]
            }
          },
          "consensus": {
            "type": "number"
          }
        }
      }
    },
    "protectedWins": {
      "type": "array"
    },
    "directions": {
      "type": "array"
    }
  }
}