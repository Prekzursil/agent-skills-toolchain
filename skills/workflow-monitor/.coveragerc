# Coverage scope for the wfmon export 100% lane (honored by `pytest --cov ...` from this dir).
# The Textual cockpit (workflow_monitor.py) + smoke/keybind tests stay OUTSIDE this lane.
[run]
source =
    workflow_run
    wfmon_export
branch = True
omit =
    workflow_monitor.py
    smoke_test.py
    conftest.py
    tests/*
    test_*.py

[report]
exclude_also =
    if __name__ == .__main__.:
    # pragma: no cover
