{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Canonical W3C-DTCG design tokens (source of truth). Authored by design-system Mode 1 / DIRECT. Consumed by the token pipeline (emits tokens.json + CSS/Tailwind + Figma Variables). Refs use {group.token} syntax; group-level $type sets the default for children.",
  "color": {
    "$type": "color",
    "base": {
      "white": { "$value": "#ffffff" },
      "black": { "$value": "#0b0b0d" },
      "slate-50": { "$value": "#f8fafc" },
      "slate-500": { "$value": "#64748b" },
      "slate-900": { "$value": "#0f172a" },
      "brand-500": { "$value": "#4f46e5", "$description": "primary accent — use sparingly" },
      "brand-600": { "$value": "#4338ca" }
    },
    "semantic": {
      "bg": { "$value": "{color.base.white}", "$description": "page background" },
      "fg": { "$value": "{color.base.slate-900}", "$description": "body text — must clear WCAG AA 4.5:1 on bg" },
      "muted": { "$value": "{color.base.slate-500}" },
      "primary": { "$value": "{color.base.brand-500}" },
      "primary-hover": { "$value": "{color.base.brand-600}" }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "0": { "$value": "0px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },
    "radius": {
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "full": { "$value": "9999px" }
    }
  },
  "typography": {
    "font-family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "font-size": {
      "$type": "dimension",
      "body": { "$value": "16px" },
      "h3": { "$value": "20px" },
      "h2": { "$value": "24px" },
      "h1": { "$value": "32px" }
    },
    "line-height": {
      "$type": "number",
      "body": { "$value": 1.5 },
      "heading": { "$value": 1.2 }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "200ms" },
      "base": { "$value": "300ms" },
      "slow": { "$value": "500ms", "$description": "upper bound of the M3 200-500ms band" }
    }
  }
}
