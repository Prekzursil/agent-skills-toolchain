# cv/ — what is GENERATED and must never be committed.
#
# Committed: profile.yaml (the facts), tools/, templates/, build.ps1, Makefile,
# README.md, REPRODUCE.md, TODO-CONFIRM.md. Everything below is rebuilt in one
# command from those, so versioning it only adds weight and merge noise.

# rendered documents (~2.7 MB, rebuilt by: ./build.ps1 all)
out/

# render toolchain (~302 MB, rebuilt by: ./build.ps1 setup)
.venv/

# caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
