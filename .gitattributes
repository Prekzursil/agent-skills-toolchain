# git-crypt — transparently encrypt per-user credential stores.
# accounts.json holds real secrets (API keys, account tokens). With git-crypt
# these are stored ENCRYPTED in the repo and decrypt to plaintext only after
# `git-crypt unlock <key>` on a trusted device. The *.example.json templates
# stay plaintext (they only show ${ENV}-reference shapes).
#
# Plug-and-play on a new device:
#   1. install git-crypt
#   2. git clone …
#   3. git-crypt unlock /path/to/agent-skills-toolchain.gitcrypt.key
#   → all accounts.json decrypt in place; the MCP hubs read them normally.
tools/mcp/*/accounts.json filter=git-crypt diff=git-crypt
tools/mcp/**/accounts.json filter=git-crypt diff=git-crypt

# Shell scripts MUST be LF (real WSL/Linux bash rejects CRLF); PS1 stays CRLF
*.sh eol=lf
*.ps1 eol=crlf
