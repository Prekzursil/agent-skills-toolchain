# git-crypt — transparently encrypt per-user credential stores.
# accounts.json holds real secrets (API keys, account tokens). With git-crypt
# these are stored ENCRYPTED in the repo and decrypt to plaintext only after
# `git-crypt unlock <key>` on a trusted device. The *.example.json templates
# stay plaintext (they only show ${ENV}-reference shapes).
#
# Plug-and-play on a new device:
#   1. install git-crypt
#   2. git clone …
#   3. git-crypt unlock /path/to/agent-skills-toolchain.gitcrypt.key
#   → all accounts.json decrypt in place; the MCP hubs read them normally.
tools/mcp/*/accounts.json filter=git-crypt diff=git-crypt
tools/mcp/**/accounts.json filter=git-crypt diff=git-crypt

# Shell scripts MUST be LF (real WSL/Linux bash rejects CRLF); PS1 stays CRLF
*.sh eol=lf
*.ps1 eol=crlf

# CC-0005 / IMP-0439 — EXPLICIT EOL POLICY FOR MARKDOWN (recorded decision, not accident).
# Deliberately NO `*.md eol=lf` here. Forcing Markdown to LF at checkout was considered as
# the sole Windows-parity fix for REACH-6 / provenance hashing and rejected: a .gitattributes
# change alone does not make every gate portable (retry_policy: two strikes then move the fix
# into the hashing routine). Provenance gates MUST hash via `git cat-file -p <rev>:<path>`
# (never working-tree bytes, never `git archive`). See tools/measure-guard/blobread.py and
# tools/command-center/validate.py REACH-6. Shell/PS1 keep their eol rules above because
# interpreters reject the wrong ending; Markdown is content hashed from the blob.

# Phone-extracted browser session cookie stores (chatgpt/databricks/aws) — real
# session tokens; stored ENCRYPTED, decrypt only after `git-crypt unlock`.
tools/crcp/cookie-store/*.json filter=git-crypt diff=git-crypt
