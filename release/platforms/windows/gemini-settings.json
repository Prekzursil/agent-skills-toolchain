{
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    },
    "disableYoloMode": false,
    "enablePermanentToolApproval": true,
    "folderTrust": {
      "enabled": true
    }
  },
  "general": {
    "enableAutoUpdate": true,
    "defaultApprovalMode": "auto_edit"
  },
  "tools": {
    "sandboxAllowedPaths": [
      "C:\\",
      "D:\\"
    ],
    "sandboxNetworkAccess": true
  },
  "skills": {
    "enabled": true
  },
  "mcpServers": {
    "github": {
      "command": "gh-cli-mcp",
      "env": {
        "GH_TOKEN": "$GH_TOKEN",
        "GITHUB_MCP_PAT": "$GITHUB_MCP_PAT"
      },
      "trust": true
    },
    "semgrep": {
      "trust": true,
      "command": "semgrep",
      "args": [
        "mcp"
      ]
    },
    "deepsource": {
      "command": "C:/Program Files/nodejs/node.exe",
      "env": {
        "DEEPSOURCE_API_KEY": "$DEEPSOURCE_API_KEY"
      },
      "args": [
        "C:/Users/Prekzursil/.local/opt/deepsource-mcp-server/deepsource-mcp-wrapper.mjs"
      ],
      "trust": true
    },
    "codecov": {
      "command": "mcp-codecov",
      "env": {
        "CODECOV_BASE_URL": "$CODECOV_BASE_URL",
        "CODECOV_TOKEN": "$CODECOV_TOKEN"
      },
      "trust": true
    },
    "codacy": {
      "command": "codacy-mcp-server",
      "env": {
        "CODACY_ACCOUNT_TOKEN": "$CODACY_ACCOUNT_TOKEN",
        "CODACY_API_TOKEN": "$CODACY_API_TOKEN"
      },
      "trust": true
    },
    "sonarqube": {
      "command": "docker",
      "env": {
        "SONARQUBE_IDE_PORT": "$SONARQUBE_IDE_PORT",
        "SONARQUBE_URL": "$SONARQUBE_URL",
        "SONARQUBE_ORG": "$SONARQUBE_ORG",
        "SONARQUBE_TOKEN": "$SONARQUBE_TOKEN"
      },
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_IDE_PORT",
        "docker.io/mcp/sonarqube:latest"
      ],
      "trust": true,
      "timeout": 180000
    },
    "cheatengine": {
      "command": "C:/Users/Prekzursil/.local/opt/cheatengine-mcp-bridge/.venv/Scripts/python.exe",
      "trust": true,
      "args": [
        "C:/Users/Prekzursil/.local/opt/cheatengine-mcp-bridge/MCP_Server/mcp_cheatengine.py"
      ]
    },
    "playwright": {
      "args": [
        "--headless"
      ],
      "command": "playwright-mcp",
      "trust": true
    },
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "trust": true
    },
    "figma": {
      "trust": true,
      "url": "https://mcp.figma.com/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${FIGMA_ACCESS_TOKEN}"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "type": "http",
      "trust": true
    },
    "linear": {
      "url": "https://mcp.linear.app",
      "type": "http",
      "trust": true
    },
    "huggingface": {
      "trust": true,
      "url": "https://huggingface.co/mcp?login",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${HUGGINGFACE_TOKEN}"
      }
    },
    "hexstrike-ai": {
      "command": "C:/Users/Prekzursil/.local/opt/hexstrike-ai/.venv/Scripts/python.exe",
      "args": [
        "C:/Users/Prekzursil/.local/opt/hexstrike-ai/hexstrike_mcp_launcher.py"
      ],
      "trust": true,
      "timeout": 300000
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": "$CONTEXT7_API_KEY"
      },
      "trust": true
    },
    "docker": {
      "command": "C:/Users/Prekzursil/.local/bin/uvx.exe",
      "args": [
        "docker-mcp"
      ],
      "trust": true
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp@latest"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "$FIRECRAWL_API_KEY"
      },
      "trust": true
    },
    "github_cli": {
      "command": "gh-cli-mcp",
      "env": {
        "GH_TOKEN": "$GH_TOKEN",
        "GITHUB_MCP_PAT": "$GITHUB_MCP_PAT"
      },
      "trust": true
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:/Users/Prekzursil/.gemini/memory.jsonl"
      },
      "trust": true
    },
    "pdf-reader": {
      "command": "npx",
      "args": [
        "-y",
        "@sylphx/pdf-reader-mcp"
      ],
      "trust": true
    },
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server@latest"
      ],
      "env": {
        "SENTRY_ACCESS_TOKEN": "$SENTRY_ACCESS_TOKEN",
        "SENTRY_HOST": "sentry.io"
      },
      "trust": true
    },
    "tavily": {
      "command": "npx",
      "args": [
        "tavily-mcp@0.2.15"
      ],
      "env": {
        "TAVILY_API_KEY": "$TAVILY_API_KEY"
      },
      "trust": true
    },
    "excel": {
      "command": "C:/Users/Prekzursil/.local/bin/uvx.exe",
      "args": [
        "excel-mcp-server",
        "stdio"
      ],
      "trust": true
    },
    "scrapegraph": {
      "command": "C:/Users/Prekzursil/.local/bin/uvx.exe",
      "args": [
        "scrapegraph-mcp==1.0.1"
      ],
      "env": {
        "SGAI_API_KEY": "$SGAI_API_KEY"
      },
      "trust": true
    },
    "browserstack": {
      "command": "npx",
      "args": [
        "-y",
        "@browserstack/mcp-server@1.2.11"
      ],
      "env": {
        "BROWSERSTACK_USERNAME": "$BROWSERSTACK_USERNAME",
        "BROWSERSTACK_ACCESS_KEY": "$BROWSERSTACK_ACCESS_KEY"
      },
      "trust": true
    },
    "ralph-orchestrator": {
      "command": "C:/Windows/System32/wsl.exe",
      "args": [
        "-e",
        "bash",
        "-lc",
        "export PATH=\"$HOME/.local/bin:$PATH\"; /home/prekzursil/.local/bin/ralph mcp serve"
      ],
      "trust": true
    },
    "digitalocean": {
      "command": "npx",
      "args": [
        "@digitalocean/mcp",
        "--services",
        "apps"
      ],
      "env": {
        "DIGITALOCEAN_API_TOKEN": "$DIGITALOCEAN_API_TOKEN"
      },
      "trust": true
    },
    "repomix": {
      "command": "npx",
      "args": [
        "-y",
        "repomix",
        "--mcp"
      ],
      "trust": true
    },
    "frida-mcp": {
      "command": "C:/Users/Prekzursil/.local/opt/frida-mcp/.venv/Scripts/frida-mcp.exe",
      "trust": true
    },
    "ida-pro-mcp": {
      "command": "C:/Users/Prekzursil/.local/opt/ida-pro-mcp/.venv/Scripts/python.exe",
      "args": [
        "C:/Users/Prekzursil/.local/opt/ida-pro-mcp/.venv/Lib/site-packages/ida_pro_mcp/server.py"
      ],
      "trust": true
    },
    "ghidra-mcp": {
      "command": "C:/Users/Prekzursil/.local/opt/ghidra-mcp/.venv/Scripts/python.exe",
      "args": [
        "C:/Users/Prekzursil/.local/opt/ghidra-mcp/GhidraMCP-release-1-4/bridge_mcp_ghidra.py",
        "--ghidra-server",
        "http://127.0.0.1:8089/"
      ],
      "trust": true
    },
    "binary-ninja-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "binary-ninja-mcp",
        "--host",
        "localhost",
        "--port",
        "9009"
      ],
      "trust": true
    },
    "mcp-graphql": {
      "command": "npx",
      "args": [
        "mcp-graphql"
      ],
      "env": {
        "ENDPOINT": "http://localhost:4000/graphql"
      },
      "trust": true
    }
  },
  "model": {
    "name": "gemini-3.1-pro-preview"
  }
}
