{
  "initialize": {
    "protocolVersion": "2024-11-05",
    "capabilities": {
      "experimental": {},
      "prompts": {
        "listChanged": false
      },
      "resources": {
        "subscribe": false,
        "listChanged": false
      },
      "tools": {
        "listChanged": false
      }
    },
    "serverInfo": {
      "name": "fb-messenger",
      "version": "1.27.2"
    }
  },
  "tools": {
    "tools": [
      {
        "name": "whoami",
        "description": "Confirm which Facebook account the configured cookies belong to.",
        "inputSchema": {
          "properties": {},
          "title": "whoamiArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "whoamiOutput",
          "type": "object"
        }
      },
      {
        "name": "list_threads",
        "description": "List recent Messenger threads (groups/rooms/pages) with id, name, type.",
        "inputSchema": {
          "properties": {
            "limit": {
              "default": 10,
              "title": "Limit",
              "type": "integer"
            }
          },
          "title": "list_threadsArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "list_threadsOutput",
          "type": "object"
        }
      },
      {
        "name": "read_thread",
        "description": "Read the most recent messages from a thread (group/room/page) by id.",
        "inputSchema": {
          "properties": {
            "thread_id": {
              "title": "Thread Id",
              "type": "string"
            },
            "limit": {
              "default": 20,
              "title": "Limit",
              "type": "integer"
            }
          },
          "required": [
            "thread_id"
          ],
          "title": "read_threadArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "read_threadOutput",
          "type": "object"
        }
      },
      {
        "name": "search_messages",
        "description": "Search for messages containing `text` within a group thread.",
        "inputSchema": {
          "properties": {
            "thread_id": {
              "title": "Thread Id",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "thread_id",
            "text"
          ],
          "title": "search_messagesArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "search_messagesOutput",
          "type": "object"
        }
      },
      {
        "name": "thread_info",
        "description": "Get details for one or more threads by id.",
        "inputSchema": {
          "properties": {
            "thread_ids": {
              "items": {
                "type": "string"
              },
              "title": "Thread Ids",
              "type": "array"
            }
          },
          "required": [
            "thread_ids"
          ],
          "title": "thread_infoArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "thread_infoOutput",
          "type": "object"
        }
      }
    ]
  }
}