  "tools": {
    "tools": [
      {
        "name": "bm_create_session",
        "description": "Create a Biomni agent session (a task) and optionally kick off its first run.\n\n``POST /v2/agent/sessions/create``. ``model_profile`` is the EFFORT tier --\nstandard | fast | premium (``max`` is accepted as an alias for premium). $$$\nwith ``submit_initial_message=True`` (default) the ``content`` is submitted and\nthe agent starts running immediately (consumes usage); set it False to create an\nempty session then compose ``bm_send_message`` + ``bm_start_processing`` (needed\nto attach skills / ``@``-resources to the first message). ``project_id`` comes\nfrom ``bm_list_projects`` (or ``bm_create_project``). Returns the ``session_id``\n(``sess_...``) used by every other session tool.\n",
        "inputSchema": {
          "properties": {
            "project_id": {
              "title": "Project Id",
              "type": "string"
            },
            "content": {
              "title": "Content",
              "type": "string"
            },
            "model_profile": {
              "default": "standard",
              "title": "Model Profile",
              "type": "string"
            },
            "submit_initial_message": {
              "default": true,
              "title": "Submit Initial Message",
              "type": "boolean"
            },
            "session_mode": {
              "default": "agent",
              "title": "Session Mode",
              "type": "string"
            }
          },
          "required": [
            "project_id",
            "content"
          ],
          "title": "bm_create_sessionArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "bm_create_sessionOutput",
          "type": "object"
        }
      },
      {
        "name": "bm_send_message",
        "description": "Send a user message to a session (does NOT start the run -- call bm_start_processing).\n\n``POST /v2/agent/{session_id}/user_message``. Two attachment mechanisms:\n* RESOURCES (tools / databases / packages) -> ``@name`` mentions INSIDE\n  ``content`` (e.g. ``\"@Addgene @airr analyse ...\"``). This is how the app\n  attaches ``@@``-resources; there is no separate field.\n* SKILLS -> ``attached_skills_json``, a JSON array of skill objects from\n  ``bm_list_skills``, each ``{\"id\",\"name\",\"category\",\"intent\":\"use\"}``. Only\n  ACTIVE skills apply (toggle with ``bm_set_skill_status``).\nSet ``is_clarification_response=True`` when answering the agent's own follow-up\nquestion. Follow with ``bm_start_processing`` to run the agent on this message.\n",
        "inputSchema": {
          "properties": {
            "session_id": {
              "title": "Session Id",
              "type": "string"
            },
            "content": {
              "title": "Content",
              "type": "string"
            },
            "attached_skills_json": {
              "default": "",
              "title": "Attached Skills Json",
              "type": "string"
            },
            "is_clarification_response": {
              "default": false,
              "title": "Is Clarification Response",
              "type": "boolean"
            }
          },
          "required": [
            "session_id",
            "content"
          ],
          "title": "bm_send_messageArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "bm_send_messageOutput",
          "type": "object"
        }
      },
      {
        "name": "bm_start_processing",
        "description": "Start the agent processing the session's latest message. $$$ consumes usage.\n\n``POST /v2/agent/{session_id}/start_processing``. Use after ``bm_send_message``;\n``bm_create_session(submit_initial_message=True)`` already starts the first run.\n",
        "inputSchema": {
          "properties": {
            "session_id": {
              "title": "Session Id",
              "type": "string"
            }
          },
          "required": [
            "session_id"
          ],
          "title": "bm_start_processingArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "bm_start_processingOutput",
          "type": "object"
        }
      },
