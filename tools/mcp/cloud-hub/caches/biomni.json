        "description": "Introspect a session's live compute (``GET /v2/agent/{session_id}/{kind}``).\n\n``kind`` is one of: background-processes | gpu-sandboxes | hpc-jobs |\nhpc-pipelines | machines. Shows what the agent is actually running on the\nbackend -- long-running processes, GPU sandboxes, HPC jobs/pipelines, and the\nmachines allocated to the session.\n",
        "inputSchema": {
          "properties": {
            "session_id": {
              "title": "Session Id",
              "type": "string"
            },
            "kind": {
              "default": "background-processes",
