      {
        "name": "bm_get_streaming",
        "description": "Best-effort LIVE stream snapshot of a running session.\n\n``GET /v2/agent/{session_id}/streaming``. This may be a long-lived stream, so the\nread is bounded by ``timeout_seconds`` (default 12s); on timeout it returns an\nerror hint -- use ``bm_get_messages`` for reliable polling. Useful to peek at an\nactively-processing session without waiting for it to finish.\n",
        "inputSchema": {
          "properties": {
            "session_id": {
              "title": "Session Id",
              "type": "string"
            },
            "timeout_seconds": {
              "default": 12.0,
              "title": "Timeout Seconds",
              "type": "number"
            }
          },
          "required": [
            "session_id"
          ],
          "title": "bm_get_streamingArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "bm_get_streamingOutput",
          "type": "object"
        }
      },
