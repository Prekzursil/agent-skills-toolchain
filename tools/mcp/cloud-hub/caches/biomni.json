      {
        "name": "bm_api_raw",
        "description": "Call ANY api.phylo.bio endpoint -- the escape hatch for uncovered routes.\n\n``method`` GET|POST|PUT|PATCH|DELETE; ``path`` is an absolute API path starting\nwith ``/`` (e.g. ``/v2/users/me/memory``, ``/v2/mcp/servers``,\n``/v2/cloud-storage/connections``). ``body_json``/``query_json`` are optional JSON\nstrings. Caution: this can reach mutating/destructive routes (a ``DELETE`` on a\nproject) on the user's OWN account -- confirm intent before calling those.\n",
        "inputSchema": {
          "properties": {
            "method": {
              "title": "Method",
              "type": "string"
            },
            "path": {
              "title": "Path",
              "type": "string"
            },
            "body_json": {
              "default": "",
              "title": "Body Json",
              "type": "string"
            },
            "query_json": {
              "default": "",
              "title": "Query Json",
              "type": "string"
            }
