{
  "initialize": {
    "protocolVersion": "2024-11-05",
    "capabilities": {
      "experimental": {},
      "prompts": {
        "listChanged": false
      },
      "resources": {
        "subscribe": false,
        "listChanged": false
      },
      "tools": {
        "listChanged": false
      }
    },
    "serverInfo": {
      "name": "modal",
      "version": "1.23.3"
    }
  },
  "tools": {
    "tools": [
      {
        "name": "modal_app_list",
        "description": "List deployed/running Modal apps (``modal app list``).",
        "inputSchema": {
          "properties": {},
          "title": "modal_app_listArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "modal_app_listOutput",
          "type": "object"
        }
      },
      {
        "name": "modal_app_stop",
        "description": "Stop a running Modal app by id or name (``modal app stop``).",
        "inputSchema": {
          "properties": {
            "app": {
              "title": "App",
              "type": "string"
            }
          },
          "required": [
            "app"
          ],
          "title": "modal_app_stopArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "modal_app_stopOutput",
          "type": "object"
        }
      },
      {
        "name": "modal_run",
        "description": "Run a Modal entrypoint, e.g. ``app.py::main`` (``modal run``).\n\nMay start billable compute. Set ``detach=True`` to return without streaming.\n",
        "inputSchema": {
          "properties": {
            "target": {
              "title": "Target",
              "type": "string"
            },
            "detach": {
              "default": false,
              "title": "Detach",
              "type": "boolean"
            }
          },
          "required": [
            "target"
          ],
          "title": "modal_runArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "modal_runOutput",
          "type": "object"
        }
      },
      {
        "name": "modal_deploy",
        "description": "Deploy a Modal app from a file/ref (``modal deploy``).",
        "inputSchema": {
          "properties": {
            "target": {
              "title": "Target",
              "type": "string"
            },
            "name": {
              "default": "",
              "title": "Name",
              "type": "string"
            }
          },
          "required": [
            "target"
          ],
          "title": "modal_deployArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "modal_deployOutput",
          "type": "object"
        }
      },
      {
        "name": "modal_volume_ls",
        "description": "List Modal volumes, or files inside one volume (``modal volume list|ls``).",
        "inputSchema": {
          "properties": {
            "volume": {
              "default": "",
              "title": "Volume",
              "type": "string"
            },
            "path": {
              "default": "/",
              "title": "Path",
              "type": "string"
            }
          },
          "title": "modal_volume_lsArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "modal_volume_lsOutput",
          "type": "object"
        }
      },
      {
        "name": "modal_secret_list",
        "description": "List Modal secret names (``modal secret list``).",
        "inputSchema": {
          "properties": {},
          "title": "modal_secret_listArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "title": "Result",
              "type": "string"
            }
          },
          "required": [
            "result"
          ],
          "title": "modal_secret_listOutput",
          "type": "object"
        }
      }
    ]
  }
}