{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills-toolchain/tools/mcp/inference-hub/schemas/routing-policy.schema.json",
  "title": ".agents/routing-policy.json - task-class routing policy, schema v1",
  "description": "Closed shape of the routing policy (BUILD-CONTRACT section 7). Names only: model refs are <model-id>, <model-id>@<endpoint-id> or an alias, never a URL or a credential. Every ref must resolve in .agents/models.json, exponents must sum to 1.0, spend shares must sum to 1.0 across classes, PACE rungs must be distinguishable means (at most one cursor-* rung, one local or procedure rung among P/A/C, distinct endpoints) and OpenRouter refs need callers within codex/cli (L1): those cross-file rules V-P1..V-P14 live in .agents/scripts/routing_policy.py.",
  "type": "object",
  "required": ["schemaVersion", "classes", "review"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1]
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "$ref": "#/$defs/taskClass"
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["cadence", "last_review", "owner"],
      "additionalProperties": false,
      "properties": {
        "cadence": {
          "type": "string",
          "enum": ["weekly", "monthly", "quarterly"]
        },
        "last_review": {
          "$ref": "#/$defs/isoDate"
        },
        "owner": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "modelRef": {
      "description": "<model-id>, <model-id>@<endpoint-id> or an alias declared in models.json.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(@[A-Za-z0-9][A-Za-z0-9._-]*)?$"
    },
    "procedure": {
      "description": "A non-model rung: a handoff: or procedure: step described in words.",
      "type": "string",
      "pattern": "^(handoff|procedure):.*\\S.*$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latticeState": {
      "type": "string",
      "enum": ["native", "probed", "declared", "emulated", "absent"]
    },
    "caller": {
      "type": "string",
      "enum": [
        "codex",
        "grok",
        "goose",
        "opencode",
        "aider",
        "fabric",
        "cursor",
        "claude",
        "agy",
        "gemini",
        "cli"
      ]
    },
    "trigger": {
      "description": "timeout plus the hub error taxonomy classes that move a request down the PACE ladder.",
      "type": "string",
      "enum": [
        "timeout",
        "BACKEND_AUTH",
        "BACKEND_RATE_LIMITED",
        "BACKEND_UNAVAILABLE",
        "BACKEND_ERROR",
        "MALFORMED_RESPONSE",
        "TIMEOUT_NO_OUTPUT",
        "TIMEOUT_PARTIAL",
        "BUDGET_EXCEEDED",
        "CONCURRENCY_SATURATED",
        "CREDENTIAL_MISSING",
        "ENDPOINT_DISABLED",
        "MODEL_DISABLED",
        "UNSUPPORTED_CAPABILITY",
        "HALTED"
      ]
    },
    "floors": {
      "description": "Minimum lattice state per capability; keys are the eleven wire.* / features.* capabilities.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wire.completions": {
          "$ref": "#/$defs/latticeState"
        },
        "wire.responses": {
          "$ref": "#/$defs/latticeState"
        },
        "wire.messages": {
          "$ref": "#/$defs/latticeState"
        },
        "features.streaming": {
          "$ref": "#/$defs/latticeState"
        },
        "features.usage": {
          "$ref": "#/$defs/latticeState"
        },
        "features.tools": {
          "$ref": "#/$defs/latticeState"
        },
        "features.tool_choice": {
          "$ref": "#/$defs/latticeState"
        },
        "features.structured_output": {
          "$ref": "#/$defs/latticeState"
        },
        "features.vision": {
          "$ref": "#/$defs/latticeState"
        },
        "features.reasoning": {
          "$ref": "#/$defs/latticeState"
        }
      }
    },
    "pace": {
      "description": "Primary / Alternate / Contingency / Emergency. P is always a model; A and C are a model or a procedure; E is the handoff naming basic-memory :8765 and agent-mail :8812.",
      "type": "object",
      "required": ["P", "A", "C", "E", "triggers"],
      "additionalProperties": false,
      "properties": {
        "P": {
          "$ref": "#/$defs/modelRef"
        },
        "A": {
          "oneOf": [
            {
              "$ref": "#/$defs/modelRef"
            },
            {
              "$ref": "#/$defs/procedure"
            }
          ]
        },
        "C": {
          "oneOf": [
            {
              "$ref": "#/$defs/modelRef"
            },
            {
              "$ref": "#/$defs/procedure"
            }
          ]
        },
        "E": {
          "type": "string",
          "pattern": "^(?=.*basic-memory :8765)(?=.*agent-mail :8812)(handoff|procedure):.*\\S.*$"
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trigger"
          }
        }
      }
    },
    "taskClass": {
      "type": "object",
      "required": [
        "primary",
        "escalate_to",
        "floors",
        "exponents",
        "spend_share",
        "pace",
        "justification"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "$ref": "#/$defs/modelRef"
        },
        "escalate_to": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modelRef"
          }
        },
        "callers": {
          "description": "Runtimes allowed to use this class; required (within codex / cli) whenever a rung or escalation is the OpenRouter sidecar (L1).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/caller"
          }
        },
        "floors": {
          "$ref": "#/$defs/floors"
        },
        "exponents": {
          "type": "object",
          "required": ["quality", "speed", "cost"],
          "additionalProperties": false,
          "properties": {
            "quality": {
              "$ref": "#/$defs/fraction"
            },
            "speed": {
              "$ref": "#/$defs/fraction"
            },
            "cost": {
              "$ref": "#/$defs/fraction"
            }
          }
        },
        "spend_share": {
          "$ref": "#/$defs/fraction"
        },
        "pace": {
          "$ref": "#/$defs/pace"
        },
        "justification": {
          "type": "string",
          "pattern": "\\S"
        },
        "pinned_until": {
          "$ref": "#/$defs/isoDate"
        }
      }
    }
  }
}
