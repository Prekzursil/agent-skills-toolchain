# Minimal, KEY-FREE profile for the self-hosted search backend (TrailSearch).
# Copy to `.env` next to docker-compose.selfhosted-search.yml (docker compose
# auto-loads `.env` from the compose dir), or export these. The `.env` name is
# gitignored on purpose; this committed template shows the shape.
# NOTHING here is a secret: the whole point of this lane is zero vendor keys.
# (If you ever opt into the optional Brave fallback, do NOT inline the key here --
#  reference it by name from .agents/local.json and inject it at runtime.)

# Where search-hub's selfhosted_* tools reach the daemon (adapter default too).
SELFHOSTED_SEARCH_PORT=8794

# Point the app at a SearXNG that exposes JSON. Default reuses the estate SearXNG
# already running for tools/search-expansion (host.docker.internal:8890). With
# `--profile bundled`, the run script sets this to the in-compose SearXNG instead.
SEARXNG_URL=http://host.docker.internal:8890

# Keyless routing: local SQLite index first, then SearXNG; no Brave/vendor.
SEARCH_PROVIDER=router
SEARCH_ROUTE_PROVIDERS=local,searxng
EXTERNAL_SEARCH_ENABLED=false

# Lowest-RAM extraction and storage: HTTP/trafilatura only, no Reader/browser,
# no Redis (local reuse index does double duty as the backfill store).
CRAWL_EXTRACTION_STRATEGY=http_first
READER_ENABLED=false
BROWSER_LOCAL_FALLBACK_ENABLED=false
CACHE_ENABLED=false
BACKFILL_QUEUE_BACKEND=local
LOCAL_INDEX_ENABLED=true

# Guardrails for a memory-starved box (per-container caps; tune as needed).
SELFHOSTED_SEARCH_MEM_LIMIT=768m
SEARXNG_MEM_LIMIT=384m

# TrailSearch source pin (the run scripts clone this ref). Bump deliberately.
TRAILSEARCH_REF=e0e2dc1160fc60d0ea925e164194e34040e750f6

# Opt-in lanes. See docs/legal/onions-lane-envelope.md before use.
# Onion-index lane (Ahmia + VormWeb): works BY DEFAULT but ASKS before every search
# (index-only, no Tor). engines=ahmia / engines=vormweb picks one index.
# ENABLE_ONIONS=0     # HARD KILL SWITCH for the whole onion lane (default unset = on, ask-first)
# ENABLE_VORMWEB=0    # drop VormWeb only (G-7 default-on; explicit engines=vormweb is then refused)
# ENABLE_OSSINSIGHT=1 # keyless GitHub repo-discovery via the public OSSInsight API (default off)
