# Minimal, KEY-FREE profile for the self-hosted search backend (TrailSearch).
# Copy to `.env` next to docker-compose.selfhosted-search.yml (docker compose
# auto-loads `.env` from the compose dir), or export these. The `.env` name is
# gitignored on purpose; this committed template shows the shape.
# NOTHING here is a secret: the whole point of this lane is zero vendor keys.
# (If you ever opt into the optional Brave fallback, do NOT inline the key here --
#  reference it by name from .agents/local.json and inject it at runtime.)

# Where search-hub's selfhosted_* tools reach the daemon (adapter default too).
SELFHOSTED_SEARCH_PORT=8794

# Point the app at a SearXNG that exposes JSON. Default reuses the estate SearXNG
# already running for tools/search-expansion (host.docker.internal:8890). With
# `--profile bundled`, the run script sets this to the in-compose SearXNG instead.
SEARXNG_URL=http://host.docker.internal:8890

# Keyless routing: local SQLite index first, then SearXNG; no Brave/vendor.
SEARCH_PROVIDER=router
SEARCH_ROUTE_PROVIDERS=local,searxng
EXTERNAL_SEARCH_ENABLED=false

# Lowest-RAM extraction and storage: HTTP/trafilatura only, no Reader/browser,
# no Redis (local reuse index does double duty as the backfill store).
CRAWL_EXTRACTION_STRATEGY=http_first
READER_ENABLED=false
BROWSER_LOCAL_FALLBACK_ENABLED=false
CACHE_ENABLED=false
BACKFILL_QUEUE_BACKEND=local
LOCAL_INDEX_ENABLED=true

# Guardrails for a memory-starved box (per-container caps; tune as needed).
SELFHOSTED_SEARCH_MEM_LIMIT=768m
SEARXNG_MEM_LIMIT=384m

# TrailSearch source pin (the run scripts clone this ref). Bump deliberately.
TRAILSEARCH_REF=e0e2dc1160fc60d0ea925e164194e34040e750f6

# Opt-in lanes. See docs/legal/onions-lane-envelope.md before use.
# Onion-index lane (Ahmia + VormWeb): works BY DEFAULT but ASKS before every search
# (index-only, no Tor). engines=ahmia / engines=vormweb picks one index.
# ENABLE_ONIONS=0     # HARD KILL SWITCH for the whole onion lane (default unset = on, ask-first)
# ENABLE_VORMWEB=0    # drop VormWeb only (G-7 default-on; explicit engines=vormweb is then refused)
# ENABLE_OSSINSIGHT=1 # keyless GitHub repo-discovery via the public OSSInsight API (default off)

# read_url -- search-hub's in-process page fetch (default ON; ENABLE_READ_URL=0 kills it).
# The readability rung is OPTIONAL: `pip install -r requirements-optional.txt` on the
# hub box enables trafilatura (rs-trafilatura preferred when importable); absent = skipped.
# READ_URL_MIN_CHARS=200      # a readability extract shorter than this gets ONE favor_recall retry, labelled quality medium (1..100000)
# READ_URL_ALLOW_PRIVATE=1    # TEST/DEV ONLY: allow loopback/private targets AND skip the DNS re-resolve pin. Never in production.

# ---------------------------------------------------------------------------
# Answer engines (docker-compose.answer-engines.yml) -- OPT-IN, ON-DEMAND, and
# NOTHING starts by default: `run-answer-engines.sh up --vane` / `--ldr`, then
# `stop-answer-engines.sh` to reclaim the RAM. Pins verified 2026-09-02; the
# same `.env` is read by compose for these, so overrides live here too.
# ---------------------------------------------------------------------------
# Hub side (search-hub reads these; the lane is OFF until one of them is set):
# ENABLE_VANE=1                       # wire selfhosted_answer at the default VANE_URL
# VANE_URL=http://127.0.0.1:3000      # or https://vane.your.ovh -- endpoint-agnostic, one-line repoint
# VANE_TIMEOUT_S=120                  # LLM budget per answer, seconds (clamped 1..3600)
# ENABLE_LDR / LDR_URL are the LDR MCP ProviderSpec's flags (providers.py) -- see the
# "Gated search-hub child providers" block: ENABLE_LDR=1 runs `ldr-mcp` over STDIO on
# the host and LDR_URL is only a resident-MCP gateway, so neither is LDR_PORT below.

# Compose side -- Vane (profile `vane`): SLIM image (no bundled SearXNG), reuses the
# estate SearXNG + the host Ollama. Provider ids are UUIDs minted per install, so the
# hub resolves them from GET /api/providers on every call; never pin them in config.
VANE_IMAGE=itzcrazykns1337/vane:slim-v1.12.2
VANE_PORT=3000
VANE_SEARXNG_API_URL=http://host.docker.internal:8890
VANE_OLLAMA_BASE_URL=http://host.docker.internal:11434
VANE_MEM_LIMIT=768m

# Compose side -- local-deep-research (profile `ldr`): web UI + REST API on LDR_PORT;
# its MCP server (`ldr-mcp`) is STDIO-only and runs on the host, not in this container.
LDR_IMAGE=localdeepresearch/local-deep-research:1.10.7
LDR_PORT=5000
LDR_OLLAMA_URL=http://host.docker.internal:11434
LDR_SEARXNG_URL=http://host.docker.internal:8890
LDR_MEM_LIMIT=2g

# Compose side -- evicting Ollama (profile `ollama`), ONLY for a box with no host
# Ollama. The container hard-codes OLLAMA_KEEP_ALIVE=0 (model leaves RAM right after
# each answer); set the same on a host Ollama: `setx OLLAMA_KEEP_ALIVE 0` + restart.
OLLAMA_IMAGE=ollama/ollama:0.33.2
OLLAMA_PORT=11434
OLLAMA_MEM_LIMIT=16g
# ANSWER_ENGINES_RESTART=no           # on-demand: no auto-restart (unless-stopped if you insist)

# Repo-health lane (bestofjs v2 + deps.dev + OpenSSF Scorecard): keyless public
# APIs, DEFAULT ON; config only, no secrets. Base URLs exist so tests can point
# the adapters at a loopback fake. NEVER set BESTOFJS_API_URL to the v1 host
# (bestofjs-static-api.vercel.app): it is frozen at 2024-08-10 and is refused.
# ENABLE_REPO_HEALTH=0  # HARD KILL SWITCH for the whole lane (default unset = on)
# BESTOFJS_API_URL=https://bestofjs-static-api-v2.vercel.app  # the v2 static dataset host
# BESTOFJS_TTL_S=21600  # in-process cache of /projects.json (1.4 MB), seconds; 0 = refetch each call
# DEPSDEV_API_URL=https://api.deps.dev
# SCORECARD_API_URL=https://api.securityscorecards.dev

# Gated search-hub child providers (README "Providers"; all keyless, never rotated).
# Default-ON keyless remotes, bridged on demand via `npx -y mcp-remote` (0 MB idle):
# ENABLE_PARALLEL=0      # kill switch: Parallel Search MCP (https://search.parallel.ai/mcp)
# ENABLE_GREPAPP=0       # kill switch: grep.app code search (https://mcp.grep.app; may 429 from datacenter IPs)
# Opt-in children (default off; `1` wires them):
# ENABLE_CORROBORATE=1   # TRIAL corroborate-mcp@0.1.3 (claim origin counting; 1-star single maintainer)
# ENABLE_OPENWEBSEARCH=1 # open-websearch@2.1.11 in MODE=stdio + SEARCH_MODE=request (SearXNG-parser fallback)
# ENABLE_LDR=1           # local-deep-research[mcp]==1.10.7 via `uvx ... ldr-mcp` (resident 8-16 GB: on-demand only)
# LDR_URL=               # optional: bridge to a resident ldr-mcp behind YOUR Streamable-HTTP gateway instead of uvx

# Grounding lane (lane_wiki.py: Wikipedia + Wayback Machine + Hacker News): keyless
# public APIs, DEFAULT ON, one kill switch per source; config only, no secrets.
# Base URLs exist so tests point every source at one loopback fake. Live shapes
# measured 2026-09-02 (README "Grounding lanes"); the CDX host flaps to HTTP 503,
# which the lane relays as an error, never as "no captures".
# ENABLE_WIKIPEDIA=0  # drop wikipedia_search + wikipedia_summary (default unset = on)
# ENABLE_WAYBACK=0    # drop wayback_available + wayback_snapshots (default unset = on)
# ENABLE_HN=0         # drop hn_search (default unset = on); all three off = lane not wired
# WIKIPEDIA_API_URL=https://en.wikipedia.org  # lang="de" etc. swaps the language label of a *.wikipedia.org host
# WAYBACK_API_URL=https://archive.org         # the availability API (/wayback/available)
# WAYBACK_CDX_URL=https://web.archive.org     # the CDX index (/cdx/search/cdx) -- a different host, hence its own env
# HN_API_URL=https://hn.algolia.com           # the Algolia HN Search API (/api/v1/search, /api/v1/search_by_date)

# Keyed search APIs (lane_keyed.py; README "Keyed search APIs"): twelve PAID vendors,
# ALL DEFAULT OFF. A vendor is wired only when BOTH its ENABLE_KEYED_<VENDOR>=1 flag
# AND its key env are set -- nothing bills until you set both. Keys are read by env
# NAME only, sent where the vendor documents (header / query / basic), never logged,
# never written to disk, scrubbed from every error text; only `authenticated` (a
# boolean) is ever reported. Put REAL values in your private .env, never in this
# example, never in git. Docs + list prices read 2026-09-02.
# KEYED_MAX_CALLS_PER_DAY=200                 # per-vendor daily call budget (attempted calls, failures included)
# KEYED_SPEND_CAP_USD=5.00                    # GLOBAL per-calendar-month cap, estimated from list prices (README table)
# KEYED_LEDGER_PATH=caches/keyed-ledger.json  # counts + estimated USD, git-ignored, never a key; must be writable
# ENABLE_KEYED_BRAVE=1          # brave_web_search, brave_llm_context: X-Subscription-Token header ($5/1k, $5/mo free credit)
# BRAVE_API_KEY=                # value in YOUR private .env only
# ENABLE_KEYED_KAGI=1           # kagi_search (v1, Bearer, $12/1k); kagi_enrich_web|news (v0, "Bot", $2/1k)
# KAGI_API_KEY=
# ENABLE_KEYED_LINKUP=1         # linkup_search: Bearer ($5/1k standard, $6/1k deep)
# LINKUP_API_KEY=
# ENABLE_KEYED_MOJEEK=1         # mojeek_search: ?api_key= query param (GBP 2 CPM ~$2.70/1k; count>10 ~$4.05/1k)
# MOJEEK_API_KEY=
# ENABLE_KEYED_YOUCOM=1         # youcom_search: X-API-Key header ($5/1k)
# YOUCOM_API_KEY=
# ENABLE_KEYED_PERPLEXITY=1     # perplexity_search: Bearer -- the Search API, not Sonar ($5/1k)
# PERPLEXITY_API_KEY=
# ENABLE_KEYED_MARGINALIA=1     # marginalia_search: API-Key header on api2.marginalia-search.com (no published price: counted, not priced)
# MARGINALIA_API_KEY=           # a PAID key; the shared 'public' key is refused (that one is the SearXNG marginalia engine)
# --- Google SERP scrapers: LEGAL SHADOW (Google v. SerpApi); no index SearXNG lacks -- prefer searxng_web_search
# ENABLE_KEYED_SERPER=1         # serper_search: X-API-KEY header ($1/1k; num>10 = 2 credits)
# SERPER_API_KEY=
# ENABLE_KEYED_SERPAPI=1        # serpapi_search: ?api_key= query param (~$25/1k, Starter-plan estimate)
# SERPAPI_API_KEY=
# ENABLE_KEYED_DATAFORSEO=1     # dataforseo_serp: HTTP basic login:password ($2 per SERP page of 10, x5 per search operator)
# DATAFORSEO_LOGIN=             # BOTH parts are required
# DATAFORSEO_PASSWORD=
# ENABLE_KEYED_ZENSERP=1        # zenserp_search: apikey header (~$2/1k, Small-plan estimate)
# ZENSERP_API_KEY=
# ENABLE_KEYED_SCRAPINGBEE=1    # scrapingbee_google: Bearer (~$2.54/1k light; ~$3.80/1k with light_request=false)
# SCRAPINGBEE_API_KEY=
# BRAVE_API_URL=https://api.search.brave.com  # base-URL override, one per vendor (<VENDOR>_API_URL: KAGI_API_URL, LINKUP_API_URL, ...);
#                                             # config, not a secret -- the tests point these at a loopback fake
