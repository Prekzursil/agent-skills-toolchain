# Per-user multi-key credential store (accounts.py / AccountStore).
# It MAY hold literal API keys (env-mode key bundles).
# accounts.json is committed ENCRYPTED via git-crypt (see root .gitattributes);
# it decrypts to plaintext only after `git-crypt unlock`. So it is intentionally
# NOT ignored here. The committed accounts.example.json shows the ${ENV} shape.
accounts.json.tmp

# Python caches
__pycache__/
.pytest_cache/

# lane_keyed spend ledger (KEYED_LEDGER_PATH default): per-vendor call counts and
# ESTIMATED USD for the hard spend cap. Local usage state, never a key; the
# .tmp-* files are its atomic-write staging and .corrupt-* an unreadable ledger
# renamed aside. The other caches/*.json are committed provider tool lists.
caches/keyed-ledger.json
caches/keyed-ledger.json.tmp-*
caches/keyed-ledger.json.corrupt-*
