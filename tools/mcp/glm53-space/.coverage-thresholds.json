{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Coverage SSOT for the GLM 5.3 Space adapter.",
  "thresholds": {
    "lines": 80,
    "branches": 80,
    "functions": 80,
    "statements": 80
  },
  "enforcement": {
    "command": "uv run pytest -q --cov=glm53_core --cov=mcp_server --cov=openai_proxy --cov-branch --cov-fail-under=80",
    "blockPRCreation": true,
    "blockTaskCompletion": true,
    "description": "Blocking project coverage gate for adapter, MCP, and proxy behavior."
  }
}
