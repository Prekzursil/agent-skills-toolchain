# linkedin-mcp holds NO credential file -- all secrets come from the environment
# (LINKEDIN_ACCESS_TOKEN / LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET). If you
# ever keep a local .env for convenience, it must never be committed.
.env
.env.*
*.token

# Python / tooling caches
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
