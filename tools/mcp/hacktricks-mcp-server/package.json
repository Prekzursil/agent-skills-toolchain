{
  "name": "@prekzursil/hacktricks-mcp-server",
  "version": "1.3.4-hardened.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hacktricks-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": ">=2.0.10 <3",
    "hono": ">=4.12.34 <5",
    "ip-address": ">=10.3.1 <11",
    "fast-uri": ">=3.1.5 <4"
  }
}
