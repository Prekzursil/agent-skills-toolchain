{
  "$id": "https://prekzursil.dev/ast-integrate/schema/conformance-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`verdict` must spell out N/N. 'nothing blocking' is not expressible in this schema.",
  "properties": {
    "artifact": {
      "const": "conformance-report"
    },
    "condition_count": {
      "minimum": 1,
      "type": "integer"
    },
    "conditions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^C[0-9]{2}$",
            "type": "string"
          },
          "requirement": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "SATISFIED",
              "VIOLATED",
              "NOT-CHECKED"
            ]
          }
        },
        "required": [
          "id",
          "requirement",
          "status",
          "evidence"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "not_checked": {
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "package": {
      "minLength": 1,
      "type": "string"
    },
    "satisfied": {
      "minimum": 0,
      "type": "integer"
    },
    "verdict": {
      "pattern": "^\\d+/\\d+ conditions satisfied$",
      "type": "string"
    },
    "violated": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "artifact",
    "package",
    "condition_count",
    "satisfied",
    "violated",
    "not_checked",
    "ok",
    "verdict",
    "conditions"
  ],
  "title": "Plugin conformance report (positive assertion, N of N)",
  "type": "object"
}
