{
  "$id": "https://prekzursil.dev/ast-integrate/schema/health-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`probe_count` has a minimum of 1: a report from an empty probe registry is not a green health check, it is a broken harness.",
  "properties": {
    "artifact": {
      "const": "health-report"
    },
    "controls": {
      "type": "array"
    },
    "failed": {
      "minimum": 0,
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "os": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "passed": {
      "minimum": 0,
      "type": "integer"
    },
    "probe_count": {
      "minimum": 1,
      "type": "integer"
    },
    "probes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "minLength": 1,
            "type": "string"
          },
          "probe": {
            "minLength": 1,
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          }
        },
        "required": [
          "probe",
          "status",
          "detail",
          "remediation"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "skipped": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "artifact",
    "os",
    "probe_count",
    "passed",
    "failed",
    "skipped",
    "ok",
    "probes"
  ],
  "title": "Health-check report",
  "type": "object"
}
