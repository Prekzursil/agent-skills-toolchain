{
  "$id": "https://prekzursil.dev/ast-integrate/schema/failure-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every fail-open row must carry a reason; the default is pinned to fail-closed.",
  "properties": {
    "artifact": {
      "const": "failure-policy"
    },
    "default_mode": {
      "const": "fail-closed"
    },
    "fail_open_count": {
      "minimum": 0,
      "type": "integer"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "component": {
            "minLength": 1,
            "type": "string"
          },
          "error_code": {
            "pattern": "^E_[A-Z_]+$",
            "type": "string"
          },
          "mode": {
            "enum": [
              "fail-open",
              "fail-closed"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "component",
          "mode",
          "error_code",
          "reason"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "default_mode",
    "fail_open_count",
    "rules"
  ],
  "title": "Per-component fail-open versus fail-closed policy",
  "type": "object"
}
