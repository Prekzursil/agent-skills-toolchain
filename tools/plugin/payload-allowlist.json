{
  "artifact": "payload-allowlist",
  "policy": "deny-by-default",
  "rules": [
    {
      "glob": ".claude-plugin/plugin.json",
      "reason": "plugin manifest contract"
    },
    {
      "glob": "LICENSE",
      "reason": "redistribution terms"
    },
    {
      "glob": "README.md",
      "reason": "user-facing documentation"
    },
    {
      "glob": "bin/*.py",
      "reason": "console entrypoints"
    },
    {
      "glob": "bin/*.sh",
      "reason": "console shell entrypoints (IMP-0017 LF-only)"
    },
    {
      "glob": "commands/*.md",
      "reason": "command surface (slash-segment *; nested rogue must not match)"
    },
    {
      "glob": "hooks/*.py",
      "reason": "hook scripts"
    },
    {
      "glob": "lib/astplugin/*.py",
      "reason": "plugin runtime"
    },
    {
      "glob": "schema/*.schema.json",
      "reason": "artifact and manifest schemas"
    },
    {
      "glob": "payload-allowlist.json",
      "reason": "deny-by-default policy travels with the packer inputs"
    },
    {
      "glob": "pack.py",
      "reason": "deterministic packer itself (IMP-0002)"
    },
    {
      "glob": "secret_gate.py",
      "reason": "credential-exposure pre-emit gate (IMP-0004)"
    }
  ],
  "budget": {
    "max_bytes": 52428800,
    "max_files": 500
  },
  "forbidden_classes": {
    "vcs": [".git/*", ".git", "*/.git/*", ".gitmodules", ".hg/*", ".svn/*"],
    "cache": [
      "__pycache__/*",
      "*/__pycache__/*",
      "*.pyc",
      ".pytest_cache/*",
      "*/.pytest_cache/*",
      ".ruff_cache/*",
      "*/.ruff_cache/*",
      "node_modules/*",
      "*/node_modules/*",
      ".venv/*",
      "*/.venv/*",
      "*.egg-info/*"
    ],
    "log": ["*.log", "*/logs/*", "logs/*", "*.log.*"],
    "transcript": [
      "*.jsonl",
      "*/projects/*/*.jsonl",
      "*transcript*",
      "*/sessions/*",
      "*/.claude/history*"
    ],
    "credential": [
      ".env",
      ".env.*",
      "*/.env",
      "*.pem",
      "*.key",
      "*.pfx",
      "*.p12",
      "id_rsa*",
      "id_ed25519*",
      "*credentials*.json",
      "*.credentials*",
      "auth.json",
      "*token*.json",
      ".npmrc",
      ".netrc"
    ],
    "backup": ["*.bak", "*.bak-*", "*.orig", "*.baseline", "*Zone.Identifier"],
    "archive": ["*.zip", "*.tar", "*.tar.gz", "*.tgz", "*.7z", "*.vhdx", "*.iso"]
  }
}
