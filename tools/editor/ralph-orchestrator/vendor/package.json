{
  "name": "ralph-orchestrator",
  "version": "2.8.1",
  "private": true,
  "description": "AI agent orchestrator with web dashboard",
  "workspaces": [
    "backend/*",
    "frontend/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:server": "npm run build -w @ralph-web/server",
    "build:web": "npm run build -w @ralph-web/dashboard",
    "dev": "npm run dev:web",
    "dev:api": "cargo run -p ralph-api",
    "dev:web": "npm run dev -w @ralph-web/dashboard",
    "dev:legacy-server": "npm run dev -w @ralph-web/server",
    "start": "cargo run -p ralph-api",
    "test": "npm run test --workspaces --if-present",
    "test:server": "npm run test -w @ralph-web/server",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "ralph"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "fast-uri": ">=3.1.8 <4",
    "fastify": {
      "version": ">=5.12.5 <6",
      "fast-uri": ">=4.1.5 <5"
    },
    "vite": ">=7.3.7 <8",
    "source-map-js": ">=1.2.2 <2",
    "zod": ">=4.6.6 <5"
  }
}
