{
  "name": "prompt-optimizer-button",
  "displayName": "Prompt Optimizer Button",
  "description": "Fast in-editor prompt optimization with local presets, inline diff, and replace/copy actions.",
  "version": "0.1.0",
  "publisher": "prekzursil-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prekzursil/agent-skills-toolchain.git",
    "directory": "tools/editor/prompt-optimizer-button"
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:promptOptimizer.optimizeSelection",
    "onCommand:promptOptimizer.copyOptimizedPrompt",
    "onCommand:promptOptimizer.replaceSelectionWithOptimized",
    "onCommand:promptOptimizer.insertOptimizedBelow",
    "onCommand:promptOptimizer.copySelectionAndOpenOfficialOptimizer",
    "onCommand:promptOptimizer.openOfficialOptimizer"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "promptOptimizer.optimizeSelection", "title": "Prompt Optimizer: Optimize Prompt" },
      { "command": "promptOptimizer.copyOptimizedPrompt", "title": "Prompt Optimizer: Copy Optimized Prompt" },
      { "command": "promptOptimizer.replaceSelectionWithOptimized", "title": "Prompt Optimizer: Replace Selection With Optimized Prompt" },
      { "command": "promptOptimizer.insertOptimizedBelow", "title": "Prompt Optimizer: Insert Optimized Prompt Below" },
      { "command": "promptOptimizer.copySelectionAndOpenOfficialOptimizer", "title": "Prompt Optimizer: Copy Optimized Prompt (compatibility alias)" },
      { "command": "promptOptimizer.openOfficialOptimizer", "title": "Prompt Optimizer: Optimize Prompt (compatibility alias)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "promptOptimizer.optimizeSelection", "when": "editorTextFocus", "group": "navigation@100" }
      ],
      "commandPalette": [
        { "command": "promptOptimizer.optimizeSelection" },
        { "command": "promptOptimizer.copyOptimizedPrompt" },
        { "command": "promptOptimizer.replaceSelectionWithOptimized" },
        { "command": "promptOptimizer.insertOptimizedBelow" },
        { "command": "promptOptimizer.copySelectionAndOpenOfficialOptimizer" },
        { "command": "promptOptimizer.openOfficialOptimizer" }
      ]
    },
    "configuration": {
      "title": "Prompt Optimizer Button",
      "properties": {
        "promptOptimizer.defaultPreset": {
          "type": "string",
          "default": "General",
          "enum": ["General", "Codex task", "Bug report", "Research request"],
          "description": "Default optimization preset."
        },
        "promptOptimizer.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Prompt Optimizer status bar button."
        },
        "promptOptimizer.openDiffByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Open a diff view after optimization."
        },
        "promptOptimizer.maxSelectionLength": {
          "type": "number",
          "default": 50000,
          "minimum": 200,
          "description": "Maximum selection size, in characters, that will be optimized locally."
        }
      }
    }
  }
}
