        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "description": {"type": "string"},
          "targets": {"type": "array", "items": {"type": "string", "enum": ["codex", "claude", "cursor", "grok", "goose", "agy", "gemini"]}},
          "enabled": {"type": "boolean"},
          "transport": {"type": "string", "enum": ["stdio", "http"]},
          "url": {"type": "string"},
          "requiredEnv": {"type": "array", "items": {"type": "string"}},
          "credentialNames": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["label", "targets", "enabled", "transport"],
        "additionalProperties": false
      },
      "valid": {
        "label": "apify",
        "description": "Imported from .codex/config.toml (apify)",
        "targets": ["codex", "claude"],
        "enabled": true,
        "transport": "http",
        "url": "https://mcp.apify.com/",
        "requiredEnv": ["APIFY_TOKEN"],
        "credentialNames": ["APIFY_TOKEN"],
        "tags": ["approved", "http", "remote", "shared"]
      },
      "invalid": {
        "label": "apify",
        "targets": ["codex"],
        "enabled": true,
        "transport": "grpc"
      }
    },
