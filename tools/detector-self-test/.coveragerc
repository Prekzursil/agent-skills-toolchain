# Coverage config for the detector self-test harness.
# Run from this directory: `python -m pytest --cov=detector_self_test`.
# The harness holds itself to 100% line AND branch coverage with no exclusions
# (the __main__ entrypoint guard is covered via a runpy test, not a pragma).
[run]
branch = True

[report]
show_missing = True
fail_under = 100
