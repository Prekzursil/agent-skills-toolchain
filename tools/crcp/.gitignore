# Local runtime / secrets — never commit
outbox/
logs/
reports/spool.db*
reports/*.lock*
reports/auth_broker_last.json
reports/desktop_cookie_inventory*.json
reports/auth_status_live.json
reports/chatgpt_send*.json
reports/*_probe*.json
reports/live_bridge_state.json
**/chatgpt_cookies.json
__pycache__/
*.pyc

# Raw browser cookie DUMPS carry live session values — never commit (reports/ is NOT
# git-crypt'd). Encrypted stores live under cookie-store/ instead.
reports/*cdp_cookies*.json

# One-shot live-capture / audit dumps — regenerated by the auth + bus probes and carrying
# account/session identifiers. The durable narrative lives in the paired reports/*.md.
reports/auth_status_audit.json
reports/auth_watch_log.jsonl
reports/health_live.json
reports/*_last.*
reports/*_live_smoke_err.txt

# Runtime ingest drop-box (crcp/inbox.py consumes it) — payloads + cursor, never source.
inbox/

# GitHub trees-API scratch dumps used once to locate vendored upstream files (2 MB, regenerable).
vendor_src/**/tree.json

# Belt-and-braces for the cookie store: the .gitattributes git-crypt rule is inert unless
# `git-crypt unlock` has run on this box. Never let a plaintext cookie dump be staged.
cookie-store/*.json
