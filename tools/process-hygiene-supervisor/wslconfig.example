# Deploy to %USERPROFILE%\.wslconfig  (i.e. C:\Users\Prekzursil\.wslconfig)
# then run `wsl --shutdown` once so the new limits take effect on next start.
#
# WHY: on 02.09.2026 04:50 EEST vmmemWSL held 1.1 GB with NO workload inside it.
# WSL2's default memory ceiling is 50% of RAM (~15.8 GB on this 31.6 GB box) and
# it does not return freed guest page cache to Windows unless autoMemoryReclaim is
# enabled. The cap below bounds the guest, and autoMemoryReclaim hands cache back
# to Windows while WSL keeps running - so the process-hygiene supervisor's
# `wsl --shutdown` is only a last resort, not the routine reclaim path.
#
# Key placement verified against Microsoft Learn (wsl-config, fetched 2026-09-02):
# memory/processors/swap/vmIdleTimeout live under [wsl2]; autoMemoryReclaim and
# sparseVhd are [experimental]-only keys (valid autoMemoryReclaim values:
# disabled | gradual | dropCache). Putting them under [wsl2] is a no-op.
#
# Tune `memory` to the largest guest workload you actually run. 8GB leaves ample
# headroom for the AI runtimes + browsers on the Windows side; drop to 4GB if WSL
# is only used for light tooling.

[wsl2]
# Hard cap on the WSL2 guest VM (vmmemWSL) RAM.
memory=8GB

# Cap guest processors so a WSL build cannot starve the Windows-side agents.
processors=4

# Bound the swap file so a runaway guest cannot balloon commit charge on C:.
swap=8GB

# Native idle shutdown (Windows 11): milliseconds the VM may sit with NO distro
# running before WSL stops it. Default is already 60000; kept explicit so the
# knob is visible. Note this does NOT fire while a distro shell/service is open -
# that is the case the supervisor's idle `wsl --shutdown` covers.
vmIdleTimeout=60000

[experimental]
# Return unused guest page cache to Windows automatically. "gradual" is the least
# disruptive; "dropCache" is more aggressive if pressure is chronic.
autoMemoryReclaim=gradual

# Reclaim the sparse VHD space freed by autoMemoryReclaim (newly created VHDs).
sparseVhd=true
