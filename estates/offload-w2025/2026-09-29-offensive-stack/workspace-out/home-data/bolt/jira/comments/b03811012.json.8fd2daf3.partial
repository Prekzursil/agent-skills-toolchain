3111302,\n       2308463728, 2307777274, 2256394969, 2256073880, 2272725257,\n       2440112209, 2439479401, 2440583665, 2290946847, 2589852413,\n       2368505351, 2369174713, 2368483523, 2369032211, 2368982213,\n       2368770231, 2369045968, 2369397384, 2370320159, 2637519324,\n       2686314736, 2685442465, 2687093820, 2571355670, 2571730207,\n       2555194141, 2556782933, 2195060919, 2212129009, 2538732531,\n       2304883794, 2305768246, 2457156255, 2456366796, 2456687037,\n       2587094095, 2242180610, 2222452205, 2222481712, 2703347246,\n       2702224883, 2180576419, 2180884927, 2206748995, 2253765581,\n       2237709741, 2525498195, 2525890969, 2718433460, 2718673978,\n       2224537912, 2223606599, 2350273259, 2371161155, 2372027836,\n       2371000145, 2371144695, 2353547338, 2352959867, 2353199063,\n       2353222506, 2353455394, 2353654587, 2352881409, 2354620077,\n       2352941586, 2352586320, 2356829518, 2357047158, 2288654886,\n       2211032057, 2175449589, 2102135872, 2239486316, 2144008461,\n       2354791808, 2355944038, 2355226937, 2355109342, 2354737237\n) and state='to_execute';{code}","2026-01-07T13:41:36.184Z"],["3793354","PFI-828897","PFI","marten.martinson@bolt.eu","Marten Martinson","Hi [~accountid:5e4fb3b04d2a000c9114bc04] \n\nYou always escalate the most difficult cases. \n\nI have taken a look and I could not locate the payment. I found some close matches, but unable to confirm the payment. \n\nHere is what we know\n\n# The payment is not in SEK as SEK payment’s don’t have any decimals. The currency is not known. \n# We are looking for a single authorization adjustment payment. In the first screenshot you can see “Prel” for two different amounts. It’s likely 9.75 EUR payment were the price was increased by 2.05 EUR. The final price was around 11.80 EUR. \n# The card issuer is Svenska Handelsbanken\n# The payment was done with ApplePay/GooglePay wallet since we could not find the payment with the card number. \n# The payment descriptors are not particularly helpful has they are missing most digits. \n\n\n\nCould you please ask the customer for more information about the payments? \nIf possible the user should provide information from their bank statement. A full payment descriptor would be the most useful. \n\nCheers, \nMarten\n","2026-01-07T13:41:47.792Z"],["3793357","BD-1972","BD","rafael.barros@bolt.eu","Rafael Adson Barbosa Barros","Ignoring courier tasks sql:\n\n{code:sql}update task\nset state='ignore', ignore_reason='Old emails should no longer be sent to couriers'\nwhere id IN (\n2817319384, 2870053718, 2783157644, 2197768383, 2198918770,\n       2854131257, 2818245090, 2817797030, 2766955530, 2835395784,\n       2822424953, 2330697781, 2783318774, 2078025858, 2394090713,\n       2395251099, 2769534770, 2838962815, 2839077796, 2804186820,\n       2313554294, 2312780998, 2250442188, 2248847663, 2801742315,\n       2800320260, 2748802384, 2749094261, 2708298040, 2319544609,\n       2318276388, 2280133426, 2295629745, 2296434412, 2295695314,\n       2332614622, 2414590696, 2065260034, 2344525885, 2346473000,\n       2411066451, 2480553395, 2397102379, 2398556658, 2166254737,\n       2167997026, 2427520368, 2617110292, 2727721468, 2497070076,\n       2314286938, 2391796714, 2081422820, 2665434985, 2342467271,\n       2341898554, 2579026417, 2579423928, 2215309199, 2214931753,\n       2487291490, 2487360001, 2487227199, 2487209398, 2337420829,\n       2337276112, 2337984928, 2337633627, 2337298425, 2338608688,\n       2337345394, 2337390184, 2337302879, 2339255968, 2338026965,\n       2337364435, 2453644439, 2453643247, 2453407131, 2453783596,\n       2617366268, 2617344295, 2619216280, 2618855995, 2419562875,\n       2074287492, 2361137264, 2298931669, 2298648956, 2373221669,\n       2372603244, 2372538501, 2729602690, 2436888324, 2435260610,\n       2337111332, 2337186944, 2337186655, 2402411613, 2402342287,\n       2403982357, 2403140628, 2402403483, 2403078375, 2402301685,\n       24030