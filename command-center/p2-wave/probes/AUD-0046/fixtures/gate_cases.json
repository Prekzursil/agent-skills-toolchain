{
  "_comment": "AUD-0046 detector-control sweep: one planted mutation per gate, matched to the exact defect class the gate's own docstring says it detects. Every mutation is applied and reverted inside a disposable `git worktree add --detach` scratch checkout (removed at the end of the run); nothing here ever touches the live tree. `commit_required` gates read committed blobs (git cat-file -p HEAD:<path>), not working-tree bytes, so the mutation must be committed in the scratch worktree before the gate is re-run, then undone with `git reset --hard`.",
  "gates": [
    {
      "id": "G1",
      "gate": "tools/measure-guard/refcheck.py",
      "claim": "every subworkflows[].source in a tracked JSON document resolves to a real repo path",
      "command": ["python3", "tools/measure-guard/refcheck.py"],
      "mutation_kind": "dangling-reference",
      "mutation": {
        "file": "platform/workflows/bp-gem-01-wide-lens-gem-sweep.json",
        "find": "platform/workflows/bp-gem-02-anti-overfit-candidate-gate.json",
        "replace": "platform/workflows/bp-gem-02-DOES-NOT-EXIST.json"
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G2",
      "gate": "ci/gen_skills_manifest.py",
      "claim": "skills/SKILLS-MANIFEST.md has exactly one row per tracked skill, kept in sync with the tree",
      "command": ["python3", "ci/gen_skills_manifest.py", "--check"],
      "mutation_kind": "stale-manifest-row-dropped",
      "mutation": {
        "file": "skills/SKILLS-MANIFEST.md",
        "drop_line_containing": "| 010-editor | custom |"
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G3",
      "gate": "ci/gen_skill_index.py",
      "claim": "every canonical .agents/skills/<name> is declared in .claude-plugin/marketplace.json",
      "command": ["python3", "ci/gen_skill_index.py", "--check", "--fail-on-drift"],
      "mutation_kind": "undeclared-canonical-skill",
      "mutation": {
        "file": ".claude-plugin/marketplace.json",
        "remove_skill_entry": "./.agents/skills/010-editor"
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G4",
      "gate": "command-center/hook-audit/check_citations.py",
      "claim": "every <!-- cite: ... value=N --> marker's N equals the value at path in the cited evidence file",
      "command": ["python3", "command-center/hook-audit/check_citations.py"],
      "mutation_kind": "uncited-value-mismatch",
      "mutation": {
        "file": "docs/hook-audit/BUILD-R1.md",
        "find": "value=12 -->",
        "replace": "value=999 -->",
        "occurrence": 1
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G5",
      "gate": "command-center/slop-report/check_published_commands.py",
      "claim": "every `python <path>` a tracked .md document publishes names a path tracked in git (reads git cat-file -p HEAD:<path>, so a working-tree-only edit is invisible -- the mutation must be committed)",
      "command": ["python3", "command-center/slop-report/check_published_commands.py"],
      "mutation_kind": "published-command-untracked-target",
      "mutation": {
        "file": "docs/hook-audit/BUILD-R1.md",
        "append": "\nRun `python command-center/slop-report/AUD-0046-planted-missing-script.py` to reproduce.\n"
      },
      "commit_required": true,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G6",
      "gate": "tools/measure-guard/suitefloor.py",
      "claim": "the casualty suite collects at least its declared floor (28) of tests",
      "command": ["python3", "tools/measure-guard/suitefloor.py", "--suite", "casualty"],
      "mutation_kind": "test-module-dropped-below-floor",
      "mutation": {
        "move": {
          "from": "command-center/casualty/tests/test_casualty_guard.py",
          "to_outside_worktree": true
        }
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G7",
      "gate": "tools/command-center/validate.py",
      "claim": "V-GRAPH: the committed DEPENDENCY-GRAPH.json equals build_graph(catalog) exactly",
      "command": ["python3", "tools/command-center/validate.py"],
      "mutation_kind": "derived-graph-drift",
      "mutation": {
        "file": "command-center/DEPENDENCY-GRAPH.json",
        "json_field_increment": "edge_count"
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    },
    {
      "id": "G8",
      "gate": "ci/check_skill_render_traps.py",
      "claim": "R1 comment-truncation: no SKILL.md description is a plain (unquoted) YAML scalar containing a ' #' that opens a comment",
      "command": ["python3", "ci/check_skill_render_traps.py"],
      "mutation_kind": "render-path-trap-comment-truncation",
      "mutation": {
        "file": ".agents/skills/010-editor/SKILL.md",
        "find": "description: Use when applying binary templates (.bt), running 010 Editor scripts (.1sc), or performing hex editing with SweetScape 010 Editor. Supports command-line batch processing of binary files with templates and scripts.",
        "replace": "description: Use when applying binary templates (.bt) #this trailing text gets silently dropped by a bare YAML scalar comment, running 010 Editor scripts (.1sc), or performing hex editing with SweetScape 010 Editor."
      },
      "commit_required": false,
      "expected_baseline_exit": 0,
      "expected_mutated_exit_nonzero": true
    }
  ],
  "not_yet_swept": [
    ".agents/skills/claim-verify-gate/scripts/claim_gate.py",
    ".agents/skills/claim-verify-gate/scripts/test_claim_gate.py",
    ".agents/skills/claim-verify-gate/scripts/test_claim_gate_mutations.py",
    "ci/check_skill_description_ratchet.py",
    "ci/check_skill_dual_write.py",
    "command-center/ci/interpreter_floor_gate.py",
    "command-center/hook-audit/hook_predeploy_gate.py",
    "command-center/hook-audit/test_citation_gate.py",
    "command-center/mcp-audit/ci_gate.py",
    "command-center/p2-next/rail_count_gate.py",
    "command-center/p2-next/split_review_gate.py",
    "command-center/p2-next/vendor_satisfiability.py",
    "command-center/ssot/ssot_drift_gate.py",
    "docs/rule-audit/ci_gate.py",
    "hooks/harness-bench/gate.py",
    "tools/measure-guard/unitgate.py"
  ]
}
