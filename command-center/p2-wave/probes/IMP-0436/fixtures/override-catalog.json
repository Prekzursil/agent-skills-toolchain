{
  "schema_version": 1,
  "$comment": "IMP-0436 fixture catalog — three units exercising default / partial-override / full-override (+ one explicit-null). Not a live-catalog mutation; live WORK-UNIT-CATALOG.json already admits per-unit keys and resolve_field enforces precedence against it.",
  "defaults": {
    "assignment": {
      "model": "opus",
      "vendor": "anthropic",
      "role": "implementer",
      "basis": "fixture-default"
    },
    "tool_permissions": ["Read", "Grep", "Glob"],
    "execution_substrate": "local-windows-pwsh7",
    "timeout_seconds": 1800,
    "output_schema": "command-center/schema/receipt.schema.json",
    "tests_required": ["both-states-control"],
    "reviewer_requirement": "one independent adversarial reviewer in a fresh context",
    "retry_policy": "two strikes then pivot",
    "failure_classification": ["overclaim", "detector-failure"]
  },
  "items": [
    {
      "id": "FIX-ALL-DEFAULTS",
      "title": "Takes every overrideable field from defaults",
      "phase": "0",
      "target": "all-defaults",
      "inputs": [],
      "dependencies": [],
      "output_path": "command-center/receipts/FIX-ALL-DEFAULTS.json",
      "completion_sentinel": "SUCCESS:FIX-ALL-DEFAULTS",
      "owner_approval_required": false
    },
    {
      "id": "FIX-THREE-OVERRIDES",
      "title": "Overrides three of the nine fields",
      "phase": "0",
      "target": "three-overrides",
      "inputs": [],
      "dependencies": [],
      "output_path": "command-center/receipts/FIX-THREE-OVERRIDES.json",
      "completion_sentinel": "SUCCESS:FIX-THREE-OVERRIDES",
      "owner_approval_required": false,
      "timeout_seconds": 90,
      "reviewer_requirement": "schema-reviewer + adversarial-refuter",
      "retry_policy": "no automatic retry"
    },
    {
      "id": "FIX-ALL-NINE",
      "title": "Overrides all nine fields; timeout_seconds is explicit null",
      "phase": "0",
      "target": "all-nine",
      "inputs": [],
      "dependencies": [],
      "output_path": "command-center/receipts/FIX-ALL-NINE.json",
      "completion_sentinel": "SUCCESS:FIX-ALL-NINE",
      "owner_approval_required": false,
      "assignment": {
        "model": "codex",
        "vendor": "openai",
        "role": "refuter"
      },
      "tool_permissions": ["Read", "Bash:pytest"],
      "execution_substrate": "linux-cloud-agent",
      "timeout_seconds": null,
      "output_schema": "command-center/schema/completion-verdict.schema.json",
      "tests_required": ["precedence-per-field", "explicit-null", "defaults-deletion"],
      "reviewer_requirement": "2 independent reviewers: schema + adversarial null probe",
      "retry_policy": "fail closed; do not retry null semantics",
      "failure_classification": ["uncontrolled-silence", "overclaim"]
    }
  ]
}
