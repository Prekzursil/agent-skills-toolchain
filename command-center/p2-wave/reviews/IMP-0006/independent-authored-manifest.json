{
  "name": "adversarial-schema-probe",
  "version": "2.4.1-rc.1",
  "description": "Fresh-context reviewer-authored fixture that exercises required fields plus optional Phase-4 compatibility, interpreters, entrypoints, payload, and x- extension keys against plugin.schema.json without copying the live control-plane manifest.",
  "author": {
    "name": "Independent Manifest Reviewer",
    "email": "imp-0006-review@example.test",
    "url": "https://example.test/imp-0006/independent-review"
  },
  "license": "Apache-2.0",
  "keywords": [
    "schema-adversarial",
    "independent-review",
    "phase4-optional-fields"
  ],
  "homepage": "https://example.test/plugins/adversarial-schema-probe",
  "compatibility": {
    "min_client": "1.2.3",
    "max_client": "9.9.9",
    "platforms": ["linux", "macos"],
    "schema_version": 1,
    "shells": ["bash", "pwsh"]
  },
  "interpreters": [
    {
      "id": "python3",
      "floor": "3.12",
      "required": true
    },
    {
      "id": "node",
      "floor": "20",
      "required": false
    }
  ],
  "entrypoints": [
    {
      "id": "schema-self-check",
      "kind": "script",
      "path": "scripts/schema-self-check.py",
      "interpreter": "python3",
      "args": ["--strict"],
      "description": "Validate this authored fixture against the live schema."
    },
    {
      "id": "docs-skill",
      "kind": "skill",
      "path": "skills/schema-review/SKILL.md",
      "description": "Skill entrypoint does not require interpreter per schema allOf."
    }
  ],
  "payload": {
    "include": ["scripts/**", "skills/**"],
    "exclude": ["**/*.pyc", ".git/**"],
    "max_bytes": 1048576,
    "max_files": 64
  },
  "deploy": {
    "targets": [
      {
        "source": "skills/schema-review",
        "target": "~/.claude/skills/schema-review",
        "mode": "copy"
      }
    ]
  },
  "x-reviewer-provenance": {
    "unit_id": "IMP-0006",
    "authored_independently": true,
    "not_copied_from_live_plugin_json": true
  }
}
