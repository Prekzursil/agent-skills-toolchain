{
  "name": "agent-skills-toolchain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "tools/mcp/codex-orchestrator",
    "tools/web/promptbridge-talk-lane"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:mcp": "npm run test --workspace @prekzursil/codex-orchestrator",
    "test:web": "npm run test --workspace @prekzursil/promptbridge-talk-lane",
    "validate:skills": "pwsh -File ./scripts/validate-all-skills.ps1",
    "mcp:serve": "node mcp-server.mjs",
    "talk:serve": "node tools/web/promptbridge-talk-lane/src/mcp-server.mjs",
    "orchestration:install": "node tools/mcp/codex-orchestrator/integrations/codex/cli.mjs install",
    "orchestration:update": "node tools/mcp/codex-orchestrator/integrations/codex/cli.mjs update",
    "orchestration:status": "node tools/mcp/codex-orchestrator/integrations/codex/cli.mjs status",
    "orchestration:probe": "node tools/mcp/codex-orchestrator/integrations/codex/cli.mjs probe",
    "orchestration:self-test": "node tools/mcp/codex-orchestrator/integrations/codex/cli.mjs self-test"
  },
  "overrides": {
    "hono": ">=4.12.27"
  }
}
